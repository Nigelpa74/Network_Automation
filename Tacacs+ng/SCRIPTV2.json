    # 4. REGLAS CENTRALIZADAS (RULESET)
    ruleset {
        rule acceso_admin {
            enabled = yes
            script {
                if (device == nexus || device == accessus || device == opticae || device == educatio || device == corpos || device == fortigay) {
                    # Los administradores entran a todo
                    if (member == grp_dominus_absolutus) {
                        profile = admin_profile
                        permit
                    }
                }
            }
        }

        rule regulus_nexus {
            enabled = yes
            script {
                if (device == nexus) {
                    if (member == dirigit_nexus) {
                        profile = admin_profile
                        permit
                    }
                    if (member == servus_nexus) {
                        profile = operator_readonly_profile
                        permit
                    }
                }
            }
        }
        rule regulus_accessus {
            enabled = yes
            script {
                if (device == accessus) {
                    if (member == dirigit_accessus) {
                        profile = admin_profile
                        permit
                    }
                    if (member == servus_accessus) {
                        profile = operator_readonly_profile
                        permit
                    }
                }
            }
        }
        rule regulus_opticae {
            enabled = yes
