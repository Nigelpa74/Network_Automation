id = spawnd {
    background = yes
    listen { port = 49 }
    spawn {
        instances min = 1
        instances max = 10
    }
}

id = tac_plus-ng {

    log autho {
        destination = "/var/log/tac_plus-ng/%Y/%m/%d_authorization.log"
    }
    log authen {
        destination = "/var/log/tac_plus-ng/%Y/%m/%d_authentication.log"
    }
    log account {
        destination = "/var/log/tac_plus-ng/%Y/%m/%d_accounting.log"
        # destination = "/var/log/tac_plus-ng-accounting.log"
    }
    
    authentication log = authen
    authorization log = autho
    accounting log = account

    # 1. DISPOSITIVOS

