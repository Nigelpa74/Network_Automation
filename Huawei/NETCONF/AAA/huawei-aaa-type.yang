submodule huawei-aaa-type {
  yang-version 1.1;
  belongs-to huawei-aaa {
    prefix aaa;
  }
  
  organization
    "Huawei Technologies Co., Ltd.";
    
  contact
    "Huawei Industrial Base
     Bantian, Longgang
     Shenzhen 518129
     People's Republic of China
     Website: http://www.huawei.com
     Email: support@huawei.com";
     
  description
    "Description of AAA type submodule.";
  revision 2025-06-24 {
    description
      "Modify yang-version 1.1.";
    reference
      "Huawei private.";
  }

  revision 2024-06-26 {
    description
      "Add salt type of password.";
    reference
      "Huawei private.";
  }
  revision 2023-12-22 {
    description
      "Modified for NAC.";
    reference
      "Huawei private.";
  }
  revision 2022-12-09 {
    description
      "Add access permission type of directory.";
    reference
      "Huawei private.";
  }
  revision 2020-01-09 {
    description
      "Initial revision.";
    reference
      "Huawei private.";
  }
  typedef aaa-directory-type {
    type enumeration {
      enum "read" {
        value 0;
        description
          "Access permission of directory is read.";
      }
      enum "write" {
        value 1;
        description
          "Access permission of directory is write.";
      }
      enum "execute" {
        value 2;
        description
          "Access permission of directory is execute.";
      }
      enum "read-write" {
        value 3;
        description
          "Access permissions of directory are read and write.";
      }
      enum "read-execute" {
        value 4;
        description
          "Access permissions of directory are read and execute.";
      }
      enum "write-execute" {
        value 5;
        description
          "Access permissions of directory are write and execute.";
      }
      enum "read-write-execute" {
        value 6;
        description
          "Access permissions of directory are read, write, and execute.";
      }
      enum "all-permission" {
        value 7;
        description
          "Access permission of directory is not restricted.";
      }
    }
    description
      "Access permissions of directory.";
  }
  typedef aaa-authen-state-type {
    type enumeration {
      enum "idle" {
        value 0;
        description
          "Idle.";
      }
      enum "authenticating" {
        value 1;
        description
          "Authenticating.";
      }
      enum "success" {
        value 2;
        description
          "Success.";
      }
      enum "failed" {
        value 3;
        description
          "Failed.";
      }
    }
    description
      "Authentication state type.";
  }
  typedef aaa-cmd-access-type {
    type enumeration {
      enum "allow" {
        value 1;
        description
          "Allow.";
      }
      enum "reject" {
        value 2;
        description
          "Reject.";
      }
    }
    description
      "Cmd access type.";
  }
  typedef aaa-authen-mode {
    type enumeration {
      enum "invalid" {
        value 0;
        description
          "Invalid authentication mode.";
      }
      enum "local" {
        value 1;
        description
          "Local authentication mode.";
      }
      enum "hwtacacs" {
        value 2;
        description
          "HWTACACS authentication mode.";
      }
      enum "radius" {
        value 3;
        description
          "RADIUS authentication mode.";
      }
      enum "none" {
        value 4;
        description
          "In this mode, users can pass with authentication.";
      }
      enum "radius-proxy" {
        value 5;
        description
          "RADIUS proxy authentication mode.";
      }
      enum "haca" {
        value 6;
        description "HACA authentication mode.";
      }
      enum "ldap" {
        value 7;
        description "LDAP authentication mode.";
      }
      enum "ad" {
        value 8;
        description "AD authentication mode.";
      }
      enum "super" {
        value 9;
        description "Super authentication mode.";
      }
      enum "local-case" {
        value 10;
        description "Local case authentication mode.";
      }
    }
    description
      "Authentication mode.";
  }
  typedef aaa-author-mode {
    type enumeration {
      enum "invalid" {
        value 0;
        description
          "Specifies that the invalid mode is applied.";
      }
      enum "local" {
        value 1;
        description
          "Specifies that the local mode is applied.";
      }
      enum "hwtacacs" {
        value 2;
        description
          "Specifies that the HWTACACS mode is applied.";
      }
      enum "if-authenticated" {
        value 3;
        description
          "Specifies that the If-authenticated mode is adopted. If users pass the authentication and the authentication is not in this mode, it indicates that the user authorization is passed. Otherwise, the authorization is not passed.";
      }
      enum "none" {
        value 4;
        description
          "Users can pass without authorization.";
      }
      enum "ad" {
        value 5;
        description
          "Specifies that the ad mode is applied.";
      }
      enum "ldap" {
        value 6;
        description
          "Specifies that the ldap mode is applied.";
      }
      enum "local-case" {
        value 7;
        description
          "Specifies that the local-case mode is applied.";
      }
    }
    description
      "Authorization mode.";
  }
  typedef aaa-author-cmd-mode {
    type enumeration {
      enum "invalid" {
        value 0;
        description
          "Specifies that the invalid mode is applied.";
      }
      enum "local" {
        value 1;
        description
          "Specifies that the local mode is applied.";
      }
      enum "hwtacacs" {
        value 2;
        description
          "Specifies that the HWTACACS mode is applied.";
      }
      enum "none" {
        value 3;
        description
          "Specifies that the none mode is applied.";
      }
    }
    description
      "Authorization cmd mode.";
  }
  typedef aaa-acct-mode {
    type enumeration {
      enum "invalid" {
        value 0;
        description
          "Invalid accounting mode.";
      }
      enum "radius" {
        value 1;
        description
          "RADIUS accounting mode.";
      }
      enum "hwtacacs" {
        value 2;
        description
          "HWTACACS accounting mode.";
      }
      enum "none" {
        value 3;
        description
          "In this mode, users do not be accounting.";
      }
      enum "haca" {
        value 4;
        description
          "HACA accounting mode.";
      }
    }
    description
      "Accounting mode.";
  }
  typedef aaa-state-type {
    type enumeration {
      enum "block" {
        value 0;
        description
          "Blocked state.";
      }
      enum "active" {
        value 1;
        description
          "Activated state.";
      }
    }
    description
