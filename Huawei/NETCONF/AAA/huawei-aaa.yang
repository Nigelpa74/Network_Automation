      "Add leaf as-mac.";
    reference
      "Huawei private.";
  }
  revision 2024-05-31 {
    description
      "Add must condition for end-life-date and time-range.";
    reference
      "Huawei private.";
  }
  revision 2024-05-28 {
    description
      "Add must condition for user/name. Modify the type of time-range.";
    reference
      "Huawei private.";
  }
  revision 2024-05-25 {
