module huawei-aaa {
  yang-version 1.1;
  namespace "urn:huawei:yang:huawei-aaa";
  prefix aaa;
  import huawei-hwtacacs {
    prefix hwtacacs;
  }
  import huawei-radius {
    prefix radius;
  }
  import huawei-acl {
    prefix acl;
  }
  import huawei-time-range {
    prefix timerange;
  }
  import huawei-extension {
    prefix ext;
  }
  import ietf-inet-types {
    prefix inet;
  }
  import ietf-yang-types {
    prefix yang;
  }
  import huawei-pub-type {
    prefix pub-type;
  }
  include huawei-aaa-type;
  include huawei-aaa-lam;
  organization
    "Huawei Technologies Co., Ltd.";
  contact
    "Huawei Industrial Base
    Bantian, Longgang
    Shenzhen 518129
    People's Republic of China
    Website: http://www.huawei.com
    Email: support@huawei.com";
  description
    "Security management, which includes the management on authentication, authorization, accounting, domains, and users.";
  revision 2025-08-28 {
    description
      "Add container of syslog-restrain.";
    reference
      "Huawei private.";
  }
  revision 2025-08-15 {
    description
      "Modify the maximum length of change-current-password node.";
    reference
      "Huawei private.";
 }
  revision 2025-06-24 {
    description
      "Modify yang-version 1.1.";
    reference
      "Huawei private.";
  }
  revision 2025-06-05 {
    description
      "Add leaf of password similar-to-name-check-type and modify spelling of words.";
    reference
      "Huawei private.";
  }
  revision 2025-05-12 {
    description
      "Add container of global-user-policy.";
    reference
      "Huawei private.";
  }
  revision 2025-03-28 {
    description
      "Modify the length of the access user name.";
    reference
      "Huawei private.";
  }
  revision 2025-03-10 {
    description
      "Add aaa-lam leaf of virtual-ip and container of bind-address.";
    reference
      "Huawei private.";
  }
  revision 2025-01-23 {
    description
      "Modify description in the leaf of index.";
    reference
      "Huawei private.";
  }
  revision 2024-12-07 {
    description
