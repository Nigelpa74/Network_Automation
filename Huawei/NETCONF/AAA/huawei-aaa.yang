      "Add must condition for complexity-check-four.";
    reference
      "Huawei private.";
  }
  revision 2024-05-24 {
    description
      "Add must condition for password. Modify the must condition of password-type.";
    reference
      "Huawei private.";
  }
  revision 2024-05-13 {
