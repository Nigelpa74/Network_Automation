module zxr10-pm-interface {
  namespace "http://www.zte.com.cn/zxr10/netconf/schema/rosng/pm-interface" ;
  prefix pm-interface ;
  yang-version 1 ;
  import zxr10-netconf-defs {
    prefix ncd ;
  }

  organization "ZTE Corporation" ;
  contact "ZTE Corporation
  Nanjing Institute of ZTE Corporation
  No.68 Zijinghua Rd. Yuhuatai District, Nanjing, China
  Tel: +86-25-52870000" ;
  revision 2025-08-25 {
    description 'increase wavelength config range from 191.15THz, add optical module channel for wavelength state node. ' ;
  }

  revision 2025-07-18 {
    description 'Increase wavelength decimal to 5.' ;
  }

  revision 2025-05-13 {
    description 'Add 99x to optical-module-config.' ;
  }

  revision 2025-04-29 {
    description 'add 59E 99X 5960X 5960M 59X-ES to interface feature flow-control-threshold' ;
  }

  revision 2025-01-02 {
    description 'Add second container in control-flap container.' ;
  }

  revision 2024-11-12 {
    description 'Add sat holdtime.' ;
  }

  revision 2024-11-04 {
    description 'obsolete wavelength-capability.' ;
  }

  revision 2024-10-29 {
    description 'add 59M to interface feature optical-module-config.' ;
  }

  revision 2024-10-16 {
    description 'Add port-alarm mgmt ' ;
  }

  revision 2024-09-20 {
    description 'add enum speed-800G in leaf speed.' ;
  }

  revision 2024-08-15 {
    description 'add pc-test feature, add to wavelength-capability' ;
  }

  revision 2024-06-10 {
    description 'Add wan-config container in eth list and increase interface name filter in wans list.' ;
  }

  revision 2024-06-04 {
    description 'Change the type string of if-name to ncd:ifname in eths, dampings, link-delays and threshold-sd-fers configuration container.' ;
  }

  revision 2024-02-06 {
    description 'Add query port config speed.' ;
  }

  revision 2024-01-23 {
    description 'Add optical-power-detect container.' ;
  }

  revision 2024-01-20 {
    description 'Add split type cgei in split container.' ;
  }

  revision 2023-12-12 {
    description 'Modify the range of 
threshold-error-packet in eth and wan container to 0-65535 and add perfcode in default value.' ;
  }

  revision 2023-11-13 {
    description 'Add split type ccgei in split container.' ;
  }

  revision 2023-10-25 {
    description 'Add wavelength-capability container.' ;
  }

  revision 2023-07-22 {
    description 'Add lan-wan-switch container.' ;
  }

  revision 2023-07-13 {
    description 'Add sdhs container.' ;
  }

  revision 2023-05-19 {
    description 'Add split type lgei in split container.' ;
  }

  revision 2023-01-30 {
    description 'Change the range of recovery-time and interval-time to 86400 of control-flap.' ;
  }

  revision 2022-11-03 {
    description 'Change accuracy of the configuration center frequency.' ;
  }

  revision 2022-10-13 {
    description 'Add leaf fec-enable-para in eth list.' ;
  }

  revision 2022-09-09 {
    description 'Add T8000 to feature optical-module-config,support configuration/pm-if/eths/eth/wavelength.' ;
  }

  revision 2022-08-31 {
    description 'Add flowcontrol off-threshold node to support configure flowcontrol off-threshold.' ;
  }

  revision 2022-08-11 {
    description 'change als status.
change 3,4,dele 5,add 6,7,8,254.' ;
  }

  revision 2022-07-16 {
    description 'Adjust the range of center frequency to 191.3-196.1' ;
  }

  revision 2022-06-05 {
    description 'add eth speed mode "speed-2.5G".' ;
  }

  revision 2022-06-01 {
    description 'add leaf af-node and shelf in list port-status.' ;
  }

  revision 2022-02-09 {
    description 'add 5960M.' ;
  }

  revision 2022-01-21 {
    description 'add port-alarm if-down.' ;
  }

  revision 2021-09-29 {
    description 'add work-mode mtn-fg.' ;
  }

  revision 2021-07-30 {
    description 'add enum line-extend and internal-extend in loopback leaf on eth list and eth-status container.' ;
  }

  revision 2021-07-03 {
    description 'add port-alarm sd-insert.' ;
  }

  revision 2021-05-29 {
    description 'add enum 16-trace-mode-null and 64-trace-mode-null in container flag j0,j0ex,j1,j1ex of wan port.' ;
  }

  revision 2021-04-19 {
    description 'add flexe dcn overhead.' ;
  }

  revision 2021-01-28 {
    description 'Modify the range of holdtime value.' ;
  }

  revision 2021-01-11 {
    description 'add laser-status invalid mode.' ;
  }

  revision 2021-01-05 {
    description 'add flow control on threshold' ;
  }

  revision 2020-09-21 {
    description 'add MTN leaf' ;
  }

  revision 2020-09-14 {
    description 'add single-fiber and link-force' ;
  }

  revision 2020-06-12 {
    description 'add eth speed mode "speed-auto"' ;
  }

  revision 2020-04-28 {
    description 'Add create-vsgs.' ;
  }

  revision 2020-04-01 {
    description 'add enum speed-25G, speed-40G, speed-50G and speed-100G in leaf ulei speed.' ;
  }

  revision 2020-02-25 {
    description 'Add container eee-statisticss,clear-eee-statisticss,control-flap,control-flap-clears,eee-config and optical-inform-monitor.' ;
  }

  revision 2020-02-15 {
    description 'Add contain split.' ;
  }

  revision 2019-06-25 {
    description 'add fec-eth and fec-bypass add center-frequency and obsolete center-freq.' ;
  }

  revision 2019-05-10 {
    description 'add leaf loopback.' ;
  }

  revision 2019-03-05 {
    description 'add optical module config.' ;
  }

  revision 2018-12-12 {
    description 'jumbo add.' ;
  }

  revision 2018-11-14 {
    description 'add work-mode' ;
  }

  revision 2018-09-17 {
    description 'ipg add perfcode.' ;
  }

  revision 2018-09-08 {
    description 'add ipg container delete2reset and modify default value.' ;
  }

  revision 2018-09-06 {
    description 'add port-speed.' ;
  }

  revision 2018-09-03 {
    description 'add enum speed-25G and speed-50G in leaf speed.' ;
  }

  revision 2018-08-16 {
    description 'add port-status.' ;
  }

  revision 2018-07-25 {
    description 'add laser off-reason and modify current-status.' ;
  }

  revision 2018-07-01 {
    description 'add gfp-mplss.' ;
  }

  revision 2018-06-28 {
    description 'add laser-status and loopback-auto-cancel.' ;
  }

  revision 2018-05-28 {
    description 'add ifhaslos.' ;
  }

  revision 2018-05-24 {
    description 'add loopback time.' ;
  }

  revision 2018-03-09 {
    description 'add rf2sf and ipg.' ;
  }

  revision 2017-10-16 {
    description 'add laser-status.' ;
  }

  revision 2017-08-01 {
    description 'add alarm insert sd.' ;
  }

  revision 2017-06-02 {
    description 'add leaf trace-64-value to pos j0 and j0ex' ;
  }

  revision 2016-11-18 {
    description 'add loopback-external' ;
  }

  revision 2016-09-26 {
    description 'leaf loopback modify type for eths wans poss and atms.' ;
  }

  revision 2016-09-10 {
    description 'list port-mode add leaf xgei-gei, leaf lan-wan add parameter pos3 and pos12, leaf pos3-pos12 add parameter lan, wan and gei.' ;
  }

  revision 2016-08-10 {
    description 'add alarm-insert-hp and alarm-insert-ms for atms and poss' ;
  }

  revision 2016-04-15 {
    description 'modify the range of link-delay-up and link-delay-down from 0 to 600000.' ;
  }

  revision 2016-03-15 {
    description 'add b2-sd-ber b2-sf-ber to sdh-threshold, only for atm' ;
  }

  revision 2016-02-29 {
    description 'modify contain threshold-sd-fers leaf occur-exponent and clear-exponent range 1 to 9' ;
  }

  revision 2016-01-20 {
    description 'Add leaf speed-100G and modify the value of speed-40G.' ;
  }

  revision 2015-12-31 {
    description 'modify atm flag c2/c2ex default value
modify pos clock-mode default value' ;
  }

  revision 2015-12-17 {
    description 'leaf recovery-mode add parameter laser-on add laser-off.' ;
  }

  revision 2015-09-06 {
    description 'add contain sdh-thresholds' ;
  }

  feature optical-module-config ;

  feature flow-control-threshold {
    ncd:revise-date 2025-04-29 ;
  }

  feature port-alarm-ifdown {
    description 'add port-alarm-ifdown feature.' ;
    ncd:revise-date 2022-01-21 ;
  }

  feature optical-power-detect {
    description 'Add optical-power-detect feature.' ;
    ncd:revise-date 2024-01-23 ;
  }

  feature pc-test {
    description 'add feature for pc test only.' ;
    ncd:revise-date 2024-08-15 ;
  }

  container configuration {
    container pm-if {
      container eths {
        list eth {
          description 'Ethernet interface mode.' ;
          key if-name ;
          leaf if-name {
            description 'Interface name.' ;
            type ncd:ifname ;

          }

          leaf holdtime {
            description 'Configures the port hold-time.' ;
            type uint16 {
              range 0..3600 {
                description 'Range: 0-3600.' ;
              }

            }

            units second ;
            default 120 ;
          }

          leaf negotiation {
            description 'Configures the port negotiation mode.' ;
            type enumeration {
              enum negotiation-force {
                value 1 ;
                description 'Force negotiation mode.' ;
              }

              enum negotiation-auto {
                value 2 ;
                description 'Auto negotiation mode.' ;
              }

            }

            default negotiation-auto ;
          }

          leaf speed {
            description 'Configures the rate of a port.' ;
            type enumeration {
              enum speed-10M {
                value 1 ;
                description 'Port speed is 10M.' ;
              }

              enum speed-100M {
                value 2 ;
                description 'Port speed is 100M.' ;
              }

              enum speed-1G {
                value 3 ;
                description 'Port speed is 1G.' ;
              }

              enum speed-10G {
                value 4 ;
                description 'Port speed is 10G.' ;
              }

              enum speed-25G {
                value 10 ;
                description 'Port speed is 25G.' ;
              }

              enum speed-40G {
                value 5 ;
                description 'Port speed is 40G.' ;
              }

              enum speed-50G {
                value 11 ;
                description 'Port speed is 50G.' ;
              }

              enum speed-100G {
                value 6 ;
                description 'Port speed is 100G.' ;
              }

              enum speed-200G {
                value 12 ;
                description 'Port speed is 200G.' ;
              }

              enum speed-400G {
                value 13 ;
                description 'Port speed is 400G.' ;
              }

              enum speed-auto {
                value 15 ;
                description 'Port speed is configured to auto, the real speed depend on optical module.' ;
              }

              enum speed-2.5G {
                value 14 ;
                description 'Port speed is 2.5G.' ;
              }
	      
              enum speed-800G {
                value 16 ;
                description 'Port speed is 800G.'
                            ;
              }

            }

            default speed-1G ;
          }

          leaf duplex {
            description 'Configures the Ethernet working mode.' ;
            type enumeration {
              enum duplex-full {
                value 1 ;
                description 'Full duplex mode.' ;
              }

              enum duplex-half {
                value 2 ;
                description 'Half duplex mode.' ;
              }

            }

            default duplex-full ;
          }

          leaf loopback {
            description 'Configures the loopback method of a port.' ;
            type enumeration {
              enum cancel {
                value 0 ;
                description 'Cancel loopback mode.' ;
              }

              enum outer {
                value 1 ;
                description 'Line loopback mode.' ;
              }

              enum inner {
                value 2 ;
                description 'Inner loopback mode.' ;
              }

              enum external {
                value 3 ;
                description 'External loopback mode.' ;
              }

              enum line-extend {
                value 4 ;
                description 'Line loopback mode extension.' ;
              }

              enum internal-extend {
                value 5 ;
                description 'Internal loopback mode extension.' ;
              }

            }

            default cancel ;
          }

          leaf mdimode {
            description 'Configures the MDI/MDI-X function, the XGEI port does not support this configuration when it is in WAN mode.' ;
            type enumeration {
              enum mdimode-mdix {
                value 1 ;
                description 'Switch port to straight-through mode.' ;
              }

              enum mdimode-mdi {
                value 2 ;
                description 'Switch port to crossover mode.' ;
              }

              enum mdimode-auto {
                value 3 ;
                description 'Switch port to auto-cross mode.' ;
              }

            }

            default mdimode-auto ;
          }

          leaf pemode {
            description 'Configures the copper-fiber attribute of a port, the XGEI port does not support this configuration when it is in WAN mode.' ;
            type enumeration {
              enum media-copper {
                value 1 ;
                description 'The PEMode of the port is electric.' ;
              }

              enum media-fiber {
                value 2 ;
                description 'The PEMode of the port is optical.' ;
              }

            }

            default media-fiber ;
          }

          leaf threshold-error-packet {
            description 'Sets the alarm threshold for port errors.' ;
            type uint16 {
              range 0..65535 {
                description 'The number of error packets.' ;
              }

            }

            default 3 ;
          }

          leaf unidirection {
            description 'Configures an unframing channel.' ;
            type enumeration {
              enum disable {
                value 1 ;
                description 'Unidirection disable.' ;
              }

              enum enable {
                value 2 ;
                description 'Unidirection enable' ;
              }

            }

            default disable ;
          }

          leaf rf2sf {
            description 'Configures rf2sf, the XGEI port does not support this configuration when it is in WAN mode.' ;
            type enumeration {
              enum enable {
                value 1 ;
                description 'rf2sf enable' ;
              }

              enum disable {
                value 0 ;
                description 'rf2sf diable' ;
              }

            }

            default enable ;
            ncd:revise-date 2018-03-09 ;
          }

          container laser-status {
            leaf status {
              description 'Open/close laser or set recover mode of ALS status.' ;
              type enumeration {
                enum on {
                  value 1 ;
                  description 'Open laser.' ;
                }

                enum off {
                  value 2 ;
                  description 'Close laser.' ;
                }

                enum auto-recovery {
                  value 3 ;
                  description 'Set recover mode is auto-recovery.' ;
                }

                enum manual-recovery {
                  value 4 ;
                  description 'Set recover mode is manual-recovery.' ;
                }

                enum invalid {
                  value 0 ;
                  description 'The invalid value of laser-status mode.' ;
                }

              }

              default on ;
            }

            leaf period {
              description 'Start period of automatic.' ;
              type uint16 {
                range 20..600 {
                  description 'Range: 20-600.' ;
                }

              }

              units second ;
              default 100 ;
            }

            leaf pulsewidth {
              description 'Start pulse wide of automatic.' ;
              type uint8 {
                range 1..20 {
                  description 'Range: 1-20.' ;
                }

              }

              units second ;
              default 2 ;
            }

            leaf testpulsewidth {
              description 'Start pulse wide of testing.' ;
              type uint8 {
                range 50..200 {
                  description 'Range: 50-200.' ;
                }

              }

              units second ;
              default 90 ;
            }

            leaf offtime {
              description 'Time of laser reopen, unit is second' ;
              type uint32 {
                range 0..65535 {
                  description 'laser status off times (s)' ;
                }

              }

              units second ;
              default 0 ;
            }

          }

          leaf flow-ctr-receive {
            description 'Flow control receive, the XGEI port does not support this configuration when it is in WAN mode.' ;
            type enumeration {
              enum disable {
                value 1 ;
                description 'Disable receive flow control.' ;
              }

              enum enable {
                value 2 ;
                description 'Enable receive flow control.' ;
              }

            }

            default disable ;
          }

          leaf flow-ctrl-send {
            description 'Flow control send, the XGEI port does not support this configuration when it is in WAN mode.' ;
            type enumeration {
              enum disable {
                value 1 ;
                description 'Disable send flow control.' ;
              }

              enum enable {
                value 2 ;
                description 'Enable send flow control.' ;
              }

            }

            default disable ;
          }

          leaf jumbo {
            description 'Configures jumbo, the XGEI port does not support this configuration when it is in WAN mode.' ;
            type enumeration {
              enum disable {
                value 1 ;
                description 'Jumbo disable.' ;
              }

              enum enable {
                value 2 ;
                description 'Jumbo enable.' ;
              }

            }

            default enable ;
            ncd:revise-date 2018-12-12 ;
          }

          leaf jumbo-size {
            description 'Configures jumbo size, the XGEI port does not support this configuration when it is in WAN mode.' ;
            type uint32 ;

            default 9216 ;
            ncd:revise-date 2018-12-12 ;
          }

          leaf master-slave-mode {
            description 'Set clock negotiation mode of interface, the XGEI port does not support this configuration when it is in WAN mode.' ;
            type enumeration {
              enum master {
                value 1 ;
                description 'Master mode.' ;
              }

              enum slave {
                value 2 ;
                description 'Slave mode.' ;
              }

              enum auto {
                value 3 ;
                description 'Auto mode.' ;
              }

            }

            default auto ;
          }

          leaf fec-eth {
            description 'Configures fec of a port, the XGEI port does not support this configuration when it is in WAN mode.' ;
            type enumeration {
              enum enable {
                value 1 ;
                description 'enable.' ;
              }

              enum disable {
                value 2 ;
                description 'disable.' ;
              }

              enum auto {
                value 3 ;
                description 'auto.' ;
              }

              enum invalid {
                value 0 ;
                description 'invalid' ;
              }

            }

            default invalid ;
            ncd:revise-date 2019-06-25 ;
          }

          container alarm-insert {
            description 'Configure alarm insert, the XGEI port does not support this configuration when it is in WAN mode.' ;
            leaf alarm-insert-sd {
              description 'Alarm insert SD.' ;
              type empty ;

            }

            ncd:revise-date 2017-08-01 ;
          }

          container ipg-config {
            description 'Configure ipg.' ;
            leaf ipg {
              description 'ipg' ;
              type uint16 {
                range 0..255 {
                  description 'ipg rang value and default value configured by perfcode.' ;
                }

              }

              default 12 ;
            }

            ncd:revise-date 2018-03-09 ;
          }

          container loopback-time {
            description 'Configure loopback time.' ;
            choice effective-time {
              case timeliness {
                leaf permanent {
                  description 'Loopback config permanent effective' ;
                  type empty ;

                }

              }

              case date-time {
                leaf begin-date {
                  description 'Begin date from 1-1-2001 to 12-31-2037' ;
                  type ncd:date ;

                  mandatory true ;
                }

                leaf begin-time {
                  description 'Begin time' ;
                  type ncd:time ;

                  mandatory true ;
                }

                leaf end-date {
                  description 'End date from 1-1-2001 to 12-31-2037' ;
                  type ncd:date ;

                  mandatory true ;
                }

                leaf end-time {
                  description 'End time' ;
                  type ncd:time ;

                  mandatory true ;
                }

              }

            }

          }

          container work-mode-config {
            description 'Configure work mode, the XGEI port does not support this configuration when it is in WAN mode.' ;
            leaf work-mode {
              description 'Ethernet working mode.' ;
              type enumeration {
                enum eth {
                  value 1 ;
                  description 'Work mode is eth' ;
                }

                enum flexe {
                  value 2 ;
                  description 'Work mode is flexe' ;
                }

                enum mtn-fg {
                  value 3 ;
                  description 'Work mode is mtn-fg' ;
                }

              }

              default eth ;
            }

            ncd:revise-date 2018-11-14 ;
          }

          container optical-module-config {
            if-feature optical-module-config ;

            description 'Configure optical module, the XGEI port does not support this configuration when it is in WAN mode.' ;
            leaf fec-mode {
              if-feature optical-module-config ;

              description 'Configure fec mode for interface' ;
              type enumeration {
                enum GFEC {
                  value 12 ;
                  description 'OTU-4 G.709 FEC' ;
                }

                enum OTNnoFEC {
                  value 18 ;
                  description 'OTU-4 Transparent mode' ;
                }

                enum HD-FEC1 {
                  value 48 ;
                  description 'OTU-4 7% Staircase HD-FEC' ;
                }

                enum SD-FECy-DIFF-15 {
                  value 53 ;
                  description '15% SD-FEC Everest Compatible' ;
                }

                enum SD-FECy-NONDIFF-15 {
                  value 85 ;
                  description '15% SD-FEC Denali Compatible' ;
                }

              }

            }

            leaf optical-power-adjust {
              if-feature optical-module-config ;

              description 'Configure optical power for interface' ;
              type int32 {
                range -2000..1000 {
                  description 'Optical power(0.01dbm, must be a multiple of 10)' ;
                }

              }

            }

            container wavelength {
              if-feature optical-module-config ;

              description 'Configure wavelength for interface' ;
              presence wavelength ;
              leaf translation-mode {
                if-feature optical-module-config ;

                description 'Configure translation mode for interface' ;
                type enumeration {
                  enum dwdm {
                    value 1 ;
                  }

                  enum cwdm {
                    value 3 ;
                  }

                }

                mandatory true ;
              }

              leaf center-frequency {
                if-feature optical-module-config ;

                description 'Configure center frequency for interface.The range is 191.15000-196.10000.' ;
                type decimal64 {
                  fraction-digits 5 ;
                  range 191.15000..196.10000 ;

                }

                mandatory true ;
                ncd:revise-date 2019-06-25 ;
              }

              leaf center-freq {
                if-feature optical-module-config ;

                status obsolete {
                  ncd:revise-date 2019-06-25 ;
                }

                description 'Configure center frequency for interface.The range is 191.3-196.1.' ;
                type string ;

                mandatory true ;
              }

            }

            container wavelength-capability {
              leaf spacing {
                if-feature pc-test {
                  ncd:revise-date 2023-10-25 ;
                }

                mandatory true ;
                type enumeration {
                  enum 50G-Spacing {
                    value 1 ;
                  }

                  enum 6.25G-Spacing {
                    value 2 ;
                  }

                }

                description 'Configurable frequency spacing, such as 50GHz, 6.25GHz.' ;
                status obsolete ;

              }

              choice configtype {
                if-feature pc-test {
                  ncd:revise-date 2023-10-25 ;
                }

                case center-frequency {
                  if-feature pc-test {
                    ncd:revise-date 2023-10-25 ;
                  }

                  leaf center-freq {
                    type empty ;

                    mandatory true ;
                    description 'Configure with frequency.' ;
                    if-feature pc-test {
                      ncd:revise-date 2023-10-25 ;
                    }

                  }

                  leaf freq-value {
                    mandatory true ;
                    if-feature pc-test {
                      ncd:revise-date 2023-10-25 ;
                    }

                    type int32 {
                      range 191150000..196100000 ;

                    }

                    description 'Integer frequency value, in range of 191150000 to 196100000, such as 191320000 representing 191.32THz.
For details, Please execute the show wavelength-capability command to view more configurable frequencies.' ;
                  }

                }

                case wavelength {
                  if-feature pc-test {
                    ncd:revise-date 2023-10-25 ;
                  }

                  leaf wavelength {
                    if-feature pc-test {
                      ncd:revise-date 2023-10-25 ;
                    }

                    mandatory true ;
                    description 'Configure with wavelength.' ;
                    type empty ;

                  }

                  leaf wavelength-value {
                    if-feature pc-test {
                      ncd:revise-date 2023-10-25 ;
                    }

                    type uint32 {
                      range 152877300..156836200 ;

                    }

                    mandatory true ;
                    description 'Integer wavelength value, in range of 152877300 to 156836200, such as 152877300 representing 1528.773nm.
For details, Please execute the show wavelength-capability command to view more configurable wavelengths.' ;
                  }

                }

                case channel {
                  if-feature pc-test {
                    ncd:revise-date 2023-10-25 ;
                  }

                  leaf channel-index {
                    type empty ;

                    if-feature pc-test {
                      ncd:revise-date 2023-10-25 ;
                    }

                    mandatory true ;
                    description 'Configure with channel number index.' ;
                  }

                  leaf channel-value {
                    if-feature pc-test {
                      ncd:revise-date 2023-10-25 ;
                    }

                    type uint32 {
                      range 1..793 ;

                    }

                    mandatory true ;
                    description 'It is the channel number index displayed in the show wavelength-capability command, with one frequency (wavelength) corresponding to one channel number. 
The range of 50GHz spacing is 1-100, and the range of 6.25GHz spacing is 1-793.' ;
                  }

                }

                mandatory true ;
              }

              presence wavelength-capability ;
              description 'Configure wavelength for interface by frequency,wavelength,channel index.' ;
              status obsolete {
                ncd:revise-date 2024-11-04 ;
              }

              if-feature pc-test {
