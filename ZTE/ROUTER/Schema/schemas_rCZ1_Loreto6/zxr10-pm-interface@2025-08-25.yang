                  value 0 ;
                  description 'Disable optical information monitor.' ;
                }

                enum enable {
                  value 1 ;
                  description 'Enable optical information monitor.' ;
                }

              }

              default disable ;
            }

            ncd:revise-date 2020-02-25 ;
          }

          container control-flap {
            description 'Interface control flap auto or manual recovery, the XGEI port does not support this configuration when it is in WAN mode.' ;
            presence control-flap ;
            choice recovery-mode {
              description 'Configure recovery mode.' ;
              mandatory true ;
              case automode {
                leaf auto {
                  description 'Configure interface auto recovery of control flap.' ;
                  type empty ;

                  mandatory true ;
                }

                leaf recovery-time {
                  description 'Configure interface recovery time of control flap.' ;
                  type uint32 {
                    range 1..86400 ;

                  }

                  mandatory true ;
                }

              }

              case forcemode {
                leaf force {
                  description 'Configure interface manual recovery of control flap.' ;
                  type empty ;

                  mandatory true ;
                }

              }

            }

            leaf interval-unit {
              description 'Configure the unit to second or millisecond.' ;
              type enumeration {
                enum s {
                  value 0 ;
                  description 'The control flap unit of time is second.' ;
                }

                enum ms {
                  value 1 ;
                  description 'The control flap unit of time is millisecond.' ;
                }

              }

              mandatory true ;
            }

            leaf threshold-times {
              description 'The threshold times of interface.' ;
              type uint16 {
                range 1..20000 ;

              }

              mandatory true ;
            }

            leaf interval-time {
              description 'The interval time of interface.' ;
              type uint32 {
                range 1..86400 ;

              }

              mandatory true ;
            }

            container second {
              description 'Second threshold-times and interval-time.' ;
              presence second ;
              leaf threshold-times {
                type uint16 {
                  range 1..20000 ;

                }

                description 'The second threshold times of interface.' ;
                mandatory true ;
              }

              leaf interval-time {
                type uint32 {
                  range 1..86400 ;

                }

                description 'The second interval time of interface.' ;
                mandatory true ;
              }

