              enum af21 {
                value 4 ;
              }

              enum af22 {
                value 5 ;
              }

              enum af31 {
                value 6 ;
              }

              enum af32 {
                value 7 ;
              }

              enum af41 {
                value 8 ;
              }

              enum af42 {
                value 9 ;
              }

              enum cs6 {
                value 10 ;
              }

              enum cs7 {
                value 11 ;
              }

              enum ef {
                value 12 ;
              }

              enum invalid {
                value 0 ;
              }

            }

            default ef ;
          }

          ncd:revise-date 2021-07-03 ;
        }

      }

      container sdhs {
        list sdh {
          key if-name ;
          leaf if-name {
            description 'Interface name.' ;
            type string ;

          }

          container delay {
            leaf clear {
              description 'Configure time value for SDH alarm clear.' ;
              type uint32 {
                range "0|200..300000" ;

              }

              units ms ;
            }

            leaf trigger {
              description 'Configure time value for SDH alarm trigger.' ;
              type uint16 {
                range "0|20..10000" ;

              }

              units ms ;
            }

          }

          container threshold {
            leaf b1-tca {
              description 'Configure B1 BER threshold crossing alarm.' ;
              type uint8 {
                range 3..9 ;

              }

              default 6 ;
            }

            leaf b2-tca {
              description 'Configure B2 BER threshold crossing alarm.' ;
              type uint8 {
                range 3..9 ;

              }

              default 6 ;
            }

            leaf b3-tca {
              description 'Configure B3 BER threshold crossing alarm.' ;
              type uint8 {
                range 3..9 ;

              }

              default 6 ;
            }

          }

          container if-down {
            description 'Configure SDH alarms which will trigger port down.' ;
            leaf los {
              description 'Configure whether LOS alarm triggers interface physical down.' ;
              type uint8 {
                range 0..1 ;

              }

              default 1 ;
            }

            leaf lof {
              description 'Configure whether LOF alarm triggers interface physical down.' ;
              type uint8 {
                range 0..1 ;

              }

              default 1 ;
            }

            leaf b1-tca {
              description 'Configure whether B1-TCA alarm triggers interface physical down.' ;
              type uint8 {
                range 0..1 ;

              }

              default 0 ;
            }

            leaf b2-tca {
              description 'Configure whether B2-TCA alarm triggers interface physical down.' ;
              type uint8 {
                range 0..1 ;

              }

              default 0 ;
            }

            leaf b3-tca {
              description 'Configure whether B3-TCA alarm triggers interface physical down.' ;
              type uint8 {
                range 0..1 ;

              }

              default 0 ;
            }

            leaf lais {
              description 'Configure whether LAIS alarm triggers interface physical down.' ;
              type uint8 {
                range 0..1 ;

              }

              default 1 ;
            }

            leaf lrdi {
              description 'Configure whether LRDI alarm triggers interface physical down.' ;
              type uint8 {
                range 0..1 ;

              }

              default 0 ;
            }

            leaf sd-ber {
              description 'Configure whether SD-BER alarm triggers interface physical down.' ;
              type uint8 {
                range 0..1 ;

              }

              default 0 ;
            }

            leaf sf-ber {
              description 'Configure whether SF-BER alarm triggers interface physical down.' ;
              type uint8 {
                range 0..1 ;

              }

              default 0 ;
            }

            leaf pais {
              description 'Configure whether PAIS alarm triggers interface physical down.' ;
              type uint8 {
                range 0..1 ;

              }

              default 0 ;
            }

            leaf plop {
              description 'Configure whether PLOP alarm triggers interface physical down.' ;
              type uint8 {
                range 0..1 ;

              }

              default 0 ;
            }

            leaf prdi {
              description 'Configure whether PRDI alarm triggers interface physical down.' ;
              type uint8 {
                range 0..1 ;

              }

              default 0 ;
            }

            leaf pplm {
              description 'Configure whether PPLM alarm triggers interface physical down.' ;
              type uint8 {
                range 0..1 ;

              }

              default 0 ;
            }

            leaf puneq {
              description 'Configure whether PUNEQ alarm triggers interface physical down.' ;
              type uint8 {
                range 0..1 ;

              }

              default 0 ;
            }

          }

        }

        ncd:revise-date 2023-07-13 ;
      }

      container lan-wan-switch {
        leaf switch {
          type enumeration {
            enum off {
              value 0 ;
              description 'Name change after configuring port-mode LAN/WAN.' ;
            }

            enum on {
              value 1 ;
              description 'Name unchange after configuring port-mode LAN/WAN.' ;
            }

          }

          default off ;
        }

        ncd:revise-date 2023-07-22 ;
      }

      container mgmts {
        list mgmt {
          leaf if-name {
            type ncd:ifname ;

            description 'Interface name.' ;
          }

          leaf alarm-down {
            type enumeration {
              enum enable {
                value 1 ;
              }

              enum disable {
                value 2 ;
              }

            }

            description 'Configure whether an alarm occurs when the management port goes down.' ;
          }

          key if-name ;
        }

        ncd:revise-date 2024-10-16 ;
      }

    }

    container flexe-dcn-oh {
      leaf global-dcn-oh {
        description 'All port dcn overhead.' ;
        type enumeration {
          enum shim-to-shim {
            value 1 ;
            description 'Flexe dcn section overhead.' ;
          }

          enum section {
            value 0 ;
            description 'Flexe dcn shim-to-shim overhead.' ;
          }

        }

        default section ;
      }

      list port-dcn-oh {
        key if-name ;
        leaf if-name {
          description 'Interface name.' ;
          type ncd:ifname ;

        }

        leaf dcn-oh {
          description 'Port dcn overhead.' ;
          type enumeration {
            enum shim-to-shim {
              value 1 ;
              description 'Flexe dcn section overhead.' ;
            }

            enum section {
              value 0 ;
              description 'Flexe dcn shim-to-shim overhead.' ;
            }

          }

          default section ;
        }

      }

      ncd:revise-date 2021-04-19 ;
    }

  }

  container operation {
    config false ;
    container pm-if {
      container start-alss {
        list start-als {
          key if-name ;
          leaf if-name {
            description 'Interface name.' ;
            type string ;

          }

          leaf als {
            description 'Set recovery mode.' ;
            type enumeration {
              enum manual {
                value 0 ;
                description 'Manual impulse.' ;
              }

              enum testing {
                value 1 ;
                description 'Testing impulse.' ;
              }

            }

          }

        }

      }

      container expire-holdtimes {
        list expire-holdtime {
          key if-name ;
          leaf if-name {
            description 'Interface name.' ;
            type string ;

          }

        }

      }

      container clear-eee-statisticss {
        description 'Clear eee statistics.' ;
        list clear-eee-statistics-interface {
          description 'Clear eee statistics by ifname.' ;
          key if-name ;
          leaf if-name {
            description 'Interface name.' ;
            type string ;

          }

        }

        list clear-eee-statistics-pfu {
          description 'Clear eee statistics by pfu.' ;
          key 'shelf boardtype panel' ;
          leaf shelf {
            description 'Shelf number.' ;
            type uint8 {
              range 0..254 ;

            }

          }

          leaf boardtype {
            description 'Board type.' ;
            type enumeration {
              enum MPU {
                value 1 ;
              }

              enum PFU {
                value 3 ;
              }

              enum SFU {
                value 4 ;
              }

            }

          }

          leaf panel {
            description 'Panel number of line-card.' ;
            type string ;

          }

        }

        ncd:revise-date 2020-02-25 ;
      }

      container control-flap-clears {
        description 'Clear control flap of interface.' ;
        list control-flap-clear {
          description 'Clear control flap of interface.' ;
          key if-name ;
          leaf if-name {
            description 'Interface name.' ;
            type string ;

          }

        }

        ncd:revise-date 2020-02-25 ;
      }

    }

  }

  container state {
    config false ;
    container pm-if {
      container als-statuss {
        list als-status {
          key if-name ;
          leaf if-name {
            type string ;

          }

          leaf als-flag {
            type enumeration {
              enum on {
                value 0 ;
              }

              enum off {
                value 1 ;
              }

            }

          }

          leaf recovery-mode {
            type enumeration {
              enum automatic-recovery {
                value 0 ;
              }

              enum manual-recovery {
                value 1 ;
              }

              enum laser-on {
                value 2 ;
              }

              enum laser-off {
                value 3 ;
              }

            }

          }

          leaf current-status {
            description 'The current status of the laser' ;
            type enumeration {
              enum ALS {
                value 0 ;
              }

              enum normal {
                value 1 ;
              }

            }

          }

          leaf laser-status {
            type enumeration {
              enum unkonwn {
                value 0 ;
              }

              enum off {
                value 1 ;
              }

              enum on {
                value 2 ;
              }

            }

            ncd:revise-date 2017-10-16 ;
          }

          leaf off-reason {
            description 'The reason of the laser power off' ;
            type enumeration {
              enum power-on-laser {
                value 0 ;
              }

              enum power-off-laser {
                value 1 ;
              }

              enum power-off-als {
                value 2 ;
              }

              enum power-off-delayup {
                value 3 ;
              }

              enum power-off-shutdown {
                value 4 ;
              }

              enum power-off-cfgshutdown {
                value 6 ;
              }

              enum power-off-los {
                value 5 ;
              }

              enum power-off-loopback-interalex {
                value 8 ;
              }

              enum power-off-unknown {
                value 254 ;
              }

              enum power-off-lst {
                value 203 ;
              }

              enum power-off-hwerror {
                value 204 ;
              }

              enum power-off-los-ex {
                value 7 ;
                description 'The true reported value, converted to 5 to ensure compatibility.' ;
              }

            }

          }

        }

      }

      container damp-statuss {
        list damp-status {
          key if-name ;
          leaf if-name {
            type string ;

          }

          leaf flap-number {
            type uint32 ;

          }

          leaf damp-number {
            type uint32 ;

          }

          leaf penalty {
            type uint32 ;

          }

          leaf max-penalty {
            type uint32 ;

          }

          leaf suppress {
            type enumeration {
              enum FALSE {
                value 0 ;
              }

              enum TRUE {
                value 1 ;
              }

            }

          }

        }

      }

      container port-statuss {
        list port-status {
          key if-name ;
          leaf if-name {
            description 'Interface name.' ;
            type string ;

          }

          leaf portphystatus {
            description 'Port physical status.' ;
            type enumeration {
              enum up {
                value 0 ;
                description 'up.' ;
              }

              enum down {
                value 1 ;
                description 'down.' ;
              }

              enum offline {
                value 32 ;
                description 'offline.' ;
              }

            }

          }

          leaf af-node {
            description 'Port af-node name.' ;
            type ncd:af-name {
              length 0..32 ;

            }

            ncd:revise-date 2022-06-01 ;
          }

          leaf shelf {
            description 'Port shelf no.' ;
            type uint8 {
              range 0..255 ;

            }

            ncd:revise-date 2022-06-01 ;
          }

        }

        ncd:revise-date 2018-08-16 ;
      }

      container eth-statuss {
        list eth-status {
          key if-name ;
          leaf if-name {
            description 'Interface name.' ;
            type string ;

          }

          leaf ifhaslos {
            type enumeration {
              enum no {
                value 0 ;
                description 'no.' ;
              }

              enum yes {
                value 1 ;
                description 'yes.' ;
              }

            }

          }

          leaf loopback {
            description 'Query the loopback mode of a port.' ;
            type enumeration {
              enum cancel {
                value 0 ;
                description 'Cancel loopback mode.' ;
              }

              enum outer {
                value 1 ;
                description 'Line loopback mode.' ;
              }

              enum inner {
                value 2 ;
                description 'Inner loopback mode.' ;
              }

              enum external {
                value 3 ;
                description 'External loopback mode.' ;
              }

              enum line-extend {
                value 4 ;
                description 'Line loopback mode extension.' ;
              }

              enum internal-extend {
                value 5 ;
                description 'Internal loopback mode extension.' ;
              }

            }

          }

          ncd:revise-date 2019-05-10 ;
        }

      }

      container eee-statisticss {
        description 'Show eee statistics.' ;
        list eee-statistics-interface {
          description 'Show eee statistics of interface.' ;
          key if-name ;
          leaf if-name {
            description 'Interface name.' ;
            type string ;

          }

          leaf txevents {
            type uint32 ;

          }

          leaf txduration {
            type uint32 ;

          }

          leaf rxevents {
            type uint32 ;

          }

          leaf rxduration {
            type uint32 ;

          }

        }

        list eee-statistics-pfu {
          description 'Show eee statistics of board.' ;
          key 'shelf boardtype panel' ;
          leaf shelf {
            description 'Shelf number.' ;
            type uint8 ;

          }

          leaf boardtype {
            description 'Board type.' ;
            type enumeration {
              enum MPU {
                value 1 ;
              }

              enum PFU {
                value 3 ;
              }

              enum SFU {
                value 4 ;
              }

              enum UNKNOWN {
                value 255 ;
              }

            }

          }

          leaf panel {
            description 'Panel number.' ;
            type string ;

          }

          leaf if-name {
            description 'Interface name.' ;
            type string ;

          }

          leaf txevents {
            type uint32 ;

          }

          leaf txduration {
            type uint32 ;

          }

          leaf rxevents {
            type uint32 ;

          }

          leaf rxduration {
            type uint32 ;

          }

        }

        ncd:revise-date 2020-02-25 ;
      }

      container mtn-statuss {
        list mtn-status {
          key if-name ;
          leaf if-name {
            description 'Interface name.' ;
            type string ;

          }

          leaf portphystatus {
            description 'Port physical status.' ;
            type enumeration {
              enum up {
                value 0 ;
                description 'up.' ;
              }

              enum down {
                value 1 ;
                description 'down.' ;
              }

              enum offline {
                value 32 ;
                description 'offline.' ;
              }

            }

          }

          leaf group-id {
            type uint32 ;

          }

          leaf fec-mode {
            description 'fec of a port.' ;
            type enumeration {
              enum enable {
                value 1 ;
                description 'enable.' ;
              }

              enum disable {
                value 2 ;
                description 'disable.' ;
              }

              enum auto {
                value 3 ;
                description 'auto.' ;
              }

              enum invalid {
                value 0 ;
                description 'invalid' ;
              }

            }

          }

        }

        ncd:revise-date 2020-09-21 ;
      }



      container port-speed-infos {
        list port-speed-info {
          leaf if-name {
            type ncd:ifname {
              length 1..31 {
                description Ifname ;
              }
            }

            description 'Interface name.' ;
          }

          leaf current-speed {
            description 'Port current speed.' ;
            type uint32 ;

            units Mbs ;
          }

          leaf adjustable-speed {
            type string ;

            description 'Interface adjustable speed.' ;
          }

          key if-name ;
        }

        ncd:revise-date 2024-02-06 ;
      }
    }

  }


  rpc fec-bypass {
    description 'RPC Operation' ;
    input {
      leaf if-name {
        config false ;
        description 'Interface name.' ;
        type string ;

        mandatory true ;
      }

      leaf bypass-status {
        config false ;
        description 'Set fec bypass.' ;
        type enumeration {
          enum enable {
            value 1 ;
            description 'enable.' ;
          }

          enum disable {
            value 2 ;
            description 'disable.' ;
          }

        }

        mandatory true ;
      }

    }

  }

  notification event {
    container loopback-auto-cancel {
      config false ;
      description 'Loopback auto cancel event.' ;
      leaf ifname {
        description 'Interface name.' ;
        type string ;

      }

    }

  }

}
