                      value 3 ;
                    }

                  }

                  description 'Specify the ACL type.' ;
                }

                leaf acl-name {
                  type string {
                    length 1..31 ;

                  }

                  description 'Specify the ACL name.' ;
                }

                container destination {
                  choice destination {
                    case interface {
                      if-feature uni-acl-intf-feature ;

                      container interface {
                        leaf interface-name {
                          type ncd:ifname ;

                          description 'Specify the interface name.' ;
                          mandatory true ;
                        }

                        container remote-monitor {
                          if-feature uni-acl-remote-vlan-feature ;

                          leaf vlan-id {
                            type uint16 {
                              range 1..4094 {
                                description 'RSPAN VLAN ID' ;
                              }

                            }

                            description 'Configure the VLAN ID of RSPAN.' ;
                            mandatory true ;
                          }

                          container tpid-priority {
                            leaf tpid {
                              type enumeration {
                                enum 0x8100 {
                                  value 1 ;
                                }

                                enum 0x88A8 {
                                  value 2 ;
                                }

                                enum 0x9100 {
                                  value 3 ;
                                }

                                enum 0x9200 {
                                  value 4 ;
                                }

                              }

                              description 'Configure the MAC header TPID.' ;
                              default 0x8100 ;
                            }

                            leaf priority {
                              type uint8 {
                                range 0..7 ;

                              }

                              description 'Configure the priority, the larger the value, the higher the priority.' ;
                              default 0 ;
                            }

                            description 'Configure the TPID and priority.' ;
                          }

                          description 'Configure remote monitor.' ;
                          presence "Configuration rspan" ;
                        }

                        description 'The type of MONITOR destination is interface.' ;
                      }

                      description 'The type of MONITOR destination is interface.' ;
                    }

                    case vpws {
                      if-feature uni-acl-vpws-feature ;

                      container vpws {
                        leaf vpws-name {
                          type string {
                            length 1..32 ;

                          }

                          description 'Specify the VPWS name.' ;
                          mandatory true ;
                        }

                        description 'The type of MONITOR destination is VPWS.' ;
                      }

                      description 'The type of MONITOR destination is VPWS.' ;
                    }

                    case gre {
                      if-feature uni-acl-gre-feature ;

                      container gre {
                        leaf gre-interface {
                          type ncd:ifname ;

                          description 'Specify the GRE tunnel interface.' ;
                          mandatory true ;
                        }

                        description 'The type of MONITOR destination is GRE tunnel.' ;
                      }

                      description 'The type of MONITOR destination is GRE tunnel.' ;
                    }

                    case cpu {
                      if-feature uni-acl-cpu-feature ;

                      container cpu {
                        leaf cpu {
                          type empty ;

                          description 'Specify CPU destination.' ;
                          mandatory true ;
                        }

                        description 'The type of MONITOR destination is CPU.' ;
                      }

                      description 'The type of MONITOR destination is CPU.' ;
                    }

                    description 'Specify the destination.' ;
                    mandatory true ;
                  }

                  description 'Specify the destination.' ;
                }

                description 'Specify one-to-one link ACL destination.' ;
                key 'acl-type acl-name' ;
              }

              description 'Specify one-to-one link ACL destination.' ;
            }

            container uni-acl-destination-ipv4-mixeds {
              if-feature uni-acl-ipv4-mixed-feature ;

              list uni-acl-destination-ipv4-mixed {
                leaf acl-type {
                  type enumeration {
                    enum ipv4-mixed-acl {
                      value 4 ;
                    }

                  }

                  description 'Specify the ACL type.' ;
                }

                leaf acl-name {
                  type string {
                    length 1..31 ;

                  }

                  description 'Specify the ACL name.' ;
                }

                container destination {
                  choice destination {
                    case interface {
                      if-feature uni-acl-intf-feature ;

                      container interface {
                        leaf interface-name {
                          type ncd:ifname ;

                          description 'Specify the interface name.' ;
                          mandatory true ;
                        }

                        container remote-monitor {
                          if-feature uni-acl-remote-vlan-feature ;

                          leaf vlan-id {
                            type uint16 {
                              range 1..4094 {
                                description 'RSPAN VLAN ID' ;
                              }

                            }

                            description 'Configure the VLAN ID of RSPAN.' ;
                            mandatory true ;
                          }

                          container tpid-priority {
                            leaf tpid {
                              type enumeration {
                                enum 0x8100 {
                                  value 1 ;
                                }

                                enum 0x88A8 {
                                  value 2 ;
                                }

                                enum 0x9100 {
                                  value 3 ;
                                }

                                enum 0x9200 {
                                  value 4 ;
                                }

                              }

                              description 'Configure the MAC header TPID.' ;
                              default 0x8100 ;
                            }

                            leaf priority {
                              type uint8 {
                                range 0..7 ;

                              }

                              description 'Configure the priority, the larger the value, the higher the priority.' ;
                              default 0 ;
                            }

                            description 'Configure the TPID and priority.' ;
                          }

                          description 'Configure remote monitor.' ;
                          presence "Configuration rspan" ;
                        }

                        description 'The type of MONITOR destination is interface.' ;
                      }

                      description 'The type of MONITOR destination is interface.' ;
                    }

                    case vpws {
                      if-feature uni-acl-vpws-feature ;

                      container vpws {
                        leaf vpws-name {
                          type string {
                            length 1..32 ;

                          }

                          description 'Specify the VPWS name.' ;
                          mandatory true ;
                        }

                        description 'The type of MONITOR destination is VPWS.' ;
                      }

                      description 'The type of MONITOR destination is VPWS.' ;
                    }

                    case gre {
                      if-feature uni-acl-gre-feature ;

                      container gre {
                        leaf gre-interface {
                          type ncd:ifname ;

                          description 'Specify the GRE tunnel interface.' ;
                          mandatory true ;
                        }

                        description 'The type of MONITOR destination is GRE tunnel.' ;
                      }

                      description 'The type of MONITOR destination is GRE tunnel.' ;
                    }

                    case cpu {
                      if-feature uni-acl-cpu-feature ;

                      container cpu {
                        leaf cpu {
                          type empty ;

                          description 'Specify CPU destination.' ;
                          mandatory true ;
                        }

                        description 'The type of MONITOR destination is CPU.' ;
                      }

                      description 'The type of MONITOR destination is CPU.' ;
                    }

                    description 'Specify the destination.' ;
                    mandatory true ;
                  }

                  description 'Specify the destination.' ;
                }

                description 'Specify one-to-one IPv4 mixed ACL destination.' ;
                key 'acl-type acl-name' ;
              }

              description 'Specify one-to-one IPv4 mixed ACL destination.' ;
            }

            ncd:revise-date 2023-08-30 ;
          }

          container service-class {
            presence "Service class" ;
            description 'Specify the service class of packets.' ;
            if-feature service-class-feature ;

            leaf service-class {
              type uint8 {
                range 0..7 ;

              }

              mandatory true ;
              description 'Specify the service class of packets.' ;
            }

            ncd:revise-date 2024-05-21 ;
          }

        }

      }

      container rate-limits {
        description 'MONITOR rate limit configuration.' ;
        list rate-limit {
          description 'MONITOR rate limit configuration list.' ;
          key board-name ;
          leaf board-name {
            description 'The board name supported rate limit by monitor.' ;
            type ncd:board {
              length 1..35 ;

            }

          }

          leaf cir {
            description 'Configure Committed Information Rate value,Unit is Mbps.' ;
            type uint32 {
              range 1..80000 {
                description 'CIR value(Mbps)' ;
              }

            }

            mandatory true ;
          }

          leaf cbs {
            description 'Configure Committed Burst Size value, default unit is MB.' ;
            type uint32 {
              range 1..16000 {
                description 'CBS value(MB)' ;
              }

            }

            mandatory true ;
          }

          leaf cbs-unit {
            type enumeration {
              enum KB {
                value 1 ;
              }

            }

            description 'Configure the unit of Committed Burst Size value.' ;
            if-feature cbs-unit-feature ;

            ncd:revise-date 2024-01-08 ;
          }

          container pir-pbs {
            description 'Configure Peak Information Rate value and Peak Burst Size value.' ;
            presence pir-pbs ;
            leaf pir {
              description 'Configure Peak Information Rate value,Unit is Mbps.' ;
              type uint32 {
                range 1..80000 {
                  description 'PIR value(Mbps)' ;
                }

              }

              mandatory true ;
            }

            leaf pbs {
              description 'Configure Peak Burst Size value, default unit is MB.' ;
              type uint32 {
                range 1..16000 {
                  description 'PBS value(MB)' ;
                }

              }

              mandatory true ;
            }

            leaf pbs-unit {
              description 'Configure the unit of Peak Burst Size value.' ;
              type enumeration {
                enum KB {
                  value 1 ;
                }

              }

              if-feature pbs-unit-feature ;

              ncd:revise-date 2024-01-08 ;
            }

          }

        }

        ncd:revise-date 2017-04-14 ;
      }

    }

  }

}
