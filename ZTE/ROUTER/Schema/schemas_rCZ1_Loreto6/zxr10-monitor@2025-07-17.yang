module zxr10-monitor {
  namespace "http://www.zte.com.cn/zxr10/netconf/schema/rosng/monitor" ;
  prefix monitor ;
  yang-version 1 ;
  import zxr10-netconf-defs {
    prefix ncd ;
  }

  organization "ZTE Corporation" ;
  contact "ZTE Corporation
  Nanjing Institute of ZTE Corporation
  No.68 Zijinghua Rd. Yuhuatai District, Nanjing, China
  Tel: +86-25-52870000" ;
  revision 2025-07-17 {
    description '1. Add acl-rule-feature to control the acl-rules node:
/configuration/monitor/sessions/session/acl-rules.
2. Add comments to the following values of flow-type about to be abandoned: openflow-lldp, openflow-arp, openflow-dhcp, openflow-bgp, openflow-ospf, openflow-icmp.' ;
  }

  revision 2024-12-10 {
    description 'Modify acl-type nodes to support ipv6-mixed-acl：
/configuration/monitor/sessions/session/multi-acl-destinations/multi-interface/acl-type;
/configuration/monitor/sessions/session/multi-acl-destinations/multi-vpws/acl-type;
/configuration/monitor/sessions/session/multi-acl-destinations/multi-cpu/acl-type.' ;
  }

  revision 2024-10-19 {
    description 'Add case type2 with erspan-type2-feature to support ERSAPAN type2:
/configuration/monitor/sessions/session/erspan-type/encapsulation/type2.' ;
  }

  revision 2024-10-16 {
    description 'Modify description.' ;
  }

  revision 2024-07-29 {
    description 'Add choice node encapsulation into container node erspan-type:
/configuration/monitor/sessions/session/erspan-type/encapsulation.
Move leaf nodes erspan-type and erspan-id into case type3:
/configuration/monitor/sessions/session/erspan-type/encapsulation/type3/erspan-id;
/configuration/monitor/sessions/session/erspan-type/encapsulation/type3/erspan-type.
Add case type1 with erspan-type1-feature to support ERSAPAN type1:
/configuration/monitor/sessions/session/erspan-type/encapsulation/type1.' ;
  }

  revision 2024-05-21 {
    description 'Support service-class with service-class-feature:
/configuration/monitor/sessions/session/service-class.' ;
  }

  revision 2024-03-12 {
    description 'Support mac-layer and ip-layer with feature:
/configuration/monitor/sessions/session/sources/interface-source/mac-layer;
/configuration/monitor/sessions/session/sources/interface-source/ip-layer.' ;
  }

  revision 2024-01-08 {
    description 'Support cbsUnit and pbsUnit with feature:
/configuration/monitor/rate-limits/rate-limit/cbs-unit;
/configuration/monitor/rate-limits/rate-limit/pir-pbs/pbs-unit.' ;
  }

  revision 2024-01-04 {
    description 'Add mmrp to flow-type.' ;
  }

  revision 2023-08-30 {
    description 'Support uni-acl-destinations with feature:
/configuration/monitor/sessions/session/uni-acl-destinations.' ;
  }

  revision 2023-05-30 {
    description 'Support mirror sample with feature sample-feature:
/configuration/monitor/sessions/session/sample.' ;
  }

  revision 2023-05-15 {
    description 'Support default CPU openflow destination with feature default-openflow-feature:
/configuration/monitor/sessions/session/default-openflow.' ;
  }

  revision 2023-04-06 {
    description 'Modify the range of session-id from 1-64 to 1-200:
/configuration/monitor/sessions/session/session-id' ;
  }

  revision 2023-02-27 {
    description 'Support packet head with feature packet-head-feature:
/configuration/monitor/sessions/session/packet-heads.' ;
  }

  revision 2023-02-06 {
    description 'Support multiple openflow destination with feature multi-openflow-feature:
/configuration/monitor/sessions/session/multi-acl-destinations/multi-openflow.' ;
  }

  revision 2022-11-23 {
    description 'Modify packet length value range from 64-9600 to control by performance parameter:
/configuration/monitor/sessions/session/packet-length;
/configuration/monitor/sessions/session/sources/interface-source/packet-length;
/configuration/monitor/sessions/session/sources/vpws-source/packet-length;
/configuration/monitor/sessions/session/sources/gre-sources/gre-source/packet-length.' ;
  }

  revision 2022-09-24 {
    description 'Support configure ERSPAN type:
/configuration/monitor/sessions/session/erspan-type.' ;
  }

  revision 2022-06-15 {
    description 'Change board name length from 1-19 to 1-35:
/configuration/monitor/rate-limits/rate-limit/board-name.' ;
  }

  revision 2022-01-12 {
    description 'Support VNI in VXLAN destination with feature vni-feature:
/configuration/monitor/sessions/session/default-vxlans/ipv4s/ipv4/vni;
/configuration/monitor/sessions/session/default-vxlans/ipv6s/ipv6/vni.' ;
  }

  revision 2021-09-15 {
    description '1. Support the mirror session packet length with feature packet-length by add node:
/configuration/monitor/sessions/session/packet-length.
2. Support the mirrored source interface packet length with feature packet-length by add nodes:
/configuration/monitor/sessions/session/sources/interface-source/packet-length;
/configuration/monitor/sessions/session/sources/vpws-source/packet-length;
/configuration/monitor/sessions/session/sources/gre-sources/gre-source/packet-length.' ;
  }

  revision 2021-08-09 {
    description '1. Support description of the interface monitor source by add node:
/configuration/monitor/sessions/session/sources/interface-source/source-desc.' ;
  }

  revision 2021-03-31 {
    description '1 Add multi-cpu with feature multi-cpu-feature to support CPU destination:
/configuration/monitor/sessions/session/multi-acl-destination/multi-cpu.
2 Add default-cpu with feature default-cpu-feature to support default CPU destination:
/configuration/monitor/sessions/session/default-cpu.' ;
  }

  revision 2021-03-03 {
    description 'Add gre-sources with feature gre-source-feature to support GRE monitor source:
/configuration/monitor/sessions/session/sources/gre-sources.' ;
  }

  revision 2021-01-05 {
    description '1 Add default-vxlans with feature default-vxlan-feature to support destination VXLAN:
/configuration/monitor/sessions/session/default-vxlans;
2 Add remote-monitor with feature remote-monitor-feature to support RSPAN:
/configuration/monitor/sessions/session/default-interfaces/default-interface/remote-monitor;
3 Add encap-remote-monitor with feature encap-remote-monitor-feature to support ERSPAN:
/configuration/monitor/sessions/session/default-gres/default-gre/encap-remote-monitor;
4 Add switchvlan-sources with feature switchvlan-source-feature to support switchvlan as monitor source:
/configuration/monitor/sessions/session/sources/switchvlan-sources.
5 Add cpu-sources with feature cpu-source-feature to support CPU monitor source:
/configuration/monitor/sessions/session/sources/cpu-sources.' ;
  }

  revision 2020-06-15 {
    description 'Support description for session:
/configuration/monitor/sessions/session/description.' ;
  }

  revision 2020-04-13 {
    description '1. Support multi-acl-destinations with feature multi-acl-feature:
/configuration/monitor/sessions/session/multi-acl-rules;
2. Support default-interfaces with feature default-interface-feature:
/configuration/monitor/sessions/session/default-interfaces.
3. Add enumeration value ipv4-mixed-acl:
/configuration/monitor/sessions/session/acl-rules/acl-rule/acl-type' ;
  }

  revision 2017-05-16 {
    description 'add destination of gre.' ;
  }

  revision 2017-04-14 {
    description '1.add vpws case to /configuration/monitor/sessions/session/acl-rules/acl-rule/destination-type/.
2.add default-vpwss container to /configuration/monitor/sessions/session/. 
3.add default-observers container to /configuration/monitor/sessions/session/. 
4.add rule-observers container to /configuration/monitor/sessions/session/.
5.add flow-type leaf to /configuration/monitor/sessions/session/sources/interface-source/.
6.add vpws-source list to /configuration/monitor/sessions/session/sources/.' ;
  }

  revision 2015-07-13 {
    description 'Initial version' ;
  }

  feature multi-acl-feature {
    description 'Mark multiple ACL destination.' ;
  }

  feature default-interface-feature {
    description 'Mark multiple default destination.' ;
  }

  feature default-vxlan-feature {
    description 'Mark default destination VXLAN.' ;
  }

  feature switchvlan-source-feature {
    description 'Mark switchvlan source.' ;
  }

  feature remote-monitor-feature {
    description 'Mark remote monitor.' ;
  }

  feature encap-remote-monitor-feature {
    description 'Mark encapsulated remote monitor.' ;
  }

  feature cpu-source-feature {
    description 'Mark CPU source.' ;
  }

  feature gre-source-feature {
    description 'Mark GER source.' ;
  }

  feature default-cpu-feature {
    description 'Mark default CPU destination.' ;
  }

  feature multi-cpu-feature {
    description 'Mark multiple CPU destination.' ;
  }

  feature packet-length {
    description 'Mark the packet length for interception.' ;
    ncd:revise-date 2021-09-15 ;
  }

  feature vni-feature {
    description 'Mark VXLAN destination support VNI.' ;
    ncd:revise-date 2022-01-12 ;
  }

  feature erspan-type {
    description 'Mark ERSPAN type.' ;
    ncd:revise-date 2022-09-24 ;
  }

  feature erspan-type1-feature {
    description 'Mark ERSPAN type1.' ;
    ncd:revise-date 2024-07-29 ;
  }

  feature erspan-type2-feature {
    description 'Mark ERSPAN type2.' ;
    ncd:revise-date 2024-10-19 ;
  }

  feature multi-openflow-feature {
    description 'Mark multiple CPU openflow destination.' ;
    ncd:revise-date 2023-02-06 ;
  }

  feature packet-head-feature {
    description 'Mark the packet head for interception.' ;
    ncd:revise-date 2023-02-27 ;
  }

  feature default-openflow-feature {
    description 'Mark default CPU openflow destination.' ;
    ncd:revise-date 2023-05-15 ;
  }

  feature sample-feature {
    description 'Mark mirror sample.' ;
    ncd:revise-date 2023-05-30 ;
  }

  feature uni-acl-ipv4-feature {
    description 'Mark one-to-one IPv4 ACL destination.' ;
    ncd:revise-date 2023-08-30 ;
  }

  feature uni-acl-ipv6-feature {
    description 'Mark one-to-one IPv6 ACL destination.' ;
    ncd:revise-date 2023-08-30 ;
  }

  feature uni-acl-link-feature {
    description 'Mark one-to-one link ACL destination.' ;
    ncd:revise-date 2023-08-30 ;
  }

  feature uni-acl-ipv4-mixed-feature {
    description 'Mark one-to-one IPv4 mixed ACL destination.' ;
    ncd:revise-date 2023-08-30 ;
  }

  feature uni-acl-intf-feature {
    description 'Mark one-to-one interface destination.' ;
    ncd:revise-date 2023-08-30 ;
  }

  feature uni-acl-vpws-feature {
    description 'Mark one-to-one VPWS destination.' ;
    ncd:revise-date 2023-08-30 ;
  }

  feature uni-acl-gre-feature {
    description 'Mark one-to-one GRE destination.' ;
    ncd:revise-date 2023-08-30 ;
  }

  feature uni-acl-cpu-feature {
    description 'Mark one-to-one CPU destination.' ;
    ncd:revise-date 2023-08-30 ;
  }

  feature uni-acl-openflow-feature {
    description 'Mark one-to-one CPU openflow destination.' ;
    ncd:revise-date 2023-08-30 ;
  }

  feature uni-acl-remote-vlan-feature {
    description 'Mark one-to-one remote VLAN destination.' ;
    ncd:revise-date 2023-08-30 ;
  }

  feature cbs-unit-feature {
    description 'Mark the unit of CBS.' ;
    ncd:revise-date 2024-01-08 ;
  }

  feature pbs-unit-feature {
    description 'Mark the unit of PBS.' ;
    ncd:revise-date 2024-01-08 ;
  }

  feature mac-layer-feature {
    description 'Mark the MAC layer matching type of packets.' ;
    ncd:revise-date 2024-03-12 ;
  }

  feature ip-layer-feature {
    description 'Mark the IP layer matching type of packets.' ;
    ncd:revise-date 2024-03-12 ;
  }

  feature service-class-feature {
    description 'Mark the service class of packets.' ;
    ncd:revise-date 2024-05-21 ;
  }

  feature acl-rule-feature {
    description 'Mark ACL destination.' ;
    ncd:revise-date 2025-07-17 ;
  }

