          leaf rem-power-port-class {
            description 'Power Class of Power Via MDI of remote neighbor.' ;
            type enumeration {
              enum "Power-port-class:PD,Power-supported:Not-supported,Power-state:Disabled,Power-ability:Not-controlled" {
                value 0 ;
                description 'Power Class is PD, MDI power support is not supported, MDI power state is disabled, MDI power ability is not controlled.' ;
              }

              enum "Power-port-class:PSE,Power-supported:Not-supported,Power-state:Disabled,Power-ability:Not-controlled" {
                value 1 ;
                description 'Power Class is PSE, MDI power support is not supported, MDI power state is disabled, MDI power ability is not controlled.' ;
              }

              enum "Power-port-class:PD,Power-supported:Supported,Power-state:Disabled,Power-ability:Not-controlled" {
                value 2 ;
                description 'Power Class is PD, MDI power support is supported, MDI power state is disabled, MDI power ability is not controlled.' ;
              }

              enum "Power-port-class:PSE,Power-supported:Supported,Power-state:Disabled,Power-ability:Not-controlled" {
                value 3 ;
                description 'Power Class is PSE, MDI power support is supported, MDI power state is disabled, MDI power ability is not controlled.' ;
              }

              enum "Power-port-class:PD,Power-supported:Not-supported,Power-state:Enabled,Power-ability:Not-controlled" {
                value 4 ;
                description 'Power Class is PD, MDI power support is not supported, MDI power state is enabled, MDI power ability is not controlled.' ;
              }

              enum "Power-port-class:PSE,Power-supported:Not-supported,Power-state:Enabled,Power-ability:Not-controlled" {
                value 5 ;
                description 'Power Class is PSE, MDI power support is not supported, MDI power state is enabled, MDI power ability is controlled.' ;
              }

              enum "Power-port-class:PD,Power-supported:Supported,Power-state:Enabled,Power-ability:Not-controlled" {
                value 6 ;
                description 'Power Class is PD, MDI power support is supported, MDI power state is enabled, MDI power ability is not controlled.' ;
              }

              enum "Power-port-class:PSE,Power-supported:Supported,Power-state:Enabled,Power-ability:Not-controlled" {
                value 7 ;
                description 'Power Class is PSE, MDI power support is supported, MDI power state is enabled, MDI power ability is not controlled.' ;
              }

              enum "Power-port-class:PD,Power-supported:Not-supported,Power-state:Disabled,Power-ability:Controlled" {
                value 8 ;
                description 'Power Class is PD, MDI power support is not supported, MDI power state is disabled, MDI power ability is controlled.' ;
              }

              enum "Power-port-class:PSE,Power-supported:Not-supported,Power-state:Disabled,Power-ability:Controlled" {
                value 9 ;
                description 'Power Class is PSE, MDI power support is not supported, MDI power state is disabled, MDI power ability is controlled.' ;
              }

              enum "Power-port-class:PD,Power-supported:Supported,Power-state:Disabled,Power-ability:Controlled" {
                value 10 ;
                description 'Power Class is PD, MDI power support is supported, MDI power state is disabled, MDI power ability is controlled.' ;
              }

              enum "Power-port-class:PSE,Power-supported:Supported,Power-state:Disabled,Power-ability:Controlled" {
                value 11 ;
                description 'Power Class is PSE, MDI power support is supported, MDI power state is disabled, MDI power ability is controlled.' ;
              }

              enum "Power-port-class:PD,Power-supported:Not-supported,Power-state:Enabled,Power-ability:Controlled" {
                value 12 ;
                description 'Power Class is PD, MDI power support is not supported, MDI power state is enabled, MDI power ability is controlled.' ;
              }

              enum "Power-port-class:PSE,Power-supported:Not-supported,Power-state:Enabled,Power-ability:Controlled" {
                value 13 ;
                description 'Power Class is PSE, MDI power support is not supported, MDI power state is enabled, MDI power ability is controlled.' ;
              }

              enum "Power-port-class:PD,Power-supported:Supported,Power-state:Enabled,Power-ability:Controlled" {
                value 14 ;
                description 'Power Class is PD, MDI power support is supported, MDI power state is enabled, MDI power ability is controlled.' ;
              }

              enum "Power-port-class:PSE,Power-supported:Supported,Power-state:Enabled,Power-ability:Controlled" {
                value 15 ;
                description 'Power Class is PSE, MDI power support is supported, MDI power state is enabled, MDI power ability is controlled.' ;
              }

            }

          }

          leaf rem-pse-power-pair {
            description 'PSE power pair of Power Via MDI of remote neighbor.' ;
            type enumeration {
              enum Unknown {
                value 0 ;
                description 'MDI power pair is Unknown.' ;
              }

              enum Signal {
                value 1 ;
                description 'MDI power pair is Signal.' ;
              }

              enum Spare {
                value 2 ;
                description 'MDI power pair is Spare.' ;
              }

            }

          }

          leaf rem-port-power-class {
            description 'Power Class of Power Via MDI of remote neighbor.' ;
            type enumeration {
              enum Unknown {
                value 0 ;
                description 'MDI power class is Unknown.' ;
              }

              enum Class0 {
                value 1 ;
                description 'MDI power class is Class0.' ;
              }

              enum Class1 {
                value 2 ;
                description 'MDI power class is Class1.' ;
              }

              enum Class2 {
                value 3 ;
                description 'MDI power class is Class2.' ;
              }

              enum Class3 {
                value 4 ;
                description 'MDI power class is Class3.' ;
              }

              enum Class4 {
                value 5 ;
                description 'MDI power class is Class4.' ;
              }

            }

          }

          leaf rem-maximum-frame-size {
            description 'Maximum Frame Size of remote neighbor.' ;
            type uint16 ;

          }

          ncd:select local-ifname ;
          ncd:select "local-ifname mac-type" ;
          ncd:select "local-ifname mac-type neighbor-id" ;
          ncd:revise-date 2022-12-15 ;
        }

      }

      container localsystemdata {
        description 'Local system data information of LLDP.' ;
        leaf chassis-id-subtype {
          description 'Chassis ID subtype of LLDP local system data.' ;
          type enumeration {
            enum macAddress {
              value 4 ;
              description 'MAC address.' ;
            }

          }

        }

        leaf chassis-id {
          type string ;

          description 'Chassis ID of LLDP local system data.' ;
          ncd:revise-date 2024-11-27 ;
        }

        leaf system-name {
          type string ;

          description 'System name of LLDP local system data.' ;
          ncd:revise-date 2024-11-27 ;
        }

        leaf system-desc {
          type string ;

          description 'System description of LLDP local system data.' ;
          ncd:revise-date 2024-11-27 ;
        }

      }

    }

  }

  notification lldp-neighbor {
    description 'The LLDP notification when neighbor is added or deleted.' ;
    container neighbor {
      config false ;
      description 'The LLDP notification when neighbor is added or deleted.' ;
      list neighbor-info {
        description 'The LLDP notification when neighbor is added or deleted.' ;
        key "local-ifname neighbor-id" ;
        leaf local-ifname {
          description 'Local port name.' ;
          type ncd:ifname {
            length 1..31 ;

          }

        }

        leaf neighbor-id {
          description 'Neighbor ID.' ;
          type uint32 {
            range 1..4294967295 ;

          }

        }

        leaf rem-chassis-id {
          type string ;

          description 'Value to indicate basis identifier in chassis ID field.' ;
          ncd:revise-date 2024-11-27 ;
        }

        leaf rem-port-id {
          type string ;

          description 'Remote port name in neighbor.' ;
          ncd:revise-date 2024-11-27 ;
        }

        leaf action {
          description 'LLDP neighbor action type, add or delete.' ;
          type enumeration {
            enum add {
              value 1 ;
              description 'LLDP neighbor add.' ;
            }

            enum delete {
              value 2 ;
              description 'LLDP neighbor delete.' ;
            }

            enum update {
              value 3 ;
              description 'LLDP neighbor update.' ;
            }

          }

        }

        leaf rem-sys-name {
          description 'System name of remote neighbor.' ;
          type string ;
          ncd:revise-date 2019-09-02 ;
        }

        container rem-man-addresses {
          description 'Management address of remote neighbor.' ;
          list rem-man-address {
            description 'Management address of remote neighbor.' ;
            key "man-addr-subtype man-address" ;
            leaf man-addr-subtype {
              description "Subtype of the management address.
              The value '1' indicates the IPv4 address.
              The value '2' indicates the IPv6 address.
              For the definition of other values, refer to IANA-ADDRESS-FAMILY-NUMBERS-MIB." ;
              type uint8 {
                range 0..255 ;

              }

            }

            leaf man-address {
              type string ;

              description 'Management address of remote neighbor.' ;
              ncd:revise-date 2024-11-27 ;
            }

            ncd:select "man-addr-subtype man-address" ;
          }
          ncd:revise-date 2020-10-30 ;
        }

      }

    }

  }

}
