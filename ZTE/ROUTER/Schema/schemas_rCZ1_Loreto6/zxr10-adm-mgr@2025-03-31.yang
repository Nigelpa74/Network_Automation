module zxr10-adm-mgr {
  namespace "http://www.zte.com.cn/zxr10/netconf/schema/rosng/adm-mgr" ;
  prefix adm-mgr ;
  yang-version 1 ;
  import zxr10-netconf-defs {
    prefix ncd ;
    revision-date 2013-11-22 ;
  }

  organization "ZTE Corporation" ;
  contact "ZTE Corporation
  Nanjing Institute of ZTE Corporation
  No.68 Zijinghua Rd. Yuhuatai District, Nanjing, China
  Tel: +86-25-52870000" ;
  description 'The netconf module to describe the ADM_MGR.' ;
  revision 2025-03-31 {
    description 'Del the project FN.C89E supported by feature node "access-only".' ;
  }

  revision 2025-02-26 {
    description 'Support emergency access policy.
Modify the default value of the following node:
(1)/adm-mgr:configuration/adm-mgr:adm-mgr/adm-mgr:usernames/adm-mgr:username/adm-mgr:change-password-expired.' ;
  }

  revision 2024-11-22 {
    description 'Support console authentication via password.
(1)Add feature node "console-authentication". This node supports the following projects: SWITCH(99X/5960X/5960M/59X-ES),HighEndPacket(15K) and PC(MSE/SWITCH).
(2)Add container node "/configuration/adm-mgr/global-configuration/console-authentication".
(3)Add container node "/configuration/adm-mgr/global-configuration/console-authentication/mode".
(4)Add container node "/configuration/adm-mgr/global-configuration/console-authentication/password".
(5)Add choice node "/configuration/adm-mgr/global-configuration/console-authentication/mode/mode".
(6)Add choice node "/configuration/adm-mgr/global-configuration/console-authentication/password/password".' ;
  }

  revision 2024-11-04 {
    description "The node '/configuration/adm-mgr/global-configuration/enable/enable-level-secret/' supports historical password duplication checking since ZXROSNGV11.00.50." ;
  }

  revision 2024-09-24 {
    description 'Correct the spelling mistakes in the descriptions of the following nodes:
(1)zxr10-adm-mgr/configuration/adm-mgr/global-configuration/default-user/bind-authortication-template;
(2)zxr10-adm-mgr/configuration/adm-mgr/authorization-templates/author-template/chmode-access/chmode/operation-mode/type1/read-only;
(3)zxr10-adm-mgr/state/adm-mgr/user-info/author-template-number;
(4)zxr10-adm-mgr/operation/adm-mgr/clear-online-user/clear-user/user-info;
(5)zxr10-adm-mgr/operation/adm-mgr/activate-user/username.' ;
  }

  revision 2024-08-12 {
    description "Support password sequential character check.
    (1)Modify the description of node:/adm-mgr:configuration/adm-mgr:adm-mgr/adm-mgr:global-configuration/adm-mgr:enable/adm-mgr:enable-strong-password.
    (2)Delete presence for node:/adm-mgr:configuration/adm-mgr:adm-mgr/adm-mgr:global-configuration/adm-mgr:enable/adm-mgr:enable-strong-password.
    (3)Modify the mandatory attribute of node '/adm-mgr:configuration/adm-mgr:adm-mgr/adm-mgr:global-configuration/adm-mgr:enable/adm-mgr:enable-strong-password/adm-mgr:same-consecutive-length' from true to false.
    (4)Add a leaf node:/adm-mgr:configuration/adm-mgr:adm-mgr/adm-mgr:global-configuration/adm-mgr:enable/adm-mgr:enable-strong-password/adm-mgr:sequential-length.
    (5)Add a leaf node:/adm-mgr:configuration/adm-mgr:adm-mgr/adm-mgr:global-configuration/adm-mgr:password/adm-mgr:strong-password/adm-mgr:sequential-length." ;
  }

  revision 2024-07-10 {
    description 'Modify the description of node:
(1)/adm-mgr:configuration/adm-mgr:adm-mgr/adm-mgr:global-configuration/adm-mgr:enable;
(2)/adm-mgr:configuration/adm-mgr:adm-mgr/adm-mgr:global-configuration/adm-mgr:enable/adm-mgr:global-enable-type/adm-mgr:authen-type/adm-mgr:aaa/adm-mgr:authentication-template;
(3)/adm-mgr:configuration/adm-mgr:adm-mgr/adm-mgr:global-configuration/adm-mgr:default-user/adm-mgr:enable-type/adm-mgr:authen-type/adm-mgr:aaa/adm-mgr:authentication-template;
(4)/adm-mgr:configuration/adm-mgr:adm-mgr/adm-mgr:global-configuration/adm-mgr:password/adm-mgr:strong-password/adm-mgr:username-related-check/adm-mgr:inverse' ;
  }

  revision 2024-06-04 {
    description 'Add the project MW(NR8000) supported by feature node "remind-before-expire".' ;
  }

  revision 2024-02-29 {
    description "The range of '/configuration/adm-mgr/global-configuration/enable/enable-level-secret/enable-secret/level' remains unchanged.
    If the range of level exceeds 15, no error will be reported if it is a delete operation; otherwise, an error will be reported if it is a configuration operation." ;
  }

  revision 2024-02-26 {
    description 'Add the projects HighEndRouter(T8000) and HighEndPacket(15K) supported by feature node "password-duration".' ;
  }

  revision 2023-05-23 {
    description '(1)Add leaf node. path:/adm-mgr:configuration/adm-mgr:adm-mgr/adm-mgr:global-configuration/adm-mgr:enable/adm-mgr:enable-cryptographic-algorithm
                 (2)Add leaf node. path:/adm-mgr:configuration/adm-mgr:adm-mgr/adm-mgr:global-configuration/adm-mgr:user-cryptographic-algorithm
                 (3)Exchange the position /adm-mgr:configuration/adm-mgr:adm-mgr/adm-mgr:global-configuration/adm-mgr:enable/adm-mgr:enable-cryptographic-algorithm
                 (4)Exchange the position typedef algorithmType' ;
  }

  revision 2023-02-03 {
    description 'Add leaf node. path:/adm-mgr:configuration/adm-mgr:adm-mgr/adm-mgr:global-configuration/adm-mgr:login-max-user' ;
  }

  revision 2022-10-21 {
    description "(1)Add the projects SWITCH(99X/5960X/5960M),HighEndRouter(T8000),HighEndPacket(15K) and FN(C600/C89E)supported by feature node \"clear-online-user\".
    (2)Add the projects PTN(6500/6700/65V5/61V5_1),HighEndRouter(T8000),HighEndPacket(15K) and OTN(9700/M721/8700/7000)supported by feature node \"date-check\".
    (3)Add the projects SWITCH(99X/5960X/5960M) and FN(C89E)supported by feature node \"password-recover-remind\".
    (4)Add the projects PTN(6500/6700/65V5/61V5_1),HighEndRouter(T8000),FN(C600) and OTN(9700/M721/8700/7000)supported by feature node \"chmode-access\".
    (5)Add the projects FN(C600) and OTN(9700/M721/8700/7000)supported by feature node \"local-user-offline\".
    (6)Add the projects SWITCH(99X)supported by feature node \"access-only\".
    (7)Modifiy the range of 'configuration/adm-mgr/authentication-templates/authen-template/bind-aaa-authen-template' from '2001-2128' to '1-2128'.
    (8)Modifiy the range of '/configuration/adm-mgr/authorization-templates/author-template/bind-aaa-author-template' from '2001-2128' to '1-2128'." ;
  }

  revision 2022-09-28 {
    description 'Support command authorization.
(1)Add container node. path:/adm-mgr:configuration/adm-mgr:adm-mgr/adm-mgr:authorization-templates/adm-mgr:author-template/adm-mgr:command-authorizations
(3)Add list node. path:/adm-mgr:configuration/adm-mgr:adm-mgr/adm-mgr:authorization-templates/adm-mgr:author-template/adm-mgr:command-authorizations/adm-mgr:command-authorization
(2)Add a leaf node. path:/adm-mgr:configuration/adm-mgr:adm-mgr/adm-mgr:authorization-templates/adm-mgr:author-template/adm-mgr:command-authorizations/adm-mgr:command-authorization/adm-mgr:level
path:/adm-mgr:configuration/adm-mgr:adm-mgr/adm-mgr:authorization-templates/adm-mgr:author-template/adm-mgr:command-authorizations/adm-mgr:command-authorization/adm-mgr:mode
path:/adm-mgr:configuration/adm-mgr:adm-mgr/adm-mgr:authorization-templates/adm-mgr:author-template/adm-mgr:command-authorizations/adm-mgr:command-authorization/adm-mgr:aaa-author-template' ;
  }

  revision 2022-09-25 {
    description 'Support enable password same consecutive check.
(1)Add a container node.  path:/configuration/adm-mgr/global-configuration/enable/enable-strong-password
(1)Add a leaf node. path:/configuration/adm-mgr/global-configuration/enable/enable-strong-password/same-consecutive-length' ;
  }

  revision 2022-09-09 {
    description 'Add the projects SWITCH(59/89/99/5960/99X/5960X/5960M) supported by feature node "local-user-offline".' ;
  }

  revision 2022-08-01 {
    description 'Support password dictionary.
(1)Add a container node. path:/configuration/adm-mgr/global-configuration/password/password-dictionary.
(2)Add a list node. path:/configuration/adm-mgr/global-configuration/password/password-dictionary/password.
(3)Add a leaf node. path:/configuration/adm-mgr/global-configuration/password/password-dictionary/password/password.
(4)Add a leaf node. path:/configuration/adm-mgr/global-configuration/password/strong-password/dictionary.' ;
  }

  revision 2022-07-22 {
    description '(1)Add container node. path:/adm-mgr:configuration/adm-mgr:adm-mgr/adm-mgr:usernames/adm-mgr:username/adm-mgr:access-time-range 
(2)Add a leaf node. path:/adm-mgr:configuration/adm-mgr:adm-mgr/adm-mgr:usernames/adm-mgr:username/adm-mgr:access-time-range/adm-mgr:time-range-name' ;
  }

  revision 2022-06-16 {
    description "(1)Add the projects PC(MSE) supported by feature node \"unlock-root-user\".
    (2)Add feature node 'show-root-user' and delete all projects except MSR(ASR,ZSRV2),SWITCH(59) and PC(MSE)." ;
  }

  revision 2022-06-06 {
    description 'Support username dictionary.
(1)Add a container node. path:/configuration/adm-mgr/global-configuration/username-dictionary.
(2)Add a list node. path:/configuration/adm-mgr/global-configuration/username-dictionary/username.
(3)Add a leaf node. path:/configuration/adm-mgr/global-configuration/username-dictionary/username/name.
(4)Add a leaf node. path:/configuration/adm-mgr/global-configuration/strong-username/dictionary.' ;
  }

  revision 2022-05-27 {
    description 'Add the projects HighEndRouter(T8000),HighEndPacket(15K) and MSE(M6000) supported by feature node "local-user-offline"' ;
  }

  revision 2022-05-10 {
    description 'Add the projects OTN(7000/M721) and PC(MSE) supported by feature node "root-user"' ;
  }

  revision 2022-04-22 {
    description 'Add the project FN(C89E) supported by feature node "password-duration"' ;
  }

  revision 2022-04-18 {
    description 'Add the projects FN(C89E) supported by feature node "local-user-offline"' ;
  }

  revision 2022-02-22 {
    description "(1)Add feature node 'unlock-root-user' and delete all projects except MSR and SWITCH(59).
    (2)Delete all projects except MSR and SWITCH(59) supported by feature node 'root-user'." ;
  }

  revision 2022-01-10 {
    description '(1)Add a new leaf node.Path:/configuration/adm-mgr/authorization-templates/author-template/login-type-allowed/grpc
(2)Add Enum Item.Path:/operation/adm-mgr/clear-online-user/clear-user/user-access-info/access-type' ;
  }

  revision 2021-12-14 {
    description 'Add the projects SWITCH(59E) supported by feature node "clear-online-user" and "local-user-offline"' ;
  }

  revision 2021-10-21 {
    description 'Support to control whether the FTP AAA authentication function is enabled.
Add container node. path:/configuration/adm-mgr/global-configuration/ftp-aaa-authentication.
Add leaf node. path:/configuration/adm-mgr/global-configuration/ftp-aaa-authentication/enabled.' ;
  }

  revision 2021-10-20 {
    description '99X project no longer supports container "access-only" and its leafs by feature node "access-only"' ;
  }

  revision 2021-10-18 {
    description 'Add the projects T8000,15K,V6000(vBras/vRouter/CDB),MSE(M6000/M6000-S) supported by feature node "remind-before-expire"' ;
  }

  revision 2021-09-21 {
    description "Modifiy the type of '/configuration/adm-mgr/global-configuration/enable/enable-level-secret/enable-secret/password' length range  from '3-200' to '8-200'." ;
  }

  revision 2021-06-28 {
    description '(1)support configuring the expiration policy for the enable secret by netconf.
(2)Add container node. path:/configuration/adm_mgr/global-configurationenable/enable/enable-secret-expire.' ;
  }

  revision 2021-05-07 {
    description '(1)All projects support the feature node "global-user-aging"
(2)All projects support the feature node "user-aging"' ;
  }

  revision 2021-04-06 {
    description '(1)Support remote server user continuous authentication failure lock. Add leaf node. path:/configuration/adm-mgr/global-configuration/login-restriction/user-authen-restriction/period.
(2)Add a new leaf node.Path:/configuration/adm-mgr/usernames/username/user-authen-restriction/period.' ;
  }

  revision 2021-03-10 {
    description '(1) Add the projects PTN(61V5_1) supported by feature node "user-authen-restriction"' ;
  }

  revision 2021-02-08 {
    description '(1) Add container node. path:/configuration/adm_mgr/authentication-templates/authen-template/authentication-method/ascii.
(2) Add leaf node. path:/configuration/adm_mgr/authentication-templates/authen-template/authentication-method/ascii/pap.
(3) Add leaf node. path:/configuration/adm_mgr/authentication-templates/authen-template/authentication-method/ascii/chap.' ;
  }

  revision 2021-02-07 {
    description '(1)Change the description of node path:/state/adm-mgr/rootuser-info/encrypt-password.' ;
  }

  revision 2021-01-28 {
    description '(1) Add the projects PTN(65V5/6700/61-SSP) OTN(7000/8700/9700) supported by feature node "clear-online-user"
(2) Add the projects PTN(61-SSP)  supported by feature node "remind-before-expire"' ;
  }

  revision 2020-11-26 {
    description "(1)Add container node path:/configuration/adm-mgr/usernames/username/change-password.
    (2)Add leaf node. path:/configuration/adm-mgr/usernames/username/change-password/min-period.
    (3)Extend the length range of node '/configuration/adm-mgr/global-configuration/password/root-user/password' from 6-200 to 6-254." ;
  }

  revision 2020-11-17 {
    description "(1) Change the projects supported by feature node \"maxlen-length\"
    (2)Extend the length range of node '/configuration/adm-mgr/global-configuration/enable/enable-level-secret/enable-secret/password' from 3-16,24-200 to 3-200.
    (3)Extend the length range of node '/configuration/adm-mgr/global-configuration/user-groups/user-group/encrypted-password' from 64-200 to 64-254.
    (4)Extend the length range of node '/configuration/adm-mgr/global-configuration/user-groups/user-group/unencrypted-password' from 3-32 to 3-128.
    (5)Change the range of node '/configuration/adm-mgr/global-configuration/password/strong-password/length' from 6-64 to 6-128.
    (6)Change the range of node '/configuration/adm-mgr/global-configuration/password/strong-password/max-length' from 8-64 to 8-128.
    (7)Extend the length range of node'/configuration/adm-mgr/global-configuration/local-user-change-password/old-password'from 3-64 to 3-128.
    (8)Extend the length range of node'/configuration/adm-mgr/global-configuration/local-user-change-password/new-password'from 3-64 to 3-128.
    (9)Extend the length of node '/configuration/adm-mgr/usernames/username/cleartext-password' from 3-64 to 3-128.
    (10)Extend the length of node '/configuration/adm-mgr/usernames/username/encrypted-password' from 64-200 to 64-254.
    (11)Extend the length of node '/configuration/adm-mgr/usernames/username/irreversible-cleartext-password' from 3-64 to 3-128.
    (12)Extend the length of node '/configuration/adm-mgr/usernames/username/irreversible-encrypted-password' from 63-200 to 63-254." ;
  }

  revision 2020-11-13 {
    description "(1) C600 project does not support 'root-user' and 'rootuser-info'" ;
  }

  revision 2020-11-02 {
    description "(1)Change the node '/configuration/adm-mgr/usernames/username/cleartext-password' datatype from 'plaintext' to \"chars\"
    (2)Change the node '/configuration/adm-mgr/usernames/username/irreversible-cleartext-password' datatype from 'plaintext' to \"chars\"
    (3)Change the node '/configuration/adm-mgr/usernames/username/encrypted-password' datatype from 'ciphertext' to \"chars\"
    (4)Change the node '/configuration/adm-mgr/usernames/username/irreversible-encrypted-password' datatype from 'ciphertext' to \"chars\"" ;
  }

