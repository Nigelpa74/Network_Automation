    description "(1)Add feature node for '/configuration/adm-mgr/usernames/username/password-recover-remind'
    (2) 9900 and 5960 project does not support 'password-recover-remind'" ;
  }

  revision 2019-10-31 {
    description "(1)Add RPC node 'unlock-local-user/input/username'
    (2)Add RPC node 'unlock-root-user'
    (3)Add a new container node.Path:/configuration/adm-mgr/usernames/username/user-authen-restriction.
