  }

  revision 2018-05-19 {
    description "The feature node 'date-check' surpport switch project 99 and 5960.
    Add container node '/configuration/adm-mgr/global-configuration/global-user-aging'.
    Add leaf node '/configuration/adm-mgr/global-configuration/global-user-aging/day'.
    Add container node '/configuration/adm-mgr/usernames/username/user-aging'.
    Add leaf node '/configuration/adm-mgr/usernames/username/user-aging/day'.
    Add leaf node '/state/adm-mgr/user-info/user-aging-state'.
    Add leaf node '/state/adm-mgr/user-info/locked-state'.
    Add container node '/operation/adm-mgr/activate-user'.
    Add leaf node '/operation/adm-mgr/activate-user/username'.
    Add feature node 'global-user-aging'.
    Add feature node 'user-aging'.
    Add feature node 'activate-user'." ;
  }

  revision 2018-04-17 {
    description "Add leaf nodes 'configuration/adm_mgr/global-configuration/password/strong-password/date-check' and feature node 'date-check'" ;
  }

  revision 2018-03-29 {
    description "Add container node 'global-configuration/strong-username' and leaf node 'global-configuration/strong-username/min-length'" ;
  }

  revision 2018-03-14 {
    description "Add leaf node 'protocol-type','authentication-method' and 'authorization-method' for 'state/adm-mgr/online-user'" ;
  }

  revision 2018-01-31 {
    description "Add container node '/configuration/adm_mgr/global-configuration/password/strong-password/username-related-check'" ;
  }

  revision 2017-11-25 {
    description "Add leaf nodes 'configuration/adm_mgr/global-configuration/password/strong-password-check/status/enable/enable' and 'configuration/adm_mgr/global-configuration/password/strong-password-check/status/disable/disable'" ;
  }

  revision 2017-10-13 {
    description "Add leaf nodes 'irreversible-cleartext-password' and 'irreversible-encrypted-password' for choice node '/adm-mgr:configuration/adm-mgr:adm-mgr/adm-mgr:usernames/adm-mgr:username/adm-mgr:password/'" ;
  }

  revision 2017-06-01 {
    description "Modifiy the type of '/adm-mgr:state/adm-mgr:adm-mgr/adm-mgr:login-fail-response-info/adm-mgr:username' length range  from '1-65' to '0-65'." ;
  }

  revision 2017-01-04 {
    description "Cancel Mandatory of 'configuration/adm_mgr/global-configuration/login-ascii/authortication-template'" ;
  }

  revision 2015-03-10 {
    description "Modifiy the type of '/adm-mgr:state/adm-mgr:adm-mgr/adm-mgr:user-info/adm-mgr:username','/adm-mgr:state/adm-mgr:adm-mgr/adm-mgr:authen-restriction-info/adm-mgr:username','/adm-mgr:state/adm-mgr:adm-mgr/adm-mgr:online-user/adm-mgr:username','/adm-mgr:state/adm-mgr:adm-mgr/adm-mgr:login-fail-response-info/adm-mgr:username', and '/adm-mgr:state/adm-mgr:adm-mgr/adm-mgr:rootuser-info/adm-mgr:username' from 'string' to 'ncd:string-all'." ;
  }

  revision 2015-02-28 {
    description "Add container node of state type '/adm-mgr:state/adm-mgr:adm-mgr/adm-mgr:rootuser-info'" ;
  }

  revision 2015-02-10 {
    description "(1)Add the description of '/operation/adm-mgr/clear-online-user/access-type/' enumeration items 'cli','qx','tl1','xml' and 'web'.
    (2)Modify feature name from 'clear-on-line-user' to 'clear-online-user'" ;
  }

  revision 2015-01-14 {
    description "(1)Delete default value of 'configuration/adm-mgr/global-configuration/login-restriction/login-failure-alarm/' leaf 'every-times'
    (2)Modify the mandatory value of 'configuration/adm-mgr/global-configuration/login-restriction/login-failure-alarm/' leaf 'every-times' from false to true.
    (3)Modify word spelling error,replace word 'leafs' for 'leaves'." ;
  }

  revision 2014-08-04 {
    description "(1)Modify the mandatory value of 'configuration/adm-mgr/usernames/username/enable-type/authen-type/aaa/' leaf 'aaa-authentication' from false to true.
    (2)Modify the mandatory value of 'configuration/adm-mgr/usernames/username/enable-type/authen-type/aaa/' leaf 'authentication-template' from false to true." ;
  }

  revision 2014-06-30 {
    description "(1)Modify the length range of 'configuration/adm-mgr/state/login-fail-response-info/' leaf 'login-time' from 1 to 40." ;
  }

  revision 2014-06-06 {
    description "(1)Add Presence value of 'configuration/adm-mgr/global-configuration/login-restriction/user-authen-restriction' Container with 'Mandatory leaves are included.',
    (2)Modify Mandatory value of 'configuration/adm-mgr/global-configuration/login-restriction/user-authen-restriction/' leaf 'fail-times' and 'lock-time' with true.
    (3)Modify the Type value of 'configuration/adm-mgr/state/login-fail-response-info/' leaf 'terminal-type' from unit8 to enumeration.
    (4)Delete the enum value 'normal-mode' of 'state/adm-mgr/login-state-info/' leaf 'current-mode', change enum value 'monitor-mode' to 'watch-mode' of this leaf." ;
  }

  revision 2014-05-15 {
    description "(1)Modify default value of 'configuration\adm-mgr\usernames\username' leaf 'once-password'and 'lock',
    (2)Modify default value of 'configuration\adm-mgr\authorization-templates\author-template' leaf 'local-cmdgroup-mode'." ;
  }

  revision 2014-04-18 {
    description 'Initial version.' ;
  }

  feature clear-online-user {
    description 'Clear the online user.' ;
  }

  feature root-user {
    description 'Configure root user password.' ;
  }

  feature date-check {
    description 'Set password date-related check' ;
  }

  feature activate-user {
    description 'Activate local user.' ;
  }

  feature global-user-aging {
    description 'The configuration of global user-aging.' ;
  }

  feature user-aging {
    description "The configuration of user's user-aging." ;
  }

  feature max-length {
    description 'Set the maximum length of the password' ;
  }

  feature remind-before-expire ;

  feature password-recover-remind {
    description 'Configure the question and answer for password recovery.' ;
  }

  feature user-authen-restriction {
    description "The configuration of user's user-authen-restriction." ;
  }

  feature chmode-access ;

  feature local-user-offline ;

  feature password-duration ;

  feature access-only {
    ncd:revise-date 2021-10-20 ;
  }

  feature unlock-root-user {
    ncd:revise-date 2022-02-22 ;
  }

  feature show-root-user {
    ncd:revise-date 2022-06-16 ;
  }

  feature access-time-range {
    description 'The Access time range of user.' ;
    ncd:revise-date 2022-07-22 ;
  }

  feature console-authentication {
    description 'Console authentication.' ;
    ncd:revise-date 2024-11-22 ;
  }

  typedef algorithmType {
    type enumeration {
      enum sha256 {
        description 'SHA256 algorithm' ;
        value 1 ;
      }

      enum sm3 {
        value 2 ;
        description 'SM3 algorithm' ;
      }

    }

    description 'cryptographic algorithm' ;
  }

  container configuration {
    description 'The configuration model of ADM_MGR.' ;
    container adm-mgr {
      description 'The configuration model of ADM_MGR.' ;
      container global-configuration {
        description 'The global configuration of ADM_MGR.' ;
        container account-switch {
          description 'Account switch.' ;
          choice switch {
            description 'To configure the command account swith.' ;
            default switch-off ;
            case switch-on {
              description 'To open command account function.' ;
              leaf on {
                description 'To open account function.' ;
                type empty ;

                mandatory true ;
              }

              leaf accounting-template {
                description 'To bind AAA account template' ;
                type uint16 {
                  range 2001..2128 ;

                }

                mandatory true ;
              }

            }

            case switch-off {
              description 'To close command account function.' ;
              leaf off {
                description 'To close account function.' ;
                type empty ;

              }

            }

          }

        }

        container login-ascii {
          description 'To configure ASCII authentication type.' ;
          presence "Mandatory leaves are included." ;
          leaf ascii {
            description 'To configure ASCII authentication type.' ;
            type empty ;

            mandatory true ;
          }

          leaf authentication-template {
            description 'To configure the global authentication template number.' ;
            type uint8 {
              range 1..128 ;

            }

            mandatory true ;
          }

          leaf authortication-template {
            description 'To configure the global authorization template number.' ;
            type uint8 {
              range 1..128 ;

            }

          }

        }

        container enable {
          description 'The configuration of enable-related.' ;
          leaf enable-cryptographic-algorithm {
            type algorithmType ;

            description 'Configure enable cryptographic algorithm' ;
            default sha256 ;
            ncd:revise-date 2023-05-23 ;
          }

          container global-enable-type {
            description 'To configure global enable authentication type.' ;
            choice authen-type {
              description 'The global enable authentication type.' ;
              default local ;
              case local {
                description 'Local authentication.' ;
                leaf local-authentication {
                  description 'Local authentication.' ;
                  type empty ;

                }

              }

              case aaa {
                description 'AAA authentication.' ;
                leaf aaa-authentication {
                  description 'AAA authentication.' ;
                  type empty ;

                  mandatory true ;
                }

                leaf authentication-template {
                  description 'To configure enable authentication template.' ;
                  type uint8 {
                    range 1..128 ;

                  }

                  mandatory true ;
                }

              }

            }

          }

          container enable-level-secret {
            description 'To configure enable password and privilege level.' ;
            list enable-secret {
              description 'To configure enable password and privilege level.' ;
              max-elements 18 ;
              key level ;
              leaf level {
                description 'The privilege level.' ;
                type uint32 {
                  range 1..18 ;

                }

              }

              choice password-type {
                description 'The password type' ;
                mandatory true ;
                case encrypted {
                  description 'The encrypted password.' ;
                  leaf encrypted-password {
                    description 'The encrypted password.' ;
                    type empty ;

                  }

                }

                case unencrypted {
                  description 'The unencrypted password.' ;
                  leaf unencrypted-password {
                    description 'The unencrypted password.' ;
                    type empty ;

                  }

                }

              }

              leaf password {
                description 'Set the password for enable authentication. The length of cleartext is 8~128 characters, the length of ciphertext is 24 or 63 characters.' ;
                type string {
                  length 8..200 ;

                }

                mandatory true ;
              }

            }

          }

          container enable-secret-expire {
            description 'Set the expiration policy for the enable secret, including the expire day(s) and the prompt day(s).' ;
            presence "enable-secret expire prompt" ;
            choice expire {
              description 'Set the expire day(s) and the prompt day(s) of the expiration policy.' ;
              case never-expire {
                description 'Set the expiration policy to never expire.' ;
                leaf never-expire {
                  description 'Never expire.' ;
                  type empty ;

                  mandatory true ;
                }

              }

              case expire-days {
                description 'Set the expiration policy.' ;
                leaf expire-days {
                  description 'The expire day(s).' ;
                  type uint32 {
                    range 1..360 ;

                  }

                  mandatory true ;
                }

                leaf prompt-days {
                  description 'The prompt day(s).' ;
                  type uint32 {
                    range 1..180 ;

                  }

                  mandatory true ;
                }

              }

            }

            ncd:revise-date 2021-06-28 ;
          }

          container enable-strong-password {
            description 'Set the strong password strategy for the enable password.' ;
            leaf same-consecutive-length {
              description 'Enable password same consecutive character max length.' ;
              type uint8 {
                range 3..5 {
                  description 'Same consecutive max length' ;
                }

              }

              mandatory false ;
            }

            leaf sequential-length {
              type uint8 {
                range 2..4 ;

              }

              description 'Enable password sequential character max length.' ;
              ncd:revise-date 2024-08-12 ;
            }

            ncd:revise-date 2022-09-25 ;
          }

        }

        leaf default-privilege-level {
          description 'To configure default privilege level.' ;
          type uint8 {
            range 0..15 ;

          }

          default 0 ;
        }

        container default-user {
          description 'The default configuration' ;
          leaf bind-authentication-template {
            description 'To configure default user authentication template number.' ;
            type uint8 {
              range 1..128 ;

            }

          }

          leaf bind-authortication-template {
            description 'To configure default user authorization template number.' ;
            type uint8 {
              range 1..128 ;

            }

          }

          container enable-type {
            description 'To configure default enable authentication type.' ;
            choice authen-type {
              description 'To configure default enable authentication type.' ;
              default local ;
              case local {
                description 'Default user local authentication.' ;
                leaf local-authentication {
                  description 'Default user local authentication.' ;
                  type empty ;

                }

              }

              case aaa {
                description 'Default user AAA authentication.' ;
                leaf aaa-authentication {
                  description 'Default user AAA authentication.' ;
                  type empty ;

                  mandatory true ;
                }

                leaf authentication-template {
                  description 'To configure default user enable authentication template.' ;
                  type uint8 {
                    range 1..128 ;

                  }

                  mandatory true ;
                }

              }

            }

          }

        }

        container user-groups {
          description 'To configure user group' ;
          list user-group {
            description 'Configure user group information for PPP authentication.' ;
            key 'group-name username' ;
            leaf group-name {
              description 'Configure user group name.' ;
              type string {
                length 1..15 ;

              }

            }

            leaf username {
              description 'Configure the user name in the group.' ;
              type string {
                length 1..16 ;

              }

            }

            choice password-type {
              description 'To configure the password.' ;
              case encrypted {
                description 'To configure the encrypted password.' ;
                leaf encrypted-password {
                  description 'Configure the encrypted password of a user in a group.' ;
                  type string {
                    length 64..254 ;

                  }

                }

              }

              case unencryted {
                description 'To configure the unencrypted password.' ;
                leaf unencrypted-password {
                  description 'Configure the unencrypted password of a user in a group.' ;
                  type string {
                    length 3..128 ;

                  }

                }

              }

            }

          }

        }

        container password {
          description 'The configuration of password-related.' ;
          container root-user {
            description 'Configuring the Password of the root User, The root password cannot be deleted.' ;
            leaf password {
              if-feature root-user ;

              description 'To configure root user password. The length of cleartext is 6~128 characters.' ;
              type string {
                length 6..254 ;

              }

            }

          }

          container strong-password {
            description 'Set the strong password strategy' ;
            leaf length {
              description 'set the minimum length of strong password' ;
              type uint8 {
                range 6..128 ;

              }

            }

            choice character-strategy {
              description 'Set the character strategy of strong password.' ;
              case character-type {
                description 'Set the character combination of strong password.' ;
                container character-type {
                  description 'Set the character combination of strong password.' ;
                  leaf number {
                    description 'The number' ;
                    type empty ;

                  }

                  leaf capital {
                    description 'The capital' ;
                    type empty ;

                  }

                  leaf lowercase {
                    description 'The lowercase' ;
                    type empty ;

                  }

                  leaf special {
                    description 'The special character' ;
                    type empty ;

                  }

                }

              }

              case character-set-num {
                description 'Set the number of character sets that must be included in the password.' ;
                container character-set-num {
                  description 'Set the number of character types that must be included in the password.' ;
                  leaf min-num {
                    description 'The minimum number of character sets' ;
                    type uint8 {
                      range 2..4 ;

                    }

                  }

                }

              }

              ncd:revise-date 2018-07-17 ;
            }

            container character {
              status obsolete {
                ncd:revise-date 2018-07-17 ;
              }

              description 'set the character combination of strong password' ;
              leaf number {
                description 'The number' ;
                type empty ;

              }

              leaf capital {
                description 'The capital' ;
                type empty ;

              }

              leaf lowercase {
                description 'The lowercase' ;
                type empty ;

              }

              leaf special {
                description 'The special character' ;
                type empty ;

              }

            }

            container username-related-check {
              description 'Set username-related check in password' ;
              container substring {
                description 'Check the substring' ;
                presence "check substring" ;
                leaf substring {
                  description 'Check the substring associated with username(case insensitive)' ;
                  type enumeration {
                    enum enable {
                      value 1 ;
                      description 'Enable substring check' ;
                    }

                    enum disable {
                      value 2 ;
                      description 'Disable substring check' ;
                    }

                  }

                  mandatory true ;
                }

              }

              leaf inverse {
                description 'Check the inverse associated with username.' ;
                type enumeration {
                  enum enable {
                    value 1 ;
                    description 'Enable inverse check' ;
                  }

                  enum disable {
                    value 2 ;
                    description 'Disable inverse check' ;
                  }

                }

                default disable ;
              }

              ncd:revise-date 2018-01-31 ;
            }

            leaf date-check {
              if-feature date-check ;

              description 'Set password date-related check. Any date ranging from 1 January 1970 to 31 December 2037 is not allowed. The date formats include: YYYYMMDD, MMDDYYYY, DDMMYYYY, YYYY-MM-DD, MM-DD-YYYY, DD-MM-YYYY' ;
              type enumeration {
                enum enable {
                  value 1 ;
                  description 'Enable date-related check in password' ;
                }

                enum disable {
                  value 2 ;
                  description 'Disable date-related check in password' ;
                }

              }

              default disable ;
              ncd:revise-date 2018-04-17 ;
            }

            leaf max-length {
              if-feature max-length ;

              description 'Set the maximum length of the password' ;
              type uint8 {
                range 8..128 ;

              }

              ncd:revise-date 2018-10-08 ;
            }

            leaf dictionary {
              description 'Enable password dictionary check.' ;
              type empty ;

              ncd:revise-date 2022-08-01 ;
            }

            leaf sequential-length {
              type uint8 {
                range 2..4 ;

              }

              description 'Password sequential character max length.' ;
              ncd:revise-date 2024-08-12 ;
            }

          }

          container strong-password-check {
            description 'The status of strong password check' ;
            choice status {
              description 'The status of strong password check' ;
              default enable ;
              case enable {
                description 'Open strong password check' ;
                leaf enable {
                  description 'Open strong password check' ;
                  type empty ;

                }

              }

              case disable {
                description 'Close strong password check' ;
                leaf disable {
                  description 'Close strong password check' ;
                  type empty ;

                }

              }

            }

            ncd:revise-date 2017-11-25 ;
          }

          leaf duplicated-password {
            description 'To configure the interval times of last same passwords.' ;
            type uint8 {
              range 2..10 ;

            }

            default 5 ;
          }

          container password-duration {
            if-feature password-duration ;

            description 'The configuration of password duration related.' ;
            presence password-duration ;
            leaf password-duration {
              description 'Set the number of days the password is valid.' ;
              type uint16 {
                range 1..360 ;

              }

              units day ;
              mandatory true ;
            }

            leaf remind-before-expire {
              description 'Set the number of days to remind before the password expires. The default is 3 days. Allows you to set the reminder days to be greater than the number of days the password is valid.' ;
              type uint16 {
                range 1..360 ;

              }

              default 3 ;
            }

            ncd:revise-date 2020-10-14 ;
          }

          container password-dictionary {
            description 'The Configuration of password dictionary.' ;
            list password {
              description 'Establish password.' ;
              max-elements 128 ;
              key password ;
              leaf password {
                description 'Password in the password dictionary.' ;
                type string {
                  length 3..128 ;

                }

              }

            }

            ncd:revise-date 2022-08-01 ;
          }

        }

        container login-restriction {
          description 'The configuration of restrict login.' ;
          container login-block {
            description 'This command configures and activates the anti-attack monitoring function for remote login.' ;
            reference "show login" ;
            presence "All the leaves of this container should be mandatory" ;
            leaf block-time {
              description 'The time of block login.' ;
              type uint16 {
                range 1..65535 {
                  description 'range from 1 to 65535' ;
                }

              }

              units second ;
              mandatory true ;
            }

            leaf attemp-times {
              description 'The max try times of login failure.' ;
              type uint16 {
                range 1..65535 {
                  description 'range from 1 to 65535' ;
                }

              }

              mandatory true ;
            }

            leaf watch-period {
              description 'The period of watch.' ;
              type uint16 {
                range 1..65535 {
                  description 'range from 1 to 65535' ;
                }

              }

              units second ;
              mandatory true ;
            }

          }

          container login-failure-alarm {
            description 'This command configure the system to create the log information or TRAP information when a login attempt failed.' ;
            reference "show login failure" ;
            presence "Mandatory leaf is included." ;
            leaf every-times {
              description 'Set failure try times when alarm' ;
              type uint8 {
                range 1..100 {
                  description 'range from 1 to 100' ;
                }

              }

              mandatory true ;
            }

          }

          container login-quiet-mode-acl {
            description 'To configure login quiet mode acl.' ;
            leaf ipv4-acl {
              description 'To configure ipv4 acl.' ;
              type string {
                length 1..31 ;

              }

            }

            leaf ipv6-acl {
              description 'To configure ipv6 acl.' ;
              type string {
                length 1..31 ;

              }

            }

          }

          container user-authen-restriction {
            description 'Set the maximum number of consecutive authentication failures and locking times for users.' ;
            leaf fail-times {
              description 'Set the consecutive failure times (0: means no limit).' ;
              type uint8 {
                range 0..16 ;

              }

              default 5 ;
            }

            leaf lock-time {
              description 'Set the lock time.' ;
              type uint16 {
                range 1..1440 ;

              }

              units minute ;
              default 5 ;
            }

            leaf period {
              description 'Set the time length of continuous authentication failures. The user will be locked automatically after the specified number of times of continuous authentication failures within period.' ;
              type uint16 {
                range 1..120 ;

              }

              units minute ;
              ncd:revise-date 2021-04-06 ;
            }

          }

        }

        container strong-username {
          description 'Set the username strategy' ;
          leaf min-length {
            description 'Set the minimum length of the username' ;
            type uint8 {
              range 1..65 ;

            }

          }

          leaf dictionary {
            description 'Enable(1) or disable(0) username dictionary.' ;
            type uint8 {
              range 0..1 ;

            }

            ncd:revise-date 2022-06-06 ;
          }

          ncd:revise-date 2018-03-29 ;
        }

        container global-user-aging {
          if-feature global-user-aging ;

          description 'The configuration of global user-aging.' ;
          leaf day {
            description 'Set the local user aging period. If the local user is not used continuously for a period of time that reaches the aging period,the user is disabled.' ;
            type uint16 {
              range 1..365 ;

            }

            units day ;
          }

          ncd:revise-date 2018-05-19 ;
        }

        container local-user-change-password {
          description 'A user that has passed local authentication modifies its password.' ;
          presence "Mandatory leaves are included." ;
          leaf old-password {
            description 'Old password' ;
            type string {
              length 3..128 ;

            }

            mandatory true ;
          }

          leaf new-password {
            description 'New password' ;
            type string {
              length 3..128 ;

            }

            mandatory true ;
          }

          ncd:revise-date 2019-09-11 ;
        }

        container local-user-offline {
          if-feature local-user-offline ;

          description 'Local user configuration changes kick users offline.' ;
          leaf password-changed {
            description 'Set change the local user password and kick the user offline.' ;
            type empty ;

          }

          leaf locked {
            description 'Set lock the local user and kick the user offline.' ;
            type empty ;

          }

          ncd:revise-date 2020-08-17 ;
        }

        container change-password {
          description 'The restriction policy of changing password.' ;
          presence change-password ;
          leaf max-times-per-day {
            description 'Maximum number of changing password within a day.' ;
            type uint16 {
              range 1..10 ;

            }

            mandatory true ;
          }

          ncd:revise-date 2020-08-31 ;
        }

        container ftp-aaa-authentication {
          description 'FTP AAA authentication.' ;
          leaf enabled {
            description 'Enables or disables FTP AAA authentication.
By default, FTP only supports local authentication. That is, users can upload and download files through FTP without using the AAA authentication template.
After FTP AAA authentication is enabled, an authentication template must be configured to support local and remote authentication.' ;
            type boolean ;

            default false ;
          }

          ncd:revise-date 2021-10-21 ;
        }

        container username-dictionary {
          description 'The Configuration of username dictionary.' ;
          list username {
            description 'Establish username.' ;
            max-elements 128 ;
            key name ;
            leaf name {
              description 'Username in the username dictionary.' ;
              type string {
                length 1..65 ;

              }

            }

          }

          ncd:revise-date 2022-06-06 ;
        }

        leaf login-max-user {
          description 'Set the max number of different users login.' ;
          type uint32 {
            range 1..500 ;

          }

          ncd:revise-date 2023-02-03 ;
        }

        leaf user-cryptographic-algorithm {
          type algorithmType ;

          default sha256 ;
          description 'Configure user cryptographic algorithm' ;
          ncd:revise-date 2023-05-23 ;
        }

        container console-authentication {
          container mode {
            description 'To configure the mode of console authentication. When the mode is set to AAA mode, it will clear the password at node "/adm-mgr:configuration/adm-mgr:adm-mgr/adm-mgr:global-configuration/adm-mgr:console-authentication/adm-mgr:password".' ;
            choice mode {
              description 'The mode of console authentication.' ;
              default aaa ;
              case pwd-only {
                description 'Configure the console authentication mode to pwd-only mode.' ;
                leaf pwd-only {
                  type empty ;

                  description 'Password only mode.' ;
                }

              }

              case aaa {
                description 'Configure the console authentication mode to AAA mode.' ;
                leaf aaa {
                  type empty ;

                  description 'AAA mode, which uses username and password for authentication.' ;
                }

              }

            }

          }

          container password {
            description 'To configure the password of console authentication. The password can only be set when the console authentication mode is pwd-only mode.' ;
            choice password {
              description 'The password of console authentication.' ;
              case plaintext {
                description 'The plaintext password of console authentication.' ;
                leaf plaintext-password {
                  type string {
                    length 3..128 ;

                  }

                  description 'The plaintext password.' ;
                }

              }

              case encrypted {
                description 'The encrypted password of console authentication.' ;
                leaf encrypted-password {
                  type string {
                    length 63..254 ;

                  }

                  description 'The encrypted password.' ;
                }

              }

            }

          }

          description 'The configuration of console authentication.' ;
          if-feature console-authentication ;

          ncd:revise-date 2024-11-22 ;
        }

      }

      container usernames {
        description 'The configuration of username-related.' ;
        list username {
          description 'Establish user name' ;
          max-elements 128 ;
          key name ;
          leaf name {
            description 'System username.' ;
            type string {
              length 1..65 ;

            }

          }

          choice password {
            description 'Set user password' ;
            case cleartext {
              description 'The unencrypted password' ;
              leaf cleartext-password {
                description 'The UNENCRYPTED (cleartext) user password' ;
                type string {
                  length 3..128 ;

                }

              }

            }

            case encrypted {
              description 'The encrypted password' ;
              leaf encrypted-password {
                description 'The encrypted user password' ;
                type string {
                  length 64..254 ;

                }

              }

            }

            case irreversible-cleartext {
              description 'The unencrypted password' ;
              leaf irreversible-cleartext-password {
                description 'The UNENCRYPTED (cleartext) user password' ;
                type string {
                  length 3..128 ;

                }

              }

              ncd:revise-date 2017-10-13 ;
            }

            case irreversible-encrypted {
              description 'The encrypted password' ;
              leaf irreversible-encrypted-password {
                description 'The irreversible encrypted password' ;
                type string {
                  length 63..254 ;

                }

              }

              ncd:revise-date 2017-10-13 ;
            }

          }

          leaf bind-authen-template {
            description 'Bind authentication template number' ;
            type uint32 {
              range 1..128 ;

            }

          }

          leaf bind-author-template {
            description 'Bind authorization template number' ;
            type uint32 {
              range 1..128 ;

            }

          }

          leaf password-duration {
            description 'Set the number of days the password is valid. If set to 0, the password never expires.' ;
            type uint16 {
              range "0 | 90..360" ;

            }

          }

          leaf remind-before-expire {
            if-feature remind-before-expire ;

            description 'Set the number of days to remind before the password expires. The default is 3 days. Allows you to set the reminder days to be greater than the number of days the password is valid. When the password never expires, the reminder days is invalid.' ;
            type uint16 {
              range 1..360 ;

            }

            ncd:revise-date 2019-01-03 ;
          }

          leaf once-password {
            description 'Must modify password when first login.' ;
            type enumeration {
              enum off {
                value 0 ;
                description "Needn't modify password when first login." ;
              }

              enum on {
                value 1 ;
                description 'Must modify password when first login.' ;
              }

            }

            default off ;
          }

          leaf lock {
            description 'Lock or unlock a local user. Locked user is not allowed to login device.' ;
            type enumeration {
              enum unlock {
                value 0 ;
                description 'Unlock a user' ;
              }

              enum lock {
                value 1 ;
                description 'Lock a user' ;
              }

            }

            default unlock ;
          }

          leaf change-password-expired {
            description 'Change password after the password expired.' ;
            type enumeration {
              enum enable {
                value 1 ;
              }

              enum disable {
                value 2 ;
              }

            }

            ncd:revise-date 2019-08-20 ;
          }

          container enable-type {
            description 'To configure user enable authentication type.' ;
            choice authen-type {
              description 'Set user enable authentication type' ;
              case local {
                description 'Local authentication' ;
                leaf local-authentication {
                  description 'User enable authentication type local' ;
                  type empty ;

                }

              }

              case aaa {
                description 'AAA authentication' ;
                leaf aaa-authentication {
                  description 'User enable AAA authentication type' ;
                  type empty ;

                  mandatory true ;
                }

                leaf authentication-template {
                  description 'User enable authentication template' ;
                  type uint8 {
                    range 1..128 ;

                  }

                  mandatory true ;
                }

              }

            }

          }

          container password-recover-remind {
            if-feature password-recover-remind ;

            description 'Set the question and answer of user password recover.' ;
            presence "Mandatory leaves are included." ;
            leaf question {
              description 'Set the question of user password reset.' ;
              type ncd:string-with-blank {
                length 1..50 ;

              }

              mandatory true ;
            }

            leaf answer {
              description 'Set the answer of user password reset.' ;
              type ncd:string-with-blank {
                length 1..200 ;

              }

              mandatory true ;
            }

          }

          container user-aging {
            if-feature user-aging ;

            description "The configuration of user's user-aging." ;
            leaf day {
              description 'Set the specified local user aging period. If the user is not used continuously for a period of time that reaches the aging period, the user is disabled. The number of day is 0, indicating that the user is not aging.' ;
              type uint16 {
                range 0..365 ;

              }

              units day ;
            }

            ncd:revise-date 2018-05-19 ;
          }

          container user-authen-restriction {
            if-feature user-authen-restriction ;

            description 'Set the maximum number of consecutive authentication failures and locking times for local users.' ;
            presence "Mandatory leaves are included." ;
            leaf fail-times {
              description 'Set the consecutive failure times.' ;
              type uint8 {
                range 3..16 ;

              }

              mandatory true ;
            }

            leaf lock-time {
              description 'Set the lock time.' ;
              type uint16 {
                range 1..1440 ;

              }

              units minute ;
              mandatory true ;
            }

            leaf period {
              description 'Set the time length of continuous authentication failures. The user will be locked automatically after the specified number of times of continuous authentication failures within period.' ;
              type uint16 {
                range 1..120 ;

              }

              units minute ;
              ncd:revise-date 2021-04-06 ;
            }

            ncd:revise-date 2019-10-31 ;
          }

          container change-password {
            description 'The restriction policy of changing password.' ;
            leaf min-period {
              description 'Minimum period between password change.' ;
              type uint32 {
                range 1..12 ;

              }

              units hour ;
            }

            ncd:revise-date 2020-11-26 ;
          }

          container access-time-range {
            if-feature access-time-range ;

            description 'Access time range for users.' ;
            leaf time-range-name {
              description 'Time range name.' ;
              type string {
                length 1..31 ;

              }

            }

            ncd:revise-date 2022-07-22 ;
          }

        }

      }

      container authentication-templates {
        description 'The configuration of authentication template.' ;
        list authen-template {
          description 'The authentication template configuration of ADM_MGR.' ;
          max-elements 128 ;
          key authen-number ;
          leaf authen-number {
            description 'Configure number of authentication template.' ;
            type uint32 {
              range 1..128 ;

            }

          }

          leaf bind-aaa-authen-template {
            description 'Configure template number of AAA which is binded by the authentication template.' ;
            type uint32 {
              range 1..2128 ;

            }

          }

          leaf ipv4-acl {
            description 'Configure IPv4 ACL name binded by the authentication template.' ;
            type string {
              length 1..31 ;

            }

          }

          leaf ipv6-acl {
            description 'Configure IPv6 ACL name binded by the authentication template.' ;
            type string {
              length 1..31 ;

            }

          }

          container authentication-method {
            description 'Configure the method of authentication.' ;
            choice method {
              description 'Configure authentication method of the authentication template.' ;
              default pap-authentication ;
              case chap-authentication {
                description 'Configure authentication method is CHAP.' ;
                leaf chap {
                  description 'Configure authentication method is CHAP.' ;
                  type empty ;

                }

              }

              case pap-authentication {
                description 'Configure authentication method is PAP.' ;
                leaf pap {
                  description 'Configure authentication method is PAP.' ;
                  type empty ;

                }

              }

              case ascii-authentication {
                description 'Configure authentication method is ASCII.' ;
                container ascii {
                  description 'Configure the TACACS+ authentication method as ASCII. The RADIUS protocol does not support ASCII authentication. If only the ASCII authentication mode is specified, but the RADIUS authentication mode is not specified, the default authentication mode is CHAP.' ;
                  presence ascii ;
                  choice radius {
                    description 'Configure RADIUS authentication method.' ;
                    default chap-authentication ;
                    case pap-authentication {
                      description 'Configure RADIUS authentication method is PAP.' ;
                      leaf pap {
                        description 'Configure RADIUS authentication method is PAP.' ;
                        type empty ;

                      }

                    }

                    case chap-authentication {
                      description 'Configure authentication method is CHAP.' ;
                      leaf chap {
                        description 'Configure RADIUS authentication method is CHAP.' ;
                        type empty ;

                      }

                    }

                  }

                }

                ncd:revise-date 2021-02-08 ;
              }

            }

          }

          leaf description {
            description 'Configure description of the authentication template.' ;
            type string {
              length 1..127 ;

            }

          }

        }

      }

      container authorization-templates {
        description 'The configuration of authorization template.' ;
        list author-template {
          description 'The authorization template configuration.' ;
          max-elements 128 ;
          key author-number ;
          leaf author-number {
            description 'The authorization template number' ;
            type uint32 {
              range 1..128 ;

            }

          }

          leaf local-privilege-level {
            description 'Set local privilege level' ;
            type uint8 {
              range 0..15 ;

            }

          }

          leaf bind-aaa-author-template {
            description 'Bind AAA authorization template' ;
            type uint32 {
              range 1..2128 ;

            }

          }

          leaf description {
            description 'The description of authorization template' ;
            type string {
              length 1..127 ;

            }

          }

          leaf login-sametime-max {
            description 'Set the max times of user login in the same time' ;
            type uint16 {
              range 1..60 ;

            }

          }

          leaf local-cmdgroup-mode {
            description 'Set the command group mode' ;
            type enumeration {
              enum inclusive {
                value 0 ;
                description 'Inclusive mode' ;
              }

              enum exclusive {
                value 1 ;
                description 'Exclusive mode' ;
              }

            }

            default inclusive ;
          }

          container max-access {
            description 'To configure max access authority' ;
            choice access {
              description 'The read-write authority' ;
              case read-write-access {
                description 'The read-write authority' ;
                leaf read-write {
                  description 'The read-write authority.' ;
                  type empty ;

                }

              }

              case read-only-access {
                description 'The read-only authority' ;
                leaf read-only {
                  description 'The read-only authority.' ;
                  type empty ;

                }

              }

            }

          }

          container access-only {
            if-feature access-only {
              ncd:revise-date 2021-10-20 ;
            }

            description 'Set the allowed access type.' ;
            leaf lct {
              description 'LCT port access.' ;
              type enumeration {
                enum deny {
                  value 0 ;
                  description 'Lct access deny' ;
                }

                enum allowed {
                  value 1 ;
                  description 'Lct access allowed' ;
                }

              }

              default allowed ;
            }

            leaf qx {
              description 'QX port access.' ;
              type enumeration {
                enum deny {
                  value 0 ;
                  description 'Qx access deny' ;
                }

                enum allowed {
                  value 1 ;
                  description 'Qx access allowed' ;
                }

              }

              default allowed ;
            }

            leaf dcn {
              description 'DCN access.' ;
              type enumeration {
                enum deny {
                  value 0 ;
                  description 'Dcn access deny' ;
                }

                enum allowed {
                  value 1 ;
                  description 'Dcn access allowed' ;
                }

              }

              default allowed ;
            }

          }

          container ftp-top-directory {
            description 'Set the top directory and access authority of FTP' ;
            leaf directory-name {
              description 'The top directory name' ;
              type string {
                length 1..159 ;

              }

            }

            choice topdir-access {
              description 'The top directory access authority' ;
              case topdir-readonly {
                description 'The read-only authority' ;
                leaf read-only {
                  description 'The read-only authority' ;
                  type empty ;

                }

              }

              case topdir-readwrite-copy {
                description 'The read-write and copy authority' ;
                leaf read-write {
                  description 'The read-write authority' ;
                  type enumeration {
                    enum no {
                      value 0 ;
                      description 'Delete ftp top dir read write' ;
                    }

                    enum yes {
                      value 1 ;
                      description 'Config ftp top dir read write' ;
                    }

                  }

                }

                leaf copy {
                  description 'The copy authority' ;
                  type enumeration {
                    enum no {
                      value 0 ;
                      description 'Delete ftp top dir copy' ;
                    }

                    enum yes {
                      value 1 ;
                      description 'Config ftp top dir copy' ;
                    }

                  }

                }

              }

            }

          }

          container sftp-top-directory {
            description 'Set the top directory and access authority of SFTP' ;
            leaf directory-name {
              description 'The top directory name' ;
              type string {
                length 1..159 ;

              }

            }

            choice topdir-access {
              description 'The top directory access permission' ;
              case topdir-readonly {
                description 'The read-only authority' ;
                leaf read-only {
                  description 'The read-only authority' ;
                  type empty ;

                }

              }

              case topdir-readwrite-copy {
                description 'The read-write and copy authority' ;
                leaf read-write {
                  description 'The read-write authority' ;
                  type enumeration {
                    enum no {
                      value 0 ;
                      description 'Delete sftp top dir read write' ;
                    }

                    enum yes {
                      value 1 ;
                      description 'Config sftp top dir read write' ;
                    }

                  }

                }

                leaf copy {
                  description 'The copy authority' ;
                  type enumeration {
                    enum no {
                      value 0 ;
                      description 'Delete sftp top dir copy' ;
                    }

                    enum yes {
                      value 1 ;
                      description 'Config sftp top dir copy' ;
                    }

                  }

                }

              }

            }

          }

          container login-type-allowed {
            description 'Set the login type.' ;
            leaf console {
              description 'Allow users to login via console.' ;
              type enumeration {
                enum deny {
                  value 0 ;
                  description 'Users are not allowed to login by console.' ;
                }

                enum allowed {
                  value 1 ;
                  description 'Users are allowed to login by console.' ;
                }

              }

              default allowed ;
              ncd:revise-date 2018-07-23 ;
            }

            leaf only-telnet {
              description 'Allow users to login via Telnet.' ;
              type enumeration {
                enum deny {
                  value 0 ;
                  description 'Users are not allowed to login by Telnet.' ;
                }

                enum allowed {
                  value 1 ;
                  description 'Users are allowed to login by Telnet.' ;
                }

              }

              default allowed ;
              ncd:revise-date 2018-07-23 ;
            }

            leaf telnet {
              description 'Allow users to login via Telnet and console.' ;
              type enumeration {
                enum deny {
                  value 0 ;
                  description 'Users are not allowed to login by Telnet and console.' ;
                }

                enum allowed {
                  value 1 ;
                  description 'Users are allowed to login by Telnet and console.' ;
                }

              }

              default allowed ;
            }

            leaf ssh {
              description 'Allow users to login via SSH.' ;
              type enumeration {
                enum deny {
                  value 0 ;
                  description 'Users are not allowed to login by SSH.' ;
                }

                enum allowed {
                  value 1 ;
                  description 'Users are allowed to login by SSH.' ;
                }

              }

              default allowed ;
            }

            leaf ftp {
              description 'Allow users to login via FTP.' ;
              type enumeration {
                enum deny {
                  value 0 ;
                  description 'Users are not allowed to login by FTP.' ;
                }

                enum allowed {
                  value 1 ;
                  description 'Users are allowed to login by FTP.' ;
                }

              }

              default allowed ;
            }

            leaf web {
              description 'Allow users to login via WEB.' ;
              type enumeration {
                enum deny {
                  value 0 ;
                  description 'Users are not allowed to login by WEB.' ;
                }

                enum allowed {
                  value 1 ;
                  description 'Users are allowed to login by WEB.' ;
                }

              }

              default allowed ;
            }

            leaf grpc {
              description 'Allow users to login via GRPC.' ;
              type enumeration {
                enum deny {
                  value 0 ;
                  description 'Users are not allowed to login by GRPC.' ;
                }

                enum allowed {
                  value 1 ;
                  description 'Users are allowed to login by GRPC.' ;
                }

              }

              default allowed ;
              ncd:revise-date 2022-01-10 ;
            }

          }

          container logfile-access {
            description 'Set the access permission of logfile.' ;
            list logfile-allowed {
              description 'Set the access permission of log file.' ;
              max-elements 4096 ;
              key log-suffix ;
              leaf log-suffix {
                description 'Set the access permission of log with suffix.' ;
                type string {
                  length 1..32 ;

                }

              }

              choice access {
                description 'The access authority of logfile' ;
                default read-write-copy ;
                case none {
                  description 'The none access authority' ;
                  leaf none-access {
                    description 'None authority.' ;
                    type empty ;

                  }

                }

                case read-only {
                  description 'The read-only access authority' ;
                  leaf read-only-access {
                    description 'The read-only authority .' ;
                    type empty ;

                  }

                }

                case read-write-copy {
                  description 'The read-write and copy access authority' ;
                  leaf read-write-access {
                    description 'The read-write authority .' ;
                    type enumeration {
                      enum no {
                        value 0 ;
                      }

                      enum yes {
                        value 1 ;
                      }

                    }

                  }

                  leaf copy-access {
                    description 'The copy authority .' ;
                    type enumeration {
                      enum no {
                        value 0 ;
                      }

                      enum yes {
                        value 1 ;
                      }

                    }

                  }

                }

              }

            }

          }

          container local-cmdgroups {
            description 'The local command group' ;
            list local-cmd-group {
              description 'Set the local command group.' ;
              key group-name ;
              leaf group-name {
                description 'Set the command group.' ;
                type string {
                  length 1..31 ;

                }

              }

            }

          }

          container chmode-access {
            if-feature chmode-access ;

            description 'Set the access permission of file or directory.' ;
            list chmode {
              description 'Set the access permission of file or directory.' ;
              key absolute-path ;
              leaf absolute-path {
                description 'Set the absolute path of a file or directory' ;
                type string {
                  length 1..159 ;

                }

              }

              leaf operation-mode {
                description 'access' ;
                type enumeration {
                  enum read-only {
                    value 1 ;
                    description 'read-only privilege' ;
                  }

                  enum read-write {
                    value 2 ;
                    description 'read-write privilege' ;
                  }

                  enum none {
                    value 3 ;
                    description 'none privilege' ;
                  }

                }

                mandatory true ;
              }

            }

            ncd:revise-date 2020-07-03 ;
          }

          container command-authorizations {
            description 'The command authorization.' ;
            list command-authorization {
              description 'Set the command authorization.' ;
              max-elements 2048 ;
              key level ;
              leaf level {
                description 'Set command authorization level.' ;
                type uint8 {
                  range 0..15 ;

                }

              }

              leaf mode {
                description 'Set command authorization mode.' ;
                type enumeration {
                  enum default-command {
                    value 1 ;
                    description 'The command is executed in user mode or privileged mode, authorization is required.' ;
                  }

                  enum config-command {
                    value 2 ;
                    description 'The command is executed in user mode, privileged mode and global configuration mode, authorization is required.' ;
                  }

                  enum all {
                    value 3 ;
                    description 'The command is executed in all modes except diagnose mode, authorization is required.' ;
                  }

                }

                default default-command ;
              }

              leaf aaa-author-template {
                description 'Set AAA author template.' ;
                type uint16 {
                  range 2001..2128 ;

                }

              }

            }

            ncd:revise-date 2022-09-28 ;
          }

        }

      }

    }

  }

  container state {
    config false ;
    description 'The state model of ADM_MGR.' ;
    container adm-mgr {
      description 'The state model of ADM_MGR.' ;
      list user-info {
        description 'User information' ;
        key username ;
        leaf username {
          description 'Username' ;
          type ncd:string-all {
            length 1..65 ;

          }

        }

        leaf encrypt-password {
          description 'Encrypted password, displayed as ******.' ;
          type string {
            length 1..200 ;

          }

        }

        leaf authen-template-number {
          description 'Authentication template number.' ;
          type uint8 {
            range 1..128 ;

          }

        }

        leaf author-template-number {
          description 'Authorization template number.' ;
          type uint8 {
            range 1..128 ;

          }

        }

        leaf age-time {
          description 'The remain validity time of password.' ;
          type string {
            length 1..20 ;

          }

        }

        leaf set-time {
          status deprecated ;

          description 'The creation time of password.' ;
          type ncd:string-with-blank {
            length 1..30 ;

          }

        }

        leaf user-aging-state {
          description 'User aging state' ;
          type enumeration {
            enum active {
              value 0 ;
              description 'User is active.' ;
            }

            enum inactive {
              value 1 ;
              description 'User is inactive.' ;
            }

          }

          ncd:revise-date 2018-05-19 ;
        }

        leaf locked-state {
          description 'User lock state' ;
          type enumeration {
            enum unlocked {
              value 0 ;
              description 'User is unlocked.' ;
            }

            enum locked {
              value 1 ;
              description 'User is locked.' ;
            }

          }

          ncd:revise-date 2018-05-19 ;
        }

      }

      list authen-restriction-info {
        description 'Locked user and login fail user information' ;
        key username ;
        leaf username {
          description 'Username' ;
          type ncd:string-all {
            length 1..65 ;

          }

        }

        leaf locked-state {
          description 'User lock state' ;
          type empty ;

        }

        leaf login-failed-times {
          description 'User login failed times.' ;
          type uint8 ;

        }

        leaf remain-time {
          description 'Locked user remain time.' ;
          type uint16 ;

          units minute ;
        }

      }

      list login-state-info {
        description 'This command queries the configuration of the anti-attack monitoring function.' ;
        reference "login block" ;
        key terminal-type ;
        leaf terminal-type {
          description 'The type of login terminal.' ;
          type enumeration {
            enum telnet {
              value 1 ;
              description 'telnet terminal' ;
            }

            enum ssh {
              value 2 ;
              description 'ssh terminal' ;
            }

            enum ftp {
              value 3 ;
              description 'ftp terminal' ;
            }

          }

        }

        leaf current-mode {
          description 'The current mode of login terminal,include Watch-Mode and Quiet-Mode.' ;
          type enumeration {
            enum watch-mode {
              value 1 ;
              description 'watch mode' ;
            }

            enum quiet-mode {
              value 2 ;
              description 'quiet mode' ;
            }

          }

        }

        leaf remain-time {
          description 'The remain time of login mode.' ;
          type uint16 {
            range 0..65535 {
              description 'range from 0 to 65535' ;
            }

          }

          units second ;
        }

        leaf login-failed-times {
          description 'The counts of login failure.' ;
          type uint16 {
            range 0..65535 {
              description 'range from 0 to 65535' ;
            }

          }

        }

      }

      list online-user {
        description 'Information of online users.' ;
        key 'username vtyno access-type' ;
        leaf username {
          description 'The online username.' ;
          type ncd:string-all {
            length 1..65 ;

          }

        }

        leaf vtyno {
          description 'Vty number.' ;
          type uint8 {
            range 0..255 ;

          }

        }

        leaf access-type {
          description 'User access type. The supported types are CLI, NETCONF and QX.' ;
          type enumeration {
            enum CLI {
              value 1 ;
              description 'Access type of user is CLI.' ;
            }

            enum SNMP {
              value 2 ;
              description 'Access type of user is SNMP.' ;
            }

            enum WEB {
              value 3 ;
              description 'Access type of user is WEB.' ;
            }

            enum NETCONF {
              value 4 ;
              description 'Access type of user is NETCONF.' ;
            }

            enum QX {
              value 5 ;
              description 'Access type of user is QX.' ;
            }

            enum CWMP {
              value 6 ;
              description 'Access type of user is CWMP.' ;
            }

            enum GRPC {
              value 7 ;
              description 'Access type of user is GRPC.' ;
            }

          }

        }

        leaf protocol-type {
          description 'The protocol type' ;
          type enumeration {
            enum NA {
              value 0 ;
              description 'The protocol type is undefined' ;
            }

            enum CONSOLE {
              value 1 ;
              description 'The protocol type is CONSOLE' ;
            }

            enum TELNET {
              value 2 ;
              description 'The protocol type is TELNET' ;
            }

            enum SSH {
              value 3 ;
              description 'The protocol type is SSH' ;
            }

          }

          ncd:revise-date 2018-03-14 ;
        }

        leaf ip-address {
          description 'The IP address of user.' ;
          type string {
            length 0..45 ;

          }

        }

        leaf online-time {
          description 'The user online time.' ;
          type string {
            length 0..32 ;

          }

        }

        leaf idle-time {
          description 'Idle time.' ;
          type string {
            length 0..32 ;

          }

        }

        leaf login-time {
          description 'Login time.' ;
          type ncd:datetime ;

        }

        leaf authentication-method {
          description 'User login authentication method' ;
          type enumeration {
            enum NA {
              value 0 ;
              description 'The authentication method is undefined' ;
            }

            enum none {
              value 1 ;
              description 'The authentication method is none' ;
            }

            enum local {
              value 2 ;
              description 'The authentication method is local' ;
            }

            enum radius {
              value 3 ;
              description 'The authentication method is RADIUS' ;
            }

            enum tacacs {
              value 4 ;
              description 'The authentication method is TACACS' ;
            }

            enum diameter {
              value 5 ;
              description 'The authentication method is DIAMETER' ;
            }

          }

          ncd:revise-date 2018-03-14 ;
        }

        leaf authorization-method {
          description 'User login authorization method' ;
          type enumeration {
            enum NA {
              value 0 ;
              description 'The authorization method is undefined' ;
            }

            enum local {
              value 2 ;
              description 'The authorization method is local' ;
            }

            enum radius {
              value 3 ;
              description 'The authorization method is RADIUS' ;
            }

            enum tacacs {
              value 4 ;
              description 'The authorization method is TACACS' ;
            }

            enum local-default {
              value 6 ;
              description 'The authorization method is local(default)' ;
            }

          }

          ncd:revise-date 2018-03-14 ;
        }

        ncd:select "username vtyno access-type" ;
      }

      list login-fail-response-info {
        description 'Information of login fail response info.' ;
        key 'seqnum terminal-type' ;
        leaf seqnum {
          description 'Login seqnum.' ;
          type int32 {
            range 1..100 ;

          }

        }

        leaf terminal-type {
          description 'The type of login terminal.' ;
          type enumeration {
            enum telnet {
              value 1 ;
              description 'telnet terminal' ;
            }

            enum ssh {
              value 2 ;
              description 'ssh terminal' ;
            }

            enum ftp {
              value 3 ;
              description 'ftp terminal' ;
            }

          }

        }

        leaf username {
          description 'Login name.' ;
          type ncd:string-all {
            length 0..65 ;

          }

        }

        leaf login-time {
          description 'Login time.' ;
          type ncd:string-with-blank {
            length 1..40 ;

          }

        }

        choice ip-address {
          description 'IP address' ;
          case ipv4-type {
            description 'Ipv4' ;
            leaf ipv4-address {
              description 'IPv4 address.' ;
              type ncd:ipv4-address ;

            }

          }

          case ipv6-type {
            description 'IPv6' ;
            leaf ipv6-address {
              description 'IPv6 address.' ;
              type ncd:ipv6-address ;

            }

          }

        }

        ncd:select "seqnum terminal-type" ;
        ncd:select terminal-type ;
      }

      container rootuser-info {
        if-feature show-root-user {
          ncd:revise-date 2022-06-16 ;
        }

        description 'Root user information' ;
        leaf username {
          description 'Root username' ;
          type ncd:string-all {
            length 1..65 ;

          }

        }

        leaf encrypt-password {
          description 'Encrypted password, display actual ciphertext or ****** according to different product forms.' ;
          type string {
            length 1..200 ;

          }

        }

        leaf set-time {
          description 'The set-time of root user password' ;
          type string {
            length 10 ;

          }

        }

      }

    }

  }

  container operation {
    config false ;
    description 'The operation model of ADM_MGR.' ;
    container adm-mgr {
      description 'The operation model of ADM_MGR.' ;
      container clear-online-user {
        description 'Clear the online user.' ;
        choice clear-user {
          if-feature clear-online-user ;

          description 'Clear the online user.' ;
          case user-info {
            description 'The online user information' ;
            leaf username {
              description 'Clear user by username.' ;
              type string {
                length 1..65 ;

              }

            }

          }

          case user-access-info {
            description 'The user access information' ;
            leaf access-type {
              description 'Clear user by accesstype.' ;
              type enumeration {
                enum cli {
                  value 0 ;
                  description 'Accesstype cli' ;
                }

                enum qx {
                  value 1 ;
                  description 'Accesstype qx' ;
                }

                enum tl1 {
                  value 2 ;
                  description 'Accesstype tl1' ;
                }

                enum xml {
                  value 3 ;
                  description 'Accesstype xml' ;
                }

                enum web {
                  value 4 ;
                  description 'Accesstype web' ;
                }

                enum grpc {
                  value 5 ;
                  description 'Accesstype grpc' ;
                }

              }

              mandatory true ;
            }

            leaf vtyno {
              description 'Clear user by vtyno.' ;
              type uint8 {
                range 0..255 ;

              }

              mandatory true ;
            }

          }

        }

      }

      container activate-user {
        if-feature activate-user ;

        description 'Activate local user.' ;
        leaf username {
          description 'If the local user is aged, it will be activated. If the local user is not aged, the aging time is update and the calculation is restarted.' ;
          type string {
            length 1..65 ;

          }

        }

        ncd:revise-date 2018-05-19 ;
      }

    }

  }

  rpc unlock-local-user {
    description 'Unlock local user' ;
    input {
      leaf username {
        description 'While the local user is locked after password authentication fails a certain number of times, unlock the local user.' ;
        type string {
          length 1..65 ;

        }

      }

    }

    ncd:revise-date 2019-10-31 ;
  }

  rpc unlock-root-user {
    if-feature unlock-root-user {
      ncd:revise-date 2022-02-22 ;
    }

    description 'Unlock root user' ;
    ncd:revise-date 2019-10-31 ;
  }

}
