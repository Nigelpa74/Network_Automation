          ncd:revise-date 2022-06-13 ;
        }

        container bus {
          description 'Match broadcast and unknown unicast.' ;
          list bu {
            description 'Configure interface rate limit based on matching broadcast and unknown unicast.' ;
            key 'if-name if-direct' ;
            leaf if-name {
              description 'Configure the name of the attaching interface.' ;
              type ncd:ifname {
                length 1..31 {
                  description 'Name of the attaching interface, support 1-31 characters' ;
                }

              }

            }

            leaf if-direct {
              description 'Specify the direction of interface.' ;
              type enumeration {
                enum input {
                  value 1 ;
                  description 'Rate limit on input' ;
                }

                enum output {
                  value 2 ;
                  description 'Rate limit on output' ;
                }

              }

            }

            leaf rate-limit-desc {
              description 'Description of rate limit, support 1-79 characters.' ;
              type ncd:string-with-blank {
                length 1..79 {
                  description 'Description of rate limit, support 1-79 characters.' ;
                }

              }

            }

            choice unit-style {
              description "Specify unit's style." ;
              mandatory true ;
              case unit-value {
                description 'Configure the value style.' ;
                leaf cir {
                  description 'Configure the CIR(Committed Information Rate) value (default: kilobits per second).' ;
                  type uint32 {
                    range 0..4294967295 {
                      description 'The CIR value (default: kilobits per second).' ;
                    }

                  }

                  mandatory true ;
                }

                leaf cir-unit {
                  description 'Set cir unit, such as kbps, mbps, gbps.' ;
                  type qos-rate-unit-type ;

                }

                leaf cbs {
                  description 'Configure the CBS(Committed Burst Size) size in bytes.' ;
                  type uint32 {
                    range 0..4294967294 {
                      description 'The CBS(Committed Burst Size) size in bytes.' ;
                    }

                  }

                  units byte ;
                }

                leaf pir {
                  description 'Configure the PIR(Peak Information Rate) value (default: kilobits per second).' ;
                  type uint32 {
                    range 0..4294967295 {
                      description 'The PIR(Peak Information Rate) value (default: kilobits per second).' ;
                    }

                  }

                  mandatory true ;
                }

                leaf pir-unit {
                  description 'Set pir unit, such as kbps, mbps, gbps.' ;
                  type qos-rate-unit-type ;

                }

                leaf pbs {
                  description 'Configure the PBS(Peak Burst Size) size in bytes.' ;
                  type uint32 {
                    range 0..4294967294 {
                      description 'The PBS(Peak Burst Size) size in KB.' ;
                    }

                  }

                  units byte ;
                }

              }

              case unit-percentage {
                description 'Configure the percentage style.' ;
                leaf cir-percentage {
                  description 'Configure the CIR(Committed Information Rate) percentage (Set the accuracy rate per hundred (1%)).' ;
                  type uint32 {
                    range 1..100 {
                      description 'The CIR percentage, support <1-100>' ;
                    }

                  }

                  mandatory true ;
                }

                leaf pir-percentage {
                  description 'Configure the PIR(Peak Information Rate) percentage (Set the accuracy rate per hundred (1%)).' ;
                  type uint32 {
                    range 1..100 {
                      description 'The PIR percentage, support <1-100>' ;
                    }

                  }

                  mandatory true ;
                }

              }

            }

            leaf statistical-share {
              description 'The flag of statistical-share.' ;
              type boolean ;

