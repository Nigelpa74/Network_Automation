                              description 'Configure the CBS(Committed Burst Size) size, default: KB.' ;
                              type uint32 {
                                range 1..4294967295 {
                                  description 'The CBS(Committed Burst Size) size in bytes, support <1-4294967295>' ;
                                }

                              }

                              mandatory true ;
