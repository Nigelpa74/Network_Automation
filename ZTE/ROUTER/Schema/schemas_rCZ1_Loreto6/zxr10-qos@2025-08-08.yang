      container service-policys {
        if-feature service-policy ;

        description 'Bind H-QoS policys to the interface.' ;
        list service-policy {
          description 'Bind H-QoS policys to the interface.' ;
          key 'if-name if-direction bound-type' ;
          leaf if-name {
            description 'Configure the name of the attaching interface.' ;
            type ncd:ifname {
              length 1..31 {
                description 'Name of the attaching interface, support 1-31 characters' ;
              }

            }

          }

          leaf if-direction {
            description 'Configure the interface direction.' ;
            type enumeration {
              enum input {
                value 1 ;
                description 'Attaches to the input interface' ;
              }

              enum output {
                value 2 ;
                description 'Attaches to the output interface' ;
              }

            }

          }

          leaf bound-type {
            description 'Specify the bind mode.' ;
            type enumeration {
              enum normal {
                value 1 ;
                description 'Set policies bound on link-ports with normal' ;
              }

              enum overwrite {
                value 2 ;
                description 'Set policies bound on link-ports with overwrite' ;
              }

              enum multiple-level-qos {
                value 4 ;
                description 'Set multiple level qos mode' ;
              }

            }

          }

          leaf pmap-name {
            description 'Name of the policy map bound on the interface, support 1-31 characters.' ;
            type string {
              length 1..31 {
                description 'Name of the policy map, support 1-31 characters' ;
              }

            }

            mandatory true ;
          }

          leaf statistical-share {
            description 'Set statistical share.' ;
            type boolean ;

            default false ;
          }

          leaf share-group {
            description 'Specify share group ID.' ;
            type uint32 {
              range 1..5000 ;

            }

            ncd:revise-date 2021-01-18 ;
          }

          leaf switch-fabric {
            description 'Set switch-fabric.' ;
            type boolean ;

            default false ;
            ncd:revise-date 2021-08-10 ;
          }

          container shape {
            description 'Configure shape.' ;
            presence "Configure shape" ;
            leaf rate {
              description 'Configure rate.' ;
              type uint32 {
                range 8..4294967295 {
                  description 'Rate in kilobits per second' ;
                }

              }

              units kbps ;
              mandatory true ;
            }

            container burst {
              description 'Configure burst and exburst size.' ;
              presence "Configure burst and exburst size in KB" ;
              leaf burst-size {
                description 'Burst size.' ;
                type uint32 {
                  range 2..250000000 {
                    description 'Burst size in KB, support <2-250000000>' ;
                  }

                }

                units KB ;
                mandatory true ;
              }

            }

            ncd:revise-date 2021-03-22 ;
          }

        }

      }

      container traffic-policy-interfaces {
        if-feature traffic-policy ;

        description 'Bind QoS policys to the interface.' ;
        list traffic-policy-interface {
          description 'Bind QoS policys to the interface.' ;
          key 'if-name if-direction' ;
          leaf if-name {
            description 'Configure the name of the attaching interface.' ;
            type ncd:ifname {
              length 1..31 {
                description 'Name of the attaching interface, support 1-31 characters' ;
              }

            }

          }

          leaf if-direction {
            description 'Configure the interface direction.' ;
            type enumeration {
              enum input {
                value 1 ;
                description 'Attaches to the input interface' ;
              }

              enum output {
                value 2 ;
                description 'Attaches to the output interface' ;
              }

            }

          }

          leaf bound-type {
            description 'Specify the bind mode.' ;
            type enumeration {
              enum overwrite {
                value 2 ;
                description 'Set policies bound on link-ports with overwrite' ;
              }

              enum normal {
                value 1 ;
                description 'Set policies bound on link-ports with normal' ;
              }

            }

            default normal ;
          }

          leaf pmap-name {
            description 'Name of the policy map bound on the interface, support 1-31 characters.' ;
            type string {
              length 1..31 {
                description 'Name of the policy map, support 1-31 characters' ;
              }

            }

            mandatory true ;
          }

          leaf statistical-share {
            description 'Set statistical share.' ;
            type boolean ;

            default false ;
          }

          leaf description {
            description 'Description of the QoS policys bind to the interface, support 1-79 characters.' ;
            type ncd:string-with-blank {
              length 1..79 {
