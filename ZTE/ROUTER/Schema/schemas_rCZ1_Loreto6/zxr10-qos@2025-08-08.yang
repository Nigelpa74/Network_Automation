              container match {
                description 'Configure matching criteria for a class map.' ;
                container port {
                  description 'Select port as matching criteria.' ;
                  presence "Select port as match criteria" ;
                  leaf port-value {
                    description 'Configure port value in range mode, support single port value or range(max num:4;spacing mark:,) in <0-65535>. For example,"1,300-400,1000,2000-4000",etc.Specifically, port value 0 can only be configured in a single value format.' ;
                    type qos-port-range ;

                    mandatory true ;
                  }

                }

                container destination-port {
                  description 'Select destination-port as matching criteria.' ;
                  presence "Select destination-port as match criteria" ;
                  leaf dst-port-value {
                    description 'Configure destination-port value in range mode, support single destination-port value or range(max num:4;spacing mark:,) in <0-65535>. For example,"1,300-400,1000,2000-4000",etc.Specifically, port value 0 can only be configured in a single value format.' ;
                    type qos-port-range ;

                    mandatory true ;
                  }

                }

                container source-port {
                  description 'Select source-port as matching criteria.' ;
                  presence "Select source-port as match criteria" ;
                  leaf src-port-value {
                    description 'Configure soure-port value in range mode, support single soure-port value or range(max num:4;spacing mark:,) in <0-65535>. For example,"1,300-400,1000,2000-4000",etc.Specifically, port value 0 can only be configured in a single value format.' ;
                    type qos-port-range ;

                    mandatory true ;
                  }

                }

                container fragment-type {
                  description 'Select fragment-type as matching criteria.' ;
                  presence "Select fragment-type as match criteria" ;
                  leaf not {
                    description 'Logical negation of operation:
true  Match opposite;
false Match current.' ;
                    type boolean ;

                    default false ;
                  }

                  leaf match-relation {
                    description 'The rule of matching, see bellow:                
all  Match all of the fragment type;
any  Match any of the fragment type.' ;
                    type enumeration {
                      enum all {
                        value 0 ;
                        description 'Match all of the fragment type.' ;
                      }

                      enum any {
                        value 1 ;
                        description 'Match any of the fragment type.' ;
                      }

                    }

                    mandatory true ;
                  }

                  choice fragment-option {
                    description 'Fragment type.' ;
                    mandatory true ;
                    case fragment {
                      description 'Fragment type.' ;
                      leaf dont-fragment {
                        description 'Match dont-fragment.' ;
                        type boolean ;

                        default false ;
                      }

                      leaf first-fragment {
                        description 'Match first-fragment.' ;
                        type boolean ;

                        default false ;
                      }

                      leaf is-fragment {
                        description 'Match is-fragment.' ;
                        type boolean ;

                        default false ;
                      }

                      leaf last-fragment {
                        description 'Match last-fragment.' ;
                        type boolean ;

                        default false ;
                      }

                    }

                  }

                }

                container destination-ipv4-addr {
                  description 'Select destination-address as matching criteria.' ;
                  presence "Select destination-address as match criteria" ;
                  leaf dst-address {
                    description 'Destination address.' ;
                    type ncd:ipv4-address ;

                    mandatory true ;
                  }

                  leaf dst-address-mask {
                    description 'Destination maskcard bits, positive mask.' ;
                    type ncd:ipv4-mask ;

                    mandatory true ;
                  }

                }

                container source-ipv4-addr {
                  description 'Select source-address as matching criteria.' ;
                  presence "Select source-address as match criteria" ;
                  leaf src-address {
                    description 'Source address.' ;
                    type ncd:ipv4-address ;

                    mandatory true ;
                  }

                  leaf src-address-mask {
                    description 'Source maskcard bits, positive mask.' ;
                    type ncd:ipv4-mask ;

                    mandatory true ;
                  }

                }

                container dscps {
                  description 'Select DSCP as matching criteria.' ;
                  list dscp {
                    description 'Set DSCP value as matching criteria.' ;
                    key ip-type ;
                    leaf ip-type {
                      description 'Configure DSCP value Based on IP, see below:
ipv4 Packets based on IPv4;
ipv6 Packets based on IPv6.' ;
                      type enumeration {
                        enum ipv4 {
                          value 1 ;
                          description 'IPv4 type.' ;
                        }

                        enum ipv6 {
                          value 2 ;
                          description 'IPv6 type.' ;
                        }

                      }

                    }

                    leaf not {
                      description 'Configure the opposite range flag,
true  Match opposite range;
false Match current range.' ;
                      type boolean ;

                      default false ;
                    }

                    leaf dscp-value {
                      description 'Configure QoS dscp in range mode, support single DSCP value or range(max num:4;spacing mark:,) in <0-63>. For example,"6,10-30,40,50-60",etc.' ;
                      type qos-dscp-bitmap ;

                      mandatory true ;
                    }

                  }

                }

                container icmp-code {
                  description 'Select icmp-code as matching criteria.' ;
                  presence "Select icmp-code as match criteria" ;
                  leaf icmp-code-value {
                    description 'Configure icmp code in range mode, support single icmp-code value or range(max num:4;spacing mark:,) in <0-255>. For example,"6,10-30,40,50-60",etc.' ;
                    type ncd:bitmap {
                      pattern "(((((([1-9][0-9]{1,1})|([1-9][0-9]{0,0})|0|([1-1][0-9]{2,2})|(2[0-4][0-9]{1,1})|(25[0-4])|255)-(([1-9][0-9]{1,1})|([1-9][0-9]{0,0})|0|([1-1][0-9]{2,2})|(2[0-4][0-9]{1,1})|(25[0-4])|255))|(([1-9][0-9]{1,1})|([1-9][0-9]{0,0})|0|([1-1][0-9]{2,2})|(2[0-4][0-9]{1,1})|(25[0-4])|255)),){0,3}(((([1-9][0-9]{1,1})|([1-9][0-9]{0,0})|0|([1-1][0-9]{2,2})|(2[0-4][0-9]{1,1})|(25[0-4])|255)-(([1-9][0-9]{1,1})|([1-9][0-9]{0,0})|0|([1-1][0-9]{2,2})|(2[0-4][0-9]{1,1})|(25[0-4])|255))|(([1-9][0-9]{1,1})|([1-9][0-9]{0,0})|0|([1-1][0-9]{2,2})|(2[0-4][0-9]{1,1})|(25[0-4])|255)){1,1})" {
                        description 'Configure icmp-code in range mode, support single icmp-code value or range(max num:4;spacing mark:,) in <0-255>.' ;
                      }

                    }

                    mandatory true ;
                  }

                }

                container icmp-type {
                  description 'Select icmp-type as matching criteria.' ;
                  presence "Select icmp-type as match criteria" ;
                  leaf icmp-type-value {
                    description 'Configure icmp type in range mode, support single icmp-type value or range(max num:4;spacing mark:,) in <0-255>. For example,"6,10-30,40,50-60",etc.' ;
                    type ncd:bitmap {
                      pattern "(((((([1-9][0-9]{1,1})|([1-9][0-9]{0,0})|0|([1-1][0-9]{2,2})|(2[0-4][0-9]{1,1})|(25[0-4])|255)-(([1-9][0-9]{1,1})|([1-9][0-9]{0,0})|0|([1-1][0-9]{2,2})|(2[0-4][0-9]{1,1})|(25[0-4])|255))|(([1-9][0-9]{1,1})|([1-9][0-9]{0,0})|0|([1-1][0-9]{2,2})|(2[0-4][0-9]{1,1})|(25[0-4])|255)),){0,3}(((([1-9][0-9]{1,1})|([1-9][0-9]{0,0})|0|([1-1][0-9]{2,2})|(2[0-4][0-9]{1,1})|(25[0-4])|255)-(([1-9][0-9]{1,1})|([1-9][0-9]{0,0})|0|([1-1][0-9]{2,2})|(2[0-4][0-9]{1,1})|(25[0-4])|255))|(([1-9][0-9]{1,1})|([1-9][0-9]{0,0})|0|([1-1][0-9]{2,2})|(2[0-4][0-9]{1,1})|(25[0-4])|255)){1,1})" {
                        description 'Configure icmp-type in range mode, support single icmp-type value or range(max num:4;spacing mark:,) in <0-255>.' ;
                      }

                    }

                    mandatory true ;
                  }

                }

                container packet-length {
                  description 'Select packet-length as matching criteria.' ;
                  presence "Select packet-length as match criteria" ;
                  leaf packet-length-value {
                    description 'Configure packet-length in range mode, support single packet-length value or range(max num:4;spacing mark:,) in <1-65535>. For example,"6,10-30,40,50-60",etc.' ;
                    type ncd:range {
                      pattern "(((([1-9][0-9]{1,3})|([1-9])|([1-5][0-9]{4,4})|(6[0-4][0-9]{3,3})|(65[0-4][0-9]{2,2})|(655[0-2][0-9]{1,1})|(6553[0-5]))(-(([1-9][0-9]{1,3})|([1-9])|([1-5][0-9]{4,4})|(6[0-4][0-9]{3,3})|(65[0-4][0-9]{2,2})|(655[0-2][0-9]{1,1})|(6553[0-5]))){0,1})((,)(([1-9][0-9]{1,3})|([1-9])|([1-5][0-9]{4,4})|(6[0-4][0-9]{3,3})|(65[0-4][0-9]{2,2})|(655[0-2][0-9]{1,1})|(6553[0-5]))(-(([1-9][0-9]{1,3})|([1-9])|([1-5][0-9]{4,4})|(6[0-4][0-9]{3,3})|(65[0-4][0-9]{2,2})|(655[0-2][0-9]{1,1})|(6553[0-5]))){0,1}){0,3})" {
                        description 'Configure packet-length in range mode, support single packet-length value or range(max num:4;spacing mark:,) in <1-65535>. For example,"6,10-30,40,50-60",etc.' ;
                      }

                    }

                    mandatory true ;
                  }

                }

                container protocol {
                  description 'Select protocol as matching criteria.' ;
                  presence "Select protocol as match criteria" ;
                  leaf not {
                    description 'Configure the opposite range flag:
true  Match opposite range;
false Match current range.' ;
                    type boolean ;

                    default false ;
                  }

                  leaf protocol-value {
                    description 'Configure protocol in range mode, support single protocol value or range(max num:4;spacing mark:,) in <0-255>. For example,"6,10-30,40,50-60",etc.' ;
                    type ncd:bitmap {
                      pattern "(((((([1-9][0-9]{1,1})|([1-9][0-9]{0,0})|0|([1-1][0-9]{2,2})|(2[0-4][0-9]{1,1})|(25[0-4])|255)-(([1-9][0-9]{1,1})|([1-9][0-9]{0,0})|0|([1-1][0-9]{2,2})|(2[0-4][0-9]{1,1})|(25[0-4])|255))|(([1-9][0-9]{1,1})|([1-9][0-9]{0,0})|0|([1-1][0-9]{2,2})|(2[0-4][0-9]{1,1})|(25[0-4])|255)),){0,3}(((([1-9][0-9]{1,1})|([1-9][0-9]{0,0})|0|([1-1][0-9]{2,2})|(2[0-4][0-9]{1,1})|(25[0-4])|255)-(([1-9][0-9]{1,1})|([1-9][0-9]{0,0})|0|([1-1][0-9]{2,2})|(2[0-4][0-9]{1,1})|(25[0-4])|255))|(([1-9][0-9]{1,1})|([1-9][0-9]{0,0})|0|([1-1][0-9]{2,2})|(2[0-4][0-9]{1,1})|(25[0-4])|255)){1,1})" {
                        description 'Configure protocol in range mode, support single protocol value or range(max num:4;spacing mark:,).' ;
                      }

                    }

                    mandatory true ;
                  }

                }

                container tcp-flag {
                  description 'Select tcp-flag as matching criteria.' ;
                  presence "Select tcp-flag as match criteria" ;
                  leaf not {
                    description 'Logical negation of operation:
true  Match opposite;
false Match current.' ;
                    type boolean ;

                    default false ;
                  }

                  leaf match-relation {
                    description 'The rule of matching, see bellow:                
all  Match all of the tcp flag;
any  Match any of the tcp flag.' ;
                    type enumeration {
                      enum all {
                        value 0 ;
                        description 'Match all of the tcp flag.' ;
                      }

                      enum any {
                        value 1 ;
                        description 'Match any of the tcp flag.' ;
                      }

                    }

                    mandatory true ;
                  }

                  choice tcp-flag-option {
                    description 'TCP Flag.' ;
                    mandatory true ;
                    case tcp-flag {
                      description 'TCP Flag.' ;
                      leaf rst {
                        description 'Match on the RST bit.' ;
                        type boolean ;

                        default false ;
                      }

                      leaf ack {
                        description 'Match on the ACK bit.' ;
                        type boolean ;

                        default false ;
                      }

                      leaf fin {
                        description 'Match on the FIN bit.' ;
                        type boolean ;

                        default false ;
                      }

                      leaf syn {
                        description 'Match on the SYN bit.' ;
                        type boolean ;

                        default false ;
                      }

                      leaf psh {
                        description 'Match on the PSH bit.' ;
                        type boolean ;

                        default false ;
                      }

                      leaf urg {
                        description 'Match on the URG bit.' ;
                        type boolean ;

                        default false ;
                      }

                      leaf ece {
                        description 'Match on the ECE bit.' ;
                        type boolean ;

                        default false ;
                      }

                      leaf cwr {
                        description 'Match on the CWR bit.' ;
                        type boolean ;

                        default false ;
                      }

                    }

                  }

                }

                container flow-label {
                  description 'Select flow-label as matching criteria.' ;
                  presence "Select flow-label as match criteria" ;
                  leaf flow-label-value {
                    description 'Set flow label value.' ;
                    type uint32 {
                      range 0..1048575 ;

                    }

                    mandatory true ;
                  }

                  ncd:revise-date 2020-02-03 ;
                }

                container destination-ipv6-addr {
                  description 'Select IPv6 destination address as matching criteria.' ;
                  presence "Select IPv6 destination address as match criteria" ;
                  leaf dst-ipv6-addr {
                    description 'IPv6 destination address.' ;
                    type ncd:ipv6-address ;

                    mandatory true ;
                  }

                  leaf dst-ipv6-addr-prefix {
                    description 'IPv6 destination maskcard length, positive mask.' ;
                    type ncd:ipv6-mask-length ;

                    mandatory true ;
                  }

                  ncd:revise-date 2020-02-03 ;
                }

                container source-ipv6-addr {
                  description 'Select IPv6 source-address as matching criteria.' ;
                  presence "Select IPv6 source-address as match criteria" ;
                  leaf src-ipv6-addr {
                    description 'IPv6 source address.' ;
                    type ncd:ipv6-address ;

                    mandatory true ;
                  }

                  leaf src-ipv6-addr-prefix {
                    description 'IPv6 source maskcard length, positive mask.' ;
                    type ncd:ipv6-mask-length ;

                    mandatory true ;
                  }

                  ncd:revise-date 2020-02-03 ;
                }

                container ipv6-icmp-code {
                  description 'Select IPv6 icmp-code as matching criteria.' ;
                  presence "Select IPv6 icmp-code as match criteria" ;
                  leaf icmp-code-value {
                    description 'Configure icmp code in range mode, support single icmp-code value or range(max num:4;spacing mark:,) in <0-255>. For example,"6,10-30,40,50-60",etc.' ;
                    type ncd:bitmap {
                      pattern "(((((([1-9][0-9]{1,1})|([1-9][0-9]{0,0})|0|([1-1][0-9]{2,2})|(2[0-4][0-9]{1,1})|(25[0-4])|255)-(([1-9][0-9]{1,1})|([1-9][0-9]{0,0})|0|([1-1][0-9]{2,2})|(2[0-4][0-9]{1,1})|(25[0-4])|255))|(([1-9][0-9]{1,1})|([1-9][0-9]{0,0})|0|([1-1][0-9]{2,2})|(2[0-4][0-9]{1,1})|(25[0-4])|255)),){0,3}(((([1-9][0-9]{1,1})|([1-9][0-9]{0,0})|0|([1-1][0-9]{2,2})|(2[0-4][0-9]{1,1})|(25[0-4])|255)-(([1-9][0-9]{1,1})|([1-9][0-9]{0,0})|0|([1-1][0-9]{2,2})|(2[0-4][0-9]{1,1})|(25[0-4])|255))|(([1-9][0-9]{1,1})|([1-9][0-9]{0,0})|0|([1-1][0-9]{2,2})|(2[0-4][0-9]{1,1})|(25[0-4])|255)){1,1})" {
                        description 'Configure icmp-code in range mode, support single icmp-code value or range(max num:4;spacing mark:,) in <0-255>.' ;
                      }

                    }

                    mandatory true ;
                  }

                  ncd:revise-date 2020-02-03 ;
                }

                container ipv6-icmp-type {
                  description 'Select IPv6 icmp-type as matching criteria.' ;
                  presence "Select IPv6 icmp-type as match criteria" ;
                  leaf icmp-type-value {
                    description 'Configure icmp type in range mode, support single icmp-type value or range(max num:4;spacing mark:,) in <0-255>. For example,"6,10-30,40,50-60",etc.' ;
                    type ncd:bitmap {
                      pattern "(((((([1-9][0-9]{1,1})|([1-9][0-9]{0,0})|0|([1-1][0-9]{2,2})|(2[0-4][0-9]{1,1})|(25[0-4])|255)-(([1-9][0-9]{1,1})|([1-9][0-9]{0,0})|0|([1-1][0-9]{2,2})|(2[0-4][0-9]{1,1})|(25[0-4])|255))|(([1-9][0-9]{1,1})|([1-9][0-9]{0,0})|0|([1-1][0-9]{2,2})|(2[0-4][0-9]{1,1})|(25[0-4])|255)),){0,3}(((([1-9][0-9]{1,1})|([1-9][0-9]{0,0})|0|([1-1][0-9]{2,2})|(2[0-4][0-9]{1,1})|(25[0-4])|255)-(([1-9][0-9]{1,1})|([1-9][0-9]{0,0})|0|([1-1][0-9]{2,2})|(2[0-4][0-9]{1,1})|(25[0-4])|255))|(([1-9][0-9]{1,1})|([1-9][0-9]{0,0})|0|([1-1][0-9]{2,2})|(2[0-4][0-9]{1,1})|(25[0-4])|255)){1,1})" {
                        description 'Configure icmp-type in range mode, support single icmp-type value or range(max num:4;spacing mark:,) in <0-255>.' ;
                      }

                    }

                    mandatory true ;
                  }

                  ncd:revise-date 2020-02-03 ;
                }

                container next-header {
                  description 'Select next-header as matching criteria.' ;
                  presence "Select next-header as match criteria" ;
                  leaf not {
                    description 'Configure the opposite range flag.' ;
                    type empty ;

                  }

                  leaf next-header-value {
                    description 'Configure next-header in range mode, support single value or range(max num:4;spacing mark:,) in <0-255>. For example,"6,10-30,40,50-60",etc.' ;
                    type ncd:bitmap {
                      pattern "(((((([1-9][0-9]{1,1})|([1-9][0-9]{0,0})|0|([1-1][0-9]{2,2})|(2[0-4][0-9]{1,1})|(25[0-4])|255)-(([1-9][0-9]{1,1})|([1-9][0-9]{0,0})|0|([1-1][0-9]{2,2})|(2[0-4][0-9]{1,1})|(25[0-4])|255))|(([1-9][0-9]{1,1})|([1-9][0-9]{0,0})|0|([1-1][0-9]{2,2})|(2[0-4][0-9]{1,1})|(25[0-4])|255)),){0,3}(((([1-9][0-9]{1,1})|([1-9][0-9]{0,0})|0|([1-1][0-9]{2,2})|(2[0-4][0-9]{1,1})|(25[0-4])|255)-(([1-9][0-9]{1,1})|([1-9][0-9]{0,0})|0|([1-1][0-9]{2,2})|(2[0-4][0-9]{1,1})|(25[0-4])|255))|(([1-9][0-9]{1,1})|([1-9][0-9]{0,0})|0|([1-1][0-9]{2,2})|(2[0-4][0-9]{1,1})|(25[0-4])|255)){1,1})" {
                        description 'Configure protocol in range mode, support single protocol value or range(max num:4;spacing mark:,).' ;
                      }

                    }

                    mandatory true ;
                  }

                  ncd:revise-date 2020-02-03 ;
                }

                container tcp-flag-values {
                  description 'Select tcp-flag-value as matching criteria.' ;
                  list tcp-flag-value {
                    description 'Select tcp-flag-value as matching criteria.' ;
                    key value ;
                    leaf not {
                      description 'Logical negation of operation:
true  Match opposite;
false Match current.' ;
                      type boolean ;

                      default false ;
                    }

                    leaf match-relation {
                      description 'The rule of matching, see bellow:                
all  Match all of the tcp flag value;
any  Match any of the tcp flag value.' ;
                      type enumeration {
                        enum all {
                          value 0 ;
                          description 'Match all of the tcp flag value.' ;
                        }

                        enum any {
                          value 1 ;
                          description 'Match any of the tcp flag value.' ;
                        }

                      }

                      mandatory true ;
                    }

                    leaf value {
                      description 'The value of tcp flag.' ;
                      type uint8 {
                        range 1..255 {
                          description 'The value of tcp flag.' ;
                        }

                      }

                    }

                    leaf item-logic {
                      description 'Logical relationship of tcp flag value, see bellow:
or     Logical or relationship of tcp flag value;
and  Logical and relationship of tcp flag value.' ;
                      type enumeration {
                        enum and {
                          value 1 ;
                          description 'Logical and relationship of tcp flag value.' ;
                        }

                        enum or {
                          value 2 ;
                          description 'Logical or relationship of tcp flag value.' ;
                        }

                      }

                      mandatory true ;
                    }

                  }

                  ncd:revise-date 2022-04-27 ;
                }

              }

              container cmap-description {
                description 'Description of a class map, support 1-79 characters.' ;
                presence "Specify description of class map" ;
                leaf cmap-description {
                  description 'Description of a class map, support 1-79 characters.' ;
                  type ncd:string-with-blank {
                    length 1..79 {
                      description 'Description of a class map, support 1-79 characters.' ;
                    }

                  }

                  mandatory true ;
                }

                ncd:revise-date 2020-06-18 ;
              }

            }

          }

          ncd:revise-date 2017-06-12 ;
        }

        container class-map-id {
          description 'QoS class map lists id, this configuration is for internal use only and for external inquiry only.' ;
          container class-maps {
            description 'QoS class map lists.' ;
            list class-map {
              description 'QoS class map list.' ;
              key cmap-name ;
              leaf cmap-name {
                description 'Name of the class map, support 1-31 characters.' ;
                type string {
                  length 1..31 {
                    description 'Name of the class map, support 1-31 characters' ;
                  }

                }

              }

              leaf cmap-id {
                description 'H-QoS class map lists id.' ;
                type uint32 {
                  range 1..16000 {
                    description 'H-QoS class map lists id' ;
                  }

                }

              }

            }

          }

          ncd:revise-date 2015-03-31 ;
        }

        container flow-feature {
          description 'Class map flow feature defination.' ;
          container class-maps {
            description 'Configure QoS class map lists.' ;
            list class-map {
              description 'Configure QoS class map list.' ;
              key cmap-name ;
              leaf cmap-name {
                description 'Name of the class map, support 1-31 characters.' ;
                type string {
                  length 1..31 {
                    description 'Name of the class map, support 1-31 characters' ;
                  }

                }

              }

              container effect-order {
                description 'The value specify the class effect order in the policy map.' ;
                presence "To set the effect order value" ;
                leaf effect-order {
                  description 'The value specify the class effect order in the policy map.' ;
                  type uint32 {
                    range 1..255 {
                      description 'The value specify the class effect order in the policy map.' ;
                    }

                  }

                  mandatory true ;
                }

              }

              container match {
                description 'Configure matching criteria for a class map.' ;
                container destination-port {
                  description 'Select destination-port as matching criteria.' ;
                  presence "Select destination-port as match criteria" ;
                  leaf dst-port-value {
                    description 'Configure destination-port value in range mode, support single destination-port value or range(max num:4;spacing mark:,) in <0-65535>. For example,"1,300-400,1000,2000-4000",etc.Specifically, port value 0 can only be configured in a single value format.' ;
                    type qos-port-range ;

                    mandatory true ;
                  }

                }

                container source-port {
                  description 'Select source-port as matching criteria.' ;
                  presence "Select source-port as match criteria" ;
                  leaf src-port-value {
                    description 'Configure source-port value in range mode, support single source-port value or range(max num:4;spacing mark:,) in <0-65535>. For example,"1,300-400,1000,2000-4000",etc.Specifically, port value 0 can only be configured in a single value format.' ;
                    type qos-port-range ;

                    mandatory true ;
                  }

                }

                container destination-ipv4-addr {
                  description 'Select destination-address as matching criteria.' ;
                  presence "Select destination-address as match criteria" ;
                  leaf dst-address {
                    description 'Destination address.' ;
                    type ncd:ipv4-address ;

                    mandatory true ;
                  }

                  leaf dst-address-mask {
                    description 'Destination maskcard bits, positive mask.' ;
                    type ncd:ipv4-mask ;

                    mandatory true ;
                  }

                }

                container source-ipv4-addr {
                  description 'Select source-address as matching criteria.' ;
                  presence "Select source-address as match criteria" ;
                  leaf src-address {
                    description 'Source address.' ;
                    type ncd:ipv4-address ;

                    mandatory true ;
                  }

                  leaf src-address-mask {
                    description 'Source maskcard bits, positive mask.' ;
                    type ncd:ipv4-mask ;

                    mandatory true ;
                  }

                }

                container protocol {
                  description 'Select protocol as matching criteria.' ;
                  presence "Select protocol as match criteria" ;
                  leaf not {
                    description 'Configure the opposite range flag:
true  Match opposite range;
false Match current range.' ;
                    type boolean ;

                  }

                  leaf protocol-value {
                    description 'Configure protocol in range mode, support single protocol value or range(max num:4;spacing mark:,) in <0-255>. For example,"6,10-30,40,50-60",etc.' ;
                    type ncd:bitmap {
                      pattern "(((((([1-9][0-9]{1,1})|([1-9][0-9]{0,0})|0|([1-1][0-9]{2,2})|(2[0-4][0-9]{1,1})|(25[0-4])|255)-(([1-9][0-9]{1,1})|([1-9][0-9]{0,0})|0|([1-1][0-9]{2,2})|(2[0-4][0-9]{1,1})|(25[0-4])|255))|(([1-9][0-9]{1,1})|([1-9][0-9]{0,0})|0|([1-1][0-9]{2,2})|(2[0-4][0-9]{1,1})|(25[0-4])|255)),){0,3}(((([1-9][0-9]{1,1})|([1-9][0-9]{0,0})|0|([1-1][0-9]{2,2})|(2[0-4][0-9]{1,1})|(25[0-4])|255)-(([1-9][0-9]{1,1})|([1-9][0-9]{0,0})|0|([1-1][0-9]{2,2})|(2[0-4][0-9]{1,1})|(25[0-4])|255))|(([1-9][0-9]{1,1})|([1-9][0-9]{0,0})|0|([1-1][0-9]{2,2})|(2[0-4][0-9]{1,1})|(25[0-4])|255)){1,1})" {
                        description 'Configure protocol in range mode, support single protocol value or range(max num:4;spacing mark:,).' ;
                      }

                    }

                    mandatory true ;
                  }

                }

                container destination-ipv6-addr {
                  description 'Select IPv6 destination-address as matching criteria.' ;
                  presence "Select destination-address as match criteria" ;
                  leaf dst-address {
                    description 'IPv6 destination address.' ;
                    type ncd:ipv6-address ;

                    mandatory true ;
                  }

                  leaf dst-address-mask {
                    description 'IPv6 destination maskcard bits, positive mask.' ;
                    type uint8 {
                      range 0..128 {
                        description 'Destination maskcard bits.' ;
                      }

                    }

                    mandatory true ;
                  }

                }

                container source-ipv6-addr {
                  description 'Select IPv6 source-address as matching criteria.' ;
                  presence "Select source-address as match criteria" ;
                  leaf src-address {
                    description 'IPv6 source address.' ;
                    type ncd:ipv6-address ;

                    mandatory true ;
                  }

                  leaf src-address-mask {
                    description 'IPv6 source maskcard bits, positive mask.' ;
                    type uint8 {
                      range 0..128 {
                        description 'Source maskcard bits.' ;
                      }

                    }

                    mandatory true ;
                  }

                }

                container interface {
                  description 'Select interface name as matching criteria.' ;
                  presence "Select interface name as match criteria" ;
                  leaf if-name {
                    description 'Set interface name.' ;
                    type ncd:ifname {
                      length 1..31 {
                        description 'Name of the interface, support 1-31 characters' ;
                      }

                    }

                    mandatory true ;
                  }

                }

                container vxlan-ipv4 {
                  description 'Select VXLAN tunnel as matching criteria.' ;
                  presence "Select VXLAN tunnel as match criteria" ;
                  leaf src-address {
                    description 'Source address.' ;
                    type ncd:ipv4-address ;

                    mandatory true ;
                  }

                  leaf dst-address {
                    description 'Destination address.' ;
                    type ncd:ipv4-address ;

                    mandatory true ;
                  }

                }

                container vni {
                  description 'Select VNI (VXLAN Network Identifier) as matching criteria.' ;
                  presence "To select VNI as match criteria" ;
                  leaf vni-range1-start {
                    description 'The starting-value of the first VNI range.' ;
                    type uint32 {
                      range 1..16777215 ;

                    }

                    mandatory true ;
                  }

                  leaf vni-range1-end {
                    description 'The ending-value of the first VNI range.' ;
                    type uint32 {
                      range 1..16777215 ;

                    }

                    mandatory true ;
                  }

                  container vni-range2 {
                    description 'To select the second VNI range.' ;
                    presence "The configuration of the second VNI range" ;
                    leaf vni-range2-start {
                      description 'The starting-value of the second VNI range.' ;
                      type uint32 {
                        range 1..16777215 ;

                      }

                      mandatory true ;
                    }

                    leaf vni-range2-end {
                      description 'The ending-value of the second VNI range.' ;
                      type uint32 {
                        range 1..16777215 ;

                      }

                      mandatory true ;
                    }

                    container vni-range3 {
                      description 'To select the third VNI range.' ;
                      presence "The configuration of the third VNI range" ;
                      leaf vni-range3-start {
                        description 'The starting-value of the third VNI range.' ;
                        type uint32 {
                          range 1..16777215 ;

                        }

                        mandatory true ;
                      }

                      leaf vni-range3-end {
                        description 'The ending-value of the third VNI range.' ;
                        type uint32 {
                          range 1..16777215 ;

                        }

                        mandatory true ;
                      }

                      container vni-range4 {
                        description 'To select the fourth VNI range.' ;
                        presence "The configuration of the fourth VNI range" ;
                        leaf vni-range4-start {
                          description 'The starting-value of the fourth VNI range.' ;
                          type uint32 {
                            range 1..16777215 ;

                          }

                          mandatory true ;
                        }

                        leaf vni-range4-end {
                          description 'The ending-value of the fourth VNI range.' ;
                          type uint32 {
                            range 1..16777215 ;

                          }

                          mandatory true ;
                        }

                      }

                    }

                  }

                }

                container vxlan-ipv6 {
                  description 'Select VXLAN tunnel as matching criteria.' ;
                  presence "Select VXLAN tunnel as match criteria" ;
                  leaf src-address {
                    description 'Source address.' ;
                    type ncd:ipv6-address ;

                    mandatory true ;
                  }

                  leaf dst-address {
                    description 'Destination address.' ;
                    type ncd:ipv6-address ;

                    mandatory true ;
                  }

                  ncd:revise-date 2020-03-05 ;
                }

              }

              container cmap-description {
                description 'Description of a class map, support 1-79 characters.' ;
                presence "Specify description of class map" ;
                leaf cmap-description {
                  description 'Description of a class map, support 1-79 characters.' ;
                  type ncd:string-with-blank {
                    length 1..79 {
                      description 'Description of a class map, support 1-79 characters.' ;
                    }

                  }

                  mandatory true ;
                }

                ncd:revise-date 2020-06-18 ;
              }

            }

          }

          ncd:revise-date 2019-04-15 ;
        }

        container traffic-based {
          description 'Class map based on traffic.' ;
          container class-maps {
            description 'Configure QoS class map lists.' ;
            list class-map {
              description 'Configure QoS class map list.' ;
              key cmap-name ;
              leaf cmap-name {
                description 'Name of the class map, support 1-31 characters.' ;
                type string {
                  length 1..31 {
                    description 'Name of the class map, support 1-31 characters' ;
                  }

                }

              }

              leaf match-relation {
                description 'The type of packets matching, see bellow:                
match-all Packets meet all of the match criteria;
match-any Packets meet any of the match criteria.' ;
                type enumeration {
                  enum match-all {
                    value 1 ;
                    description 'Packets meet all of the match criteria' ;
                  }

                  enum match-any {
                    value 2 ;
                    description 'Packets meet any of the match criteria' ;
                  }

                }

                mandatory true ;
              }

              container match {
                description 'Configure matching criteria for a class map.' ;
                container dscps {
                  description 'Select DSCP as matching criteria.' ;
                  list dscp {
                    description 'Set DSCP value as matching criteria.' ;
                    key ip-type ;
                    leaf ip-type {
                      description 'Configure DSCP value Based on IP, see below:
any  Packets based on any IP;
ipv4 Packets based on IPv4;
ipv6 Packets based on IPv6.' ;
                      type qos-ip-type ;

                    }

                    leaf not {
                      description 'Configure the opposite range flag:
true  Match opposite range;
false Match current range.' ;
                      type boolean ;

                      default false ;
                    }

                    leaf dscp-value {
                      description 'Configure QoS dscp in range mode, support single DSCP value or range(max num:4;spacing mark:,) in <0-63>. For example,"6,10-30,40,50-60",etc.' ;
                      type qos-dscp-bitmap ;

                      mandatory true ;
                    }

                  }

                }

                container dscp-exs {
                  if-feature class-match-dscp-ex ;

                  description 'Select the identification code mapped from DSCP to PHB (Per Hop Behavior), that is, reserve keywords as matching criteria.' ;
                  list dscp-ex {
                    description 'Set  the reserved keyword as matching criteria.' ;
                    key 'ip-type reserved-words' ;
                    leaf ip-type {
                      description 'Configure DSCP value Based on IP, see below:
any  Packets based on any IP;
ipv4 Packets based on IPv4;
ipv6 Packets based on IPv6.' ;
                      type qos-ip-type ;

                    }

                    leaf reserved-words {
                      description 'Configure the reserved keyword.' ;
                      type qos-reserved-words ;

                    }

                  }

                }

                container precedences {
                  description 'Select IP-Precedence as matching criteria.' ;
                  list precedence {
                    description 'Set IP Precedence value as matching criteria.' ;
                    key ip-type ;
                    leaf ip-type {
                      description 'Configure DSCP value Based on IP, see below:
any  Packets based on any IP;
ipv4 Packets based on IPv4;
ipv6 Packets based on IPv6.' ;
                      type qos-ip-type ;

                    }

                    leaf not {
                      description 'Configure the opposite range flag:
true  Match opposite range;
false Match current range.' ;
                      type boolean ;

                      default false ;
                    }

                    leaf prec-value {
                      description 'Configure QoS IP Precedence in range mode, support single precedence value or range(max num:4;spacing mark:,) in <0-7>. For example,"0,2-4,7",etc.' ;
                      type qos-prec-bitmap ;

                      mandatory true ;
                    }

                  }

                }

                container mpls-exp {
                  description 'Select MPLS-EXP as matching criteria.' ;
                  presence "Select MPLS-EXP as match criteria" ;
                  leaf mpls-exp-value {
                    description 'Configure QoS MPLS-EXP value in range mode, support single MPLS-EXP value or range(max num:4;spacing mark:,) in <0-7>. For example,"0,2-4,7",etc.' ;
                    type qos-mpls-bitmap ;

                    mandatory true ;
                  }

                }

                container in-vlan {
                  description 'Select inner-VLAN as matching criteria.' ;
                  presence "Select inner-VLAN as match criteria" ;
                  leaf vlan-value {
                    description 'Configure inner-VLAN value in range mode, support single inner-VLAN value or range(max num:4;spacing mark:,) in <1-4094>. For example,"1,300-400,1000,2000-4000",etc.' ;
                    type qos-vlan-bitmap ;

                    mandatory true ;
                  }

                }

                container out-vlan {
                  description 'Select outer-VLAN as matching criteria.' ;
                  presence "Select outer-VLAN as match criteria" ;
                  leaf vlan-value {
                    description 'Configure outer-VLAN value in range mode, support single outer-VLAN value or range(max num:4;spacing mark:,) in <1-4094>. For example,"1,300-400,1000,2000-4000",etc.' ;
                    type qos-vlan-bitmap ;

                    mandatory true ;
                  }

                }

                container in-8021p {
                  description 'Select inner 802.1p as matching criteria.' ;
                  presence "Select inner 802.1p as match criteria" ;
                  leaf in-8021p-value {
                    description 'Configure inner 802.1p value in range mode, support single 802.1p value or range(max num:4;spacing mark:,) in <0-7>. For example,"0,2-4,7",etc.' ;
                    type qos-8021p-bitmap ;

                    mandatory true ;
                  }

                }

                container out-8021p {
                  description 'Select outer 802.1p as matching criteria.' ;
                  presence "Select outer 802.1p as match criteria" ;
                  leaf out-8021p-value {
                    description 'Configure outer 802.1p value in range mode, support single 802.1p value or range(max num:4;spacing mark:,) in <0-7>. For example,"0,2-4,7",etc.' ;
                    type qos-8021p-bitmap ;

                    mandatory true ;
                  }

                }

                container qos-group {
                  description 'Select qos-group as matching criteria.' ;
                  presence "Select qos-group as match criteria" ;
                  leaf qos-id {
                    description 'Set qos-group number, support <1-65535>.' ;
                    type uint16 {
                      range 1..65535 ;

                    }

                    mandatory true ;
                  }

                }

                container vrf-name {
                  description 'Select vrf-name as matching criteria.' ;
                  presence "Select vrf-name as match criteria" ;
                  leaf vrf-name {
                    description 'Set vrf name, support 1-32 characters.' ;
                    type string {
                      length 1..32 {
                        description 'Vrf name, support 1-32 characters' ;
                      }

                    }

                    mandatory true ;
                  }

                  if-feature traffic-match-vrf {
                    ncd:revise-date 2024-07-17 ;
                  }

                }

                container uni-cast {
                  description 'Select unicast as matching criteria.' ;
                  presence "Select unicast as match criteria" ;
                  leaf uni-cast {
                    description 'Set unicast.' ;
                    type empty ;

                    mandatory true ;
                  }

                }

                container multi-cast {
                  description 'Select multicast as matching criteria.' ;
                  presence "Select multicast as match criteria" ;
                  leaf multi-cast {
                    description 'Set multicast.' ;
                    type empty ;

                    mandatory true ;
                  }

                }

                container mac-addr {
                  description 'Select mac-address as matching criteria.' ;
                  presence "Select mac-address as match criteria" ;
                  leaf mac-address {
                    description 'Configure mac-address.' ;
                    type ncd:mac-address ;

                    mandatory true ;
                  }

                }

                container ipv4-acls {
                  description 'Select IPv4 ACL name as matching criteria.' ;
                  list ipv4-acl {
                    description 'Set IPv4 ACL name as matching criteria.' ;
                    key acl-name ;
                    leaf acl-name {
                      description 'Set ipv4-access-list name, support 1-31 characters.' ;
                      type string {
                        length 1..31 {
                          description 'Name of ACL, support 1-31 characters' ;
                        }

                      }

                    }

                  }

