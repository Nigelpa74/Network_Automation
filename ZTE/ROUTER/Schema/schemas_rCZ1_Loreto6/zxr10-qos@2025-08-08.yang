                container ipv6-acls {
                  description 'Select IPv6 ACL name as matching criteria.' ;
                  list ipv6-acl {
                    description 'Set IPv6 ACL name as matching criteria.' ;
                    key acl-name ;
                    leaf acl-name {
                      description 'Set ipv6-access-list name, support 1-31 characters.' ;
                      type string {
                        length 1..31 {
                          description 'Name of ACL, support 1-31 characters' ;
                        }

                      }

                    }

                  }

                }

                container link-acls {
                  if-feature class-match-link-acl ;

                  description 'Select link ACL name as matching criteria.' ;
                  list link-acl {
                    description 'Set link ACL name as matching criteria.' ;
                    key acl-name ;
                    leaf acl-name {
                      description 'Set link-access-list name, support 1-31 characters.' ;
                      type string {
                        length 1..31 {
                          description 'Name of ACL, support 1-31 characters' ;
                        }

                      }

                    }

                  }

                }

                container vpws {
                  description 'Select VPWS instance name as matching criteria.' ;
                  presence "Select VPWS instance name as match criteria" ;
                  leaf vpws-name {
                    description 'Set VPWS instance name, support 1-32 characters.' ;
                    type string {
                      length 1..32 {
                        description 'VPWS instance name, support 1-32 characters' ;
                      }

                    }

                    mandatory true ;
                  }

                }

                container vpls {
                  description 'Select VPLS instance name as matching criteria.' ;
                  presence "Select VPLS instance name as match criteria" ;
                  leaf vpls-name {
                    description 'Set VPLS instance name, support 1-32 characters.' ;
                    type string {
                      length 1..32 {
                        description 'VPLS instance name, support 1-32 characters' ;
                      }

                    }

                    mandatory true ;
                  }

                }

                container service-class {
                  if-feature phb-mode ;

                  description 'Select PHB as matching criteria.' ;
                  presence "Select PHB as match criteria" ;
                  leaf service-class {
                    description 'Select service class of PHB info.' ;
                    type qos-service-class ;

                    mandatory true ;
                  }

                }

                container vni {
                  description 'To select VNI (VXLAN Network Identifier) as matching criteria.' ;
                  presence "To select VNI as match criteria" ;
                  leaf vni-range1-start {
                    description 'The starting-value of the first VNI range.' ;
                    type uint32 {
                      range 1..16777215 ;

                    }

                    mandatory true ;
                  }

                  leaf vni-range1-end {
                    description 'The ending-value of the first VNI range.' ;
                    type uint32 {
                      range 1..16777215 ;

                    }

                    mandatory true ;
                  }

