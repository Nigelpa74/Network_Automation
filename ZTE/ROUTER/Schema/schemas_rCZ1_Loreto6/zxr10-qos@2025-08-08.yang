                container applications {
                  description 'Select application as matching criteria.' ;
                  list application {
                    description 'Select application as matching criteria.' ;
                    key application-name ;
                    leaf application-name {
                      description 'Set application name, support 1-31 characters.' ;
                      type string {
                        length 1..31 {
                          description 'Name of the application, support 1-31 characters' ;
                        }

                      }

                    }

                    leaf application-id {
                      description 'Set application id, support <1-65535>.' ;
                      type uint32 {
                        range 1..65535 ;

