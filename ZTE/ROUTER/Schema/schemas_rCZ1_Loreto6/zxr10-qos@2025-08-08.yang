                            description 'Configure the CIR.' ;
                            leaf cir {
                              description 'Configure the CIR (Committed Information Rate) value, default: kilobits per second.' ;
                              type uint32 {
                                range 8..4294967295 {
                                  description 'The CIR value (default: kilobits per second),support <8-4294967295>' ;
                                }

                              }

