                                  description '802.1p value, support <0-7>' ;
                                }

                              }

                              mandatory true ;
                            }

                            leaf inner-outer {
                              description 'Set 8021p inner or outer flag.If vlaue is 0, it means outer flag. If value is 1,it means inner and outer flag.' ;
                              type uint8 {
                                range 0..1 {
                                  description 'Inner or outer flag. 0 is outer. 1 is inner and outer' ;
                                }

                              }

                              default 0 ;
                            }

                          }

                        }

                        case inherit {
                          status obsolete {
                            ncd:revise-date 2021-06-04 ;
                          }

                          description 'Set the 802.1p value by inheriting.' ;
                          container inherit {
                            description 'Set the 802.1p value by inheriting.' ;
                            leaf inherit-type {
                              description 'Specify the source inherit type, such as precedence, mpls-exp, 8021p, dscp.' ;
                              type enumeration {
                                enum precedence {
                                  value 1 ;
                                  description 'Select precedence as source inherit' ;
                                }

                                enum mpls-exp {
                                  value 2 ;
                                  description 'Select MPLS-EXP as source inherit' ;
