  typedef qos-dscp-bitmap {
    type ncd:bitmap {
      pattern "(((((([1-9][0-9]{0,0})|0|([1-5][0-9]{1,1})|(6[0-2])|63)-(([1-9][0-9]{0,0})|0|([1-5][0-9]{1,1})|(6[0-2])|63))|(([1-9][0-9]{0,0})|0|([1-5][0-9]{1,1})|(6[0-2])|63)),){0,3}(((([1-9][0-9]{0,0})|0|([1-5][0-9]{1,1})|(6[0-2])|63)-(([1-9][0-9]{0,0})|0|([1-5][0-9]{1,1})|(6[0-2])|63))|(([1-9][0-9]{0,0})|0|([1-5][0-9]{1,1})|(6[0-2])|63)){1,1})" {
        description 'Configure DSCP in range mode, support single DSCP value or range(max num:4;spacing mark:,) in <0-63>.' ;
      }

    }

    description 'The definition of QoS dscp in range mode, support single DSCP value or range(max num:4;spacing mark:,) in <0-63>. For example,"6,10-30,40,50-60",etc.' ;
  }

  typedef qos-prec-bitmap {
    type ncd:bitmap {
      pattern "(((([0-7]-[0-7])|[0-7]),){0,3}(([0-7]-[0-7])|([0-7])){1,1})" {
        description 'Configure IP-Precedence in range mode, support single precedence value or range(max num:4;spacing mark:,) in <0-7>.' ;
      }

    }

    description 'The definition of QoS IP-Precedence in range mode, support single precedence value or range(max num:4;spacing mark:,) in <0-7>. For example,"0,4-7",etc.' ;
  }

  typedef qos-vlan-bitmap {
    type ncd:bitmap {
      pattern "(((((([1-9][0-9]{1,2})|([2-9][0-9]{0,0})|1|([1-3][0-9]{3,3})|(40[0-8][0-9]{1,1})|(409[0-3])|4094)-(([1-9][0-9]{1,2})|([2-9][0-9]{0,0})|1|([1-3][0-9]{3,3})|(40[0-8][0-9]{1,1})|(409[0-3])|4094))|(([1-9][0-9]{1,2})|([2-9][0-9]{0,0})|1|([1-3][0-9]{3,3})|(40[0-8][0-9]{1,1})|(409[0-3])|4094)),){0,3}(((([1-9][0-9]{1,2})|([2-9][0-9]{0,0})|1|([1-3][0-9]{3,3})|(40[0-8][0-9]{1,1})|(409[0-3])|4094)-(([1-9][0-9]{1,2})|([2-9][0-9]{0,0})|1|([1-3][0-9]{3,3})|(40[0-8][0-9]{1,1})|(409[0-3])|4094))|(([1-9][0-9]{1,2})|([2-9][0-9]{0,0})|1|([1-3][0-9]{3,3})|(40[0-8][0-9]{1,1})|(409[0-3])|4094)){1,1})" {
        description 'Configure VLAN in range mode, support single VLAN value or range(max num:4;spacing mark:,) in <1-4094>.' ;
      }

    }

    description 'The definition of QoS VLAN in range mode, support single VLAN value or range(max num:4;spacing mark:,) in <1-4094>. For example,"1-300,400,450-500",etc.' ;
  }

  typedef qos-mpls-bitmap {
    type ncd:bitmap {
      pattern "(((([0-7]-[0-7])|[0-7]),){0,3}(([0-7]-[0-7])|([0-7])){1,1})" {
        description 'Configure MPLS-EXP in range mode, support single MPLS-EXP value or range(max num:4;spacing mark:,) in <0-7>.' ;
      }

    }

    description 'The definition of QoS MPLS-EXP in range mode, support single MPLS-EXP value or range(max num:4;spacing mark:,) in <0-7>. For example,"0,3-5,7",etc.' ;
  }

  typedef qos-8021p-bitmap {
    type ncd:bitmap {
      pattern "(((([0-7]-[0-7])|[0-7]),){0,3}(([0-7]-[0-7])|([0-7])){1,1})" {
        description 'Configure 802.1p in range mode, support single 802.1p value or range(max num:4;spacing mark:,) in <0-7>.' ;
      }

    }

    description 'The definition of QoS 802.1p in range mode, support single 802.1p value or range(max num:4;spacing mark:,) in <0-7>. For example,"0,3-5,7",etc.' ;
  }

  typedef qos-vlan-range {
    type ncd:range {
      pattern "(((((([1-9][0-9]{1,2})|([2-9][0-9]{0,0})|1|([1-3][0-9]{3,3})|(40[0-8][0-9]{1,1})|(409[0-3])|4094)-(([1-9][0-9]{1,2})|([2-9][0-9]{0,0})|1|([1-3][0-9]{3,3})|(40[0-8][0-9]{1,1})|(409[0-3])|4094))|(([1-9][0-9]{1,2})|([2-9][0-9]{0,0})|1|([1-3][0-9]{3,3})|(40[0-8][0-9]{1,1})|(409[0-3])|4094)),){0,3}(((([1-9][0-9]{1,2})|([2-9][0-9]{0,0})|1|([1-3][0-9]{3,3})|(40[0-8][0-9]{1,1})|(409[0-3])|4094)-(([1-9][0-9]{1,2})|([2-9][0-9]{0,0})|1|([1-3][0-9]{3,3})|(40[0-8][0-9]{1,1})|(409[0-3])|4094))|(([1-9][0-9]{1,2})|([2-9][0-9]{0,0})|1|([1-3][0-9]{3,3})|(40[0-8][0-9]{1,1})|(409[0-3])|4094)){1,1})" {
        description 'Configure VLAN in range mode, support single VLAN value or range(max num:4;spacing mark:,) in <1-4094>.' ;
      }

    }

    description 'The definition of QoS VLAN in range mode, support single VLAN value or range(max num:4;spacing mark:,) in <1-4094>. For example,"1-300,400,450-500",etc.' ;
  }

  typedef qos-service-class {
    type enumeration {
      enum be {
        value 1 ;
        description 'Best effort' ;
      }

      enum af1 {
        value 2 ;
        description 'Assured forwarding class 1' ;
      }

      enum af2 {
        value 3 ;
        description 'Assured forwarding class 2' ;
      }

      enum af3 {
        value 4 ;
        description 'Assured forwarding class 3' ;
      }

      enum af4 {
        value 5 ;
        description 'Assured forwarding class 4' ;
      }

      enum ef {
        value 6 ;
        description 'Expedited forward' ;
      }

      enum cs6 {
        value 7 ;
        description 'Internetwork control service class' ;
      }

      enum cs7 {
        value 8 ;
        description 'Network control service class' ;
      }

    }

    description 'The definition of server class of PHB info, see below:
             be (1) Best effort
             af1(2) Assured forwarding class 1
             af2(3) Assured forwarding class 2
             af3(4) Assured forwarding class 3
             af4(5) Assured forwarding class 4
             ef (6) Expedited forward
             cs6(7) Internetwork control service class
             cs7(8) Network control service class' ;
  }

  typedef qos-color-type {
    type enumeration {
      enum green {
        value 1 ;
        description 'Green packets' ;
      }

      enum yellow {
        value 2 ;
        description 'Yellow packets' ;
      }

      enum red {
        value 3 ;
        description 'Red packets' ;
      }

    }

    description 'The definition of color type of PHB info, see below:
             green  (1) Green packets
             yellow (2) Yellow packets
             red    (3) Red packets' ;
  }

  typedef qos-reserved-words {
    type enumeration {
      enum default {
        value 0 ;
        description 'Match packets with default dscp (000000)' ;
      }

      enum af11 {
        value 10 ;
        description 'Match packets with AF11 dscp (001010)' ;
      }

      enum af12 {
        value 12 ;
        description 'Match packets with AF12 dscp (001100)' ;
      }

      enum af13 {
        value 14 ;
        description 'Match packets with AF13 dscp (001110)' ;
      }

      enum af21 {
        value 18 ;
        description 'Match packets with AF21 dscp (010010)' ;
      }

      enum af22 {
        value 20 ;
        description 'Match packets with AF22 dscp (010100)' ;
      }

      enum af23 {
        value 22 ;
        description 'Match packets with AF23 dscp (010110)' ;
      }

      enum af31 {
        value 26 ;
        description 'Match packets with AF31 dscp (011010)' ;
      }

      enum af32 {
        value 28 ;
        description 'Match packets with AF32 dscp (011100)' ;
      }

      enum af33 {
        value 30 ;
        description 'Match packets with AF33 dscp (011110)' ;
      }

      enum af41 {
        value 34 ;
        description 'Match packets with AF41 dscp (100010)' ;
      }

      enum af42 {
        value 36 ;
        description 'Match packets with AF42 dscp (100100)' ;
      }

      enum af43 {
        value 38 ;
        description 'Match packets with AF43 dscp (100110)' ;
      }

      enum ef {
        value 46 ;
        description 'Match packets with EF dscp (101110)' ;
      }

      enum cs1 {
        value 8 ;
        description 'Match packets with CS1(precedence 1) dscp (001000)' ;
      }

      enum cs2 {
        value 16 ;
        description 'Match packets with CS2(precedence 2) dscp (010000)' ;
      }

      enum cs3 {
        value 24 ;
        description 'Match packets with CS3(precedence 3) dscp (011000)' ;
      }

      enum cs4 {
        value 32 ;
        description 'Match packets with CS4(precedence 4) dscp (100000)' ;
      }

      enum cs5 {
        value 40 ;
        description 'Match packets with CS5(precedence 5) dscp (101000)' ;
      }

      enum cs6 {
        value 48 ;
        description 'Match packets with CS6(precedence 6) dscp (110000)' ;
      }

      enum cs7 {
        value 56 ;
        description 'Match packets with CS7(precedence 7) dscp (111000)' ;
      }

    }

    description 'The definition of resserved words of DSCP info ,see below:
      default(0) Match packets with default dscp (000000)      
      af11(10)   Match packets with AF11 dscp (001010)                                
      af12(12)   Match packets with AF12 dscp (001100)                                
      af13(14)   Match packets with AF13 dscp (001110)                                
      af21(18)   Match packets with AF21 dscp (010010)                                
      af22(20)   Match packets with AF22 dscp (010100)                                
      af23(22)   Match packets with AF23 dscp (010110)                                
      af31(26)   Match packets with AF31 dscp (011010)                                
      af32(28)   Match packets with AF32 dscp (011100)                                
      af33(30)   Match packets with AF33 dscp (011110)                                
      af41(34)   Match packets with AF41 dscp (100010)                                
      af42(36)   Match packets with AF42 dscp (100100)                                
      af43(38)   Match packets with AF43 dscp (100110)   
      ef(46)     Match packets with EF dscp (101110)                             
      cs1(8)     Match packets with CS1(precedence 1) dscp (001000)                   
      cs2(16)    Match packets with CS2(precedence 2) dscp (010000)                   
      cs3(24)    Match packets with CS3(precedence 3) dscp (011000)                   
      cs4(32)    Match packets with CS4(precedence 4) dscp (100000)                   
      cs5(40)    Match packets with CS5(precedence 5) dscp (101000)                   
      cs6(48)    Match packets with CS6(precedence 6) dscp (110000)                   
      cs7(56)    Match packets with CS7(precedence 7) dscp (111000)' ;
  }

  typedef qos-ip-type {
    type enumeration {
      enum any {
        value 0 ;
        description 'Based on any IP' ;
      }

      enum ipv4 {
        value 1 ;
        description 'Based on IPv4' ;
      }

      enum ipv6 {
        value 2 ;
        description 'Based on IPv6' ;
      }

    }

    description 'Configure based on IP, see below:
      any  Packets based on any IP;
      ipv4 Packets based on IPv4;
      ipv6 Packets based on IPv6;' ;
  }

  typedef qos-rate-unit-type {
    type enumeration {
      enum kbps {
        value 1 ;
        description 'Kilobits per second' ;
      }

      enum mbps {
        value 2 ;
        description 'Megabits per second' ;
      }

      enum gbps {
        value 3 ;
        description 'Gigabits per second' ;
      }

    }

    description 'The definition of rate unit of police car info, see below:
             kbps  (1) Kilobits per second
             mbps  (2) Megabits per second
             gbps  (3) Gigabits per second' ;
  }

  typedef qos-bucket-unit-type {
    type enumeration {
      enum kb {
        value 1 ;
        description 'Kilobits' ;
      }

      enum mb {
        value 2 ;
        description 'Megabits' ;
      }

      enum gb {
        value 3 ;
        description 'Gigabits' ;
      }

    }

    description 'The definition of bucket unit of police car info, see below:
             kb  (1) Kilobyte
             mb  (2) Megabyte
             gb  (3) Gigabyte' ;
  }

  typedef qos-threshold-unit-type {
    type enumeration {
      enum kbytes {
        value 1 ;
        description 'Kilobytes' ;
      }

      enum mbytes {
        value 2 ;
        description 'Megabytes' ;
      }

      enum gbytes {
        value 3 ;
        description 'Gigabytes' ;
      }

    }

    description 'The definition of threshold unit of wred info, see below:
             kb  (1) Kilobytes
             mb  (2) Megabytes
             gb  (3) Gigabytes' ;
  }

  typedef qos-direction {
    type enumeration {
      enum input {
        value 1 ;
        description 'input  Attaches to the input flow' ;
      }

      enum output {
        value 2 ;
        description 'output Attaches to the output flow' ;
      }

    }

    description 'The flow direction, as follows,
     input  Attaches to the input flow
     output Attaches to the output flow' ;
  }

  typedef qos-port-range {
    type ncd:range {
      pattern "(((((([1-9][0-9]{1,3})|([1-9][0-9]{0,0})|0|([1-5][0-9]{4,4})|(6[0-4][0-9]{3,3})|(65[0-4][0-9]{2,2})|(655[0-2][0-9]{1,1})|(6553[0-4])|65535)-(([1-9][0-9]{1,3})|([1-9][0-9]{0,0})|0|([1-5][0-9]{4,4})|(6[0-4][0-9]{3,3})|(65[0-4][0-9]{2,2})|(655[0-2][0-9]{1,1})|(6553[0-4])|65535))|(([1-9][0-9]{1,3})|([1-9][0-9]{0,0})|0|([1-5][0-9]{4,4})|(6[0-4][0-9]{3,3})|(65[0-4][0-9]{2,2})|(655[0-2][0-9]{1,1})|(6553[0-4])|65535)),){0,3}(((([1-9][0-9]{1,3})|([1-9][0-9]{0,0})|0|([1-5][0-9]{4,4})|(6[0-4][0-9]{3,3})|(65[0-4][0-9]{2,2})|(655[0-2][0-9]{1,1})|(6553[0-4])|65535)-(([1-9][0-9]{1,3})|([1-9][0-9]{0,0})|0|([1-5][0-9]{4,4})|(6[0-4][0-9]{3,3})|(65[0-4][0-9]{2,2})|(655[0-2][0-9]{1,1})|(6553[0-4])|65535))|(([1-9][0-9]{1,3})|([1-9][0-9]{0,0})|0|([1-5][0-9]{4,4})|(6[0-4][0-9]{3,3})|(65[0-4][0-9]{2,2})|(655[0-2][0-9]{1,1})|(6553[0-4])|65535)){1,1})" {
        description 'Configure port in range mode, support single port value or range(max num:4;spacing mark:,) in <0-65535>.' ;
      }

    }

    description 'The definition of port in range mode, support single port value or range(max num:4;spacing mark:,) in <0-65535>. For example,"1-300,400,450-500",etc.' ;
  }

  typedef qos-rate-unit-type-ex {
    type enumeration {
      enum kbps {
        value 1 ;
        description 'Kilobits per second' ;
      }

      enum mbps {
        value 2 ;
        description 'Megabits per second' ;
      }

      enum gbps {
        value 3 ;
        description 'Gigabits per second' ;
      }

      enum pps {
        value 4 ;
        description 'Packets per second' ;
      }

    }

    description 'The definition of rate unit of police car info, see below:
             kbps  (1) Kilobits per second
             mbps  (2) Megabits per second
             gbps  (3) Gigabits per second
             pps   (4) Packets per second' ;
  }

  typedef qos-phb-bitmap {
    type ncd:bitmap {
      pattern "(((([0-7]-[0-7])|[0-7]),){0,3}(([0-7]-[0-7])|([0-7])){1,1})" {
        description 'Configure phb in range mode, support single phb value or range(max num:4;spacing mark:,) in <0-7>.' ;
      }

    }

    description 'The definition of phb in range mode, support single phb value or range(max num:4;spacing mark:,) in <0-7>. For example,"0,4-7",etc.' ;
  }

  typedef qos-stats-switch-status {
    type enumeration {
      enum on {
        value 0 ;
        description 'Switch on' ;
      }

    }

    description 'Swtich status:
  0: swtich on.' ;
  }

  typedef hqos-stats-switch-status {
    type enumeration {
      enum on {
        value 1 ;
        description 'Switch on' ;
      }

      enum off {
        value 3 ;
        description 'Switch off' ;
      }

    }

    description 'Swtich status:
  1: swtich on.
  3: swtich off.' ;
  }

  typedef qos-stats-global-switch-status {
    type enumeration {
      enum on {
        value 1 ;
        description 'Switch on' ;
      }

    }

    description 'Switch status:
  1: switch on.' ;
  }

  typedef if-car-stats-clear-match-type {
    type enumeration {
      enum localport {
        description 'match localport.' ;
        value 1 ;
      }

      enum ipv4-access-list {
        value 5 ;
        description 'match IPv4 ACL.' ;
      }

      enum ipv6-access-list {
        description 'match IPv6 ACL.' ;
        value 6 ;
      }

      enum link-access-list {
        value 15 ;
        description 'match link ACL.' ;
      }

    }

    description 'IF-CAR match type:
  1: localport.
  5: ipv4-access-list.
  6: ipv6-access-list.
  15: link-access-list.' ;
  }

  container configuration {
    description 'Configuration information.' ;
    container qos {
      description 'Configuration about QoS.' ;
      container class-map {
        description 'Configure QoS class map.' ;
        container normal {
          if-feature normal-mode ;

          description 'Class map based on normal.' ;
          container class-maps {
            description 'Configure H-QoS class map lists.' ;
            list class-map {
              description 'Configure H-QoS class map list.' ;
              key cmap-name ;
              leaf cmap-name {
                description 'Name of the class map, support 1-31 characters.' ;
                type string {
                  length 1..31 {
                    description 'Name of the class map, support 1-31 characters' ;
                  }

                }

              }

              leaf match-relation {
                description 'The type of packets matching, see bellow:
match-all Packets meet all of the match criteria;
match-any Packets meet any of the match criteria.' ;
                type enumeration {
                  enum match-all {
                    value 1 ;
                    description 'Packets meet all of the match criteria' ;
                  }

                  enum match-any {
                    value 2 ;
                    description 'Packets meet any of the match criteria' ;
                  }

                }

                mandatory true ;
              }

              container service-type {
                description 'The same value represents the same class-map.' ;
                presence "To set the service type value" ;
                leaf service-type {
                  description 'The same service type value represents the same class-map.' ;
                  type uint32 {
                    range 1..255 {
                      description 'The same service type value represents the same class-map.' ;
                    }

                  }

                  mandatory true ;
                }

                container effect-order {
                  description 'The value specify the class effect order in the policy map.' ;
                  presence "To set the effect order value" ;
                  leaf effect-order {
                    description 'The value specify the class effect order in the policy map.' ;
                    type uint32 {
                      range 1..255 {
                        description 'The value specify the class effect order in the policy map.' ;
                      }

                    }

                    mandatory true ;
                  }

                }

                ncd:revise-date 2017-06-12 ;
              }

              container match {
                description 'Configure matching criteria for a class map.' ;
                container dscps {
                  description 'Select DSCP as matching criteria.' ;
                  list dscp {
                    description 'Set DSCP as matching criteria.' ;
                    key ip-type ;
                    leaf ip-type {
                      description 'Configure DSCP value Based on IP, see below:
any  Packets based on any IP;
ipv4 Packets based on IPv4;
ipv6 Packets based on IPv6.' ;
                      type qos-ip-type ;

                    }

                    leaf not {
                      description 'Configure the opposite range flag:
true  Match opposite range;
false Match current range.' ;
                      type boolean ;

                      default false ;
                    }

                    leaf dscp-value {
                      description 'Configure QoS dscp in range mode, support single DSCP value or range(max num:4;spacing mark:,) in <0-63>. For example,"6,10-30,40,50-60",etc.' ;
                      type qos-dscp-bitmap ;

                      mandatory true ;
                    }

                  }

                }

                container dscp-exs {
                  if-feature class-match-dscp-ex ;

                  description 'Select the identification code mapped from DSCP to PHB (Per Hop Behavior), that is, reserve keywords as matching criteria.' ;
                  list dscp-ex {
                    description 'Set  the reserved keyword as matching criteria.' ;
                    key 'ip-type reserved-words' ;
                    leaf ip-type {
                      description 'Configure DSCP value Based on IP, see below:
any  Packets based on any IP;
ipv4 Packets based on IPv4;
ipv6 Packets based on IPv6.' ;
                      type qos-ip-type ;

                    }

                    leaf reserved-words {
                      description 'Configure the reserved keyword.' ;
                      type qos-reserved-words ;

                    }

                  }

                }

                container precedences {
                  description 'Select IP-Precedence as matching criteria.' ;
                  list precedence {
                    description 'Set IP Precedence value as matching criteria.' ;
                    key ip-type ;
                    leaf ip-type {
                      description 'Configure DSCP value Based on IP, see below:
any  Packets based on any IP;
ipv4 Packets based on IPv4;
ipv6 Packets based on IPv6.' ;
                      type qos-ip-type ;

                    }

                    leaf not {
                      description 'Configure the opposite range flag:
true  Match opposite range;
false Match current range.' ;
                      type boolean ;

                      default false ;
                    }

                    leaf prec-value {
                      description 'Configure QoS IP Precedence in range mode, support single precedence value or range(max num:4;spacing mark:,) in <0-7>. For example,"0,2-4,7",etc.' ;
                      type qos-prec-bitmap ;

                      mandatory true ;
                    }

                  }

                }

                container mpls-exp {
                  description 'Select MPLS-EXP as matching criteria.' ;
                  presence "Select MPLS-EXP as match criteria" ;
                  leaf mpls-exp-value {
                    description 'Configure QoS MPLS-EXP value in range mode, support single MPLS-EXP value or range(max num:4;spacing mark:,) in <0-7>. For example,"0,2-4,7",etc.' ;
                    type qos-mpls-bitmap ;

                    mandatory true ;
                  }

                }

                container in-vlan {
                  description 'Select inner-VLAN as matching criteria.' ;
                  presence "Select inner-VLAN as match criteria" ;
                  leaf vlan-value {
                    description 'Configure inner-VLAN value in range mode, support single inner-VLAN value or range(max num:4;spacing mark:,) in <1-4094>. For example,"1,300-400,1000,2000-4000",etc.' ;
                    type qos-vlan-bitmap ;

                    mandatory true ;
                  }

                }

                container out-vlan {
                  description 'Select outer-VLAN as matching criteria.' ;
                  presence "Select outer-VLAN as match criteria" ;
                  leaf vlan-value {
                    description 'Configure outer-VLAN value in range mode, support single outer-VLAN value or range(max num:4;spacing mark:,) in <1-4094>. For example,"1,300-400,1000,2000-4000",etc.' ;
                    type qos-vlan-bitmap ;

                    mandatory true ;
                  }

                }

                container in-8021p {
                  description 'Select inner 802.1p as matching criteria.' ;
                  presence "Select inner 802.1p as match criteria" ;
                  leaf in-8021p-value {
                    description 'Configure inner 802.1p value in range mode, support single 802.1p value or range(max num:4;spacing mark:,) in <0-7>. For example,"0,2-4,7",etc.' ;
                    type qos-8021p-bitmap ;

                    mandatory true ;
                  }

                }

                container out-8021p {
                  description 'Select outer 802.1p as matching criteria.' ;
                  presence "Select outer 802.1p as match criteria" ;
                  leaf out-8021p-value {
                    description 'Configure outer 802.1p value in range mode, support single 802.1p value or range(max num:4;spacing mark:,) in <0-7>. For example,"0,2-4,7",etc.' ;
                    type qos-8021p-bitmap ;

                    mandatory true ;
                  }

                }

                container qos-group {
                  description 'Select qos-group as matching criteria.' ;
                  presence "Select qos-group as match criteria" ;
                  leaf qos-id {
                    description 'Set qos-group number, support <1-65535>.' ;
                    type uint16 {
                      range 1..65535 ;

                    }

                    mandatory true ;
                  }

                }

                container vrf-name {
                  description 'Select vrf-name as matching criteria.' ;
                  presence "Select vrf-name as match criteria" ;
                  leaf vrf-name {
                    description 'Set vrf name, support 1-32 characters.' ;
                    type string {
                      length 1..32 {
                        description 'Vrf name, support 1-32 characters' ;
                      }

                    }

                    mandatory true ;
                  }

                }

                container uni-cast {
                  description 'Select unicast as matching criteria.' ;
                  presence "Select unicast as match criteria" ;
                  leaf uni-cast {
                    description 'Set unicast.' ;
                    type empty ;

                    mandatory true ;
                  }

                }

                container multi-cast {
                  description 'Select multicast as matching criteria.' ;
                  presence "Select multicast as match criteria" ;
                  leaf multi-cast {
                    description 'Set multicast.' ;
                    type empty ;

                    mandatory true ;
                  }

                }

                container mac-addr {
                  description 'Select mac-address as matching criteria.' ;
                  presence "Select mac-address as match criteria" ;
                  leaf mac-address {
                    description 'Configure mac-address.' ;
                    type ncd:mac-address ;

                    mandatory true ;
                  }

                }

                container child {
                  description 'Set the mark of null class.' ;
                  presence "Set the mark of null class" ;
                  leaf child {
                    description 'Set the mark of null class.' ;
                    type empty ;

                    mandatory true ;
                  }

                }

                container ipv4-acls {
                  description 'Select IPv4 ACL name as matching criteria.' ;
                  list ipv4-acl {
                    description 'Set IPv4 ACL name as matching criteria.' ;
                    key acl-name ;
                    leaf acl-name {
                      description 'Set ipv4-access-list name, support 1-31 characters.' ;
                      type string {
                        length 1..31 {
                          description 'Name of ACL, support 1-31 characters' ;
                        }

                      }

                    }

                  }

                }

                container ipv6-acls {
                  description 'Select IPv6 ACL name as matching criteria.' ;
                  list ipv6-acl {
                    description 'Set IPv6 ACL name as matching criteria.' ;
                    key acl-name ;
                    leaf acl-name {
                      description 'Set ipv6-access-list name, support 1-31 characters.' ;
                      type string {
                        length 1..31 {
                          description 'Name of ACL, support 1-31 characters' ;
                        }

                      }

                    }

                  }

                }

                container link-acls {
                  if-feature class-match-link-acl ;

                  description 'Select link ACL name as matching criteria.' ;
                  list link-acl {
                    description 'Set link ACL name as matching criteria.' ;
                    key acl-name ;
                    leaf acl-name {
                      description 'Set link-access-list name, support 1-31 characters.' ;
                      type string {
                        length 1..31 {
                          description 'Name of ACL, support 1-31 characters' ;
                        }

                      }

                    }

                  }

                }

                container vpws {
                  description 'Select VPWS instance name as matching criteria.' ;
                  presence "Select VPWS instance name as match criteria" ;
                  leaf vpws-name {
