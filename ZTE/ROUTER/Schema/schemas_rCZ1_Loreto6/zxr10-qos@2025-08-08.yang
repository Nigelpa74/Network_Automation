                  list ipp-inner-ipv6-acl {
                    description 'Set IPv6 ACL name as matching criteria of IPP(ip-in-ip) inner layer.' ;
                    key acl-name ;
                    leaf acl-name {
                      description 'Set ipv6-access-list name, support 1-31 characters.' ;
                      type string {
                        length 1..31 {
                          description 'Name of ACL, support 1-31 characters.' ;
                        }

                      }

                    }

                  }

                  ncd:revise-date 2022-10-09 ;
                }

                container ipv4-rocev2 {
                  if-feature match-rocev2 ;

                  description 'Select IPv4 type RoCEv2 packets as matching criteria.' ;
                  choice opcode {
                    description 'Configure the message type of RoCEv2 that indicate the operation mode of it.' ;
                    case value {
                      description 'Configure the opcode value of RoCEv2.' ;
                      leaf opcode-value {
                        description 'Configure the opcode value of RoCEv2.' ;
                        type uint16 {
                          range 0..255 {
                            description 'The opcode value, support <0-255>.' ;
                          }

                        }

                      }

                    }

                    case cnp {
                      description 'Configure the RoCEv2 opcode as CNP.' ;
                      leaf cnp {
                        description 'Configure the RoCEv2 opcode as CNP.' ;
                        type empty ;

                      }

                      if-feature rocev2-cnp-feature ;

                      ncd:revise-date 2024-06-11 ;
                    }

                    case nak {
                      description 'Configure the RoCEv2 opcode as NAK.' ;
                      leaf nak {
                        description 'Configure the RoCEv2 opcode as NAK.' ;
                        type empty ;

                      }

                      if-feature rocev2-nak-feature ;

                      ncd:revise-date 2024-06-11 ;
                    }

                  }

                  leaf qpair-value {
                    description 'Configure the queue pair value of RoCEv2.' ;
                    type uint32 {
                      range 0..16777215 {
                        description 'The queue pair value, support <0-16777215>.' ;
                      }

                    }

                  }

                  container udf {
                    leaf udf-data {
                      type string {
                        length 10 {
                          description 'udf data, supports exactly 10 characters.' ;
                        }

                      }

                      description 'Set user defined hexadecimal string data,as follows:
0x00000000-0xffffffff.' ;
                      mandatory true ;
                    }

                    leaf udf-mask {
                      type string {
                        length 10 {
                          description 'udf mask, supports exactly 10 characters.' ;
                        }

                      }

                      description 'Set user defined hexadecimal string wildcard mask,as follows:
0x00000000-0xffffffff.' ;
                      mandatory true ;
                    }

                    leaf offset-value {
                      type uint8 {
                        range 8..20 {
                          description 'udf offset value, support 8-20.' ;
                        }

                      }

                      description 'Set user defined offset value.' ;
                      mandatory true ;
                    }

                    if-feature class-match-rocev2-udf ;

                    description 'Configure user defined base l4-head value.' ;
                    presence udf ;
                    ncd:revise-date 2025-02-11 ;
                  }

                  ncd:revise-date 2022-12-05 ;
                }

                container ipv6-rocev2 {
