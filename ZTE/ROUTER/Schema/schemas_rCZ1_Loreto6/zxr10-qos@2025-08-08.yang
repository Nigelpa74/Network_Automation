        container precedences {
          description 'Match IP precedence.' ;
          list precedence {
            description 'Configure interface rate limit based on matching precedence.' ;
            key 'if-name if-direct ip-protocol prec-value' ;
            leaf if-name {
              description 'Configure the name of the attaching interface.' ;
              type ncd:ifname {
                length 1..31 {
                  description 'Name of the attaching interface, support 1-31 characters' ;
                }

              }

            }

            leaf if-direct {
              description 'Specify the direction of interface.' ;
              type enumeration {
                enum input {
                  value 1 ;
                  description 'Rate limit on input' ;
                }

                enum output {
                  value 2 ;
                  description 'Rate limit on output' ;
                }

              }

            }

            leaf ip-protocol {
              description 'Rate limit based on protocol.' ;
              type enumeration {
                enum any {
                  value 1 ;
                  description 'Rate limit based on any protocol' ;
                }

                enum ipv4 {
                  value 2 ;
                  description 'Rate limit based on IPv4' ;
                }

                enum ipv6 {
                  value 3 ;
                  description 'Rate limit based on IPv6' ;
                }

              }

            }

            leaf prec-value {
              description 'IP precedence value, support <0-7>.' ;
              type uint32 {
                range 0..7 {
                  description 'IP precedence value, support <0-7>' ;
                }

