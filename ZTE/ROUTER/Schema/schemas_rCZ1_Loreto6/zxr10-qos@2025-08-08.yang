              presence "Configure coupling flag information" ;
              leaf cf-value {
                description 'Configure coupling-flag value.' ;
                type uint8 {
                  range 0..1 ;

                }

              }

              if-feature qos-car-cf ;

              ncd:revise-date 2023-09-12 ;
            }

            container adjust {
              description 'Configure QoS accuracy adjustment values.' ;
              presence "Configure adjust information" ;
              leaf adjust-value {
                description 'Configure QoS accuracy adjustment values.' ;
