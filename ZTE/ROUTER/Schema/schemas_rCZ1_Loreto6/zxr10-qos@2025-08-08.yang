                    }

                  }

                }

                case va-8021p {
                  description 'Rewrite packet 802.1p and transmit the packet.' ;
                  container set-8021p-transmit {
                    description 'Rewrite packet 802.1p and transmit it.' ;
                    leaf value-8021p {
                      description 'Reset 802.1p, support <0-7>.' ;
