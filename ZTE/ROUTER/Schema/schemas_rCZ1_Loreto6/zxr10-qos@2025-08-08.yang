                      length 1..31 {
                        description 'Name of the class map, support 1-31 characters' ;
                      }

                    }

                  }

                  container police {
                    description 'Configure traffic policing.' ;
                    presence "Configure traffic policing" ;
                    container c-bucket {
                      description 'Configure C-bucket related parameters.' ;
                      container cir-value {
                        description 'Configure the CIR.' ;
                        leaf cir {
                          description 'Configure the CIR (Committed Information Rate) value, unit: packets per second.' ;
                          type uint32 {
                            range 1..4294967295 {
                              description 'The CIR value (Unit: packets per second)' ;
                            }

                          }

                          mandatory true ;
                        }

                      }

                    }

                  }

                  container drop {
                    description 'Configure drop.' ;
                    presence "Configure drop" ;
                    leaf drop {
                      description 'Specify drop.' ;
                      type empty ;

                      mandatory true ;
                    }

                  }

                  container priority-level {
                    description 'Configure PQ(Priority Queuing) priority level.' ;
                    presence "Configure PQ priority level" ;
                    leaf priority-value {
                      description 'Set the priority level of PQ.' ;
                      type uint16 {
                        range 1..65535 {
                          description 'The priority level of PQ' ;
                        }

                      }

                      mandatory true ;
                    }

                  }

                }

                container class-default {
                  description 'Select policy association default class.' ;
                  presence "Specify the default class" ;
                  leaf class-default {
                    description 'Specify the default class.' ;
                    type empty ;

                    mandatory true ;
                  }

                  container police {
                    description 'Configure traffic policing.' ;
                    presence "Configure traffic policing" ;
                    container c-bucket {
                      description 'Configure C-bucket related parameters.' ;
                      container cir-value {
                        description 'Configure the CIR.' ;
                        leaf cir {
                          description 'Configure the CIR (Committed Information Rate) value, unit: packets per second.' ;
                          type uint32 {
                            range 1..4294967295 {
                              description 'The CIR value (Unit: packets per second)' ;
                            }

                          }

                          mandatory true ;
                        }

                      }

                    }

                  }

                  container drop {
                    description 'Configure drop.' ;
                    presence "Configure drop" ;
                    leaf drop {
                      description 'Specify drop.' ;
                      type empty ;

                      mandatory true ;
                    }

                  }

                  container priority-level {
                    description 'Configure PQ(Priority Queuing) priority level.' ;
                    presence "Configure PQ priority level" ;
                    leaf priority-value {
                      description 'Set the priority level of PQ.' ;
                      type uint16 {
                        range 1..65535 {
                          description 'The priority level of PQ' ;
                        }

                      }

                      mandatory true ;
                    }

                  }

                }

              }

              container pmap-description {
                description 'Description of a policy map, support 1-79 characters.' ;
                presence "Specify description of policy map" ;
                leaf pmap-description {
                  description 'Description of a policy map, support 1-79 characters.' ;
                  type ncd:string-with-blank {
                    length 1..79 {
                      description 'Description of a policy map, support 1-79 characters.' ;
                    }

                  }

                  mandatory true ;
                }

              }

