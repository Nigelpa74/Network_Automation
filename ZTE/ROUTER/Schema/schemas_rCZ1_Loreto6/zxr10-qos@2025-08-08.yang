        container drop-ratio-threshold {
          if-feature qos-queue-alarm ;

          description 'Set drop ratio threshold.' ;
          presence "Drop ratio threshold" ;
          choice drop-ratio-threshold {
            description 'Set drop ratio threshold.' ;
            mandatory true ;
            case drop-ratio-threshold {
              description 'Set drop ratio threshold.' ;
              leaf upper-threshold-percentage {
                description 'Set drop ratio upper threshold percentage(<0.00-100.00>).' ;
                type decimal64 {
                  fraction-digits 2 ;
