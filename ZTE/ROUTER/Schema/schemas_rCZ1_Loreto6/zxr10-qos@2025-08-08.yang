                  list ipp-inner-ipv4-acl {
                    description 'Set IPv4 ACL name as matching criteria of IPP(ip-in-ip) inner layer.' ;
                    key acl-name ;
                    leaf acl-name {
                      description 'Set ipv4-access-list name, support 1-31 characters.' ;
