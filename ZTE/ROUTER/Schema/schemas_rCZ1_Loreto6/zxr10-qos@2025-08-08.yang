                                  description 'Select precedence as source inherit' ;
                                }

                                enum mpls-exp {
                                  value 2 ;
                                  description 'Select MPLS-EXP as source inherit' ;
                                }

                                enum 8021p {
                                  value 3 ;
                                  description 'Select 802.1p as source inherit' ;
                                }

                                enum dscp {
                                  value 4 ;
                                  description 'Select dscp as source inherit' ;
                                }

                              }

                              mandatory true ;
                            }

                            leaf inner-outer {
                              description 'Set 8021p inner or outer flag.If vlaue is 0, it means outer flag. If value is 1,it means inner and outer flag.' ;
                              type uint8 {
                                range 0..1 {
                                  description 'Inner or outer flag. 0 is outer. 1 is inner and outer' ;
                                }

                              }

                              default 0 ;
                            }

                          }

