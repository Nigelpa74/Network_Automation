                      }

                    }

                    leaf probility {
                      description 'Set mark probability denominator, support <1-100>.' ;
                      type uint32 {
                        range 1..100 {
                          description 'Set mark probability denominator' ;
                        }

                      }

                      mandatory true ;
                    }

                  }

                  container red {
                    description 'Red packets.' ;
                    presence "Red packets" ;
                    choice threshold {
                      description 'Set the threshold.' ;
                      mandatory true ;
                      case threshold-value {
                        description 'Set the threshold value.' ;
                        leaf min-threshold {
                          description 'Set the minimum threshold.' ;
                          type uint32 {
                            range 1..4294967295 {
                              description 'Set the minimum threshold in kilobytes' ;
                            }

                          }

                          units KB ;
                          mandatory true ;
                        }

                        leaf max-threshold {
                          description 'Set the maximum threshold.' ;
                          type uint32 {
                            range 1..4294967295 {
                              description 'Set the maximum threshold in kilobytes' ;
                            }

                          }

                          units KB ;
                          mandatory true ;
                        }

