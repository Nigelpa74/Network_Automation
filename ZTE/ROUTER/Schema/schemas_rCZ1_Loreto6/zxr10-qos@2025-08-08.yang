      container qos-ds-domains {
        if-feature qos-ds-domains ;

        description 'Configure the used diffserv domain template.' ;
        list qos-ds-domain {
          description 'Configure interface binding DS domain.' ;
          key if-name ;
          leaf if-name {
            description 'Specify the name of interface binding DS domain, support 1-31 characters.' ;
            type ncd:ifname {
              length 1..31 {
                description 'Name of the interface, support 1-31 characters' ;
              }

            }

          }

          leaf ds-domain-name {
            description 'Name of the diffserv domain, support 1-31 characters.' ;
            type string {
              length 1..31 {
                description 'Name of the diffserv domain, support 1-31 characters' ;
              }

            }

            mandatory true ;
          }

          leaf bound-type {
            description 'Specify the bind mode.' ;
            type enumeration {
              enum overwrite {
                value 2 ;
                description 'Set DS-domain bound on link-ports with overwrite' ;
              }

            }

            ncd:revise-date 2018-09-19 ;
          }

        }

      }

      container qos-prioritys {
        if-feature qos-prioritys ;

        description 'Configure the type of priority trusted by QoS.' ;
        list qos-priority {
          description 'Configure the type of priority trusted by QoS.' ;
          key if-name ;
          leaf if-name {
            description 'Specify the name of interface applied, support 1-31 characters.' ;
            type ncd:ifname {
              length 1..31 {
                description 'Name of the interface, support 1-31 characters' ;
              }

            }

          }

          leaf priority-type {
            description 'Set the priority type trusted by interface.' ;
            type enumeration {
              enum 8021p {
                value 1 ;
                description 'Based on 802.1p' ;
              }

              enum ip-dscp {
                value 2 ;
                description 'Based on IP DSCP' ;
              }

              enum mpls-exp {
                value 3 ;
                description 'Based on MPLS-EXP' ;
              }

            }

            mandatory true ;
          }

        }

      }

      container qos-schedule {
        if-feature qos-schedule ;

        description 'Set scheduling policy for a certain transmitting entity.' ;
        container interfaces {
          description 'Set scheduling policy for a certain interface.' ;
          list interface {
            description 'Set scheduling policy for a certain interface.' ;
            key if-name ;
            leaf if-name {
              description 'Name of the attaching tunnel.' ;
              type ncd:ifname {
                length 1..31 {
                  description 'Name of the attaching tunnel' ;
                }

              }

            }

            choice schedule {
              description 'Configure schedule policy.' ;
              mandatory true ;
              case sche-group {
                description 'Configure schedule based on the combination of schedule policy.' ;
                container queue-schedule {
                  description 'Configure queue schedule.' ;
                  presence "Configure queue schedule" ;
                  choice queue-schedule {
                    description 'Select the type of queue schedule.' ;
                    mandatory true ;
                    case pq {
                      description 'Set PQ(Priority Queuing) scheduling between transmitting entities.' ;
                      leaf priority-level {
                        description 'Set the priority level of PQ, support <1-4>.' ;
                        type uint8 {
                          range 1..4 {
                            description 'The priority level of PQ, support<1-4>' ;
                          }

                        }

                      }

                    }

                    case wfq {
                      description 'Set WFQ(Weighted Fair Queuing) scheduling between transmitting entities.' ;
                      leaf wfq-weight {
                        description 'Set the weight of WFQ, support <1-100>.' ;
                        type uint8 {
                          range 1..100 {
                            description 'The weight of WFQ, support <1-100>' ;
                          }

                        }

                      }

                    }

                  }

                }

                leaf pmap-name {
                  description 'Name of scheduling policy based on PHB, support 1-31 characters.' ;
                  type string {
                    length 1..31 {
                      description 'Name of the policy map, support 1-31 characters' ;
                    }

                  }

                }

              }

            }

          }

        }

        container pws {
          description 'Set scheduling policy for a certain PW.' ;
          list pw {
            description 'Set scheduling policy for a certain PW.' ;
            key pw-name ;
            leaf pw-name {
              description 'Name of the PW, support 1-31 characters.' ;
              type string {
                length 1..31 {
                  description 'The name of PW, support 1-31 characters' ;
                }

              }

            }

            choice schedule {
              description 'Configure schedule policy.' ;
              mandatory true ;
              case sche-group {
                description 'Configure schedule based on the combination of schedule policy.' ;
                container queue-schedule {
                  description 'Configure queue schedule.' ;
                  presence "Configure queue schedule" ;
                  choice queue-schedule {
                    description 'Select the type of queue schedule.' ;
                    mandatory true ;
                    case pq {
                      description 'Set PQ(Priority Queuing) scheduling between transmitting entities.' ;
                      leaf priority-level {
                        description 'Set the priority level of PQ, support <1-4>.' ;
                        type uint8 {
                          range 1..4 {
                            description 'The priority level of PQ, support<1-4>' ;
                          }

                        }

                      }

                    }

                    case wfq {
                      description 'Set WFQ(Weighted Fair Queuing) scheduling between transmitting entities.' ;
                      leaf wfq-weight {
                        description 'Set the weight of WFQ, support <1-100>.' ;
                        type uint8 {
                          range 1..100 {
                            description 'The weight of WFQ, support <1-100>' ;
                          }

                        }

                      }

                    }

                  }

                }

                leaf pmap-name {
                  description 'Name of scheduling policy based on PHB, support 1-31 characters.' ;
                  type string {
                    length 1..31 {
                      description 'Name of the policy map, support 1-31 characters' ;
                    }

                  }

                }

                leaf statistical-share {
                  description 'Set statistical share.' ;
                  type boolean ;

                  default false ;
                  ncd:revise-date 2021-03-04 ;
                }

              }

            }

          }

        }

        container pw-ins {
          description 'Set ingress scheduling policy for a certain PW.' ;
          list pw-in {
            description 'Set ingress scheduling policy for a certain PW.' ;
            key pw-name ;
            leaf pw-name {
              description 'Name of the PW, support 1-31 characters.' ;
              type string {
                length 1..31 {
                  description 'The name of PW, support 1-31 characters' ;
                }

              }

            }

            choice schedule {
              description 'Configure schedule policy.' ;
              mandatory true ;
              case sche-group {
                description 'Configure schedule based on the combination of schedule policy.' ;
                container queue-schedule {
                  description 'Configure queue schedule.' ;
                  presence "Configure queue schedule" ;
                  choice queue-schedule {
                    description 'Select the type of queue schedule.' ;
                    mandatory true ;
                    case pq {
                      description 'Set PQ(Priority Queuing) scheduling between transmitting entities.' ;
                      leaf priority-level {
                        description 'Set the priority level of PQ, support <1-4>.' ;
                        type uint8 {
                          range 1..4 {
                            description 'The priority level of PQ, support<1-4>' ;
                          }

                        }

                      }

                    }

                    case wfq {
                      description 'Set WFQ(Weighted Fair Queuing) scheduling between transmitting entities.' ;
                      leaf wfq-weight {
                        description 'Set the weight of WFQ, support <1-100>.' ;
                        type uint8 {
                          range 1..100 {
                            description 'The weight of WFQ, support <1-100>' ;
                          }

                        }

                      }

                    }

                  }

                }

                leaf pmap-name {
                  description 'Name of scheduling policy based on PHB, support 1-31 characters.' ;
                  type string {
                    length 1..31 {
                      description 'Name of the policy map, support 1-31 characters' ;
                    }

                  }

                }

                leaf statistical-share {
                  description 'Set statistical share.' ;
                  type boolean ;

                  default false ;
                  ncd:revise-date 2021-03-04 ;
                }

              }

