                      choice method {
                        description 'Specify the method to set DSCP.' ;
                        mandatory true ;
                        case set-value {
                          description 'Set the DSCP value directly.' ;
                          container set-value {
                            description 'Set the DSCP value directly.' ;
                            leaf dscp-value {
                              description 'DSCP value, support <0-63>.' ;
                              type uint16 {
                                range 0..63 {
                                  description 'DSCP value, support <0-63>' ;
                                }

                              }

                              mandatory true ;
                            }

                          }

                        }

                        case inherit {
                          status obsolete {
