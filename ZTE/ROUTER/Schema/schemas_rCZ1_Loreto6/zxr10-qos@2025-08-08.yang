      container wred-templates {
        if-feature wred-template ;

        description 'Configure the WRED(Weighted Random Early Detection) template.' ;
        list wred-template {
          description 'Configure the WRED(Weighted Random Early Detection) template.' ;
          key wred-template-name ;
          leaf wred-template-name {
            description 'Name of the WRED(Weighted Random Early Detection) template (1-31 characters).' ;
            type string {
              length 1..31 {
                description 'Name of the WRED template (1-31 characters)' ;
              }

            }

          }

          container wred-actions {
            description 'Configure WRED(Weighted Random Early Detection) action information.' ;
            container colors {
              description 'Configure WRED(Weighted Random Early Detection) thresholds based on color.' ;
              list color {
                description 'Configure WRED(Weighted Random Early Detection) thresholds based on color.' ;
                key color-type ;
                leaf color-type {
                  description 'Set WRED color.' ;
                  type qos-color-type ;

                }

                choice threshold {
                  description 'Set the threshold.' ;
                  case threshold-value {
                    description 'Set the threshold value.' ;
                    leaf min-threshold {
                      description 'Set the minimum threshold in kilobytes, support <1-1024000>.' ;
                      type uint32 {
                        range 1..1024000 {
                          description 'The minimum threshold in kilobytes, support <1-1024000>' ;
                        }

                      }

                      units KB ;
                      mandatory true ;
                    }

                    leaf max-threshold {
                      description 'Set the maximum threshold in kilobytes, support <1-1024000>.' ;
                      type uint32 {
                        range 1..1024000 {
                          description 'The maximum threshold in kilobytes, support <1-1024000>' ;
                        }

                      }

                      units KB ;
                      mandatory true ;
                    }

                  }

                  case threshold-percentage {
                    description 'Set the threshold percentage.' ;
                    container threshold-percentage {
                      description 'Set the threshold percentage.' ;
                      leaf min-threshold-percentage {
                        description 'Set the minimum threshold percentage, support <1-100>.' ;
                        type uint32 {
                          range 1..100 {
                            description 'The minimum threshold percentage, support <1-100>' ;
                          }

                        }

                        mandatory true ;
                      }

                      leaf max-threshold-percentage {
                        description 'Set the maximum threshold percentage, support <1-100>.' ;
                        type uint32 {
                          range 1..100 {
                            description 'The maximum threshold percentage, support <1-100>' ;
                          }

                        }

                        mandatory true ;
                      }

                    }

                  }

                }

                leaf probability {
                  description 'Set mark probability denominator, support <1-100>.' ;
                  type uint8 {
                    range 1..100 {
                      description 'Set mark probability denominator, support <1-100>' ;
                    }

                  }

                  mandatory true ;
                }

              }

            }

            container precedences {
              description 'Configure WRED(Weighted Random Early Detection) thresholds based on precedence.' ;
              list precedence {
                description 'Configure WRED(Weighted Random Early Detection) thresholds based on precedence.' ;
                key prec-value ;
                leaf prec-value {
                  description 'Set the precedence value, such as MPLS EXP, VLAN 802.1p, IP DSCP, IP Precedence, support <0-7>.' ;
                  type uint16 {
                    range 0..7 {
                      description 'The IP-Precedence value, support <0-7>' ;
                    }

                  }

                }

                choice threshold {
                  description 'Set the threshold.' ;
                  case threshold-value {
                    description 'Set the threshold value.' ;
                    leaf min-threshold {
                      description 'Set the minimum threshold (default: kilobytes).' ;
                      type uint32 {
                        range 1..4294967295 {
                          description 'The minimum threshold (default: kilobytes), support <1-4294967295>' ;
                        }

                      }

                      mandatory true ;
                    }

                    leaf min-threshold-unit {
                      description 'Set min-threshold unit, such as kbytes, mbytes, gbytes.' ;
                      type qos-threshold-unit-type ;

                    }

                    leaf max-threshold {
                      description 'Set the maximum threshold (default: kilobytes).' ;
                      type uint32 {
                        range 1..4294967295 {
                          description 'The maximum threshold (default: kilobytes), support <1-4294967295>.' ;
                        }

                      }

                      mandatory true ;
                    }

                    leaf max-threshold-unit {
                      description 'Set max-threshold unit, such as kbytes, mbytes, gbytes.' ;
                      type qos-threshold-unit-type ;

                    }

                  }

                  case threshold-percentage {
                    description 'Set the threshold percentage.' ;
                    container threshold-percentage {
                      description 'Set the threshold percentage.' ;
                      leaf min-threshold-percentage {
                        description 'Set the minimum threshold percentage, support <1-100>.' ;
                        type uint32 {
                          range 1..100 {
                            description 'The minimum threshold percentage, support <1-100>' ;
                          }

                        }

                        mandatory true ;
                      }

                      leaf max-threshold-percentage {
                        description 'Set the maximum threshold percentage, support <1-100>.' ;
                        type uint32 {
                          range 1..100 {
                            description 'The maximum threshold percentage, support <1-100>' ;
                          }

                        }

                        mandatory true ;
                      }

                    }

                  }

                  case threshold-cachetime {
                    description 'Set the threshold cachetime.' ;
                    container threshold-cachetime {
                      description 'Set the threshold cachetime.' ;
                      leaf min-threshold-cachetime {
                        description 'Set the minimum threshold cachetime (default: ms).' ;
                        type uint32 {
                          range 1..1000 {
                            description 'The minimum threshold cachetime, support <1-1000>' ;
                          }

                        }

                        mandatory true ;
                      }

                      leaf max-threshold-cachetime {
                        description 'Set the maximum threshold cachetime (default: ms).' ;
                        type uint32 {
                          range 1..1000 {
                            description 'The maximum threshold cachetime, support <1-1000>' ;
                          }

                        }

                        mandatory true ;
                      }

                    }

                  }

                }

                leaf probability {
                  description 'Set mark probability denominator, support <1-100>.' ;
                  type uint32 {
                    range 1..100 {
                      description 'Set mark probability denominator, support <1-100>' ;
                    }

                  }

                  mandatory true ;
                }

              }

            }

            container weight {
              description 'Configure WRED(Weighted Random Early Detection) exponential weight factor.' ;
              presence "Configure WRED exponential weight factor" ;
              leaf weight-value {
                description 'Specify exponent used in weighted average calculation, support <1-16>.' ;
                type uint8 {
