          }

        }

        container unknown-unicasts {
          description 'Match unknown unicast.' ;
          list unknown-unicast {
            description 'Configure interface rate limit based on matching unknown unicast.' ;
            key 'if-name if-direct' ;
            leaf if-name {
              description 'Configure the name of the attaching interface.' ;
              type ncd:ifname {
                length 1..31 {
                  description 'Name of the attaching interface, support 1-31 characters' ;
                }

              }

            }

            leaf if-direct {
              description 'Specify the direction of interface.' ;
              type enumeration {
                enum input {
                  value 1 ;
                  description 'Rate limit on input' ;
                }

                enum output {
                  value 2 ;
                  description 'Rate limit on output' ;
                }

              }

            }

            leaf rate-limit-desc {
              description 'Description of rate limit, support 1-79 characters.' ;
              type ncd:string-with-blank {
                length 1..79 {
                  description 'Description of rate limit, support 1-79 characters.' ;
                }

              }

              ncd:revise-date 2020-06-18 ;
            }

            choice unit-style {
              description "Specify unit's style." ;
              mandatory true ;
              case unit-value {
                description 'Configure the value style.' ;
                leaf cir {
                  description 'Configure the CIR(Committed Information Rate) value (default: kilobits per second).' ;
                  type uint32 {
                    range 0..4294967295 {
                      description 'The CIR value (default: kilobits per second).' ;
                    }

                  }

                  mandatory true ;
                }

                leaf cir-unit {
                  description 'Set cir unit, such as kbps, mbps, gbps.' ;
                  type qos-rate-unit-type ;

                }

                leaf cbs {
                  description 'Configure the CBS(Committed Burst Size) size in bytes.' ;
                  type uint32 {
                    range 0..4294967294 {
                      description 'The CBS(Committed Burst Size) size in bytes.' ;
                    }

                  }

                  units byte ;
                }

                leaf pir {
                  description 'Configure the PIR(Peak Information Rate) value (default: kilobits per second).' ;
                  type uint32 {
                    range 0..4294967295 {
                      description 'The PIR(Peak Information Rate) value (default: kilobits per second).' ;
                    }

                  }

                  mandatory true ;
                }

                leaf pir-unit {
                  description 'Set pir unit, such as kbps, mbps, gbps.' ;
                  type qos-rate-unit-type ;

                }

                leaf pbs {
                  description 'Configure the PBS(Peak Burst Size) size in bytes.' ;
                  type uint32 {
                    range 0..4294967294 {
                      description 'The PBS(Peak Burst Size) size in KB.' ;
                    }

                  }

                  units byte ;
                }

              }

              case unit-percentage {
                description 'Configure the percentage style.' ;
                leaf cir-percentage {
                  description 'Configure the CIR(Committed Information Rate) percentage (Set the accuracy rate per hundred (1%)).' ;
                  type uint32 {
                    range 1..100 {
                      description 'The CIR percentage, support <1-100>' ;
                    }

                  }

                  mandatory true ;
                }

                leaf pir-percentage {
                  description 'Configure the PIR(Peak Information Rate) percentage (Set the accuracy rate per hundred (1%)).' ;
                  type uint32 {
                    range 1..100 {
                      description 'The PIR percentage, support <1-100>' ;
                    }

                  }

                  mandatory true ;
                }

                ncd:revise-date 2020-12-23 ;
              }

            }

            choice buket-value-percent {
              if-feature car-buket-value-percent ;

              description 'Configure CIR, CBS, PIR and PBS.' ;
              mandatory true ;
              case buket-value {
                description 'Configure CIR, CBS, PIR and PBS in numerical form.' ;
                container c-buket {
                  description 'Configure C-buket related parameters.' ;
                  container cir-value {
                    description 'Configure the CIR(Committed Information Rate).' ;
                    leaf cir {
                      description 'Configure the CIR(Committed Information Rate) value (default: kilobits per second).' ;
                      type uint32 {
                        range "0|8..4294967295" {
                          description 'The CIR value (default: kilobits per second).' ;
                        }

                      }

                      mandatory true ;
                    }

                    leaf cir-unit {
                      description 'Set cir unit, such as kbps, mbps, gbps, pps.' ;
                      type qos-rate-unit-type-ex ;

                    }

                  }

                  container cbs-value {
                    description 'Configure the CBS(Committed Burst Size).' ;
                    presence cbs ;
                    leaf cbs {
                      description 'Configure the CBS(Committed Burst Size) value in bytes.' ;
                      type uint32 {
                        range 1..4294967295 {
                          description 'The CBS(Committed Burst Size) size in bytes, support <1-4294967295>' ;
                        }

                      }

                      units byte ;
                      mandatory true ;
                    }

                  }

                }

                container p-buket {
                  description 'Configure P-buket related parameters.' ;
                  presence p-buket ;
                  container pir-value {
                    description 'Configure the PIR(Peak Information Rate).' ;
                    leaf pir {
                      description 'Configure the PIR(Peak Information Rate) value (default: kilobits per second).' ;
                      type uint32 {
                        range 8..4294967295 {
                          description 'The PIR(Peak Information Rate) value (default: kilobits per second), support <8-4294967295>' ;
                        }

                      }

                      mandatory true ;
                    }

                    leaf pir-unit {
                      description 'Set pir unit, such as kbps, mbps, gbps, pps.' ;
                      type qos-rate-unit-type-ex ;

                    }

                  }

                  container pbs-value {
                    description 'Configure the PBS(Peak Burst Size).' ;
                    presence pbs ;
                    leaf pbs {
                      description 'Configure the PBS(Peak Burst Size) value in bytes.' ;
                      type uint32 {
                        range 1..4294967295 {
                          description 'The PBS(Peak Burst Size) size in bytes, support <1-4294967295>' ;
                        }

                      }

                      units byte ;
                      mandatory true ;
                    }

                  }

                }

              }

              case buket-percent {
                description 'Configure CIR and PIR in percentage.' ;
                container cir-percent {
                  description 'Configure CIR in percentage.' ;
                  leaf cir-percent {
                    description 'Configure CIR in percentage.' ;
                    type uint32 {
                      range 1..100 ;

                    }

                    mandatory true ;
                  }

                }

                container pir-percent {
                  description 'Configure PIR in percentage.' ;
                  presence pir ;
                  leaf pir-percent {
                    description 'Configure PIR in percentage.' ;
                    type uint32 {
                      range 1..100 ;

                    }

                    mandatory true ;
                  }

                }

              }

              ncd:revise-date 2021-01-25 ;
            }

