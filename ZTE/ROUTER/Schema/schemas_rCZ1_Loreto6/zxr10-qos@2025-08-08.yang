                presence "Configure shape" ;
                choice shape {
                  description 'Configure shape.' ;
                  mandatory true ;
                  case cir-cbs {
                    description 'Configure CIR CBS PIR and PBS.' ;
                    leaf cir {
                      description 'Configure the CIR (Committed Information Rate) value, default: kilobits per second.' ;
                      type uint32 {
                        range 8..4294967295 {
                          description 'The CIR value (default: kilobits per second),support <8-4294967295>.' ;
                        }

                      }

                      mandatory true ;
                    }

                    leaf cbs {
                      description 'Configure the CBS(Committed Burst Size) size, default: KB.' ;
