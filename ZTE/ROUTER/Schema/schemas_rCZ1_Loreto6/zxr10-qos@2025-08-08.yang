                      value 3 ;
                      description 'Set queue depth to 64KB' ;
                    }

                    enum 128 {
                      value 14 ;
                      description 'Set queue depth to 128KB' ;
                    }

                    enum 512 {
                      value 4 ;
                      description 'Set queue depth to 512KB' ;
                    }

                    enum 1000 {
                      value 15 ;
                      description 'Set queue depth to 1000KB' ;
                    }

                    enum 4000 {
                      value 16 ;
                      description 'Set queue depth to 4000KB' ;
                    }

                    enum 8000 {
                      value 6 ;
                      description 'Set queue depth to 8000KB' ;
                    }

                    enum 24000 {
                      value 9 ;
                      description 'Set queue depth to 24000KB' ;
                    }

                    enum 64000 {
                      value 10 ;
                      description 'Set queue depth to 64000KB' ;
                    }

                    enum 96000 {
                      value 17 ;
                      description 'Set queue depth to 96000KB' ;
                    }

                    enum 192000 {
                      value 18 ;
                      description 'Set queue depth to 192000KB' ;
                    }

                    enum 1000000 {
                      value 13 ;
                      description 'Set queue depth to 1000000KB' ;
                    }

                    enum 128000 {
                      value 11 ;
                      description 'Set queue depth to 128000KB' ;
                    }

                    enum 16 {
                      value 1 ;
                      description 'Set queue depth to 16KB' ;
                    }

                    enum 16000 {
                      value 8 ;
                      description 'Set queue depth to 16000KB' ;
                    }

                    enum 2000 {
                      value 5 ;
                      description 'Set queue depth to 2000KB' ;
                    }

                    enum 24 {
                      value 2 ;
                      description 'Set queue depth to 24KB' ;
                    }

                    enum 512000 {
                      value 12 ;
                      description 'Set queue depth to 512000KB' ;
                    }

                    enum 7 {
                      value 7 ;
                      description 'Set queue depth to 7KB' ;
                    }

                    enum 8000000 {
                      value 21 ;
                      description 'Set queue depth to 8000000KB' ;
                    }

                    enum 600000 {
                      value 22 ;
                      description 'Set queue depth to 600000KB' ;
                    }

                    enum 660000 {
                      value 23 ;
                      description 'Set queue depth to 660000KB' ;
                    }

                    enum 680000 {
                      value 24 ;
                      description 'Set queue depth to 680000KB' ;
                    }

                    enum 3000000 {
                      value 25 ;
                      description 'Set queue depth to 3000000KB' ;
                    }

                    enum 4000000 {
                      value 26 ;
                      description 'Set queue depth to 4000000KB' ;
                    }

                    enum 5000000 {
                      value 27 ;
                      description 'Set queue depth to 5000000KB' ;
                    }

