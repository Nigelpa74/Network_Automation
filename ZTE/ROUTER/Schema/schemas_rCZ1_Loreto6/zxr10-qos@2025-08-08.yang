      container diffserv {
        if-feature diffserv ;

        description 'Differentiated Services.' ;
        container ds-domains {
          description 'Configure the template of diffserv domain.' ;
          list ds-domain {
            description 'Configure the template of diffserv domain, the max number of template is 8.' ;
            key domain-name ;
            leaf domain-name {
              description 'Name of the diffserv domain, support 1-31 characters.' ;
              type string {
                length 1..31 {
                  description 'Name of the diffserv domain, support 1-31 characters' ;
                }

              }

            }

            container map {
              description 'Configure the mapping between some protocol and PHB.' ;
              container pri-8021ps {
                status obsolete {
                  ncd:revise-date 2016-12-20 ;
                }

                description 'Configure the mapping based on 802.1p.' ;
                list pri-8021p {
                  status obsolete {
                    ncd:revise-date 2016-12-20 ;
                  }

                  description 'Map 802.1p to PHB, PHB include server class and color.' ;
                  key value-8021p ;
                  leaf value-8021p {
                    status obsolete {
                      ncd:revise-date 2016-12-20 ;
                    }

                    description '802.1p value, support <0-7>.' ;
                    type uint32 {
                      range 0..7 {
                        description '802.1p value, support <0-7>' ;
                      }

                    }

                  }

                  leaf server-class {
                    status obsolete {
                      ncd:revise-date 2016-12-20 ;
                    }

                    description 'Specify server class of PHB info, support <af1,af2,af3,af4,be,cs6,cs7,ef>.' ;
                    type qos-service-class ;

                    mandatory true ;
                  }

                  leaf color-type {
                    status obsolete {
                      ncd:revise-date 2016-12-20 ;
                    }

                    description 'Specify packets color, support <green,yellow,red>.' ;
                    type qos-color-type ;

                    mandatory true ;
                  }

                }

              }

              container pri-8021p-singles {
                description 'Configure the mapping based on 802.1p.' ;
                list pri-8021p-single {
                  description 'Map 802.1p to PHB.' ;
                  key value-8021p ;
                  leaf value-8021p {
                    description '802.1p value, support <0-7>.' ;
                    type uint32 {
                      range 0..7 {
                        description '802.1p value, support <0-7>' ;
                      }

                    }

                  }

                  leaf server-class {
                    description 'Specify server class of PHB info, support <af1,af2,af3,af4,be,cs6,cs7,ef>.' ;
                    type qos-service-class ;

                    mandatory true ;
                  }

                  leaf color-type {
                    description 'Specify packets color, support <green,yellow,red>.' ;
                    type qos-color-type ;

                    mandatory true ;
                  }

                }

                ncd:revise-date 2016-12-20 ;
              }

              container pri-8021p-ranges {
                description 'Configure the mapping based on 802.1p.' ;
                list pri-8021p-range {
                  description 'Map 802.1p to PHB, PHB include server class and color.' ;
                  key value-8021p ;
