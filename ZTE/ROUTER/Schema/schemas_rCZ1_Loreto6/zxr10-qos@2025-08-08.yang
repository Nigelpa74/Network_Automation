                    description 'Set IPv4 ACL name as matching criteria.' ;
                    key acl-name ;
                    leaf acl-name {
                      description 'Set ipv4-access-list name, support 1-31 characters.' ;
                      type string {
                        length 1..31 {
                          description 'Name of ACL, support 1-31 characters' ;
                        }

                      }

                    }

                  }

