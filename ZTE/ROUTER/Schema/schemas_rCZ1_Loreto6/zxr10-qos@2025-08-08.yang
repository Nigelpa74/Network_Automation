module zxr10-qos {
  namespace "http://www.zte.com.cn/zxr10/netconf/schema/rosng/qos" ;
  prefix qos ;
  yang-version 1 ;
  import zxr10-netconf-defs {
    prefix ncd ;
  }

  import zxr10-cps {
    prefix cps ;
  }

  organization "ZTE Corporation" ;
  contact "ZTE Corporation
  Nanjing Institute of ZTE Corporation
  No.68 Zijinghua Rd. Yuhuatai District, Nanjing, China
  Tel: +86-25-52870000" ;
  description 'The netconf module to describe QoS services info.It contains state and configuration info.' ;
  revision 2025-08-08 {
    description '1. Add the SWITCH.5960X product label to the following feature: rocev2-cnp-feature,rocev2-nak-feature.' ;
  }

  revision 2025-06-06 {
    description '1. Add the ROSNG-V.VEG product label to the following feature: policy-action-rediret-route-map,traffic-policy.' ;
  }

  revision 2025-05-26 {
    description '1. Add the SWITCH.99X,SWITCH.59X-ES product label to the following feature: class-match-rocev2-udf.' ;
  }

  revision 2025-04-07 {
    description '1. Delete the MSR.ASR,MSR.ZSRV2,OTN.M721,PTN.61V5_1 product label from the following feature: policy-action-rediret-route-map.' ;
  }

  revision 2025-03-10 {
    description '1. Add feature policy-ecmp-mode to select the action load-sharing ecmp-hash function effective product.
2. Add ecmp-mode container below /qos:configuration/qos:qos/qos:policy-map/qos:traffic-based/qos:policy-maps/qos:policy-map/qos:class-maps/qos:class-map/qos:load-sharing and /qos:configuration/qos:qos/qos:policy-map/qos:traffic-based/qos:policy-maps/qos:policy-map/qos:class-maps/qos:class-default/qos:load-sharing.' ;
  }

  revision 2025-03-05 {
    description 'Description polishing.' ;
  }

  revision 2025-02-11 {
    description '1. Add feature class-match-rocev2-udf to select the match RoCEv2 user defined function effective product.
2. Add udf container below /qos:configuration/qos:qos/qos:class-map/qos:traffic-based/qos:class-maps/qos:class-map/qos:match/qos:ipv4-rocev2 and /qos:configuration/qos:qos/qos:class-map/qos:traffic-based/qos:class-maps/qos:class-map/qos:match/qos:ipv6-rocev2.' ;
  }

  revision 2024-09-02 {
    description '1. nsh of SFC' ;
  }

  revision 2024-07-17 {
    description '1. Add feature traffic-match-vrf to select the match vrf-name function effective product.' ;
  }

  revision 2024-06-11 {
    description '1.Support configure fields of RoCEv2 packets as CNP, NAK, add follow containers:
/configuration/qos/class-map/traffic-based/class-maps/class-map/match/ipv4-rocev2/opcode/cnp/cnp;
/configuration/qos/class-map/traffic-based/class-maps/class-map/match/ipv4-rocev2/opcode/nak/nak;
/configuration/qos/class-map/traffic-based/class-maps/class-map/match/ipv6-rocev2/opcode/cnp/cnp;
/configuration/qos/class-map/traffic-based/class-maps/class-map/match/ipv6-rocev2/opcode/nak/nak.' ;
  }

  revision 2024-05-09 {
    description '1. Support QoS IF-CAR stats switch with feature qos-car-stats-if, add container:
/qos:configuration/qos:qos/qos:qos-car-stats
2. Support clear QoS IF-CAR stats data with feature qos-car-stats-if, add container:
/qos:operation/qos:qos/qos:qos-car-stats-clear' ;
  }

  revision 2024-04-01 {
    description '1.Support QoS statistical share global switch, add nodes:
/qos:configuration/qos:qos/qos:qos-statistical-share-globals' ;
  }

  revision 2024-03-07 {
    description 'Modify the feature queue-depth-adaptive : add PTN.61V5_1 label.' ;
  }

  revision 2024-02-27 {
    description 'Add enumeration value to node:
/configuration/qos/queue-templates/queue-template/queue-nos/queue-no/queue-limit/queue-depth' ;
  }

