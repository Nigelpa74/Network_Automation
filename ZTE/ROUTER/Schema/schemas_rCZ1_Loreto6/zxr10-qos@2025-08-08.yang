                container ipv6-acls {
                  description 'Select IPv6 ACL name as matching criteria.' ;
                  list ipv6-acl {
                    description 'Set IPv6 ACL name as matching criteria.' ;
                    key acl-name ;
                    leaf acl-name {
                      description 'Set ipv6-access-list name, support 1-31 characters.' ;
                      type string {
                        length 1..31 {
                          description 'Name of ACL, support 1-31 characters' ;
                        }

                      }

                    }

                  }

                }

                container link-acls {
                  description 'Select link ACL name as matching criteria.' ;
                  list link-acl {
                    description 'Set link ACL name as matching criteria.' ;
                    key acl-name ;
                    leaf acl-name {
                      description 'Set link-access-list name, support 1-31 characters.' ;
                      type string {
                        length 1..31 {
                          description 'Name of ACL, support 1-31 characters' ;
                        }

                      }

                    }

                  }

                }

                container flowtypes {
                  description 'Select flowtype name as matching criteria.' ;
                  list flowtype {
                    description 'Set flowtype name as matching criteria.' ;
                    key flowtype-name ;
                    leaf flowtype-name {
                      description 'Set flowtype-name.' ;
                      type cps:flowtype-name-ex ;

                    }

                  }

                }

              }

              container cmap-description {
                description 'Description of a class map, support 1-79 characters.' ;
                presence "Specify description of class map" ;
                leaf cmap-description {
                  description 'Description of a class map, support 1-79 characters.' ;
                  type ncd:string-with-blank {
                    length 1..79 {
                      description 'Description of a class map, support 1-79 characters.' ;
                    }

                  }

                  mandatory true ;
                }

              }

            }

          }

          ncd:revise-date 2021-04-18 ;
