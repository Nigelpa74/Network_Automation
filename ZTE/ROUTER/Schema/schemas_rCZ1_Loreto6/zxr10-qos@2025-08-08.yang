          ncd:revise-date 2022-09-08 ;
        }

        container bgpad-schedules {
          description 'Clear QoS statistic data of BGP-AD schedule.' ;
          list bgpad-schedule {
            description 'Clear QoS statistic data of BGP-AD schedule.' ;
            key 'vpls-name peer-router-id' ;
            leaf vpls-name {
              description 'Set VPLS instance name, support 1-32 characters.' ;
              type string {
                length 1..32 ;

              }

            }

            leaf peer-router-id {
              description 'Set peer router id.' ;
              type ncd:ipv4-address ;

            }

          }

          ncd:revise-date 2021-01-11 ;
        }

        container interfaces {
          description 'Clear the QoS flow statistics.' ;
          list interface {
            description 'Clear the QoS flow statistics.' ;
            key 'if-name flow-direction' ;
            leaf if-name {
              description 'The interface which to be enabled statistics.' ;
              type ncd:ifname ;

            }

            leaf flow-direction {
              description 'The flow direction.' ;
              type qos-direction ;

            }

          }

          ncd:revise-date 2021-03-24 ;
        }

      }

      container traffic-policy-stats-clear {
        if-feature traffic-policy ;

        description 'Clear QoS traffic policy statistic data.' ;
        container stats-clear-interfaces {
          description 'Clear QoS traffic policy statistic data for interface.' ;
          list stats-clear-interface {
            description 'Clear QoS traffic policy statistic data for interface.' ;
            key 'if-name direction' ;
            leaf if-name {
              description 'The name of interface.' ;
              type ncd:ifname ;

            }

            leaf direction {
              description 'The direction to clear.' ;
              type qos-direction ;

            }

          }

        }

        container stats-clear-policy-maps {
          description 'Clear QoS traffic policy statistic data for policy map.' ;
          list stats-clear-policy-map {
            description 'Clear QoS traffic policy statistic data for policy map.' ;
            key 'policy-map-name direction' ;
            leaf policy-map-name {
              description 'The name of policy map.' ;
              type string {
                length 1..31 {
                  description 'Name of the policy map, support 1-31 characters' ;
                }

              }

            }

            leaf direction {
              description 'The direction to clear.' ;
              type qos-direction ;

            }

          }

          ncd:revise-date 2021-12-17 ;
        }

        ncd:revise-date 2021-01-25 ;
      }

      container qos-car-stats-clear {
        container stats-clear-interfaces {
          leaf if-name {
            type ncd:ifname ;

            description 'The name of interface.' ;
            mandatory true ;
          }

          leaf direction {
            type qos-direction ;

            description 'The flow direction.' ;
            mandatory true ;
          }

          choice match-type {
            description 'The match type of IF-CAR statistic.' ;
            case localport {
              container localport {
                leaf localport {
                  type empty ;

                  description 'Match localport.' ;
                  mandatory true ;
                }

                description 'Clear IF-CAR statistic data based on matching localport.' ;
                presence "match localport" ;
              }

              description 'Clear IF-CAR statistic data based on matching localport.' ;
            }

            case ipv4-access-list {
              container ipv4-access-list {
                leaf ipv4-acl-name {
                  type string {
                    length 1..31 {
                      description 'Name of IPv4 access list, support 1-31 characters.' ;
                    }

                  }

                  description 'Match IPv4 ACL name.' ;
                  mandatory true ;
                }

                description 'Clear IF-CAR statistic data based on matching IPv4 ACL.' ;
                presence "match ipv4 acl" ;
              }

              description 'Clear IF-CAR statistic data based on matching IPv4 ACL.' ;
            }

            case ipv6-access-list {
              container ipv6-access-list {
                leaf ipv6-acl-name {
                  type string {
                    length 1..31 {
                      description 'Name of IPv6 access list, support 1-31 characters.' ;
                    }

                  }

                  description 'Match IPv6 ACL name.' ;
                  mandatory true ;
                }

                description 'Clear IF-CAR statistic data based on matching IPv6 ACL.' ;
                presence "match ipv6 acl" ;
              }

              description 'Clear IF-CAR statistic data based on matching IPv6 ACL.' ;
            }

            case link-access-list {
              container link-access-list {
                leaf link-acl-name {
                  type string {
                    length 1..31 {
                      description 'Name of link access list, support 1-31 characters.' ;
                    }

                  }

                  description 'Match Link ACL name.' ;
                  mandatory true ;
                }

                description 'Clear IF-CAR statistic data based on matching link ACL.' ;
                presence "match link acl" ;
              }

              description 'Clear IF-CAR statistic data based on matching link ACL.' ;
            }

          }

          description 'Clear IF-CAR statistic data.' ;
          presence "stats clear interfaces" ;
          if-feature qos-car-stats-if {
            ncd:revise-date 2024-05-09 ;
          }

        }

        description 'Clear QoS CAR statistic data.' ;
        ncd:revise-date 2024-05-09 ;
      }

    }

    ncd:revise-date 2016-05-03 ;
  }

  container state {
    config false ;
    description 'State model.' ;
    container qos {
      description 'State about QoS.' ;
      container hqosstats {
        description 'Query HQoS statistics data.' ;
        list hqosstat {
          description 'Query HQoS statistics data.' ;
          key 'if dir p0 c1 p1 c2 p2 c3 p3 c4' ;
          leaf if {
            description 'The name of the attaching interface.' ;
            type ncd:ifname ;

          }

          leaf dir {
            description 'Configure the interface direction.' ;
            type enumeration {
              enum input {
                value 1 ;
                description 'Attaches to the input interface' ;
              }

              enum output {
                value 2 ;
                description 'Attaches to the output interface' ;
              }

            }

          }

          leaf p0 {
            description 'The 1st level policy-map name.' ;
            type string {
              length 1..31 {
                description 'The 1st level policy-map name.' ;
              }

            }

          }

          leaf c1 {
            description 'The 1st level class-map name.' ;
            type string {
              length 1..31 {
                description 'The 1st level class-map name.' ;
              }

            }

          }

          leaf p1 {
            description 'The 2nd level policy-map name.' ;
            type string {
              length 1..31 {
                description 'The 2nd level policy-map name.' ;
              }

            }

          }

          leaf c2 {
            description 'The 2nd level class-map name.' ;
            type string {
              length 1..31 {
                description 'The 2nd level class-map name.' ;
              }

            }

          }

          leaf p2 {
            description 'The 3rd level policy-map name.' ;
            type string {
              length 1..31 {
                description 'The 3rd level policy-map name.' ;
              }

            }

          }

          leaf c3 {
            description 'The 3rd level class-map name.' ;
            type string {
              length 1..31 {
                description 'The 3rd level class-map name.' ;
              }

            }

          }

          leaf p3 {
            description 'The 4th level policy-map name.' ;
            type string {
              length 1..31 {
                description 'The 4th level policy-map name.' ;
              }

            }

          }

          leaf c4 {
            description 'The 4th level class-map name.' ;
            type string {
              length 1..31 {
                description 'The 4th level class-map name.' ;
              }

            }

          }

          leaf transmit-pkts {
            description 'The transmit packtes.' ;
            type uint64 ;

          }

          leaf transmit-octets {
            description 'The transmit octets.' ;
            type uint64 ;

            units byte ;
          }

          leaf dropped-pkts {
            description 'The dropped packtes.' ;
            type uint64 ;

          }

          leaf dropped-octets {
            description 'The dropped octets.' ;
            type uint64 ;

            units byte ;
          }

          leaf transmit-pkts-rate {
            description 'The transmit packtes rate.' ;
            type uint64 ;

            units pps ;
          }

          leaf transmit-octets-rate {
            description 'The transmit octets rate.' ;
            type uint64 ;

            units Bps ;
            ncd:revise-date 2022-08-23 ;
          }

          leaf dropped-pkts-rate {
            description 'The dropped packtes rate.' ;
            type uint64 ;

            units pps ;
            ncd:revise-date 2022-08-23 ;
          }

          leaf dropped-octets-rate {
            description 'The dropped octets rate.' ;
            type uint64 ;

            units Bps ;
            ncd:revise-date 2022-08-23 ;
          }

          leaf used-queue-depth-pkts {
            description 'The used queue depth (Unit:packet).' ;
            type uint64 ;

            units packet ;
            ncd:revise-date 2022-08-23 ;
          }

          leaf used-queue-depth {
            description 'The used queue depth (Unit:byte).' ;
            type uint64 ;

            units byte ;
            ncd:revise-date 2022-08-23 ;
          }

          leaf pkts-loss-rate {
            description 'The packets loss rate.' ;
            type decimal64 {
              fraction-digits 4 ;
            }

            ncd:revise-date 2022-08-23 ;
          }

          leaf octets-loss-rate {
            description 'The octets loss rate.' ;
            type decimal64 {
              fraction-digits 4 ;
            }

            ncd:revise-date 2022-08-23 ;
          }

        }

      }

      container statistics {
        description 'Query QoS queue statistics data.' ;
        list statistic {
          description 'Query QoS queue statistics data.' ;
          key 'ifname direction' ;
          leaf ifname {
            description 'The name of the attaching interface.' ;
            type string {
              length 1..31 {
                description 'Name of the attaching interface, support 1-31 characters' ;
              }

            }

          }

          leaf direction {
            description 'Configure the interface direction.' ;
            type enumeration {
              enum input {
                value 1 ;
                description 'Attaches to the input interface' ;
              }

              enum output {
                value 2 ;
                description 'Attaches to the output interface' ;
              }

            }

          }

          container queues {
            description 'Query QoS queque statistics data.' ;
            list queue {
              description 'Query QoS queque statistics data.' ;
              key name ;
              leaf name {
                description 'The name of queue.' ;
                type qos-service-class ;

              }

              leaf transmit-pkts {
                description 'The transmit packtes.' ;
                type uint64 ;

              }

              leaf transmit-octets {
                description 'The transmit octets.' ;
                type uint64 ;

                units byte ;
              }

              leaf dropped-pkts {
                description 'The dropped packtes.' ;
                type uint64 ;

              }

              leaf dropped-octets {
                description 'The dropped octets.' ;
                type uint64 ;

                units byte ;
              }

              leaf transmit-pkts-rate {
                description 'The transmit packtes rate.' ;
                type uint64 ;

                units pps ;
              }

              leaf total-queue-depth {
                description 'The total queue depth.' ;
                type uint64 ;

                units byte ;
                ncd:revise-date 2021-09-15 ;
              }

              leaf used-queue-depth {
                description 'The used queue depth (Unit:byte).' ;
                type uint64 ;

                units byte ;
                ncd:revise-date 2021-09-15 ;
              }

              leaf transmit-octets-rate {
                description 'The transmit octets rate.' ;
                type uint64 ;

                units Bps ;
                ncd:revise-date 2022-08-23 ;
              }

              leaf transmit-bits-rate {
                description 'The transmit bits rate.' ;
                type uint64 ;

                units bps ;
                ncd:revise-date 2022-08-23 ;
              }

              leaf dropped-pkts-rate {
                description 'The dropped packtes rate.' ;
                type uint64 ;

                units pps ;
                ncd:revise-date 2022-08-23 ;
              }

              leaf dropped-bits-rate {
                description 'The dropped bits rate.' ;
                type uint64 ;

                units bps ;
                ncd:revise-date 2022-08-23 ;
              }

              leaf received-bits-rate {
                description 'The received bits rate.' ;
                type uint64 ;

                units bps ;
                ncd:revise-date 2022-12-26 ;
              }

              leaf used-queue-depth-pkts {
                description 'The used queue depth (Unit:packet).' ;
                type uint64 ;

                units packet ;
                ncd:revise-date 2022-08-23 ;
              }

              leaf pkts-loss-rate {
                description 'The packets loss rate.' ;
                type decimal64 {
                  fraction-digits 4 ;
                }

                ncd:revise-date 2022-08-23 ;
              }

              leaf octets-loss-rate {
                description 'The octets loss rate.' ;
                type decimal64 {
                  fraction-digits 4 ;
                }

                ncd:revise-date 2022-08-23 ;
              }

              leaf real-time-usage {
                description 'The real time usage.' ;
                type decimal64 {
                  fraction-digits 4 ;
                }

                ncd:revise-date 2022-08-23 ;
              }

            }

          }

          ncd:select ifname ;
          ncd:select "ifname direction" ;
        }

        ncd:revise-date 2021-08-11 ;
      }

      container queue-resource-stats {
        description 'QoS queue resource statistics data.' ;
        list boardstat {
          description 'Board queue resource statistics.' ;
          key board-name ;
          leaf board-name {
            description 'The board name.' ;
            type string {
              length 1..31 ;

            }

          }

          leaf in-total-num {
            description 'The total number of queue resources in the input direction.' ;
            type uint32 ;

          }

          leaf in-used-num {
            description 'The used number of queue resources in the input direction.' ;
            type uint32 ;

          }

          leaf out-total-num {
            description 'The total number of queue resources in the output direction.' ;
            type uint32 ;

          }

          leaf out-used-num {
            description 'The used number of queue resources in the output direction.' ;
            type uint32 ;

          }

        }

        ncd:revise-date 2021-08-23 ;
      }

      container flowspec-vrf-stats {
        description 'Query QoS VRF flowspec statistics data.' ;
        list flowspec-vrf-stat {
          description 'Query QoS VRF flowspec statistics data.' ;
          key 'address-family vrfName index' ;
          leaf address-family {
            description 'The address family.' ;
            type enumeration {
              enum ipv4 {
                value 4 ;
                description 'The address family type is IPv4.' ;
              }

              enum ipv6 {
                value 24 ;
                description 'The address family type is IPv6.' ;
              }

            }

          }

          leaf vrfName {
            description 'Virtual route forwarding name, support 1-32 characters.' ;
            type string {
              length 1..32 {
                description 'Virtual route forwarding name, support 1-32 characters.' ;
              }

            }

          }

          leaf index {
            description 'Flowspec statistics index.' ;
            type binary {
              length 32 {
                description 'The length of flowspec statistics index.' ;
              }

            }

          }

          container match {
            description 'Get match criteria of a class map.' ;
            container dscp {
              description 'Select DSCP as match criteria.' ;
              leaf dscp-value {
                description 'Get QoS dscp in range mode, support single DSCP value or range(max num:4;spacing mark:,) in <0-63>. For example,"6,10-30,40,50-60",etc.' ;
                type ncd:range ;

              }

            }

            container destination-ipv4-addr {
              description 'Select destination-address as match criteria.' ;
              leaf dst-address {
                description 'Destination IPv4 address.' ;
                type ncd:ipv4-address ;

              }

              leaf dst-address-mask {
                description 'Destination IPv4 maskcard bits.' ;
                type ncd:ipv4-mask ;

              }

            }

            container destination-ipv6-addr {
              description 'Select IPv6 destination-address as match criteria.' ;
              leaf dst-ipv6-addr {
                description 'IPv6 destination address.' ;
                type ncd:ipv6-address ;

              }

              leaf dst-ipv6-addr-prefix {
                description 'IPv6 destination maskcard length.' ;
                type uint8 {
                  range 0..128 {
                    description 'The range of the IPv6 address prefix.' ;
                  }

                }

              }

            }

            container source-ipv4-addr {
              description 'Select source-address as match criteria.' ;
              leaf src-address {
                description 'Source IPv4 address.' ;
                type ncd:ipv4-address ;

              }

              leaf src-address-mask {
                description 'Source IPv4 maskcard bits.' ;
                type ncd:ipv4-mask ;

              }

            }

            container source-ipv6-addr {
              description 'Select IPv6 source-address as match criteria.' ;
              leaf src-ipv6-addr {
                description 'IPv6 source address.' ;
                type ncd:ipv6-address ;

              }

              leaf src-ipv6-addr-prefix {
                description 'IPv6 source maskcard length.' ;
                type ncd:ipv6-mask-length ;

              }

            }

            container fragment-type {
              description 'Select fragment-type as match criteria.' ;
              leaf not {
                description 'Get logical negation of operation,
true  Match opposite
false Match current.' ;
                type boolean ;

              }

              leaf match-relation {
                description 'The rule of matching, see bellow:                
all  Match all of the fragment type
any  Match any of the fragment type.' ;
                type enumeration {
                  enum all {
                    value 0 ;
                    description 'Match all of the fragment type.' ;
                  }

                  enum any {
                    value 1 ;
                    description 'Match any of the fragment type.' ;
                  }

                }

              }

              leaf dont-fragment {
                description 'Match dont-fragment.' ;
                type boolean ;

              }

              leaf first-fragment {
                description 'Match first-fragment.' ;
                type boolean ;

              }

              leaf is-fragment {
                description 'Match is-fragment.' ;
                type boolean ;

              }

              leaf last-fragment {
                description 'Match last-fragment.' ;
                type boolean ;

              }

            }

            container port {
              description 'Select port as match criteria.' ;
              leaf port-value {
                description 'Get port value in range mode, support single port value or range(max num:4;spacing mark:,) in <0-65535>. For example,"1,300-400,1000,2000-4000",etc.' ;
                type ncd:range ;

              }

            }

            container destination-port {
              description 'Select destination-port as match criteria.' ;
              leaf dst-port-value {
                description 'Get destination-port value in range mode, support single destination-port value or range(max num:4;spacing mark:,) in <0-65535>. For example,"1,300-400,1000,2000-4000",etc.' ;
                type ncd:range ;

              }

            }

            container source-port {
              description 'Select source-port as match criteria.' ;
              leaf src-port-value {
                description 'Get source-port value in range mode, support single source-port value or range(max num:4;spacing mark:,) in <0-65535>. For example,"1,300-400,1000,2000-4000",etc.' ;
                type ncd:range ;

              }

            }

            container icmp-code {
              description 'Select icmp-code as match criteria.' ;
              leaf icmp-code-value {
                description 'Get icmp code in range mode, support single icmp-code value or range(max num:4;spacing mark:,) in <0-255>. For example,"6,10-30,40,50-60",etc.' ;
                type ncd:range ;

              }

            }

            container icmp-type {
              description 'Select icmp-type as match criteria.' ;
              leaf icmp-type-value {
                description 'Get icmp type in range mode, support single icmp-type value or range(max num:4;spacing mark:,) in <0-255>. For example,"6,10-30,40,50-60",etc.' ;
                type ncd:range ;

              }

            }

            container packet-length {
              description 'Select packet-length as match criteria.' ;
              leaf packet-length-value {
                description 'Get packet-length in range mode, support single packet-length value or range(max num:4;spacing mark:,) in <1-65535>. For example,"6,10-30,40,50-60",etc.' ;
                type ncd:range ;

              }

            }

            container protocol {
              description 'Select protocol as match criteria.' ;
              leaf protocol-value {
                description 'Get protocol in range mode, support single protocol value or range(max num:4;spacing mark:,) in <0-255>. For example,"6,10-30,40,50-60",etc.' ;
                type ncd:range ;

              }

            }

            container tcp-flags {
              description 'Select tcp-flag as match criteria.' ;
              list tcp-flag {
                description 'Select tcp-flag as match criteria.' ;
                key 'cwr ece urg ack psh rst syn fin' ;
                leaf cwr {
                  description 'Match on the CWR bit.' ;
                  type boolean ;

                }

                leaf ece {
                  description 'Match on the ECE bit.' ;
                  type boolean ;

                }

                leaf urg {
                  description 'Match on the URG bit.' ;
                  type boolean ;

                }

                leaf ack {
                  description 'Match on the ACK bit.' ;
                  type boolean ;

                }

                leaf psh {
                  description 'Match on the PSH bit.' ;
                  type boolean ;

                }

                leaf rst {
                  description 'Match on the RST bit.' ;
                  type boolean ;

                }

                leaf syn {
                  description 'Match on the SYN bit.' ;
                  type boolean ;

                }

                leaf fin {
                  description 'Match on the FIN bit.' ;
                  type boolean ;

                }

                leaf not {
                  description 'Get logical negation of operation,
true  Match opposite
false Match current.' ;
                  type boolean ;

                }

                leaf match-relation {
                  description 'The rule of matching, see bellow:                
all  Match all of the fragment type
any  Match any of the fragment type.' ;
                  type enumeration {
                    enum all {
                      value 0 ;
                      description 'Match all of the fragment type.' ;
                    }

                    enum any {
                      value 1 ;
                      description 'Match any of the fragment type.' ;
                    }

                  }

                }

                leaf relation-with-previous {
                  description 'The logical relationship with the previous tcp-flag match item, see bellow:                
and  The relationship to the previous tcp-flag is and
or   The relationship to the previous tcp-flag is or.' ;
                  type enumeration {
                    enum and {
                      value 1 ;
                      description 'The relationship to the previous tcp-flag match item is and.' ;
                    }

                    enum or {
                      value 2 ;
                      description 'The relationship to the previous tcp-flag match item is or.' ;
                    }

                  }

                }

                ncd:select "cwr ece urg ack psh rst syn fin" ;
              }

            }

            container flow-label {
              description 'Select flow-label as match criteria.' ;
              leaf flow-label-value {
                description 'Get flow label value.' ;
                type uint32 {
                  range 0..1048575 {
                    description 'The range of the flow label value.' ;
                  }

                }

              }

            }

            container next-header {
              description 'Select next-header as match criteria.' ;
              leaf next-header-value {
                description 'Get next-header in range mode, support single value or range(max num:4;spacing mark:,) in <0-255>. For example,"6,10-30,40,50-60",etc.' ;
                type ncd:range ;

              }

            }

          }

          container action {
            description 'Get the action of the flowspec.' ;
            container set {
              description 'Mark a packet.' ;
              container dscp {
                description 'Select DSCP as mark type.' ;
                leaf dscp-value {
                  description 'Get action of DSCP value, support <0-63>.' ;
                  type uint16 {
                    range 0..63 {
                      description 'DSCP value, support <0-63>' ;
                    }

                  }

                }

              }

            }

            container drop {
              description 'Get drop action.' ;
              leaf drop {
                description 'Get drop action.' ;
                type boolean ;

              }

            }

            container police {
              description 'Get traffic policing action.' ;
              leaf rate {
                description 'Get the rate value(default:kilobits per second).' ;
                type uint32 {
                  range 8..4294967295 {
                    description 'Get the rate value(default:kilobits per second).' ;
                  }

                }

              }

            }

            container redirect-nexthop {
              description 'Get redirect nexthop action.' ;
              container ip-address {
                description 'Get IPv4 address type of next-hop.' ;
                leaf ipv4-address {
                  description 'IPv4 address.' ;
                  type ncd:ipv4-address ;

                }

                leaf global {
                  description 'Global route.' ;
                  type boolean ;

                }

                leaf route-target {
                  description 'Whether route-target is configured as next-hop.' ;
                  type boolean ;

                }

                leaf rt-pattern {
                  description 'Route target, support three types as follow:
1. <0-65535>:<0-4294967295>
2. A.B.C.D:<0-65535>
3. <1-65535>.<0-65535>:<0-65535>.' ;
                  type string ;

                }

                leaf vrf-name {
                  description 'Virtual route forwarding name, support 1-32 characters.' ;
                  type string {
                    length 1..32 {
                      description 'Virtual route forwarding name, support 1-32 characters.' ;
                    }

                  }

                }

                leaf copy {
                  description 'Copy flag.' ;
                  type boolean ;

                }

              }

              container route-target {
                description 'Get route-target type of next-hop.' ;
                leaf route-target {
                  description 'Whether route-target is configured as next-hop.' ;
                  type boolean ;

                }

                leaf rt-pattern {
                  description 'Route target, support three types as follow:
1. <0-65535>:<0-4294967295>
2. A.B.C.D:<0-65535>
3. <1-65535>.<0-65535>:<0-65535>.' ;
                  type string ;

                }

              }

              container vrf {
                description 'Get virtual route forwarding type of next-hop.' ;
                leaf vrf-name {
                  description 'Virtual route forwarding name, support 1-32 characters.' ;
                  type string {
                    length 1..32 {
                      description 'Virtual route forwarding name, support 1-32 characters.' ;
                    }

                  }

                }

              }

              container ipv6-address {
                description 'Get IPv6 address type of next-hop.' ;
                leaf ipv6-address {
                  description 'IPv6 address.' ;
                  type ncd:ipv6-address ;

                }

                leaf global {
                  description 'Global route.' ;
                  type boolean ;

                }

                leaf route-target {
                  description 'Whether route-target is configured as next-hop.' ;
                  type boolean ;

                }

                leaf rt-pattern {
                  description 'Route target, support three types as follow:
1. <0-65535>:<0-4294967295>
2. A.B.C.D:<0-65535>
3. <1-65535>.<0-65535>:<0-65535>.' ;
                  type string ;

                }

                leaf vrf-name {
                  description 'Virtual route forwarding name, support 1-32 characters.' ;
                  type string {
                    length 1..32 {
                      description 'Virtual route forwarding name, support 1-32 characters.' ;
                    }

                  }

                }

                leaf color {
                  description 'Get color value, support 1-4294967295.' ;
                  type uint32 {
                    range 1..4294967295 ;

                  }

                }

                leaf prefix-sid {
                  description 'Get prefix SID value, <X:X:X:X:X:X:X:X>.' ;
                  type ncd:ipv6-address ;

                }

                leaf copy {
                  description 'Copy flag.' ;
                  type boolean ;

                }

              }

              container srv6-be {
                description 'Get srv6-be type of next-hop.' ;
                leaf srv6-be {
                  description 'Get srv6-be.' ;
                  type ncd:ipv6-address ;

                }

                leaf end-point {
                  description 'Get end-point.' ;
                  type ncd:ipv6-address ;

                }

                leaf copy {
                  description 'Copy flag.' ;
                  type boolean ;

                }

                ncd:revise-date 2022-09-26 ;
              }

            }

            container redirect-tunnel-id {
              description 'Get redirect tunnel ID.' ;
              leaf indirection-id {
                description 'Get indirection ID.' ;
                type uint32 {
                  range 1..4294967295 ;

                }

              }

              leaf copy {
                description 'Get copy flag.' ;
                type boolean ;

              }

            }

            container sampler {
              description 'Get sampler action.' ;
              leaf sampler {
                description 'Get sampler action.' ;
                type boolean ;

              }

            }

          }

          container if-groups {
            description 'Get interface group ID.' ;
            list if-group {
              description 'Get interface group ID.' ;
              key if-group-id ;
              leaf if-group-id {
                description 'Get interface group ID.' ;
                type uint16 {
                  range 0..16383 {
                    description 'Set interface group ID.' ;
                  }

                }

              }

            }

            ncd:revise-date 2022-10-10 ;
          }

          leaf matchPackets {
            description 'The number of matched packets.' ;
            type uint64 ;

          }

          leaf matchBytes {
            description 'The number of matched bytes.' ;
            type uint64 ;

            units byte ;
          }

          leaf transmitPackets {
            description 'The number of transmitted packets.' ;
            type uint64 ;

          }

          leaf transmitBytes {
            description 'The number of transmitted bytes.' ;
            type uint64 ;

            units byte ;
          }

          leaf dropPackets {
            description 'The number of dropped packets.' ;
            type uint64 ;

          }

          leaf dropBytes {
            description 'The number of dropped bytes.' ;
            type uint64 ;

          }

          ncd:select "address-family vrfName" ;
        }

        ncd:revise-date 2022-05-07 ;
      }

      container flowspec-ip-stats {
        description 'Query QoS IPv4 or IPv6 flowspec statistics data.' ;
        list flowspec-ip-stat {
          description 'Query QoS IPv4 or IPv6 flowspec statistics data.' ;
          key 'address-family index' ;
          leaf address-family {
            description 'The address family.' ;
            type enumeration {
              enum ipv4 {
                value 4 ;
                description 'The address family type is IPv4.' ;
              }

              enum ipv6 {
                value 24 ;
                description 'The address family type is IPv6.' ;
              }

            }

          }

          leaf index {
            description 'Flowspec statistics index.' ;
            type binary {
              length 32 {
                description 'The length of flowspec statistics index.' ;
              }

            }

          }

          container match {
            description 'Get match criteria of a class map.' ;
            container dscp {
              description 'Select DSCP as match criteria.' ;
              leaf dscp-value {
                description 'Get QoS dscp in range mode, support single DSCP value or range(max num:4;spacing mark:,) in <0-63>. For example,"6,10-30,40,50-60",etc.' ;
                type ncd:range ;

              }

            }

            container destination-ipv4-addr {
              description 'Select destination-address as match criteria.' ;
              leaf dst-address {
                description 'Destination IPv4 address.' ;
                type ncd:ipv4-address ;

              }

              leaf dst-address-mask {
                description 'Destination IPv4 maskcard bits.' ;
                type ncd:ipv4-mask ;

              }

            }

            container destination-ipv6-addr {
              description 'Select IPv6 destination-address as match criteria.' ;
              leaf dst-ipv6-addr {
                description 'IPv6 destination address.' ;
                type ncd:ipv6-address ;

              }

              leaf dst-ipv6-addr-prefix {
                description 'IPv6 destination maskcard length.' ;
                type uint8 {
                  range 0..128 {
                    description 'The range of the IPv6 address prefix.' ;
                  }

                }

              }

            }

            container source-ipv4-addr {
              description 'Select source-address as match criteria.' ;
              leaf src-address {
                description 'Source IPv4 address.' ;
                type ncd:ipv4-address ;

              }

              leaf src-address-mask {
                description 'Source IPv4 maskcard bits.' ;
                type ncd:ipv4-mask ;

              }

            }

            container source-ipv6-addr {
              description 'Select IPv6 source-address as match criteria.' ;
              leaf src-ipv6-addr {
                description 'IPv6 source address.' ;
                type ncd:ipv6-address ;

              }

              leaf src-ipv6-addr-prefix {
                description 'IPv6 source maskcard length.' ;
                type ncd:ipv6-mask-length ;

              }

            }

            container fragment-type {
              description 'Select fragment-type as match criteria.' ;
              leaf not {
                description 'Get logical negation of operation,
true  Match opposite
false Match current.' ;
                type boolean ;

              }

              leaf match-relation {
                description 'The rule of matching, see bellow:                
all  Match all of the fragment type
any  Match any of the fragment type.' ;
                type enumeration {
                  enum all {
                    value 0 ;
                    description 'Match all of the fragment type.' ;
                  }

                  enum any {
                    value 1 ;
                    description 'Match any of the fragment type.' ;
                  }

                }

              }

              leaf dont-fragment {
                description 'Match dont-fragment.' ;
                type boolean ;

              }

              leaf first-fragment {
                description 'Match first-fragment.' ;
                type boolean ;

              }

              leaf is-fragment {
                description 'Match is-fragment.' ;
                type boolean ;

              }

              leaf last-fragment {
                description 'Match last-fragment.' ;
                type boolean ;

              }

            }

            container port {
              description 'Select port as match criteria.' ;
              leaf port-value {
                description 'Get port value in range mode, support single port value or range(max num:4;spacing mark:,) in <0-65535>. For example,"1,300-400,1000,2000-4000",etc.' ;
                type ncd:range ;

              }

            }

            container destination-port {
              description 'Select destination-port as match criteria.' ;
              leaf dst-port-value {
                description 'Get destination-port value in range mode, support single destination-port value or range(max num:4;spacing mark:,) in <0-65535>. For example,"1,300-400,1000,2000-4000",etc.' ;
                type ncd:range ;

              }

            }

            container source-port {
              description 'Select source-port as match criteria.' ;
              leaf src-port-value {
                description 'Get source-port value in range mode, support single source-port value or range(max num:4;spacing mark:,) in <0-65535>. For example,"1,300-400,1000,2000-4000",etc.' ;
                type ncd:range ;

              }

            }

            container icmp-code {
              description 'Select icmp-code as match criteria.' ;
              leaf icmp-code-value {
                description 'Get icmp code in range mode, support single icmp-code value or range(max num:4;spacing mark:,) in <0-255>. For example,"6,10-30,40,50-60",etc.' ;
                type ncd:range ;

              }

            }

            container icmp-type {
              description 'Select icmp-type as match criteria.' ;
              leaf icmp-type-value {
                description 'Get icmp type in range mode, support single icmp-type value or range(max num:4;spacing mark:,) in <0-255>. For example,"6,10-30,40,50-60",etc.' ;
                type ncd:range ;

              }

            }

            container packet-length {
              description 'Select packet-length as match criteria.' ;
              leaf packet-length-value {
                description 'Get packet-length in range mode, support single packet-length value or range(max num:4;spacing mark:,) in <1-65535>. For example,"6,10-30,40,50-60",etc.' ;
                type ncd:range ;

              }

            }

            container protocol {
              description 'Select protocol as match criteria.' ;
              leaf protocol-value {
                description 'Get protocol in range mode, support single protocol value or range(max num:4;spacing mark:,) in <0-255>. For example,"6,10-30,40,50-60",etc.' ;
                type ncd:range ;

              }

            }

            container tcp-flags {
              description 'Select tcp-flag as match criteria.' ;
              list tcp-flag {
                description 'Select tcp-flag as match criteria.' ;
                key 'rst ack fin syn psh urg ece cwr' ;
                leaf cwr {
                  description 'Match on the CWR bit.' ;
                  type boolean ;

                }

                leaf ece {
                  description 'Match on the ECE bit.' ;
                  type boolean ;

                }

                leaf urg {
                  description 'Match on the URG bit.' ;
                  type boolean ;

                }

                leaf ack {
                  description 'Match on the ACK bit.' ;
                  type boolean ;

                }

                leaf psh {
                  description 'Match on the PSH bit.' ;
                  type boolean ;

                }

                leaf rst {
                  description 'Match on the RST bit.' ;
                  type boolean ;

                }

                leaf syn {
                  description 'Match on the SYN bit.' ;
                  type boolean ;

                }

                leaf fin {
                  description 'Match on the FIN bit.' ;
                  type boolean ;

                }

                leaf not {
                  description 'Get logical negation of operation,
true  Match opposite
false Match current.' ;
                  type boolean ;

                }

                leaf match-relation {
                  description 'The rule of matching, see bellow:                
all  Match all of the fragment type
any  Match any of the fragment type.' ;
                  type enumeration {
                    enum all {
                      value 0 ;
                      description 'Match all of the fragment type.' ;
                    }

                    enum any {
                      value 1 ;
                      description 'Match any of the fragment type.' ;
                    }

                  }

                }

                leaf relation-with-previous {
                  description 'The logical relationship with the previous tcp-flag match item, see bellow:                
and  The relationship to the previous tcp-flag is and
or   The relationship to the previous tcp-flag is or.' ;
                  type enumeration {
                    enum and {
                      value 1 ;
                      description 'The relationship to the previous tcp-flag match item is and.' ;
                    }

                    enum or {
                      value 2 ;
                      description 'The relationship to the previous tcp-flag match item is or.' ;
                    }

                  }

                }

                ncd:select "cwr ece urg ack psh rst syn fin" ;
              }

            }

            container flow-label {
              description 'Select flow-label as match criteria.' ;
              leaf flow-label-value {
                description 'Get flow label value.' ;
                type uint32 {
                  range 0..1048575 {
                    description 'The range of the flow label value.' ;
                  }

                }

              }

            }

            container next-header {
              description 'Select next-header as match criteria.' ;
              leaf next-header-value {
                description 'Get next-header in range mode, support single value or range(max num:4;spacing mark:,) in <0-255>. For example,"6,10-30,40,50-60",etc.' ;
                type ncd:range ;

              }

            }

          }

          container action {
            description 'Get the action of the flowspec.' ;
            container set {
              description 'Mark a packet.' ;
              container dscp {
                description 'Select DSCP as mark type.' ;
                leaf dscp-value {
                  description 'Get action of DSCP value, support <0-63>.' ;
                  type uint16 {
                    range 0..63 {
                      description 'DSCP value, support <0-63>' ;
                    }

                  }

                }

              }

            }

            container drop {
              description 'Get drop action.' ;
              leaf drop {
                description 'Get drop action.' ;
                type boolean ;

              }

            }

            container police {
              description 'Get traffic policing action.' ;
              leaf rate {
                description 'Get the rate value(default:kilobits per second).' ;
                type uint32 {
                  range 8..4294967295 {
                    description 'Get the rate value(default:kilobits per second).' ;
                  }

                }

              }

            }

            container redirect-nexthop {
              description 'Get redirect nexthop action.' ;
              container ip-address {
                description 'Get IPv4 address type of next-hop.' ;
                leaf ipv4-address {
                  description 'IPv4 address.' ;
                  type ncd:ipv4-address ;

                }

                leaf global {
                  description 'Global route.' ;
                  type boolean ;

                }

                leaf route-target {
                  description 'Whether route-target is configured as next-hop.' ;
                  type boolean ;

                }

                leaf rt-pattern {
                  description 'Route target, support three types as follow:
1. <0-65535>:<0-4294967295>
2. A.B.C.D:<0-65535>
3. <1-65535>.<0-65535>:<0-65535>.' ;
                  type string ;

                }

                leaf vrf-name {
                  description 'Virtual route forwarding name, support 1-32 characters.' ;
                  type string {
                    length 1..32 {
                      description 'Virtual route forwarding name, support 1-32 characters.' ;
                    }

                  }

                }

                leaf copy {
                  description 'Copy flag.' ;
                  type boolean ;

                }

              }

              container route-target {
                description 'Get route-target type of next-hop.' ;
                leaf route-target {
                  description 'Whether route-target is configured as next-hop.' ;
                  type boolean ;

                }

                leaf rt-pattern {
                  description 'Route target, support three types as follow:
1. <0-65535>:<0-4294967295>
2. A.B.C.D:<0-65535>
3. <1-65535>.<0-65535>:<0-65535>.' ;
                  type string ;

                }

              }

              container vrf {
                description 'Get virtual route forwarding type of next-hop.' ;
                leaf vrf-name {
                  description 'Virtual route forwarding name, support 1-32 characters.' ;
                  type string {
                    length 1..32 {
                      description 'Virtual route forwarding name, support 1-32 characters.' ;
                    }

                  }

                }

              }

              container ipv6-address {
                description 'Get IPv6 address type of next-hop.' ;
                leaf ipv6-address {
                  description 'IPv6 address.' ;
                  type ncd:ipv6-address ;

                }

                leaf global {
                  description 'Global route.' ;
                  type boolean ;

                }

                leaf route-target {
                  description 'Whether route-target is configured as next-hop.' ;
                  type boolean ;

                }

                leaf rt-pattern {
                  description 'Route target, support three types as follow:
1. <0-65535>:<0-4294967295>
2. A.B.C.D:<0-65535>
3. <1-65535>.<0-65535>:<0-65535>.' ;
                  type string ;

                }

                leaf vrf-name {
                  description 'Virtual route forwarding name, support 1-32 characters.' ;
                  type string {
                    length 1..32 {
                      description 'Virtual route forwarding name, support 1-32 characters.' ;
                    }

                  }

                }

                leaf color {
                  description 'Get color value, support 1-4294967295.' ;
                  type uint32 {
                    range 1..4294967295 ;

                  }

                }

                leaf prefix-sid {
                  description 'Get prefix SID value, <X:X:X:X:X:X:X:X>.' ;
                  type ncd:ipv6-address ;

                }

                leaf copy {
                  description 'Copy flag.' ;
                  type boolean ;

                }

              }

              container srv6-be {
                description 'Get srv6-be type of next-hop.' ;
                leaf srv6-be {
                  description 'Get srv6-be.' ;
                  type ncd:ipv6-address ;

                }

                leaf end-point {
                  description 'Get end-point.' ;
                  type ncd:ipv6-address ;

                }

                leaf copy {
                  description 'Copy flag.' ;
                  type boolean ;

                }

                ncd:revise-date 2022-09-26 ;
              }

            }

            container redirect-tunnel-id {
              description 'Get redirect tunnel ID.' ;
              leaf indirection-id {
                description 'Get indirection ID.' ;
                type uint32 {
                  range 1..4294967295 ;

                }

              }

              leaf copy {
                description 'Get copy flag.' ;
                type boolean ;

              }

            }

            container sampler {
              description 'Get sampler action.' ;
              leaf sampler {
                description 'Get sampler action.' ;
                type boolean ;

              }

            }

          }

          container if-groups {
            description 'Get interface group ID.' ;
            list if-group {
              description 'Get interface group ID.' ;
              key if-group-id ;
              leaf if-group-id {
                description 'Get interface group ID.' ;
                type uint16 {
                  range 0..16383 {
                    description 'Set interface group ID.' ;
                  }

                }

              }

            }

            ncd:revise-date 2022-10-10 ;
          }

          leaf matchPackets {
            description 'The number of matched packets.' ;
            type uint64 ;

          }

          leaf matchBytes {
            description 'The number of matched bytes.' ;
            type uint64 ;

            units byte ;
          }

          leaf transmitPackets {
            description 'The number of transmitted packets.' ;
            type uint64 ;

          }

          leaf transmitBytes {
            description 'The number of transmitted bytes.' ;
            type uint64 ;

            units byte ;
          }

          leaf dropPackets {
            description 'The number of dropped packets.' ;
            type uint64 ;

          }

          leaf dropBytes {
            description 'The number of dropped bytes.' ;
            type uint64 ;

          }

          ncd:select address-family ;
        }

        ncd:revise-date 2022-05-07 ;
      }

      container traffic-policy-if-stats {
        description 'Query QoS if key traffic policy statistics data.' ;
        list traffic-policy-if-stat {
          description 'Query QoS if key traffic policy statistics data.' ;
          key 'if dir pname cname' ;
          leaf if {
            description 'The name of the attaching interface.' ;
            type ncd:ifname ;

          }

          leaf dir {
            description 'Configure the interface direction.' ;
            type enumeration {
              enum input {
                value 1 ;
                description 'Attaches to the input interface' ;
              }

              enum output {
                value 2 ;
                description 'Attaches to the output interface' ;
              }

            }

          }

          leaf pname {
            description 'Policy map name.' ;
            type string {
              length 1..31 {
                description 'Policy map name.' ;
              }

            }

          }

          leaf cname {
            description 'Class map name.' ;
            type string {
              length 1..31 {
                description 'Class map name.' ;
              }

            }

          }

          leaf transmit-pkts-rate {
            description 'The transmit packtes rate.' ;
            type uint64 ;

            units pps ;
          }

          leaf transmit-octets-rate {
            description 'The transmit octets rate.' ;
            type uint64 ;

            units Bps ;
          }

          leaf dropped-pkts-rate {
            description 'The dropped packtes rate.' ;
            type uint64 ;

            units pps ;
          }

          leaf dropped-octets-rate {
            description 'The dropped octets rate.' ;
            type uint64 ;

            units Bps ;
          }

        }

        ncd:revise-date 2022-09-19 ;
      }

    }

    ncd:revise-date 2021-06-04 ;
  }

}
