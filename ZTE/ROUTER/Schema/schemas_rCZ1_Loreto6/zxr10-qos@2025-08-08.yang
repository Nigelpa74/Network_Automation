  container operation {
    config false ;
    description 'Operation model.' ;
    container qos {
      description 'Operation about QoS.' ;
      container stats-clear {
        description 'Clear QoS statistic data.' ;
        container pw-schedules {
          description 'Clear QoS statistic data of PW schedule.' ;
          list pw-schedule {
            description 'Clear QoS statistic data of PW schedule.' ;
            key pw-name ;
            leaf pw-name {
              description 'Name of the PW, support 1-31 characters.' ;
              type string {
                length 1..31 {
                  description 'Name of the PW, support 1-31 characters.' ;
                }

              }

            }

          }

        }

        container pw-in-schedules {
          description 'Clear QoS statistic data of ingress PW schedule.' ;
          list pw-in-schedule {
            description 'Clear QoS statistic data of ingress PW schedule.' ;
            key pw-name ;
            leaf pw-name {
              description 'Name of the PW, support 1-31 characters.' ;
              type string {
                length 1..31 {
                  description 'Name of the PW, support 1-31 characters.' ;
                }

              }

            }

          }

