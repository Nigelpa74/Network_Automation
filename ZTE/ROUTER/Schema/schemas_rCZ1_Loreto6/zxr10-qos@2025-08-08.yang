                        type uint16 {
                          range 0..255 {
                            description 'The opcode value, support <0-255>.' ;
                          }

                        }

                        description 'Configure the opcode value of RoCEv2.' ;
                      }

                      description 'Configure the opcode value of RoCEv2.' ;
                    }

                    case cnp {
                      leaf cnp {
                        type empty ;

                        description 'Configure the RoCEv2 opcode as CNP.' ;
                      }

                      if-feature rocev2-cnp-feature ;

                      description 'Configure the RoCEv2 opcode as CNP.' ;
                      ncd:revise-date 2024-06-11 ;
                    }

                    case nak {
                      leaf nak {
                        type empty ;

                        description 'Configure the RoCEv2 opcode as NAK.' ;
                      }

                      if-feature rocev2-nak-feature ;

                      description 'Configure the RoCEv2 opcode as NAK.' ;
                      ncd:revise-date 2024-06-11 ;
                    }

                    description 'Configure the message type of RoCEv2 that indicate the operation mode of it.' ;
                  }

                  leaf qpair-value {
                    description 'Configure the queue pair value of RoCEv2.' ;
                    type uint32 {
                      range 0..16777215 {
                        description 'The queue pair value, support <0-16777215>.' ;
                      }

                    }

                  }

                  container udf {
                    leaf udf-data {
                      type string {
                        length 10 {
                          description 'udf data, supports exactly 10 characters.' ;
                        }

                      }

                      description 'Set user defined hexadecimal string data,as follows:
0x00000000-0xffffffff.' ;
                      mandatory true ;
                    }

                    leaf udf-mask {
                      type string {
                        length 10 {
                          description 'udf mask, supports exactly 10 characters.' ;
                        }

                      }

                      description 'Set user defined hexadecimal string wildcard mask,as follows:
0x00000000-0xffffffff.' ;
                      mandatory true ;
                    }

                    leaf offset-value {
                      type uint8 {
                        range 8..20 {
                          description 'udf offset value, support 8-20.' ;
                        }

                      }

                      description 'Set user defined offset value.' ;
                      mandatory true ;
                    }

