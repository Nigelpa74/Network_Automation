                    container mpls-exp {
                      description 'Select MPLS-EXP as mark type.' ;
                      presence "Select MPLS-EXP as mark type" ;
                      leaf label-type {
                        if-feature policy-action-set-label ;

                        description 'Select MPLS-EXP label position, such as default, topmost, imposition, inner.' ;
                        type enumeration {
                          enum topmost {
                            value 1 ;
                            description 'Set the MPLS-EXP value on topmost label' ;
                          }

                          enum imposition {
                            value 2 ;
                            description 'Set the MPLS-EXP value on all imposed labels' ;
                          }

                          enum default {
                            value 0 ;
                            description 'The default for topmost label' ;
                          }

                          enum inner {
                            value 3 ;
                            description 'Set the MPLS-EXP value on inner label' ;
                          }

                        }

                      }

                      choice method {
                        description 'Specify the method to set MPLS-EXP.' ;
                        mandatory true ;
