                  list ipv6-vxlan-acl {
                    description 'Set IPv6 vxlan ACL name as matching criteria.' ;
                    key acl-name ;
                    leaf acl-name {
                      description 'Set ipv6-vxlan-access-list name, support 1-31 characters.' ;
                      type string {
                        length 1..31 {
                          description 'Name of ACL, support 1-31 characters.' ;
                        }

                      }

                    }

