      container qos-prioritys-remark {
        if-feature qos-prioritys-remark ;

        description 'Configure the type of priority remarked by QoS.' ;
        list qos-priority-remark {
          description 'Configure the type of priority remarked by QoS.' ;
          key 'if-name priority-type' ;
          leaf if-name {
            description 'Specify the name of interface applied, support 1-31 characters.' ;
            type ncd:ifname {
              length 1..31 {
                description 'Name of the interface, support 1-31 characters' ;
              }

            }

          }

          leaf priority-type {
            description 'Set the priority type remarked by interface.' ;
            type enumeration {
              enum 8021p {
                value 1 ;
                description 'Based on 802.1p' ;
              }

              enum ip-dscp {
                value 2 ;
                description 'Based on IP DSCP' ;
              }

              enum mpls-exp {
                value 3 ;
                description 'Based on MPLS EXP' ;
              }

            }

          }

          leaf enable-switch {
            if-feature ds-interf-priority-remark-enable ;

            description 'Configure the interface priority modification is enabled or disable.' ;
            type enumeration {
              enum enable {
                value 1 ;
                description 'The switch is enable.' ;
              }

              enum disable {
                value 2 ;
                description 'The switch is disable.' ;
              }

