                    choice threshold {
                      description 'Set the threshold.' ;
                      mandatory true ;
                      case threshold-value {
                        description 'Set the threshold value.' ;
                        leaf min-threshold {
                          description 'Set the minimum threshold.' ;
                          type uint32 {
                            range 1..4294967295 {
                              description 'Set the minimum threshold in kilobytes' ;
                            }

                          }

                          units KB ;
                          mandatory true ;
