                          description 'Set the threshold percentage.' ;
                          leaf min-threshold-percentage {
                            description 'Set the minimum threshold percentage, support <1-100>.' ;
                            type uint32 {
                              range 1..100 ;

                            }

                            mandatory true ;
                          }

                          leaf max-threshold-percentage {
