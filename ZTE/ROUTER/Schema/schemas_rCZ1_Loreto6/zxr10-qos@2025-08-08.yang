                          description 'Set the DSCP value by inheriting.' ;
                          container inherit {
                            description 'Set the DSCP value by inheriting.' ;
                            leaf inherit-type {
                              description 'Specify the source inherit type, such as precedence, mpls-exp, 8021p, dscp, pay-load 8021p.' ;
                              type enumeration {
                                enum precedence {
                                  value 1 ;
                                  description 'Select precedence as source inherit' ;
                                }

                                enum mpls-exp {
                                  value 2 ;
                                  description 'Select MPLS-EXP as source inherit' ;
                                }

                                enum 8021p {
                                  value 3 ;
                                  description 'Select 802.1p as source inherit' ;
                                }

                                enum dscp {
                                  value 4 ;
                                  description 'Select dscp as source inherit' ;
                                }

                                enum pay-load-8021p {
                                  value 6 ;
                                  description 'Select inner 802.1p as source inherit' ;
                                }

                              }

                              mandatory true ;
                            }

                          }

                        }

                      }

