                    }

                    leaf vni-range2-end {
                      description 'The ending-value of the second VNI range.' ;
                      type uint32 {
                        range 1..16777215 ;

                      }

                      mandatory true ;
                    }

                    container vni-range3 {
                      description 'To select the third VNI range.' ;
                      presence "The configuration of the third VNI range" ;
                      leaf vni-range3-start {
                        description 'The starting-value of the third VNI range.' ;
                        type uint32 {
                          range 1..16777215 ;

                        }

