                    description 'To select the second VNI range.' ;
                    presence "The configuration of the second VNI range" ;
                    leaf vni-range2-start {
                      description 'The starting-value of the second VNI range.' ;
                      type uint32 {
                        range 1..16777215 ;

                      }

