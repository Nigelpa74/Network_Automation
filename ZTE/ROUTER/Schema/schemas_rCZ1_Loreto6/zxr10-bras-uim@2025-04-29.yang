module zxr10-bras-uim {
  namespace "http://www.zte.com.cn/zxr10/netconf/schema/bras/uim" ;
  prefix bras-uim ;
  yang-version 1 ;
  import zxr10-netconf-defs {
    prefix ncd ;
  }

  organization "ZTE Corporation" ;
  contact "ZTE Corporation  
     Nanjing Institute of ZTE Corporation 
     No.68 Zijinghua Rd. Yuhuatai District, Nanjing, China 
     Tel: +86-25-52870000" ;
  description 'The netconf module to describe the bras-uim' ;
  revision 2025-04-29 {
    description 'dhcp username' ;
  }

  revision 2025-04-18 {
    description 'iphost vrf change' ;
  }

  revision 2023-05-17 {
    description 'netconf encrypted-password <datatype>ciphertext</datatype>  add <log-type>password</log-type>' ;
  }

  revision 2022-11-16 {
    description 'leaf case add filter' ;
  }

  revision 2022-10-21 {
    description 'Add global-arp-safeguard.' ;
  }

  revision 2022-07-21 {
    description 'The minimum value of vxlan end-id is changed from 1 to 0.' ;
  }

  revision 2022-05-19 {
    description 'leaf "nas-basi""force""trackName""vxlan/start-id""vxlan/end-id" add range' ;
  }

  revision 2021-12-22 {
    description 'access-circuit-insert nas-user-def-text and ani-user-def-text length 31' ;
  }

  revision 2021-12-01 {
    description 'Configure access delay groups.' ;
  }

  revision 2021-05-27 {
    description 'leaf "userQos" delete enum user-classify-car.' ;
  }

  revision 2021-04-16 {
    description 'Add agent-circuit-id format ignore-ipox.' ;
  }

  revision 2021-04-14 {
    description 'add access-circuit-insert none-info' ;
  }

  revision 2021-02-26 {
    description 'L3 add dhcpv6 authen type' ;
  }

  revision 2021-02-20 {
    description 'Add ipox-basic-service leaf.' ;
  }

  revision 2021-02-08 {
    description 'Add access-delay-mac-offset leaf.' ;
  }

  revision 2021-02-03 {
    description 'Add dhcp-v6 suppress ia-nata in l3-access' ;
  }

  revision 2020-12-16 {
    description 'Encryption algorithm upgrade.' ;
  }

  revision 2020-08-04 {
    description 'Add qos-mode if-queue user-queue-car.
Add four kinds of mac format.' ;
  }

  revision 2020-05-18 {
    description 'add dhcpv6-slaac slaac access policy' ;
  }

  revision 2020-02-20 {
    description 'Change the maximum-time of access-delay from 2000 to 20000' ;
  }

  revision 2020-01-07 {
    description 'ipoxv6 user-detect command add no-flowcheck option
iphost user-detect command add no-flowcheck option' ;
  }

  revision 2019-11-20 {
    description 'nas-port-id' ;
  }

  revision 2019-08-14 {
    description 'Add dhcpv6 authentication option parse configuration of username,domain,password.Add dhcpv6 authentication type of mac-option16' ;
  }

  revision 2019-07-10 {
    description 'Add authentication option parse configuration of username,domain,password' ;
  }

  revision 2019-02-23 {
    description 'Add smartgroup-master container node.' ;
  }

  revision 2019-01-15 {
    description 'dhcp user-detect command add no-flowcheck option' ;
  }

  revision 2019-01-09 {
    description 'add username-type mac-option60 default option60 content' ;
  }

  revision 2018-05-14 {
    description 'add track command and vxlan configure' ;
  }

  revision 2018-01-19 {
    description 'modify max-vlan-session default 64000 to 128000' ;
  }

  revision 2016-12-28 {
    description 'Change dslam.' ;
  }

  revision 2016-12-08 {
    description 'Change the value of list access-delay,add 0 enum' ;
  }

  revision 2016-08-19 {
    description 'Change the reset value of container /configuration/uim/vbuis/vbui/iphost-detect, /configuration/uim/vbuis/vbui/ipoxv6-detect, /configuration/uim/vbuis/vbui/dhcp-user-detect' ;
  }

  revision 2016-04-08 {
    description 'Initial version' ;
  }

  container configuration {
    description 'configuration model info.' ;
    container uim {
      description 'Configure BRAS interface parameters.' ;
      container vccs {
        description 'Configure VCC parameters.' ;
        list vcc {
          description 'The port configure VCC info.' ;
          key vcc-name ;
          leaf vcc-name {
            description 'The interface will be configure VCC.' ;
            type ncd:ifname ;

          }

          leaf per-mac-multi-ipv4 {
            description 'Set per mac multi ipv4 flag' ;
            type enumeration {
              enum disable {
                value 0 ;
                description 'Disable per mac multi ip' ;
              }

              enum enable {
                value 1 ;
                description 'Enable per mac multi ip' ;
              }

            }

            default enable ;
          }

          leaf ip-access-type {
            description 'ip-access-type info of this port.' ;
            type enumeration {
              enum ipv4 {
                value 1 ;
                description 'IPv4 access' ;
              }

              enum ipv6 {
                value 2 ;
                description 'IPv6 access' ;
              }

              enum dual {
                value 3 ;
                description 'IP dual stack access' ;
              }

            }

            default ipv4 ;
          }

          leaf pppox-template {
            description 'Configure PPPoX template' ;
            type uint32 {
              range 1..1000 ;

            }

          }

          leaf encapsulation {
            description 'Set encapsulation type for interface' ;
            type enumeration {
              enum ppp-over-ethernet {
                value 1 ;
              }

              enum ip-over-ethernet {
                value 4 ;
              }

              enum multi {
                value 7 ;
              }

            }

          }

          leaf pre-domain {
            description 'authentication pre-domain name' ;
            type string {
              length 1..31 ;

            }

          }

          leaf max-vlan-session {
            description 'access max sessions per VLAN ID' ;
            type uint32 {
              range 0..128000 ;

            }

            default 128000 ;
          }

          leaf ipox-max-vlan-session {
            description 'ipox subscriber access max sessions per VLAN ID' ;
            type uint32 {
              range 0..128000 ;

            }

            default 128000 ;
          }

          leaf pppox-max-vlan-session {
            description 'pppox subscriber access max sessions per VLAN ID' ;
            type uint32 {
              range 0..128000 ;

            }

            default 128000 ;
          }

          leaf subscriber-check-location {
            description 'Subscriber location information' ;
            type enumeration {
              enum none {
                value 0 ;
                description 'Use BRAS information only' ;
              }

              enum vbas {
                value 1 ;
                description 'Use VBAS protocol' ;
              }

              enum pppoe-plus {
                value 2 ;
                description 'Use PPPoE+ protocol' ;
              }

              enum dhcp-option82 {
                value 3 ;
                description 'Use DHCP option82 protocol' ;
              }

              enum "o82|pppoe-plus" {
                value 4 ;
                description 'Use PPPoE+ or option82 protocol' ;
              }

              enum "o82|vbas" {
                value 5 ;
                description 'Use option82 or VBAS protocol' ;
              }

            }

            default none ;
          }

          leaf radius-proxy {
            description 'Radius proxy switch' ;
            type enumeration {
              enum disable {
                value 0 ;
                description 'Disable radius proxy' ;
              }

              enum enable {
                value 3 ;
                description 'Enable radius proxy' ;
              }

            }

            default disable ;
          }

          leaf bind-sal {
            description 'Bind SAL in VCC' ;
            type string {
              length 1..32 ;

            }

          }

          leaf server-discover-timer {
            description 'dhcp server discover timer' ;
            type enumeration {
              enum 60 {
                value 1 ;
                description 'Dhcp-server-discover-timer 60s' ;
              }

              enum 300 {
                value 5 ;
                description 'Dhcp-server-discover-timer 300s' ;
              }

              enum 3600 {
                value 60 ;
                description 'Dhcp-server-discover-timer 3600s' ;
              }

            }

          }

          leaf hostV4AuthType {
            description 'Iphostv4 authentication-type' ;
            type enumeration {
              enum web {
                value 3 ;
                description 'Web authentication' ;
              }

            }

          }

          leaf hostDualAuthType {
            description 'iphost user authentication-type' ;
            type enumeration {
              enum web {
                value 3 ;
                description 'Web authentication' ;
              }

            }

          }

          leaf ipv4-transmitmodeswitchCopy {
            description 'IPv4 multicast copy mode' ;
            type enumeration {
              enum user {
                value 1 ;
                description 'Set IPoE multicast copy mode by user' ;
              }

            }

          }

          leaf ipv6-transmitmodeswitch {
            description 'IPv6 multicast copy mode' ;
            type enumeration {
              enum user {
                value 1 ;
                description 'Set IPoE multicast copy mode by user' ;
              }

            }

          }

          leaf ipox-v4-authen {
            description 'Configure ipv4 user authentication-type' ;
            type enumeration {
              enum cir-map {
                value 1 ;
                description 'Circuit authentication' ;
              }

              enum option {
                value 2 ;
                description 'Option authentication' ;
              }

              enum web {
                value 3 ;
                description 'Web authentication' ;
              }

              enum option-web {
                value 4 ;
                description 'Option and web mixed authentication' ;
              }

            }

          }

          leaf ipoxv6-access-type {
            description 'ipox IPv6 access type' ;
            type enumeration {
              enum dhcpv6 {
                value 1 ;
                description 'DHCPv6 access type' ;
              }

              enum dhcpv6-slaac {
                value 2 ;
                description 'DHCPv6 and SLAAC multiple access type' ;
              }

              enum slaac {
                value 3 ;
                description 'SLAAC access type' ;
              }

            }

          }

          leaf slaac-access-policy {
            type enumeration {
              enum discard {
                value 1 ;
              }

              enum ignore-and-reply {
                value 2 ;
              }

            }

            ncd:revise-date 2020-05-18 ;
          }

          leaf pppoxv6-access-type {
            description 'Configure pppox IPv6 access type' ;
            type enumeration {
              enum dhcpv6 {
                value 1 ;
                description 'DHCPv6 access type' ;
              }

              enum dhcpv6-slaac {
                value 2 ;
                description 'DHCPv6 and SLAAC multiple access type' ;
              }

              enum slaac {
                value 3 ;
                description 'SLAAC access type' ;
              }

              enum pppv6 {
                value 4 ;
                description 'PPPv6 access type' ;
              }

            }

          }

          container ipoxv6-authen-type {
            description 'Configure ipv6 user authentication-type' ;
            leaf dhcp-v6 {
              description 'DHCPv6 user authentication-type' ;
              type enumeration {
                enum cir-map {
                  value 1 ;
                  description 'Circuit authentication' ;
                }

                enum option {
                  value 2 ;
                  description 'Option authentication' ;
                }

                enum web {
                  value 3 ;
                  description 'Web authentication' ;
                }

                enum option-web {
                  value 4 ;
                  description 'Option and web mixed authentication' ;
                }

              }

            }

            leaf slaac {
              description 'SLAAC authentication-type' ;
              type enumeration {
                enum cir-map {
                  value 1 ;
                  description 'Circuit authentication' ;
                }

                enum web {
                  value 3 ;
                  description 'Web authentication' ;
                }

              }

            }

          }

          leaf dhcpv6-suppress {
            description 'DHCPv6 suppress configure' ;
            type enumeration {
              enum ia-nata {
                value 1 ;
                description 'DHCPv6 suppress ia-nata' ;
              }

            }

          }

          container ipox-dual-authen {
            description 'Configure dual user authentication-type' ;
            leaf dhcp-v4 {
              description 'DHCPv4 user authentication-type' ;
              type enumeration {
                enum cir-map {
                  value 1 ;
                  description 'Circuit authentication' ;
                }

                enum option {
                  value 2 ;
                  description 'Option authentication' ;
                }

                enum web {
                  value 3 ;
                  description 'Web authentication' ;
                }

                enum option-web {
                  value 4 ;
                  description 'Option and web mixed authentication' ;
                }

              }

            }

            leaf dhcp-v6 {
              description 'DHCPv6 user authentication-type' ;
              type enumeration {
                enum cir-map {
                  value 1 ;
                  description 'Circuit authentication' ;
                }

                enum option {
                  value 2 ;
                  description 'Option authentication' ;
                }

                enum web {
                  value 3 ;
                  description 'Web authentication' ;
                }

                enum option-web {
                  value 4 ;
                  description 'Option and web mixed authentication' ;
                }

              }

            }

            leaf slaac {
              description 'SLAAC authentication-type' ;
              type enumeration {
                enum cir-map {
                  value 1 ;
                  description 'Circuit authentication' ;
                }

                enum web {
                  value 3 ;
                  description 'Web authentication' ;
                }

              }

            }

          }

          container nas-ssids {
            description 'Configure nas SSID' ;
            presence nas-ssid ;
            container ssid-qinq {
              description 'Configure nas SSID' ;
              presence ssid-qinq ;
              list ssid-qinq {
                description 'Configure nas SSID' ;
                key 'ex-vlan in-vlan' ;
                leaf ssid {
                  description 'SSID (e.g 00-15-70-91-E2-40:CFCC-EDA)' ;
                  type string {
                    length 1..51 {
                      description 'SSID (e.g 00-15-70-91-E2-40:CFCC-EDA)' ;
                    }

                  }

                  mandatory true ;
                }

                leaf ex-vlan {
                  description 'Set external vlan' ;
                  type ncd:single-range {
                    pattern "(([0-9]+-[0-9]+)|([1-9][0-9]*)){1,1}" {
                      description '(([0-9]+-[0-9]+)|([1-9][0-9]*)){1,1}' ;
                    }

                  }

                }

                leaf in-vlan {
                  description 'Set internal vlan' ;
                  type ncd:single-range {
                    pattern "(([0-9]+-[0-9]+)|([1-9][0-9]*)){1,1}" {
                      description '(([0-9]+-[0-9]+)|([1-9][0-9]*)){1,1}' ;
                    }

                  }

                }

              }

            }

            container ssid-dot1q {
              description 'Configure nas SSID' ;
              presence ssid-dot1q ;
              list ssid-dot1q {
                description 'Configure nas SSID' ;
                key ex-vlan ;
                leaf ssid {
                  description 'SSID (e.g 00-15-70-91-E2-40:CFCC-EDA)' ;
                  type string {
                    length 1..51 {
                      description 'SSID (e.g 00-15-70-91-E2-40:CFCC-EDA)' ;
                    }

                  }

                  mandatory true ;
                }

                leaf ex-vlan {
                  description 'Set external vlan' ;
                  type ncd:single-range {
                    pattern "(([0-9]+-[0-9]+)|([1-9][0-9]*)){1,1}" {
                      description '(([0-9]+-[0-9]+)|([1-9][0-9]*)){1,1}' ;
                    }

                  }

                }

              }

            }

            container ssid-no-vlan {
              description 'Configure nas SSID' ;
              presence ssid-no-vlan ;
              leaf ssid {
                description 'SSID (e.g 00-15-70-91-E2-40:CFCC-EDA)' ;
                type string {
                  length 1..51 {
                    description 'SSID (e.g 00-15-70-91-E2-40:CFCC-EDA)' ;
                  }

                }

                mandatory true ;
              }

            }

          }

          leaf nas-logic-ip {
            description 'nas logic IP address' ;
            type ncd:ipv4-address {
              pattern "(([1-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5])(.([0-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5])){3})|(([0])(.([1-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5]))(.([0-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5])){2})|(([0])(.([0]))(.([1-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5]))(.([0-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5])))|(([0])(.([0])){2}(.([1-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5])))" {
                description '(([1-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5])(.([0-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5])){3})|(([0])(.([1-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5]))(.([0-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5])){2})|(([0])(.([0]))(.([1-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5]))(.([0-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5])))|(([0])(.([0])){2}(.([1-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5])))' ;
              }

            }

          }

          leaf nas-logic-sysname {
            description 'nas logic system name' ;
            type string {
              length 1..31 ;

            }

          }

          container nas-logic-interface {
            description 'nas logic interface' ;
            presence nas-logic-interface ;
            leaf nas-logic-porttype {
              description 'nas logic interface type' ;
              type enumeration {
                enum atm {
                  value 1 ;
                  description 'ATM' ;
                }

                enum ethernet {
                  value 2 ;
                  description 'Ethernet' ;
                }

                enum smartgroup {
                  value 3 ;
                  description 'Smartgroup' ;
                }

              }

            }

            leaf nas_logic-slot {
              description 'nas logic interface slot' ;
              type uint16 {
                range 0..255 ;

              }

              mandatory true ;
            }

            leaf nas-logic-subslot {
              description 'nas logic interface subslot' ;
              type uint16 {
                range 0..255 ;

              }

              mandatory true ;
            }

            leaf nas_logic-port {
              description 'nas logic interface port number' ;
              type uint16 {
                range 0..255 ;

              }

              mandatory true ;
            }

          }

          leaf eap-authentication-type {
            description 'eap authentication type for interface' ;
            type enumeration {
              enum disable {
                value 0 ;
              }

              enum enable {
                value 1 ;
              }

            }

            default disable ;
          }

          leaf eap-template-no {
            description 'bind EAP template' ;
            type uint16 {
              range 1..1000 {
                description 'EAP template number' ;
              }

            }

          }

          leaf mac-format {
            description 'Configure MAC format' ;
            type enumeration {
              enum xx:xx:xx:xx:xx:xx {
                value 2 ;
                description 'Optional format' ;
              }

              enum xx-xx-xx-xx-xx-xx {
                value 1 ;
                description 'Optional format' ;
              }

              enum xxxx:xxxx:xxxx {
                value 3 ;
                description 'Optional format' ;
              }

              enum xxxx-xxxx-xxxx {
                value 4 ;
                description 'Optional format' ;
              }

              enum xxxxxxxxxxxx {
                value 5 ;
                description 'Optional format' ;
              }

              enum xxxx.xxxx.xxxx {
                value 6 ;
                description 'Optional format' ;
              }

              enum xx.xx.xx.xx.xx.xx {
                value 7 ;
                description 'Optional format' ;
              }

              enum user-defined {
                value 8 ;
                description 'Format eg. width 4 delimeter - : xxxx-xxxx-xxxx' ;
              }

            }

            default xx-xx-xx-xx-xx-xx ;
          }

          leaf mac-format-width {
            type enumeration {
              enum 1 {
                value 1 ;
                description 'Set width of mac-fomat 1 character' ;
              }

              enum 2 {
                value 2 ;
                description 'Set width of mac-fomat 2 characters' ;
              }

              enum 3 {
                value 3 ;
                description 'Set width of mac-fomat 3 characters' ;
              }

              enum 4 {
                value 4 ;
                description 'Set width of mac-fomat 4 characters' ;
              }

              enum 6 {
                value 6 ;
                description 'Set width of mac-fomat 6 characters' ;
              }

            }

            ncd:revise-date 2020-08-04 ;
          }

          leaf mac-format-delimiter {
            description "These characters's ASCII unicode must be between 0x21-0x2F/ 0x3A-0x3E/ 0x40/ 0x47-0x60/ 0x67-0x7E." ;
            type enumeration {
              enum "!" {
                value 33 ;
              }

              enum '"' {
                value 34 ;
              }

              enum "#" {
                value 35 ;
              }

              enum "$" {
                value 36 ;
              }

              enum "%" {
                value 37 ;
              }

              enum "&" {
                value 38 ;
              }

              enum "'" {
                value 39 ;
              }

              enum "(" {
                value 40 ;
              }

              enum ")" {
                value 41 ;
              }

              enum "*" {
                value 42 ;
              }

              enum "+" {
                value 43 ;
              }

              enum "," {
                value 44 ;
              }

              enum - {
                value 45 ;
              }

              enum . {
                value 46 ;
              }

              enum "/" {
                value 47 ;
              }

              enum : {
                value 58 ;
              }

              enum ";" {
                value 59 ;
              }

              enum "<" {
                value 60 ;
              }

              enum "=" {
                value 61 ;
              }

              enum ">" {
                value 62 ;
              }

              enum @ {
                value 64 ;
              }

              enum G {
                value 71 ;
              }

              enum H {
                value 72 ;
              }

              enum I {
                value 73 ;
              }

              enum J {
                value 74 ;
              }

              enum K {
                value 75 ;
              }

              enum L {
                value 76 ;
              }

              enum M {
                value 77 ;
              }

              enum N {
                value 78 ;
              }

              enum O {
                value 79 ;
              }

              enum P {
                value 80 ;
              }

              enum Q {
                value 81 ;
              }

              enum R {
                value 82 ;
              }

              enum S {
                value 83 ;
              }

              enum T {
                value 84 ;
              }

              enum U {
                value 85 ;
              }

              enum V {
                value 86 ;
              }

              enum W {
                value 87 ;
              }

              enum X {
                value 88 ;
              }

              enum Y {
                value 89 ;
              }

              enum Z {
                value 90 ;
              }

              enum "[" {
                value 91 ;
              }

              enum '\' {
                value 92 ;
              }

              enum "]" {
                value 93 ;
              }

              enum "^" {
                value 94 ;
              }

              enum _ {
                value 95 ;
              }

              enum "`" {
                value 96 ;
              }

              enum g {
                value 103 ;
              }

              enum h {
                value 104 ;
              }

              enum i {
                value 105 ;
              }

              enum j {
                value 106 ;
              }

              enum k {
                value 107 ;
              }

              enum l {
                value 108 ;
              }

              enum m {
                value 109 ;
              }

              enum n {
                value 110 ;
              }

              enum o {
                value 111 ;
              }

              enum p {
                value 112 ;
              }

              enum q {
                value 113 ;
              }

              enum r {
                value 114 ;
              }

              enum s {
                value 115 ;
              }

              enum t {
                value 116 ;
              }

              enum u {
                value 117 ;
              }

              enum v {
                value 118 ;
              }

              enum w {
                value 119 ;
              }

              enum x {
                value 120 ;
              }

              enum y {
                value 121 ;
              }

              enum z {
                value 122 ;
              }

              enum "{" {
                value 123 ;
              }

              enum "|" {
                value 124 ;
              }

              enum "}" {
                value 125 ;
              }

              enum "~" {
                value 126 ;
              }

            }

            ncd:revise-date 2020-08-04 ;
          }

          leaf mac-match-case {
            description 'MAC format match-case' ;
            type enumeration {
              enum majuscule {
                value 1 ;
                description 'Hexadecimal characters are in upper case' ;
              }

              enum lowercase {
                value 2 ;
                description 'Hexadecimal characters are in lower case' ;
              }

            }

            default majuscule ;
          }

          leaf close-source-mac-check {
            description 'Turn off checking source MAC' ;
            type enumeration {
              enum disable {
                value 0 ;
                description 'Turn on checking source MAC' ;
              }

              enum enable {
                value 1 ;
                description 'Turn off checking source MAC' ;
              }

            }

            default disable ;
          }

          leaf unauthentic-time {
            description 'unauthentic-timeout value' ;
            type uint32 {
              range 300..864000 {
                description 'Timeout value (s)' ;
              }

            }

          }

          leaf agent-circuit-id-format {
            description 'Configure agent-circuit-id format' ;
            type enumeration {
              enum china-tel {
                value 0 ;
                description 'China Telecom format' ;
              }

              enum tr101 {
                value 1 ;
                description 'Broadband Forum TR-101 format' ;
              }

              enum class1 {
                value 2 ;
                description 'Class1 format(e.g. ani-name atm 0/1/0/8:8.35)' ;
              }

              enum compatible {
                value 3 ;
                description 'Compatible format(include china-tel and class1)' ;
              }

              enum keep {
                value 4 ;
                description 'Keep format(for any format,do not analyse)' ;
              }

            }

            default compatible ;
          }

          leaf ac-client-group {
            description 'AC client group name' ;
            type string {
              length 1..31 ;

            }

          }

          leaf bras-ac-separate {
            description 'bras-ac separate flag' ;
            type enumeration {
              enum disable {
                value 0 ;
                description 'Disable bras-ac separate' ;
              }

              enum enable {
                value 1 ;
                description 'Enable bras-ac separate' ;
              }

            }

            default disable ;
          }

          leaf arp-safeguard {
            description 'Set arp safeguard flag' ;
            type enumeration {
              enum enable {
                value 1 ;
                description 'Enable arp safeguard' ;
              }

              enum disable {
                value 0 ;
                description 'Disable arp safeguard' ;
              }

            }

          }

          leaf access-delay-mac-offset {
            description 'Configure mac offset for access delay.' ;
            type uint32 {
              range 1..47 {
                description 'mac offset bit(s)' ;
              }

            }

            ncd:revise-date 2021-02-08 ;
          }

          container access-delay {
            description 'Configure the delay timer' ;
            presence access-delay ;
            list access-delay {
              description 'Configure the delay timer' ;
              key 'modular remainder' ;
              leaf delaytime {
                description 'Configure the delay timer(ms),multiples of 50' ;
                type uint32 {
                  range 50..20000 ;

                }

                mandatory true ;
              }

              leaf modular {
                description 'Configure the modular' ;
                type enumeration {
                  enum even-mac {
                    value 1 ;
                  }

                  enum odd-mac {
                    value 2 ;
                  }

                  enum 3 {
                    value 3 ;
                  }

                  enum 4 {
                    value 4 ;
                  }

                  enum 5 {
                    value 5 ;
                  }

                  enum 6 {
                    value 6 ;
                  }

                  enum 7 {
                    value 7 ;
                  }

                  enum 8 {
                    value 8 ;
                  }

                  enum 0 {
                    value 255 ;
                  }

                }

              }

              leaf remainder {
                description 'Configure the remainder' ;
                type uint32 {
                  range 0..7 ;

                }

              }

              leaf group-name {
                type string {
                  length 1..31 {
                    description 'delay group.' ;
                  }

                }

