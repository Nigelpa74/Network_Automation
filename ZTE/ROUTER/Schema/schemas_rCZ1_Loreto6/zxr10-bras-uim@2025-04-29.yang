      container track {
        list trackName {
          key ifName ;
          leaf ifName {
            type ncd:ifname ;

          }

          leaf afnodeName {
            type ncd:af-name ;

            mandatory true ;
          }

          leaf name {
            description 'track name' ;
            type string {
              length 0..31 ;

            }

            mandatory true ;
          }

          leaf afnodeIndex {
            description 'af-node ID' ;
            type uint32 ;

            mandatory true ;
          }

          leaf ifIndex {
            type uint32 ;

            mandatory true ;
          }

        }

        ncd:revise-date 2018-05-14 ;
      }

      container vxlans {
        description 'Configure VXLAN parameters.' ;
        list vxlan {
          description 'Configure VXLAN parameters' ;
          key 'if-name start-id end-id' ;
          leaf if-name {
            description 'Interface name' ;
            type ncd:ifname ;

          }

          leaf start-id {
            description 'vni start id' ;
            type uint32 {
              range 1..16777215 ;

            }

          }

          leaf end-id {
            description 'vni end id' ;
            type uint32 {
              range 0..16777215 ;

            }

          }

        }

        ncd:revise-date 2018-05-14 ;
      }

      container smartgroup-master {
        presence master-interface ;
        list master {
          description 'Configure the master member port of smartgroup.' ;
          key smartgroup-id ;
          leaf smartgroup-id {
            description 'The group id bound by master port, its maximum value depends on the performance parameters.' ;
            type uint32 {
              range 1..65535 {
                description 'The maximum value depends on the performance parameters.' ;
              }

            }

          }

          leaf master-interface {
            description 'The interface name of master member port.' ;
            type ncd:ifname ;

            mandatory true ;
          }

        }

        ncd:revise-date 2019-02-23 ;
      }

      container access-delay-groups {
        description 'Configure access delay groups.' ;
        presence access-delay-group ;
        list access-delay-group {
          description 'Configure access delay group.' ;
          max-elements 32 ;
          key group-name ;
          leaf group-name {
            description 'Configure group name.' ;
            type string {
              length 1..31 {
                description 'delay group name' ;
              }

            }

          }

          leaf delay-time {
            description 'Configure group delay time.' ;
            type uint32 {
              range 0..20000 {
                description 'group delay time' ;
              }

            }

            mandatory true ;
          }

          choice algorithms {
            description 'Configure group algorithm.' ;
            mandatory true ;
            case hash {
              description 'Configure algorithm hash.' ;
              leaf algorithm-hash {
                type enumeration {
                  enum enable {
                    value 1 ;
                    description 'Configure algorithms hash enable.' ;
                  }

                }

              }

            }

            case user-balance {
              description 'Configure algorithm user-balance.' ;
              leaf algorithm-user-balance {
                type enumeration {
                  enum enable {
                    value 2 ;
                    description 'Configure algorithm user-balance enable.' ;
                  }

                }

              }

              leaf all-response {
                description 'Configure all interface response.' ;
                type enumeration {
                  enum enable {
                    value 1 ;
                  }

                  enum disable {
                    value 0 ;
                  }

                }

                mandatory true ;
              }

            }

          }

        }

        ncd:revise-date 2021-12-01 ;
      }

      container global-arp-safeguard {
        leaf arp-safeguard {
          description 'Configure global arp safeguard flag.' ;
          type enumeration {
            enum disable {
              value 0 ;
              description 'Disable global arp safeguard.' ;
            }

            enum enable {
              value 1 ;
              description 'Enable global arp safeguard.' ;
            }

          }

          default disable ;
        }

        ncd:revise-date 2022-10-21 ;
      }

    }

