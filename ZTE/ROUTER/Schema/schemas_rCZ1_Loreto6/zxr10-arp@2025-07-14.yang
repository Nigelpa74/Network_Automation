module zxr10-arp {
  namespace "http://www.zte.com.cn/zxr10/netconf/schema/rosng/arp" ;
  prefix arp ;
  yang-version 1 ;
  import zxr10-netconf-defs {
    prefix ncd ;
    revision-date 2013-11-22 ;
  }

  organization "ZTE Corporation" ;
  contact "ZTE Corporation
  Nanjing Institute of ZTE Corporation
  No.68 Zijinghua Rd. Yuhuatai District, Nanjing, China
  Tel: +86-25-52870000" ;
  description 'The netconf module to describe ARP.' ;
  revision 2025-07-14 {
    description 'Add configuration/arp/interface-container/interface-mgmt-list.' ;
  }

  revision 2025-05-30 {
    description 'Add leaf configuration/arp/global-container/global/host-route-ecmp and feautrue host-route-ecmp.' ;
  }

  revision 2025-02-12 {
    description 'Add arp detail leaf' ;
  }

  revision 2024-12-23 {
    description 'Add inspection-interface node of configuration/arp/global-container/global.' ;
  }

  revision 2024-11-26 {
    description 'Modify description of some nodes' ;
  }

  revision 2024-08-01 {
    description 'Add configuration/arp/interface-container/interface-list/mac-change-notify-arp leaf' ;
  }

  revision 2024-07-11 {
    description 'Add units for configuration/arp/global-container/global/scan-period
configuration/arp/global-container/global/scan-send-rate
configuration/arp/global-container/global/update-suppress-mac/suppress-time
configuration/arp/vpls-evpns/vpls-evpn/probe-delay' ;
  }

  revision 2024-06-24 {
    description 'Add global-host-route-priority node of configuration/arp/global-container/global.' ;
  }

  revision 2024-04-09 {
    description 'Add configuration\arp\aggregated-routes container node.
Add configuration\arp\interface-container\interface-list\host-route-policy leaf.' ;
  }

  revision 2023-11-13 {
    description 'Add configuration\arp\vpls container.' ;
  }

  revision 2023-10-10 {
    description 'Add configuration\arp\interface-container\interface-list\fast-delete-sub-interface-down leaf node.' ;
  }

  revision 2023-09-05 {
    description 'Add configuration\arp\interface-container\interface-list\host-route-priority leaf node.
Add configuration\arp\interface-container\interface-list\host-route-tag leaf node.' ;
  }

  revision 2023-08-01 {
    description 'Modify the node configuration/arp/interface-container/interface-list/timeout, and configuration/arp/global-container/global/global-timeout, default value is determined by performance parameters' ;
  }

  revision 2023-06-25 {
    description 'Add configuration\arp\global-container\global\update-suppress-mac\suppress-count and suppress-time leaf node.' ;
  }

  revision 2023-05-23 {
    description 'Add state\arp\arp-statistics\arp-proxy-statistics\count leaf node' ;
  }

  revision 2023-03-29 {
    description 'Add entry-alarm-percent feature about the alarm threshold percent of ARP entries.
Add container configuration/arp/interface-container/interface-list/entry-alarm-percent.
Add leaf configuration/arp/interface-container/interface-list/entry-alarm-percent/alarm-percent.
Add leaf configuration/arp/interface-container/interface-list/entry-alarm-clear-percent.
Add container configuration/arp/global-container/global/global-entry-alarm-percent.
Add leaf configuration/arp/global-container/global/global-entry-alarm-percent/alarm-percent.
Add leaf configuration/arp/global-container/global/global-entry-alarm-percent/alarm-clear-percent.
Add arp scan interface network ipaddress' ;
  }

  revision 2023-03-14 {
    description 'Add configuration/arp/interface-container/interface-list/source-filtered-strict node.' ;
  }

  revision 2023-01-04 {
    description 'Add operation/arp/dhcp container node and son nodes.' ;
  }

  revision 2022-12-12 {
    description 'Add configuration/arp/interface-container/interface-list/remote-entry node.' ;
  }

  revision 2022-11-03 {
    description 'Modify the labels of the features.' ;
  }

  revision 2022-10-17 {
    description 'Add state/arp/proxy-segment-container container node.
Add state/arp/proxy-segment-container/proxy-segment-list list node.
Add state/arp/proxy-segment-container/proxy-segment-list/ip leaf node.
Add state/arp/proxy-segment-container/proxy-segment-list/intf-name leaf node.
Add state/arp/proxy-segment-container/proxy-segment-list/mask leaf node.' ;
  }

  revision 2022-09-07 {
    description 'Add PTN.6100 and PTN.61V5_1 labels to the feature of destination-filtered.' ;
  }

  revision 2022-07-29 {
    description 'Add PTN.6100 and PTN.61V5_1 labels to the feature of inspection vlan and inspection trust.' ;
  }

  revision 2022-06-14 {
    description 'Add state/arp/arp-statistics/global container node.
Add state/arp/arp-statistics/global/current-entry-num leaf node.
Add state/arp/arp-statistics/global/max-entry-num leaf node.' ;
  }

  revision 2022-05-17 {
    description 'Add update-suppress-time node of configuration/arp/global-container/global.' ;
  }

  revision 2022-01-26 {
    description 'Add SWITCH.99 SWITCH.99X and PC.SWITCH labels to the feature of destination-filtered.' ;
  }

  revision 2021-09-29 {
    description 'Delete the default value of /configuration/arp/interface-container/interface-list/icb-delete-notify, and modify the description of the leaf.' ;
  }

  revision 2021-08-05 {
    description 'Add state/arp/l2-proxy-items/l2-proxy-item/vlan-id node.
Modify the key of state/arp/l2-proxy-items/l2-proxy-item.' ;
  }

  revision 2021-05-25 {
    description 'Add leaf node: configuration/arp/interface-container/interface-list/send-trap.' ;
  }

  revision 2021-04-20 {
    description 'Add leaf configuration/arp/interface-container/interface-list/icb-delete-notify.' ;
  }

  revision 2021-04-07 {
    description 'Add detect-times node of configuration/arp/interface-container/interface-list.' ;
  }

  revision 2021-03-24 {
    description 'Modify feature of configuration/arp/interface-container/interface-list/detect-min-interval.' ;
  }

  revision 2021-03-04 {
    description 'Add state/arp/mclag-check-items node and son nodes.
Add the feature of mclag-consistency-check.' ;
  }

  revision 2021-01-28 {
    description 'Modify range of configuration/arp/interface-container/interface-list/temp-arp-timeout.' ;
  }

  revision 2020-08-10 {
    description 'Add detect-min-interval node of configuration/arp/interface-container/interface-list.' ;
  }

  revision 2020-08-06 {
    description 'Add host-route node of configuration/arp/interface-container/interface-list.' ;
  }

  revision 2020-07-22 {
    description 'Add destination-filtered node of configuration/arp/global-container/global.' ;
  }

  revision 2020-07-08 {
    description 'Add fast-reply node and fast-reply-mode node of configuration/arp/global-container/global.' ;
  }

  revision 2020-05-23 {
    description 'Add configuration/arp/vpls-evpns son nodes.
include:
  arp description' ;
  }

  revision 2020-05-06 {
    description 'Add state/arp/l2-proxy-items/l2-proxy-item nodes and feature about getting l2-proxy-item .' ;
  }

  revision 2019-12-22 {
    description 'Add configuration/arp/vpls-evpns/probe-delay nodes.' ;
  }

  revision 2018-07-05 {
    description 'modify RARP feature' ;
  }

  revision 2018-04-27 {
    description 'modify arp broadcast and arp proxy-suppress feature' ;
  }

  revision 2018-02-07 {
    description 'Add configuration/arp/vpls-evpns son nodes.
Include:
  arp broadcast
  arp proxy-suppress' ;
  }

  revision 2017-12-25 {
    description 'Add arp-vpls-evpn feature.
Add configuration/arp/vpls-evpns node and its son nodes.' ;
  }

  revision 2017-12-12 {
    description "The arp-vxlan-evpn feature doesn't support all switch projects and C600 project." ;
  }

  revision 2017-10-10 {
    description 'Add leaf node:/configuration/arp/interface-container/interface-list/global-proxy.' ;
  }

  revision 2017-08-03 {
    description 'Add configuration/arp/vxlan-evpn-container/double-label node.' ;
  }

  revision 2017-07-05 {
    description 'Add arp-vxlan-evpn feature.
Add configuration/arp/vxlan-evpn-container node and its son nodes.' ;
  }

  revision 2016-03-17 {
    description 'Add type case node under the clear-dynamic chioce node.' ;
  }

  revision 2016-01-25 {
    description '1.Modify the minimum value of configuration/arp/mac-protect-container/mac-protect-list/protect-num from 0 to 1.' ;
  }

  revision 2016-01-07 {
    description '1.Modify the type ipv4 of state/arp-item/detail/remote-ip to string.' ;
  }

  revision 2015-12-25 {
    description '1.Modify the type ipv4 of configuration/arp/vxlan-permanent-container/vxlan-permanent-list/remote-ip to choice.
2.Modify the type ipv4 of state/arp/vxlan-arp-item/brief/remote-ip to string.' ;
  }

  revision 2015-04-06 {
    description 'Delete the node of state/arp/ip-arp-inspection-configure.' ;
  }

  revision 2015-03-27 {
    description '1.Change the description of configuration/arp/interface-container/interface-list/protect-num.
2.Change the range and description of configuration/arp/mac-protect-container/mac-protect-list/protect-num.
3.Change the range and description of configuration/arp/global-container/global/global-protect-num.
4.Change the range and description of configuration/arp/global-container/global/mac-protect-num.' ;
  }

  revision 2015-03-13 {
    description '1.Delete the feature of freearp-periodic and cps-trust.
2.Add the feature of interface-temp-arp-timeout to the node of configuration/arp/interface-container/interface-list/temp-arp-timeout.
3.Delete the units of configuration/arp/inspection-trust-container/inspection-trust-list/inspection-trust.' ;
  }

  revision 2015-02-25 {
    description 'Modify the type unit8 of the leaf nodes of state/arp/ip-arp-inspection-configure to chars.' ;
  }

  revision 2015-02-13 {
    description '1.Add features of vxlan-arp,cps-trust,inspection-validate and inspection.
2.Add configuration/arp/vxlan-permanent-container to the feature of vxlan-arp.
3.Add configuration/arp/global-container/global/inspect-scr-mac,inspect-des-mac and inspect-ip to the feature of inspection-validate.
4.Add configuration/arp/inspection-container to the feature of inspection.
5.Add state/arp/arp-statistics to the feature of clear-arp-statistics.
6.Add state/arp/ip-arp-inspection-configure to the feature of inspection-validate.
7.Add state/arp/ip-arp-inspection-interface to the feature of inspection-trust.
8.Add state/arp/ip-arp-inspection-vlan to the feature of inspection-vlan.
9.Add state/arp/vxlan-arp-item to the feature of vxlan-arp.' ;
  }

  revision 2015-01-15 {
    description 'Modify vxlan permanent arp item nodes.
Delete these nodes:
zxr10-arp\configuration\permanent-container\permanent-list\remote-ip.
zxr10-arp\configuration\permanent-container\permanent-list\vtep-intf-name.
zxr10-arp\configuration\permanent-container\permanent-list\vxlan-id.
Add these nodes:
zxr10-arp\vxlan-permanent-container and its children nodes.' ;
  }

  revision 2014-12-03 {
    description 'Resolve the problem of interface filtering.
   Add default value of several nodes.' ;
  }

  revision 2014-08-11 {
    description 'Add vxlan arp item nodes and modify arp item detail nodes.' ;
  }

  revision 2014-05-20 {
    description 'Add 18 feature nodes.
Modify the protect-num node.
Add the inter-vlan-proxy node.
Remove permanent-flag node.
Modify the action-type of the no-to-static node.
Add performance parameters of the purge-delay and temp-arp-timeout nodes.' ;
  }

  revision 2014-04-28 {
    description 'Delete nodes of parent-intf in permanent and static ARP configuration.
Modify the default value of del-flag and source-filtered nodes.
The no-to-permanent-container node changes name to to-permanent-container.
Modify the configuration of static arp function.
Delete the nodes of mac inter-vlanid and exter-vlanid in the no-static-list node.
Add inspection function.' ;
  }

  revision 2014-03-20 {
    description 'Initial version' ;
  }

  feature interface-network-learn {
    description 'Network ARP learning function.' ;
  }

  feature interface-temp-arp-timeout {
    description 'Temporary ARP aging time.' ;
  }

  feature inspection-vlan {
    description 'Set VLAN dynamic ARP inspection.' ;
  }

  feature inspection-trust {
    description 'Set dynamic ARP inspection trust.' ;
  }

  feature inspection-limit {
    description 'Set dynamic ARP inspection limit speed.' ;
  }

  feature inspection-interface {
    description 'Set dynamic ARP inspection interface.' ;
    ncd:revise-date 2024-12-23 ;
  }

  feature to-permanent {
    description 'The dynamic ARP entry changes to the permanent type of the entry.' ;
  }

  feature detect {
    description 'Enable detect snooping function.' ;
  }

  feature keepalive-time {
    description 'The static routing the next-hop ARP keep alive interval.' ;
  }

  feature gratuitous-proxy-arp {
    description 'Set gratuitous proxy ARP.' ;
  }

  feature alarm-threshold {
    description 'Alarm-threshold.' ;
  }

  feature clear-arp-statistics {
    description 'Clear the ARP packet statistics counting.' ;
  }

  feature conflict-notify {
    description 'Set ARP conflict notify.' ;
  }

  feature learn-limit {
    description 'Limit ARP learning function.' ;
  }

  feature limit-time {
    description 'ARP limit time.' ;
  }

  feature port-speed {
    description 'Packets number per second of the port.' ;
  }

  feature inter-vlan-proxy {
    description 'Set ARP proxy function between different VLANs in the same interface.' ;
  }

  feature scan {
    description 'ARP scan under the interface.' ;
  }

  feature vxlan-arp {
    description 'ARP about VXLAN.' ;
  }

  feature inspection-validate {
    description 'Dynamic ARP inspection.' ;
  }

  feature inspection {
    description 'Dynamic ARP inspection about routers.' ;
  }

  feature arp-vxlan-evpn {
    description 'ARP configuration about VxLAN-EVPN.' ;
  }

  feature interface-global-proxy {
    description 'ARP global proxy function.' ;
  }

  feature arp-vpls-evpn {
    description 'ARP configurations about VPLS-EVPN.' ;
  }

  feature arp-vpls-evpn-l2-proxy {
    description 'ARP configurations about arp broadcast and arp proxy-suppress.' ;
  }

  feature rarp {
    description 'ARP configurations about RARP.' ;
  }

  feature get-l2-proxy-item {
    description 'A feature about getting l2-proxy-item' ;
  }

  feature arp-vpls-evpn-description {
    description 'Set the description of VPLS EVPN ARP.' ;
  }

  feature fast-reply {
    description 'A feature about arp fast-reply and arp fast-reply-mode.' ;
  }

  feature destination-filtered {
    description 'A feature about arp destination-filtered.' ;
  }

  feature host-route {
    description 'A feature about arp host-route.' ;
  }

  feature mclag-consistency-check {
    description 'The feature for getting the permanent ARP information in MC-LAG consistency checking.' ;
  }

  feature detect-min-interval {
    description 'A feature about arp detect-min-interval.' ;
  }

  feature detect-times {
    description 'A feature about arp detect-times.' ;
  }

  feature delete-notify {
    description 'A feature about inter-chassis backup delete-notify.' ;
  }

  feature send-trap {
    description 'Feature for send-trap.' ;
  }

  feature update-suppress-time {
    description 'A feature about the update-suppress time of ARP entries.' ;
    ncd:revise-date 2022-05-17 ;
  }

  feature proxy-segment {
    description 'A feature about arp proxy segment.' ;
    ncd:revise-date 2022-10-17 ;
  }

  feature entry-alarm-percent {
    description 'A feature about the alarm threshold percent of ARP entries.' ;
    ncd:revise-date 2023-03-29 ;
  }

  feature scan-intf-net-addr {
    description 'A feature about scan interface network address.' ;
    ncd:revise-date 2023-03-29 ;
  }

  feature arp-show-proxy-statistics {
    description 'A feature about show arp proxy statistics.' ;
    ncd:revise-date 2023-05-23 ;
  }

  feature update-suppress-mac {
    description 'The feature for nd update-suppress-mac function.' ;
    ncd:revise-date 2023-06-25 ;
  }

  feature aggregated-route {
    description 'The feature for aggregate route.' ;
    ncd:revise-date 2024-04-09 ;
  }

  feature mac-change-notify-arp {
    description 'the featrue of MAC change notify function.' ;
    ncd:revise-date 2024-08-01 ;
  }

  feature host-route-ecmp {
    description 'ARP configurations about host-route-ecmp.' ;
    ncd:revise-date 2025-05-30 ;
  }

  container configuration {
    description 'ARP configuration commands.' ;
    container arp {
      description 'ARP configuration commands.' ;
      container interface-container {
        description 'Commands under interface mode about ARP.' ;
        list interface-list {
          description 'Commands under interface mode about ARP.' ;
          key intf-name ;
          leaf intf-name {
            description 'Interface name.' ;
            type ncd:ifname ;

          }

          leaf timeout {
            description 'Dynamic ARP entries of aging time.' ;
            type uint32 {
              range 1..2147483 {
                description 'From 1 To 2147483.' ;
              }

            }

            units seconds ;
            default 14400 ;
          }

          leaf purge-delay {
            description 'ARP purge delay.' ;
            type uint32 {
              range 1..36000 {
                description 'From 1 to 36000.' ;
              }

            }

            units seconds ;
            default 600 ;
          }

          leaf protect-num {
            description 'Protect limit number.Its value depends on the performance parameters.' ;
            type uint32 {
              range 0..262144 {
                description 'From 0 to 262144.' ;
              }

            }

            default 0 ;
          }

          leaf limit-time {
            if-feature limit-time ;

            description 'ARP limit time.' ;
            type uint32 {
              range 0..1000 {
                description 'From 0 to 1000.' ;
              }

            }

            units seconds ;
            default 10 ;
          }

          leaf port-speed {
            if-feature port-speed ;

            description 'Packets number per second of the port.' ;
            type uint32 {
              range 0..1000 {
                description 'From 0 to 1000.' ;
              }

            }

            units number-per-second ;
            default 0 ;
          }

          leaf proxy {
            description 'ARP proxy.' ;
            type enumeration {
              enum disable {
                value 0 ;
                description 'Disable.' ;
              }

              enum enable {
                value 1 ;
                description 'Enable.' ;
              }

            }

            default disable ;
          }

          leaf learn-disable {
            description 'Disable ARP learning function.' ;
            type enumeration {
              enum disable {
                value 1 ;
                description 'Disable.' ;
              }

              enum enable {
                value 2 ;
                description 'Enable.' ;
              }

            }

            default disable ;
          }

          leaf source-filtered {
            description 'The interface source-filtered.' ;
            type enumeration {
              enum enable {
                value 1 ;
                description 'Enable.' ;
              }

              enum disable {
                value 2 ;
                description 'Disable.' ;
              }

            }

            default enable ;
          }

          leaf local-proxy-arp {
            description 'ARP local proxy in the port.' ;
            type enumeration {
              enum disable {
                value 0 ;
                description 'Disable.' ;
              }

              enum enable {
                value 1 ;
                description 'Enable.' ;
              }

            }

            default disable ;
          }

          leaf proxy-local {
            description 'Under the same VLAN ARP proxy function.' ;
            type enumeration {
              enum disable {
                value 0 ;
                description 'Disable.' ;
              }

              enum enable {
                value 1 ;
                description 'Enable.' ;
              }

            }

            default disable ;
          }

          leaf learn-limit {
            if-feature learn-limit ;

            description 'Limit ARP learning function.' ;
            type enumeration {
              enum enable {
                value 1 ;
                description 'Enable.' ;
              }

              enum disable {
                value 2 ;
                description 'Disable.' ;
              }

            }

            default disable ;
          }

          leaf backupvrrp-learn-flag {
            description 'Backup VRRP ARP learning function.' ;
            type enumeration {
              enum enable {
                value 1 ;
                description 'Enable.' ;
              }

              enum disable {
                value 2 ;
                description 'Disable.' ;
              }

            }

            default disable ;
          }

          leaf gratuitous-learn-flag {
            description 'Gratuitous ARP learning function.' ;
            type enumeration {
              enum enable {
                value 1 ;
                description 'Enable.' ;
              }

              enum disable {
                value 2 ;
                description 'Disable.' ;
              }

            }

            default disable ;
          }

          leaf network-learn-flag {
            if-feature interface-network-learn ;

            description 'Network ARP learning function.' ;
            type enumeration {
              enum enable {
                value 1 ;
                description 'Enable.' ;
              }

              enum disable {
                value 2 ;
                description 'Disable.' ;
              }

            }

            default disable ;
          }

          leaf limit-alarm-threshold {
            if-feature alarm-threshold ;

            description 'ARP learn-limit alarm-threshold.' ;
            type uint32 {
              range 1..65535 {
                description 'From 1 to 65535.' ;
              }

            }

            default 300 ;
          }

          leaf filter-alarm-thresshold {
            if-feature alarm-threshold ;

            description 'ARP source-filter alarm-threshold.' ;
            type uint32 {
              range 1..65535 {
                description 'From 1 to 65535.' ;
              }

            }

            default 300 ;
          }

          leaf temp-arp-timeout {
            if-feature interface-temp-arp-timeout ;

            description 'Temporary ARP aging time.Its maximum which is between 10-100 and generally 10, depends on pruduct specification.' ;
            type uint32 {
              range 1..100 {
                description 'From 1 to 100.' ;
              }

            }

            units seconds ;
            default 3 ;
          }

          leaf inter-vlan-proxy {
            if-feature inter-vlan-proxy ;

            description 'Set ARP proxy function between different VLANs in the same interface.' ;
            type enumeration {
              enum enable {
                value 1 ;
                description 'Enable.' ;
              }

              enum disable {
                value 2 ;
                description 'Disable.' ;
              }

            }

            default disable ;
          }

          leaf global-proxy {
            if-feature interface-global-proxy ;

            description 'ARP global proxy.' ;
            type enumeration {
              enum disable {
                value 0 ;
                description 'Disable global proxy function.' ;
              }

              enum enable {
                value 1 ;
                description 'Enable global proxy function.' ;
              }

            }

            default disable ;
            ncd:revise-date 2017-10-10 ;
          }

          container gratuitous-proxy {
            if-feature gratuitous-proxy-arp ;

            description 'Gratuitous proxy ARP.' ;
            leaf gratuitous-proxy-time {
              description 'Gratuitous proxy ARP regularly send interval.' ;
              type uint32 {
                range 1..14400 {
                  description 'From 1 to 14400.' ;
                }

              }

              units seconds ;
              default 30 ;
            }

          }

          container freearp {
            description 'Regularly send gratuitous ARP message sign of the port.' ;
            leaf freearp-time {
              description 'The time interval of send gratuitous ARP message.' ;
              type uint32 {
                range 10..14400 {
                  description 'From 10 to 14400.' ;
                }

              }

              units seconds ;
              default 30 ;
            }

          }

          leaf rarp {
            if-feature rarp ;

            description 'Set RARP function switch.' ;
            type enumeration {
              enum disable {
                value 0 ;
                description 'Disable RARP function' ;
              }

              enum enable {
                value 1 ;
                description 'Enable RARP function' ;
              }

            }

            default disable ;
            ncd:revise-date 2018-07-05 ;
          }

          leaf host-route {
            if-feature host-route ;

            description 'ARP host route function.' ;
            type enumeration {
              enum enable {
                value 1 ;
                description 'Enable ARP host-route.' ;
              }

              enum disable {
                value 0 ;
                description 'Disable ARP host-route.' ;
              }

            }

            default disable ;
            ncd:revise-date 2020-08-06 ;
          }

          leaf detect-min-interval {
            if-feature detect-min-interval ;

            description 'Set ARP detect minimum interval.' ;
            type uint32 {
              range 1..3600 {
                description 'From 1 To 3600.' ;
              }

            }

            units seconds ;
            default 3 ;
            ncd:revise-date 2020-08-10 ;
          }

          leaf detect-times {
            if-feature detect-times ;

            description 'Set ARP detection times.' ;
            type uint8 {
              range 1..10 {
                description 'From 1 To 10.' ;
              }

            }

            default 3 ;
            ncd:revise-date 2021-04-07 ;
          }

          leaf icb-delete-notify {
            if-feature delete-notify ;

            description 'Set ARP inter-chassis backup delete-notify.Its default value which is enable or disable and generally enable, depends on product specification.' ;
            type enumeration {
              enum enable {
                value 1 ;
                description 'Enable ARP inter-chassis backup delete-notify.' ;
              }

              enum disable {
                value 0 ;
                description 'Disable ARP inter-chassis backup delete-notify.' ;
              }

            }

            ncd:revise-date 2021-04-20 ;
          }

          leaf send-trap {
            if-feature send-trap ;

            description 'Set ARP trap function.' ;
            type enumeration {
              enum enable {
                value 1 ;
                description 'Enable ARP trap function.' ;
              }

              enum disable {
                value 0 ;
                description 'Disable ARP trap function.' ;
              }

            }

            default disable ;
            ncd:revise-date 2021-05-25 ;
          }

          leaf remote-entry {
            description 'Set ARP inter-chassis backup remote-entry. Its default value is disable.' ;
