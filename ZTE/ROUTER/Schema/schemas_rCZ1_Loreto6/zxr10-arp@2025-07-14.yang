              enum enable {
                value 1 ;
                description 'Enable remote-entry.' ;
              }

              enum disable {
                value 0 ;
                description 'Disable remote-entry.' ;
              }

            }

            default disable ;
            ncd:revise-date 2022-12-12 ;
          }

          leaf source-filtered-strict {
            description 'The source address strict filtering function of the interface. Its default value which is enable or disable and generally disable, depends on product specification.' ;
