              enum enable {
                value 0 ;
                description 'Enable source address strict filtering.' ;
              }

              enum disable {
                value 1 ;
                description 'Disable source address strict filtering.' ;
              }

            }

            ncd:revise-date 2023-03-14 ;
          }

          container entry-alarm-percent {
            if-feature entry-alarm-percent ;

            description 'ARP entries alarm percent configuration.' ;
            presence alarm-cfg ;
            leaf alarm-percent {
              description 'Sets the alarm percentage of the number of ARP entries on the interface.' ;
              type uint8 {
                range 1..99 ;

              }

              units percent ;
              mandatory true ;
            }

            leaf alarm-clear-percent {
              description 'Sets the alarm clearing percentage of the number of ARP entries on the interface.' ;
              type uint8 {
                range 1..99 ;

              }

