            description 'Set MAC change notify ARP function. Its default value is enable.' ;
            default enable ;
            if-feature mac-change-notify-arp ;

            ncd:revise-date 2024-08-01 ;
          }

        }

        list interface-mgmt-list {
          leaf intf-name {
            type ncd:ifname ;

            description 'Interface name.' ;
          }

          key intf-name ;
          leaf learn-limit {
            if-feature learn-limit ;

            type enumeration {
              enum enable {
                value 1 ;
                description 'Enable.' ;
              }

              enum disable {
                value 2 ;
                description 'Disable.' ;
              }

            }

            description 'Limit ARP learning function.' ;
            default disable ;
          }

          ncd:revise-date 2025-07-14 ;
        }

