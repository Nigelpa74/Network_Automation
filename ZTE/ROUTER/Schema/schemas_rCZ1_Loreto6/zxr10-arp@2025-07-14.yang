          leaf interface-name {
            type ncd:ifname ;

            description 'The name of the interface.' ;
          }

          leaf aggregated-ipv4 {
            type ncd:ipv4-address ;

            description 'The IPv4 address of aggregated route.' ;
          }

          leaf aggregated-mask-length {
            type uint8 {
              range 1..32 ;

            }

            description 'The mask length of aggregated route.' ;
            default 32 ;
          }

          key 'interface-name aggregated-ipv4' ;
        }

        ncd:revise-date 2024-04-09 ;
      }

    }

  }

  container operation {
    config false ;
    description 'ARP operation commands.' ;
    container arp {
      description 'ARP operation commands.' ;
      container to-static {
        description 'The dynamic ARP entry changes to the static type of the entry.' ;
        container to-static-container {
          description 'The static ARP entry changes to the dynamic type of the entry.' ;
          choice tostatic-choice {
            description 'The dynamic ARP entry changes to the static type of the entry.' ;
            case interface-case {
              description 'Interface name.' ;
              leaf intf-name {
                description 'Interface name.' ;
                type ncd:ifname ;

              }

            }

            case global-case {
              description 'All dynamic ARP entries change to static ARP entries.' ;
              leaf global {
                description 'All dynamic ARP entries change to static ARP entries.' ;
                type empty ;

              }

            }

          }

        }

      }

      container scan {
        if-feature scan ;

        description 'ARP scan under the interface.' ;
        list scan {
          description 'ARP scan under the interface.' ;
          key 'interface ip-begin ip-end' ;
          leaf interface {
            description 'Interface name.' ;
            type ncd:ifname ;

          }

          leaf ip-begin {
            description 'Start IP address.' ;
            type ncd:ipv4-address ;

          }

          leaf ip-end {
            description 'End IP address.' ;
            type ncd:ipv4-address ;

          }

        }

      }

      container to-permanent {
        if-feature to-permanent ;

        description 'The dynamic ARP entry changes to the permanent type of the entry.' ;
        container to-permanent-container {
          description 'The dynamic ARP entry changes to the permanent type of the entry.' ;
          leaf interface {
            description 'interface name.' ;
            type ncd:ifname ;

          }

        }

      }

      container clear {
        description 'Clear ARP entries.' ;
        container tostatic {
          description 'Clear dynamic-to-static ARP entries.' ;
          choice to-static-choice {
            description 'Clear dynamic-to-static ARP entries.' ;
            case interface-case {
              description 'Interface name.' ;
              leaf interface {
                description 'Interface name.' ;
                type ncd:ifname ;

              }

            }

            case global-case {
              description 'Clear all dynamic-to-static ARP entries.' ;
              leaf global {
                description 'Clear all dynamic-to-static ARP entries.' ;
                type empty ;

              }

            }

          }

        }

        container statistics {
          if-feature clear-arp-statistics ;

          description 'Clear the ARP packet statistics counting.' ;
          leaf interface {
            description 'Interface name.' ;
            type ncd:ifname ;

          }

        }

        container dynamic {
          description 'Clear dynamic ARP entries.' ;
          choice clear-dynamic {
            description 'Clear dynamic ARP entries.' ;
            case ip {
              description 'IP address.' ;
              leaf ip {
                description 'IP address.' ;
                type ncd:ipv4-address ;

              }

            }

            case ip-range {
              description 'IP address range.' ;
              leaf start-ip {
                description 'Start IP address.' ;
                type ncd:ipv4-address ;

                mandatory true ;
              }

              leaf end-ip {
                description 'End IP address.' ;
                type ncd:ipv4-address ;

                mandatory true ;
              }

            }

            case mac {
              leaf mac {
                description 'MAC address.' ;
                type ncd:mac-address ;

              }

            }

            case interface {
              description 'interface name.' ;
              container interface-dynamic {
                description 'Clear dynamic ARP entries under the interface.' ;
                choice clear-interface {
                  description 'Clear dynamic ARP entries under the interface.' ;
                  case ip-case {
                    description 'IP address.' ;
                    container ip {
                      description 'IP address.' ;
                      leaf interface-ip {
                        description 'IP address.' ;
                        type ncd:ipv4-address ;

                        mandatory true ;
                      }

                      leaf interface-name {
                        description 'Interface name.' ;
                        type ncd:ifname ;

                        mandatory true ;
                      }

                    }

                  }

                  case ip-range-case {
                    description 'IP address range.' ;
                    container ip-range {
                      description 'IP address range.' ;
                      leaf start-ip {
                        description 'Start IP address.' ;
                        type ncd:ipv4-address ;

                        mandatory true ;
                      }

                      leaf end-ip {
                        description 'End IP address.' ;
                        type ncd:ipv4-address ;

                        mandatory true ;
                      }

                      leaf interface-name {
                        description 'Interface name.' ;
                        type ncd:ifname ;

                        mandatory true ;
                      }

                    }

                  }

                  case mac-case {
                    description 'MAC address.' ;
                    container mac {
                      description 'MAC address.' ;
                      leaf interface-mac {
                        description 'MAC address.' ;
                        type ncd:mac-address ;

                        mandatory true ;
                      }

                      leaf interface-name {
                        description 'Interface name.' ;
                        type ncd:ifname ;

                        mandatory true ;
                      }

                    }

                  }

                  case interface-all-case {
                    description 'Delete all dynamic ARP entries under the interface.' ;
                    container interface-all {
                      description 'Delete all dynamic ARP entries under the interface.' ;
                      leaf interface-name {
                        description 'Interface name.' ;
                        type ncd:ifname ;

                        mandatory true ;
                      }

                    }

                  }

                }

              }

            }

            case type {
              description 'Clear ARP entry by type.' ;
              leaf type {
                description 'The type of ARP entry.' ;
                type enumeration {
                  enum dynamic-learning {
                    value 1 ;
                    description 'Dynamic learning ARP.' ;
                  }

                  enum DHCP {
                    value 2 ;
                    description 'DHCP ARP.' ;
                  }

                  enum controller {
                    value 3 ;
                    description 'Controller ARP.' ;
                  }

                }

                mandatory true ;
              }

              ncd:revise-date 2016-03-17 ;
            }

            case global {
              description 'Clear all dynamic ARP entries.' ;
              leaf global-dynamic {
                description 'Clear all dynamic ARP entries.' ;
                type empty ;

              }

            }

          }

        }

        container static {
          description 'Clear the static ARP entry.' ;
          choice clear-static {
            description 'Clear the static ARP entry.' ;
            case interface {
              description 'Clear static ARP entries under the interface.' ;
              leaf interface {
                description 'Clear static ARP entries under the interface.' ;
                type ncd:ifname ;

              }

            }

            case global {
              description 'Clear all static ARP entries.' ;
              leaf global-static {
                description 'Clear all static ARP entries.' ;
                type empty ;

              }

            }

          }

        }

        container dhcp {
          description 'Clear the dhcp ARP entry.' ;
          choice clear-dhcp {
            description 'Clear the dhcp ARP entry.' ;
            case interface_case {
              description 'Clear dhcp ARP entries under the interface.' ;
              leaf interface {
                description 'Clear dhcp ARP entries under the interface.' ;
                type ncd:ifname ;

              }

            }

            case global_case {
              description 'Clear all dhcp ARP entries.' ;
              leaf global-dhcp {
                description 'Clear all dhcp ARP entries.' ;
                type empty ;

              }

            }

          }

          ncd:revise-date 2023-01-04 ;
        }

      }

      container static {
        description 'Set the static ARP.' ;
        list static-list {
          description 'Set the static ARP.' ;
          key 'ip intf-name' ;
          leaf ip {
            description 'IP address.' ;
            type ncd:ipv4-address ;

          }

          leaf intf-name {
            description 'Interface name.' ;
            type ncd:ifname ;

          }

          leaf mac {
            description 'MAC address.' ;
            type ncd:mac-address ;

            mandatory true ;
          }

          leaf inter-vlanid {
            description 'Internal VLAN ID.' ;
            type uint16 {
              range 1..4094 {
                description 'From 1 to 4094.' ;
              }

            }

          }

          leaf exter-vlanid {
            description 'External VLAN ID.' ;
            type uint16 {
              range 1..4094 {
                description 'From 1 to 4094.' ;
              }

            }

          }

        }

      }

      container no-static {
        description 'Delete a static ARP entry.' ;
        list no-static-list {
          description 'Delete a static ARP entry.' ;
          key 'ip intf-name' ;
          leaf ip {
            description 'IP address.' ;
            type ncd:ipv4-address ;

          }

          leaf intf-name {
            description 'Interface name.' ;
            type ncd:ifname ;

          }

        }

      }

      container no-to-static {
        description 'The static ARP entry changes to the dynamic type of the entry.' ;
        container no-to-static-container {
          description 'The static ARP entry changes to the dynamic type of the entry.' ;
          choice no-to-static-choice {
            description 'The dynamic ARP entry changes to the static type of the entry.' ;
            case interface-case {
              description 'Interface name.' ;
              leaf intf-name {
                description 'Interface name.' ;
                type ncd:ifname ;

              }

            }

            case global-case {
              description 'All dynamic ARP entries change to static ARP entries.' ;
              leaf global {
                description 'All dynamic ARP entries change to static ARP entries.' ;
                type empty ;

              }

            }

          }

        }

      }

    }

  }

  container state {
    config false ;
    description 'Arp State Commod' ;
    container arp {
      description 'The show of ARP commod' ;
      container arp-item {
        description 'Show Arp Item Node' ;
        list brief {
          description 'Show Arp Item List' ;
          key 'ip-address hardware-address interface-name exter-vlanid inter-vlanid item-type' ;
          leaf ip-address {
            description 'IP Address' ;
            type ncd:ipv4-address ;

          }

          leaf hardware-address {
            description 'MAC Address' ;
            type ncd:mac-address ;

          }

          leaf interface-name {
            description 'Interface Name' ;
            type ncd:ifname ;

          }

          leaf exter-vlanid {
            description 'Exter Vlan ID' ;
            type uint16 ;

          }

          leaf inter-vlanid {
            description 'Inter Vlan ID' ;
            type uint16 ;

          }

          leaf item-type {
            description 'ARP Item Type' ;
            type uint8 ;

          }

          leaf sub-interface-name {
            description 'Sub Interface Name' ;
            type ncd:ifname ;

          }

          leaf age {
            description 'Show Dynamic Arp Time Or Show Arp Item Type' ;
            type ncd:string-all ;

          }

          ncd:select ip-address ;
          ncd:select interface-name ;
          ncd:select exter-vlanid ;
          ncd:select inter-vlanid ;
          ncd:select item-type ;
          ncd:select "ip-address interface-name" ;
          ncd:select "hardware-address interface-name" ;
          ncd:select "interface-name item-type" ;
        }

        list detail {
          description 'Show Arp Item Detail Infomation' ;
          key 'ip-address interface-name' ;
          leaf ip-address {
            description 'IP Address' ;
            type ncd:ipv4-address ;

          }

          leaf interface-name {
            description 'Interface Name' ;
            type ncd:ifname ;

          }

          leaf age {
            description 'Show Dynamic Arp Time Or Show Arp Item Type' ;
            type ncd:string-all ;

          }

          leaf hardware-address {
            description 'MAC Address' ;
            type ncd:mac-address ;

          }

          leaf physical-interface-name {
            description 'Physical Interface Name' ;
            type ncd:ifname ;

          }

          leaf item-attribute {
            description 'Item Attribute' ;
            type ncd:string-all ;

          }

          leaf item-class {
            description 'Item Class' ;
            type ncd:string-all ;

          }

          leaf learn-time-stamp {
            description 'Learn Time Stamp' ;
            type uint32 ;

          }

          leaf learn-ip-address {
            description 'Learn IP Address' ;
            type ncd:ipv4-address ;

          }

          leaf item-vrf {
            description 'Item VRF' ;
            type ncd:string-all ;

          }

          leaf data-source {
            description 'Data Source' ;
            type ncd:string-all ;

          }

          leaf cps-trust {
            description 'CPS Trust' ;
            type ncd:string-all ;

          }

          leaf vtep-interface-name {
            description 'Vtep Interface Name' ;
            type ncd:ifname ;

          }

          leaf vxlan-id {
            description 'VXLAN ID' ;
            type uint32 ;

          }

          leaf local-ip {
            type string {
              length 1..128 ;

            }

            description 'Source IP address.' ;
            ncd:revise-date 2025-02-12 ;
          }

          leaf remote-ip {
            description 'Remote IP address.' ;
            type string ;

          }

          leaf esi {
            type string {
              length 1..36 ;

            }

            description 'Ethernet segment identifier.' ;
            ncd:revise-date 2025-02-12 ;
          }

          leaf tunnel-name {
            type string {
              length 1..36 ;

            }

            description 'VXLAN tunnel name.' ;
            ncd:revise-date 2025-02-12 ;
          }

          ncd:select "ip-address interface-name" ;
        }

      }

      container arp-statistics {
        if-feature clear-arp-statistics ;

        description 'Show Arp Statistics' ;
        list brief {
          description 'Show Arp Statistics Item List' ;
          key interface-name ;
          leaf interface-name {
            description 'Interface Name' ;
            type ncd:ifname ;

          }

          leaf rcv-packets {
            description 'Receive Packets Number' ;
            type uint32 ;

            default 0 ;
          }

          leaf err-packets {
            description 'Error Packets Number' ;
            type uint32 ;

            default 0 ;
          }

          ncd:select interface-name ;
        }

        list detail {
          description 'Show Arp Statistics Item Detail' ;
          key interface-name ;
          leaf interface-name {
            description 'Interface Name' ;
            type ncd:ifname ;

          }

          leaf rcv-packets {
            description 'Receive Packets Number' ;
            type uint32 ;

            default 0 ;
          }

          leaf drop-limit-packets {
            description 'Drop Packets Number For Protect Limit' ;
            type uint32 ;

            default 0 ;
          }

          leaf drop-source-filter-packets {
            description 'Drop Packets Number For Source Filter' ;
            type uint32 ;

            default 0 ;
          }

          leaf drop-learn-limit-packets {
            description 'Drop Packets Number For Learn Limit' ;
            type uint32 ;

            default 0 ;
          }

          leaf drop-speed-packets {
            description 'Drop Packets Number For Port Speed' ;
            type uint32 ;

            default 0 ;
          }

          leaf drop-other-packets {
            description 'Drop Packets Number For Other' ;
            type uint32 ;

            default 0 ;
          }

          ncd:select interface-name ;
        }

        container global {
          description 'Get ARP global statics' ;
          leaf current-entry-num {
            description 'IPv4 ARP current entry num.' ;
            type uint32 ;

          }

          leaf max-entry-num {
            description 'IPv4 ARP max entry num.' ;
            type uint32 ;

          }

          ncd:revise-date 2022-06-14 ;
        }

        container arp-proxy-statistics {
          leaf statistics {
            type string ;

          }

          if-feature arp-show-proxy-statistics ;

          ncd:revise-date 2023-05-23 ;
        }

      }

      container ip-arp-inspection-interface {
        if-feature inspection-trust ;

        description 'Show Ip Arp Inspection Interface' ;
        list brief {
          description 'Show Ip Arp Inspection Interface Item' ;
          key interface-name ;
          leaf interface-name {
            description 'Interface Name' ;
            type ncd:ifname ;

          }

          leaf trust-state {
            description 'Trust State' ;
            type ncd:string-all ;

          }

          leaf rate {
            description 'Rate' ;
            type uint32 ;

            units pps ;
            default 0 ;
          }

          ncd:select interface-name ;
        }

      }

      container ip-arp-inspection-vlan {
        if-feature inspection-vlan ;

        description 'Show Ip Arp Inspection Vlan' ;
        list brief {
          description 'Show Ip Arp Inspection Vlan Item' ;
          key 'vlan-id inspection vlan-name' ;
          leaf vlan-id {
            description 'VLAN ID' ;
            type uint16 ;

          }

          leaf inspection {
            description 'Inspection State' ;
            type ncd:string-all ;

          }

          leaf vlan-name {
            description 'VLAN Name' ;
            type ncd:string-all ;

          }

          ncd:select vlan-id ;
          ncd:select inspection ;
          ncd:select vlan-name ;
        }

      }

      container vxlan-arp-item {
        if-feature vxlan-arp ;

        description 'Show Vxlan Arp Item Node.' ;
        list brief {
          description 'Show Vxlan Arp Item List' ;
          key vnid ;
          leaf vnid {
            description 'VNI ID.' ;
            type int32 ;

          }

          leaf ip-address {
            description 'IP address.' ;
            type ncd:ipv4-address ;

            mandatory true ;
          }

          leaf mac {
            description 'MAC address.' ;
            type ncd:mac-address ;

            mandatory true ;
          }

          leaf interface {
            description 'Interface name.' ;
            type ncd:ifname ;

            mandatory true ;
          }

          leaf vtep-interface {
            description 'VTEP interface.' ;
            type ncd:ifname ;

            mandatory true ;
          }

          leaf remote-ip {
            description 'Remote IP.' ;
            type string ;

            mandatory true ;
          }

          ncd:select vnid ;
        }

      }

      container l2-proxy-items {
        if-feature get-l2-proxy-item ;

        description 'Show ARP l2-proxy item' ;
        list l2-proxy-item {
          description 'Show ARP l2-proxy item node.' ;
          key 'ip-address vpls-name vlan-id' ;
          leaf ip-address {
            description 'IP address' ;
            type ncd:ipv4-address ;

          }

          leaf vpls-name {
            description 'VPLS EVPN instance name' ;
            type ncd:string-all ;

          }

          leaf vlan-id {
            description 'VLAN ID.0 means VLAN is ignorable.' ;
            type uint16 {
              range 0..4094 ;

            }

            ncd:revise-date 2021-08-05 ;
          }

          leaf mac {
            description 'MAC address' ;
            type ncd:mac-address ;

          }

          leaf item-type {
            description 'Item type' ;
            type ncd:string-all ;

          }

          ncd:select vpls-name ;
        }

        ncd:revise-date 2020-05-06 ;
      }

      container mclag-check-items {
        if-feature mclag-consistency-check ;

        description 'Get the permanent ARP information in MC-LAG consistency checking.' ;
        list mclag-check-item {
          description 'Get the permanent ARP information in MC-LAG consistency checking.' ;
          key 'interface-name ip-address' ;
          leaf interface-name {
            description 'The name of the interface.' ;
            type ncd:ifname ;

          }

          leaf ip-address {
            description 'IP Address' ;
            type ncd:ipv4-address ;

          }

          leaf local-mac {
            description 'MAC address of the local permanent ARP item.' ;
            type string ;

          }

          leaf remote-mac {
            description 'MAC address of the remote permanent ARP item.' ;
            type ncd:mac-address ;

          }

        }

        ncd:revise-date 2021-03-04 ;
      }

    }

  }

}
