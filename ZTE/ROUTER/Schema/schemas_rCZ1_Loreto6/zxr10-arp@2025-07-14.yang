          }

          leaf host-route-tag {
            type uint32 {
              range 0..4294967295 {
                description 'From 0 to 4294967295.' ;
              }

            }

            default 0 ;
            description 'Set host route tag.' ;
            if-feature host-route ;

            ncd:revise-date 2023-09-05 ;
          }

          leaf fast-delete-sub-interface-down {
            type enumeration {
              enum enable {
                value 1 ;
                description 'Enable fast-delete sub-interface-down.' ;
              }

              enum disable {
                value 0 ;
                description 'Disable fast-delete sub-interface-down.' ;
              }

            }

            default disable ;
            description 'Set ARP fast-delete function when sub interface is down. Its default value is disable.' ;
