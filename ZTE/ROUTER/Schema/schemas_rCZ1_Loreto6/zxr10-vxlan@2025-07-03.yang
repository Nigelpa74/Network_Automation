                type uint16 {
                  range 0..65535 {
                    description 'Maximum must be in this range.Value 0 means unknow.' ;
                  }

                }

              }

              leaf source-port {
                description 'Source port value.' ;
                type uint16 {
                  range 1..65535 {
                    description 'Maximum must be in this range.(0 is invalid)' ;
                  }

                }

              }

            }

            list udp-rule-with-destination-port {
              description 'Udp protocol rule.' ;
              key 'source-segment destination-segment destination-port' ;
              leaf source-segment {
                description 'Source segment.(0 means unknown)' ;
                type uint16 {
                  range 0..65535 {
                    description 'Maximum must be in this range.Value 0 means unknow.' ;
                  }

                }

              }

              leaf destination-segment {
                description 'Destination segment.(0 means unknown)' ;
                type uint16 {
                  range 0..65535 {
                    description 'Maximum must be in this range.Value 0 means unknow.' ;
                  }

                }

              }

              leaf destination-port {
                description 'Source port value.' ;
                type uint16 {
                  range 1..65535 {
                    description 'Maximum must be in this range.(0 is invalid)' ;
                  }

                }

              }

            }

            list udp-rule-with-both-port {
              description 'Udp protocol rule.' ;
              key 'source-segment destination-segment source-port destination-port' ;
              leaf source-segment {
                description 'Source segment.(0 means unknown)' ;
                type uint16 {
                  range 0..65535 {
                    description 'Maximum must be in this range.Value 0 means unknow.' ;
                  }

                }

              }

              leaf destination-segment {
                description 'Destination segment.(0 means unknown)' ;
                type uint16 {
                  range 0..65535 {
                    description 'Maximum must be in this range.Value 0 means unknow.' ;
                  }

                }

              }

              leaf source-port {
                description 'Source port value.' ;
                type uint16 {
                  range 1..65535 {
                    description 'Maximum must be in this range.(0 is invalid)' ;
                  }

                }

              }

              leaf destination-port {
                description 'Destination port value.' ;
                type uint16 {
                  range 1..65535 {
                    description 'Maximum must be in this range.(0 is invalid)' ;
                  }

                }

              }

            }

            container rule-extend {
              description 'The configuration of rule extend.' ;
              list rule-extend {
                description 'rule extend.' ;
                key rule-id ;
                leaf rule-id {
                  description 'ID of this rule.' ;
                  type uint32 {
                    range 1..65535 ;

                  }

                }

                leaf source-segment {
                  description 'Source segment.(0 means unknown)' ;
                  type uint16 {
                    range 0..65535 ;

                  }

                  mandatory true ;
                }

                leaf destination-segment {
                  description 'Destination segment.(0 means unknown)' ;
                  type uint16 {
                    range 0..65535 ;

                  }

                  mandatory true ;
                }

                choice protocol {
                  description 'protocol type.' ;
                  case common {
                    description 'Common rule.' ;
                    leaf protocol-type {
                      description 'protocol type.' ;
                      mandatory true ;
                      type uint16 {
                        range "0..5|7..16|18..131|133..255" ;

                      }

                    }

                  }

                  case icmp {
                    description 'Icmp protocol rule.' ;
                    leaf icmp-protocol {
                      type empty ;

                      description 'icmp protocol.' ;
                      mandatory true ;
                    }

                    leaf icmp-type {
                      description 'icmp type.' ;
                      mandatory true ;
                      type uint16 {
                        range 0..255 ;

                      }

                    }

                  }

                  case icmpv6 {
                    description 'Icmpv6 protocol rule.' ;
                    leaf icmpv6-protocol {
                      type empty ;

                      description 'icmpv6 protocol.' ;
                      mandatory true ;
                    }

                    leaf icmpv6-type {
                      description 'icmpv6 type.' ;
                      mandatory true ;
                      type uint16 {
                        range 0..255 ;

                      }

                    }

                  }

                  case tcp {
                    description 'Tcp protocol rule.' ;
                    leaf tcp-protocol {
                      type empty ;

                      description 'tcp protocol.' ;
                      mandatory true ;
                    }

                    container tcp-port {
                      description 'port.' ;
                      choice source-port-type {
                        case source-port {
                          leaf source-port {
                            type uint16 {
                              range 1..65535 ;

                            }

                            description 'Source port value.' ;
                            mandatory true ;
                          }

                        }

                        case source-port-range {
                          leaf source-port-range {
                            type ncd:single-range {
                              pattern "(([1-9][0-9]{1,3})|([1-9][0-9]{0,0})|([1-5][0-9]{4,4})|(6[0-4][0-9]{3,3})|(65[0-4][0-9]{2,2})|(655[0-2][0-9]{1,1})|(6553[0-4])|65535)(-(([1-9][0-9]{1,3})|([1-9][0-9]{0,0})|0|([1-5][0-9]{4,4})|(6[0-4][0-9]{3,3})|(65[0-4][0-9]{2,2})|(655[0-2][0-9]{1,1})|(6553[0-4])|65535)){0,1}" ;

                            }

                            description 'Source port range value.' ;
                            mandatory true ;
                          }

                        }

                      }

                      choice destination-port-type {
                        case destination-port {
                          leaf destination-port {
                            type uint16 {
                              range 1..65535 ;

                            }

                            description 'Destination port value.' ;
                            mandatory true ;
                          }

                        }

                        case destination-port-range {
                          leaf destination-port-range {
                            type ncd:single-range {
                              pattern "(([1-9][0-9]{1,3})|([1-9][0-9]{0,0})|([1-5][0-9]{4,4})|(6[0-4][0-9]{3,3})|(65[0-4][0-9]{2,2})|(655[0-2][0-9]{1,1})|(6553[0-4])|65535)(-(([1-9][0-9]{1,3})|([1-9][0-9]{0,0})|0|([1-5][0-9]{4,4})|(6[0-4][0-9]{3,3})|(65[0-4][0-9]{2,2})|(655[0-2][0-9]{1,1})|(6553[0-4])|65535)){0,1}" ;

                            }

                            description 'Destination port range value.' ;
                            mandatory true ;
                          }

                        }

                      }

                    }

                  }

                  case udp {
                    description 'Udp protocol rule.' ;
                    leaf udp-protocol {
                      type empty ;

                      description 'udp protocol.' ;
                      mandatory true ;
                    }

                    container udp-port {
                      description 'port.' ;
                      choice source-port-type {
                        case source-port {
                          leaf source-port {
                            type uint16 {
                              range 1..65535 ;

                            }

                            description 'Source port value.' ;
                            mandatory true ;
                          }

                        }

                        case source-port-range {
                          leaf source-port-range {
                            type ncd:single-range {
                              pattern "(([1-9][0-9]{1,3})|([1-9][0-9]{0,0})|([1-5][0-9]{4,4})|(6[0-4][0-9]{3,3})|(65[0-4][0-9]{2,2})|(655[0-2][0-9]{1,1})|(6553[0-4])|65535)(-(([1-9][0-9]{1,3})|([1-9][0-9]{0,0})|0|([1-5][0-9]{4,4})|(6[0-4][0-9]{3,3})|(65[0-4][0-9]{2,2})|(655[0-2][0-9]{1,1})|(6553[0-4])|65535)){0,1}" ;

                            }

                            description 'Source port range value.' ;
                            mandatory true ;
                          }

                        }

                      }

                      choice destination-port-type {
                        case destination-port {
                          leaf destination-port {
                            type uint16 {
                              range 1..65535 ;

                            }

                            description 'Destination port value.' ;
                            mandatory true ;
                          }

                        }

                        case destination-port-range {
                          leaf destination-port-range {
                            type ncd:single-range {
                              pattern "(([1-9][0-9]{1,3})|([1-9][0-9]{0,0})|([1-5][0-9]{4,4})|(6[0-4][0-9]{3,3})|(65[0-4][0-9]{2,2})|(655[0-2][0-9]{1,1})|(6553[0-4])|65535)(-(([1-9][0-9]{1,3})|([1-9][0-9]{0,0})|0|([1-5][0-9]{4,4})|(6[0-4][0-9]{3,3})|(65[0-4][0-9]{2,2})|(655[0-2][0-9]{1,1})|(6553[0-4])|65535)){0,1}" ;

                            }

                            description 'Destination port range value.' ;
                            mandatory true ;
                          }

                        }

                      }

                    }

                  }

                  case sctp {
                    description 'Sctp protocol rule.' ;
                    leaf sctp-protocol {
                      type empty ;

                      description 'sctp protocol.' ;
                      mandatory true ;
                    }

                    container sctp-port {
                      description 'port.' ;
                      choice source-port-type {
                        case source-port {
                          leaf source-port {
                            type uint16 {
                              range 1..65535 ;

                            }

                            description 'Source port value.' ;
                            mandatory true ;
                          }

                        }

                        case source-port-range {
                          leaf source-port-range {
                            type ncd:single-range {
                              pattern "(([1-9][0-9]{1,3})|([1-9][0-9]{0,0})|([1-5][0-9]{4,4})|(6[0-4][0-9]{3,3})|(65[0-4][0-9]{2,2})|(655[0-2][0-9]{1,1})|(6553[0-4])|65535)(-(([1-9][0-9]{1,3})|([1-9][0-9]{0,0})|0|([1-5][0-9]{4,4})|(6[0-4][0-9]{3,3})|(65[0-4][0-9]{2,2})|(655[0-2][0-9]{1,1})|(6553[0-4])|65535)){0,1}" ;

                            }

                            description 'Source port range value.' ;
                            mandatory true ;
                          }

                        }

                      }

                      choice destination-port-type {
                        case destination-port {
                          leaf destination-port {
                            type uint16 {
                              range 1..65535 ;

                            }

                            description 'Destination port value.' ;
                            mandatory true ;
                          }

                        }

                        case destination-port-range {
                          leaf destination-port-range {
                            type ncd:single-range {
                              pattern "(([1-9][0-9]{1,3})|([1-9][0-9]{0,0})|([1-5][0-9]{4,4})|(6[0-4][0-9]{3,3})|(65[0-4][0-9]{2,2})|(655[0-2][0-9]{1,1})|(6553[0-4])|65535)(-(([1-9][0-9]{1,3})|([1-9][0-9]{0,0})|0|([1-5][0-9]{4,4})|(6[0-4][0-9]{3,3})|(65[0-4][0-9]{2,2})|(655[0-2][0-9]{1,1})|(6553[0-4])|65535)){0,1}" ;

                            }

                            description 'Destination port range value.' ;
                            mandatory true ;
                          }

                        }

                      }

                    }

                  }

                }

              }

              if-feature micro-segment-rule-extend ;

              ncd:revise-date 2024-04-07 ;
            }

          }

        }

        container policy {
          description 'Configure a segment policy.' ;
          list policy-name {
            description 'Policy name.' ;
            key name ;
            leaf name {
              description 'Policy name.' ;
              type ncd:string-with-blank {
                length 1..128 ;

              }

              ncd:revise-date 2023-11-29 ;
            }

            list classifier {
              description 'Set classifier state.' ;
              key classifier-name ;
              leaf classifier-name {
                description 'Classifier name.' ;
                type ncd:string-with-blank {
                  length 1..128 ;

                }

                ncd:revise-date 2023-11-29 ;
              }

              leaf state {
                description 'State.' ;
                type enumeration {
                  enum permit {
                    value 1 ;
                    description 'Permit' ;
                  }

                  enum deny {
                    value 2 ;
                    description 'Deny' ;
                  }

                }

                mandatory true ;
              }

            }

          }

        }

        ncd:revise-date 2022-10-10 ;
      }

    }

  }

  container state {
    description 'Information of VXLAN state.' ;
    config false ;
    container vxlan {
      description 'Information of VXLAN state.' ;
      container vxlan-tunnels {
        description 'Information of VXLAN tunnel.' ;
        list vxlan-tunnel {
          description 'Information of VXLAN tunnel.' ;
          key 'remote-ipv4 local-ipv4' ;
          leaf remote-ipv4 {
            description 'Remote IPv4 address of VXLAN tunnel.' ;
            type ncd:ipv4-address ;

            ncd:revise-date 2016-04-05 ;
          }

          leaf local-ipv4 {
            description 'Local IPv4 address of VXLAN tunnel.' ;
            type ncd:ipv4-address ;

            ncd:revise-date 2016-04-05 ;
          }

          leaf static-tunnel-id {
            description 'Static tunnel ID.' ;
            type uint32 ;

            ncd:revise-date 2016-04-20 ;
          }

          leaf evpn-tunnel-id {
            description 'EVPN tunnel ID.' ;
            type uint32 ;

            ncd:revise-date 2016-04-05 ;
          }

          container statistics {
            description 'Tunnel statistics.' ;
            container tunnel-statistics {
              description 'Total tunnel statistics.' ;
              leaf in-bytes {
                description 'Total bytes received.' ;
                type string {
                  length 1..24 ;

                }

              }

              leaf out-bytes {
                description 'Total bytes sent.' ;
                type string {
                  length 1..24 ;

                }

              }

              leaf in-packets {
                description 'Total packets received.' ;
                type string {
                  length 1..24 ;

                }

              }

              leaf out-packets {
                description 'Total packets sent.' ;
                type string {
                  length 1..24 ;

                }

              }

              leaf in-rate-bps {
                description '120s-bytes-rate received.' ;
                type uint64 ;

                ncd:revise-date 2017-01-10 ;
              }

              leaf out-rate-bps {
                description '120s-bytes-rate sent.' ;
                type uint64 ;

                ncd:revise-date 2017-01-10 ;
              }

              leaf in-rate-pps {
                description '120s-packets-rate received.' ;
                type uint64 ;

                ncd:revise-date 2017-01-10 ;
              }

              leaf out-rate-pps {
                description '120s-packets-rate sent.' ;
                type uint64 ;

                ncd:revise-date 2017-01-10 ;
              }

            }

            container tunnel-vni-statistics {
              description 'Statistics in VXLAN tunnel.' ;
              list tunnel-vni-statistic {
                description 'Statistics in VXLAN tunnel.' ;
                key vxlan-id ;
                leaf vxlan-id {
                  description 'The VXLAN in tunnel.' ;
                  type uint32 {
                    range 1..16777215 {
                      description 'The value of VXLAN,it must be between 1 to 16777215.' ;
                    }

                  }

                }

                leaf in-bytes {
                  description 'Total bytes received.' ;
                  type string {
                    length 1..24 ;

                  }

                }

                leaf out-bytes {
                  description 'Total bytes sent.' ;
                  type string {
                    length 1..24 ;

                  }

                }

                leaf in-packets {
                  description 'Total packets received.' ;
                  type string {
                    length 1..24 ;

                  }

                }

                leaf out-packets {
                  description 'Total packets sent.' ;
                  type string {
                    length 1..24 ;

                  }

                }

                leaf in-rate-bps {
                  description '120s-bytes-rate received.' ;
                  type uint64 ;

                  ncd:revise-date 2017-01-10 ;
                }

                leaf out-rate-bps {
                  description '120s-bytes-rate sent.' ;
                  type uint64 ;

                  ncd:revise-date 2017-01-10 ;
                }

                leaf in-rate-pps {
                  description '120s-packets-rate received.' ;
                  type uint64 ;

                  ncd:revise-date 2017-01-10 ;
                }

                leaf out-rate-pps {
                  description '120s-packets-rate sent.' ;
                  type uint64 ;

                  ncd:revise-date 2017-01-10 ;
                }

              }

            }

            ncd:revise-date 2016-04-20 ;
          }

          ncd:select "remote-ipv4 local-ipv4" ;
          ncd:select evpn-tunnel-id ;
        }

        list vxlan-tunnel-ipv6 {
          description 'Information of VXLAN tunnel(IPv6).' ;
          key 'remote-ipv6 local-ipv6' ;
          leaf remote-ipv6 {
            description 'Remote IPv6 address of VXLAN tunnel.' ;
            type ncd:ipv6-address ;

          }

          leaf local-ipv6 {
            description 'Local IPv6 address of VXLAN tunnel.' ;
            type ncd:ipv6-address ;

          }

          leaf static-tunnel-id {
            description 'Static tunnel ID.' ;
            type uint32 ;

          }

          leaf evpn-tunnel-id {
            description 'EVPN tunnel ID.' ;
            type uint32 ;

          }

          container statistics {
            description 'Tunnel(IPv6) statistics.' ;
            container tunnel-ipv6-statistics {
              description 'Total IPv6 tunnel statistics.' ;
              leaf in-bytes {
                description 'Total bytes received.' ;
                type string {
                  length 1..24 ;

                }

              }

              leaf out-bytes {
                description 'Total bytes sent.' ;
                type string {
                  length 1..24 ;

                }

              }

              leaf in-packets {
                description 'Total packets received.' ;
                type string {
                  length 1..24 ;

                }

              }

              leaf out-packets {
                description 'Total packets sent.' ;
                type string {
                  length 1..24 ;

                }

              }

              leaf in-rate-bps {
                description '120s-bytes-rate received.' ;
                type uint64 ;

              }

              leaf out-rate-bps {
                description '120s-bytes-rate sent.' ;
                type uint64 ;

              }

              leaf in-rate-pps {
                description '120s-packets-rate received.' ;
                type uint64 ;

              }

              leaf out-rate-pps {
                description '120s-packets-rate sent.' ;
                type uint64 ;

              }

            }

            container tunnel-ipv6-vni-statistics {
              description 'Statistics in VXLAN IPv6 tunnel.' ;
              list tunnel-ipv6-vni-statistic {
                description 'Statistics in VXLAN IPv6 tunnel.' ;
                key vxlan-id ;
                leaf vxlan-id {
                  description 'The VXLAN in tunnel.' ;
                  type uint32 {
                    range 1..16777215 {
                      description 'The value of VXLAN,it must be between 1 to 16777215.' ;
                    }

                  }

                }

                leaf in-bytes {
                  description 'Total bytes received.' ;
                  type string {
                    length 1..24 ;

                  }

                }

                leaf out-bytes {
                  description 'Total bytes sent.' ;
                  type string {
                    length 1..24 ;

                  }

                }

                leaf in-packets {
                  description 'Total packets received.' ;
                  type string {
                    length 1..24 ;

                  }

                }

                leaf out-packets {
                  description 'Total packets sent.' ;
                  type string {
                    length 1..24 ;

                  }

                }

                leaf in-rate-bps {
                  description '120s-bytes-rate received.' ;
                  type uint64 ;

                }

                leaf out-rate-bps {
                  description '120s-bytes-rate sent.' ;
                  type uint64 ;

                }

                leaf in-rate-pps {
                  description '120s-packets-rate received.' ;
                  type uint64 ;

                }

                leaf out-rate-pps {
                  description '120s-packets-rate sent.' ;
                  type uint64 ;

                }

              }

            }

            ncd:revise-date 2018-11-29 ;
          }

          ncd:revise-date 2018-02-06 ;
          ncd:select "remote-ipv6 local-ipv6" ;
          ncd:select evpn-tunnel-id ;
        }

      }

      container vxlan-statistics {
        description 'Statistics in VXLAN.' ;
        list vxlan-statistic {
          description 'Statistic in VXLAN.' ;
          key vxlan-id ;
          leaf vxlan-id {
            description 'VXLAN Network Identifier' ;
            type uint32 {
              range 1..16777215 {
                description 'The value of VXLAN,it must be between 1 to 16777215.' ;
              }

            }

          }

          leaf in-bytes {
            description 'Total bytes received.' ;
            type string ;

          }

          leaf out-bytes {
            description 'Total bytes sent.' ;
            type string ;

          }

          leaf in-packets {
            description 'Total packets received.' ;
            type string ;

          }

          leaf out-packets {
            description 'Total packets sent.' ;
            type string ;

          }

          leaf in-rate-bps {
            description '120s-bytes-rate received.' ;
            type uint64 ;

          }

          leaf out-rate-bps {
            description '120s-bytes-rate sent.' ;
            type uint64 ;

          }

          leaf in-rate-pps {
            description '120s-packets-rate received.' ;
            type uint64 ;

          }

          leaf out-rate-pps {
            description '120s-packets-rate sent.' ;
            type uint64 ;

          }

        }

        ncd:revise-date 2018-11-05 ;
      }

    }

    ncd:revise-date 2016-01-08 ;
  }

  container operation {
    description 'Operation of VXLAN.' ;
    config false ;
    container vxlan {
      description 'Operation of VXLAN.' ;
      container clear-vxlan-tunnel-statistics {
        description 'Clear statistics of VXLAN tunnel.' ;
        list vxlan-tunnel-statistics {
          description 'Clear statistics of VXLAN tunnel.' ;
          key 'local-ipv4 remote-ipv4' ;
          leaf local-ipv4 {
            description 'Local IP address.' ;
            type ncd:ipv4-address ;

          }

          leaf remote-ipv4 {
            description 'Remote IP address.' ;
            type ncd:ipv4-address ;

          }

          leaf vxlan-id {
            description 'The VXLAN in tunnel.' ;
            type uint32 {
              range 1..16777215 {
                description 'Range of VXLAN ID.' ;
              }

            }

          }

        }

        list vxlan-tunnel-ipv6-statistics {
          description 'Clear statistics of VXLAN tunnel(IPv6).' ;
          key 'local-ipv6 remote-ipv6' ;
          leaf local-ipv6 {
            description 'Local IPv6 address.' ;
            type ncd:ipv6-address ;

          }

          leaf remote-ipv6 {
            description 'Remote IPv6 address.' ;
            type ncd:ipv6-address ;

          }

          leaf vxlan-id {
            description 'The VXLAN in tunnel.' ;
            type uint32 {
              range 1..16777215 {
                description 'Range of VXLAN ID.' ;
              }

            }

          }

          ncd:revise-date 2018-11-29 ;
        }

        list vxlan-statistics {
          description 'Clear statistics of VXLAN.' ;
          key vxlan-id ;
          leaf vxlan-id {
            description 'VXLAN Network Identifier' ;
            type uint32 {
              range 1..16777215 {
                description 'Range of VXLAN ID.' ;
              }

            }

          }

          ncd:revise-date 2018-11-05 ;
        }

      }

    }

    ncd:revise-date 2016-04-20 ;
  }

}
