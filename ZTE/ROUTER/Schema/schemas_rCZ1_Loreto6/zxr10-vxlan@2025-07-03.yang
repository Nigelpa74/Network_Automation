module zxr10-vxlan {
  namespace "http://www.zte.com.cn/zxr10/netconf/schema/rosng/vxlan" ;
  prefix vxlan ;
  import zxr10-netconf-defs {
    prefix ncd ;
  }

  organization "ZTE Corporation" ;
  contact "ZTE Corporation
  Nanjing Institute of ZTE Corporation
  No.68 Zijinghua Rd. Yuhuatai District, Nanjing, China
  Tel: +86-25-52870000" ;
  description 'The netconf module to describe VXLAN.' ;
  revision 2025-07-03 {
    description '1.The node range is changed from 0-128 to 1-128,/vxlan:configuration/vxlan:vxlan/vxlan:micro-segment/vxlan:segment-id/vxlan:segment-id/vxlan:ipv6-configuration/vxlan:mask-len
2.The node range is changed from 0-128 to 1-128,/vxlan:configuration/vxlan:vxlan/vxlan:micro-segment/vxlan:segment-id/vxlan:segment-id/vxlan:ipv6-configuration-with-vrf/vxlan:mask-len' ;
  }

  revision 2024-09-02 {
    description '1.Obsolete a container /vxlan:configuration/vxlan:vxlan/vxlan:mac-floodings.
2.Obsolete a container /vxlan:configuration/vxlan:vxlan/vxlan:vxlan-instances.
3.Obsolete a container /vxlan:configuration/vxlan:vxlan/vxlan:vtep-instances.
4.Obsolete a container /vxlan:configuration/vxlan:vxlan/vxlan:vtep-binds.
5.Obsolete a container /vxlan:configuration/vxlan:vxlan/vxlan:static-tunnel-binds.
6.Obsolete a container /vxlan:configuration/vxlan:vxlan/vxlan:redundancy-group-binds.' ;
  }

  revision 2024-08-27 {
    description '1.The node not support IPv6 link local,/vxlan:configuration/vxlan:vxlan/vxlan:nve-instances/vxlan:nve-instance-v6/vxlan:source-vtep-ipv6.' ;
  }

  revision 2024-04-07 {
    description '1.Add a new container rule-extend on /vxlan:configuration/vxlan:vxlan/vxlan:micro-segment/vxlan:classifier/vxlan:classifier-name;' ;
  }

  revision 2023-12-14 {
    description '1.Add a new list nve-mac on zxr10-vxlan\configuration\vxlan\nve-instances;' ;
  }

  revision 2023-11-29 {
    description '1.Change the node length to 128, /vxlan:configuration/vxlan:vxlan/vxlan:micro-segment/vxlan:segment-id/vxlan:segment-id/vxlan:segment-name.
2.Change the node length to 128, /vxlan:configuration/vxlan:vxlan/vxlan:micro-segment/vxlan:classifier/vxlan:classifier-name/vxlan:name.
3.Change the node length to 128, /vxlan:configuration/vxlan:vxlan/vxlan:micro-segment/vxlan:policy/vxlan:policy-name/vxlan:name.' ;
  }

  revision 2023-06-19 {
    description '1.Add a new list icmpv6-rule-with-type on zxr10-vxlan\configuration\vxlan\micro-segment\classifier\classifier-name;' ;
  }

  revision 2023-04-24 {
    description '1.Add a new container vni-v6-multicasts on zxr10-vxlan\configuration\vxlan\vni-instances\vni-instance;
2.Add a new list nve-instances-v6 on zxr10-vxlan\configuration\vxlan\nve-instances;' ;
  }

  revision 2023-03-10 {
    description '1.Change the length of node /vxlan:configuration/vxlan:vxlan/vxlan:micro-segment/vxlan:segment-id/vxlan:segment-id/vxlan:segment-name.
2.Change the length of node /vxlan:configuration/vxlan:vxlan/vxlan:micro-segment/vxlan:classifier/vxlan:classifier-name/vxlan:name.
3.Change the length of node /vxlan:configuration/vxlan:vxlan/vxlan:micro-segment/vxlan:policy/vxlan:policy-name/vxlan:name.' ;
  }

  revision 2022-10-10 {
    description '1.Add a new containor micro-segment on zxr10-vxlan\configuration\vxlan;' ;
  }

  revision 2020-04-09 {
    description '1.Add a new select evpn-tunnel-id on zxr10-vxlan\state\vxlan\vxlan-tunnels;' ;
  }

  revision 2019-11-19 {
    description '1.Add a new container vni-instances on zxr10-vxlan\configuration\vxlan;
2.Add a new container nve-instances on zxr10-vxlan\configuration\vxlan;' ;
  }

  revision 2018-11-29 {
    description '1.Add a new list tunnel-ipv6-statistics-config on zxr10-vxlan\configuration\vxlan\tunnel-statistics-configs;
2.Add a new list tunnel-ipv6-vni-statistics-config on zxr10-vxlan\configuration\vxlan\tunnel-statistics-configs;
3.Add a new container statistics on zxr10-vxlan\state\vxlan\vxlan-tunnels\vxlan-tunnel-ipv6;
4.Add a new list vxlan-tunnel-ipv6-statistics on zxr10-vxlan\operation\vxlan\clear-vxlan-tunnel-statistics.' ;
  }

  revision 2018-11-05 {
    description '1.Add a new list vni-statistics-config on zxr10-vxlan\configuration\vxlan\tunnel-statistics-configs;
2.Add a new container vxlan-statistics on zxr10-vxlan\state\vxlan;
3.Add a new list vxlan-statistics on zxr10-vxlan\operation\vxlan\clear-vxlan-tunnel-statistics.' ;
  }

  revision 2018-02-06 {
    description '1.Add a new list node of vxlan-tunnel-ipv6 on zxr10-vxlan\state\vxlan\vxlan-tunnels.' ;
  }

  revision 2017-11-15 {
    description '1.Delete SWITCH & C600 labels in feature mac-flooding;
2.Delete SWITCH & C600 labels in feature vxlan-instance-mode;
3.Delete SWITCH & C600 labels in feature static-tunnel;
4.Delete SWITCH & C600 labels in feature redundancy-group-bind;
5.Delete SWITCH & C600 labels in feature vtep-bind;
6.Delete SWITCH & C600 labels in feature move-dampening.' ;
  }

  revision 2017-09-20 {
    description '1.Add a new container node of move-dampening-policy on zxr10-vxlan\configuration\vxlan\vxlan-instances\vxlan-instance;
2.The feature of move-dampening is defined.' ;
  }

  revision 2017-09-15 {
    description '1.The feature of vtep-bind is defined.
2.The feature of vtep-instance-mode is validated to 15K and T8K. 
3.All features in the yang of revison 2017-9-15 are validated to 89 and 89-GM.' ;
  }

  revision 2017-05-04 {
    description '1.Add a new container node of mac-policy on zxr10-vxlan\configuration\vxlan\vxlan-instances\vxlan-instance;
2.Add a leaf node of evpn-remote-mac-learning on zxr10-vxlan\configuration\vxlan\vxlan-instances\vxlan-instance\mac-policy;
3.Add a leaf node of local-mac-learning on zxr10-vxlan\configuration\vxlan\vxlan-instances\vxlan-instance\mac-policy;
4.Add a leaf node of evpn-remote-mac-receiving on zxr10-vxlan\configuration\vxlan\vxlan-instances\vxlan-instance\mac-policy;
5.Add a leaf node of evpn-local-mac-advertising on zxr10-vxlan\configuration\vxlan\vxlan-instances\vxlan-instance\mac-policy;' ;
  }

  revision 2017-03-30 {
    description '1.Add a new choice of ingress-adjust on zxr10-vxlan\configuration\vxlan\vxlan-instances\vxlan-instance\vxlan-map-tables\vxlan-map-l2interface;
2.delete a leaf node of ingress-adjust-tag-as-payload on zxr10-vxlan\configuration\vxlan\vxlan-instances\vxlan-instance\vxlan-map-tables\vxlan-map-l2interface;' ;
  }

  revision 2017-01-16 {
    description '1.Add a leaf node /vxlan:configuration/vxlan:vxlan/vxlan:vxlan-instances/vxlan:vxlan-instance/vxlan:vxlan-route-targets/vxlan:vxlan-route-target/vxlan:split-horizon-group.' ;
  }

  revision 2017-01-10 {
    description '1.Add four new leaves on vxlan:state/vxlan:vxlan/vxlan:vxlan-tunnels/vxlan:vxlan-tunnel/vxlan:statistics/vxlan:tunnel-statistics/
2.Add four new leaves on vxlan:state/vxlan:vxlan/vxlan:vxlan-tunnels/vxlan:vxlan-tunnel/vxlan:statistics/vxlan:tunnel-vni-statistics/vxlan:tunnel-vni-statistic/' ;
  }

  revision 2016-08-18 {
    description '1.Delete the container node of map-l2interace on zxr10-vxlan\configuration\vxlan\vxlan-instances\vxlan-instance\vxlan-map-tables\vxlan-map-l2interface;
2.Add a new list node of map-l2interace on zxr10-vxlan\configuration\vxlan\vxlan-instances\vxlan-instance\vxlan-map-tables\vxlan-map-l2interface;' ;
  }

  revision 2016-07-05 {
    description "(1)Add feature node mac-flooding, VXLAN-instance-mode, vtep-instance-mode, static-tunnel, redundancy-group-bind.
    (2)Add feature attribute mac-flooding on container 'configuration/vxlan/mac-floodings'.
    (3)Add feature attribute VXLAN-instance-mode on container 'configuration/vxlan/vxlan-instances'.
    (4)Add feature attribute vtep-instance-mode on container 'configuration/vxlan/vtep-instances' and 'configuration/vxlan/vtep-binds'.
    (5)Add feature attribute static-tunnel on container 'configuration/vxlan/static-tunnel-binds'.
    (6)Add feature attribute redundancy-group-bind on container 'configuration/vxlan/redundancy-group-binds'." ;
  }

  revision 2016-04-26 {
    description '1.Add range of /vxlan:state/vxlan:vxlan/vxlan:vxlan-tunnels/vxlan:vxlan-tunnel/vxlan:statistics/vxlan:tunnel-vni-statistics/vxlan:tunnel-vni-statistic/vxlan:vxlan-id.
2.Change range of /vxlan:state/vxlan:vxlan/vxlan:vxlan-tunnels/vxlan:vxlan-tunnel/vxlan:statistics/vxlan:tunnel-statistics/vxlan:in-bytes,/vxlan:state/vxlan:vxlan/vxlan:vxlan-tunnels/vxlan:vxlan-tunnel/vxlan:statistics/vxlan:tunnel-statistics/vxlan:out-bytes,/vxlan:state/vxlan:vxlan/vxlan:vxlan-tunnels/vxlan:vxlan-tunnel/vxlan:statistics/vxlan:tunnel-statistics/vxlan:in-packets and /vxlan:state/vxlan:vxlan/vxlan:vxlan-tunnels/vxlan:vxlan-tunnel/vxlan:statistics/vxlan:tunnel-statistics/vxlan:out-packets.' ;
  }

  revision 2016-04-20 {
    description '1.Add a new container on zxr10-vxlan\configuration\vxlan\static-tunnel-binds;
2.Add a new container on zxr10-vxlan\configuration\vxlan\tunnel-statistics-configs;
3.Add a new container on zxr10-vxlan\configuration\vxlan\redundancy-group-binds;
4.Add a new leaf on zxr10-vxlan\state\vxlan\vxlan-tunnels\vxlan-tunnel\static-tunnel-id;
5.Add a new container on zxr10-vxlan\state\vxlan\vxlan-tunnels\vxlan-tunnel\statistics;
6.Add a new container on zxr10-vxlan\operation.' ;
  }

  revision 2016-04-05 {
    description '1.Delete the node /vxlan:state/vxlan:vxlan/vxlan:vxlan-tunnels/vxlan:vxlan-tunnel/vxlan:tunnel-type.
2.Change the name of node /vxlan:state/vxlan:vxlan/vxlan:vxlan-tunnels/vxlan:vxlan-tunnel/vxlan:destination-ip to /vxlan:state/vxlan:vxlan/vxlan:vxlan-tunnels/vxlan:vxlan-tunnel/vxlan:remote-ipv4.
3.Change the name of node /vxlan:state/vxlan:vxlan/vxlan:vxlan-tunnels/vxlan:vxlan-tunnel/vxlan:source-ip to /vxlan:state/vxlan:vxlan/vxlan:vxlan-tunnels/vxlan:vxlan-tunnel/vxlan:local-ipv4.
4.Change the name of node /vxlan:state/vxlan:vxlan/vxlan:vxlan-tunnels/vxlan:vxlan-tunnel/vxlan:tunnel-id to /vxlan:state/vxlan:vxlan/vxlan:vxlan-tunnels/vxlan:vxlan-tunnel/vxlan:evpn-tunnel-id.' ;
  }

  revision 2016-03-16 {
    description '1.Change the name of node /vxlan:configuration/vxlan:vxlan/vxlan:vxlan-instances/vxlan:vxlan-instance/vxlan:vxlan-route-targets/vxlan:vxlan-route-target/vxlan:rd to rt-value,change the description of this node.' ;
  }

  revision 2016-01-08 {
    description '1.Add container /vxlan:configuration/vxlan:vxlan/vxlan:mac-floodings.
2.Add leaf /vxlan:configuration/vxlan:vxlan/vxlan:vxlan-instances/vxlan:vxlan-instance/vxlan:description.
3.Add leaf /vxlan:configuration/vxlan:vxlan/vxlan:vxlan-instances/vxlan:vxlan-instance/vxlan:unknow-unicast-drop.
4.Add leaf /vxlan:configuration/vxlan:vxlan/vxlan:vxlan-instances/vxlan:vxlan-instance/vxlan:filter-vrrp.
5.Add container /vxlan:configuration/vxlan:vxlan/vxlan:vxlan-instances/vxlan:vxlan-instance/vxlan:vxlan-rd.
6.Add container /vxlan:configuration/vxlan:vxlan/vxlan:vxlan-instances/vxlan:vxlan-instance/vxlan:vxlan-route-targets.
7.Add container /vxlan:state.
8.Obsolete container /vxlan:configuration/vxlan:vxlan/vxlan:vxlan-instances/vxlan:vxlan-instance/vxlan:vxlan-multicast-ip.
9.Obsolete container /vxlan:configuration/vxlan:vxlan/vxlan:vxlan-instances/vxlan:vxlan-instance/vxlan:vxlan-multicast-ipv6.' ;
  }

  revision 2015-11-25 {
    description 'Add container /vxlan:configuration/vxlan:vxlan/vxlan:vxlan-instances/vxlan:vxlan-instance/vxlan:vxlan-multicast-ipv6.' ;
  }

  revision 2014-09-16 {
    description 'Initial version.' ;
  }

  feature mac-flooding {
    description 'This node is used to distinguish whether the MAC flooding function can be enabled.' ;
  }

  feature vxlan-instance-mode {
    description 'This node is used to distinguish whether the VXLAN instance mode can be enabled.' ;
  }

  feature vtep-instance-mode {
    description 'This node is used to distinguish whether the vtep instance mode can be enabled.' ;
  }

  feature static-tunnel {
    description 'This node is used to distinguish whether static tunnel function can be enabled.' ;
  }

  feature redundancy-group-bind {
    description 'This node is used to distinguish whether redundancy group bind table function can be enabled.' ;
  }

  feature vtep-bind {
    description 'This node is used to distinguish whether the vtep bind can be enabled.' ;
  }

  feature move-dampening {
    description 'This node is used to distinguish whether the move dampening policy can be enabled.' ;
  }

  feature vxlan-micro-segment {
    description 'This node is used to distinguish whether the micro-segment function can be enabled.' ;
    ncd:revise-date 2022-10-10 ;
  }

  feature micro-segment-rule-extend {
    description 'This node is used to distinguish whether the micro-segment rule-extend function can be enabled.' ;
    ncd:revise-date 2024-04-07 ;
  }

  container configuration {
    description 'Configuration model info.' ;
    container vxlan {
      description 'Configure VXLAN parameters.' ;
      container global-config {
        description 'Global enable configuration of VXLAN.' ;
        presence global-config ;
        leaf global-enable {
          description 'VXLAN global enble.' ;
          type empty ;

          mandatory true ;
        }

      }

      container mac-floodings {
        if-feature mac-flooding ;

        description 'Configuration of MAC flooding.' ;
        status obsolete {
          ncd:revise-date 2024-09-02 ;
        }

        list mac-flooding {
          description 'Configuration of MAC flooding.' ;
          key 'mac-address vlan-id' ;
          leaf mac-address {
            description 'Specific MAC address of MAC flooding.' ;
            type ncd:mac-address ;

            status obsolete ;

          }

          leaf vlan-id {
            description 'VLAN ID of MAC flooding.' ;
            type uint16 {
              range 1..4094 {
                description 'The value of VLAN,it must be between 1 to 4094.' ;
              }

            }

            status obsolete ;

          }

          status obsolete ;

        }

        ncd:revise-date 2016-01-08 ;
      }

      container vxlan-instances {
        if-feature vxlan-instance-mode ;

        description 'Configuration of VXLAN instances.' ;
        status obsolete {
          ncd:revise-date 2024-09-02 ;
        }

        list vxlan-instance {
          description 'Configuration of VXLAN instance.' ;
          key vxlan-id ;
          leaf vxlan-id {
            description 'VXLAN ID of VXLAN instance.' ;
            type uint32 {
              range 1..16777215 {
                description 'The value of VXLAN,it must be between 1 to 16777215.' ;
              }

            }

            status obsolete ;

          }

          leaf description {
            description 'The description information of VXLAN instance.' ;
            type string {
              length 0..64 {
                description 'VXLAN instance description information.' ;
              }

            }

            default '' ;
            status obsolete ;

            ncd:revise-date 2016-01-08 ;
          }

          leaf unknow-unicast-drop {
            description 'Unknow unicast drop configuration of VXLAN instance.' ;
            type enumeration {
              enum enable {
                value 1 ;
                description 'Unknown unicast drop enable.' ;
              }

              enum disable {
                value 2 ;
                description 'Unknown unicast drop disable.' ;
              }

            }

            default enable ;
            status obsolete ;

            ncd:revise-date 2016-01-08 ;
          }

          leaf filter-vrrp {
            description 'VRRP packets filter configuration of VXLAN instance.' ;
            type enumeration {
              enum enable {
                value 1 ;
                description 'VRRP packets filter.' ;
              }

              enum disable {
                value 2 ;
                description 'VRRP packets not filter.' ;
              }

            }

            default enable ;
            status obsolete ;

            ncd:revise-date 2016-01-08 ;
          }

          container vxlan-multicast-ip {
            description 'VXLAN multicast IP address.' ;
            status obsolete {
              ncd:revise-date 2016-01-08 ;
            }

            presence vxlan-multicast-ip ;
            leaf multicast-ip {
              description 'VXLAN multicast IP address.' ;
              status obsolete {
                ncd:revise-date 2016-01-08 ;
              }

              type ncd:ipv4-address ;

              mandatory true ;
            }

          }

          container vxlan-multicast-ipv6 {
            description 'VXLAN multicast IPv6 address.' ;
            status obsolete {
              ncd:revise-date 2016-01-08 ;
            }

            presence vxlan-multicast-ipv6 ;
            leaf multicast-ipv6 {
              description 'VXLAN multicast IPv6 address.' ;
              status obsolete {
                ncd:revise-date 2016-01-08 ;
              }

              type ncd:ipv6-address ;

              mandatory true ;
            }

            ncd:revise-date 2015-11-25 ;
          }

          container vxlan-map-tables {
            description 'VXLAN map tables.' ;
            presence vxlan-map-tables ;
            choice vxlan-map-types {
              description 'VXLAN map type choice.' ;
              case vxlan-map-vlan {
                description 'VXLAN map VLAN.' ;
                leaf map-type-vlan {
                  description 'VXLAN map VLAN.' ;
                  type enumeration {
                    enum map-type-vlan1to1 {
                      value 1 ;
                      description 'Map type VLAN1:1.' ;
                    }

                    enum map-type-vlan1ton {
                      value 2 ;
                      description 'Map type VLAN1:n.' ;
                    }

                  }

                  default map-type-vlan1to1 ;
                }

                list map-vlan {
                  description 'VXLAN map VLAN.' ;
                  key vlan-id ;
                  leaf vlan-id {
                    description 'VLAN ID.' ;
                    type uint16 {
                      range 1..4094 {
                        description 'The value of VLAN,it must be between 1 to 4094.' ;
                      }

                    }

                  }

                }

              }

              case vxlan-map-mac {
                description 'VXLAN map MAC.' ;
                leaf map-type-mac {
                  description 'VXLAN map MAC.' ;
                  type empty ;

                }

                container map-mac {
                  description 'VXLAN map MAC.' ;
                  presence map-mac ;
                  leaf mac {
                    description 'MAC address.' ;
                    type ncd:mac-address ;

                    mandatory true ;
                  }

                }

              }

              case vxlan-map-l2interface {
                description 'VXLAN map L2 interface.' ;
                leaf map-type-l2interface {
                  description 'VXLAN map L2 interface.' ;
                  type empty ;

                }

                list map-l2interface {
                  description 'VXLAN map L2 interface.' ;
                  key interface-name ;
                  leaf interface-name {
                    description 'L2 interface name.' ;
                    type ncd:ifname ;

                  }

                  leaf ingress-adjust-tag-as-payload {
                    description 'The ingress tag as payload flag of the ethernet parameter.' ;
                    status obsolete {
                      ncd:revise-date 2017-03-30 ;
                    }

                    type enumeration {
                      enum default {
                        value 0 ;
                        description 'Sub-interface means pTag. The others means uTag.' ;
                      }

                      enum all {
                        value 1 ;
                        description 'The ingress tag as payload flag is from outer most.' ;
                      }

                      enum from-sublayer {
                        value 2 ;
                        description 'The ingress tag as payload flag is from sub layer.' ;
                      }

                    }

                    default default ;
                  }

                  choice ingress-adjust {
                    description 'Configure ingress-adjustment operation' ;
                    case tag-as-payload {
                      description 'The ingress tag as payload flag of the ethernet parameter.' ;
                      leaf tag-as-payload {
                        description 'The ingress tag as payload flag of the ethernet parameter.' ;
                        type enumeration {
                          enum default {
                            value 0 ;
                            description 'Sub-interface means pTag. The others means uTag.' ;
                          }

                          enum all {
                            value 1 ;
                            description 'The ingress tag as payload flag is from outer most.' ;
                          }

                          enum from-sublayer {
                            value 2 ;
                            description 'The ingress tag as payload flag is from sub layer.' ;
                          }

                        }

                        default default ;
                      }

                    }

                    ncd:revise-date 2017-03-30 ;
                  }

                  ncd:revise-date 2016-08-18 ;
                }

              }

              case vxlan-map-l3interface {
                description 'VXLAN map L3 interface.' ;
                leaf map-type-l3interface {
                  description 'VXLAN map L3 interface.' ;
                  type empty ;

                }

                list map-l3interface {
                  description 'VXLAN map L3 interface.' ;
                  key interface-name ;
                  leaf interface-name {
                    description 'L3 interface name.' ;
                    type ncd:ifname {
                      length 1..31 {
                        description 'The length of interface name must be between 1 to 31.' ;
                      }

                    }

                  }

                }

              }

            }

            status obsolete ;

          }

          container vxlan-rd {
            description 'Information of route distinguisher.' ;
            presence vxlan-rd ;
            leaf rd {
              description 'The route distinguisher parameter.' ;
              type union {
                type ncd:asn-nn ;

                type ncd:ipadd-nn ;

              }

              mandatory true ;
              status obsolete ;

            }

            status obsolete ;

            ncd:revise-date 2016-01-08 ;
          }

          container vxlan-route-targets {
            description 'The configuration of route target.' ;
            presence vxlan-route-targets ;
            list vxlan-route-target {
              description 'The configuration of route target.' ;
              key 'effect-type rt-value' ;
              leaf effect-type {
                description 'The effect type of route target.' ;
                type enumeration {
                  enum export {
                    value 2 ;
                    description 'The route target effect type is export.' ;
                  }

                  enum import {
                    value 3 ;
                    description 'The route target effect type is import.' ;
                  }

                }

                status obsolete ;

              }

              leaf rt-value {
                description 'The value of RT attribution.' ;
                type union {
                  type ncd:asn-nn ;

                  type ncd:ipadd-nn ;

                }

                status obsolete ;

                ncd:revise-date 2016-03-16 ;
              }

              leaf split-horizon-group {
                description 'Split-horizon group,the range is A-Z.' ;
                type string ;

                status obsolete ;

                ncd:revise-date 2017-01-16 ;
              }

              status obsolete ;

            }

            status obsolete ;

            ncd:revise-date 2016-01-08 ;
          }

          container mac-policy {
            description 'Information of MAC learning policy.' ;
            presence mac-policy ;
            leaf evpn-remote-mac-learning {
              description 'Remote MAC of EVPN tunnel learning enable.' ;
              type enumeration {
                enum enable {
                  value 1 ;
                  description 'Enable' ;
                }

                enum disable {
                  value 2 ;
                  description 'Disable' ;
                }

              }

              default enable ;
              status obsolete ;

            }

            leaf evpn-remote-mac-receiving {
              description 'Remote EVPN tunnel advertise MAC receiving enable.' ;
              type enumeration {
                enum enable {
                  value 1 ;
                  description 'Enable' ;
                }

                enum disable {
                  value 2 ;
                  description 'Disable' ;
                }

              }

              default enable ;
              status obsolete ;

            }

            leaf evpn-local-mac-advertising {
              description 'EVPN local MAC advertising enable.' ;
              type enumeration {
                enum enable {
                  value 1 ;
                }

                enum disable {
                  value 2 ;
                }

              }

              default enable ;
              status obsolete ;

            }

            leaf local-mac-learning {
              description 'Local MAC learning enable of VXLAN instance.' ;
              type enumeration {
                enum enable {
                  value 1 ;
                  description 'Enable' ;
                }

                enum disable {
                  value 2 ;
                  description 'Disable' ;
                }

              }

              default enable ;
              status obsolete ;

            }

            status obsolete ;

            ncd:revise-date 2017-05-04 ;
          }

          container move-dampening-policy {
            description 'The detector of MAC/IP routing drift.' ;
            leaf move-dampening {
