              description 'AIM Diameter accounting group configure.' ;
              type string {
                length 1..32 {
                  description 'WORD  Diameter group name (1-32 characters)' ;
                }

              }

            }

          }

          container accounting-radius-group {
            description 'AIM accounting RADIUS group configure.' ;
            presence accounting-radius-group ;
