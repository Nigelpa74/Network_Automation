      container security-template {
        list security-template {
          description 'AIM security template configuration list.' ;
          max-elements 2000 ;
          key security-name ;
          leaf security-name {
            description 'Aim security template name configure.' ;
            type string {
              length 1..31 {
                description 'WORD  Security template name (1-31 characters)' ;
              }

            }

          }

          leaf ipv6-urpf-check {
            description 'Set v6 user check urpf function' ;
            type enumeration {
              enum disable {
                value 1 ;
                description 'Turn off the URPF check of IPv6' ;
              }

              enum enable {
                value 0 ;
                description 'Turn on the URPF check of IPv6' ;
              }

            }

            default disable ;
          }

          choice urpf-check {
            case disable {
              leaf urpf-check-disable {
                description 'Close ipv4 urpf-checkout switch.' ;
                type enumeration {
                  enum disable {
                    value 1 ;
                    description 'Close ipv4 urpf-checkout switch.' ;
                  }

                }

              }

            }

            case enable {
              leaf urpf-check-enable {
                description 'Open ipv4 urpf-checkout switch.' ;
                type enumeration {
                  enum enable {
                    value 0 ;
                    description 'Open ipv4 urpf-checkout switch.' ;
                  }

                }

              }

              leaf subnet {
                description 'ipv4 subnet-check switch.' ;
                type enumeration {
                  enum TRUE {
                    value 1 ;
                    description 'Open ipv4 subnet-check switch.' ;
                  }

                  enum FALSE {
                    value 0 ;
                    description 'Close ipv4 subnet-check switch' ;
                  }

                }

                default FALSE ;
              }

            }

            ncd:revise-date 2022-08-18 ;
          }

        }

        ncd:revise-date 2020-01-21 ;
      }

      container circuit-maps {
        description 'Circuit map infomation configuration' ;
        list circuit-map {
          description 'Circuit map infomation configuration' ;
          max-elements 1000 ;
          key 'externalvlan internalvlan interface' ;
          leaf externalvlan {
            type ncd:single-range ;

          }

          leaf internalvlan {
            type ncd:single-range ;

          }

          leaf interface {
            type ncd:ifname {
              length 1..31 ;

            }

          }

          leaf username {
            type string {
              length 1..127 ;

            }

            mandatory true ;
          }

          leaf domainname {
            type string {
              length 1..31 ;

            }

            mandatory true ;
          }

          choice choose-password {
            mandatory true ;
            case passwd {
              leaf password-ex {
                type string {
                  length 1..31 ;

                }

              }

            }

            case encry-passwd {
              leaf cir_map_encrypted_passwd {
                type string {
                  length 64..84 ;

                }

              }

            }

          }

        }

        ncd:revise-date 2020-12-16 ;
      }

      container local-subscribers {
        list local-subscriber {
          max-elements 10000 ;
          key 'localSubName domain-name' ;
          leaf localSubName {
            type string {
              length 1..127 ;

            }

          }

          leaf domain-name {
            type string {
              length 1..31 ;

            }

          }

          choice choose-password {
            mandatory true ;
            case passwd {
              leaf password-ex {
                type string {
                  length 1..31 ;

                }

              }

            }

            case encry-passwd {
              leaf local-sub-encrypted-passwd {
                type string {
                  length 64..84 ;

                }

              }

            }

          }

          container ipv6-address {
            presence ipv6-address ;
            leaf ipv6-address {
              description 'LocSub Appoint IPV6 Address' ;
              type ncd:ipv6-address ;

              mandatory true ;
            }

            ncd:revise-date 2023-08-10 ;
          }

          container ipv6-nd-prefix {
            presence ipv6-nd-prefix ;
            leaf nd-prefix {
              description 'LocSub Appoint IPV6 ND Prefix' ;
              type ncd:ipv6-address ;

              mandatory true ;
            }

            leaf nd-prefix-len {
              description 'LocSub Appoint IPV6 ND Prefix Len' ;
              type uint32 {
                range 1..128 ;

              }

              mandatory true ;
            }

            ncd:revise-date 2023-08-10 ;
          }

          container ipv6-pd-prefix {
            presence ipv6-pd-prefix ;
            leaf pd-prefix {
              description 'LocSub Appoint IPV6 PD Prefix' ;
              type ncd:ipv6-address ;

              mandatory true ;
            }

            leaf pd-prefix-len {
              description 'LocSub Appoint IPV6 PD Prefix Len' ;
              type uint32 {
                range 1..128 ;

              }

              mandatory true ;
            }

            ncd:revise-date 2023-08-10 ;
          }

        }

        ncd:revise-date 2020-12-16 ;
      }

      container default-username-templates {
        description 'Default username template model.' ;
        list default-username-template {
          description 'Default username template configuration list.' ;
          max-elements 100 ;
          key default-username-template-name ;
          leaf default-username-template-name {
            description 'Default username template name.' ;
            type string {
              length 1..31 ;

            }

          }

          leaf default-username-type {
            description 'Default username type.' ;
            type enumeration {
              enum mac {
                value 1 ;
                description 'Use the mac as user name' ;
              }

              enum agent-circuit-id {
                value 2 ;
                description 'Use the agent-circuit-id as user name' ;
              }

              enum config {
                value 3 ;
                description 'Configure user name.' ;
              }

            }

          }

          leaf default-username-name {
            description 'Default username.' ;
            type string {
              length 1..127 ;

            }

          }

        }

        ncd:revise-date 2021-12-15 ;
      }

      container default-password-templates {
        description 'Default password template model.' ;
        list default-password-template {
          description 'Default password template configuration list.' ;
          max-elements 100 ;
          key default-password-template-name ;
          leaf default-password-template-name {
            description 'Default password template name.' ;
            type string {
              length 1..31 ;

            }

          }

          choice choose-password {
            case password {
              description 'Default password.' ;
              leaf password-ex {
                type string {
                  length 1..31 ;

                }

              }

            }

            case encry-passwd {
              description 'Default encrypted password.' ;
              leaf encrypted-password {
                type string {
                  length 64..84 ;

                }

              }

            }

          }

        }

        ncd:revise-date 2021-12-15 ;
      }

    }

  }

}
