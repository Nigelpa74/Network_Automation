module zxr10-bras-aim {
  namespace "http://www.zte.com.cn/zxr10/netconf/schema/bras/aim" ;
  prefix aim ;
  yang-version 1 ;
  import zxr10-netconf-defs {
    prefix ncd ;
  }

  organization "ZTE Corporation" ;
  contact "ZTE Corporation
  Nanjing Institute of ZTE Corporation
  No.68 Zijinghua Rd. Yuhuatai District, Nanjing, China
  Tel: +86-25-52870000" ;
  description 'This module describes the netconf model about Aim.' ;
  revision 2025-04-23 {
    description 'add acct-session-id-format' ;
  }

  revision 2024-03-27 {
    description 'add authentic-request-control lac user' ;
  }

  revision 2024-02-20 {
    description 'redirect-url-ipv6 web-server fault solve' ;
  }

  revision 2023-09-04 {
    description 'add new command (no) radius-attribute extend {port}' ;
  }

  revision 2023-08-10 {
    description 'add new command ipv6 address/nd-prefix/pd-prefix' ;
  }

  revision 2023-05-17 {
    description 'netconf encrypted-password <datatype>ciphertext</datatype>  add <log-type>password</log-type>' ;
  }

  revision 2023-03-23 {
    description 'new commond in aim accounting-template mode:
attribute zte_user_mac format {octets | string [{xx-xx-xx-xx-xx-xx|xx.xx.xx.xx.xx.xx|xx:xx:xx:xx:xx:xx|xxxx-xxxx-xxxx|xxxx.xxxx.xxxx|xxxx:xxxx:xxxx|xxxxxxxxxxxx}]}' ;
  }

  revision 2022-12-08 {
    description 'Modify bandwidth smartgroup load-sharing' ;
  }

  revision 2022-11-17 {
    description 'AIM choice' ;
  }

  revision 2022-11-07 {
    description 'Add the default of redirect-url-ipv4 and redirect-url-ipv6' ;
  }

  revision 2022-10-22 {
    description 'Attribute flow-extend {enable|disable}' ;
  }

  revision 2022-08-18 {
    description 'Add bandwidth trunck mode under author template.' ;
  }

  revision 2022-05-19 {
    description 'leaf "domain""advertise-url""nat-domain-name" add length range' ;
  }

  revision 2022-05-12 {
    description 'Add urpf-checkout attribute under security-template.' ;
  }

  revision 2022-02-10 {
    description 'Add lns-web-acl-ipv6.
Add lns-special-acl-ipv6.' ;
  }

  revision 2021-12-15 {
    description 'profile name length extend to 127' ;
  }

  revision 2021-12-14 {
    description 'Add default-username-template.
Add default-password-template.' ;
  }

  revision 2021-11-22 {
    description 'Obsolete leaf related to smlog' ;
  }

  revision 2021-08-05 {
    description 'add dhcp-lease-reonline switch' ;
  }

  revision 2021-07-20 {
    description 'obsolete queue-share node' ;
  }

  revision 2021-06-29 {
    description 'add option for copy-to-radius-group' ;
  }

  revision 2021-06-10 {
    description 'change subcar' ;
  }

  revision 2021-04-26 {
    description 'Add cmd intelligent-speed' ;
  }

  revision 2021-03-02 {
    description 'add performance-statistics switch' ;
  }

  revision 2021-01-28 {
    description 'add authentication request control' ;
  }

  revision 2021-01-19 {
    description 'password hex' ;
  }

  revision 2020-12-16 {
    description 'Encryption algorithm upgrade.' ;
  }

  revision 2020-10-10 {
    description 'set monitor session to 200' ;
  }

  revision 2020-06-24 {
    description 'Change default value of event num and event switch' ;
  }

  revision 2020-06-10 {
    description 'add dsl-agent-circuit-id command' ;
  }

  revision 2020-04-17 {
    description 'Obsolete radius-authen-password under domain and add new node choose-password' ;
  }

  revision 2020-03-12 {
    description 'Add ipv6-nd-ra-suppress under authorization-template-ex.' ;
  }

  revision 2020-03-02 {
    description 'Add flow-statistic container' ;
  }

  revision 2020-02-20 {
    description 'Add the access delay rule for bras and slot.' ;
  }

  revision 2020-01-21 {
    description 'Add ipv6-urpf-checkout attribute under security-template.' ;
  }

  revision 2020-01-13 {
    description 'Add radius username case sensitive.' ;
  }

  revision 2019-12-11 {
    description 'Add mac-ipv6-tables container' ;
  }

  revision 2019-10-16 {
    description 'accounting template policy' ;
  }

  revision 2019-09-19 {
    description 'Reauthen from other domain when no response from radius server' ;
  }

  revision 2019-08-23 {
    description 'user event log' ;
  }

  revision 2019-03-21 {
    description 'authentication max-session 1024000' ;
  }

  revision 2019-01-30 {
    description 'basic service' ;
  }

  revision 2019-01-28 {
    description 'add sustained advertisement online-effect switch' ;
  }

  revision 2019-01-11 {
    description 'configure nat-domain-name' ;
  }

  revision 2018-10-16 {
    description 'configure block rule for bras and slot.' ;
  }

  revision 2018-05-08 {
    description 'openflow-reconnect' ;
  }

  revision 2017-12-28 {
    description 'add copy accounting radius group' ;
  }

  revision 2017-12-06 {
    description 'add username replace switch' ;
  }

  revision 2017-12-04 {
    description 'Configure default domain by user type' ;
  }

  revision 2017-11-30 {
    description 'Add leaf of match-username force.' ;
  }

  revision 2017-11-28 {
    description 'add leaf of attribute nat-multi-portrange switch' ;
  }

  revision 2017-11-13 {
    description 'add check other vendor id switch' ;
  }

  revision 2017-10-10 {
    description 'Add openflow-disconnect' ;
  }

  revision 2017-06-26 ;

  revision 2016-03-02 {
    description 'Initial version.' ;
  }

  container configuration {
    description 'Global configuration model.' ;
    container subscriber-manager {
      description 'Submanager configuration model.' ;
      container sals {
        description 'The configuration infomation of sal. sal:server access list' ;
        list sal {
          description 'Sal configuration list' ;
          max-elements 256 ;
          key salname ;
          leaf salname {
            description 'Sal name' ;
            type string {
              length 1..32 ;

            }

          }

          leaf default-domain {
            description 'Default domain' ;
            type string {
              length 1..31 ;

            }

          }

          container none-domains {
            description 'None domain info' ;
            presence none-domains ;
            leaf none-domain {
              description 'None domain' ;
              type string {
                length 1..31 ;

              }

              mandatory true ;
            }

            leaf keep {
              description 'None domain keep switch' ;
              type enumeration {
                enum FALSE {
                  value 0 ;
                }

                enum TRUE {
                  value 1 ;
                }

              }

            }

          }

          container translatedomains {
            description 'Translate domain configuration' ;
            presence translatedomain ;
            list translatedomain {
              description 'Translate domain list' ;
              max-elements 64 ;
              key source-doamin ;
              leaf source-doamin {
                description 'Source domain' ;
                type string {
                  length 0..31 ;

                }

              }

              leaf dest-domain {
                description 'Destination domain' ;
                type string {
                  length 1..31 ;

                }

                mandatory true ;
              }

            }

          }

          leaf translateanydomain {
            description 'Translate any domain to this domain' ;
            type string {
              length 1..31 ;

            }

          }

          choice deny-permit {
            description 'Deny or permit all domain' ;
            default permit-any ;
            case deny-any {
              description 'Deny all domain access' ;
              leaf denyany {
                description 'Deny all domain access' ;
                type uint8 {
                  range 1 ;

                }

              }

            }

            case permit-any {
              description 'Permit all domain access' ;
              leaf permitany {
                description 'Permit all domain access' ;
                type uint8 {
                  range 0 ;

                }

              }

            }

          }

          container deny-permit-one-domain {
            description 'Deny or permit one domain access' ;
            presence deny-permit-one-domain ;
            list deny-permit-one-domain {
              description 'Deny or permit one domain access' ;
              max-elements 64 ;
              key domain-name ;
              leaf domain-name {
                description 'Domain name' ;
                type string {
                  length 1..31 ;

                }

              }

              choice permit-deny-domain {
                description 'Deny or permit one domain' ;
                mandatory true ;
                case permit-domain {
                  description 'Permit one domain' ;
                  leaf permitdomain {
                    description 'Permit one domain' ;
                    type uint8 {
                      range 0 ;

                    }

                  }

                }

                case deny-domain {
                  description 'Deny one domain' ;
                  leaf denydomain {
                    description 'Deny one domain' ;
                    type uint8 {
                      range 1 ;

                    }

                  }

                }

              }

            }

          }

          container change-domains {
            description 'Change domain configuration' ;
            presence change-domain ;
            list change-domain {
              description 'Change domain list' ;
              max-elements 16 ;
              key domain-name ;
              leaf domain-name {
                description 'Change domain name' ;
                type string {
                  length 1..31 ;

                }

              }

              leaf local-domain {
                description 'Local domain name' ;
                type string {
                  length 1..31 ;

                }

                mandatory true ;
              }

            }

          }

          container match-addresss {
            description 'Get domain by match ipv4 address' ;
            presence match-address ;
            list match-address {
              description 'Get domain by match ipv4 address' ;
              max-elements 64 ;
              key addrMatchName ;
              leaf addrMatchName {
                description 'Match item name' ;
                type string {
                  length 1..32 ;

                }

              }

              leaf domain-name {
                description 'Domain name' ;
                type string {
                  length 1..31 ;

                }

                mandatory true ;
              }

              leaf ipaddress {
                description 'IPv4 address' ;
                type ncd:ipv4-address ;

                mandatory true ;
              }

              leaf ipaddrMaskLen {
                description 'IPv4 mask' ;
                type ncd:ipv4-mask ;

                mandatory true ;
              }

            }

          }

          container match-usernames {
            description 'Get domain by match username' ;
            presence match-username ;
            list match-username {
              description 'Get domain by match username' ;
              max-elements 64 ;
              key username ;
              leaf username {
                description 'User name' ;
                type string {
                  length 1..32 ;

                }

              }

              leaf domainname {
                description 'Domain name' ;
                type string {
                  length 1..32 ;

                }

                mandatory true ;
              }

              leaf force {
                description 'Match username force.' ;
                type int8 {
                  range 0..1 {
                    description 'Force to map' ;
                  }

                }

              }

            }

          }

          container match-vlans {
            description 'Get domain by match vlan' ;
            presence matchvlan ;
            list match-vlan {
              description 'Get domain by match vlan' ;
              max-elements 64 ;
              key match-vlan-name ;
              leaf external-vlan {
                description 'External vlan range' ;
                type ncd:range ;

                mandatory true ;
              }

              leaf match-vlan-name {
                description 'Match item name' ;
                type string {
                  length 1..32 ;

                }

              }

              leaf internal-vlan {
                description 'Internal vlan range' ;
                type ncd:range {
                  pattern "(([0-9]+-[0-9]+)|([1-9][0-9]*)){1,1}" {
                    description '(([0-9]+-[0-9]+)|([1-9][0-9]*)){1,1}' ;
                  }

                }

              }

              leaf domainname {
                description 'Domain name' ;
                type string {
                  length 1..31 ;

                }

                mandatory true ;
              }

            }

          }

          container default-user-types {
            description 'Configure default domain by user type' ;
            presence user-type ;
            list user-type {
              description 'Configure default domain by user type' ;
              key user-type ;
              leaf user-type {
                description 'user type' ;
                type enumeration {
                  enum pppox {
                    value 1 ;
                    description 'Set PPPoX and LAC subscriber' ;
                  }

                  enum ipox {
                    value 2 ;
                    description 'Set IPoX subscriber' ;
                  }

                  enum multi-hop {
                    value 4 ;
                    description 'Set Multi-Hop and IPox L3 subscriber' ;
                  }

                  enum lns {
                    value 3 ;
                    description 'Set LNS subscriber' ;
                  }

                }

              }

              leaf domain {
                description 'domain name' ;
                type string {
                  length 1..31 ;

                }

              }

            }

          }

        }

      }

      container authorization-templates {
        description 'Authorization template information' ;
        list authorization-template {
          description 'Authorizatin template list' ;
          max-elements 20000 ;
          key authorization-name ;
          leaf authorization-name {
            description 'Authorization name' ;
            type string {
              length 1..31 ;

            }

          }

          leaf authorization-type {
            description 'Set authorization type' ;
            type enumeration {
              enum diameter {
                value 1 ;
                description 'Diameter authorization' ;
              }

              enum radius {
                value 2 ;
                description 'RADIUS authorization' ;
              }

              enum mix-diameter {
                value 3 ;
                description 'Mix-Diameter authorization' ;
              }

              enum mix-radius {
                value 4 ;
                description 'Mix-Radius authorization' ;
              }

              enum none {
                value 6 ;
                description 'No authorization' ;
              }

            }

          }

          leaf bind-nat-domain {
            status obsolete {
              ncd:revise-date 2019-12-11 ;
            }

            description 'Bind nat domain' ;
            type string {
              length 1..31 ;

            }

          }

          leaf access-list-input-ipv4 {
            description 'Configure ipv4 input access list' ;
            type string {
              length 1..31 ;

            }

          }

          leaf access-list-input-ipv6 {
            description 'Configure ipv6 input access list' ;
            type string {
              length 1..31 ;

            }

          }

          leaf access-list-output-ipv4 {
            description 'Configure ipv4 output access list' ;
            type string {
              length 1..31 ;

            }

          }

          leaf access-list-output-ipv6 {
            description 'Configure ipv6 output access list' ;
            type string {
              length 1..31 ;

            }

          }

          leaf vpdn-group {
            description 'Vpdn group configuration' ;
            type string {
              length 1..31 ;

            }

          }

          leaf timeout-absolute {
            description 'User absolutely timeout' ;
            type uint32 {
              range 60..2147483647 ;

            }

          }

          leaf session-timeout-switch {
            description 'Config relet or absolute type' ;
            type enumeration {
              enum relet {
                value 1 ;
              }

              enum absolute {
                value 0 ;
              }

              enum relet-from-now {
                value 2 ;
              }

            }

            default absolute ;
          }

          leaf service-priority {
            description 'Configure service priority' ;
            type uint8 {
              range 1..4 ;

            }

          }

          leaf service-bandwidth {
            description 'Configure service bandwidth' ;
            type uint32 {
              range 66..16777215 ;

            }

          }

          leaf qos-queue-statistics {
            description 'Set qos queue statistics function' ;
            type enumeration {
              enum enable {
                value 1 ;
              }

              enum disable {
                value 0 ;
              }

            }

            default disable ;
          }

          leaf nat-type {
            description 'Nat type' ;
            type enumeration {
              enum none {
                value 0 ;
              }

              enum inside {
                value 1 ;
              }

            }

          }

          leaf nat-service {
            description 'Nat service switch' ;
            type enumeration {
              enum enable {
                value 0 ;
              }

              enum disable {
                value 1 ;
              }

            }

          }

          leaf igmp-service-profile {
            type uint8 {
              range 1..100 ;

            }

          }

          leaf lns-load-sharing {
            description 'Lns load share configuration switch' ;
            type enumeration {
              enum enable {
                value 1 ;
              }

              enum disable {
                value 0 ;
              }

            }

          }

          leaf lns-web-acl {
            description 'Lns web acl' ;
            type string {
              length 1..31 ;

            }

          }

          leaf dhcp-lease-reonline {
            description 'dhcp-lease-reonline switch.' ;
            type enumeration {
              enum enable {
                value 1 ;
                description 'Enable dhcp-lease-reonline function.' ;
              }

              enum disable {
                value 0 ;
                description 'Disable dhcp-lease-reonline function.' ;
              }

            }

            ncd:revise-date 2021-08-05 ;
          }

          container advertise {
            description 'Advertisement information configuration' ;
            leaf keep-time {
              description 'Keep advertisement time' ;
              type uint32 {
                range 10..3600 ;

              }

            }

            leaf online-effect {
              description 'Online-effect switch' ;
              type enumeration {
                enum FALSE {
                  value 0 ;
                }

                enum TRUE {
                  value 1 ;
                }

              }

            }

            container advertise-mode {
              description 'Advertise mode information' ;
              presence url-mode ;
              choice mode {
                description 'Advertise redirect mode' ;
                case portal {
                  description 'Portal' ;
                  leaf portal {
                    description 'Portal advertisement' ;
                    type enumeration {
                      enum portal {
                        value 0 ;
                      }

                    }

                    mandatory true ;
                  }

                  leaf delay {
                    description 'Portal advertisment delay time' ;
                    type uint8 {
                      range 0..3 ;

                    }

                  }

                }

                case padm {
                  description 'Padm advertisement mode' ;
                  leaf padm {
                    type enumeration {
                      enum padm {
                        value 2 ;
                      }

                    }

                  }

                }

              }

            }

            container web-force {
              description 'Configure advertise web-force  timer and count' ;
              presence web-force ;
              leaf web-force-timer {
                description 'Advertise period' ;
                type uint32 {
                  range 5..71582788 ;

                }

                mandatory true ;
              }

              leaf web-force-count {
                description 'Advertise counter' ;
                type uint32 {
                  range 1..2147483647 ;

                }

                mandatory true ;
              }

            }

            container url-ipv4 {
              description 'Configure advertise url' ;
              choice url-mode {
                description 'Url mode' ;
                case url {
                  description 'Advertise url' ;
                  leaf advertise-url {
                    description 'Advertise url' ;
                    type string {
                      length 1..127 ;

                    }

                  }

                }

                case web-server-number {
                  description 'Bind web server with v4 advertise' ;
                  leaf number {
                    description 'Web server number <1-128>' ;
                    type uint8 {
                      range 1..128 ;

                    }

                  }

                }

              }

            }

            container url-ipv6 {
              description 'Configure advertise url-ipv6' ;
              choice url-mode {
                description 'Url mode' ;
                case url {
                  description 'Advertise url' ;
                  leaf advertise-url {
                    description 'Advertise url' ;
                    type string {
                      length 1..127 ;

                    }

                  }

                }

                case web-server-number {
                  description 'Bind web server with v4 advertise' ;
                  leaf number {
                    description 'Web server number <1-128>' ;
                    type uint8 {
                      range 1..128 ;

                    }

                  }

                }

              }

            }

          }

          container force {
            leaf redirect-web {
              description 'Force redirct web' ;
              type uint32 {
                range 1 ;

              }

            }

            leaf timer {
              description 'Configure timer' ;
              type uint32 {
                range 1..71582788 ;

              }

            }

            leaf count {
              description 'Web force count' ;
              type uint32 {
                range 1..2147483647 ;

              }

            }

          }

          container monitor-bind-sessions {
            description 'Monitor information' ;
            list monitor-bind-session {
              description 'Monitor configuration' ;
              max-elements 2 ;
              key direction ;
              leaf direction {
                description 'Monitor direction' ;
                type enumeration {
                  enum both {
                    value 1 ;
                  }

                  enum rx {
                    value 2 ;
                  }

                  enum tx {
                    value 3 ;
                  }

                }

              }

              leaf session-num {
                description 'Monitor session number' ;
                type uint32 {
                  range 1..200 ;

                }

              }

            }

          }

          container authen-fail {
            description 'Authentication fail policy information' ;
            choice policy {
              description 'Policy choice' ;
              case offline {
                description 'Offline policy' ;
                leaf offline {
                  description 'Kickoff the user immediately' ;
                  type enumeration {
                    enum offline {
                      value 0 ;
                    }

                  }

                }

              }

              case redirect-web {
                description 'Redirect web choice' ;
                leaf redirect-web {
                  description 'Redirect the user to a fixed web page' ;
                  type enumeration {
                    enum redirect-web {
                      value 1 ;
                    }

                  }

                }

                leaf none-accounting {
                  description 'Stop accounting' ;
                  type enumeration {
                    enum FALSE {
                      value 0 ;
                    }

                    enum TRUE {
                      value 1 ;
                    }

                  }

                  default FALSE ;
                }

              }

            }

          }

          container user-group {
            description 'User group information' ;
            container bandwidth {
              description 'User group bandwidth information' ;
              presence bandwidth ;
              leaf input {
                description 'Input' ;
                type uint32 {
                  range 66..16777215 ;

                }

              }

              leaf output {
                description 'Output' ;
                type uint32 {
                  range 66..16777215 ;

                }

              }

            }

            leaf local-start {
              description 'User group local start' ;
              type enumeration {
                enum local-start {
                  value 1 ;
                }

              }

            }

            container service-priority {
              description 'User group service priority information' ;
              leaf input {
                description 'Input' ;
                type uint32 {
                  range 1..4 ;

                }

                default 3 ;
              }

              leaf output {
                description 'Output' ;
                type uint32 {
                  range 1..4 ;

                }

                default 3 ;
              }

            }

          }

          container traffic-rate-mode {
            description 'Traffic rate mode' ;
            leaf input {
              description 'Input' ;
              type enumeration {
                enum together {
                  value 1 ;
                }

                enum separate {
                  value 2 ;
                }

              }

              default together ;
            }

            leaf output {
              description 'Output' ;
              type enumeration {
                enum together {
                  value 1 ;
                }

                enum separate {
                  value 2 ;
                }

              }

              default together ;
            }

          }

          container prepay {
            leaf flow {
              description 'Prepay flow' ;
              type uint32 {
                range 0..4294967294 ;

              }

              default 0 ;
            }

            leaf type {
              description 'Prepay type' ;
              type enumeration {
                enum up {
                  value 3 ;
                }

                enum down {
                  value 4 ;
                }

                enum dual {
                  value 2 ;
                }

              }

              default dual ;
            }

            leaf time {
              description 'Prepay time' ;
              type uint32 {
                range "0 | 60..4294967294" ;

              }

              default 0 ;
            }

          }

          container mld {
            description 'Mld information' ;
            leaf service-profile {
              description 'Service profile number' ;
              type uint8 {
                range 0..100 ;

              }

              default 0 ;
            }

          }

          container authorization-template-ex {
            leaf userquota-exceed-support-prepay {
              description 'User quota exceed support prepay switch' ;
              type enumeration {
                enum open {
                  value 0 ;
                }

                enum close {
                  value 1 ;
                }

              }

              default open ;
            }

            leaf laft6-bind-tunnel-if-name {
              description 'Laft6 tunnel interface name' ;
              type ncd:ifname {
                length 0..31 ;

              }

            }

            leaf nat-bind-ip-attribute {
              description 'Is support bind' ;
              type enumeration {
                enum TRUE {
                  value 1 ;
                }

                enum FALSE {
                  value 0 ;
                }

              }

              default FALSE ;
            }

            leaf qos-pmap-error {
              description 'Configure subscriber online or offline if radius authorization policy-map does not exist' ;
              type enumeration {
                enum online {
                  value 0 ;
                }

                enum offline {
                  value 1 ;
                }

              }

              default online ;
            }

            leaf smart-traffic-operation-switch {
              description 'Smart traffic operation switch' ;
              type enumeration {
                enum enable {
                  value 1 ;
                }

                enum disable {
                  value 2 ;
                }

              }

            }

            leaf ipv6-nd-ra-suppress {
              type enumeration {
                enum disable {
                  value 0 ;
                  description 'Open IPv6 router advertisements' ;
                }

                enum enable {
                  value 1 ;
                  description 'Close IPv6 router advertisements' ;
                }

              }

              default disable ;
              ncd:revise-date 2020-03-12 ;
            }

          }

          container url-log {
            description 'Set url-log function' ;
            leaf url-log-switch {
              description 'Url log switch' ;
              type enumeration {
                enum enable {
                  value 1 ;
                }

                enum disable {
                  value 0 ;
                }

              }

            }

          }

          container username-replace {
            description 'Set username replace switch' ;
            leaf username-replace-switch {
              description 'Username replace switch' ;
              type enumeration {
                enum enable {
                  value 1 ;
                }

                enum disable {
                  value 0 ;
                }

