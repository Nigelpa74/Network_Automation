              length 1..31 {
                description 'WORD  Accounting template name (1-31 characters)' ;
              }

            }

          }

          leaf account-type {
            description 'AIM accounting type configure.' ;
            type enumeration {
              enum none {
                value 1 ;
                description 'No accounting' ;
              }

              enum radius {
                value 2 ;
                description 'RADIUS accounting' ;
              }

              enum diameter {
                value 3 ;
                description 'Diameter accounting' ;
              }

            }

          }

          leaf calling-station {
            description 'AIM calling-station-id get config' ;
            type enumeration {
              enum server-first {
                value 0 ;
                description 'Server first' ;
              }

              enum local-first {
                value 1 ;
                description 'Local first' ;
              }

            }

          }

          leaf flow-bill {
            description 'AIM user flow bill configure' ;
            type enumeration {
              enum ipv4 {
                value 0 ;
                description 'User flow bill only include ipv4 flow' ;
              }

              enum ipv6 {
                value 1 ;
                description 'User flow bill only include ipv6 flow' ;
              }

              enum dual {
                value 2 ;
                description 'User flow bill only include dual flow' ;
              }

              enum user {
                value 3 ;
                description 'User flow bill only include integrated flow' ;
              }

            }

          }

          leaf l2tp-accounting {
            description 'AIM l2tp accounting mode configure.' ;
            type enumeration {
              enum none {
                value 2 ;
                description 'Close l2tp accounting switch' ;
              }

              enum class1 {
                value 3 ;
                description 'Open l2tp accounting of class1(as vpdn)' ;
              }

              enum class2 {
                value 1 ;
                description 'Open l2tp accounting of class2(as ppp)' ;
              }

            }

            default class1 ;
          }

          leaf l2tp-tunnel-accounting {
            description 'AIM l2tp tunnel accounting switch configure.' ;
            type enumeration {
              enum enable {
                value 1 ;
                description 'Open l2tp tunnel accounting switch' ;
              }

              enum disable {
                value 0 ;
                description 'Close l2tp tunnel accounting switch' ;
              }

            }

          }

          leaf accounting-start-fail {
            description 'AIM accounting start-fail policy configure.' ;
            type enumeration {
              enum online {
                value 0 ;
                description 'Accounting start-fail online' ;
              }

              enum offline {
                value 1 ;
                description 'Accounting start-fail offline' ;
              }

            }

          }

          container accounting-update-fail {
            description 'AIM accounting start-fail and update-fail policy configure.' ;
            presence accounting ;
            leaf update-fail {
              description 'AIM accounting update-fail policy configure.' ;
              type enumeration {
                enum online {
                  value 0 ;
                  description 'Accounting update-fail online' ;
                }

                enum offline {
                  value 1 ;
                  description 'Accounting update-fail offline' ;
                }

              }

            }

            leaf max-times {
              description 'AIM accounting update-fail max times configure.' ;
              type uint32 {
                range 1..255 {
                  description '<1-255>  Max times of accounting update-fail' ;
                }

              }

            }

          }

          container accounting-diameter-group {
            description 'AIM accounting Diameter group configure.' ;
            presence accounting-diameter-group ;
