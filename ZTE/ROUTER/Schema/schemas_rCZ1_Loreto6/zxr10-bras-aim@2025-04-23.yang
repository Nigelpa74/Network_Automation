              type enumeration {
                enum enable {
                  value 1 ;
                  description 'attribute framed-ipv6-address enable' ;
                }

                enum disable {
                  value 0 ;
                  description 'attribute framed-ipv6-address disable' ;
                }

              }

            }

            leaf nat-multi-portrange {
              description 'AIM acccounting attribute nat-multi-portrange switch configure.' ;
              type enumeration {
                enum enable {
                  value 1 ;
                  description 'attribute nat-multi-portrange enable' ;
                }

                enum disable {
                  value 0 ;
                  description 'attribute nat-multi-portrange disable' ;
                }

              }

            }

            leaf flow-extend {
              description 'AIM accounting attribute flow-extend {enable|disable}' ;
              type enumeration {
                enum enable {
                  value 1 ;
                  description 'Attribute flow-extend enable' ;
                }

                enum disable {
                  value 0 ;
                  description 'Attribute flow-extend disable' ;
                }

              }

              ncd:revise-date 2022-10-22 ;
            }

            container zte-user-mac {
              presence mac-string ;
              choice zte-user-mac-format {
                case octets {
                  description 'take mac in the way of octets' ;
                  leaf octets {
                    description 'take mac in the way of octets' ;
                    type enumeration {
                      enum octets {
                        value 1 ;
                      }

                    }

                    mandatory true ;
                  }

                }

                case string {
                  description 'take mac in the way of string' ;
                  leaf string {
                    description 'take mac in the way of octets' ;
                    type enumeration {
                      enum string {
                        value 2 ;
                      }

                    }

                    mandatory true ;
                  }

                  leaf mac-format {
                    description 'string mac form' ;
                    type enumeration {
                      enum xx-xx-xx-xx-xx-xx {
                        value 1 ;
                      }

                      enum xx.xx.xx.xx.xx.xx {
                        value 7 ;
                      }

                      enum xx:xx:xx:xx:xx:xx {
                        value 2 ;
                      }

                      enum xxxx-xxxx-xxxx {
                        value 4 ;
                      }

                      enum xxxx.xxxx.xxxx {
                        value 6 ;
                      }

                      enum xxxx:xxxx:xxxx {
                        value 3 ;
                      }

                      enum xxxxxxxxxxxx {
                        value 5 ;
                      }

                    }

                  }

                }

              }

              ncd:revise-date 2023-03-23 ;
            }

