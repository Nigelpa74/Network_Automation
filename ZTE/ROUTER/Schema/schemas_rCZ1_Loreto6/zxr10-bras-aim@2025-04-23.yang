                  description 'WORD  Second RADIUS group name (1-31 characters)' ;
                }

              }

            }

          }

          container accounting-start-delay {
            description 'AIM accounting-start delay configure.' ;
            presence accounting-start ;
            leaf delay {
              description 'AIM accounting start delay configure.' ;
              type uint32 {
                range 1..300 {
                  description '<1-300>  Accounting start delay period(s)' ;
                }

              }

            }

            leaf offline {
              description 'AIM Offline enable configuration.' ;
              type enumeration {
                enum offline {
                  value 1 ;
                  description 'Offline enable configuration' ;
                }

                enum 0 {
                  value 0 ;
                  description 'Invalid value' ;
                }

              }

              default 0 ;
            }

          }

          leaf accounting-update-delay {
            description 'AIM accounting update delay period configure.' ;
            type uint32 {
              range 1..300 {
                description '<1-300>  Accounting update delay period(s)' ;
              }

            }

          }

          leaf accounting-update-immediately {
            description 'AIM immediate account update configure.' ;
            type enumeration {
              enum immediately {
                value 1 ;
                description 'Immediate account update' ;
              }

              enum 0 {
                value 0 ;
                description 'Invalid value' ;
              }

            }

            default 0 ;
          }

          container accounting-update-interval {
            description 'AIM accounting update configure.' ;
            presence accounting-update ;
            choice period-or-disable {
              description 'AIM accounting update period configure or AIM accounting update close configure.' ;
              default period ;
              case period {
                description 'AIM accounting update period configure.' ;
                leaf update-period {
                  description 'AIM accounting update period configure.' ;
                  type uint32 {
                    range 60..604800 {
                      description '<60-604800>  Accounting update period(s)' ;
                    }

