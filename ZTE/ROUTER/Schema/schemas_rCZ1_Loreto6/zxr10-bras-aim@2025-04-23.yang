                  default 600 ;
                }

              }

              case disable {
                description 'AIM accounting update close configure.' ;
                leaf disable {
                  description 'AIM accounting update close configure.' ;
                  type uint32 {
                    range 0 {
                      description 'Close accounting update' ;
                    }

                  }

                  default 0 ;
                }

              }

            }

