module zxr10-l3vpn {
  namespace "http://www.zte.com.cn/zxr10/netconf/schema/rosng/l3vpn" ;
  prefix l3vpn ;
  yang-version 1 ;
  import zxr10-netconf-defs {
    prefix ncd ;
  }

  organization "ZTE Corporation" ;
  contact "ZTE Corporation
  Nanjing Institute of ZTE Corporation
  No.68 Zijinghua Rd. Yuhuatai District, Nanjing, China
  Tel: +86-25-52870000" ;
  description 'The netconf module to describe L3VPN.This netconf module contains managed object definitions of VRF for L3VPN and 6VPE.' ;
  revision 2025-08-26 {
    description 'Add feature for the following nodes:frr-wtr-sec-with-min,protection-wtr,protection-wtr-second,protection-wtr-sec-with-min.' ;
  }

  revision 2025-01-06 {
    description '1.Add leaf node import-additional-policy in address-family-ipv4 and address-family-ipv6.' ;
  }

  revision 2024-10-15 {
    description 'Modify common terms in the description.' ;
  }

  revision 2024-10-14 {
    description '1.Add container l3vpn-prefix-sid-delete-delay: /configuration/vrf/l3vpn-prefix-sid-delete-delay.' ;
  }

  revision 2024-08-14 {
    description '1.Add container l3vpn-usid-fib: /configuration/vrf/l3vpn-usid-fib.
2.Obsolete container l3vpn-usid-fib:/l3vpn:l3vpn-usid-fib/' ;
  }

  revision 2024-08-13 {
    description '1.Add leaf nodes protection-wtr-sec-with-min and frr-wtr-sec-with-min.' ;
  }

  revision 2024-04-09 {
    description '1.Add container l3vpn-usid-fib: /configuration/vrf/l3vpn-usid-fib.' ;
  }

  revision 2024-03-15 {
    description 'Add two leaves:
/configuration/vrf/apply-all-by-default-ttl-mode/ttl-mode,
/configuration/vrf/vrf-instances/vrf-inst/added-property/ttl-mode.' ;
  }

  revision 2024-01-09 {
    description '1.Modify the default value of the leaf node:protection-wtr-second to 10 in address-family-ipv4、address-family-ipv6.' ;
  }

  revision 2023-12-11 {
    description '1.Convert leaf nodes to choice nodes:frr-wtr-type and add leaf node:frr-wtr-second in address-family-ipv4、address-family-ipv6;
2.Convert leaf nodes to choice nodes:protection-wtr-type and add leaf node:protection-wtr-second in address-family-ipv4、address-family-ipv6.' ;
  }

  revision 2023-11-28 {
    description 'Add nine leaves:
/state/vrf/vrf-instances/vrf-inst/l3vpn-statistics/ipv4-in-bytes,
/state/vrf/vrf-instances/vrf-inst/l3vpn-statistics/ipv4-in-packets,
/state/vrf/vrf-instances/vrf-inst/l3vpn-statistics/ipv4-out-bytes,
/state/vrf/vrf-instances/vrf-inst/l3vpn-statistics/ipv4-out-packets,
/state/vrf/vrf-instances/vrf-inst/l3vpn-statistics/ipv6-in-bytes,
/state/vrf/vrf-instances/vrf-inst/l3vpn-statistics/ipv6-in-packets,
/state/vrf/vrf-instances/vrf-inst/l3vpn-statistics/ipv6-out-bytes,
/state/vrf/vrf-instances/vrf-inst/l3vpn-statistics/ipv6-out-packets,
/configuration/vrf/vrf-instances/vrf-inst/net-traffic-stat.' ;
  }

  revision 2023-07-13 {
    description 'Add two leaf nodes named default-route-allocate-label.' ;
  }

  revision 2023-03-15 {
    description 'Change the maximum value of a leaf node named vpnid.' ;
  }

  revision 2023-02-08 {
    description '1.Add leaf route-reoriginate-l3vpn-to-l3vpn in address-family-ipv4 and address-family-ipv6.' ;
  }

