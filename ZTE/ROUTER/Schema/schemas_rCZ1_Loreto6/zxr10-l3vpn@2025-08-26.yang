                enum disable {
                  value 0 ;
                  description 'Disable Segment Routing over IPv6 traffic engineering policy' ;
                }

                enum enable {
                  value 1 ;
                  description 'Enable Segment Routing over IPv6 traffic engineering policy' ;
                }

              }

              ncd:revise-date 2020-08-13 ;
            }

