2.vrf add route-policy:
/l3vpn:configuration/l3vpn:vrf/l3vpn:vrf-instances/l3vpn:vrf-inst/l3vpn:address-family-ipv4/l3vpn:export-policy,
/l3vpn:configuration/l3vpn:vrf/l3vpn:vrf-instances/l3vpn:vrf-inst/l3vpn:address-family-ipv4/l3vpn:import-policy,
/l3vpn:configuration/l3vpn:vrf/l3vpn:vrf-instances/l3vpn:vrf-inst/l3vpn:address-family-ipv4/l3vpn:evpn-export-policy,
/l3vpn:configuration/l3vpn:vrf/l3vpn:vrf-instances/l3vpn:vrf-inst/l3vpn:address-family-ipv4/l3vpn:evpn-import-policy,
/l3vpn:configuration/l3vpn:vrf/l3vpn:vrf-instances/l3vpn:vrf-inst/l3vpn:address-family-ipv4/l3vpn:gw-ip/l3vpn:route-policy,
/l3vpn:configuration/l3vpn:vrf/l3vpn:vrf-instances/l3vpn:vrf-inst/l3vpn:address-family-ipv6/l3vpn:export-policy,
/l3vpn:configuration/l3vpn:vrf/l3vpn:vrf-instances/l3vpn:vrf-inst/l3vpn:address-family-ipv6/l3vpn:import-policy,
/l3vpn:configuration/l3vpn:vrf/l3vpn:vrf-instances/l3vpn:vrf-inst/l3vpn:address-family-ipv6/l3vpn:evpn-export-policy,
/l3vpn:configuration/l3vpn:vrf/l3vpn:vrf-instances/l3vpn:vrf-inst/l3vpn:address-family-ipv6/l3vpn:evpn-import-policy,
/l3vpn:configuration/l3vpn:vrf/l3vpn:vrf-instances/l3vpn:vrf-inst/l3vpn:address-family-ipv6/l3vpn:gw-ip/l3vpn:route-policy,
/l3vpn:configuration/l3vpn:vrf/l3vpn:vrf-public-instance/l3vpn:address-family-ipv4/l3vpn:export-policy,
/l3vpn:configuration/l3vpn:vrf/l3vpn:vrf-public-instance/l3vpn:address-family-ipv6/l3vpn:export-policy' ;
  }

  revision 2022-03-08 {
    description '1.Add leaves:
/configuration/vrf/vrf-instances/vrf-inst/address-family-ipv4/evpn-auto-originate-route,
/configuration/vrf/vrf-instances/vrf-inst/address-family-ipv6/evpn-auto-originate-route,' ;
