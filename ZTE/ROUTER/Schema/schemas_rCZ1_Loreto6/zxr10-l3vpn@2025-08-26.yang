              if-feature default-value-common ;

              description 'Set the WTR time to be precise to seconds.' ;
              type uint32 {
                range 1..720 ;

              }

              default 300 ;
              units s ;
              ncd:revise-date 2023-12-11 ;
            }

            leaf frr-wtr-sec-with-min {
              type uint32 {
                range 0..59 ;

              }

              description 'Set the WTR time to be precise to seconds.' ;
              units s ;
              if-feature default-value-common {
                ncd:revise-date 2025-08-26 ;
              }

              ncd:revise-date 2024-08-13 ;
            }

            leaf route-reoriginate-from-evpn {
              description 'Control route reoriginate from EVPN to L3VPN.Its default value which is between [enable,disable] and generally enable ,depends on product specification.' ;
              type enumeration {
                enum disable {
                  value 0 ;
                  description 'Disable route reoriginate from EVPN to L3VPN.' ;
                }

                enum enable {
                  value 1 ;
                  description 'Enable route reoriginate from EVPN to L3VPN.' ;
                }

              }

              ncd:revise-date 2020-08-04 ;
            }

            leaf route-reoriginate-from-l3vpn {
              description 'Control route reoriginate from L3VPN to EVPN.Its default value which is between [enable,disable] and generally enable ,depends on product specification.' ;
              type enumeration {
                enum disable {
                  value 0 ;
                  description 'Disable route reoriginate from L3VPN to EVPN.' ;
                }

                enum enable {
                  value 1 ;
                  description 'Enable route reoriginate from L3VPN to EVPN.' ;
                }

              }

              ncd:revise-date 2020-08-04 ;
            }

            leaf srv6-best-effort {
              description 'Segment Routing over IPv6 best effort.' ;
              type enumeration {
                enum disable {
                  value 0 ;
                  description 'Disable Segment Routing over IPv6 best effort' ;
                }

                enum enable {
                  value 1 ;
                  description 'Enable Segment Routing over IPv6 best effort' ;
                }

              }

              ncd:revise-date 2020-08-13 ;
            }

            leaf srv6-traffic-engineer {
