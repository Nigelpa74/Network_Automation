/configuration/vrf/vrf-instances/vrf-inst/address-family-ipv4/default-color,
/configuration/vrf/vrf-instances/vrf-inst/address-family-ipv4/default-color-evpn,
/configuration/vrf/vrf-instances/vrf-inst/address-family-ipv6/default-color,
