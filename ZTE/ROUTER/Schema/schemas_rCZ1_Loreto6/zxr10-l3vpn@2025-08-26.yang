                  value 0 ;
                  description 'Disable originate EVPN routes automatically.' ;
                }

                enum enable {
                  value 1 ;
                  description 'Enable originate EVPN routes automatically.' ;
                }

              }

              ncd:revise-date 2022-03-08 ;
            }

            leaf protection-wtr {
              description 'Set the WTR time for local prefixes protection.' ;
              type uint32 {
                range 0..12 ;

              }

              units min ;
              if-feature protection-local-prefix-wtr {
                ncd:revise-date 2025-08-26 ;
              }

              ncd:revise-date 2022-08-05 ;
            }

            leaf protection-wtr-second {
              description 'Set the WTR time to be precise to seconds for local prefixes protection.' ;
              type uint32 {
                range 0..720 ;

              }

              default 10 ;
              units s ;
              if-feature protection-local-prefix-wtr {
                ncd:revise-date 2025-08-26 ;
              }

              ncd:revise-date 2023-12-11 ;
            }

            leaf protection-wtr-sec-with-min {
              type uint32 {
                range 0..59 ;

              }

              description 'Set the WTR time to be precise to seconds for local prefixes protection.' ;
              units s ;
              if-feature protection-local-prefix-wtr {
                ncd:revise-date 2025-08-26 ;
              }

              ncd:revise-date 2024-08-13 ;
            }

            leaf tunnel-select-prefer {
              description 'Select preferred tunnel.' ;
              type enumeration {
                enum color {
                  value 1 ;
                  description 'Color tunnel preferred.' ;
                }

              }

              ncd:revise-date 2022-09-08 ;
            }

            leaf route-reoriginate-l3vpn-to-l3vpn {
              description 'Control route reoriginate from L3VPN to L3VPN.' ;
              type enumeration {
                enum disable {
                  value 0 ;
                  description 'Disable route reoriginate from L3VPN to L3VPN.' ;
                }

                enum enable {
                  value 1 ;
                  description 'Enable route reoriginate from L3VPN to L3VPN.' ;
                }

              }

              default disable ;
              ncd:revise-date 2023-02-08 ;
            }

            leaf default-route-allocate-label {
              type enumeration {
                enum per-prefix {
                  value 2 ;
                  description 'Per prefix label.' ;
                }

                enum per-vrf {
                  value 3 ;
                  description 'Per VRF label.' ;
                }

              }

              description 'Allocate MPLS label for default route.' ;
              ncd:revise-date 2023-07-13 ;
            }

            leaf import-additional-policy {
              type enumeration {
                enum inherit-bgp {
                  value 0 ;
                  description 'Inherit BGP global command.' ;
                }

                enum enable {
                  value 1 ;
                  description 'Enable additional policy.' ;
                }

                enum disable {
                  value 2 ;
                  description 'Disable additional policy.' ;
                }

              }

              description 'Additional policy for route import.' ;
              default inherit-bgp ;
              ncd:revise-date 2025-01-06 ;
            }

          }

          container nm-create {
            if-feature nm-private ;

            description 'Use to distinguish the type of VRF.' ;
            leaf vrf-type {
              description 'The type of VRF instance.' ;
