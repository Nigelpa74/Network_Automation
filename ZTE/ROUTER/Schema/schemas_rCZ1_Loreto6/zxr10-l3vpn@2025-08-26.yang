              list import-vrf-route {
                description 'Import VRF routes.' ;
                key vrf-name ;
                leaf vrf-name {
                  description 'VRF name.' ;
                  type string {
                    length 1..32 ;

                  }

                }

                leaf reoriginate-l3vpn {
                  description 'Reoriginate VPN routes.' ;
                  type empty ;

                }

                leaf reoriginate-evpn {
                  description 'Reoriginate EVPN routes.' ;
                  type empty ;

                }

              }

              ncd:revise-date 2021-07-15 ;
            }

            leaf default-color {
              description 'Default color value.' ;
