  container state {
    config false ;
    description 'State' ;
    container ipsec {
      description 'IPsec state' ;
      container ipsec-gdoi-gms {
        description 'Show IPsec GDOI Group Members' ;
        list ipsec-gdoi-gm-acl {
          description 'Show IPsec GDOI Group Member' ;
          key 'group-name acl-num' ;
          leaf group-name {
            description 'GDOI group name' ;
            type string {
              length 1..32 ;

            }

          }

          leaf acl-num {
            description 'ACL rule number' ;
            type uint32 ;

          }

          leaf acl-inform {
            description 'ACL rules' ;
            type ncd:string-with-blank ;

          }

          ncd:select group-name ;
          ncd:select "group-name acl-num" ;
        }

        list ipsec-gdoi-gm {
          description 'Show IPsec GDOI Group Member' ;
          key group-name ;
          leaf group-name {
            description 'GDOI group name' ;
            type string {
              length 1..32 ;

            }

          }

          leaf group-member {
            description 'Group member' ;
            type string ;

          }

          leaf vrf-name {
            description 'Vrf name' ;
            type string ;

          }

          leaf registration-status {
            description 'Registration status' ;
            type registration-status ;

          }

          leaf registered-with {
            description 'Registered with' ;
            type string ;

          }

          leaf last-rekey-from {
            description 'Last rekey from' ;
            type string ;

          }

          leaf current-seq-num {
            description 'Current seq num' ;
            type uint32 ;

          }

          container kek-policy {
            description 'KEK information' ;
            leaf multicast-address {
              description 'Multicast address' ;
              type string ;

            }

            leaf remain-lifetime {
              description 'Remain lifetime' ;
              type uint32 ;

            }

            leaf encrypt-algorithm {
              description 'Encrypt algorithm' ;
              type KEK-encrypt-algorithm ;

            }

            leaf key-size {
              description 'Key size' ;
              type uint32 ;

            }

            leaf sig-hash-algorithm {
              description 'Sig Hash Algorithm' ;
              type Sig-Hash-Algorithm ;

            }

            leaf sig-key-length {
              description 'Sig Key Length' ;
              type uint32 ;

            }

            leaf my-cookie {
              description 'My Cookie' ;
              type string ;

            }

            leaf ks-cookie {
              description 'KS cookie' ;
              type string ;

            }

          }

          ncd:select group-name ;
        }

      }

      container tunnel-groups {
        description 'IPsec tunnel group information.' ;
        list tunnel-group {
          description 'IPsec tunnel group information.' ;
          key group-number ;
          leaf group-number {
            description 'Tunnel group number.' ;
            type uint8 ;

          }

          leaf vrrp-if {
            description 'VRRP if name.' ;
            type string ;

          }

          leaf vrrp-id {
            description 'VRRP ID.' ;
            type uint8 ;

          }

          leaf vrrp-state {
            description 'VRRP state.' ;
            type enumeration {
              enum invalid {
                value 0 ;
              }

              enum init {
                value 1 ;
              }

              enum master {
                value 2 ;
              }

              enum backup {
                value 3 ;
              }

            }

          }

          leaf peer-vrrp-state {
            description 'Peer VRRP state.' ;
            type enumeration {
              enum invalid {
                value 0 ;
              }

              enum init {
                value 1 ;
              }

              enum master {
                value 2 ;
              }

              enum backup {
                value 3 ;
              }

            }

          }

          leaf track-state {
            description 'IPsec tunnel group track state.' ;
            type enumeration {
              enum invalid {
                value 0 ;
              }

              enum up {
                value 1 ;
              }

              enum down {
                value 2 ;
              }

            }

          }

        }

        ncd:revise-date 2023-01-05 ;
      }

      container tunnel-statistics {
        description 'Tunnel flow statistics.' ;
        list tunnel-statistic {
          description 'Tunnel flow statistics.' ;
          key tunnel-name ;
          leaf tunnel-name {
            description 'IPsec tunnel name.' ;
            type ncd:ifname ;

          }

          leaf in-success-packets {
            description 'The number of packets successfully decrypted in the inbound direction.' ;
            type ncd:uint64-8bytes ;

          }

          leaf in-success-bytes {
            description 'The number of bytes successfully decrypted in the inbound direction.' ;
            type ncd:uint64-8bytes ;

          }

          leaf in-total-packets {
            description 'The number of packets to decrypt in the inbound direction.' ;
            type ncd:uint64-8bytes ;

          }

          leaf in-total-bytes {
            description 'The number of bytes to decrypt in the inbound direction.' ;
            type ncd:uint64-8bytes ;

          }

          leaf out-success-packets {
            description 'The number of packets successfully encrypted in the outbound direction.' ;
            type ncd:uint64-8bytes ;

          }

          leaf out-success-bytes {
            description 'The number of bytes successfully encrypted in the outbound direction.' ;
            type ncd:uint64-8bytes ;

          }

          leaf out-total-packets {
            description 'The number of packets to encrypt in the outbound direction.' ;
            type ncd:uint64-8bytes ;

          }

          leaf out-total-bytes {
            description 'The number of bytes to encrypt in the outbound direction.' ;
            type ncd:uint64-8bytes ;

          }

        }

        ncd:revise-date 2023-01-05 ;
      }

      container load-balances {
        description 'IPSEC load balancing information.' ;
        list load-balance-tunnel {
          description 'IPSEC load balancing information.' ;
          key tunnel-name ;
          leaf tunnel-name {
            description 'IPsec tunnel name' ;
            type string {
              length 1..31 ;

            }

          }

          leaf tunnel-type {
            description 'Tunnel type' ;
            type enumeration {
              enum unknown {
                value 0 ;
              }

              enum static {
                value 1 ;
              }

              enum dynamic {
                value 2 ;
              }

              enum manual {
                value 3 ;
              }

              enum gdoi {
                value 4 ;
              }

            }

          }

          leaf local-ip {
            description 'Local address' ;
            type string {
              length 0..45 ;

            }

          }

          leaf tunnel-vrf {
            description 'Tunnel VRF name' ;
            type string {
              length 0..32 ;

            }

          }

          list load-balance-tunnel-cpu {
            description 'IPSEC load balancing CPU information.' ;
            key peer-ip ;
            leaf peer-ip {
              description 'Remote address' ;
              type string {
                length 1..45 ;

              }

            }

            leaf cpu-name {
              description 'CPU name' ;
              type string {
                length 0..31 ;

              }

            }

          }

          ncd:select tunnel-name ;
        }

        ncd:revise-date 2023-01-05 ;
      }

      container ipsec-sa {
        description 'Show crypto ipsec sa' ;
        list ipsec-sa {
          description 'Show crypto ipsec sa.' ;
          key 'tunnel-name inbound-AH-SPI inbound-ESP-SPI' ;
          leaf tunnel-name {
            description 'IPsec tunnel name.' ;
            type string {
              length 1..31 ;

            }

          }

          leaf ike-version {
            description 'Ike sa version' ;
            type string {
              length 1..11 ;

            }

          }

          leaf ipsec-profile-tag {
            description 'Ipsec profile name' ;
            type string {
              length 1..19 ;

            }

          }

          leaf local-endpt {
            description 'Local address' ;
            type string {
              length 1..45 ;

            }

          }

          leaf current-remote-endpt {
            description 'Current remote address' ;
            type string {
              length 1..45 ;

            }

          }

          leaf ipsec-mtu {
            description 'IPSEC mtu' ;
            type uint32 ;

          }

          leaf FVRF {
            description 'FVRF name' ;
            type string {
              length 0..35 ;

            }

          }

          leaf IVRF {
            description 'IVRF name' ;
            type string {
              length 0..35 ;

            }

          }

          leaf pre-fragmentation {
            description 'Pre-fragmentation' ;
            type string {
              length 1..11 ;

            }

          }

          leaf origin-IP-header-DF-bit {
            description 'Origin IP header DF bit' ;
            type string {
              length 1..11 ;

            }

          }

          leaf tunnel-IP-header-DF-bit {
            description 'Tunnel IP header DF bit' ;
            type string {
              length 1..11 ;

            }

          }

          leaf sa-type {
            description 'The type of sa' ;
            type string {
              length 1..11 ;

            }

          }

          leaf remain-inbound-throughput {
            description 'Inbound remain kilobyte (KB)' ;
            type uint32 ;

            units KB ;
          }

          leaf remain-outbound-throughput {
            description 'Outbound remain kilobyte (KB)' ;
            type uint32 ;

            units KB ;
          }

          leaf local-ident-address {
            description 'Local ident address' ;
            type string {
              length 0..45 ;

            }

          }

          leaf local-ident-mask {
            description 'Local ident net mask' ;
            type string {
              length 0..45 ;

            }

          }

          leaf local-ident-protocal {
            description 'The protocol of local ident' ;
            type uint8 ;

          }

          leaf local-ident-port-min {
            description 'Local ident port min' ;
            type string {
              length 1..11 ;

            }

          }

          leaf local-ident-port-max {
            description 'Local ident port max' ;
            type string {
              length 1..11 ;

            }

          }

          leaf remote-ident-address {
            description 'Remote ident address' ;
            type string {
              length 0..45 ;

            }

          }

          leaf remote-ident-mask {
            description 'Remote ident net mask' ;
            type string {
              length 0..45 ;

            }

          }

          leaf remote-ident-protocal {
            description 'The protocol of remote ident' ;
            type uint8 ;

          }

          leaf remote-ident-port-min {
            description 'Remote ident port min' ;
            type string {
              length 1..11 ;

            }

          }

          leaf remote-ident-port-max {
            description 'Remote ident port max' ;
            type string {
              length 1..11 ;

            }

          }

          leaf inbound-AH-SPI {
            description 'SPI of inbound AH sa' ;
            type string {
              length 0..11 ;

            }

          }

          leaf inbound-AH-auth-algorithm {
            description 'Authentication algorithm of inbound AH sa' ;
            type string {
              length 0..11 ;

            }

          }

          leaf inbound-AH-encap-mode {
            description 'Encapsulation mode of inbound AH sa' ;
            type string {
              length 0..11 ;

            }

          }

          leaf inbound-AH-throughput {
            description 'Current kilobyte throughput of inbound AH sa (KB)' ;
            type string {
              length 0..31 ;

            }

            units KB ;
          }

          leaf inbound-AH-remain-lifetime {
            description 'Remain lifetime of inbound AH sa (s)' ;
            type string {
              length 0..31 ;

            }

            units s ;
          }

          leaf outbound-AH-SPI {
            description 'SPI of outbound AH sa' ;
            type string {
              length 0..11 ;

            }

          }

          leaf outbound-AH-auth-algorithm {
            description 'Authentication algorithm of outbound AH sa' ;
            type string {
              length 0..11 ;

            }

          }

          leaf outbound-AH-encap-mode {
            description 'Encapsulation mode of outbound AH sa' ;
            type string {
              length 0..11 ;

            }

          }

          leaf outbound-AH-throughput {
            description 'Current kilobyte throughput of outbound AH sa (KB)' ;
            type string {
              length 0..31 ;

            }

            units KB ;
          }

          leaf outbound-AH-remain-lifetime {
            description 'Remain lifetime of outbound AH sa (s)' ;
            type string {
              length 0..31 ;

            }

            units s ;
          }

          leaf inbound-ESP-SPI {
            description 'SPI of inbound ESP sa' ;
            type string {
              length 0..11 ;

            }

          }

          leaf inbound-ESP-auth-algorithm {
            description 'Authentication algorithm of inbound ESP sa' ;
            type string {
              length 0..11 ;

            }

          }

          leaf inbound-ESP-encry-algorithm {
            description 'Encryption algorithm of inbound ESP sa' ;
            type string {
              length 0..19 ;

            }

          }

          leaf inbound-ESP-encap-mode {
            description 'Encapsulation mode of inbound ESP sa' ;
            type string {
              length 0..11 ;

            }

          }

          leaf inbound-ESP-throughput {
            description 'Current kilobyte throughput of inbound ESP sa (KB)' ;
            type string {
              length 0..31 ;

            }

            units KB ;
          }

          leaf inbound-ESP-remain-lifetime {
            description 'Remain lifetime of inbound ESP sa (s)' ;
            type string {
              length 0..31 ;

            }

            units s ;
          }

          leaf outbound-ESP-SPI {
            description 'SPI of outbound ESP sa' ;
            type string {
              length 0..11 ;

            }

          }

          leaf outbound-ESP-auth-algorithm {
            description 'Authentication algorithm of outbound ESP sa' ;
            type string {
              length 0..11 ;

            }

          }

          leaf outbound-ESP-encry-algorithm {
            description 'Encryption algorithm of outbound ESP sa' ;
            type string {
              length 0..19 ;

            }

          }

          leaf outbound-ESP-encap-mode {
            description 'Encapsulation mode of outbound ESP sa' ;
            type string {
              length 0..11 ;

            }

          }

          leaf outbound-ESP-throughput {
            description 'Current kilobyte throughput of outbound ESP sa (KB)' ;
            type string {
              length 0..31 ;

            }

            units KB ;
          }

          leaf outbound-ESP-remain-lifetime {
            description 'Remain lifetime of outbound ESP sa (s)' ;
            type string {
              length 0..31 ;

            }

            units s ;
          }

          ncd:select tunnel-name ;
          ncd:select "tunnel-name inbound-AH-SPI" ;
          ncd:select "tunnel-name inbound-ESP-SPI" ;
        }

        ncd:revise-date 2023-03-13 ;
      }

    }

    ncd:revise-date 2016-12-10 ;
  }

  rpc tunnel-group-state-to-backup {
    description 'Switch all tunnel group states to backup.' ;
    ncd:revise-date 2022-09-23 ;
  }

  rpc clear-ipsec-sa {
    description 'Clear IPsec SA.' ;
    input {
      container clear-para {
        config false ;
        description 'Clear parameter of IPsec SA.' ;
        container common-para {
          description 'Clear common parameter of IPsec SA.' ;
          leaf force {
            description 'Clear IPsec SAs in force mode.' ;
            type empty ;

          }

        }

        choice clear-type {
          description 'Clear type of IPsec SA.' ;
          case peer {
            description 'Specify the peer address to clear IPsec SA.' ;
            container peer-para {
              description 'Specify the peer address to clear IPsec SA.' ;
              leaf vrf-name {
                description 'VRF name.' ;
                type string {
                  length 1..32 ;

                }

              }

              choice peer-ip-type {
                description 'Peer address type.' ;
                mandatory true ;
                case peer-ipv4 {
                  description 'Peer IPV4 address.' ;
                  leaf peer-ipv4-addr {
                    description 'Peer IPV4 address.' ;
                    type ncd:ipv4-address-none-zero ;

                  }

                }

                case peer-ipv6 {
                  description 'Peer IPV6 address.' ;
                  leaf peer-ipv6-addr {
                    description 'Peer IPV6 address.' ;
                    type ncd:ipv6-address ;

                  }

                }

              }

            }

          }

        }

      }

    }

    ncd:revise-date 2023-01-05 ;
  }

}
