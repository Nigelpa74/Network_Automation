                  mandatory true ;
                }

              }

              case ipv6 {
                description 'Set IPv6 identity' ;
                leaf ipv6-address {
                  description 'Set Peer IPv6 address' ;
                  type ncd:ipv6-address ;

                  mandatory true ;
                }

              }

