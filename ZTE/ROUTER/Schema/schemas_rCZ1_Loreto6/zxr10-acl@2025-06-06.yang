              description 'Specify the time to live (TTL).' ;
              presence "Specify the TTL" ;
              choice ttl {
                description 'Specify the TTL value
The operator value of TTL mean 
eq(1)   : Match only packets on a given ttl value
ge(2)   : Match only packets with a no lower ttl value
le(3)   : Match only packets with a no greater ttl value
neq(6)  : Match only packets with a no equeal ttl value
range(7): Match only packet on a given ttl value range.' ;
                mandatory true ;
                case ttl-value {
                  description 'Specify the value of the TTL.' ;
                  container ttl-value {
                    description 'Specify the value of the TTL.' ;
                    presence "Specify the TTL value" ;
                    leaf ttl-operator {
                      description 'Specify the operation type of the TTL.' ;
                      type enumeration {
                        enum eq {
                          value 1 ;
                          description 'Equal to.' ;
                        }

                        enum ge {
                          value 2 ;
                          description 'Great than or equal to.' ;
                        }

                        enum le {
                          value 3 ;
                          description 'Less than or equal to.' ;
                        }

                        enum neq {
                          value 6 ;
                          description 'Not equal to.' ;
                        }

                      }

                      mandatory true ;
                    }

                    leaf ttl-value {
                      description 'Specify the value of the TTL.' ;
