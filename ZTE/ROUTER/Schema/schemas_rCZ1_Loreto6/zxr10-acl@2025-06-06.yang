  container state {
    config false ;
    description 'State model.' ;
    container acl {
      description 'State about ACL.' ;
      container acl-v4-statistics {
        if-feature ipv4-feature ;

        if-feature acl-statistics ;

        description 'Query the IPv4 type interface granularity statistical data.' ;
        list acl-v4-statistic {
          description 'Query the IPv4 type interface granularity statistical data.' ;
          key 'if-name if-direction acl-ruleid' ;
          leaf if-name {
            description 'Specify the interface name.' ;
            type ncd:ifname ;

          }

          leaf if-direction {
            description 'Specify the interface direction.' ;
            type acl-if-direction ;

          }

          leaf acl-ruleid {
            description 'Specify the rule ID.' ;
            type uint32 {
              range 1..2147483644 {
                description 'ID of this rule.' ;
              }

            }

          }

          leaf acl-name {
            description 'ACL Name.' ;
            type acl-name-type ;

          }

          leaf stats-bytes {
            description 'The number of bytes in the packets that match the rule.' ;
            type uint64 ;

            units byte ;
          }

          leaf stats-packets {
            description 'The number of packets that match the rule.' ;
            type uint64 ;

          }

          leaf stats-rate {
            description 'The instantaneous rate of packets that match the rule.' ;
            type uint64 ;

            units bps ;
          }

          ncd:select "if-name if-direction" ;
          ncd:select "if-name if-direction acl-ruleid" ;
        }

      }

      container acl-v6-statistics {
        if-feature ipv6-feature ;

        if-feature acl-statistics ;

        description 'Query the IPv6 type interface granularity statistical data.' ;
        list acl-v6-statistic {
          description 'Query the IPv6 type interface granularity statistical data.' ;
          key 'if-name if-direction acl-ruleid' ;
          leaf if-name {
            description 'Specify the interface name.' ;
            type ncd:ifname ;

          }

          leaf if-direction {
            description 'Specify the interface direction.' ;
            type acl-if-direction ;

          }

          leaf acl-ruleid {
            description 'Specify the rule ID.' ;
            type uint32 {
              range 1..2147483644 {
                description 'ID of this rule.' ;
              }

