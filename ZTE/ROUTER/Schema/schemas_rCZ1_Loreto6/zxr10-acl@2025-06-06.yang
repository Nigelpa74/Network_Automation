                description 'Standard rule type.' ;
                leaf ipv4-protocol-std {
                  description 'Standard rule type.' ;
                  type empty ;

                  mandatory true ;
                }

              }

              case extend {
                description 'Extended rule type.' ;
                container extended {
                  description 'Extended rule type.' ;
                  choice dest-addr {
                    description 'Specify destination IP address.' ;
                    mandatory true ;
                    case dest-ip-address {
                      description 'Destination IP address.' ;
                      leaf dest-address {
                        description 'Destination IP address.' ;
                        type ncd:ipv4-address ;

                        mandatory true ;
                      }

