                        description 'Prefix list name, support 1-169 characters.' ;
                      }

                    }

                    description 'Source prefix list.' ;
                    mandatory true ;
                  }

                  description 'Source prefix list.' ;
                }

                if-feature prefix-list ;

                description 'Source prefix list.' ;
                ncd:revise-date 2023-12-12 ;
              }

            }

            leaf log {
              if-feature log-config ;

              description 'Enable/Disable the function of counting matched packet data.' ;
              type boolean ;

              default false ;
            }

            leaf time-range {
              description 'The name of the time range referenced by the ACL rule.
The referenced time range must exist.' ;
              type string {
                length 1..31 ;

              }

            }

            choice rule-type {
              description 'Specify the rule type of an IPv4 ACL rule.' ;
