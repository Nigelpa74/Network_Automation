                  mandatory true ;
                }

                leaf matchlen7 {
                  description 'Configure the match length.' ;
                  type uint8 {
                    range 1..4 ;

                  }

                  default 2 ;
                }

              }

              container segment8 {
                description 'Configure the eighth segment of the general user-defined template.' ;
                presence segment8 ;
                leaf head-type8 {
                  description 'Configure the general packet header type.' ;
                  type general-template-head-type ;

                  mandatory true ;
                }

                leaf offset8 {
                  description 'Configure the offset value.' ;
                  type uint8 {
                    range 0..77 ;

                  }

                  mandatory true ;
                }

                leaf matchlen8 {
                  description 'Configure the match length.' ;
                  type uint8 {
                    range 1..4 ;

                  }

                  default 2 ;
                }

              }

            }

          }

          ncd:revise-date 2022-01-27 ;
        }

        ncd:revise-date 2017-05-08 ;
      }

      container port-pools {
        if-feature port-pool ;

        description 'Configure ACL port pools.' ;
        list port-pool {
          description 'Configure an ACL port pool.' ;
          key port-pool-name ;
          leaf port-pool-name {
            type acl-port-pool-name ;

            description 'Port pool name.' ;
          }

          container port-pool-items {
            container port-eq-items {
              list port-eq-item {
                description 'Configure a port EQ item.' ;
                key port-eq-value ;
                leaf port-eq-value {
                  type uint16 {
                    range 0..65535 ;

                  }

                  description 'Match packets on a given port number.' ;
                }

              }

              description 'Configure port EQ items.' ;
            }

            container port-ge-item {
              leaf port-ge-value {
                type uint16 {
                  range 0..65535 ;

                }

                description 'Match packets with a no lower port number.' ;
                mandatory true ;
              }

              description 'Configure a port GE item.' ;
              presence port-ge-value ;
            }

            container port-le-item {
              leaf port-le-value {
                type uint16 {
                  range 0..65535 ;

                }

                description 'Match packets with a no greater port number.' ;
                mandatory true ;
              }

              description 'Configure a port LE item.' ;
              presence port-le-value ;
            }

            container port-range-items {
              list port-range-item {
                leaf port-range {
                  type acl-port-range ;

                  description 'Match packets on a given port range.' ;
                }

                description 'Configure a port range item.' ;
                key port-range ;
              }

              description 'Configure port range items.' ;
            }

            description 'Configure port pool items.' ;
          }

          container port-pool-description {
            leaf description {
              type ncd:string-with-blank {
                length 1..79 {
                  description 'Description of an access control list, support 1-79 characters.' ;
                }

              }

              description 'The description of an ACL port pool.' ;
              mandatory true ;
            }

            description 'The description of an ACL port pool.' ;
            presence "Specify acl port pool description" ;
            if-feature port-pool-description ;

            ncd:revise-date 2024-08-13 ;
          }

        }

        ncd:revise-date 2023-12-12 ;
      }

      container access-list {
        description 'Configure the Access Control List (ACL).' ;
        list ipv4-access-list {
          if-feature ipv4-feature ;

          description 'Configure the IPv4 ACL.' ;
          key acl-name ;
          leaf acl-name {
            description 'Specify the ACL name.' ;
            type acl-name-type ;

          }

          list rule {
            description 'Configure an IPv4 ACL rule.' ;
            key ruleid ;
            leaf ruleid {
              description 'Specify the rule ID.' ;
              type uint32 {
                range 1..2147483644 ;

              }

            }

            choice permit-deny {
              description 'Specify the action as either permit or deny.' ;
              case deny {
                description 'Deny the packets that match the rule.' ;
                leaf deny {
                  description 'Deny the packets that match the rule.' ;
                  type empty ;

                  mandatory true ;
                }

              }

              case permit {
                description 'Permit the packets that match the rule.' ;
                leaf permit {
                  description 'Permit the packets that match the rule.' ;
                  type empty ;

                  mandatory true ;
                }

              }

            }

            choice src-addr {
              description 'Specify source IP address.' ;
