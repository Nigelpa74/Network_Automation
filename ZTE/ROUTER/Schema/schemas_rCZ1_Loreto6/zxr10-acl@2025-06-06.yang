            }

            choice src-mac-addr {
              description 'Specify source MAC address.' ;
              case src-mac-addr {
                description 'Source MAC address.' ;
                leaf src-mac-address {
                  description 'Source MAC address.' ;
                  type ncd:mac-address ;

                  mandatory true ;
                }

                leaf src-mac-wildcard {
                  description 'Source MAC address wildcard.' ;
                  type ncd:mac-address ;

                  mandatory true ;
                }

              }

              case src-mac-any {
                description 'Any source MAC address.' ;
                leaf src-mac-any {
                  description 'Any source MAC address.' ;
                  type empty ;

                }

              }

              case src-mac-range {
                if-feature mac-range-config ;

                description 'Source MAC address range.' ;
                leaf src-mac-from1 {
                  description 'The starting value of the first range of source MAC address.' ;
                  type ncd:mac-address ;

                  mandatory true ;
                }

                leaf src-mac-to1 {
                  description 'The ending value of the first range of source MAC address.' ;
                  type ncd:mac-address ;

                  mandatory true ;
                }

                container src-mac-range2 {
                  description 'The second range of source MAC address.' ;
                  presence "config second source mac range" ;
                  leaf src-mac-from2 {
                    description 'The starting value of the second range of source MAC address.' ;
                    type ncd:mac-address ;

                    mandatory true ;
                  }

                  leaf src-mac-to2 {
                    description 'The ending value of the second range of source MAC address.' ;
                    type ncd:mac-address ;

                    mandatory true ;
                  }

                }

              }

            }

            choice dest-mac-addr {
              description 'Specify destination MAC address.' ;
              case dest-mac-addr {
                description 'Destination MAC address.' ;
                leaf dest-mac-address {
                  description 'Destination MAC address.' ;
                  type ncd:mac-address ;

                  mandatory true ;
                }

                leaf dest-mac-wildcard {
                  description 'Destination MAC address wildcard.' ;
                  type ncd:mac-address ;

                  mandatory true ;
                }

              }

              case dest-mac-any {
                description 'Any destination MAC address.' ;
                leaf dest-mac-any {
                  description 'Any destination MAC address.' ;
                  type empty ;

                }

              }

              case dest-mac-range {
                if-feature mac-range-config ;

                description 'Destination MAC address range.' ;
                leaf dest-mac-from1 {
                  description 'The starting value of the first range of destination MAC address.' ;
                  type ncd:mac-address ;

                  mandatory true ;
                }

                leaf dest-mac-to1 {
                  description 'The ending value of the first range of destination MAC address.' ;
                  type ncd:mac-address ;

                  mandatory true ;
                }

                container dest-mac-range2 {
                  description 'The second range of destination MAC address.' ;
                  presence "config second destination mac range" ;
                  leaf dest-mac-from2 {
                    description 'The starting value of the second range of destination MAC address.' ;
                    type ncd:mac-address ;

                    mandatory true ;
                  }

                  leaf dest-mac-to2 {
                    description 'The ending value of the second range of destination MAC address.' ;
                    type ncd:mac-address ;

                    mandatory true ;
                  }

                }

              }

            }

            leaf inner-cos {
              if-feature ipv4-mixed-cos-value ;

              description 'Specify the inner-layer CoS value.' ;
              type uint8 {
                range 0..7 ;

              }

            }

            leaf inner-cos-range {
              if-feature ipv4-mixed-cos-range ;

              description 'Specify the range of inner-layer CoS, supporting single value and range configuration.' ;
              type acl-cos-range ;

              ncd:revise-date 2015-04-20 ;
            }

            leaf outer-cos {
              if-feature ipv4-mixed-cos-value ;

              description 'Specify the outer-layer CoS value.' ;
              type uint8 {
                range 0..7 ;

              }

            }

            leaf outer-cos-range {
              if-feature ipv4-mixed-cos-range ;

              description 'Specify the range of outer-layer CoS, supporting single value and range configuration.' ;
              type acl-cos-range ;

              ncd:revise-date 2015-04-20 ;
            }

            choice vlan-conf {
              description 'Specify VLAN.' ;
              case vlan-value {
                if-feature vlan-value-config ;

                description 'Specify the VLAN value.' ;
                leaf inne-vlan-value {
                  description 'Specify the inner-layer VLAN value.' ;
                  type uint16 {
                    range 1..4094 ;

                  }

                }

                leaf outer-vlan-value {
                  description 'Specify the outer-layer VLAN value.' ;
                  type uint16 {
                    range 1..4094 ;

                  }

                }

              }

              case vlan-range {
                if-feature vlan-range-config ;

                description 'Specify the VLAN range.' ;
                leaf inner-vlan-range {
                  description 'Specify the range of the inner-layer VLAN.' ;
                  type acl-vlan-range ;

                }

                leaf cfi {
                  description 'Specify the CFI.' ;
                  type enumeration {
                    enum set {
                      value 1 ;
                      description 'Match when the flag is set.' ;
                    }

                    enum unset {
                      value 0 ;
                      description 'Match when the flag is not set.' ;
                    }

                  }

                  ncd:revise-date 2017-06-20 ;
                }

                leaf outer-vlan-range {
                  description 'Specify the range of the outer-layer VLAN.' ;
                  type acl-vlan-range ;

                }

                leaf dei {
                  description 'Specify the DEI.' ;
                  type enumeration {
                    enum set {
                      value 1 ;
                      description 'Match when the flag is set.' ;
                    }

                    enum unset {
                      value 0 ;
                      description 'Match when the flag is not set.' ;
                    }

                  }

                  ncd:revise-date 2017-06-20 ;
                }

              }

            }

            choice permit-deny {
              description 'Specify the action as either permit or deny.' ;
              case deny {
                description 'Deny the packets that match the rule.' ;
                leaf deny {
                  description 'Deny the packets that match the rule.' ;
                  type empty ;

                }

              }

              case permit {
                description 'Permit the packets that match the rule.' ;
                leaf permit {
                  description 'Permit the packets that match the rule.' ;
                  type empty ;

                }

              }

            }

            choice src-addr {
              description 'Specify source IP address.' ;
              case src-ip-address {
                description 'Source IP address.' ;
                leaf src-address {
                  description 'Source IP address.' ;
                  type ncd:ipv4-address ;

                  mandatory true ;
                }

                leaf src-wildcard {
                  description 'Source IP address wildcard.' ;
                  type ncd:ipv4-address ;

                  mandatory true ;
                }

              }

              case src-any {
                description 'Any source IP address.' ;
                leaf src-any {
                  description 'Any source IP address.' ;
                  type empty ;

                }

              }

            }

            leaf time-range {
              description 'The name of the time range referenced by the ACL rule.
The referenced time range must exist.' ;
              type string {
                length 1..31 ;

              }

            }

            choice rule-type {
              description 'Specify the rule type of an IPv4 mixed ACL rule.' ;
              case std {
                description 'Standard rule type.' ;
                leaf ipv4-protocol-std {
                  description 'Standard rule type.' ;
                  type empty ;

                }

              }

              case extend {
                description 'Extended rule type.' ;
                container extended {
                  description 'Extended rule type.' ;
                  choice dest-addr {
                    description 'Specify destination IP address.' ;
                    mandatory true ;
                    case dest-ip-address {
                      description 'Destination IP address.' ;
                      leaf dest-address {
                        description 'Destination IP address.' ;
                        type ncd:ipv4-address ;

                        mandatory true ;
                      }

                      leaf dest-wildcard {
                        description 'Destination IP address wildcard.' ;
                        type ncd:ipv4-address ;

                        mandatory true ;
                      }

                    }

                    case dest-any {
                      description 'Any destination IP address.' ;
                      leaf dest-any {
                        description 'Any destination IP address.' ;
                        type empty ;

                      }

                    }

                  }

                  choice priority {
                    description 'Specify the priority of packets.
This is an optional node.
If you set this node you can choose precedence, tos, or dscp.
None means all case is invalid, And the default state is none.' ;
                    case precedence {
                      if-feature ipv4-mixed-pri-value ;

                      description 'Specify the precedence value.' ;
                      leaf precedence {
                        description 'Specify the precedence value.' ;
                        type uint8 {
                          range 0..7 ;

                        }

                      }

                    }

                    case prec-range {
                      if-feature ipv4-mixed-pri-range ;

                      description 'Specify the precedence, supporting single value and range configuration.' ;
                      leaf prec-range {
                        description 'Specify the precedence, supporting single value and range configuration.' ;
                        type acl-prec-range ;

                      }

                      ncd:revise-date 2015-04-20 ;
                    }

                    case tos {
                      description 'Specify the TOS value.' ;
                      leaf tos {
                        description 'Specify the TOS value.' ;
                        type uint8 {
                          range 0..15 ;

                        }

                      }

                    }

                    case dscp {
                      if-feature ipv4-mixed-pri-value ;

                      description 'Specify the DSCP value.' ;
                      leaf dscp {
                        description 'Specify the DSCP value.' ;
                        type uint8 {
                          range 0..63 ;

                        }

                      }

                    }

                    case dscp-range {
                      if-feature ipv4-mixed-pri-range ;

                      description 'Specify the DSCP, supporting single value and range configuration.' ;
                      leaf dscp-range {
                        description 'Specify the DSCP, supporting single value and range configuration.' ;
                        type acl-dscp-range ;

                      }

                      ncd:revise-date 2015-04-20 ;
                    }

                  }

                  leaf fragment {
                    description 'Examine non-initial fragments of packet.' ;
                    type boolean ;

                    default false ;
                  }

                  choice ipv4-protocol-type {
                    description 'IPv4 protocol type.' ;
                    mandatory true ;
                    case udp-tcp {
                      description 'The protocol number is UDP or TCP.' ;
                      container udp-tcp {
                        description 'The protocol number is UDP or TCP.' ;
                        choice udpOrTcp {
                          description 'The protocol number is UDP or TCP.' ;
                          mandatory true ;
                          case udp {
                            description 'The protocol number is UDP.' ;
                            leaf ipv4-protocol-udp {
                              description 'The protocol number is UDP.' ;
                              type empty ;

                            }

                          }

                          case tcp {
                            description 'The protocol number is TCP.' ;
                            leaf ipv4-protocol-tcp {
                              description 'The protocol number is TCP.' ;
                              type empty ;

                              mandatory true ;
                            }

                            leaf established {
                              description 'Specify the flag that indicates whether the TCP protocol initiates a connection establishment.' ;
                              type boolean ;

                              default false ;
                            }

                            leaf rst {
                              description 'Specify the RST flag.' ;
                              type acl-tcp-flag ;

                            }

                            leaf ack {
                              description 'Specify the ACK flag.' ;
                              type acl-tcp-flag ;

                            }

                            leaf fin {
                              description 'Specify the FIN flag.' ;
                              type acl-tcp-flag ;

                            }

                            leaf syn {
                              description 'Specify the SYN flag.' ;
                              type acl-tcp-flag ;

                            }

                            leaf psh {
                              description 'Specify the PSH flag.' ;
                              type acl-tcp-flag ;

                            }

                            leaf urg {
                              description 'Specify the URG flag.' ;
                              type acl-tcp-flag ;

                            }

                          }

                        }

                        choice src-port {
                          status obsolete {
                            ncd:revise-date 2017-07-20 ;
                          }

                          description 'Specify source port.
When the value of operator is invalid, it means match all port range,
the other value of operator means
eq(1)   : match only packets on a given port number
ge(2)   : match only packets with a no lower port number
le(3)   : match only packets with a no greater port number
range(7): match only packet on a given port range.' ;
                          case src-value {
                            status obsolete {
                              ncd:revise-date 2017-07-20 ;
                            }

                            description 'Configure port number.' ;
                            leaf src-value-operator {
                              status obsolete {
                                ncd:revise-date 2017-07-20 ;
                              }

                              description 'Operator type
eq(1)   : match only packets on a given port number
ge(2)   : match only packets with a no lower port number
le(3)   : match only packets with a no greater port number.' ;
                              type enumeration {
                                enum eq {
                                  value 1 ;
                                  description 'Equal to.' ;
                                }

                                enum ge {
                                  value 2 ;
                                  description 'Great than or equal to.' ;
                                }

                                enum le {
                                  value 3 ;
                                  description 'Less than or equal to.' ;
                                }

                              }

                              mandatory true ;
                            }

                            leaf src-port-number {
                              status obsolete {
                                ncd:revise-date 2017-07-20 ;
                              }

                              description 'Port number.' ;
                              type uint16 {
                                range 0..65535 ;

                              }

                              mandatory true ;
                            }

                          }

                          case src-range {
                            status obsolete {
                              ncd:revise-date 2017-07-20 ;
                            }

                            description 'Configure port range.' ;
                            leaf src-range-operator {
                              status obsolete {
                                ncd:revise-date 2017-07-20 ;
                              }

                              description 'Operator type
range(7): match only packet on a given port range.' ;
                              type empty ;

                              mandatory true ;
                            }

                            leaf src-port-range {
                              status obsolete {
                                ncd:revise-date 2017-07-20 ;
                              }

                              description 'Port range.' ;
                              type acl-port-range ;

                              mandatory true ;
                            }

                          }

                        }

                        choice dest-port {
                          status obsolete {
                            ncd:revise-date 2017-07-20 ;
                          }

                          description 'Specify destination port.
When the value of operator is invalid, it means match all port range,
the other value of operator means
eq(1)   : match only packets on a given port number
ge(2)   : match only packets with a no lower port number
le(3)   : match only packets with a no greater port number
range(7): match only packet on a given port range.' ;
                          case dest-value {
                            status obsolete {
                              ncd:revise-date 2017-07-20 ;
                            }

                            description 'Configure port number.' ;
                            leaf dest-value-operator {
                              status obsolete {
                                ncd:revise-date 2017-07-20 ;
                              }

                              description 'Operator type
eq(1)   : match only packets on a given port number
ge(2)   : match only packets with a no lower port number
le(3)   : match only packets with a no greater port number.' ;
                              type enumeration {
                                enum eq {
                                  value 1 ;
                                  description 'Equal to.' ;
                                }

                                enum ge {
                                  value 2 ;
                                  description 'Great than or equal to.' ;
                                }

                                enum le {
                                  value 3 ;
                                  description 'Less than or equal to.' ;
                                }

                              }

                              mandatory true ;
                            }

                            leaf dest-port-number {
                              status obsolete {
                                ncd:revise-date 2017-07-20 ;
                              }

                              description 'Port number.' ;
                              type uint16 {
                                range 0..65535 ;

                              }

                              mandatory true ;
                            }

                          }

                          case dest-range {
                            status obsolete {
                              ncd:revise-date 2017-07-20 ;
                            }

                            description 'Configure port range.' ;
                            leaf dest-range-operator {
                              status obsolete {
                                ncd:revise-date 2017-07-20 ;
                              }

                              description 'Operator type
range(7): match only packet on a given port range.' ;
                              type empty ;

                              mandatory true ;
                            }

                            leaf dest-port-range {
                              status obsolete {
                                ncd:revise-date 2017-07-20 ;
                              }

                              description 'Port range.' ;
                              type acl-port-range ;

                              mandatory true ;
                            }

                          }

                        }

                        container source-port {
                          description 'Specify the source port.' ;
                          presence "Specify source port" ;
                          choice source-port {
                            description 'Specify the source port.' ;
                            mandatory true ;
                            case src-port-value {
                              description 'Specify the value of the source port number.' ;
                              container src-port-value {
                                description 'Specify the value of the source port number.' ;
                                presence "Configure port number" ;
                                leaf src-port-operator {
                                  description 'Specify the operation type of the source port number.' ;
                                  type enumeration {
                                    enum eq {
                                      value 1 ;
                                      description 'Equal to.' ;
                                    }

                                    enum ge {
                                      value 2 ;
                                      description 'Great than or equal to.' ;
                                    }

                                    enum le {
                                      value 3 ;
                                      description 'Less than or equal to.' ;
                                    }

                                  }

                                  mandatory true ;
                                }

                                leaf src-port-value {
                                  description 'Specify the value of the source port number.' ;
                                  type uint16 {
                                    range 0..65535 ;

                                  }

                                  mandatory true ;
                                }

                              }

                            }

                            case src-port-range {
                              description 'Specify the range of the source port number.' ;
                              container src-port-range {
                                description 'Specify the range of the source port number.' ;
                                presence "Configure port range" ;
                                leaf src-port-operator {
                                  description 'Specify the operation type of the source port number.' ;
                                  type enumeration {
                                    enum range {
                                      value 7 ;
                                      description 'Range.' ;
                                    }

                                  }

                                  mandatory true ;
                                }

                                leaf src-port-range {
                                  description 'Specify the range of the source port number.' ;
                                  type acl-port-range ;

                                  mandatory true ;
                                }

                              }

                            }

                          }

                          ncd:revise-date 2017-07-20 ;
                        }

                        container destination-port {
                          description 'Specify the destination port.' ;
                          presence "Specify destination port" ;
                          choice destination-port {
                            description 'Specify the destination port.' ;
                            mandatory true ;
                            case dst-port-value {
                              description 'Specify the value of the destination port number.' ;
                              container dst-port-value {
                                description 'Specify the value of the destination port number.' ;
                                presence "Configure port number" ;
                                leaf dst-port-operator {
                                  description 'Specify the operation type of the destination port number.' ;
                                  type enumeration {
                                    enum eq {
                                      value 1 ;
                                      description 'Equal to.' ;
                                    }

                                    enum ge {
                                      value 2 ;
                                      description 'Great than or equal to.' ;
                                    }

                                    enum le {
                                      value 3 ;
                                      description 'Less than or equal to.' ;
                                    }

                                  }

                                  mandatory true ;
                                }

                                leaf dst-port-value {
                                  description 'Specify the value of the destination port number.' ;
                                  type uint16 {
                                    range 0..65535 ;

                                  }

                                  mandatory true ;
                                }

                              }

                            }

                            case dst-port-range {
                              description 'Specify the range of the destination port number.' ;
                              container dst-port-range {
                                description 'Specify the range of the destination port number.' ;
                                presence "Configure port range" ;
                                leaf dst-port-operator {
                                  description 'Specify the operation type of the destination port number.' ;
                                  type enumeration {
                                    enum range {
                                      value 7 ;
                                      description 'Range.' ;
                                    }

                                  }

                                  mandatory true ;
                                }

                                leaf dst-port-range {
                                  description 'Specify the range of the destination port number.' ;
                                  type acl-port-range ;

                                  mandatory true ;
                                }

                              }

                            }

                          }

                          ncd:revise-date 2017-07-20 ;
                        }

                      }

                    }

                    case icmp {
                      description 'The protocol number is ICMP.' ;
                      leaf ipv4-protocol-icmp {
                        description 'The protocol number is ICMP.' ;
                        type empty ;

                        mandatory true ;
                      }

                      container icmp-conf {
                        description 'Specify the ICMP type and ICMP code.' ;
                        presence "config icmp type and code" ;
                        leaf icmp-type {
                          description 'Specify the ICMP type.' ;
                          type uint16 {
                            range 0..255 ;

                          }

                          mandatory true ;
                        }

                        leaf icmp-code {
                          description 'Specify the ICMP code.' ;
                          type uint16 {
                            range 0..255 ;

                          }

                        }

                      }

                    }

                    case ip {
                      description 'The protocol number is a value excluding TCP, UDP, and ICMP.' ;
                      leaf ipv4-protocol {
                        description 'Specify the IP protocol type excluding TCP, UDP, and ICMP.' ;
                        mandatory true ;
                        type uint16 {
                          range "0 | 2..5 | 7..16 | 18..255 | 65535" ;

                        }

                      }

                      container port {
                        container source-port {
                          choice source-port {
                            case src-port-value {
                              container src-port-value {
                                leaf src-port-operator {
                                  type enumeration {
                                    enum eq {
                                      value 1 ;
                                      description 'Equal to.' ;
                                    }

                                    enum ge {
                                      value 2 ;
                                      description 'Great than or equal to.' ;
                                    }

                                    enum le {
                                      value 3 ;
                                      description 'Less than or equal to.' ;
                                    }

                                  }

                                  description 'Specify the operation type of the source port number.' ;
                                  mandatory true ;
                                }

                                leaf src-port-value {
                                  type uint16 {
                                    range 0..65535 ;

                                  }

                                  description 'Specify the value of the source port number.' ;
                                  mandatory true ;
                                }

                                description 'Specify the value of the source port number.' ;
                                presence "Configure port number" ;
                              }

                              description 'Specify the value of the source port number.' ;
                            }

                            case src-port-range {
                              container src-port-range {
                                leaf src-port-operator {
                                  type enumeration {
                                    enum range {
                                      value 7 ;
                                      description 'Range.' ;
                                    }

                                  }

                                  description 'Specify the operation type of the source port number.' ;
                                  mandatory true ;
                                }

                                leaf src-port-range {
                                  type acl-port-range ;

                                  description 'Specify the range of the source port number.' ;
                                  mandatory true ;
                                }

                                description 'Specify the range of the source port number.' ;
                                presence "Configure port range" ;
                              }

                              description 'Specify the range of the source port number.' ;
                            }

                            description 'Specify the source port.' ;
                            mandatory true ;
                          }

                          description 'Specify the source port.' ;
                          presence "Specify source port" ;
                        }

                        container destination-port {
                          choice destination-port {
                            case dst-port-value {
                              container dst-port-value {
                                leaf dst-port-operator {
                                  type enumeration {
                                    enum eq {
                                      value 1 ;
                                      description 'Equal to.' ;
                                    }

                                    enum ge {
                                      value 2 ;
                                      description 'Great than or equal to.' ;
                                    }

                                    enum le {
                                      value 3 ;
                                      description 'Less than or equal to.' ;
                                    }

                                  }

                                  description 'Specify the operation type of the destination port number.' ;
                                  mandatory true ;
                                }

                                leaf dst-port-value {
                                  type uint16 {
                                    range 0..65535 ;

                                  }

                                  description 'Specify the value of the destination port number.' ;
                                  mandatory true ;
                                }

                                description 'Specify the value of the destination port number.' ;
                                presence "Configure port number" ;
                              }

                              description 'Specify the value of the destination port number.' ;
                            }

                            case dst-port-range {
                              container dst-port-range {
                                leaf dst-port-operator {
                                  type enumeration {
                                    enum range {
                                      value 7 ;
                                      description 'Range.' ;
                                    }

                                  }

                                  description 'Specify the operation type of the destination port number.' ;
                                  mandatory true ;
                                }

                                leaf dst-port-range {
                                  type acl-port-range ;

                                  description 'Specify the range of the destination port number.' ;
                                  mandatory true ;
                                }

                                description 'Specify the range of the destination port number.' ;
                                presence "Configure port range" ;
                              }

                              description 'Specify the range of the destination port number.' ;
                            }

                            description 'Specify the destination port.' ;
                            mandatory true ;
                          }

                          description 'Specify the destination port.' ;
                          presence "Specify destination port" ;
                        }

                        description 'Specify the port. The port is valid when the protocol number is 132.' ;
                        ncd:revise-date 2024-02-27 ;
                      }

                    }

                  }

                  leaf source-monitor-group-id {
                    description 'Specify the source monitor group ID.' ;
                    type uint8 {
                      range 1..63 ;

                    }

                    ncd:revise-date 2020-07-13 ;
                  }

                  leaf destination-monitor-group-id {
                    description 'Specify the destination monitor group ID.' ;
                    type uint8 {
                      range 1..63 ;

                    }

                    ncd:revise-date 2020-07-13 ;
                  }

                }

              }

            }

            leaf exp {
              description 'Specify the MPLS EXP value.' ;
              type uint8 {
                range 0..7 {
                  description 'Value of exp, support 0-7.' ;
                }

              }

              ncd:revise-date 2019-10-08 ;
            }

            leaf label {
              description 'Specify the outermost label value.' ;
              type uint32 {
                range 1..1048575 ;

              }

              ncd:revise-date 2019-10-08 ;
            }

            leaf label2 {
              description 'Specify the second-layer label value.' ;
              type uint32 {
                range 1..1048575 ;

              }

              ncd:revise-date 2019-10-08 ;
            }

            leaf log {
              if-feature ipv4-mixed-log-config ;

              description 'Enable/Disable the function of counting matched packet data.' ;
              type boolean ;

              default false ;
              ncd:revise-date 2019-10-08 ;
            }

            leaf v4mix-desc {
              description 'The description of the rule.' ;
              type ncd:string-with-blank {
                length 1..70 {
                  description 'Direction for use, support 1-70 characters.' ;
                }

              }

