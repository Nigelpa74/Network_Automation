            choice permit-deny {
              description 'Specify the action as either permit or deny.' ;
              case deny {
                description 'Deny the packets that match the rule.' ;
                leaf deny {
                  description 'Deny the packets that match the rule.' ;
                  type empty ;

                }

              }

              case permit {
                description 'Permit the packets that match the rule.' ;
                leaf permit {
                  description 'Permit the packets that match the rule.' ;
                  type empty ;

                }

              }

            }

            leaf flowlabel {
              description 'Specify the flow label.' ;
              type uint32 {
                range 0..1048575 ;

              }

            }

            choice src-addr {
              description 'Specify source IPv6 address.' ;
              case src-ip-address {
                description 'Source IPv6 address.' ;
                leaf src-address {
                  description 'Source IPv6 address.' ;
                  type ncd:ipv6-address ;

                  mandatory true ;
                }

                choice src-wildcard-type {
                  description 'Source IPv6 address wildcard.' ;
                  case wildcard-len {
                    description 'Source IPv6 address prefix length.' ;
                    leaf src-wildcard {
                      description 'Source IPv6 address prefix length.' ;
                      type ncd:ipv6-mask-length ;

                      mandatory true ;
                    }

                  }

                  case wildcard-bits {
                    description 'Source IPv6 address wildcard.' ;
                    leaf src-wildcard-bits {
                      description 'Source IPv6 address wildcard.' ;
                      type ncd:ipv6-address ;

                      mandatory true ;
                    }

                    ncd:revise-date 2021-08-09 ;
                  }

                }

              }

              case src-any {
                description 'Any source IPv6 address.' ;
                leaf src-any {
                  description 'Any source IPv6 address.' ;
                  type empty ;

                }

              }

            }

            choice dest-addr {
              description 'Specify destination IPv6 address.' ;
              case dest-ip-address {
                description 'Destination IPv6 address.' ;
                leaf dest-address {
                  description 'Destination IPv6 address.' ;
                  type ncd:ipv6-address ;

                  mandatory true ;
                }

                choice dest-wildcard-type {
