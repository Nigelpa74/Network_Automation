module zxr10-acl {
  namespace "http://www.zte.com.cn/zxr10/netconf/schema/rosng/acl" ;
  prefix acl ;
  yang-version 1 ;
  import zxr10-netconf-defs {
    prefix ncd ;
  }

  organization "ZTE Corporation" ;
  contact "ZTE Corporation
  Nanjing Institute of ZTE Corporation
  No.68 Zijinghua Rd. Yuhuatai District, Nanjing, China
  Tel: +86-25-52870000" ;
  description 'The netconf module to describe access-list(ACL).' ;
  revision 2025-06-06 {
    description '1. Add the ROSNG-V.VEG product label to the following feature: vxlan-acl-tcp-flag, ip-flags-config.' ;
  }

  revision 2024-12-10 {
    description 'In order to support configuring VRF and label in IPv4 mixed ACL and IPv6 mixed ACL, new nodes are added as follows:
1./configuration/acl/access-list/ipv4-mixed-access-list/rule/vrf;
2./configuration/acl/access-list/ipv6-mixed-access-list/rule/label;
3./configuration/acl/access-list/ipv6-mixed-access-list/rule/label2;
4./configuration/acl/access-list/ipv6-mixed-access-list/rule/vrf.' ;
  }

  revision 2024-11-25 {
    description 'This modification is only for polishing the description.' ;
  }

  revision 2024-08-13 {
    description 'In order to describing link access list and port pool, new nodes are added as follows:
1./configuration/acl/access-list/link-access-list/acl-description;
2./configuration/acl/port-pools/port-pool/port-pool-description.' ;
  }

  revision 2024-06-01 {
    description 'To support TCP flags in VXLAN ACL, add rst, ack, fin, syn, psh, urg leaf nodes the following nodes:
1./configuration/acl/access-list/ipv4-vxlan-access-lists/ipv4-vxlan-access-list/rules/rule/inner-layer/tcp-udp
2./configuration/acl/access-list/ipv4-vxlan-access-lists/ipv4-vxlan-access-list/rules-transit-inner/rule-transit-inner/inner-layer/tcp-udp
3./configuration/acl/access-list/ipv4-vxlan-access-lists/ipv4-vxlan-access-list/rules-vtep-inner/rule-vtep-inner/inner-layer/tcp-udp
4./configuration/acl/access-list/ipv6-vxlan-access-lists/ipv6-vxlan-access-list/rules-transit-inner/rule-transit-inner/inner-layer/tcp-udp
5./configuration/acl/access-list/ipv6-vxlan-access-lists/ipv6-vxlan-access-list/rules-vtep-inner/rule-vtep-inner/inner-layer/tcp-udp' ;
  }

  revision 2024-05-07 {
    description 'Delete project label 15K and T8000 from feature port-pool and prefix-list.' ;
  }

  revision 2024-03-22 {
    description 'To support IP flags in IPv4 VXLAN ACL, add nodes:
1./configuration/acl/access-list/ipv4-vxlan-access-lists/ipv4-vxlan-access-list/rules/rule/inner-layer/ip-flags
2./configuration/acl/access-list/ipv4-vxlan-access-lists/ipv4-vxlan-access-list/rules-transit-inner/rule-transit-inner/inner-layer/ip-flags
3./configuration/acl/access-list/ipv4-vxlan-access-lists/ipv4-vxlan-access-list/rules-vtep-inner/rule-vtep-inner/inner-layer/ip-flags' ;
  }

  revision 2024-02-27 {
    description 'To support SCTP port, add nodes:
1./configuration/acl/access-list/ipv4-mixed-access-list/rule/extended/port
2./configuration/acl/access-list/ipv6-mixed-access-list/rule/port' ;
  }

  revision 2024-01-16 {
    description 'In order to support ACL interface application, add container:
/configuration/acl/interface-applications' ;
  }

  revision 2024-01-04 {
    description 'Add enums of vxlan ACL mode type:
/configuration/acl/access-list/ipv4-vxlan-access-lists/ipv4-vxlan-access-list/mode-type
/configuration/acl/access-list/ipv6-vxlan-access-lists/ipv6-vxlan-access-list/mode-type' ;
  }

  revision 2023-12-12 {
    description '1. To support configuring port pools, add nodes:
/configuration/acl/port-pools;
2. To support matching port pools in IPv4 and IPv6 ACL, add nodes:
/configuration/acl/access-list/ipv4-access-list/rule/rule-type/extend/extended/ipv4-protocol-type/udp-tcp/udp-tcp/source-port/source-port/src-port-pool,
/configuration/acl/access-list/ipv4-access-list/rule/rule-type/extend/extended/ipv4-protocol-type/udp-tcp/udp-tcp/destination-port/destination-port/dst-port-pool,
/configuration/acl/access-list/ipv4-access-list/rule/rule-type/extend/extended/ipv4-protocol-type/icmp/icmp-port/source-port/source-port/src-port-pool,
/configuration/acl/access-list/ipv4-access-list/rule/rule-type/extend/extended/ipv4-protocol-type/icmp/icmp-port/destination-port/destination-port/dst-port-pool,
/configuration/acl/access-list/ipv4-access-list/rule/rule-type/extend/extended/ipv4-protocol-type/ip/port/source-port/source-port/src-port-pool,
/configuration/acl/access-list/ipv4-access-list/rule/rule-type/extend/extended/ipv4-protocol-type/ip/port/destination-port/destination-port/dst-port-pool,
/configuration/acl/access-list/ipv6-access-list/rule/rule-type/udp-tcp/udp-tcp/source-port/source-port/src-port-pool,
/configuration/acl/access-list/ipv6-access-list/rule/rule-type/udp-tcp/udp-tcp/destination-port/destination-port/dst-port-pool,
/configuration/acl/access-list/ipv6-access-list/rule/rule-type/icmp/icmp-port/source-port/source-port/src-port-pool,
/configuration/acl/access-list/ipv6-access-list/rule/rule-type/icmp/icmp-port/destination-port/destination-port/dst-port-pool,
/configuration/acl/access-list/ipv6-access-list/rule/rule-type/ip/port/source-port/source-port/src-port-pool,
/configuration/acl/access-list/ipv6-access-list/rule/rule-type/ip/port/destination-port/destination-port/dst-port-pool;
3. To support matching prefix list in IPv4 and IPv6 ACL, add nodes:
/configuration/acl/access-list/ipv4-access-list/rule/src-addr/src-prefix-list,
/configuration/acl/access-list/ipv4-access-list/rule/rule-type/extend/extended/dest-addr/dest-prefix-list,
/configuration/acl/access-list/ipv6-access-list/rule/src-addr/src-prefix-list,
/configuration/acl/access-list/ipv6-access-list/rule/dest-addr/dest-prefix-list.' ;
  }

  revision 2023-10-07 {
    description 'In order to support statistics for IPv4 and IPv6 VXLAN ACL in outer layer, some nodes are added as follows:
1./configuration/acl/access-list/ipv4-vxlan-access-lists/ipv4-vxlan-access-list/rules-transit-outer/rule-transit-outer/log
2./configuration/acl/access-list/ipv4-vxlan-access-lists/ipv4-vxlan-access-list/rules-vtep-outer/rule-vtep-outer/log
3./configuration/acl/access-list/ipv6-vxlan-access-lists/ipv6-vxlan-access-list/rules-transit-outer/rule-transit-outer/log
4./configuration/acl/access-list/ipv6-vxlan-access-lists/ipv6-vxlan-access-list/rules-vtep-outer/rule-vtep-outer/log' ;
  }

  revision 2022-01-27 {
    description '1. Add log in user defined template ACL:
/configuration/acl/access-list/user-defined-template-acls/user-defined-template-acl/rules/rule/log
2. Support user defined template ACL statistics switch:
/configuration/acl/statistics-switch/user-defined-template-log-switches;
3. Support user defined template ACL statistics clear:
/operation/acl/user-defined-template-log-clears;
4. Add general user defined template:
/configuration/acl/templates/udf-template-generals.' ;
  }

  revision 2022-01-20 {
    description 'In order to support statistics for IPv4 and IPv6 VXLAN ACL, some nodes are added as follows:
1./configuration/acl/access-list/ipv4-vxlan-access-lists/ipv4-vxlan-access-list/rules/rule/log
2./configuration/acl/access-list/ipv4-vxlan-access-lists/ipv4-vxlan-access-list/rules-transit-inner/rule-transit-inner/log
3./configuration/acl/access-list/ipv4-vxlan-access-lists/ipv4-vxlan-access-list/rules-vtep-inner/rule-vtep-inner/log
4./configuration/acl/access-list/ipv6-vxlan-access-lists/ipv6-vxlan-access-list/rules-transit-inner/rule-transit-inner/log
5./configuration/acl/access-list/ipv6-vxlan-access-lists/ipv6-vxlan-access-list/rules-vtep-inner/rule-vtep-inner/log
6./configuration/acl/statistics-switch/ipv4-vxlan-log-switches-by-acl
7./configuration/acl/statistics-switch/ipv6-vxlan-log-switches-by-acl
8./operation/acl/ipv4-vxlan-log-clears-by-acl
9./operation/acl/ipv6-vxlan-log-clears-by-acl
10./state/acl/acl-v4-vxlan-statistics-by-acl
11./state/acl/acl-v6-vxlan-statistics-by-acl' ;
  }

  revision 2021-11-23 {
    description 'To support default action configuration in empty ACL, some leaf nodes are added as follows:
1./configuration/acl/port-acl/if-ipv4/egress/none-rule-default-action;
2./configuration/acl/port-acl/if-ipv4/ingress/none-rule-default-action;
3./configuration/acl/port-acl/if-ipv6/egress/none-rule-default-action;
4./configuration/acl/port-acl/if-ipv6/ingress/none-rule-default-action;
5./configuration/acl/port-acl/if-link/egress/none-rule-default-action;
6./configuration/acl/port-acl/if-link/ingress/none-rule-default-action.' ;
  }

  revision 2021-11-02 {
    description 'To support clear ACL statistics in all interface, some list nodes are changed to choice-case nodes, and some container nodes are added in choice nodes.
1./operation/acl/ipv4-log-clears;
2./operation/acl/ipv6-log-clears;
3./operation/acl/link-log-clears;
4./operation/acl/ipv4-mixed-log-clears;' ;
  }

  revision 2021-10-26 {
    description 'In order to support vxlan link ACL, some nodes are added as follows:
1. /configuration/acl/access-list/ipv4-vxlan-access-lists/ipv4-vxlan-access-list/rules-transit-inner/rule-transit-inner/l2-layer;
2. /configuration/acl/access-list/ipv4-vxlan-access-lists/ipv4-vxlan-access-list/rules-vtep-inner/rule-vtep-inner/l2-layer;
3. /configuration/acl/access-list/ipv6-vxlan-access-lists/ipv6-vxlan-access-list/rules-transit-inner/rule-transit-inner/l2-layer;
4. /configuration/acl/access-list/ipv6-vxlan-access-lists/ipv6-vxlan-access-list/rules-vtep-inner/rule-vtep-inner/l2-layer;' ;
  }

  revision 2021-10-20 {
    description 'Add some nodes to support obtaining statistics by ACL:
