                  description 'VXLAN ID.' ;
                }

              }

            }

            leaf direction {
              description 'Specify the VXLAN instance direction.' ;
              type acl-if-direction ;

            }

            leaf acl-name {
              description 'Configure the IPv4 VXLAN ACL name.' ;
              type acl-name-type {
                length 1..31 {
