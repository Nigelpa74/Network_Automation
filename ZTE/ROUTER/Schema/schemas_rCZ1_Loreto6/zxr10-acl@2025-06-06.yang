/configuration/acl/access-list/ipv6-mixed-access-list/rule/exp.' ;
  }

  revision 2021-06-03 {
    description 'In order to support statistics for IPv6 mixed ACL, some nodes are added as follows:
1.Add new feature: ipv6-mixed-log-config
2./configuration/acl/access-list/ipv6-mixed-access-list/rule/log
3./configuration/acl/statistics-switch/ipv6-mixed-log-switchs
4./operation/acl/ipv6-mixed-log-clears
5./state/acl/acl-v6-mixed-statistics' ;
  }

  revision 2021-04-02 {
    description '1.Add time-range nodes in IPv4 vxlan rule as follows:
/configuration/acl/access-list/ipv4-vxlan-access-lists/ipv4-vxlan-access-list/rules/rule/time-range;
