The referenced time range must exist.' ;
              type string {
                length 1..31 ;

              }

            }

            leaf routing {
              description 'Specify the routing header.' ;
              type boolean ;

              default false ;
            }

            leaf authen {
              description 'Specify the authentication header.' ;
              type boolean ;

              default false ;
            }

            leaf destopts {
              description 'Specify the destination options header.' ;
              type boolean ;

              default false ;
            }

            leaf fragment {
              description 'Specify the fragment header.' ;
              type boolean ;

              default false ;
            }

            leaf hop-by-hop {
              description 'Specify the hop-by-hop options header.' ;
