  typedef acl-name-type {
    type string {
      length 1..31 ;

    }

    description 'The definition of ACL name type, support 1-31 characters.' ;
  }

  typedef acl-port-range {
    type ncd:single-range {
      pattern "((([1-9][0-9]{1,3})|([1-9][0-9]{0,0})|0|([1-5][0-9]{4,4})|(6[0-4][0-9]{3,3})|(65[0-4][0-9]{2,2})|(655[0-2][0-9]{1,1})|(6553[0-4])|65535)(-(([1-9][0-9]{1,3})|([1-9][0-9]{0,0})|0|([1-5][0-9]{4,4})|(6[0-4][0-9]{3,3})|(65[0-4][0-9]{2,2})|(655[0-2][0-9]{1,1})|(6553[0-4])|65535)){0,1})" ;

    }

    description 'The definition of ACL port range, support <0-65535>-<0-65535>.' ;
  }

  typedef acl-vlan-range {
    type ncd:single-range {
      pattern "((([1-9][0-9]{1,2})|([2-9][0-9]{0,0})|1|([1-3][0-9]{3,3})|(40[0-8][0-9]{1,1})|(409[0-3])|4094)(-(([1-9][0-9]{1,2})|([2-9][0-9]{0,0})|1|([1-3][0-9]{3,3})|(40[0-8][0-9]{1,1})|(409[0-3])|4094)){0,1})" ;

    }

    description 'The definition of ACL VLAN range, support <1-4094>-<1-4094>.' ;
  }

  typedef acl-ttl-range {
    type ncd:single-range {
      pattern "((([1-9][0-9]{1,1})|([2-9][0-9]{0,0})|1|([1-1][0-9]{2,2})|(2[0-4][0-9]{1,1})|(25[0-4])|255)(-(([1-9][0-9]{1,1})|([2-9][0-9]{0,0})|1|([1-1][0-9]{2,2})|(2[0-4][0-9]{1,1})|(25[0-4])|255)){0,1})" ;

    }

    description 'The definition of ACL TTL range, support <1-255>-<1-255>.' ;
  }

  typedef acl-tcp-flag {
    type enumeration {
      enum - {
        value 0 ;
        description 'Match when the flag not set.' ;
      }

      enum "+" {
        value 1 ;
        description 'Match when the flag set.' ;
      }

    }

    description 'The definition of ACL TCP flag.' ;
  }

  typedef acl-prec-range {
    type ncd:single-range {
      pattern "((([0-7]-[0-7])|([0-7])){1,1})" ;

    }

    description 'The definition of ACL Precedence range, support <0-7>-<0-7>.' ;
  }

  typedef acl-dscp-range {
    type ncd:single-range {
      pattern "((((([1-9][0-9]{0,0})|0|([1-5][0-9]{1,1})|(6[0-2])|63)-(([1-9][0-9]{0,0})|0|([1-5][0-9]{1,1})|(6[0-2])|63))|(([1-9][0-9]{0,0})|0|([1-5][0-9]{1,1})|(6[0-2])|63)){1,1})" ;

    }

    description 'The definition of ACL DSCP range, support <0-63>-<0-63>.' ;
  }

  typedef acl-cos-range {
    type ncd:single-range {
      pattern "((([0-7]-[0-7])|([0-7])){1,1})" ;

    }

    description 'The definition of ACL CoS range, support <0-7>-<0-7>.' ;
  }

  typedef acl-if-direction {
    type enumeration {
      enum egress {
        value 0 ;
        description 'Direction egress.' ;
      }

      enum ingress {
        value 1 ;
        description 'Direction ingress.' ;
      }

    }

    description 'The definition of interface direction, as follows,
     egress  Direction egress
     ingress Direction ingress.' ;
  }

  typedef acl-vrf-name {
    type string {
      length 1..32 {
        description 'VPN Routing/Forwarding instance name, support 1-32 characters.' ;
      }

    }

    description 'VPN Routing/Forwarding instance name, support 1-32 characters.' ;
  }

  typedef acl-pktlen-opr {
    type enumeration {
      enum eq {
        value 1 ;
        description 'Match only packets on a given packet length.' ;
      }

      enum gt {
        value 4 ;
        description 'Match only packets with a greater packet length.' ;
      }

      enum lt {
        value 5 ;
        description 'Match only packets with a lower packet length.' ;
      }

      enum neq {
        value 6 ;
        description 'Match only packets not on a given packet length.' ;
      }

    }

    description 'Packet length operator, such as 
  eq   Match only packets on a given packet length
  gt   Match only packets with a greater packet length
  lt   Match only packets with a lower packet length
  neq  Match only packets not on a given packet length.' ;
  }

  typedef acl-pktlen-range {
    type ncd:single-range {
      pattern "((([1-9][0-9]{1,3})|([2-9][0-9]{0,0})|1|([1-5][0-9]{4,4})|(6[0-4][0-9]{3,3})|(65[0-4][0-9]{2,2})|(655[0-2][0-9]{1,1})|(6553[0-4])|65535)(-(([1-9][0-9]{1,3})|([2-9][0-9]{0,0})|1|([1-5][0-9]{4,4})|(6[0-4][0-9]{3,3})|(65[0-4][0-9]{2,2})|(655[0-2][0-9]{1,1})|(6553[0-4])|65535)){0,1})" ;

    }

    description 'Match only packets on a given packet length range, support <1-65535>-<1-65535>.' ;
  }

  typedef vxlan-head-type {
    type enumeration {
      enum outer-l2-head {
        value 1 ;
        description 'outer-l2-head' ;
      }

      enum vxlan-head {
        value 2 ;
        description 'vxlan-head' ;
      }

      enum vxlan-in-v4 {
        value 3 ;
        description 'vxlan-in-v4' ;
      }

      enum vxlan-in-v4-gre {
        value 4 ;
        description 'vxlan-in-v4-gre' ;
      }

    }

    description 'The definition of head type, as follows,  
  outer-l2-head    Outer-l2-head(1)
  vxlan-head       Vxlan-head(2)
  vxlan-in-v4      Vxlan-Inner-ipv4(3)
  vxlan-in-v4-gre  Vxlan-Inner-ipv4-gre(4)' ;
  }

  typedef general-template-head-type {
    type enumeration {
      enum l2-head {
        value 1 ;
        description 'Offset from L2-head' ;
      }

      enum l3-head {
        value 2 ;
        description 'Offset from L3-head' ;
      }

      enum l4-head {
        value 3 ;
        description 'Offset from L4-head' ;
      }

    }

    description 'The definition of head type, as follows,  
  l2-head    Offset from L2-head(1)
  l3-head    Offset from L3-head(2)
  l4-head    Offset from L4-head(3)' ;
  }

  typedef acl-port-pool-name {
    type string {
      length 1..31 ;

    }

    description 'The definition of ACL port pool name type, support 1-31 characters.' ;
  }

  typedef acl-if-application-mode-type {
    type enumeration {
      enum overwrite {
        value 1 ;
        description 'overwrite mode' ;
      }

    }

    description 'The definition of interface application mode type, as follows:
             overwrite(1) overwrite mode' ;
  }

  container configuration {
    description 'Configuration model.' ;
    container acl {
      description 'Configuration related to ACL.' ;
      container templates {
        if-feature udf-template-type ;

        description 'Configure user-defined template.' ;
        container udf-template-vxlans {
          if-feature udf-template-type ;

          description 'Configure VXLAN user-defined template.' ;
          list udf-template-vxlan {
            if-feature udf-template-type ;

            description 'Configure VXLAN user-defined template.' ;
            key template-name ;
            leaf template-name {
              description 'The template name of the VXLAN user-defined template.' ;
              type acl-name-type ;

            }

            container format {
              description 'Configure the format of the VXLAN user-defined template.' ;
              presence format ;
              container segment1 {
                description 'Configure the first segment of the VXLAN user-defined template.' ;
                presence segment1 ;
                leaf head-type1 {
                  description 'Configure the VXLAN packet header type.' ;
                  type vxlan-head-type ;

                  mandatory true ;
                }

                leaf offset1 {
                  description 'Configure the offset value.' ;
                  type uint8 {
                    range 0..77 ;

                  }

                  mandatory true ;
                }

                leaf matchlen1 {
                  description 'Configure the match length.' ;
                  type uint8 {
                    range 1..4 ;

                  }

                  default 2 ;
                }

              }

              container segment2 {
                description 'Configure the second segment of the VXLAN user-defined template.' ;
                presence segment2 ;
                leaf head-type2 {
                  description 'Configure the VXLAN packet header type.' ;
                  type vxlan-head-type ;

                  mandatory true ;
                }

                leaf offset2 {
                  description 'Configure the offset value.' ;
                  type uint8 {
