12./state/acl/acl-v6-statistics-by-acl
13./state/acl/acl-link-statistics-by-acl
14./state/acl/acl-v4-mixed-statistics-by-acl
15./state/acl/acl-v6-mixed-statistics-by-acl' ;
  }

  revision 2021-08-09 {
    description 'IPv6 wildcard leaf nodes are changed to choice-case nodes, and wildcard-bits case nodes are added in wildcard choice nodes:
1./acl:configuration/acl:acl/acl:access-list/acl:ipv6-access-list/acl:rule/acl:src-wildcard-type;
