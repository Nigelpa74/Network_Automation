                        }

                        description 'Operator type
eq(1)   : match only packets on a given port number
ge(2)   : match only packets with a no lower port number
le(3)   : match only packets with a no greater port number.' ;
                        type enumeration {
                          enum eq {
                            value 1 ;
                            description 'Equal to.' ;
                          }

                          enum ge {
                            value 2 ;
                            description 'Great than or equal to.' ;
                          }

                          enum le {
                            value 3 ;
                            description 'Less than or equal to.' ;
                          }

                        }

                        mandatory true ;
                      }

                      leaf dest-port-number {
                        status obsolete {
                          ncd:revise-date 2017-07-20 ;
                        }

                        description 'Port number.' ;
                        type uint16 {
                          range 0..65535 ;

                        }

                        mandatory true ;
                      }

                    }

                    case dest-range {
                      status obsolete {
                        ncd:revise-date 2017-07-20 ;
                      }

                      description 'Configure port range.' ;
                      leaf dest-range-operator {
                        status obsolete {
                          ncd:revise-date 2017-07-20 ;
                        }

                        description 'Operator type
range(7): match only packet on a given port range.' ;
                        type empty ;

                        mandatory true ;
                      }

                      leaf dest-port-range {
                        status obsolete {
                          ncd:revise-date 2017-07-20 ;
                        }

                        description 'Port range.' ;
                        type acl-port-range ;

                        mandatory true ;
                      }

                    }

                  }

                  container source-port {
                    description 'Specify the source port.' ;
                    presence "Specify source port" ;
                    choice source-port {
                      description 'Specify the source port.' ;
                      mandatory true ;
                      case src-port-value {
                        description 'Specify the value of the source port number.' ;
                        container src-port-value {
                          description 'Specify the value of the source port number.' ;
                          presence "Configure port number" ;
                          leaf src-port-operator {
                            description 'Specify the operation type of the source port number.' ;
                            type enumeration {
                              enum eq {
                                value 1 ;
                                description 'Equal to.' ;
                              }

                              enum ge {
                                value 2 ;
                                description 'Great than or equal to.' ;
                              }

                              enum le {
                                value 3 ;
                                description 'Less than or equal to.' ;
                              }

                            }

                            mandatory true ;
                          }

                          leaf src-port-value {
                            description 'Specify the value of the source port number.' ;
                            type uint16 {
                              range 0..65535 ;

                            }

                            mandatory true ;
                          }

                        }

                      }

                      case src-port-range {
                        description 'Specify the range of the source port number.' ;
                        container src-port-range {
                          description 'Specify the range of the source port number.' ;
                          presence "Configure port range" ;
                          leaf src-port-operator {
                            description 'Specify the operation type of the source port number.' ;
                            type enumeration {
                              enum range {
                                value 7 ;
                                description 'Range.' ;
                              }

                            }

                            mandatory true ;
                          }

                          leaf src-port-range {
                            description 'Specify the range of the source port number.' ;
                            type acl-port-range ;

                            mandatory true ;
                          }

                        }

                      }

                    }

                    ncd:revise-date 2017-07-20 ;
                  }

                  container destination-port {
                    description 'Specify the destination port.' ;
                    presence "Specify destination port" ;
                    choice destination-port {
                      description 'Specify the destination port.' ;
                      mandatory true ;
                      case dst-port-value {
                        description 'Specify the value of the destination port number.' ;
                        container dst-port-value {
                          description 'Specify the value of the destination port number.' ;
                          presence "Configure port number" ;
                          leaf dst-port-operator {
                            description 'Specify the operation type of the destination port number.' ;
                            type enumeration {
                              enum eq {
                                value 1 ;
                                description 'Equal to.' ;
                              }

                              enum ge {
                                value 2 ;
                                description 'Great than or equal to.' ;
                              }

                              enum le {
                                value 3 ;
                                description 'Less than or equal to.' ;
                              }

                            }

                            mandatory true ;
                          }

                          leaf dst-port-value {
                            description 'Specify the value of the destination port number.' ;
                            type uint16 {
                              range 0..65535 ;

                            }

                            mandatory true ;
                          }

                        }

                      }

                      case dst-port-range {
                        description 'Specify the range of the destination port number.' ;
                        container dst-port-range {
                          description 'Specify the range of the destination port number.' ;
                          presence "Configure port range" ;
                          leaf dst-port-operator {
                            description 'Specify the operation type of the destination port number.' ;
                            type enumeration {
                              enum range {
                                value 7 ;
                                description 'Range.' ;
                              }

                            }

                            mandatory true ;
                          }

                          leaf dst-port-range {
                            description 'Specify the range of the destination port number.' ;
                            type acl-port-range ;

                            mandatory true ;
                          }

                        }

                      }

                    }

                    ncd:revise-date 2017-07-20 ;
                  }

                }

              }

              case icmp {
                description 'The protocol number is ICMP.' ;
                leaf ipv6-protocol-icmp {
                  description 'The protocol number is ICMP.' ;
                  type empty ;

                  mandatory true ;
                }

                container icmp-conf {
                  description 'Specify the ICMP type and ICMP code.' ;
                  presence "config icmp type and code" ;
                  leaf icmp-type {
                    description 'Specify the ICMP type.' ;
                    type uint16 {
                      range 0..255 ;

                    }

                    mandatory true ;
                  }

                  leaf icmp-code {
                    description 'Specify the ICMP code.' ;
                    type uint16 {
                      range 0..255 ;

                    }

                  }

                }

              }

              case ip {
                description 'The protocol number is a value excluding TCP, UDP, and ICMP.' ;
                leaf ipv6-protocol {
                  description 'Specify the IPv6 protocol type excluding TCP, UDP, and ICMP.' ;
                  mandatory true ;
                  type uint16 {
                    range "0..5 | 7..16 | 18..57 | 59..255 | 65535" ;

                  }

                }

                container port {
                  description 'Specify the port. The port is valid when the protocol number is 132.' ;
                  container source-port {
                    description 'Specify the source port.' ;
                    presence "Specify source port" ;
                    choice source-port {
                      description 'Specify the source port.' ;
                      mandatory true ;
                      case src-port-value {
                        description 'Specify the value of the source port number.' ;
                        container src-port-value {
                          description 'Specify the value of the source port number.' ;
                          presence "Configure port number" ;
                          leaf src-port-operator {
                            description 'Specify the operation type of the source port number.' ;
                            type enumeration {
                              enum eq {
                                value 1 ;
                                description 'Equal to.' ;
                              }

                              enum ge {
                                value 2 ;
                                description 'Great than or equal to.' ;
                              }

                              enum le {
                                value 3 ;
                                description 'Less than or equal to.' ;
                              }

                            }

                            mandatory true ;
                          }

                          leaf src-port-value {
                            description 'Specify the value of the source port number.' ;
                            type uint16 {
                              range 0..65535 ;

                            }

                            mandatory true ;
                          }

                        }

                      }

                      case src-port-range {
                        description 'Specify the range of the source port number.' ;
                        container src-port-range {
                          description 'Specify the range of the source port number.' ;
                          presence "Configure port range" ;
                          leaf src-port-operator {
                            description 'Specify the operation type of the source port number.' ;
                            type enumeration {
                              enum range {
                                value 7 ;
                                description 'Range.' ;
                              }

                            }

                            mandatory true ;
                          }

                          leaf src-port-range {
                            description 'Specify the range of the source port number.' ;
                            type acl-port-range ;

                            mandatory true ;
                          }

                        }

                      }

                    }

                  }

                  container destination-port {
                    description 'Specify the destination port.' ;
                    presence "Specify destination port" ;
                    choice destination-port {
                      description 'Specify the destination port.' ;
                      mandatory true ;
                      case dst-port-value {
                        description 'Specify the value of the destination port number.' ;
                        container dst-port-value {
                          description 'Specify the value of the destination port number.' ;
                          presence "Configure port number" ;
                          leaf dst-port-operator {
                            description 'Specify the operation type of the destination port number.' ;
                            type enumeration {
                              enum eq {
                                value 1 ;
                                description 'Equal to.' ;
                              }

                              enum ge {
                                value 2 ;
                                description 'Great than or equal to.' ;
                              }

                              enum le {
                                value 3 ;
                                description 'Less than or equal to.' ;
                              }

                            }

                            mandatory true ;
                          }

                          leaf dst-port-value {
                            description 'Specify the value of the destination port number.' ;
                            type uint16 {
                              range 0..65535 ;

                            }

                            mandatory true ;
                          }

                        }

                      }

                      case dst-port-range {
                        description 'Specify the range of the destination port number.' ;
                        container dst-port-range {
                          description 'Specify the range of the destination port number.' ;
                          presence "Configure port range" ;
                          leaf dst-port-operator {
                            description 'Specify the operation type of the destination port number.' ;
                            type enumeration {
                              enum range {
                                value 7 ;
                                description 'Range.' ;
                              }

                            }

                            mandatory true ;
                          }

                          leaf dst-port-range {
                            description 'Specify the range of the destination port number.' ;
                            type acl-port-range ;

                            mandatory true ;
                          }

                        }

                      }

                    }

                  }

                  ncd:revise-date 2024-02-27 ;
                }

              }

            }

            leaf v6mix-desc {
              description 'The description of the rule.' ;
              type ncd:string-with-blank {
                length 1..70 {
                  description 'Direction for use, support 1-70 characters.' ;
                }

              }

              ncd:revise-date 2019-12-06 ;
            }

            leaf log {
              if-feature ipv6-mixed-log-config ;

              description 'Enable/Disable the function of counting matched packet data.' ;
              type boolean ;

              default false ;
              ncd:revise-date 2021-06-03 ;
            }

            leaf exp {
              description 'Specify the MPLS EXP value.' ;
              type uint8 {
                range 0..7 {
                  description 'Value of exp, support 0-7.' ;
                }

              }

              ncd:revise-date 2021-08-04 ;
            }

            leaf label {
              type uint32 {
                range 1..1048575 ;

              }

              if-feature ipv6-mixed-label ;

              description 'Specify the outermost label value.' ;
              ncd:revise-date 2024-12-10 ;
            }

            leaf label2 {
              type uint32 {
                range 1..1048575 ;

              }

              if-feature ipv6-mixed-label2 ;

              description 'Specify the second-layer label value.' ;
              ncd:revise-date 2024-12-10 ;
            }

            leaf vrf {
              type acl-vrf-name {
                length 1..32 {
                  description 'VPN Routing/Forwarding instance name, support 1-32 characters.' ;
                }

              }

              if-feature ipv6-mixed-vrf ;

              description 'Specify the VRF instance name.
The referenced VRF must exist.' ;
              ncd:revise-date 2024-12-10 ;
            }

          }

          container acl-description {
            description 'The description of the ACL.' ;
            presence "Specify acl description" ;
            leaf acl-description {
              description 'The description of the ACL.' ;
              type ncd:string-with-blank {
                length 1..79 {
                  description 'Description of an access control list, support 1-79 characters.' ;
                }

              }

              mandatory true ;
            }

            ncd:revise-date 2020-06-29 ;
          }

        }

        list link-access-list {
          if-feature link-feature ;

          description 'Configure the link ACL.' ;
          key acl-name ;
          leaf acl-name {
            description 'Specify the ACL name.' ;
            type acl-name-type ;

          }

          list rule {
            description 'Configure a link ACL rule.' ;
            key ruleid ;
            leaf ruleid {
              description 'Specify the rule ID.' ;
              type uint32 {
                range 1..2147483644 ;

              }

            }

            choice permit-deny {
              description 'Specify the action as either permit or deny.' ;
              case deny {
                description 'Deny the packets that match the rule.' ;
                leaf deny {
                  description 'Deny the packets that match the rule.' ;
                  type empty ;

                  mandatory true ;
                }

              }

              case permit {
                description 'Permit the packets that match the rule.' ;
                leaf permit {
                  description 'Permit the packets that match the rule.' ;
                  type empty ;

                  mandatory true ;
                }

              }

            }

            choice link-prot {
              description 'Specify the link protocol type.' ;
              case link-protocol {
                description 'Specify the link protocol type.' ;
                leaf link-protocol {
                  description 'Specify the link protocol type.' ;
                  type uint32 {
                    range 1536..65535 ;

                  }

                }

                leaf link-protocol-mask {
                  description 'Specify the link protocol mask in hexadecimal format.' ;
                  type ncd:hex {
                    length 3..6 ;

                  }

                  ncd:revise-date 2017-06-02 ;
                }

              }

              case link-protocol-hex {
                if-feature link-prot-hex-config ;

                description 'Specify the link protocol in hexadecimal format.' ;
                leaf link-protocol-hex {
                  description 'Specify the link protocol in hexadecimal format.' ;
                  type ncd:hex ;

                }

                leaf link-protocol-hex-mask {
                  description 'Specify the link protocol mask in hexadecimal format.' ;
                  type ncd:hex {
                    length 3..6 ;

                  }

                  ncd:revise-date 2017-06-02 ;
                }

              }

              case sap {
                if-feature sap-feature ;

                description 'Specify the Service Access Point (SAP).' ;
                container dsap-ssap {
                  description 'Specify the Destination Service Access Point (DSAP) and the Source Service Access Point (SSAP).' ;
                  presence "config dsap and ssap" ;
                  leaf dsap {
                    description 'Specify the DSAP.' ;
                    type uint16 {
                      range 0..255 ;

                    }

                    mandatory true ;
                  }

                  leaf ssap {
                    description 'Specify the SSAP.' ;
                    type uint16 {
                      range 0..255 ;

                    }

                    mandatory true ;
                  }

                }

                ncd:revise-date 2017-07-12 ;
              }

            }

            choice src-mac-addr {
              description 'Specify source MAC address.' ;
              case src-mac-addr {
                description 'Source MAC address.' ;
                leaf src-mac-address {
                  description 'Source MAC address.' ;
                  type ncd:mac-address ;

                  mandatory true ;
                }

                leaf src-mac-wildcard {
                  description 'Source MAC address wildcard.' ;
                  type ncd:mac-address ;

                  mandatory true ;
                }

              }

              case src-mac-any {
                description 'Any source MAC address.' ;
                leaf src-mac-any {
                  description 'Any source MAC address.' ;
                  type empty ;

                  mandatory true ;
                }

              }

              case src-mac-range {
                if-feature mac-range-config ;

                description 'Source MAC address range.' ;
                leaf src-mac-from1 {
                  description 'The starting value of the first range of source MAC address.' ;
                  type ncd:mac-address ;

                  mandatory true ;
                }

                leaf src-mac-to1 {
                  description 'The ending value of the first range of source MAC address.' ;
                  type ncd:mac-address ;

                  mandatory true ;
                }

                container src-mac-range2 {
                  description 'The second range of source MAC address.' ;
                  presence "config second source mac range" ;
                  leaf src-mac-from2 {
                    description 'The starting value of the second range of source MAC address.' ;
                    type ncd:mac-address ;

                    mandatory true ;
                  }

                  leaf src-mac-to2 {
                    description 'The ending value of the second range of source MAC address.' ;
                    type ncd:mac-address ;

                    mandatory true ;
                  }

                }

              }

            }

            choice dest-mac-addr {
              description 'Specify destination MAC address.' ;
              case dest-mac-addr {
                description 'Destination MAC address.' ;
                leaf dest-mac-address {
                  description 'Destination MAC address.' ;
                  type ncd:mac-address ;

                  mandatory true ;
                }

                leaf dest-mac-wildcard {
                  description 'Destination MAC address wildcard.' ;
                  type ncd:mac-address ;

                  mandatory true ;
                }

              }

              case dest-mac-any {
                description 'Any destination MAC address.' ;
                leaf dest-mac-any {
                  description 'Any destination MAC address.' ;
                  type empty ;

                  mandatory true ;
                }

              }

              case dest-mac-range {
                if-feature mac-range-config ;

                description 'Destination MAC address range.' ;
                leaf dest-mac-from1 {
                  description 'The starting value of the first range of destination MAC address.' ;
                  type ncd:mac-address ;

                  mandatory true ;
                }

                leaf dest-mac-to1 {
                  description 'The ending value of the first range of destination MAC address.' ;
                  type ncd:mac-address ;

                  mandatory true ;
                }

                container dest-mac-range2 {
                  description 'The second range of destination MAC address.' ;
                  presence "config second destination mac range" ;
                  leaf dest-mac-from2 {
                    description 'The starting value of the second range of destination MAC address.' ;
                    type ncd:mac-address ;

                    mandatory true ;
                  }

                  leaf dest-mac-to2 {
                    description 'The ending value of the second range of destination MAC address.' ;
                    type ncd:mac-address ;

                    mandatory true ;
                  }

                }

              }

            }

            leaf inner-cos {
              if-feature link-cos-value ;

              description 'Specify the inner-layer CoS value.' ;
              type uint8 {
                range 0..7 ;

              }

            }

            leaf inner-cos-range {
              if-feature link-cos-range ;

              description 'Specify the range of inner-layer CoS, supporting single value and range configuration.' ;
              type acl-cos-range ;

              ncd:revise-date 2015-04-20 ;
            }

            leaf outer-cos {
              if-feature link-cos-value ;

              description 'Specify the outer-layer CoS value.' ;
              type uint8 {
                range 0..7 ;

              }

            }

            leaf outer-cos-range {
              if-feature link-cos-range ;

              description 'Specify the range of outer-layer CoS, supporting single value and range configuration.' ;
              type acl-cos-range ;

              ncd:revise-date 2015-04-20 ;
            }

            choice vlan-conf {
              description 'Specify VLAN.' ;
              case vlan-value {
                if-feature vlan-value-config ;

                description 'Specify the VLAN value.' ;
                leaf inne-vlan-value {
                  description 'Specify the inner-layer VLAN value.' ;
                  type uint16 {
                    range 1..4094 ;

                  }

                }

                leaf outer-vlan-value {
                  description 'Specify the outer-layer VLAN value.' ;
                  type uint16 {
                    range 1..4094 ;

                  }

                }

              }

              case vlan-range {
                if-feature vlan-range-config ;

                description 'Specify the VLAN range.' ;
                leaf inner-vlan-range {
                  description 'Specify the range of the inner-layer VLAN.' ;
                  type acl-vlan-range ;

                }

                leaf cfi {
                  description 'Specify the CFI.' ;
                  type enumeration {
                    enum set {
                      value 1 ;
                      description 'Match when the flag is set.' ;
                    }

                    enum unset {
                      value 0 ;
                      description 'Match when the flag is not set.' ;
                    }

                  }

                  ncd:revise-date 2017-06-20 ;
                }

                leaf outer-vlan-range {
                  description 'Specify the range of the outer-layer VLAN.' ;
                  type acl-vlan-range ;

                }

                leaf dei {
                  description 'Specify the DEI.' ;
                  type enumeration {
                    enum set {
                      value 1 ;
                      description 'Match when the flag is set.' ;
                    }

                    enum unset {
                      value 0 ;
                      description 'Match when the flag is not set.' ;
                    }

                  }

                  ncd:revise-date 2017-06-20 ;
                }

              }

            }

            leaf time-range {
              description 'The name of the time range referenced by the ACL rule.
The referenced time range must exist.' ;
              type string {
                length 1..31 ;

              }

            }

            leaf log {
              if-feature link-log-config ;

              description 'Enable/Disable the function of counting matched packet data.' ;
              type boolean ;

              default false ;
              ncd:revise-date 2015-04-20 ;
            }

            leaf description {
              description 'The description of the rule.' ;
              type ncd:string-with-blank {
                length 1..70 {
                  description 'Direction for use, support 1-70 characters.' ;
                }

              }

              ncd:revise-date 2016-08-18 ;
            }

            leaf vrf {
              description 'Specify the VRF instance name.
The referenced VRF must exist.' ;
              type acl-vrf-name {
                length 1..32 {
                  description 'VPN Routing/Forwarding instance name, support 1-32 characters.' ;
                }

              }

              ncd:revise-date 2017-06-20 ;
            }

            leaf exp {
              description 'Specify the MPLS EXP value.' ;
              type uint8 {
                range 0..7 {
                  description 'Value of exp, support 0-7.' ;
                }

              }

              ncd:revise-date 2017-06-20 ;
            }

            leaf label {
              description 'Specify the outermost label value.' ;
              type uint32 {
                range 1..1048575 ;

              }

              ncd:revise-date 2019-06-18 ;
            }

            leaf label2 {
              description 'Specify the second-layer label value.' ;
              type uint32 {
                range 1..1048575 ;

              }

              ncd:revise-date 2019-06-18 ;
            }

          }

          container acl-description {
            leaf acl-description {
              type ncd:string-with-blank {
                length 1..79 {
                  description 'Description of an access control list, support 1-79 characters.' ;
                }

              }

              description 'The description of the ACL.' ;
              mandatory true ;
            }

            description 'The description of the ACL.' ;
            presence "Specify acl description" ;
            if-feature link-acl-description ;

            ncd:revise-date 2024-08-13 ;
          }

        }

        list user-protocol-access-list {
          if-feature user-protocol-feature ;

          description 'Configure the user protocol ACL.' ;
          key acl-name ;
          leaf acl-name {
            description 'Specify the ACL name.' ;
            type acl-name-type ;

          }

          list rule {
            description 'Configure a user protocol ACL rule.' ;
            key ruleid ;
            leaf ruleid {
              description 'Specify the rule ID.' ;
              type uint32 {
                range 1..2147483644 ;

              }

            }

            choice ethernet-type {
              description 'Specify the ethernet protocol type or any ethernet protocol type.' ;
              mandatory true ;
              case any-ethernet-type {
                description 'Any ethernet protocol type.' ;
                leaf any {
                  description 'Any ethernet protocol type.' ;
                  type empty ;

                }

              }

              case ethernet-type-value {
                description 'Specify the ethernet protocol type.' ;
                leaf ether-type {
                  description 'Specify the ethernet protocol type.' ;
                  type ncd:hex {
                    pattern "((0x){1}([1-9]|[a-f]|[A-F]){1}([0-9]|[a-f]|[A-F]){0,3})" ;

                  }

                }

              }

            }

            leaf destination-mac {
              description 'Destination MAC address.' ;
              type ncd:mac-address ;

              mandatory true ;
            }

            leaf destination-mac-wildcard {
              description 'Destination MAC address wildcard.' ;
              type ncd:mac-address ;

              mandatory true ;
            }

          }

          ncd:revise-date 2015-11-04 ;
        }

        list user-defined-list {
          if-feature user-defined-feature ;

          description 'Configure the user-defined ACL.' ;
          key acl-name ;
          leaf acl-name {
            description 'Specify the ACL name.' ;
            type acl-name-type ;

          }

          list rule {
            description 'Configure a user-defined ACL rule.' ;
            key ruleid ;
            leaf ruleid {
              description 'Specify the rule ID.' ;
              type uint32 {
                range 1..2147483644 ;

              }

            }

            choice permit-deny {
              description 'Specify the action as either permit or deny.' ;
              mandatory true ;
              case deny {
                description 'Deny the packets that match the rule.' ;
                leaf deny {
                  description 'Deny the packets that match the rule.' ;
                  type empty ;

                }

              }

              case permit {
                description 'Permit the packets that match the rule.' ;
                leaf permit {
                  description 'Permit the packets that match the rule.' ;
                  type empty ;

                  mandatory true ;
                }

              }

            }

            leaf frame-type {
              description 'Specify the ethernet frame type.' ;
              type enumeration {
                enum any {
                  value 4 ;
                  description 'Any frame.' ;
                }

                enum ethernet2 {
                  value 1 ;
                  description 'Ethernet version II frame.' ;
                }

                enum llc-snap {
                  value 2 ;
                  description 'LLC/SNAP frame in IEEE802.3.' ;
                }

                enum sap {
                  value 3 ;
                  description 'SAP frame in IEEE802.3.' ;
                }

              }

              mandatory true ;
            }

            leaf tag-status {
              description 'Specify the status of the VLAN tag.' ;
              type enumeration {
                enum untag {
                  value 1 ;
                  description 'Status with no VLAN tag.' ;
                }

                enum single-tag {
                  value 2 ;
                  description 'Status with VLAN tag.' ;
                }

                enum double-tag {
                  value 3 ;
                  description 'Status with outer and inner VLAN tag.' ;
                }

                enum any {
                  value 4 ;
                  description 'Any status with VLAN tag.' ;
                }

              }

              mandatory true ;
            }

            leaf ip-flag {
              description 'Specify the type of IP packet header.' ;
              type enumeration {
                enum ip4-hdr-only {
                  value 1 ;
                  description 'Segment of only IPv4 header.' ;
                }

                enum ip6-hdr-only {
                  value 2 ;
                  description 'Segment of only IPv6 header.' ;
                }

                enum ip6-fragment {
                  value 3 ;
                  description 'Segment of IPv6 fragment.' ;
                }

                enum ip4-over-ip4 {
                  value 4 ;
                  description 'Segment of IPv4 datagram over IPv4.' ;
                }

                enum ip6-over-ip4 {
                  value 5 ;
                  description 'Segment of IPv6 datagram over IPv4' ;
                }

                enum ip6-fragment-over-ip4 {
                  value 6 ;
                  description 'Segment of IPv6 fragment datagram over IPv4.' ;
                }

                enum ip4-over-ip6 {
                  value 7 ;
                  description 'Segment of IPv4 datagram over IPv6.' ;
                }

                enum ip6-over-ip6 {
                  value 8 ;
                  description 'Segment of IPv6 datagram over IPv6.' ;
                }

                enum gre-ip4-over-ip4 {
                  value 9 ;
                  description 'Segment of IPv4 datagram over IPv4 by GRE.' ;
                }

                enum gre-ip6-over-ip4 {
                  value 10 ;
                  description 'Segment of IPv6 datagram over IPv4 by GRE.' ;
                }

                enum gre-ip4-over-ip6 {
                  value 11 ;
                  description 'Segment of IPv4 datagram over IPv6 by GRE.' ;
                }

                enum gre-ip6-over-ip6 {
                  value 12 ;
                  description 'Segment of IPv6 datagram over IPv6 by GRE.' ;
                }

                enum ip-unused {
                  value 13 ;
                  description 'None IP format datagram.' ;
                }

                enum one-mpls-label {
                  value 14 ;
                  description 'Segment of the first label out of tunnel.' ;
                }

                enum two-mpls-labels {
                  value 15 ;
                  description 'Segment of the second label in tunnel.' ;
                }

                enum any-mpls-labels {
                  value 16 ;
                  description 'Segment of any or multiple MPLS label.' ;
                }

                enum any {
                  value 17 ;
                  description 'Any segment' ;
                }

              }

              mandatory true ;
            }

            choice segment-type {
              description 'Type of the rule segment.' ;
              mandatory true ;
              case any-segment {
                description 'Any rule segment.' ;
                leaf any {
                  description 'Any rule segment.' ;
                  type empty ;

                  mandatory true ;
                }

              }

              case segment {
                description 'Configure the rule segment.' ;
                container segment1 {
                  description 'Configure the first segment.' ;
                  leaf offset {
                    description 'The first match field offset.' ;
                    type uint32 {
                      range 2..126 ;

                    }

                    mandatory true ;
                  }

                  leaf rule-string {
                    description 'The first match field value.' ;
                    type string {
                      length 10 {
                        description 'User defined hexadecimal string,as follows:
0x00000000-0xffffffff.' ;
                      }

                    }

                    mandatory true ;
                  }

                  leaf rule-mask {
                    description 'The first match field mask.' ;
                    type string {
                      length 10 {
                        description 'User defined hexadecimal string mask,as follows:
0x00000000-0xffffffff.' ;
                      }

                    }

                    mandatory true ;
                  }

                  container segment2 {
                    description 'Configure the second segment.' ;
                    presence segment2 ;
                    leaf offset {
                      description 'The second match field offset.' ;
                      type uint32 {
                        range 2..126 ;

                      }

                      mandatory true ;
                    }

                    leaf rule-string {
                      description 'The second match field value.' ;
                      type string {
                        length 10 {
                          description 'User defined hexadecimal string,as follows:
0x00000000-0xffffffff.' ;
                        }

                      }

                      mandatory true ;
                    }

                    leaf rule-mask {
                      description 'The second match field mask.' ;
                      type string {
                        length 10 {
                          description 'User defined hexadecimal string mask,as follows:
0x00000000-0xffffffff.' ;
                        }

                      }

                      mandatory true ;
                    }

                    container segment3 {
                      description 'Configure the third segment.' ;
                      presence segment3 ;
                      leaf offset {
                        description 'The third match field offset.' ;
                        type uint32 {
                          range 2..126 ;

                        }

                        mandatory true ;
                      }

                      leaf rule-string {
                        description 'The third match field value.' ;
                        type string {
                          length 10 {
                            description 'User defined hexadecimal string,as follows:
0x00000000-0xffffffff.' ;
                          }

                        }

                        mandatory true ;
                      }

                      leaf rule-mask {
                        description 'The third match field mask.' ;
                        type string {
                          length 10 {
                            description 'User defined hexadecimal string mask,as follows:
0x00000000-0xffffffff.' ;
                          }

                        }

                        mandatory true ;
                      }

                      container segment4 {
                        description 'Configure the fourth segment.' ;
                        presence segment4 ;
                        leaf offset {
                          description 'The fourth match field offset.' ;
                          type uint32 {
                            range 2..126 ;

                          }

                          mandatory true ;
                        }

                        leaf rule-string {
                          description 'The fourth match field value.' ;
                          type string {
                            length 10 {
                              description 'User defined hexadecimal string,as follows:
0x00000000-0xffffffff.' ;
                            }

                          }

                          mandatory true ;
                        }

                        leaf rule-mask {
                          description 'The fourth match field mask.' ;
                          type string {
                            length 10 {
                              description 'User defined hexadecimal string mask,as follows:
0x00000000-0xffffffff.' ;
                            }

                          }

                          mandatory true ;
                        }

                      }

                    }

                  }

                }

              }

            }

            leaf time-range {
              description 'The name of the time range referenced by the ACL rule.
The referenced time range must exist.' ;
              type string {
                length 1..31 ;

              }

            }

          }

          ncd:revise-date 2015-12-23 ;
        }

        container ipv4-vxlan-access-lists {
          description 'Configure the IPv4 VXLAN ACL.' ;
          list ipv4-vxlan-access-list {
            if-feature ipv4-vxlan-feature ;

            description 'Configure the IPv4 VXLAN ACL.' ;
            key acl-name ;
            leaf acl-name {
              description 'Specify the ACL name.' ;
              type acl-name-type ;

            }

            leaf without-vni {
              description 'Configure rules without virtual network ID.' ;
              type empty ;

            }

            leaf mode-type {
              description 'Mode type of the IPv4 VXLAN ACL.' ;
              type enumeration {
                enum transit-inner {
                  value 1 ;
                  description 'Transit node match VXLAN inner layer' ;
                }

                enum transit-outer {
                  value 2 ;
                  description 'Transit node match VXLAN outer layer' ;
                }

                enum vtep-inner {
                  value 3 ;
                  description 'VTEP node match VXLAN inner layer' ;
                }

                enum vtep-outer {
                  value 4 ;
                  description 'VTEP node match VXLAN outer layer' ;
                }

                enum outer-v4-transit-inner {
                  value 5 ;
                  description 'Transit node match VXLAN inner layer whose underlay is IPv4' ;
                }

                enum outer-v6-transit-inner {
                  value 6 ;
                  description 'Transit node match VXLAN inner layer whose underlay is IPv6' ;
                }

                enum outer-v4-vtep-inner {
                  value 7 ;
                  description 'VTEP node match VXLAN inner layer whose underlay is IPv4' ;
                }

                enum outer-v6-vtep-inner {
                  description 'VTEP node match VXLAN inner layer whose underlay is IPv6' ;
                  value 8 ;
                }

              }

              ncd:revise-date 2018-09-17 ;
            }

            container rules {
              description 'Configure the IPv4 VXLAN ACL rules in default mode.
An IPv4 VXLAN ACL without a mode type must be configured first.' ;
              list rule {
                description 'Configure an IPv4 VXLAN ACL rule in default mode.' ;
                key ruleid ;
                leaf ruleid {
                  description 'Specify the rule ID.' ;
                  type uint32 {
                    range 1..2147483644 ;

                  }

                }

                choice permit-deny {
                  description 'Specify the action as either permit or deny.' ;
                  mandatory true ;
                  case deny {
                    description 'Deny the packets that match the rule.' ;
                    leaf deny {
                      description 'Deny the packets that match the rule.' ;
                      type empty ;

                      mandatory true ;
                    }

                  }

                  case permit {
                    description 'Permit the packets that match the rule.' ;
                    leaf permit {
                      description 'Permit the packets that match the rule.' ;
                      type empty ;

                      mandatory true ;
                    }

                  }

                }

                container inner-layer {
                  description 'The inner-layer protocol of VXLAN.' ;
                  choice protocol-type {
                    description 'IPv4 protocol type.' ;
                    mandatory true ;
                    case tcp-udp {
                      description 'The protocol number is UDP or TCP.' ;
                      container tcp-udp {
                        description 'The protocol number is UDP or TCP.' ;
                        leaf tcp-udp {
                          description 'The protocol number is UDP or TCP.' ;
                          type enumeration {
                            enum tcp {
                              value 6 ;
                              description 'Transmission Control Protocol(6)' ;
                            }

                            enum udp {
                              value 17 ;
                              description 'User Datagram Protocol(17)' ;
                            }

                          }

                          mandatory true ;
                        }

                        choice src-addr {
                          description 'Specify source IP address.' ;
                          mandatory true ;
                          case addr-type {
                            description 'Source IP address.' ;
                            leaf src-address {
                              description 'Source IP address.' ;
                              type ncd:ipv4-address ;

                              mandatory true ;
                            }

                            leaf src-wildcard {
                              description 'Source IP address wildcard.' ;
                              type ncd:ipv4-address ;

                              mandatory true ;
                            }

                          }

                          case any-type {
                            description 'Any source IP address.' ;
                            leaf src-any-addr {
                              description 'Any source IP address.' ;
                              type empty ;

                              mandatory true ;
                            }

                          }

                        }

                        choice src-port {
                          status obsolete {
                            ncd:revise-date 2017-07-20 ;
                          }

                          description 'Configure source port.' ;
                          case src-oper {
                            status obsolete {
                              ncd:revise-date 2017-07-20 ;
                            }

                            description 'Configure source port.' ;
                            leaf src-oper {
                              status obsolete {
                                ncd:revise-date 2017-07-20 ;
                              }

                              description 'source port operator.
Operator type
eq(1)   : match only packets on a given port number
ge(2)   : match only packets with a no lower port number
le(3)   : match only packets with a no greater port number.' ;
                              type enumeration {
                                enum eq {
                                  value 1 ;
                                  description 'Match only packets on a given port number.' ;
                                }

                                enum ge {
                                  value 2 ;
                                  description 'Match only packets with a no lower port number.' ;
                                }

                                enum le {
                                  value 3 ;
                                  description 'Match only packets with a no greater port number.' ;
                                }

                              }

                              mandatory true ;
                            }

                            leaf src-port-number {
                              status obsolete {
                                ncd:revise-date 2017-07-20 ;
                              }

                              description 'Configure port number from 0 to 65535.' ;
                              type uint16 {
                                range 0..65535 ;

                              }

                              mandatory true ;
                            }

                          }

                          case src-range {
                            status obsolete {
                              ncd:revise-date 2017-07-20 ;
                            }

                            description 'configure range type source port.' ;
                            leaf src-range {
                              status obsolete {
                                ncd:revise-date 2017-07-20 ;
                              }

                              description 'configure range type source port.' ;
                              type empty ;

                              mandatory true ;
                            }

                            leaf src-range-value {
                              status obsolete {
                                ncd:revise-date 2017-07-20 ;
                              }

                              description 'Port range.' ;
                              type acl-port-range ;

                              mandatory true ;
                            }

                          }

                        }

                        container source-port {
                          description 'Specify the source port.' ;
                          presence "Specify source port" ;
                          choice source-port {
                            description 'Specify the source port.' ;
                            mandatory true ;
                            case src-port-value {
                              description 'Specify the value of the source port number.' ;
                              container src-port-value {
                                description 'Specify the value of the source port number.' ;
                                presence "Configure port number" ;
                                leaf src-port-operator {
                                  description 'Specify the operation type of the source port number.' ;
                                  type enumeration {
                                    enum eq {
                                      value 1 ;
                                      description 'Equal to.' ;
                                    }

                                    enum ge {
                                      value 2 ;
                                      description 'Great than or equal to.' ;
                                    }

                                    enum le {
                                      value 3 ;
                                      description 'Less than or equal to.' ;
                                    }

                                  }

                                  mandatory true ;
                                }

                                leaf src-port-value {
                                  description 'Specify the value of the source port number.' ;
                                  type uint16 {
                                    range 0..65535 ;

                                  }

                                  mandatory true ;
                                }

                              }

                            }

                            case src-port-range {
                              description 'Specify the range of the source port number.' ;
                              container src-port-range {
                                description 'Specify the range of the source port number.' ;
                                presence "Configure port range" ;
                                leaf src-port-operator {
                                  description 'Specify the operation type of the source port number.' ;
                                  type enumeration {
                                    enum range {
                                      value 7 ;
                                      description 'Range.' ;
                                    }

                                  }

                                  mandatory true ;
                                }

                                leaf src-port-range {
                                  description 'Specify the range of the source port number.' ;
                                  type acl-port-range ;

                                  mandatory true ;
                                }

                              }

                            }

                          }

                          ncd:revise-date 2017-07-20 ;
                        }

                        choice dst-addr {
                          description 'Specify destination IP address.' ;
                          mandatory true ;
                          case addr-type {
                            description 'Destination IP address.' ;
                            leaf dst-address {
                              description 'Destination IP address.' ;
                              type ncd:ipv4-address ;

                              mandatory true ;
                            }

                            leaf dst-wildcard {
                              description 'Destination IP address wildcard.' ;
                              type ncd:ipv4-address ;

                              mandatory true ;
                            }

                          }

                          case any-type {
                            description 'Any destination IP address.' ;
                            leaf dst-any-addr {
                              description 'Any destination IP address.' ;
                              type empty ;

                              mandatory true ;
                            }

                          }

                        }

                        choice dst-port {
                          status obsolete {
                            ncd:revise-date 2017-07-20 ;
                          }

                          description 'Configure destination port.' ;
                          case dst-oper {
                            status obsolete {
                              ncd:revise-date 2017-07-20 ;
                            }

                            description 'Configure destination port with operator flag.' ;
                            leaf dst-oper {
                              status obsolete {
                                ncd:revise-date 2017-07-20 ;
                              }

                              description 'Operator type
eq(1)   : match only packets on a given port number
ge(2)   : match only packets with a no lower port number
le(3)   : match only packets with a no greater port number.' ;
                              type enumeration {
                                enum eq {
                                  value 1 ;
                                  description 'Match only packets on a given port number.' ;
                                }

                                enum ge {
                                  value 2 ;
                                  description 'Match only packets with a no lower port number.' ;
                                }

                                enum le {
                                  value 3 ;
                                  description 'Match only packets with a no greater port number.' ;
                                }

                              }

                              mandatory true ;
                            }

                            leaf dst-port-number {
                              status obsolete {
                                ncd:revise-date 2017-07-20 ;
                              }

                              description 'Configure port number from 0 to 65535.' ;
                              type uint16 {
                                range 0..65535 ;

                              }

                              mandatory true ;
                            }

                          }

                          case dst-range {
                            status obsolete {
                              ncd:revise-date 2017-07-20 ;
                            }

                            description 'Configure destination port in range type.' ;
                            leaf dst-range {
                              status obsolete {
                                ncd:revise-date 2017-07-20 ;
                              }

                              description 'Range operator.' ;
                              type empty ;

                              mandatory true ;
                            }

                            leaf dst-range-value {
                              status obsolete {
                                ncd:revise-date 2017-07-20 ;
                              }

                              description 'Destination port range.' ;
                              type acl-port-range ;

                              mandatory true ;
                            }

                          }

                        }

                        container destination-port {
                          description 'Specify the destination port.' ;
                          presence "Specify destination port" ;
                          choice destination-port {
                            description 'Specify the destination port.' ;
                            mandatory true ;
                            case dst-port-value {
                              description 'Specify the value of the destination port number.' ;
                              container dst-port-value {
                                description 'Specify the value of the destination port number.' ;
                                presence "Configure port number" ;
                                leaf dst-port-operator {
                                  description 'Specify the operation type of the destination port number.' ;
                                  type enumeration {
                                    enum eq {
                                      value 1 ;
                                      description 'Equal to.' ;
                                    }

                                    enum ge {
                                      value 2 ;
                                      description 'Great than or equal to.' ;
                                    }

                                    enum le {
                                      value 3 ;
                                      description 'Less than or equal to.' ;
                                    }

                                  }

                                  mandatory true ;
