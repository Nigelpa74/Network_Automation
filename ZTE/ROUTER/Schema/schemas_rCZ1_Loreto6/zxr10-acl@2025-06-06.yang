        }

        ncd:revise-date 2016-03-04 ;
      }

      container statistics-switch {
        if-feature acl-statistics ;

        description 'Configure ACL statistics switches.' ;
        presence "Configure ACL log statistics switch" ;
        container ipv4-log-switchs {
          if-feature ipv4-feature ;

          description 'Configure the IPv4 type interface granularity statistics switch.' ;
          list ipv4-log-switch {
            description 'Configure the IPv4 type interface granularity statistics switch.' ;
            key 'if-name if-direction' ;
            leaf if-name {
              description 'Specify the interface name.' ;
              type ncd:ifname ;

            }

            leaf if-direction {
              description 'Specify the interface direction.' ;
              type acl-if-direction ;

            }

            choice switch-option {
              description 'Configure the statistics switch.' ;
              mandatory true ;
              case off {
                description 'Turn off the statistics.' ;
                leaf off {
                  description 'Turn off the statistics.' ;
                  type empty ;

                  mandatory true ;
                }

              }

              case on {
                description 'Turn on the statistics.' ;
                leaf on {
                  description 'Turn on the statistics.' ;
                  type empty ;

                  mandatory true ;
                }

                leaf action {
                  description 'Specify the action of the rule to be counted.' ;
                  type enumeration {
                    enum permit {
                      value 1 ;
                      description 'Enable permit ACL log.' ;
                    }

                    enum deny {
                      value 2 ;
                      description 'Enable deny ACL log.' ;
                    }

                    enum all {
                      value 3 ;
                      description 'Enable all ACL log.' ;
                    }

                  }

                  mandatory true ;
                }

