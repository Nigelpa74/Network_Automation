module zxr10-igmp-snooping {
  namespace "http://www.zte.com.cn/zxr10/netconf/schema/rosng/igmp-snooping" ;
  prefix igs ;
  yang-version 1 ;
  import zxr10-netconf-defs {
    prefix ncd ;
    revision-date 2013-11-22 ;
  }

  organization "ZTE Corporation" ;
  contact "ZTE Corporation
  Nanjing Institute of ZTE Corporation
  No.68 Zijinghua Rd. Yuhuatai District, Nanjing, China
  Tel: +86-25-52870000" ;
  description 'The netconf module to describe IGMP snooping.' ;
  revision 2025-09-04 {
    description 'Modified description spell error.' ;
  }

  revision 2024-10-29 {
    description 'Add ssm-mapping' ;
  }

  revision 2023-06-05 {
    description 'Change the Type of leaf node /igs:state/igs:igmp-snooping/igs:evpn-vpls/igs:member/igs:interface-name from ncd:ifname to string, range: 1-59.
Add product 5960X for feature topology-change.' ;
  }

  revision 2022-12-22 {
    description 'add leaf node
/igs:configuration/igs:igmp-snooping/igs:evpn-vplses/igs:evpn-vpls/igs:mapping-host-to-multicast' ;
  }

  revision 2022-10-13 {
    description 'add leaf node
/igs:configuration/igs:igmp-snooping/igs:vlans/igs:vlan/igs:mapping-host-to-multicast' ;
  }

  revision 2022-07-15 {
    description 'add leaf node
/igs:configuration/igs:igmp-snooping/igs:evpn-vplses/igs:evpn-vpls/igs:learning-peer-link' ;
  }

  revision 2022-06-14 {
    description 'Add container:
/igs:configuration/igs:igmp-snooping/vlans/vlan/block-sending-to-mrouters/
Add list:
/igs:configuration/igs:igmp-snooping/vlans/vlan/block-sending-to-mrouters/block-sending-to-mrouter/
add leaf node
/igs:configuration/igs:igmp-snooping/igs:vlans/igs:vlan/igs:block-sending-to-mrouters/igs:block-sending-to-mrouter/igs:group-ip.
add feature block-sending-to-mrouter' ;
  }

  revision 2021-10-19 {
    description 'Add container:
/igs:configuration/igs:igmp-snooping/vlans/vlan/mvlan/
/igs:configuration/igs:igmp-snooping/vlans/vlan/mvlan/default/
add leaf node
/igs:configuration/igs:igmp-snooping/igs:vlans/igs:vlan/igs:mvlan/igs:default/igs:m-vlan-id.
add feature mvlan' ;
  }

  revision 2020-07-15 {
    description 'Add default value for node /igs:configuration/igs:igmp-snooping/igs:global/igs:host-aging-closedown' ;
  }

  revision 2019-12-05 {
    description 'add leaf node
/igs:state/igs:igmp-snooping/igs:vbui/igs:member/igs:present-time,
/igs:state/igs:igmp-snooping/igs:vrf/igs:member/igs:present-time,
/igs:state/igs:igmp-snooping/igs:vxlan/igs:member/igs:present-time,
/igs:state/igs:igmp-snooping/igs:ring-tree/igs:member/igs:present-time,
/igs:state/igs:igmp-snooping/igs:vxlan/igs:mrouter/igs:present-time,
/igs:state/igs:igmp-snooping/igs:ring-tree/igs:mrouter/igs:present-time.
add feature mvpls general-state-mrouter' ;
  }

  revision 2019-11-04 {
    description 'Add container:
/igs:configuration/igs:igmp-snooping/global/logging/
Add node:
/igs:configuration/igs:igmp-snooping/global/logging/packet-report;
/igs:configuration/igs:igmp-snooping/global/logging/overrun-report;
add feature:logging' ;
  }

  revision 2019-10-08 {
    description 'Remove the project tag of 99 from the vxlan feature.' ;
  }

  revision 2018-08-07 {
    description 'Add node:/igs:configuration/igs:igmp-snooping/global/querier-send-to-mrouter;
/igs:configuration/igs:igmp-snooping/igs:vpls/igs:vpls/querier-send-to-mrouter;
/igs:configuration/igs:igmp-snooping/igs:vpls/igs:vpls/interface/querier-send-to-mrouter;
/igs:configuration/igs:igmp-snooping/igs:vlans/igs:vlan/querier-send-to-mrouter;
/igs:configuration/igs:igmp-snooping/igs:vlans/igs:vlan/interfaces/interface/querier-send-to-mrouter;
add feature:querier-send-to-mrouter' ;
  }

  revision 2018-07-03 {
    description 'Add the default value to the leaf redundancy-pw-mrouter-transmitting in list VPLS.' ;
  }

  revision 2018-06-13 {
    description 'Add path:/igs:configuration/igs:igmp-snooping/igs:evpn-vpls, /state/igmp-snooping/evpn-vpls,operation/igmp-snooping/clear/group/instance/evpn-vpls,operation/igmp-snooping/clear/groups/type/evpn-vpls
Add feature:evpn-vpls' ;
  }

  revision 2018-05-30 {
    description 'Add leaf node:/igs:configuration/igs:igmp-snooping/igs:vlans/igs:vlan/igs:query-interval
Add feature:vlan-query-interval' ;
  }

  revision 2018-04-03 {
    description 'Add leaf node:/igs:configuration/igs:igmp-snooping/igs:vpls/igs:vpls/igs:redundancy-pw-mrouter-transmitting.
Add typedef:redundancy-pw-transmitting-type.
Add feature:redundancy-pw-mrouter-transmitting.' ;
  }

  revision 2018-02-12 {
    description 'Add path:/igs:configuration/igs:igmp-snooping/igs:global/igs:host-aging-closedown,
/igs:configuration/igs:igmp-snooping/igs:global/igs:transmit-pkt,
/igs:configuration/igs:igmp-snooping/igs:vlans/igs:vlan/igs:max-member-num,
/igs:configuration/igs:igmp-snooping/igs:vlans/igs:vlan/igs:topology-chg,
/igs:configuration/igs:igmp-snooping/igs:vlans/igs:vlan/igs:group-spe-query-suppress,
/igs:configuration/igs:igmp-snooping/igs:ip-global,
/igs:configuration/igs:igmp-snooping/igs:groups,
/igs:configuration/igs:igmp-snooping/igs:interfaces,
/igs:state/igs:igmp-snooping/igs:vpls/igs:member/igs:present-time,
/igs:state/igs:igmp-snooping/igs:vlan/igs:member/igs:present-time,
/igs:state/igs:igmp-snooping/igs:ip-global/igs:member/igs:present-time,
/igs:state/igs:igmp-snooping/igs:mrouter/igs:present-time.
Add feature:host-aging-closedown,transmit-to-block-port,topology-change,max-host-in-group,max-host-in-interface,max-host-in-vlan,group-specific-query-suppress,supervlan-member,transmit-from-block-port,group,interface,mrouter-version.' ;
  }

  revision 2017-10-27 {
    description 'Add path:/igs:configuration/igs:igmp-snooping/igs:ring-trees, /state/igmp-snooping/ring-tree,operation/igmp-snooping/clear/group/instance/ring-tree,operation/igmp-snooping/clear/groups/type/ring-tree
Add feature:ring-tree' ;
  }

  revision 2017-07-27 {
    description 'Add path:/igs:configuration/igs:igmp-snooping/igs:vxlans/igs:vxlan/igs:mrouters/igs:mrouter/igs:untag;/igs:configuration/igs:igmp-snooping/igs:vxlans/igs:vxlan/igs:members/igs:member/igs:untag' ;
  }

  revision 2017-05-23 {
    description 'Add path:configuration/igmp-snooping/vxlans, state/igmp-snooping/vxlan,operation/igmp-snooping/clear/group/instance/vxlan,operation/igmp-snooping/clear/groups/type/vxlan
Add feature:vpls,vlan,vxlan,vbui,vrf,ip-global' ;
  }

  revision 2016-11-08 {
    description "Add path:state/igmp-snooping/mrouter's query term: vlan-id+interface-name,vpls-name+interface-name" ;
  }

  revision 2015-11-25 {
    description 'Modify leaf node attribute, node path:/configuration/igmp-snooping/vpls/vpls/m-vpls/default/m-vpls-name' ;
  }

  revision 2015-10-30 {
    description 'Add leaf node, node path: /state/igmp-snooping/mrouter/querier-ip.' ;
  }

  revision 2015-09-15 {
    description 'Modify leaf node type, node path: /operation/igmp-snooping/clear/groups/type/ip-global/ip-global, /operation/igmp-snooping/clear/groups/type/all/all-groups, /operation/igmp-snooping/clear/group/instance/ip-global/ip-global.' ;
  }

  revision 2015-06-05 {
    description 'Modify /configuration/igmp-snooping/vpls/vpls/acl-name and /configuration/igmp-snooping/vlans/vlan/acl-name length range (1..31 to 0..31)' ;
  }

  revision 2015-03-02 {
    description 'Add clear operation and global summary show.' ;
  }

  revision 2015-02-12 {
    description 'Modify m-vpls configuration. Add default and groups container.Change proper noun, such as vpls,vlan,id etc, from lowercase into capital.' ;
  }

  revision 2014-04-28 {
    description 'Add the VLAN configuration. Add the mrouter state and the member state of instance VLAN, VBUI,VRF and IP-GLOBAL.' ;
  }

  revision 2014-01-08 {
    description 'Add the range of leaf max-group-num and max-member-num ,modify the range of leaf last-mem-qry-interval ,modify the type of leaf interface.' ;
  }

  revision 2013-09-17 {
    description 'Modify the key of list member in state ,delete the mandatory and add length range of leaf name in list VPLS.' ;
  }

  revision 2013-08-01 {
    description 'Initial version.' ;
  }

  feature vpls {
    description 'IGMP snooping over VPLS.' ;
  }

  feature vlan {
    description 'IGMP snooping over VLAN.' ;
  }

  feature vxlan {
    description 'IGMP snooping over VXLAN.' ;
  }

  feature vbui {
    description 'IGMP snooping over VBUI.' ;
  }

  feature vrf {
    description 'IGMP snooping over VRF.' ;
  }

  feature ip-global {
    description 'IGMP snooping over IP-global.' ;
  }

  feature ring-tree {
    description 'IGMP snooping over Ring Tree.' ;
  }

  feature host-aging-closedown {
    description 'Host aging closedown.' ;
  }

  feature transmit-to-block-port {
    description 'Transmit packets through block ports.' ;
  }

  feature topology-change {
    description 'Response or send packets when the topology changes.' ;
  }

  feature max-host-in-group {
    description 'Max access members in the specific group.' ;
  }

  feature max-host-in-interface {
    description 'Max access members in the specific interface.' ;
  }

  feature max-host-in-vlan {
    description 'Max access members in the specific VLAN.' ;
  }

  feature group-specific-query-suppress {
    description 'Group-specific query suppression in transparent mode.' ;
  }

  feature supervlan-member {
    description 'Supervlan members.' ;
  }

  feature transmit-from-block-port {
    description 'Transmit packets from block ports.' ;
  }

  feature group {
    description 'IGMP snooping group configuration.' ;
  }

  feature interface {
    description 'IGMP snooping interface configuration.' ;
  }

  feature mrouter-version {
    description 'IGMP snooping mrouter version.' ;
  }

  feature redundancy-pw-mrouter-transmitting {
    description 'The mode of transmitting IGMP report/leave packets from mrouter can be configured.' ;
  }

  feature vlan-query-interval {
    description 'The query interval configuration in vlan mode.' ;
  }

  feature evpn-vpls {
    description 'IGMP snooping over EVPN-VPLS.' ;
  }

  feature querier-send-to-mrouter {
    description 'Querier sends query to mrouter.' ;
  }

  feature logging {
    description 'Logging igmp packets.' ;
  }

  feature mvpls {
    description 'IGMP snooping mvpls configuration.' ;
  }

  feature general-state-mrouter {
    description 'IGMP snooping support general state mrouter.' ;
  }

  feature mvlan {
    description 'IGMP snooping mvlan configuration.' ;
    ncd:revise-date 2021-10-19 ;
  }

  feature block-sending-to-mrouter {
    description 'IGMP snooping block-sending-to-mrouter configuration.' ;
    ncd:revise-date 2022-06-14 ;
  }

  typedef switch-type {
    type enumeration {
      enum disable {
        value 0 ;
        description 'Disable this switch.' ;
      }

      enum enable {
        value 1 ;
        description 'Enable this switch.' ;
      }

    }

    description 'Type of switch status.' ;
  }

  typedef packet-dispose-type {
    type enumeration {
      enum accept {
        value 0 ;
        description 'Accept packet mode.' ;
      }

      enum ignore {
        value 1 ;
        description 'Ignore packet mode.' ;
      }

      enum discard {
        value 2 ;
        description 'Discard packet mode.' ;
      }

    }

    description 'Type of packet dispose.' ;
  }

  typedef work-mode-type {
    type enumeration {
      enum proxy {
        value 0 ;
        description 'Proxy mode.' ;
      }

      enum route {
        value 1 ;
        description 'Route mode' ;
      }

      enum transparent {
        value 2 ;
        description 'Transparent mode.' ;
      }

    }

    description 'Type of work mode.' ;
  }

  typedef version-type {
    type enumeration {
      enum v1 {
        value 1 ;
        description 'IGMP version1.' ;
      }

      enum v2 {
        value 2 ;
        description 'IGMP version2.' ;
      }

      enum v3 {
        value 3 ;
        description 'IGMP version3.' ;
      }

    }

    description 'The version of IGMP.' ;
  }

  typedef mode-type {
    type enumeration {
      enum dynamic {
        value 0 ;
        description 'Dynamic mode.' ;
      }

      enum static {
        value 1 ;
        description 'Static mode.' ;
      }

    }

    description 'Type of mode. include dynamic mode or static mode.' ;
  }

  typedef mrouter-version-type {
    type enumeration {
      enum v1 {
        value 5 ;
        description 'Mrouter port version 1.' ;
      }

      enum v2 {
        value 7 ;
        description 'Mrouter port version 2.' ;
      }

      enum v3 {
        value 9 ;
        description 'Mrouter port version 3.' ;
      }

    }

    description 'The version of IGMP mrouter port.' ;
  }

  typedef redundancy-pw-transmitting-type {
    type enumeration {
      enum double {
        value 2 ;
        description 'If set to double,It means that IGMP packets will be sent through both working PW and protection PW.' ;
      }

      enum single {
        value 1 ;
        description 'If set to single,It means that IGMP packets will be sent through only working PW.' ;
      }

    }

    description 'Redundancy PW transmitting mode:single or double.' ;
  }

  container configuration {
    description 'Configuration model.' ;
    container igmp-snooping {
      description 'Configure IGMP snooping parameters.' ;
      container global {
        description 'IGMP snooping global configure.' ;
        leaf global-enable {
          description 'Enable/disable IGMP snooping in this device.Its default value depends on the product.' ;
          type switch-type ;

        }

        leaf global-query-enable {
          description 'Enable/disable IGMP queries in this device.' ;
          type switch-type ;

          default disable ;
        }

        leaf query-interval {
          description 'Configure query interval.The query interval is the interval between general queries sent by the querier.' ;
          type uint16 {
            range 30..65535 ;

          }

          units second ;
          default 125 ;
        }

        leaf query-rsp-interval {
          description 'Configure query response interval. The response interval inserted into the periodic general queries.' ;
          type uint8 {
            range 1..255 ;

          }

          units "tick (1 tick = 100ms)" ;
          default 100 ;
        }

        leaf v1-packet-dispose {
          description 'The disposal mode of IGMPv1 Report message.' ;
          type packet-dispose-type ;

          default accept ;
        }

        leaf v2-packet-dispose {
          description 'The disposal mode of IGMPV2 Report/Leave message.' ;
          type packet-dispose-type ;

          default accept ;
        }

        leaf v3-packet-dispose {
          description 'The disposal mode of IGMPV3 Report message.' ;
          type packet-dispose-type ;

          default discard ;
        }

        leaf host-aging-closedown {
          if-feature host-aging-closedown ;

          description 'Configure host aging closedown.' ;
          type switch-type ;

          default disable ;
          ncd:revise-date 2018-02-12 ;
        }

        container transmit-to-block-port {
          if-feature transmit-to-block-port ;

          description 'Transmit packets through block ports.' ;
          leaf trans-query-to-block-port {
            description 'Configure query packet through blocked port.' ;
            type switch-type ;

            default disable ;
          }

          leaf trans-report-leave-to-block-port {
            description 'Configure report and leave packet through blocked port.' ;
            type switch-type ;

            default disable ;
          }

          ncd:revise-date 2018-02-12 ;
        }

        container transmit-from-block-port {
          if-feature transmit-from-block-port ;

          description 'Transmit packets from block ports.' ;
          leaf trans-query-from-block-port {
            description 'Allow to transmit query packet from blocked port.' ;
            type switch-type ;

            default disable ;
          }

          ncd:revise-date 2018-02-12 ;
        }

        leaf querier-send-to-mrouter {
          if-feature querier-send-to-mrouter ;

          description 'Configure querier sending query to mrouter.' ;
          type enumeration {
            enum enable {
              value 1 ;
              description 'Configure sending query to mrouter enable.' ;
            }

            enum disable {
              value 2 ;
              description 'Configure sending query to mrouter disable.' ;
            }

          }

          default disable ;
          ncd:revise-date 2018-08-07 ;
        }

        container logging {
          description 'Logging the igmp packet.' ;
          leaf packet-report {
            if-feature logging ;

            description 'Logging the IGMP report.' ;
            type switch-type ;

            default disable ;
          }

          leaf overrun-report {
            if-feature logging ;

            description 'Logging the IGMP report for group or member number overrun.' ;
            type switch-type ;

            default disable ;
          }

          ncd:revise-date 2019-11-04 ;
        }

      }

      container vpls {
        if-feature vpls ;

        description "IGMP snooping VPLS configure.Can't config IGMP snooping in VPLS if the VPLS instance not exist.If IGMP snooping configuration exist in VPLS,the VPLS instance can't be deleted." ;
        list vpls {
          description 'The config of instance VPLS.' ;
          key name ;
          leaf name {
            description 'Submode instance Name of VPLS.' ;
            type string {
              length 1..32 ;

            }

          }

          leaf snooping-switch {
            description 'Enable/disable IGMP snooping in this instance.' ;
            type switch-type ;

            default disable ;
          }

          leaf member-fast-leave {
            description 'Enable/disable group membership fast leave in this instance.' ;
            type switch-type ;

            default disable ;
          }

          leaf acl-name {
            description 'Configure an ACL rule in this instance.' ;
            type string {
              length 0..31 ;

            }

          }

          leaf member-time-out {
            description 'Member aging time in this instance.' ;
            type uint16 {
              range 30..65535 ;

            }

            units second ;
            default 260 ;
          }

          leaf mrouter-time-out {
            description 'Multicast router port aging time in this instance.' ;
            type uint16 {
              range 30..65535 ;

            }

            units second ;
            default 260 ;
          }

          leaf work-mode {
            description 'Work mode in this instance: proxy, transparent or router.' ;
            type work-mode-type ;

            default proxy ;
          }

          leaf proxy-ip {
            description 'This IP address is used as source IP when sending IGMP Report and Leave in proxy mode.' ;
            type ncd:ipv4-address ;

          }

          leaf query-ip {
            description 'This IP address is used as source IP when sending IGMP Query.' ;
            type ncd:ipv4-address ;

          }

          leaf max-group-num {
            description 'Max number of multicast group can access in this instance.Its default value and maximum value depends on the product.' ;
            type uint32 {
              range 1..4294967295 ;

            }

          }

          leaf ndl-enable {
            description 'Enable/disable all ports are not allowed to learn dynamic mrouter port(s).' ;
            type switch-type ;

            default disable ;
          }

          leaf last-mem-qry-interval {
            description 'The last member query interval is the max response time inserted into group-specific queries sent in response to leave group messages, and is also the amount of time between group-specific query messages.' ;
            type uint16 {
              range 1..25 ;

            }

            units second ;
            default 1 ;
          }

          leaf query-version {
            description 'Querier version: V1, V2 or V3.' ;
            type version-type ;

            default v2 ;
          }

          leaf query-enable {
            description 'Enable/disable querier in this instance.' ;
            type switch-type ;

            default disable ;
          }

          leaf redundancy-pw-mrouter-transmitting {
            if-feature redundancy-pw-mrouter-transmitting ;

            description 'Configure redundancy PW mrouter transmitting mode:single or double.' ;
            type redundancy-pw-transmitting-type ;

            default double ;
            ncd:revise-date 2018-04-03 ;
          }

          leaf querier-send-to-mrouter {
            if-feature querier-send-to-mrouter ;

            description 'Configure querier sending query to mrouter.' ;
            type enumeration {
              enum unconfigured {
                value 0 ;
                description 'Function of sending query to mrouter is unconfigured.' ;
              }

              enum enable {
                value 1 ;
                description 'Configure sending query to mrouter enable.' ;
              }

              enum disable {
                value 2 ;
                description 'Configure sending query to mrouter disable.' ;
              }

            }

            default unconfigured ;
            ncd:revise-date 2018-08-07 ;
          }

          list drop {
            description 'The config of group with drop in instance VPLS.The max-elements depends on the product.' ;
            key group-ip ;
            leaf group-ip {
              description 'Group IP address.' ;
              type ncd:ipv4-address ;

            }

          }

          list prejoin {
            description 'The config of group with prejoin in instance VPLS.The max-elements depends on the product.' ;
            key group-ip ;
            leaf group-ip {
              description 'Group IP address.' ;
              type ncd:ipv4-address ;

            }

          }

          list max-member-num {
            description 'The config of group with max-member-num in instance VPLS.The max-elements depends on the product.' ;
            key group-ip ;
            leaf group-ip {
              description 'Group IP address.' ;
              type ncd:ipv4-address ;

            }

            leaf max-member-num {
              description 'Max number of IGMP member can access to this group.Its default value and maximum
value depends on the product.' ;
              type uint32 {
                range 1..4294967295 ;

              }

            }

          }

          list member {
            description 'The config of static member in instance VPLS.The max-elements depends on the product.' ;
            key 'group-ip interface' ;
            leaf group-ip {
              description 'Group IP address.' ;
              type ncd:ipv4-address ;

            }

            leaf interface {
              description 'Interface name.' ;
              type ncd:ifname ;

            }

          }

          list interface {
            description 'The config of interface in instance VPLS.' ;
            key name ;
            leaf name {
              description 'Interface name.' ;
              type ncd:ifname ;

            }

            leaf snooping-switch {
              description 'Enable/Disable IGMP snooping in the interface.' ;
              type switch-type ;

              default enable ;
            }

            leaf mrouter-guard {
              description 'Interface multicast router guard function is enabled.' ;
              type switch-type ;

              default disable ;
            }

            leaf querier-send-to-mrouter {
              if-feature querier-send-to-mrouter ;

              description 'Configure querier sending query to mrouter.' ;
              type enumeration {
                enum unconfigured {
                  value 0 ;
                  description 'Function of sending query to mrouter is unconfigured.' ;
                }

                enum enable {
                  value 1 ;
                  description 'Configure sending query to mrouter enable.' ;
                }

                enum disable {
                  value 2 ;
                  description 'Configure sending query to mrouter disable.' ;
                }

              }

              default unconfigured ;
              ncd:revise-date 2018-08-07 ;
            }

          }

          list mrouter {
            description 'The config of static mrouter in instance VPLS.The max-elements depends on the product.' ;
            key interface ;
            leaf interface {
              description 'Interface name.' ;
              type ncd:ifname ;

            }

          }

          list ndl {
            description 'The config of port not allowed to learn dynamic mrouter in instance VPLS.The max-elements depends on the product.' ;
            key interface ;
            leaf interface {
              description 'Interface name.' ;
              type ncd:ifname ;

            }

          }

          container m-vpls {
            if-feature mvpls ;

            description 'The config of multicast VPLS in instance VPLS.The max-elements depends on the product.' ;
            container default {
              description 'The config of default multicast VPLS in instance VPLS.' ;
              presence default ;
              leaf m-vpls-name {
                description 'The config of default multicast VPLS in instance VPLS.' ;
                type string {
                  length 1..32 ;

                }

                mandatory true ;
              }

            }

            container groups {
              description 'The specific group of multicast VPLS in instance VPLS.' ;
              list group {
                description 'The specific group of multicast VPLS in instance VPLS.' ;
                key group-ip ;
                leaf group-ip {
                  description 'Group IP address.' ;
                  type ncd:ipv4-address ;

                }

                leaf m-vpls-name {
                  description 'Multicast VPLS name.' ;
                  type string {
