            description 'Remain time of this member.' ;
            type string {
              length 1..10 ;

            }

          }

          leaf present-time {
            description 'Present time of this member.' ;
            type string {
              length 1..10 ;

            }

            ncd:revise-date 2019-12-05 ;
          }

          ncd:select ring-tree-name ;
          ncd:select "ring-tree-name group-ip source-ip" ;
          ncd:select "ring-tree-name group-ip source-ip interface-name" ;
        }

        list mrouter {
          if-feature ring-tree ;

          description 'The information of IGMP multicast router.' ;
          key 'ring-tree-name interface-name' ;
          leaf ring-tree-name {
            description 'Submode instance name of Ring Tree.' ;
            type string {
              length 1..32 ;

            }

          }

          leaf interface-name {
            description 'Interface name of this mrouter.' ;
            type ncd:ifname ;

          }

          leaf instance-id {
            description 'Submode instance ID of Ring Tree.' ;
            type uint32 {
              range 1..65535 ;

            }

          }

          leaf state {
            description 'State of this mrouter.' ;
            type mode-type ;

          }

          leaf version {
            description 'Version of this mrouter.' ;
            type version-type ;

          }

          leaf remain-time {
            description 'Remain time of this mrouter.' ;
            type uint32 {
              range 0..65535 ;

            }

            units second ;
          }

          leaf querier-ip {
            description 'Querier IP address.' ;
            type ncd:ipv4-address ;

          }

          leaf present-time {
            description 'Present time of this mrouter.' ;
            type string {
              length 1..10 ;

            }

            ncd:revise-date 2019-12-05 ;
          }

          ncd:select "ring-tree-name interface-name" ;
        }

        ncd:revise-date 2017-10-27 ;
      }

      container evpn-vpls {
        if-feature evpn-vpls ;

        description 'IGMP snooping EVPN VPLS information.' ;
        list member {
          description 'The information of member in instance EVPN VPLS.' ;
          key 'evpn-vpls-name group-ip source-ip interface-name vni external-vlan-id internal-vlan-id' ;
          leaf evpn-vpls-name {
            description 'Submode instance Name of EVPN VPLS.' ;
            type string {
              length 1..32 ;

            }

          }

          leaf group-ip {
            description 'Group IP address.' ;
            type ncd:ipv4-address ;

          }

          leaf source-ip {
            description 'Source IP address.' ;
            type ncd:ipv4-address ;

          }

          leaf interface-name {
            description 'Interface name of this member.' ;
            type string {
              length 1..59 ;

            }

          }

          leaf vni {
            description 'VXLAN network ID.' ;
            type uint32 {
              range 0..16777215 ;

            }

          }

          leaf external-vlan-id {
            description 'External VLAN ID of this member.' ;
            type uint32 {
              range 0..4094 ;

            }

          }

          leaf internal-vlan-id {
            description 'Internal VLAN ID of this member.' ;
            type uint32 {
              range 0..4094 ;

            }

          }

          leaf state {
            description 'State of this member.' ;
            type version-type ;

          }

          leaf mode {
            description 'Mode of this member.' ;
            type mode-type ;

          }

          leaf remain-time {
            description 'Remain time of this member.' ;
            type string {
              length 1..10 ;

            }

          }

          leaf present-time {
            description 'Present time of this member.' ;
            type string {
              length 1..10 ;

            }

          }

          ncd:select evpn-vpls-name ;
          ncd:select "evpn-vpls-name group-ip source-ip" ;
          ncd:select "evpn-vpls-name group-ip source-ip interface-name" ;
        }

        list mrouter {
          description 'The information of IGMP multicast router.' ;
          key 'evpn-vpls-name interface-name vni external-vlan-id internal-vlan-id' ;
          leaf evpn-vpls-name {
            description 'Submode instance Name of EVPN VPLS.' ;
            type string {
              length 1..32 ;

            }

          }

          leaf interface-name {
            description 'Interface name of this mrouter.' ;
            type ncd:ifname ;

          }

          leaf vni {
            description 'VXLAN network ID.' ;
            type uint32 {
              range 0..16777215 ;

            }

          }

          leaf external-vlan-id {
            description 'External VLAN ID of this member.' ;
            type uint32 {
              range 0..4094 ;

            }

          }

          leaf internal-vlan-id {
            description 'Internal VLAN ID of this member.' ;
            type uint32 {
              range 0..4094 ;

            }

          }

          leaf state {
            description 'State of this mrouter.' ;
            type mode-type ;

          }

          leaf version {
            description 'Version of this mrouter.' ;
            type version-type ;

          }

          leaf querier-ip {
            description 'Querier IP address.' ;
            type ncd:ipv4-address ;

          }

          leaf remain-time {
            description 'Remain time of this mrouter.' ;
            type uint32 {
              range 0..65535 ;

            }

            units second ;
          }

          leaf present-time {
            description 'Present time of this mrouter.' ;
            type string {
              length 1..10 ;

            }

          }

          ncd:select "evpn-vpls-name interface-name" ;
        }

        ncd:revise-date 2018-06-13 ;
      }

    }

  }

  container operation {
    config false ;
    description 'Command of IGMP snooping clear.' ;
    container igmp-snooping {
      description 'Clear IGMP snooping groups.' ;
      container clear {
        description 'Clear IGMP snooping groups.' ;
        container group {
          description 'Clear the specific group of the specific instance.' ;
          presence group ;
          leaf group-ip {
            description 'Multicast group IP address.' ;
            type ncd:ipv4-address ;

            mandatory true ;
          }

          leaf source-ip {
            description 'Source IP address.' ;
            type ncd:ipv4-address ;

          }

          choice instance {
            description 'Instance.' ;
            mandatory true ;
            case vlan {
              if-feature vlan ;

              description 'Clear all groups of the specific VLAN instance.' ;
              leaf vlan-id {
                description 'VLAN ID.' ;
                type uint16 {
                  range 1..4094 ;

                }

              }

            }

            case vpls {
              if-feature vpls ;

              description 'Clear all groups of the specific VPLS instance.' ;
              leaf vpls-name {
                description 'VPLS name.' ;
                type string {
                  length 1..32 ;

                }

              }

            }

            case vrf {
              if-feature vrf ;

              description 'Clear all groups of the specific VRF instance.' ;
              leaf vrf-name {
                description 'VRF name.' ;
                type string {
                  length 0..32 ;

                }

              }

            }

            case ip-global {
              if-feature ip-global ;

              description 'Clear all groups of the specific IP-global instance.' ;
              leaf ip-global {
                description 'IP-global.' ;
                type empty ;

              }

            }

            case vxlan {
              if-feature vxlan ;

              description 'Clear all groups of the specific VXLAN instance.' ;
              leaf vxlan-id {
                description 'VXLAN ID.' ;
                type uint32 ;

              }

              ncd:revise-date 2017-05-23 ;
            }

            case ring-tree {
              if-feature ring-tree ;

              description 'Clear all groups of the specific Ring Tree instance.' ;
              leaf ring-tree-name {
                description 'Ring Tree name.' ;
                type string {
                  length 1..32 ;

                }

              }

              ncd:revise-date 2017-10-27 ;
            }

            case evpn-vpls {
              if-feature evpn-vpls ;

              description 'Clear all groups of the specific EVPN VPLS instance.' ;
              leaf evpn-vpls-name {
                description 'EVPN VPLS name.' ;
                type string {
                  length 1..32 ;

                }

              }

              ncd:revise-date 2018-06-13 ;
            }

          }

        }

        container groups {
          description 'Clear all groups of the specific instance.' ;
          choice type {
            description 'Clear all groups of the specific instance.' ;
            case vlan {
              if-feature vlan ;

              description 'Clear all groups of the specific VLAN instance.' ;
              leaf vlan-id {
                description 'VLAN ID.' ;
                type uint16 {
                  range 1..4094 ;

                }

              }

            }

            case vpls {
              if-feature vpls ;

              description 'Clear all groups of the specific VPLS instance.' ;
              leaf vpls-name {
                description 'VPLS name.' ;
                type string {
                  length 1..32 ;

                }

              }

            }

            case vrf {
              if-feature vrf ;

              description 'Clear all groups of the specific VRF instance.' ;
              leaf vrf-name {
                description 'VRF name.' ;
                type string {
                  length 0..32 ;

                }

              }

            }

            case ip-global {
              if-feature ip-global ;

              description 'Clear all groups of the specific IP-global instance.' ;
              leaf ip-global {
                description 'IP-global.' ;
                type empty ;

              }

            }

            case all {
              description 'Clear all groups.' ;
              leaf all-groups {
                description 'All groups.' ;
                type empty ;

              }

            }

            case vxlan {
              if-feature vxlan ;

              description 'Clear all groups of the specific VXLAN instance.' ;
              leaf vxlan-id {
                description 'VXLAN ID.' ;
                type uint32 ;

              }

              ncd:revise-date 2017-05-23 ;
            }

            case ring-tree {
              if-feature ring-tree ;

              description 'Clear all groups of the specific Ring Tree instance.' ;
              leaf ring-tree-name {
                description 'Ring Tree name.' ;
                type string {
                  length 1..32 ;

                }

              }

              ncd:revise-date 2017-10-27 ;
            }

            case evpn-vpls {
              if-feature evpn-vpls ;

              description 'Clear all groups of the specific EVPN VPLS instance.' ;
              leaf evpn-vpls-name {
                description 'EVPN VPLS name.' ;
                type string {
                  length 1..32 ;

                }

              }

              ncd:revise-date 2018-06-13 ;
            }

          }

        }

      }

    }

  }

}
