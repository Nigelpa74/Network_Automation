      container vlans {
        if-feature vlan ;

        description "IGMP snooping VLAN configure.Can't config IGMP snooping in VLAN if the VLAN instance not exist.If IGMP snooping configuration exist in VLAN,the VLAN instance can't be deleted." ;
        list vlan {
          description 'The config of instance VLAN.' ;
          key id ;
          leaf id {
            description 'Submode instance ID of VLAN.' ;
            type uint16 {
              range 1..4094 ;

            }

          }

          leaf snooping-switch {
            description 'Enable/disable IGMP snooping in this instance.' ;
            type switch-type ;

            default disable ;
          }

          leaf member-fast-leave {
            description 'Enable/disable group membership fast leave in this instance.' ;
            type switch-type ;

            default disable ;
          }

          leaf acl-name {
            description 'Configure an ACL rule in this instance.' ;
            type string {
              length 0..31 ;

            }

          }

          leaf member-time-out {
            description 'Member aging time in this instance.' ;
            type uint16 {
              range 30..65535 ;

            }

            units second ;
            default 260 ;
          }

          leaf mrouter-time-out {
            description 'Multicast router port aging time in this instance.' ;
            type uint16 {
              range 30..65535 ;

            }

            units second ;
            default 260 ;
          }

          leaf work-mode {
            description 'Work mode in this instance: proxy, transparent or router.' ;
            type work-mode-type ;

            default proxy ;
          }

          leaf proxy-ip {
            description 'This IP address is used as source IP when sending IGMP Report and Leave in proxy mode.' ;
            type ncd:ipv4-address ;

          }

          leaf query-ip {
            description 'This IP address is used as source IP when sending IGMP Query.' ;
            type ncd:ipv4-address ;

          }

          leaf max-group-num {
            description 'Max number of multicast group can access in this instance.Its default value and maximum value depends on the product.' ;
            type uint32 {
              range 1..4294967295 ;

            }

          }

          leaf ndl-enable {
            description 'Enable/disable all ports are not allowed to learn dynamic mrouter port(s).' ;
            type switch-type ;

            default disable ;
          }

          leaf last-mem-qry-interval {
            description 'The last member query interval is the max response time inserted into group-specific queries sent in response to leave group messages, and is also the amount of time between group-specific query messages.' ;
            type uint16 {
              range 1..25 ;

            }

            units second ;
            default 1 ;
          }

          leaf query-version {
            description 'Querier version: V1, V2 or V3.' ;
            type version-type ;

            default v2 ;
          }

          leaf query-enable {
            description 'Enable/disable querier in this instance.' ;
            type switch-type ;

            default disable ;
          }

          leaf querier-send-to-mrouter {
            if-feature querier-send-to-mrouter ;

            description 'Configure querier sending query to mrouter.' ;
            type enumeration {
              enum unconfigured {
                value 0 ;
                description 'Function of sending query to mrouter is unconfigured.' ;
              }

              enum enable {
                value 1 ;
                description 'Configure sending query to mrouter enable.' ;
              }

              enum disable {
                value 2 ;
                description 'Configure sending query to mrouter disable.' ;
              }

            }

            default unconfigured ;
            ncd:revise-date 2018-08-07 ;
          }

          container drops {
            list drop {
              description 'The config of group with drop in instance VLAN.The max-elements depends on the product.' ;
              key group-ip ;
              leaf group-ip {
                description 'Group IP address.' ;
                type ncd:ipv4-address ;

              }

            }

          }

          container prejoins {
            list prejoin {
              description 'The config of group with prejoin in instance VLAN.The max-elements depends on the product.' ;
              key group-ip ;
              leaf group-ip {
                description 'Group IP address.' ;
                type ncd:ipv4-address ;

              }

            }

          }

          container max-member-nums {
            list max-member-num {
              description 'The config of group with max-member-num in instance VLAN.The max-elements depends on the product.' ;
              key group-ip ;
              leaf group-ip {
                description 'Group IP address.' ;
                type ncd:ipv4-address ;

              }

              leaf max-member-num {
                description 'Max number of IGMP member can access to this group.Its default value and maximum
value depends on the product.' ;
                type uint32 {
                  range 1..4000 ;

                }

              }

            }

          }

          container members {
            list member {
              description 'The config of static member in instance VLAN.The max-elements depends on the product.' ;
              key 'group-ip interface' ;
              leaf group-ip {
                description 'Group IP address.' ;
                type ncd:ipv4-address ;

              }

              leaf interface {
                description 'Interface name.' ;
                type ncd:ifname ;

              }

            }

          }

          container interfaces {
            list interface {
              description 'The config of interface in instance VLAN.' ;
              key name ;
              leaf name {
                description 'Interface name.' ;
                type ncd:ifname ;

              }

              leaf mrouter-guard {
                description 'Interface multicast router guard function is enabled.' ;
                type switch-type ;

                default disable ;
              }

              leaf querier-send-to-mrouter {
                if-feature querier-send-to-mrouter ;

                description 'Configure querier sending query to mrouter.' ;
                type enumeration {
                  enum unconfigured {
                    value 0 ;
                    description 'Function of sending query to mrouter is unconfigured.' ;
                  }

                  enum enable {
                    value 1 ;
                    description 'Configure sending query to mrouter enable.' ;
                  }

                  enum disable {
                    value 2 ;
                    description 'Configure sending query to mrouter disable.' ;
                  }

                }

                default unconfigured ;
                ncd:revise-date 2018-08-07 ;
              }

            }

          }

          container mrouters {
            list mrouter {
              description 'The config of static mrouter in instance VLAN.The max-elements depends on the product.' ;
              key interface ;
              leaf interface {
                description 'Interface name.' ;
                type ncd:ifname ;

              }

              leaf version {
                if-feature mrouter-version ;

                description 'Mrouter port version: V1, V2 or V3.' ;
                type mrouter-version-type ;

                default v2 ;
                ncd:revise-date 2018-02-12 ;
              }

            }

          }

          container ndls {
            list ndl {
              description 'The config of port not allowed to learn dynamic mrouter in instance VLAN.The max-elements depends on the product.' ;
              key interface ;
              leaf interface {
                description 'Interface name.' ;
                type ncd:ifname ;

              }

            }

          }

          leaf max-member-num {
            if-feature max-host-in-vlan ;

            description 'Max number of IGMP member can access to this instance.Its maximum value depends on the product.' ;
            type uint32 {
              range 1..4000 ;

            }

            ncd:revise-date 2018-02-12 ;
          }

          container topology-chg {
            if-feature topology-change ;

            leaf response-spe-leave {
              description 'Response special leave when the topology changes.' ;
              type switch-type ;

            }

            leaf send-general-query {
              description 'Send general query when the topology changes.' ;
              type switch-type ;

            }

            leaf send-spe-leave {
              description 'Send special leave when the topology changes.' ;
              type switch-type ;

            }

            ncd:revise-date 2018-02-12 ;
          }

          container group-spe-query-suppress {
            if-feature group-specific-query-suppress ;

            description 'Configure group-specific query suppression in transparent mode.' ;
            choice suppress-config {
              description 'Suppress configuration.' ;
              case suppress-without-time-out {
                description 'Enable group-specific query suppression function without specified leaving host time out.' ;
                leaf suppress-without-time-out {
                  description 'Enable group-specific query suppression function.' ;
                  type empty ;

                }

              }

              case suppress-with-time-out {
                description 'Enable group-specific query suppression function with specified leaving host time out.' ;
                leaf suppress-with-time-out {
                  description 'Enable group-specific query suppression and specify leaving host time out.' ;
                  type uint16 {
                    range 2..175 ;

                  }

                  units second ;
                }

              }

              case unsuppress {
                description 'Disable group-specific query suppression function.' ;
                leaf unsuppress {
                  description 'Disable group-specific query suppression function.' ;
                  type empty ;

                }

              }

            }

            ncd:revise-date 2018-02-12 ;
          }

          leaf query-interval {
            if-feature vlan-query-interval ;

            description 'Configure query interval of vlan instance.The query interval is the interval between general queries sent by the querier.' ;
            type uint16 {
              range 30..65535 ;

            }

            units second ;
            ncd:revise-date 2018-05-30 ;
          }

          container mvlan {
            if-feature mvlan ;

            description 'The config of multicast VLAN in instance VLAN.The max-elements depends on the product.' ;
            container default {
              description 'The config of default multicast VLAN in instance VLAN.' ;
              presence default ;
              leaf m-vlan-id {
                description 'The config of default multicast VALN in instance VLAN.' ;
                type uint16 {
                  range 1..4094 ;

                }

                mandatory true ;
              }

            }

            ncd:revise-date 2021-10-19 ;
          }

          container block-sending-to-mrouters {
            if-feature block-sending-to-mrouter ;

            description 'The config of group with block-sending-to-mrouter in instance VLAN.' ;
            list block-sending-to-mrouter {
              description 'The config of group with block-sending-to-mrouter in instance VLAN.' ;
              key group-ip ;
              leaf group-ip {
                description 'Group IP address.' ;
                type ncd:ipv4-address ;

              }

            }

            ncd:revise-date 2022-06-14 ;
          }

          leaf mapping-host-to-multicast {
            description 'Enable/disable mapping host to multicast.' ;
            type switch-type ;

            default disable ;
            ncd:revise-date 2022-10-13 ;
          }

          leaf ssm-enable {
            type switch-type ;

            description 'SSM mapping enable' ;
            default disable ;
            ncd:revise-date 2024-10-29 ;
          }

          container ssm-ranges {
            description 'SSM mapping range' ;
            choice ssm-range {
              description 'SSM mapping range' ;
              case range-default {
                description 'Use 232/8 group range for SSM' ;
                leaf default {
                  type empty ;

                  description 'Use 232/8 group range for SSM' ;
                }

              }

              case range-acl {
                description 'ACL for group range to be used for SSM' ;
                leaf acl {
                  type string {
                    length 1..31 ;

                  }

                  description 'ACL for group range to be used for SSM' ;
                }

              }

            }

            ncd:revise-date 2024-10-29 ;
          }

          container ssm-maps {
            description 'SSM mapping static function' ;
            container acls {
              description 'SSM group' ;
              list acl {
                description 'SSM group' ;
                key 'acl-name src-addr' ;
                max-elements 1000 ;
                leaf acl-name {
                  type string {
                    length 1..31 ;

                  }

                  description 'SSM group named access list (1-31 characters)' ;
                }

                leaf src-addr {
                  type ncd:ipv4-address ;

                  description 'SSM source address' ;
                }

              }

            }

            container defaults {
              description 'SSM default group ' ;
              list default {
                description 'SSM default group ' ;
                max-elements 1000 ;
                key src-addr ;
                leaf src-addr {
                  type ncd:ipv4-address ;

                  description 'SSM source address' ;
                }

              }

            }

            ncd:revise-date 2024-10-29 ;
          }

        }

      }

