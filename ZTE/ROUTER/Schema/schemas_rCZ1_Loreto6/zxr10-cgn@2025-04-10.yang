                description 'Remove this entitiy means to remove value of any entities which belong to any case within this choice.' ;
                presence location-all-clear ;
              }

              ncd:revise-date 2020-08-11 ;
            }

          }

          leaf port-reserved {
            description 'Port reserved.' ;
            type uint32 {
              range 0..4096 ;

            }

            default 64 ;
            ncd:revise-date 2017-08-03 ;
          }

          leaf position {
            description 'The server position to obtain IP ranges.' ;
            type enumeration {
              enum local {
                value 1 ;
              }

              enum remote {
                value 2 ;
              }

              enum disable {
                value 0 ;
              }

            }

            default disable ;
            ncd:revise-date 2017-10-16 ;
          }

          leaf ippool-name {
            description 'IP pool name.' ;
            type string {
              length 1..64 ;

            }

            ncd:revise-date 2017-10-16 ;
          }

          leaf low {
            description 'The low threshold.' ;
            type uint32 {
              range 1..100 ;

            }

            default 20 ;
            ncd:revise-date 2017-10-16 ;
          }

          leaf high {
            description 'The high threshold.' ;
            type uint32 {
              range 1..100 ;

            }

            default 80 ;
            ncd:revise-date 2017-10-16 ;
          }

          leaf mask {
            description 'The mask of range.' ;
            type uint32 {
              range 20..32 ;

            }

            default 27 ;
            ncd:revise-date 2017-10-16 ;
          }

          leaf max-number {
            description 'The max number of ranges.' ;
            type uint32 {
              range 1..2000 ;

            }

            default 200 ;
            ncd:revise-date 2017-10-16 ;
          }

          leaf max-static-port-range-blocks {
            description 'Max blocks of static portrange for one user.' ;
            type uint8 {
              range 1..4 ;

            }

            default 1 ;
            ncd:revise-date 2017-10-28 ;
          }

          leaf recycle {
            description 'Force recycle resources.' ;
            type enumeration {
              enum enable {
                value 1 ;
              }

              enum disable {
                value 0 ;
              }

            }

            default disable ;
            ncd:revise-date 2017-12-28 ;
          }

          leaf assign {
            description 'Assign obtain IP ranges policy.' ;
            type enumeration {
              enum none {
                value 0 ;
                description 'Assign policy none' ;
              }

              enum forward {
                value 1 ;
                description 'Assign policy forward' ;
              }

              enum backward {
                value 2 ;
                description 'Assign policy backward' ;
              }

            }

            default none ;
            ncd:revise-date 2018-11-14 ;
          }

          container lock-ip-list {
            description 'Lock IP list.' ;
            list lock-ip {
              description 'Lock IP.' ;
              key lock-ip-no ;
              leaf lock-ip-no {
                description 'Lock IP number.' ;
                type uint32 {
                  range 1..10 ;

                }

              }

              choice lock-ip-type {
                description 'Lock IP type.' ;
                case ip {
                  description 'IP.' ;
                  leaf start-ip {
                    description 'Start IP address.' ;
                    type ncd:ipv4-address-none-zero ;

                  }

                  leaf end-ip {
                    description 'End IP address.' ;
                    type ncd:ipv4-address-none-zero ;

                  }

                }

                case section {
                  description 'Section.' ;
                  leaf section-no {
                    description 'Section number.' ;
                    type uint32 {
                      range 1..2000 ;

                    }

                  }

                }

                case all {
                  description 'Lock all.' ;
                  leaf all {
                    description 'Lock all.' ;
                    type enumeration {
                      enum all {
                        value 1 ;
                        description 'Lock all.' ;
                      }

                    }

                  }

                }

              }

            }

            ncd:revise-date 2019-03-13 ;
          }

          leaf detect-retransmit-number {
            description 'Detect retransmit number.' ;
            type uint32 {
              range 0..10 ;

            }

            default 0 ;
            ncd:revise-date 2019-05-05 ;
          }

          leaf detect-interval-day {
            description 'Detect interval day number.' ;
            type uint32 {
              range 0..999 ;

            }

            default 0 ;
            ncd:revise-date 2019-05-05 ;
          }

          leaf detect-interval-hour {
            description 'Detect interval hour number.' ;
            type uint32 {
              range 0..23 ;

            }

            default 0 ;
            ncd:revise-date 2019-05-05 ;
          }

          leaf detect-interval-minute {
            description 'Detect interval minute number.' ;
            type uint32 {
              range 0..59 ;

            }

            default 0 ;
            ncd:revise-date 2019-05-05 ;
          }

          container port-forbidden-list {
            description 'Port forbidden list.' ;
            list port-forbidden {
              description 'Port forbidden.' ;
              key start-port ;
              leaf start-port {
                description 'Start port.' ;
                type uint32 {
                  range 1..65535 ;

                }

              }

              leaf end-port {
                description 'End port.' ;
                type uint32 {
                  range 1..65535 ;

                }

              }

            }

            ncd:revise-date 2019-09-10 ;
          }

          leaf max-idle-port-range {
            description 'Max idle port range number(0:not limit).' ;
            type uint32 {
              range 0..2097152 ;

            }

            default 0 ;
            ncd:revise-date 2022-03-02 ;
          }

        }

      }

      container domain-list {
        description 'Domain list.' ;
        list domain {
          description 'Domain.' ;
          key domain-name ;
          leaf domain-name {
            description 'Domain name.' ;
            type string {
              length 1..31 ;

            }

          }

          leaf domain-id {
            description 'Domain ID.' ;
            type uint32 {
              range 1..4000 ;

            }

            mandatory true ;
          }

          leaf type {
            description 'Domain type.' ;
            type enumeration {
              enum standalone {
                value 1 ;
                description 'Standalone CGN product.' ;
              }

              enum sr {
                value 2 ;
                description 'Service Router product.' ;
              }

              enum bras {
                value 3 ;
                description 'Brandband Remote Access Server/Broadband product.' ;
              }

              enum xgw {
                value 4 ;
                description 'Wireless Core Network packet switch node (GGSN).' ;
              }

            }

            mandatory true ;
          }

          leaf ip-version-issued {
            description 'IP version issued.' ;
            type enumeration {
              enum ipv4-issued {
                value 1 ;
                description 'Configure as NAT44 or NAT46.' ;
              }

              enum ipv6-issued {
                value 2 ;
                description 'Configure as DualStack-Lite or NAT64.' ;
              }

            }

            mandatory true ;
          }

          leaf instance-name {
            description 'Instance name.' ;
            type ncd:string-quesiton-mark ;

            mandatory true ;
          }

          leaf description {
            description 'Description.' ;
            type string {
              length 1..63 ;

            }

          }

          leaf quota-exceed-action {
            description 'The action of quota exceeded.' ;
            type enumeration {
              enum discard {
                value 0 ;
                description 'Discard the packet if exceed max translations' ;
              }

              enum send-icmp-error {
                value 1 ;
                description 'Send ICMP error if exceed max translations' ;
              }

            }

            default discard ;
          }

          leaf softwire-error-alarm-threshold {
            status obsolete {
              ncd:revise-date 2021-02-26 ;
            }

            description 'Configure softwire error alarm threshold' ;
            type uint32 {
              range 1..4294967295 ;

            }

            default 4294967295 ;
          }

          leaf dns-no-limit {
            description "Don't limit the PAT sessions that destination port is DNS." ;
            type enumeration {
              enum enable {
                value 1 ;
                description 'Enable limit of DNS sessions' ;
              }

              enum disable {
                value 0 ;
                description 'Disable limit of DNS sessions' ;
              }

            }

            default disable ;
          }

          leaf max-private-address-num {
            description 'The max IPv4 number of the same user.' ;
            type uint32 {
              range 1..1000000 {
                description 'The max IPv4 number of the same user' ;
              }

            }

            default 200000 ;
          }

          leaf new-session-create-speed {
            description 'Speed of new session created.' ;
            type uint32 {
              range 0..50000 {
                description 'Configure speed (pps)' ;
              }

            }

          }

          container dynamic-rule-list {
            description 'Dynamic rule list.' ;
            list dynamic-rule {
              description 'Dynamic rule.' ;
              key rule-id ;
              leaf rule-id {
                description 'Rule ID.' ;
                type uint32 {
                  range 1..2000 ;

                }

              }

              leaf acl-type {
                description 'ACL type.' ;
                type enumeration {
                  enum ipv4-list {
                    value 1 ;
                    description 'Specify IPv4 access list.' ;
                  }

                  enum ipv6-list {
                    value 2 ;
                    description 'Specify IPv6 access list.' ;
                  }

                }

                mandatory true ;
              }

              leaf acl-name {
                description 'ACL Name.' ;
                type string {
                  length 1..31 ;

                }

                mandatory true ;
              }

              choice action {
                description 'Action.' ;
                mandatory true ;
                case permit {
                  description 'Permit.' ;
                  container permit {
                    description 'Permit.' ;
                    leaf permit {
                      description 'Permit.' ;
                      type enumeration {
                        enum permit {
                          value 1 ;
                        }

                      }

                      mandatory true ;
                    }

                    leaf pool-name {
                      description 'Pool name.' ;
                      type string {
                        length 1..31 ;

                      }

                    }

                    leaf interface-name {
                      description 'Interface name.' ;
                      type ncd:ifname ;

                    }

                    leaf flow-ip {
                      description 'Flow IP address.' ;
                      type ncd:ipv4-address-none-zero ;

                    }

                  }

                }

                case drop {
                  description 'Drop.' ;
                  container drop {
                    description 'Drop.' ;
                    leaf drop {
                      description 'Drop.' ;
                      type enumeration {
                        enum drop {
                          value 2 ;
                        }

                      }

                      mandatory true ;
                    }

                    leaf interface-name {
                      description 'Interface name.' ;
                      type ncd:ifname ;

                    }

                  }

                }

                case deny {
                  description 'Deny.' ;
                  container deny {
                    description 'Deny.' ;
                    leaf deny {
                      description 'Deny.' ;
                      type enumeration {
                        enum deny {
                          value 3 ;
                        }

                      }

                      mandatory true ;
                    }

                    leaf interface-name {
                      description 'Interface name.' ;
                      type ncd:ifname ;

                    }

                  }

                }

              }

            }

          }

          container static-rule-list {
            description 'Static rule list.' ;
            list static-rule {
              description 'Static rule.' ;
              key rule-id ;
              leaf rule-id {
                description 'Rule ID.' ;
                type uint32 {
                  range 1..2000 ;

                }

              }

              choice user-type {
                description 'User type.' ;
                mandatory true ;
                case softwire {
                  description 'Softwire.' ;
                  container softwire {
                    description 'Softwire.' ;
                    leaf cpe-ipv6-address {
                      description 'IPv6 address of CPE.' ;
                      type ncd:ipv6-address ;

                      mandatory true ;
                    }

                    leaf aftr-ipv6-address {
                      description 'IPv6 address of AFTR.' ;
                      type ncd:ipv6-address ;

                      mandatory true ;
                    }

                    leaf local-ip {
                      description 'Local IP address.' ;
                      type ncd:ipv4-address-none-zero ;

                      mandatory true ;
                    }

                    leaf dslite-vrf {
                      description 'VRF of DSLITE.' ;
                      type string {
                        length 1..32 ;

                      }

                      ncd:revise-date 2021-02-26 ;
                    }

                  }

                }

                case vrf {
                  description 'VRF.' ;
                  container vrf {
                    description 'VRF.' ;
                    leaf vrf-name {
                      description 'VRF name.' ;
                      type string {
                        length 1..32 ;

                      }

                      mandatory true ;
                    }

                    leaf local-ip {
                      description 'Local IP address.' ;
                      type ncd:ipv4-address-none-zero ;

                      mandatory true ;
                    }

                  }

                }

                case cpe {
                  description 'CPE.' ;
                  container cpe {
                    description 'CPE.' ;
                    leaf cpe-ipv6-address {
                      description 'IPv6 address of CPE.' ;
                      type ncd:ipv6-address ;

                      mandatory true ;
                    }

                    leaf cpe-vrf {
                      description 'VRF of CPE.' ;
                      type string {
                        length 1..32 ;

                      }

                    }

                    leaf nat64-prefix {
                      description 'NAT64 prefix.' ;
                      type ncd:ipv6-address ;

                      mandatory true ;
                    }

                    leaf nat64-prefix-vrf {
                      description 'VRF of NAT64 prefix.' ;
                      type string {
                        length 1..32 ;

                      }

                    }

                    leaf nat64-prefix-length {
                      description 'Prefix length of NAT64.' ;
                      type enumeration {
                        enum 96 {
                          value 96 ;
                        }

                        enum 32 {
                          value 32 ;
                          description '32' ;
                        }

                        enum 40 {
                          value 40 ;
                          description '40' ;
                        }

                        enum 48 {
                          value 48 ;
                          description '48' ;
                        }

                        enum 56 {
                          value 56 ;
                          description '56' ;
                        }

                        enum 64 {
                          value 64 ;
                          description '64' ;
                        }

                      }

                      mandatory true ;
                    }

                  }

                }

                case public {
                  description 'Public.' ;
                  container public {
                    description 'Public.' ;
                    leaf local-ip {
                      description 'Local IP address.' ;
                      type ncd:ipv4-address-none-zero ;

                      mandatory true ;
                    }

                  }

                }

              }

              choice trans-mode {
                description 'Translation mode.' ;
                mandatory true ;
                case pat {
                  description 'PAT.' ;
                  container pat {
                    description 'PAT.' ;
                    leaf local-port {
                      description 'Local port.' ;
                      type uint16 {
                        range 1..65535 ;

                      }

                      mandatory true ;
                    }

                    leaf local-end-port {
                      description 'Local end port.' ;
                      type uint16 {
                        range 1..65535 ;

                      }

                      ncd:revise-date 2021-06-18 ;
                    }

                    leaf global-ip {
                      description 'Global IP address.' ;
                      type ncd:ipv4-address-none-zero ;

                      mandatory true ;
                    }

                    leaf global-port {
                      description 'Global port.' ;
                      type uint16 {
                        range 1..65535 ;

                      }

                      mandatory true ;
                    }

                    leaf global-end-port {
                      description 'Global end port.' ;
                      type uint16 {
                        range 1..65535 ;

                      }

                      ncd:revise-date 2021-06-18 ;
                    }

                    leaf protocol {
                      description 'Protocol.' ;
                      type enumeration {
                        enum tcp {
                          value 6 ;
                        }

                        enum udp {
                          value 17 ;
                        }

                      }

                      mandatory true ;
                    }

                  }

                }

                case nat {
                  description 'NAT.' ;
                  container nat {
                    description 'NAT.' ;
                    leaf global-ip {
                      description 'Global IP address.' ;
                      type ncd:ipv4-address-none-zero ;

                      mandatory true ;
                    }

                  }

                }

                case interface-pat {
                  if-feature static-rule-interface-feature ;

                  description 'Interface PAT.' ;
                  container if-pat {
                    description 'PAT.' ;
                    leaf local-port {
                      description 'Local port.' ;
                      type uint16 {
                        range 1..65535 ;

                      }

                      mandatory true ;
                    }

                    leaf local-end-port {
                      description 'Local end port.' ;
                      type uint16 {
                        range 1..65535 ;

                      }

                      ncd:revise-date 2021-06-18 ;
                    }

                    leaf if-name {
                      description 'Interface name.' ;
                      type ncd:ifname ;

                      mandatory true ;
                    }

                    leaf global-port {
                      description 'Global port.' ;
                      type uint16 {
                        range 1..65535 ;

                      }

                      mandatory true ;
                    }

                    leaf global-end-port {
                      description 'Global end port.' ;
                      type uint16 {
                        range 1..65535 ;

                      }

                      ncd:revise-date 2021-06-18 ;
                    }

                    leaf protocol {
                      description 'Protocol.' ;
                      type enumeration {
                        enum tcp {
                          value 6 ;
                        }

                        enum udp {
                          value 17 ;
                        }

                      }

                      mandatory true ;
                    }

                  }

                  ncd:revise-date 2018-04-19 ;
                }

                case interface-nat {
                  if-feature static-rule-interface-feature ;

                  description 'Interface NAT.' ;
                  container if-nat {
                    description 'NAT.' ;
                    leaf if-name {
                      description 'Interface name.' ;
                      type ncd:ifname ;

                      mandatory true ;
                    }

                  }

                  ncd:revise-date 2018-04-19 ;
                }

              }

              leaf car-policy {
                description 'CAR policy.' ;
                type string {
                  length 1..31 ;

                }

              }

              leaf time-range {
                description 'Time range.' ;
                type string {
                  length 1..31 ;

                }

              }

              container dest-ip {
                leaf dest-ip {
                  type ncd:ipv4-address-none-zero ;

                  description 'Destination IP.' ;
                  mandatory true ;
                }

                if-feature static-rule-dest-ip-feature {
                  ncd:revise-date 2024-04-01 ;
                }

                description 'Destination IP.' ;
                presence dest-ip ;
                leaf dest-ip-mask {
                  type ncd:ipv4-mask {
                    pattern '([1-9][0-9]*\.[1-9][0-9]*\.[1-9][0-9]*\.[1-9][0-9]*)|([1-9][0-9]*\.0\.0\.0)|(0\.[1-9][0-9]*\.0\.0)|(0\.0\.[1-9][0-9]*\.0)|(0\.0\.0\.[1-9][0-9]*)|([1-9][0-9]*\.[1-9][0-9]*\.0\.0)|(0\.[1-9][0-9]*\.[1-9][0-9]*\.0)|(0\.0\.[1-9][0-9]*\.[1-9][0-9]*)|([1-9][0-9]*\.0\.0\.[1-9][0-9]*)|(0\.[1-9][0-9]*\.0\.[1-9][0-9]*)|([1-9][0-9]*\.0\.[1-9][0-9]*\.0)|([1-9][0-9]*\.[1-9][0-9]*\.[1-9][0-9]*\.0)|([1-9][0-9]*\.[1-9][0-9]*\.0\.[1-9][0-9]*)|([1-9][0-9]*\.0\.[1-9][0-9]*\.[1-9][0-9]*)|(0\.[1-9][0-9]*\.[1-9][0-9]*\.[1-9][0-9]*)' ;

                  }

                  description 'Destination IP mask.' ;
                  mandatory true ;
                }

                ncd:revise-date 2024-04-01 ;
              }

            }

          }

          container same-address-policy {
            description 'Same address policy.' ;
            presence same-address-policy ;
            leaf same-addr-for-same-ipv4 {
              description 'Allocate the same global IP for one local IPv4 address.' ;
              type enumeration {
                enum must {
                  value 2 ;
                }

                enum try-best {
                  value 1 ;
                }

                enum random {
                  value 0 ;
                }

              }

              default random ;
            }

            leaf same-addr-for-same-softwire {
              status obsolete {
                ncd:revise-date 2021-02-26 ;
              }

              description 'Allocate the same global IP for one softwire.' ;
              type enumeration {
                enum must {
                  value 2 ;
                }

                enum try-best {
                  value 1 ;
                }

                enum random {
                  value 0 ;
                }

              }

              default random ;
            }

            leaf same-addr-for-same-user {
              status obsolete {
                ncd:revise-date 2021-02-26 ;
              }

              description 'Allocate the same global IP for one user.' ;
              type enumeration {
                enum must {
                  value 2 ;
                }

                enum try-best {
                  value 1 ;
                }

                enum random {
                  value 0 ;
                }

              }

              default random ;
            }

            leaf same-addr-for-same-ipv6 {
              description 'Allocate the same global IP for one local IPv6 address.' ;
              type enumeration {
                enum must {
                  value 2 ;
                }

                enum try-best {
                  value 1 ;
                }

                enum random {
                  value 0 ;
                }

              }

              default random ;
              ncd:revise-date 2021-02-26 ;
            }

          }

          container different-address-policy {
            description 'Different address policy.' ;
            presence diff-address-policy ;
            list different-addr-tcp-udp {
              description 'Allocate different address for TCP or UDP.' ;
              key 'protocol-type dest-port' ;
              leaf protocol-type {
                description 'Protocol type.' ;
                type enumeration {
                  enum tcp {
                    value 6 ;
                  }

                  enum udp {
                    value 17 ;
                  }

                }

              }

              leaf dest-port {
                description 'Destination port.' ;
                type uint16 {
                  range 1..65535 ;

                }

              }

              leaf description {
                description 'Description.' ;
                type string {
                  length 1..31 ;

                }

                mandatory true ;
              }

            }

            list different-addr-icmp {
              description 'Allocate different address for ICMP.' ;
              max-elements 1 ;
              key protocol-type ;
              leaf protocol-type {
                description 'Protocol type.' ;
                type enumeration {
                  enum icmp {
                    value 1 ;
                  }

                }

              }

              leaf description {
                description 'Description.' ;
                type string {
                  length 1..31 ;

                }

                mandatory true ;
              }

            }

          }

          container tcp-policy {
            description 'TCP policy.' ;
            presence tcp-policy ;
            leaf filtering-mode {
              description 'Filtering mode.' ;
              type enumeration {
                enum endpoint-independent {
                  value 1 ;
                }

                enum address-dependent {
                  value 2 ;
                }

                enum address-and-port-dependent {
                  value 3 ;
                }

              }

              default endpoint-independent ;
            }

            leaf mapping-mode {
              description 'Mapping mode.' ;
              type enumeration {
                enum endpoint-independent {
                  value 1 ;
                }

                enum address-dependent {
                  value 2 ;
                }

                enum address-and-port-dependent {
                  value 3 ;
                }

              }

              default endpoint-independent ;
            }

            leaf refreshing-mode {
              description 'Refreshing mode.' ;
              type enumeration {
                enum inbound {
                  value 1 ;
                }

                enum outbound {
                  value 2 ;
                }

                enum both-bounds {
                  value 3 ;
                }

              }

              default outbound ;
            }

            leaf well-known-port-timeout {
              description 'Timeout of well-known port.The default value is the performance parameter customized by the product.' ;
              type uint16 {
                range 1..7200 ;

              }

            }

            leaf well-known-syn-timeout {
              description 'Timeout of well-known TCP SYN.The default value is the performance parameter customized by the product.' ;
              type uint16 {
                range 1..7200 ;

              }

            }

            leaf well-known-fin-rst-timeout {
              description 'Timeout of well-known TCP FIN or TCP RST.The default value is the performance parameter customized by the product.' ;
              type uint16 {
                range 1..7200 ;

              }

            }

            leaf unwell-known-port-timeout {
              description 'Timeout of unwell-known port.The default value is the performance parameter customized by the product.' ;
              type uint16 {
                range 1..7200 ;

              }

            }

            leaf unwell-known-syn-timeout {
              description 'Timeout of unwell-known TCP SYN.The default value is the performance parameter customized by the product.' ;
              type uint16 {
                range 1..7200 ;

              }

            }

            leaf unwell-known-fin-rst-timeout {
              description 'Timeout of unwell-known TCP FIN or TCP RST.The default value is the performance parameter customized by the product.' ;
              type uint16 {
                range 1..7200 ;

              }

            }

            leaf port-parity {
              status obsolete {
                ncd:revise-date 2017-02-08 ;
              }

              description 'Parity of port.' ;
              type enumeration {
                enum enable {
                  value 1 ;
                }

                enum disable {
                  value 0 ;
                }

              }

              default disable ;
            }

            leaf port-random {
              description 'Randomization of port.' ;
              type enumeration {
                enum enable {
                  value 1 ;
                }

                enum disable {
                  value 0 ;
                }

              }

              default disable ;
            }

            container allowed-port-range {
              description 'Allowed port range.' ;
              presence allowed-range-port ;
              leaf start-port {
                description 'Start port.' ;
                type uint16 {
                  range 1..65535 ;

                }

                mandatory true ;
              }

              leaf end-port {
                description 'End port.' ;
                type uint16 {
                  range 1..65535 ;

                }

                mandatory true ;
              }

            }

            container forbidden-port-range {
              description 'Forbidden port range.' ;
              presence forbidden-port-range ;
              leaf start-port {
                description 'Start port.' ;
                type uint16 {
                  range 1..65535 ;

                }

                mandatory true ;
              }

              leaf end-port {
                description 'End port.' ;
                type uint16 {
                  range 1..65535 ;

                }

                mandatory true ;
              }

            }

            leaf well-known-fin-wait-timeout {
              description 'Timeout of well-known TCP FIN wait.' ;
              type uint16 {
                range 0..7200 ;

              }

              default 0 ;
              ncd:revise-date 2017-06-20 ;
            }

            leaf unwell-known-fin-wait-timeout {
              description 'Timeout of unwell-known TCP FIN wait.' ;
              type uint16 {
                range 0..7200 ;

              }

              default 0 ;
              ncd:revise-date 2017-06-20 ;
