                value 0 ;
              }

            }

            default disable ;
            ncd:revise-date 2017-08-03 ;
          }

          leaf hotback-delay-time {
            description 'Hotback translations delay time. Unit: Seconds.' ;
            type uint16 {
              range 2..120 ;

            }

            ncd:revise-date 2022-10-20 ;
          }

        }

        list pcp-service {
          description 'PCP service.' ;
          key instance-name ;
          leaf instance-name {
            description 'Instance name.' ;
            type ncd:string-quesiton-mark {
              length 1..31 ;

            }

          }

          leaf pcp-switch {
            description 'PCP switch.' ;
            type enumeration {
              enum enable {
                value 1 ;
              }

              enum disable {
                value 0 ;
              }

            }

            default disable ;
          }

          leaf min-life-time {
            description 'Mapping minimum life time.' ;
            type uint32 {
              range 120..86400 ;

            }

            default 120 ;
          }

          leaf max-life-time {
            description 'Maximal life time.' ;
            type uint32 {
              range 120..86400 ;

            }

            default 86400 ;
          }

          leaf ipv4-acl {
            description 'IPv4 access control list.' ;
            type string {
              length 1..31 ;

            }

          }

          leaf ipv6-acl {
            description 'IPv6 access control list.' ;
            type string {
              length 1..31 ;

            }

          }

        }

        list protocol-session-timeout {
          description 'Session timeout for different protocol.' ;
          max-elements 512 ;
          key 'instance-name protocol destination-port' ;
          leaf instance-name {
            description 'Instance name.' ;
            type ncd:string-quesiton-mark {
              length 1..31 ;

            }

          }

          leaf protocol {
            description 'Protocol.' ;
            type enumeration {
              enum tcp {
                value 6 ;
              }

              enum udp {
                value 17 ;
              }

            }

          }

          leaf destination-port {
            description 'Destination port.' ;
            type uint16 {
              range 1..65535 ;

            }

          }

          leaf description {
            description 'Description.' ;
            type string {
              length 1..63 ;

            }

            mandatory true ;
          }

          leaf timeout {
            description 'Timeout.' ;
            type uint16 {
              range 1..7200 ;

            }

            mandatory true ;
          }

        }

      }

      container alg-list {
        description 'ALG list.' ;
        list alg-switch {
          description 'ALG switch.' ;
          key instance-name ;
          leaf instance-name {
            description 'Instance name.' ;
            type ncd:string-quesiton-mark ;

          }

          leaf ftp {
            description 'FTP.' ;
            type enumeration {
              enum enable {
                value 1 ;
                description 'Enable FTP ALG' ;
              }

              enum disable {
                value 0 ;
                description 'Disable FTP ALG' ;
              }

            }

            default disable ;
          }

          leaf icmp {
            description 'ICMP.' ;
            type enumeration {
              enum enable {
                value 1 ;
                description 'Enable ICMP ALG' ;
              }

              enum disable {
                value 0 ;
                description 'Disable ICMP ALG' ;
              }

            }

            default disable ;
          }

          leaf dns {
            description 'DNS.' ;
            type enumeration {
              enum enable {
                value 1 ;
                description 'Enable DNS ALG' ;
              }

              enum disable {
                value 0 ;
                description 'Disable DNS ALG' ;
              }

            }

            default disable ;
          }

          leaf rtsp {
            description 'RTSP.' ;
            type enumeration {
              enum enable {
                value 1 ;
                description 'Enable RTSP ALG' ;
              }

              enum disable {
                value 0 ;
                description 'Disable RTSP ALG' ;
              }

            }

            default disable ;
          }

          leaf h323 {
            description 'H323.' ;
            type enumeration {
              enum enable {
                value 1 ;
                description 'Enable H323 ALG' ;
              }

              enum disable {
                value 0 ;
                description 'Disable H323 ALG' ;
              }

            }

            default disable ;
          }

          leaf sip {
            description 'SIP.' ;
            type enumeration {
              enum enable {
                value 1 ;
                description 'Enable SIP ALG' ;
              }

              enum disable {
                value 0 ;
                description 'Disable SIP ALG' ;
              }

            }

            default disable ;
          }

          leaf pptp {
            description 'PPTP.' ;
            type enumeration {
              enum enable {
                value 1 ;
                description 'Enable PPTP ALG' ;
              }

              enum disable {
                value 0 ;
                description 'Disable PPTP ALG' ;
              }

            }

            default disable ;
          }

          leaf http {
            description 'HTTP.' ;
            type enumeration {
              enum enable {
                value 1 ;
                description 'Enable HTTP ALG' ;
              }

              enum disable {
                value 0 ;
                description 'Disable HTTP ALG' ;
              }

            }

            default disable ;
            if-feature http-alg-feature {
              ncd:revise-date 2025-04-10 ;
            }

          }

          leaf dhcp {
            description 'DHCP.' ;
            type enumeration {
              enum enable {
                value 1 ;
                description 'Enable DHCP ALG' ;
              }

              enum disable {
                value 0 ;
                description 'Disable DHCP ALG' ;
              }

            }

            default disable ;
          }

          leaf ipsec {
            type enumeration {
              enum enable {
                description 'Enable IPSEC ALG' ;
                value 1 ;
              }

              enum disable {
                description 'Disable IPSEC ALG' ;
                value 0 ;
              }

            }

            description 'IPSEC.' ;
            default disable ;
            ncd:revise-date 2024-07-15 ;
          }

          leaf ftp-nat64 {
            description 'NAT64 FTP.' ;
            type enumeration {
              enum enable {
                value 1 ;
                description 'Enable FTP ALG' ;
              }

              enum disable {
                value 0 ;
                description 'Disable FTP ALG' ;
              }

            }

            default disable ;
            ncd:revise-date 2021-02-26 ;
          }

          leaf icmp-nat64 {
            description 'NAT64 ICMP.' ;
            type enumeration {
              enum enable {
                value 1 ;
                description 'Enable ICMP ALG' ;
              }

              enum disable {
                value 0 ;
                description 'Disable ICMP ALG' ;
              }

            }

            default disable ;
            ncd:revise-date 2021-02-26 ;
          }

          leaf dns-nat64 {
            description 'NAT64 DNS.' ;
            type enumeration {
              enum enable {
                value 1 ;
                description 'Enable DNS ALG' ;
              }

              enum disable {
                value 0 ;
                description 'Disable DNS ALG' ;
              }

            }

            default disable ;
            ncd:revise-date 2021-02-26 ;
          }

          leaf rtsp-nat64 {
            description 'NAT64 RTSP.' ;
            type enumeration {
              enum enable {
                value 1 ;
                description 'Enable RTSP ALG' ;
              }

              enum disable {
                value 0 ;
                description 'Disable RTSP ALG' ;
              }

            }

            default disable ;
            ncd:revise-date 2021-02-26 ;
          }

          leaf http-nat64 {
            description 'NAT64 HTTP.' ;
            type enumeration {
              enum enable {
                value 1 ;
                description 'Enable HTTP ALG' ;
              }

              enum disable {
                value 0 ;
                description 'Disable HTTP ALG' ;
              }

            }

            default disable ;
            ncd:revise-date 2021-02-26 ;
          }

          leaf pptp-nat64 {
            type enumeration {
              enum enable {
                value 1 ;
                description 'Enable PPTP ALG' ;
              }

              enum disable {
                value 0 ;
                description 'Disable PPTP ALG' ;
              }

            }

            description 'NAT64 PPTP.' ;
            default disable ;
            ncd:revise-date 2025-03-21 ;
          }

        }

        list alg-port {
          description 'ALG port.' ;
          max-elements 16 ;
          key 'instance-name protocol port' ;
          leaf instance-name {
            description 'Instance name.' ;
            type ncd:string-quesiton-mark ;

          }

          leaf protocol {
            description 'Protocol.' ;
            type enumeration {
              enum tcp {
                value 6 ;
                description 'TCP' ;
              }

            }

          }

          leaf port {
            description 'Port.' ;
            type uint16 {
              range 1..65535 {
                description '1-65535' ;
              }

            }

          }

          leaf alg-type {
            description 'ALG type.' ;
            type enumeration {
              enum ftp {
                value 0 ;
                description 'FTP' ;
              }

            }

            mandatory true ;
          }

        }

        list alg-nat64-port {
          description 'NAT64 ALG port.' ;
          max-elements 16 ;
          key 'instance-name protocol port' ;
          leaf instance-name {
            description 'Instance name.' ;
            type ncd:string-quesiton-mark ;

          }

          leaf protocol {
            description 'Protocol.' ;
            type enumeration {
              enum tcp {
                value 6 ;
                description 'TCP' ;
              }

              enum udp {
                value 17 ;
                description 'UDP' ;
              }

            }

          }

          leaf port {
            description 'Port.' ;
            type uint16 {
              range 1..65535 {
                description '1-65535' ;
              }

            }

          }

          leaf description {
            description 'Description.' ;
            type string {
              length 1..31 ;

            }

            mandatory true ;
          }

          ncd:revise-date 2021-02-26 ;
        }

      }

      container alarm-list {
        description 'Alarm list.' ;
        list alarm {
          description 'Alarm.' ;
          key instance-name ;
          leaf instance-name {
            description 'Instance name.' ;
            type ncd:string-quesiton-mark ;

          }

          leaf alarm-switch {
            description 'Alarm switch.' ;
            type enumeration {
              enum enable {
                value 1 ;
                description 'Start CGN alarm' ;
              }

              enum disable {
                value 0 ;
                description 'Stop CGN alarm' ;
              }

            }

            default disable ;
          }

          leaf warning-switch {
            description 'Warning switch.' ;
            type enumeration {
              enum enable {
                value 0 ;
                description 'Start CGN warning' ;
              }

              enum disable {
                value 1 ;
                description 'Stop CGN warning' ;
              }

            }

            default enable ;
          }

          leaf port-range-block-alarm-switch {
            description 'Alarm switch of port range block utilization.' ;
            type enumeration {
              enum enable {
                value 1 ;
                description 'Start alarm' ;
              }

              enum disable {
                value 0 ;
                description 'Stop alarm' ;
              }

            }

            default disable ;
          }

          leaf ip-resource-threshold {
            description 'IP resource alarm threshold of NAT pool.' ;
            type uint16 {
              range 1..100 {
                description '<1-100>' ;
              }

            }

            default 80 ;
          }

          leaf port-resource-threshold {
            description 'Port resource alarm threshold of PAT pool.' ;
            type uint16 {
              range 1..100 {
                description '<1-100>' ;
              }

            }

            default 80 ;
          }

          leaf translations-threshold-high-level {
            description 'High level threshold of translations.' ;
            type uint16 {
              range 1..100 ;

            }

            ncd:revise-date 2016-09-22 ;
          }

          leaf translations-threshold-middle-level {
            description 'Middle level threshold of translations.' ;
            type uint16 {
              range 1..100 ;

            }

            ncd:revise-date 2016-09-22 ;
          }

          leaf translations-threshold {
            description 'Translations alarm threshold.' ;
            type uint16 {
              range 1..100 {
                description '<1-100>' ;
              }

            }

            default 80 ;
          }

          leaf performance-statistics-switch {
            description 'Performance statistics switch.' ;
            type enumeration {
              enum on {
                value 1 ;
                description 'Start CGN performance statistics switch.' ;
              }

              enum off {
                value 0 ;
                description 'Stop CGN performance statistics switch.' ;
              }

            }

            default off ;
            ncd:revise-date 2016-09-22 ;
          }

          container local-ip-threshold {
            description 'Local IP threshold.' ;
            leaf high-level {
              description 'High level threshold of local IP.' ;
              type int16 {
                range 1..100 ;

              }

            }

            leaf middle-level {
              description 'Middle level threshold of local IP.' ;
              type int16 {
                range 1..100 ;

              }

            }

            leaf low-level {
              description 'Low level threshold of local IP.' ;
              type int16 {
                range 1..100 ;

              }

              default 80 ;
            }

            ncd:revise-date 2016-09-22 ;
          }

          leaf static-port-range-threshold {
            description 'Static port range alarm threshold.' ;
            type uint8 {
              range 1..100 ;

            }

            default 95 ;
            ncd:revise-date 2019-03-06 ;
          }

        }

      }

    }

    container aftr {
      leaf aftr-switch {
        description 'AFTR switch.' ;
        type enumeration {
          enum enable {
            value 1 ;
            description 'Enable' ;
          }

          enum disable {
            value 0 ;
            description 'Disable' ;
          }

        }

        default enable ;
      }

      leaf protect-action-forward {
        description 'Protect forward.' ;
        type enumeration {
          enum enable {
            value 1 ;
          }

          enum disable {
            value 0 ;
          }

        }

        default disable ;
      }

      description 'AFTR.' ;
      ncd:revise-date 2021-02-26 ;
    }

  }

}
