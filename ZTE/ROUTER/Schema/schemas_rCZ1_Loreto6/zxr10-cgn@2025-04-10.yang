  revision 2015-12-07 {
    description 'Initial version.' ;
  }

  feature static-rule-interface-feature {
    description 'Static rule interface feature.' ;
  }

  feature section-interface-feature {
    description 'Section interface feature.' ;
    ncd:revise-date 2023-01-17 ;
  }

  feature location-node-capacity-feature {
    description 'Location node capacity feature.' ;
    ncd:revise-date 2024-03-12 ;
  }

  feature static-rule-dest-ip-feature {
    description 'Static rule dest IP feature.' ;
    ncd:revise-date 2024-04-01 ;
  }

  feature http-alg-feature {
    description 'HTTP ALG feature.' ;
    ncd:revise-date 2025-04-10 ;
  }

  container state {
    config false ;
    description 'The state of CGN.' ;
    container cgn {
      description 'The CGN state.' ;
      container global-counters {
        description 'The global counters of CGN.' ;
        leaf trans-packet-num {
          description 'The number of packets successfully translated.' ;
          type uint32 ;

          default 0 ;
        }

        leaf port-deplete-num {
          description 'The number of packets discarded due to port resource depletion.' ;
          type uint32 ;

          default 0 ;
        }

        leaf quota-exceed-num {
          description 'The number of packets discarded because of the quota exceeded.' ;
          type uint32 ;

          default 0 ;
        }

        leaf trans-num {
          description 'Translations number.' ;
          type uint32 ;

          default 0 ;
        }

        leaf ipv4-address-num {
          description 'The number of private IPv4 addresses.' ;
          type uint32 ;

          default 0 ;
        }

        leaf private-ipv4-num {
          description 'The number of private IPv4 addresses.' ;
          type uint32 ;

          default 0 ;
        }

      }

      container translations-summary {
        description 'CGN translations summary.' ;
        container total-sum {
          description 'CGN translations total number.' ;
          leaf static-nat-trans-num {
            description 'Static NAT translations number.' ;
            type uint32 ;

          }

          leaf static-pat-trans-num {
            description 'Static PAT translations number.' ;
            type uint32 ;

          }

          leaf dynamic-nat-trans-num {
            description 'Dynamic NAT translations number.' ;
            type uint32 ;

          }

          leaf dynamic-pat-trans-num {
            description 'Dynamic PAT translations number.' ;
            type uint32 ;

          }

          leaf alg-trans-num {
            description 'ALG translations number.' ;
            type uint32 ;

          }

          leaf pcp-trans-num {
            description 'PCP translations number.' ;
            type uint32 ;

          }

          leaf local-ip-num {
            description 'Local IP number.' ;
            type uint32 ;

          }

          leaf total-translations-num {
            description 'Total translations number.' ;
            type uint32 ;

          }

        }

        list single-cpu-sum {
          description 'CGN translations number of one CPU.' ;
          key cpu-name ;
          leaf cpu-name {
            description 'CPU Name.' ;
            type ncd:cpu ;

          }

          leaf static-nat-trans-num {
            description 'Static NAT translations number.' ;
            type uint32 ;

          }

          leaf static-pat-trans-num {
            description 'Static NAT translations number.' ;
            type uint32 ;

          }

          leaf dynamic-nat-trans-num {
            description 'Dynamic NAT translations number.' ;
            type uint32 ;

          }

          leaf dynamic-pat-trans-num {
            description 'Dynamic PAT translations number.' ;
            type uint32 ;

          }

          leaf alg-trans-num {
            description 'ALG translations number.' ;
            type uint32 ;

          }

          leaf pcp-trans-num {
            description 'PCP translations number.' ;
            type uint32 ;

          }

          leaf local-ip-num {
            description 'Local IP number.' ;
            type uint32 ;

          }

        }

      }

      container pool-utilization {
        description 'Pool utilization.' ;
        container total {
          description 'Total.' ;
          leaf nat-used-ip-count {
            description 'NAT used IP count.' ;
            type uint32 ;

          }

          leaf nat-total-ip-count {
            description 'NAT total IP count.' ;
            type uint32 ;

          }

          leaf pat-total-ip-count {
            description 'PAT total IP count.' ;
            type uint32 ;

          }

          leaf tcp-used-port-count {
            description 'TCP used port count.' ;
            type uint32 ;

          }

          leaf udp-used-port-count {
            description 'UDP used port count.' ;
            type uint32 ;

          }

          leaf icmp-used-port-count {
            description 'ICMP used port count.' ;
            type uint32 ;

          }

          leaf tcp-total-port-count {
            description 'TCP total port count.' ;
            type uint32 ;

          }

          leaf udp-total-port-count {
            description 'UDP total port count.' ;
            type uint32 ;

          }

          leaf icmp-total-port-count {
            description 'ICMP total port count.' ;
            type uint32 ;

          }

        }

        list pool {
          description 'Pool.' ;
          key pool-name ;
          leaf pool-name {
            description 'Pool name.' ;
            type string {
              length 1..31 ;

            }

          }

          leaf nat-used-ip-count {
            description 'NAT used IP count.' ;
            type uint32 ;

          }

          leaf nat-total-ip-count {
            description 'NAT total IP count.' ;
            type uint32 ;

          }

          leaf pat-total-ip-count {
            description 'PAT total IP count.' ;
            type uint32 ;

          }

          leaf tcp-used-port-count {
            description 'TCP used port count.' ;
            type uint32 ;

          }

          leaf udp-used-port-count {
            description 'UDP used port count.' ;
            type uint32 ;

          }

          leaf icmp-used-port-count {
            description 'ICMP used port count.' ;
            type uint32 ;

          }

          leaf tcp-total-port-count {
            description 'TCP total port count.' ;
            type uint32 ;

          }

          leaf udp-total-port-count {
            description 'UDP total port count.' ;
            type uint32 ;

          }

          leaf icmp-total-port-count {
            description 'ICMP total port count.' ;
            type uint32 ;

          }

        }

        list cpu {
          description 'CPU.' ;
          key cpu-name ;
          leaf cpu-name {
            description 'CPU Name.' ;
            type ncd:cpu ;

          }

          leaf nat-used-ip-count {
            description 'NAT used IP count.' ;
            type uint32 ;

          }

          leaf nat-total-ip-count {
            description 'NAT total IP count.' ;
            type uint32 ;

          }

          leaf pat-total-ip-count {
            description 'PAT total IP count.' ;
            type uint32 ;

          }

          leaf tcp-used-port-count {
            description 'TCP used port count.' ;
            type uint32 ;

          }

          leaf udp-used-port-count {
            description 'UDP used port count.' ;
            type uint32 ;

          }

          leaf icmp-used-port-count {
            description 'ICMP used port count.' ;
            type uint32 ;

          }

          leaf tcp-total-port-count {
            description 'TCP total port count.' ;
            type uint32 ;

          }

          leaf udp-total-port-count {
            description 'UDP total port count.' ;
            type uint32 ;

          }

          leaf icmp-total-port-count {
            description 'ICMP total port count.' ;
            type uint32 ;

          }

        }

        list detail {
          description 'Detail.' ;
          key 'cpu-name pool-name' ;
          leaf cpu-name {
            description 'CPU Name.' ;
            type ncd:cpu ;

          }

          leaf pool-name {
            description 'Pool name.' ;
            type string {
              length 1..31 ;

            }

          }

          leaf nat-used-ip-count {
            description 'NAT used IP count.' ;
            type uint32 ;

          }

          leaf nat-total-ip-count {
            description 'NAT total IP count.' ;
            type uint32 ;

          }

          leaf pat-total-ip-count {
            description 'PAT total IP count.' ;
            type uint32 ;

          }

          leaf tcp-used-port-count {
            description 'TCP used port count.' ;
            type uint32 ;

          }

          leaf udp-used-port-count {
            description 'UDP used port count.' ;
            type uint32 ;

          }

          leaf icmp-used-port-count {
            description 'ICMP used port count.' ;
            type uint32 ;

          }

          leaf tcp-total-port-count {
            description 'TCP total port count.' ;
            type uint32 ;

          }

          leaf udp-total-port-count {
            description 'UDP total port count.' ;
            type uint32 ;

          }

          leaf icmp-total-port-count {
            description 'ICMP total port count.' ;
            type uint32 ;

          }

        }

        list ip {
          description 'IP.' ;
          key 'pool-name ip cpu-name' ;
          leaf pool-name {
            description 'Pool name.' ;
            type string {
              length 1..31 ;

            }

          }

          leaf ip {
            description 'IP address.' ;
            type ncd:ipv4-address-none-zero ;

          }

          leaf cpu-name {
            description 'CPU Name.' ;
            type ncd:cpu ;

          }

          leaf nat-used-ip-count {
            description 'NAT used IP count.' ;
            type uint32 ;

          }

          leaf nat-total-ip-count {
            description 'NAT total IP count.' ;
            type uint32 ;

          }

          leaf pat-total-ip-count {
            description 'PAT total IP count.' ;
            type uint32 ;

          }

          leaf tcp-used-port-count {
            description 'TCP used port count.' ;
            type uint32 ;

          }

          leaf udp-used-port-count {
            description 'UDP used port count.' ;
            type uint32 ;

          }

          leaf icmp-used-port-count {
            description 'ICMP used port count.' ;
            type uint32 ;

          }

          leaf tcp-total-port-count {
            description 'TCP total port count.' ;
            type uint32 ;

          }

          leaf udp-total-port-count {
