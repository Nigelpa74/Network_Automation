              description 'Value for default high threshold.' ;
              type binary {
                length 10 ;

              }

            }

            leaf warnlow {
              description 'Value for default warn-low threshold.' ;
              type binary {
                length 10 ;

              }

            }

            leaf warnhigh {
              description 'Value for default warn-high threshold.' ;
              type binary {
                length 10 ;

              }

            }

            leaf curlow {
              description 'Value for current low threshold.' ;
              type binary {
                length 10 ;

              }

            }

            leaf curhigh {
              description 'Value for current high threshold.' ;
              type binary {
                length 10 ;

              }

            }

            leaf curwarnlow {
              description 'Value for current warn-low threshold.' ;
              type binary {
                length 10 ;

              }

            }

            leaf curwarnhigh {
              description 'Value for current warn-high threshold.' ;
              type binary {
                length 10 ;

              }

            }

            leaf minvalue {
              description 'The minimum detectable value. Not used.' ;
