module zxr10-performance {
  namespace "http://www.zte.com.cn/zxr10/netconf/schema/rosng/performance" ;
  prefix pm ;
  yang-version 1 ;
  import zxr10-netconf-defs {
    prefix ncd ;
  }

  organization "ZTE Corporation" ;
  contact "ZTE Corporation
  Nanjing Institute of ZTE Corporation
  No.68 Zijinghua Rd. Yuhuatai District, Nanjing, China
  Tel: +86-25-52870000" ;
  description 'The netconf module to describe performance' ;
  revision 2025-03-24 {
    description '(1) Correct the display of /pm:state/pm:performance/pm:statistics queries for BVI interface (checkpoint-type 402), BVI sub-interface (checkpoint-type 393), and tunnel (checkpoint-type 577). Cap the bandwidth utilization display at 100% once it exceeds 100%.' ;
  }
  revision 2024-12-09 {
    description '(1)Add state/performance/threshold/satellite-current-thresholds' ;
  }

  revision 2024-09-03 {
    description '(1) Modify the description information of the performance module.' ;
  }

