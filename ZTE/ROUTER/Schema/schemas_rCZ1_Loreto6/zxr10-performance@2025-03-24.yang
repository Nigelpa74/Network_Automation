            leaf high-state {
              type uint8 ;

              description 'High threshold state.' ;
            }

            leaf warn-low-state {
              type uint8 ;

              description 'Warn-low threshold state.' ;
            }

            leaf warn-high-state {
              type uint8 ;

              description 'Warn-high threshold state.' ;
            }

            key 'checkpoint-type tpid perfcode tpid-length' ;
            description "Only supports queries for specified 'checkpoint-type' ,'tpid’and 'perfcode' . Does not support wild queries." ;
            leaf result {
              type uint8 {
                range 0..255 ;

              }

              description 'Query result.' ;
            }

            ncd:select "checkpoint-type tpid perfcode tpid-length" ;
          }

          description 'Query the current threshold on the satellite device. At present, it is only used to construct xml message for querying from the center to the satellite, and does not support querying directly from the node to the device.' ;
          ncd:revise-date 2024-12-09 ;
        }

      }

    }

  }

  container operation {
    description 'Operation info. ' ;
    config false ;
    container performance {
      description 'Performance operation.' ;
      container clear {
        description 'Cleared performance data.The performance alarm will immediately disappear.' ;
        container currentdata {
          description 'Cleared current performance data.' ;
          list currentdatum {
            description 'Used to clear current performance value.' ;
            key 'cycle checkpoint-type tpid-matcher tpid-mask perfcode tpid-class' ;
            leaf cycle {
              description 'Performance cycle.' ;
              type enumeration {
                enum fifteen-minutes {
                  value 1 ;
                  description 'Minute cycle. The actual cycle value depends on the minute-cycle configuration.' ;
                }

                enum twenty-four-hours {
                  value 2 ;
                }

              }

            }

            leaf checkpoint-type {
              description 'TPID type. 0xFFFF for all.' ;
              type uint16 {
                range 1..65535 ;

              }

            }

            leaf tpid-matcher {
              description 'As a conditions TPID, used with tpid-mask.' ;
              type binary {
                length 62..128 ;

              }

            }

            leaf tpid-mask {
              description "Mask bit of attribute 'tpid-matcher'. Length is always 8 bytes." ;
              type binary {
                length 8..16 ;

              }

            }

            leaf perfcode {
              description 'The specified performance code. 0xFFFF for all.' ;
              type uint16 {
                range 1..65535 ;

              }

            }

            leaf tpid-class {
              description 'The class of TPID.' ;
              type enumeration {
                enum board {
                  value 1 ;
                }

                enum CPU {
                  value 2 ;
                }

                enum system {
                  value 3 ;
                }

                enum all {
                  value 255 ;
                }

              }

            }

            leaf tpid-length {
              description 'The length of TPID.' ;
              type uint8 {
                range 62..128 ;

              }

            }

          }

        }

      }

      container monitor {
        description 'The real-time performance monitoring task operation.' ;
        container start-up {
          description 'Start (i.e., create or generate) real-time performance monitoring tasks.' ;
          list task {
            description 'Real-time monitor task.' ;
            key taskid ;
            leaf taskid {
              description 'Monitor task ID.' ;
              type uint32 ;

            }

            leaf cycle {
              description 'Sampling period.' ;
              type uint16 {
                range 5..900 ;

              }

              units second ;
              default 30 ;
            }

            leaf total-time {
              description 'Total duration of monitoring tasks. When filling 0xFFFFFFFF that the total duration of uncertainty triggered by the user manually stopped.' ;
              type uint32 ;

              units second ;
            }

            leaf auto-report {
              description 'Whether to automatically reported. Only support false.' ;
              type boolean ;

              default false ;
            }

            container checkpoints {
              description 'Performance Item List.' ;
              list checkpoint {
                description 'The performance code of this tpid.' ;
                min-elements 1 ;
                key 'type tpid perfcode' ;
                leaf type {
                  description 'TPID type.' ;
                  type uint16 ;

                }

                leaf tpid {
                  description 'The TPID specified.' ;
                  type binary {
                    length 62..128 ;

                  }

                }

                leaf perfcode {
                  description 'Performance item code.' ;
                  type uint16 {
                    range 1..65535 ;

                  }

                }

                leaf tpid-length {
                  description 'The length of TPID.' ;
                  type uint8 {
                    range 62..128 ;

                  }

                }

              }

            }

          }

        }

        container stop {
          description 'Stop (i.e., delete or cancel) real-time performance monitoring tasks.' ;
          list task {
            description 'Real-time monitor tasks.' ;
            key taskid ;
            leaf taskid {
              description 'Monitor task ID. 0xFFFFFFFF indicates that stop all monitor task.' ;
              type uint32 ;

            }

          }

        }

      }

    }

  }

}
