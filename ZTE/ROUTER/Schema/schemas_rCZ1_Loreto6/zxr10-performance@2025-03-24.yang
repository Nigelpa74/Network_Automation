      container threshold {
        description 'Performance threshold query.' ;
        container default-thresholds {
          description 'Info about default-thresholds.' ;
          list zxr10analog-default-threshold {
            description "(1) Selects:checkpoint-type+tpid+perfcode+tpid-length:

            1.1 Specify the slot number included in the tpid. Now, 'checkpoint-type' and 'perfcode' are 0xFF.

            1.2 Do not specify the conditions that get all. Now, 'checkpoint-type', 'tpid' and 'perfcode' are 0xFF.

            1.3 Specify the 'tpid' with the wild card 0xFF.



            (2) Selects:checkpoint-type+tpid+perfcode+tpid-length+tpid-mask:

            In this case, specify the 'tpid' with 'tpid-mask'." ;
            key 'checkpoint-type tpid perfcode tpid-length' ;
            leaf checkpoint-type {
              description 'TPID type. 0xFFFF indicates that the query all type of check-point.' ;
              type uint16 {
                range 1..65535 ;

              }

            }

            leaf tpid {
              description 'TPID value. Full 0xFF match all.' ;
              type binary {
                length 62..128 ;

              }

            }

            leaf perfcode {
              description 'The performance code of this TPID. 0xFFFF indicates any performance items.' ;
              type uint16 {
                range 1..65535 ;

              }

            }

            leaf tpid-length {
              description 'The length of TPID.' ;
              type uint8 {
                range 62..128 ;

              }

            }

            leaf tpid-mask {
              description "Mask bit of attribute 'tpid'. Length is always 8 to 16 bytes." ;
              type binary {
                length 8..16 ;

              }

              ncd:revise-date 2016-11-16 ;
            }

            leaf low {
              description 'Value for default low threshold.' ;
              type binary {
                length 10 ;

              }

            }

            leaf high {
              description 'Value for default high threshold.' ;
              type binary {
                length 10 ;

              }

            }

            leaf warnlow {
              description 'Value for default warn-low threshold.' ;
              type binary {
                length 10 ;

              }

            }

            leaf warnhigh {
              description 'Value for default warn-high threshold.' ;
              type binary {
                length 10 ;

              }

            }

            leaf curlow {
              description 'Value for current low threshold.' ;
              type binary {
                length 10 ;

              }

            }

            leaf curhigh {
              description 'Value for current high threshold.' ;
              type binary {
                length 10 ;

              }

            }

            leaf curwarnlow {
              description 'Value for current warn-low threshold.' ;
              type binary {
                length 10 ;

              }

            }

            leaf curwarnhigh {
              description 'Value for current warn-high threshold.' ;
              type binary {
                length 10 ;

              }

            }

            leaf minvalue {
              description 'The minimum detectable value. Not used.' ;
              type binary {
                length 10 ;

              }

            }

            leaf maxvalue {
              description 'The maximum detectable value. Not used.' ;
              type binary {
                length 10 ;

              }

            }

            ncd:revise-date 2015-12-28 ;
            ncd:select "checkpoint-type tpid perfcode tpid-length" ;
            ncd:select "checkpoint-type tpid perfcode tpid-length tpid-mask" ;
          }

