      container monitor {
        description 'The state info about real-time monitor.' ;
        container perfdata {
          description 'The collect data about real-time monitor.' ;
          list zxr10perfdatum {
            description 'The performance data of real-time monitor.' ;
            key 'taskid checkpoint-type tpid perfcode cycle-end-time tpid-length' ;
            leaf taskid {
              description 'Monitor task ID.' ;
              type uint32 ;

            }

            leaf checkpoint-type {
              description 'TPID type.' ;
              type uint16 {
                range 1..65535 ;

              }

            }

            leaf tpid {
              description 'TPID value.' ;
              type binary {
                length 62..128 ;

              }

            }

            leaf perfcode {
              description 'The performance code of this tpid.' ;
              type uint16 {
                range 1..65535 ;

              }

            }

            leaf cycle-end-time {
              description 'The end time of sampling period. UTC.' ;
              type ncd:datetime ;

            }

            leaf tpid-length {
              description 'The length of tpid.' ;
              type uint8 {
                range 62..128 ;

              }

            }

            leaf cycle {
              description 'Sampling period.' ;
              type uint16 {
                range 5..900 ;

              }

              units second ;
              default 30 ;
            }

            leaf value {
              description 'The performance value of this sampling period. Effective for digital item.' ;
              type binary {
                length 10 ;

              }

            }

            leaf max-value {
              description 'Tthe maximum value of this period. Effective for analog item.' ;
              type binary {
                length 10 ;

              }

            }

            leaf min-value {
              description 'Tthe minimum value of this period. Effective for analog item.' ;
              type binary {
                length 10 ;

              }

            }

            leaf avg-value {
              description 'Tthe average value of this period. Effective for analog item.' ;
              type binary {
                length 10 ;

              }

            }

            leaf isdoubt {
              description 'Performance value is doubtful? If the performance test cycle affect the calculation of the events occurred, they sign into doubt.' ;
              type boolean ;

            }

            leaf first-cycle {
              description 'Queries the first sample value.' ;
              type boolean ;

            }

            leaf begin-time {
              description 'Start time for query. UTC. End of the cycle time within the time period is selected.' ;
              type ncd:datetime ;

            }

            leaf end-time {
              description 'End time for query. UTC. End of the cycle time within the time period is selected.' ;
              type ncd:datetime ;

            }

            leaf perf-type {
              description 'Digital or analog.' ;
              type enumeration {
                enum digital {
                  value 1 ;
                }

                enum analog {
                  value 2 ;
                }

              }

            }

            ncd:revise-date 2015-12-28 ;
            ncd:select "taskid checkpoint-type tpid perfcode tpid-length first-cycle" ;
            ncd:select "taskid checkpoint-type tpid perfcode tpid-length begin-time end-time" ;
