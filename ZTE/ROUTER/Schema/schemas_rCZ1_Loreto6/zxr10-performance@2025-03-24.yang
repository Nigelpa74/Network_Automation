  revision 2013-12-31 {
    description "(1) Add 'configuration \ performance \ perf-masks \ perf-mask' leaf 'tpid-length'

    (2) Modify Type Range of 'configuration \ performance \ perf-masks \ perf-mask ' leaf 'tpid-matcher' to 'from 62 to 128'

    (3) Delete 'configuration \ performance \ perf-suppresses \ perf-suppress'  leaf 'cycle' type 'all'

    (4) Modify Type Range of 'configuration \ performance \ perf-thresholds \ perf-threshold' leaf 'tpid' to 'from 62 to 128'

    (5) Add 'configuration \ performance \ perf-thresholds \ perf-threshold' leaf 'tpid-length'" ;
  }

  revision 2013-10-15 {
    description "(1) Leaf node checkpoint-type, perfcode is limited to: 1-65535. (2) Real-time performance monitoring of the adoption cycle is limited to: 5-900. (3) Revise 'state\performance\monitor\perfdata\perfdatum\perf-type' definition as enumeration. (4) Add default value for 'operation\performance\monitor\start-up        ask\auto-report' as false." ;
  }

  revision 2013-09-30 {
    description "Current and historical performance modeling of an explicit distinction between 15 minutes and 24 hours queries. Involving state node structural changes. 'configuration \ performance \ default-threholds \ templateId' name changed to template-id." ;
  }

  revision 2013-09-24 {
    description 'Add perf-type for realtime query operation.' ;
  }

  revision 2013-08-22 {
    description 'The real-time performance monitoring tasks from the configuration command to action command.' ;
  }

  revision 2013-08-16 {
    description 'Real-time performance statistics add a query that indicates whether the value of the first sample query. Namely: state \ performance \ statistics \ monitor \ perfdata \ perfdatum \ selet \ first \ first-cycle.' ;
  }

  revision 2013-08-13 {
    description "(1) Remove the leaf node:

    'stateperformance hresholddefault-thresholdsanalog-default-threshold pid-matcher'.

    (2) The node ' state  performance  monitor  perfdata  perfdatum  cycle-end-time' type is changed to ncd: datatime.

    (3) In the following 'list' node, add a layer of 'container' node:

    - configurationperformancestatisticsperf-mask

    - configurationperformancestatisticsperf-suppress

    - configurationperformance hresholdperf-threshold

    - configurationperformance hresholddefault-threshold" ;
  }

  revision 2013-04-22 {
    description 'Initial version.' ;
  }

  feature flow-statistics ;

  feature self-defined-minutes {
    ncd:revise-date 2024-02-20 ;
  }

  container configuration {
    description 'Configuration model info.' ;
    container performance {
      description 'The configuration info about performance.' ;
      container statistics {
        description 'The configuration info about statistics.' ;
        container perf-masks {
          description 'The rules for performance mask.' ;
          list perf-mask {
            description 'The rules for performance mask.' ;
            key 'checkpoint-type tpid-matcher perfcode cycle tpid-mask tpid-class' ;
            leaf checkpoint-type {
              description 'The type of TPID. 0xFFFF for any type.' ;
              type uint16 {
                range 1..65535 ;

              }

            }

            leaf tpid-matcher {
              description "The matcher about TPID, the format is the same to TPID. It always to be used with 'tpid-mask', they can be indicated a group of TPID." ;
              type binary {
                length 62..128 ;

              }

            }

            leaf perfcode {
              description 'Performance code, one TPID may have serval performance codes. 0xFFFF for any code.' ;
              type uint16 {
                range 1..65535 ;

              }

            }

            leaf cycle {
              description 'The performance cycle. 15(5) minutes, 24 hours or all.' ;
              type enumeration {
                enum fifteen-minutes {
                  value 1 ;
                  description 'Minute cycle. The actual cycle value depends on the minute-cycle configuration.' ;
                }

                enum twenty-four-hours {
                  value 2 ;
                }

                enum all {
                  value 3 ;
                }

              }

            }

            leaf tpid-mask {
              description "The mask about tpid-matcher, it indicates which position of 'tpid-matcher' is available." ;
              type binary {
                length 8..16 ;

              }

            }

            leaf tpid-length {
              description 'The length of TPID.' ;
              type uint8 {
                range 62..128 ;

              }

            }

            leaf tpid-class {
              description 'The class of TPID.' ;
              type enumeration {
                enum board {
                  value 1 ;
                }

                enum CPU {
                  value 2 ;
                }

                enum system {
                  value 3 ;
                }

                enum all {
                  value 255 ;
                }

              }

            }

          }

        }

        container perf-suppresses {
          description 'The function about performance suppress.' ;
          list perf-suppress {
            description 'The function about performance suppress.' ;
            key 'checkpoint-type tpid cycle' ;
            leaf checkpoint-type {
              description 'The type of TPID. Only for any TPID type. The value is always 0xFFFF.' ;
              type uint16 {
                range 1..65535 ;

              }

            }

            leaf tpid {
              description "Check point id, only every positon's value is 0xFF can be accepted." ;
              type binary {
                length 62..128 ;

              }

            }

            leaf cycle {
              description 'Statistics cycle.' ;
              type enumeration {
                enum cur15minutes {
                  value 1 ;
                  description 'Current minute cycle. The actual cycle value depends on the minute-cycle configuration.' ;
                }

                enum his15minutes {
                  value 2 ;
                  description 'History minute cycle. The actual cycle value depends on the minute-cycle configuration.' ;
                }

                enum cur24hours {
                  value 3 ;
                }

                enum his24hours {
                  value 4 ;
                }

              }

            }

            leaf tpid-length {
              description 'The length of TPID.' ;
              type uint8 {
                range 62..128 ;

              }

            }

            leaf state {
              description 'Performance suppress state.' ;
              type enumeration {
                enum suppress {
                  value 1 ;
                }

                enum unsuppress {
                  value 2 ;
                }

              }

            }

          }

        }

        container minute-cycle {
          description 'The performance cycle at minute level.' ;
          presence minute-cycle ;
          leaf minute-cycle {
            description 'The performance cycle at minute level. 15 minutes or 5 minutes.' ;
