module zxr10-isakmp {
  namespace "http://www.zte.com.cn/zxr10/netconf/schema/rosng/isakmp" ;
  prefix isakmp ;
  yang-version 1 ;
  import zxr10-netconf-defs {
    prefix ncd ;
  }

  organization "ZTE Corporation" ;
  contact "ZTE Corporation  
     Nanjing Institute of ZTE Corporation 
     No.68 Zijinghua Rd. Yuhuatai District, Nanjing, China 
     Tel: +86-25-52870000" ;
  revision 2023-07-05 {
    description 'Add send-certification-authority leaf' ;
  }
  
  revision 2023-05-24 {
    description 'Add “suffix” in sync-fixedkey of keyid-isakmp-key list
Add “suffix” in sync-fixedkey of keyid-isakmp-vrf-key list
Add keyid-isakmp-key-suffixs container
Add keyid-isakmp-vrf-key-suffixs container
Add identity-user-suffixs container
Add “suffix” in sync-fixedkey of identity-keyid list
Add “suffix” in sync-fixedkey of identity-keyid container' ;
  }

  revision 2023-03-23 {
    description 'ADD NETCONF SHOW ISAKMP SA.' ;
  }

  revision 2023-01-20 {
    description 'Add clear-isakmp-sa for rpc.' ;
  }

  revision 2022-12-29 {
    description 'Add pki-common-name of self-identity and user-gorup identity' ;
  }

  revision 2022-11-24 {
    description 'Add ikev2 authentication sig-hash' ;
  }

  revision 2022-01-11 {
    description 'Support ikev2 cookie challenge' ;
  }

  revision 2021-07-28 {
    description 'The maximum number of users in the user group is replaced by performance parameters.' ;
  }

  revision 2021-04-06 {
    description 'Support DPD global configuration.' ;
  }

  revision 2021-02-25 {
    description 'add dh-group 20
add dh-group 21' ;
  }

  revision 2021-01-29 {
    description 'Userfqdn supports suffix matching.' ;
  }

  revision 2021-01-05 {
    description 'add dh-group 14
add dh-group 19' ;
  }

  revision 2020-07-07 {
    description '1)Modified /configuration/isakmp/isakmp-key/ipv4-isakmp-keys/ipv4-isakmp-key/key/key/clear-key/clear-key
