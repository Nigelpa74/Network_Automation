42)Modified /configuration/isakmp/isakmp-key-sets/isakmp-key-set/keyid-isakmp-vrf-keys/keyid-isakmp-vrf-key/key/key/encrypted-key/encrypted-key
43)Modified /configuration/isakmp/isakmp-profiles/isakmp-profile/default-key/default-key/clear-key/clear-key
44)Modified /configuration/isakmp/isakmp-profiles/isakmp-profile/default-key/default-key/encrypted-key/encrypted-key' ;
  }

  revision 2018-01-15 {
    description 'Remove feature ipv6-isakmp-local-keys for container:/configuration/isakmp/isakmp-key/ipv6-isakmp-local-keys;
Remove feature ipv6-isakmp-local-keys for container:/configuration/isakmp/isakmp-key/ipv6-isakmp-vrf-local-keys;' ;
  }

  revision 2017-06-20 {
    description 'Add sha256,sha384,sha512 for Container:/configuration/isakmp/isakmp-policys/isakmp-policy/prf.
Add sha256,sha384,sha512 for HASH.' ;
  }

  revision 2017-01-13 {
    description 'Isakmp support MCG-5000' ;
  }

  revision 2017-01-12 {
    description 'Supprt match identity pki-common-name
add Container:/configuration/isakmp/isakmp-profiles/isakmp-profile/match-identity/pki-common-name-match-identitys,
add YangList:/configuration/isakmp/isakmp-profiles/isakmp-profile/match-identity/pki-common-name-match-identity,
add Leaf:/configuration/isakmp/isakmp-profiles/isakmp-profile/match-identity/pki-common-name.' ;
  }

  revision 2017-01-09 {
    description '1)Modified zxr10-isakmp/configuration/isakmp/global-configuration/isakmp-enable leaf. Add default value disable(0).
2)Modified zxr10-isakmp/configuration/isakmp/isakmp-policys/isakmp-policy/authentication leaf. Add default value pre-share(0).
3)Modified zxr10-isakmp/configuration/isakmp/isakmp-policys/isakmp-policy/group leaf. Add default value group1(0).
4)Modified zxr10-isakmp/configuration/isakmp/isakmp-policys/isakmp-policy/hash leaf. Add default value sha1(1).
5)Modified zxr10-isakmp/configuration/isakmp/isakmp-policys/isakmp-policy/encryption leaf. Add default value 3des(4).
6)Modified zxr10-isakmp/configuration/isakmp/isakmp-policys/isakmp-policy/lifetime leaf. Add default value 86400.
7)Modified zxr10-isakmp/configuration/isakmp/isakmp-policys/isakmp-policy/prf leaf. Changed type from derivedType HASH to baseType enumeration, and add enum md5(0) and sha1(1), and add default value sha1(1).
8)Modified zxr10-isakmp/configuration/isakmp/user-groups/user-group/user-names/user-name/user-password choice. Changed mandatory value from false to true.
9)Modified zxr10-isakmp/configuration/isakmp/isakmp-profiles/isakmp-profile/ikev2-authentication leaf. Change type from derivedType AUTHMODE to baseType enumeration, and add enum pre-share(0) and rsa-sig(1), and add default value pre-share(0).' ;
  }

  revision 2016-07-12 {
    description 'Initial version' ;
  }

  feature ipv6-isakmp-local-keys {
    description 'The feature of IPv6 ISAKMP local keys' ;
  }

  typedef AUTHMODE {
    description 'Authentication mode enumeration' ;
    type enumeration {
      enum pre-share {
        value 0 ;
        description 'Pre-Shared key' ;
      }

      enum rsa-sig {
        value 1 ;
        description 'RSA signature' ;
      }

      enum digi-envelope {
        value 2 ;
        description 'Digital envelope' ;
      }

    }

  }

  typedef ENCRYPTION {
    description 'ISAKMP encryption algorithm' ;
    type enumeration {
      enum aes-128 {
        value 0 ;
        description 'AES - Advanced Encryption Standard(128 bit keys)' ;
      }

      enum aes-192 {
        value 1 ;
        description 'AES - Advanced Encryption Standard(192 bit keys)' ;
      }

      enum aes-256 {
        value 2 ;
        description 'AES - Advanced Encryption Standard(256 bit keys)' ;
      }

      enum des {
        value 3 ;
        description 'DES - Data Encryption Standard (56 bit keys)' ;
      }

      enum 3des {
        value 4 ;
        description 'Three key triple DES' ;
      }

      enum sm4 {
        value 5 ;
        description 'SM4 cryptographic algorithm(128 bit keys)' ;
      }

      enum sm1 {
        value 6 ;
        description 'SM1 - cryptographic algorithm(128 bit keys)' ;
      }

    }

  }

  typedef DHGROUP {
    description 'Diffie-Hellman group' ;
    type enumeration {
      enum group1 {
        value 0 ;
        description 'Diffie-Hellman group 1' ;
      }

      enum group2 {
        value 1 ;
        description 'Diffie-Hellman group 2' ;
      }

      enum group5 {
        value 2 ;
        description 'Diffie-Hellman group 5' ;
      }

      enum group14 {
        value 3 ;
        description 'Diffie-Hellman group 14' ;
      }

      enum group19 {
        value 6 ;
        description 'ECP group 19' ;
      }

      enum group20 {
        value 7 ;
        description 'ECP group 20' ;
      }

      enum group21 {
        value 8 ;
        description 'ECP group 21' ;
      }

    }

  }

  typedef HASH {
    description 'Hash-algorithm' ;
    type enumeration {
      enum md5 {
        value 0 ;
        description 'Message Digest 5' ;
      }

      enum sha1 {
        value 1 ;
        description 'Secure Hash Standard' ;
      }

      enum sm3 {
        value 2 ;
        description 'SM3 algorithm' ;
      }

      enum sha256 {
        value 3 ;
        description 'Secure Hash Standard 256' ;
      }

      enum sha384 {
        value 4 ;
        description 'Secure Hash Standard 384' ;
      }

      enum sha512 {
        value 5 ;
        description 'Secure Hash Standard 512' ;
      }

    }

  }

  typedef EAPTYPE {
    description 'EAP type' ;
    type enumeration {
      enum md5 {
        value 4 ;
        description 'EAP-MD5' ;
      }

      enum mschapv2 {
        value 26 ;
        description 'EAP-MSCHAPV2' ;
      }

      enum none {
        value 0 ;
      }

    }

  }

  typedef ENABLE-FLAG {
    type enumeration {
      enum enable {
        value 1 ;
      }

      enum disable {
        value 0 ;
      }

    }

  }

  typedef EXCHANGEMODE {
    description 'Exchange mode' ;
    type enumeration {
      enum main {
        value 2 ;
        description 'Main exchange-mode' ;
      }

      enum aggressive {
        value 4 ;
        description 'Aggressive exchange-mode' ;
      }

    }

  }

  typedef IKEVERSION {
    description 'IKE version' ;
    type enumeration {
      enum ikev1 {
        value 1 ;
        description 'IKE version 1.0' ;
      }

      enum ikev2 {
        value 2 ;
        description 'IKE version 2.0' ;
      }

    }

  }

  container configuration {
    description 'Configuration' ;
    container isakmp {
      description 'ISAKMP configuration' ;
      container global-configuration {
        description 'ISAKMP global configuration' ;
        leaf isakmp-enable {
          description 'Set IKE enable flag' ;
          type ENABLE-FLAG ;

          default disable ;
        }

        leaf ikev2-cookie-challenge-enable {
          description 'Set IKEv2 cookie challenge enable flag' ;
          type ENABLE-FLAG ;

          default disable ;
          ncd:revise-date 2022-01-11 ;
        }

      }

      container isakmp-policys {
        description 'Set ISAKMP policy' ;
        list isakmp-policy {
          description 'Set ISAKMP policy' ;
          key priority ;
          leaf priority {
            description 'Set ISAKMP policy priority' ;
            type uint16 {
              range 1..10000 ;

            }

          }

          leaf authentication {
            description 'Set authentication method for protection suite' ;
            type AUTHMODE ;

            default pre-share ;
          }

          leaf group {
            description 'Set the Diffie-Hellman group' ;
            type DHGROUP ;

            default group1 ;
          }

          leaf hash {
            description 'Set hash algorithm for protection suite' ;
            type HASH ;

            default sha1 ;
          }

          leaf encryption {
            description 'Set encryption algorithm for protection suite' ;
            type ENCRYPTION ;

            default 3des ;
          }

          leaf lifetime {
            description 'Set lifetime for ISAKMP security association' ;
            type uint32 {
              range 60..86400 ;

            }

            default 86400 ;
          }

          leaf prf {
            description 'Set PRF algorithm for protection suite' ;
            type enumeration {
              enum md5 {
                value 0 ;
                description 'Message Digest 5' ;
              }

              enum sha1 {
                value 1 ;
                description 'Secure Hash Standard' ;
              }

              enum sha256 {
                value 3 ;
                description 'Secure Hash Standard 256' ;
              }

              enum sha384 {
                value 4 ;
                description 'Secure Hash Standard 384' ;
              }

              enum sha512 {
                value 5 ;
                description 'Secure Hash Standard 512' ;
              }

            }

            default sha1 ;
          }

        }

      }

      container isakmp-key {
        description 'Set ISAKMP pre-share keys' ;
        container ipv4-isakmp-keys {
          description 'Set IPv4 pre-share keys' ;
          list ipv4-isakmp-key {
            description 'Set IPv4 pre-share key' ;
            key 'ipv4-address ipv4-netmask' ;
            leaf ipv4-address {
              description 'Set IPv4 address' ;
              type ncd:ipv4-address-none-zero ;

            }

            leaf ipv4-netmask {
              description 'Set IPv4 mask' ;
              type ncd:ipv4-mask ;

            }

            container key {
              description 'Set pre-share keys' ;
              presence key ;
              choice key {
                description 'Set pre-share keys' ;
                case clear-key {
                  description 'Set clear key' ;
                  leaf clear-key {
                    description 'Set clear key' ;
                    type string {
                      length 1..128 ;

                    }

                  }

                }

                case encrypted-key {
                  description 'Set encrypted key' ;
                  leaf encrypted-key {
                    description 'Set encrypted key' ;
                    type string {
                      length 1..236 ;

                    }

                  }

                }

              }

            }

          }

        }

        container ipv4-isakmp-local-keys {
          description 'Set IPv4 pre-share keys with local address' ;
          list ipv4-isakmp-local-key {
            description 'Set IPv4 pre-share key with local address' ;
            key 'ipv4-address ipv4-netmask ipv4-local-address' ;
            leaf ipv4-address {
              description 'Set IPv4 address' ;
              type ncd:ipv4-address-none-zero ;

            }

            leaf ipv4-netmask {
              description 'Set IPv4 mask' ;
              type ncd:ipv4-mask ;

            }

            leaf ipv4-local-address {
              description 'Set IPv4 local address' ;
              type ncd:ipv4-address-none-zero ;

            }

            container key {
              description 'Set pre-share keys' ;
              presence key ;
              choice key {
                description 'Set pre-share keys' ;
                case clear-key {
                  description 'Set clear key' ;
                  leaf clear-key {
                    description 'Set clear key' ;
                    type string {
                      length 1..128 ;

                    }

                  }

                }

                case encrypted-key {
                  description 'Set encrypted key' ;
                  leaf encrypted-key {
                    description 'Set encrypted key' ;
                    type string {
                      length 1..236 ;

                    }

                  }

                }

              }

            }

          }

        }

        container ipv4-isakmp-vrf-keys {
          description 'Set IPv4 pre-share keys with VRF' ;
          list ipv4-isakmp-vrf-key {
            description 'Set IPv4 pre-share keys with VRF' ;
            key 'ipv4-address ipv4-netmask ipv4-vrfname' ;
            leaf ipv4-address {
              description 'Set IPv4 address' ;
              type ncd:ipv4-address-none-zero ;

            }

            leaf ipv4-netmask {
              description 'Set IPv4 mask' ;
              type ncd:ipv4-mask ;

            }

            leaf ipv4-vrfname {
              description 'Set VRF name' ;
              type string {
                length 1..32 ;

              }

            }

            container key {
              description 'Set pre-share keys' ;
              presence key ;
              choice key {
                description 'Set pre-share keys' ;
                case clear-key {
                  description 'Set clear key' ;
                  leaf clear-key {
                    description 'Set clear key' ;
                    type string {
                      length 1..128 ;

                    }

                  }

                }

                case encrypted-key {
                  description 'Set encrypted key' ;
                  leaf encrypted-key {
                    description 'Set encrypted key' ;
                    type string {
                      length 1..236 ;

                    }

                  }

                }

              }

            }

          }

        }

        container ipv4-isakmp-vrf-local-keys {
          description 'Set IPv4 pre-share keys with VRF and local address' ;
          list ipv4-isakmp-vrf-local-key {
            description 'Set IPv4 pre-share key with VRF and local address' ;
            key 'ipv4-address ipv4-netmask ipv4-local-address ipv4-vrfname' ;
            leaf ipv4-address {
              description 'Set IPv4 address' ;
              type ncd:ipv4-address-none-zero ;

            }

            leaf ipv4-netmask {
              description 'Set IPv4 mask' ;
              type ncd:ipv4-mask ;

            }

            leaf ipv4-local-address {
              description 'Set IPv4 local address' ;
              type ncd:ipv4-address-none-zero ;

            }

            leaf ipv4-vrfname {
              description 'Set VRF name' ;
              type string {
                length 1..32 ;

              }

            }

            container key {
              description 'Set pre-share keys' ;
              presence key ;
              choice key {
                description 'Set pre-share key' ;
                case clear-key {
                  description 'Set clear key' ;
                  leaf clear-key {
                    description 'Set clear key' ;
                    type string {
                      length 1..128 ;

                    }

                  }

                }

                case encrypted-key {
                  description 'Set encrypted key' ;
                  leaf encrypted-key {
                    description 'Set encrypted key' ;
                    type string {
                      length 1..236 ;

                    }

                  }

                }

              }

            }

          }

        }

        container ipv6-isakmp-keys {
          description 'Set IPv6 pre-share keys' ;
          list ipv6-isakmp-key {
            description 'Set IPv6 pre-share key' ;
            key 'ipv6-address ipv6-netmask' ;
            leaf ipv6-address {
              description 'Set IPv6 address' ;
              type ncd:ipv6-address ;

            }

            leaf ipv6-netmask {
              description 'Set IPv6 mask' ;
              type ncd:ipv6-mask-length {
                range 1..128 ;

              }

            }

            container key {
              description 'Set pre-share keys' ;
              presence key ;
              choice key {
                description 'Set pre-share key' ;
                case clear-key {
                  description 'set clear key' ;
                  leaf clear-key {
                    description 'set clear key' ;
                    type string {
                      length 1..128 ;

                    }

                  }

                }

                case encrypted-key {
                  description 'Set encrypted key' ;
                  leaf encrypted-key {
                    description 'Set encrypted key' ;
                    type string {
                      length 1..236 ;

                    }

                  }

                }

              }

            }

          }

        }

        container ipv6-isakmp-local-keys {
          description 'Set IPv6 pre-share keys with local address' ;
          list ipv6-isakmp-local-key {
            description 'Set IPv6 pre-share key with local address' ;
            key 'ipv6-address ipv6-netmask ipv6-local-address' ;
            leaf ipv6-address {
              description 'Set IPv6 address' ;
              type ncd:ipv6-address ;

            }

            leaf ipv6-netmask {
              description 'Set IPv6 mask' ;
              type ncd:ipv6-mask-length {
                range 1..128 ;

              }

            }

            leaf ipv6-local-address {
              description 'Set IPv6 local address' ;
              type ncd:ipv6-address ;

            }

            container key {
              description 'Set pre-share keys' ;
              presence key ;
              choice key {
                description 'Set pre-share key' ;
                case clear-key {
