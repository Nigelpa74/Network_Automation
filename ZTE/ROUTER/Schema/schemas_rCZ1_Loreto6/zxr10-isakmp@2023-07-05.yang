                    description 'Set encrypted key' ;
                    leaf encrypted-key {
                      description 'Set encrypted key' ;
                      type string {
                        length 1..236 ;

                      }

                    }

                  }

                }

              }

            }

            ncd:revise-date 2023-05-24 ;
          }

        }

      }

      container isakmp-profiles {
        description 'Set ISAKMP profiles' ;
        list isakmp-profile {
          description 'Set ISAKMP profile' ;
          key profile ;
          leaf profile {
            description 'Set ISAKMP profile tag' ;
            type string {
              length 1..18 ;

            }

          }

          leaf description {
            description 'Set description of profile' ;
            type string {
              length 1..64 ;

            }

          }

          leaf exchange-mode {
            description 'Set the exchange-mode for the profile' ;
            type EXCHANGEMODE ;

            default main ;
          }

          leaf ikev2-authentication {
            description 'Set IKEv2 authentication method for protection suite' ;
            type enumeration {
              enum pre-share {
                value 0 ;
                description 'Pre-Shared key' ;
              }

              enum rsa-sig {
                value 1 ;
                description 'RSA signature' ;
              }

            }

            default pre-share ;
          }

          leaf initiator {
            description 'Set initiator IKE version' ;
            type IKEVERSION ;

            default ikev1 ;
          }

          container nat-transparency {
            description 'Set ISAKMP NAT-Traversal' ;
            presence nat-transparency ;
            leaf keepalive {
              description 'Set ISAKMP NAT-Traversal keepalive' ;
              type uint32 {
                range 5..3600 ;

              }

              default 20 ;
            }

            leaf udp-encapsulation {
              description 'Set ISAKMP NAT-Traversal UDP encapsulation' ;
              type uint8 {
                range 0..1 ;

              }

              default 0 ;
            }

          }

          container policys {
            description 'Set policy for the profile' ;
            list policy {
              description 'Set policy for the profile' ;
              key priority ;
              leaf priority {
                description 'Set priority of protection suite' ;
                type uint16 {
                  range 1..10000 ;

                }

              }

            }

          }

          container key-sets {
            description 'Set key-set for the profile' ;
            list key-set {
              description 'Set key-set for the profile' ;
              key name ;
              leaf name {
                description 'Set key-set name' ;
                type string {
                  length 1..32 ;

                }

              }

            }

          }

          container keepalive {
            description 'Set dead peer detection interval of peer' ;
            presence keepalive ;
            leaf dpd-interval {
              description 'Set number of seconds that peer is allowed to idle' ;
              type uint32 {
                range 10..3600 ;

              }

              mandatory true ;
            }

            leaf retry {
              description 'Set number of seconds that keepalive response timeout' ;
              type uint32 {
                range 2..60 ;

              }

            }

          }

          container match-identity {
            description 'Set match peer identity for the profile' ;
            container ipv6-match-identitys {
              description 'Set identity with IPv6 address' ;
              list ipv6-match-identity {
                description 'Set identity with IPv6 address' ;
                key ipv6-address ;
                leaf ipv6-address {
                  description 'Set peer IPv6 address' ;
                  type ncd:ipv6-address ;

                }

              }

            }

            container fqdn-match-identitys {
              description 'Set identity with hostname or domain name' ;
              list fqdn-match-identity {
                description 'Set identity with hostname or domain name' ;
                key fqdn ;
                leaf fqdn {
                  description 'Set hostname or domain name of peer' ;
                  type string {
                    length 1..64 ;

                  }

                }

              }

            }

            container ipv4-match-identitys {
              description 'Set identity with IPv4 address' ;
              list ipv4-match-identity {
                description 'Set identity with IPv4 address' ;
                key ipv4-address ;
                leaf ipv4-address {
                  description 'Set peer IPv4 address' ;
                  type ncd:ipv4-address-none-zero ;

                }

              }

            }

            container pki-common-name-match-identitys {
              description 'Define identity with ASN1-DN' ;
              list pki-common-name-match-identity {
                description 'Define identity with ASN1-DN' ;
                key pki-common-name ;
                leaf pki-common-name {
                  description 'ASN.1 X.500 distinguished name' ;
                  type string {
                    length 1..64 ;

                  }

                }

              }

              ncd:revise-date 2017-01-12 ;
            }

          }

          leaf match-any-identity {
            description 'Set allowing all peer identities to pass' ;
            type ENABLE-FLAG ;

            default disable ;
          }

          container self-identity {
            description 'Set self-identity type for the profile' ;
            presence self-identity ;
            choice self-identity {
              description 'Set self-identity type for the profile' ;
              default address ;
              case fqdn {
                description 'Use specified name as fqdn identity' ;
                leaf name {
                  description 'Set hostname or domain name' ;
                  type string {
                    length 1..64 ;

                  }

                  mandatory true ;
                }

                leaf fqdn {
                  description 'Use specified name as fqdn identity' ;
                  type enumeration {
                    enum fqdn {
                      value 3 ;
                    }

                  }

                  mandatory true ;
                }

              }

              case address {
                description 'Use the IP address of the interface' ;
                leaf address {
                  description 'Use the IP address of the interface' ;
                  type enumeration {
                    enum address {
                      value 1 ;
                    }

                  }

                }

              }

              case hostname {
                description 'Use the hostname of the router as fqdn identity' ;
                leaf hostname {
                  description 'Use the hostname of the router as fqdn identity' ;
                  type enumeration {
                    enum hostname {
                      value 2 ;
                    }

                  }

                  mandatory true ;
                }

              }

              case pki-commom-name {
                description 'Use the ASN.1 X.500 distinguished name' ;
                leaf pki-common-name {
                  description 'Use the ASN.1 X.500 distinguished name' ;
                  type enumeration {
                    enum pki-common-name {
                      value 9 ;
                    }

                  }

                  mandatory true ;
                }

                ncd:revise-date 2022-12-29 ;
              }

            }

          }

          container default-key {
            description 'Set default pre-share key' ;
            presence default-key ;
            choice default-key {
              description 'Set default pre-share key' ;
              case clear-key {
                description 'Set plaintext key' ;
                leaf clear-key {
                  description 'Set plaintext key' ;
                  type string {
                    length 1..128 ;

                  }

                }

              }

              case encrypted-key {
                description 'Set encrypted key' ;
                leaf encrypted-key {
                  description 'Set encrypted key' ;
                  type string {
                    length 1..236 ;

                  }

                }

              }

            }

          }

          container ikev2-authentication-sig-hash {
            description 'Set IKEv2 authentication method and signature hash algorithm' ;
            list sig-hash {
              description 'Set hash algorithm for signature' ;
              key hash ;
              leaf hash {
                description 'Set hash algorithm for signature' ;
                type enumeration {
                  enum sha256 {
                    value 2 ;
                    description 'Secure Hash Standard 256' ;
                  }

                  enum sha384 {
                    value 3 ;
                    description 'Secure Hash Standard 384' ;
                  }

                  enum sha512 {
                    value 4 ;
                    description 'Secure Hash Standard 512' ;
                  }

                }

              }

            }
	    
	    ncd:revise-date 2022-11-24 ;
          }

          leaf send-certification-authority {
            type ENABLE-FLAG ;

            default disable ;
            description 'Send certification authority in certificate request payload' ;
            ncd:revise-date 2023-07-05 ;
          }

        }

      }

      container isakmp-pools {
        description 'Set ISAKMP pools' ;
        list isakmp-pool {
          description 'Set ISAKMP pool' ;
          key ipsec-pool-name ;
          leaf ipsec-pool-name {
            description 'Set pool name' ;
            type string {
              length 1..32 ;

            }

          }

          leaf ip-pool {
            description 'Set ip pool' ;
            type string ;

          }

          container dns-ip {
            description 'Set DNS server IP' ;
            presence dns-ip ;
            leaf dns-server-ip {
              description 'Set first DNS server IP address' ;
              type ncd:ipv4-address ;

              mandatory true ;
            }

            leaf dns-2nd-ip {
              description 'Set second DNS server IP' ;
              type ncd:ipv4-address ;

            }

          }

          container wins-ip {
            description 'Set WINDOWS server IP' ;
            presence wins-ip ;
            leaf wins-server-ip {
              description 'Set first WINDOWS server IP' ;
              type ncd:ipv4-address ;

              mandatory true ;
            }

            leaf wins-2nd-ip {
              description 'Set wins second ip' ;
              type ncd:ipv4-address ;

            }

          }

        }

      }

      container global-keepalive {
        description 'Set dead peer detection interval of peer.' ;
        presence keepalive ;
        leaf dpd-interval {
          description 'Set number of seconds that peer is allowed to idle' ;
          type uint16 {
            range 10..3600 ;

          }

          mandatory true ;
        }

        leaf retry {
          description 'Set number of seconds that keepalive response timeout' ;
          type uint8 {
            range 2..60 ;

          }

          mandatory true ;
        }

        ncd:revise-date 2021-04-06 ;
      }

      container peer-keepalive {
        description 'Configure global DPD lifetime and retransmission cycle according to the peer address.' ;
        container ipv4-isakmp-dpds {
          list ipv4-isakmp-dpd {
            key 'ipv4-address ipv4-netmask' ;
            leaf ipv4-address {
              description 'Set IPv4 address' ;
              type ncd:ipv4-address-none-zero ;

            }

            leaf ipv4-netmask {
              description 'Set IPv4 mask' ;
              type ncd:ipv4-mask ;

            }

            container keep-alive {
              leaf dpd-interval {
                description 'Set number of seconds that peer is allowed to idle' ;
                type uint16 {
                  range 10..3600 ;

                }

                mandatory true ;
              }

              leaf retry {
                description 'Set number of seconds that keepalive response timeout' ;
                type uint8 {
                  range 2..60 ;

                }

                mandatory true ;
              }

            }

          }

        }

        container ipv4-isakmp-vrf-dpds {
          list ipv4-isakmp-vrf-dpd {
            key 'ipv4-address ipv4-netmask ipv4-vrfname' ;
            leaf ipv4-address {
              description 'Set IPv4 address' ;
              type ncd:ipv4-address-none-zero ;

            }

            leaf ipv4-netmask {
              description 'Set IPv4 mask' ;
              type ncd:ipv4-mask ;

            }

            leaf ipv4-vrfname {
              description 'Set VRF name' ;
              type string {
                length 1..32 ;

              }

            }

            container keep-alive {
              leaf dpd-interval {
                description 'Set number of seconds that peer is allowed to idle' ;
                type uint16 {
                  range 10..3600 ;

                }

                mandatory true ;
              }

              leaf retry {
                description 'Set number of seconds that keepalive response timeout' ;
                type uint8 {
                  range 2..60 ;

                }

                mandatory true ;
              }

            }

          }

        }

        container ipv6-isakmp-dpds {
          list ipv6-isakmp-dpd {
            key 'ipv6-address ipv6-netmask' ;
            leaf ipv6-address {
              description 'Set IPv6 address' ;
              type ncd:ipv6-address ;

            }

            leaf ipv6-netmask {
              description 'Set IPv6 mask' ;
              type ncd:ipv6-mask-length ;

            }

            container keep-alive {
              leaf dpd-interval {
                description 'Set number of seconds that peer is allowed to idle' ;
                type uint16 {
                  range 10..3600 ;

                }

                mandatory true ;
              }

              leaf retry {
                description 'Set number of seconds that keepalive response timeout' ;
                type uint8 {
                  range 2..60 ;

                }

                mandatory true ;
              }

            }

          }

        }

        container ipv6-isakmp-vrf-dpds {
          list ipv6-isakmp-vrf-dpd {
            key 'ipv6-address ipv6-netmask ipv6-vrfname' ;
            leaf ipv6-address {
              description 'Set IPv6 address' ;
              type ncd:ipv6-address ;

            }

            leaf ipv6-netmask {
              description 'Set IPv6 mask' ;
              type ncd:ipv6-mask-length ;

            }

            leaf ipv6-vrfname {
              description 'Set VRF name' ;
              type string {
                length 1..32 ;

              }

            }

            container keep-alive {
              leaf dpd-interval {
                description 'Set number of seconds that peer is allowed to idle' ;
                type uint16 {
                  range 10..3600 ;

                }

                mandatory true ;
              }

              leaf retry {
                description 'Set number of seconds that keepalive response timeout' ;
                type uint8 {
                  range 2..60 ;

                }

                mandatory true ;
              }

            }

          }

        }

        container fqdn-isakmp-dpds {
          list fqdn-isakmp-dpd {
            key fqdn ;
            leaf fqdn {
              description 'Set FQDN name' ;
              type string {
                length 1..64 ;

              }

            }

            container keep-alive {
              leaf dpd-interval {
                description 'Set number of seconds that peer is allowed to idle' ;
                type uint16 {
                  range 10..3600 ;

                }

                mandatory true ;
              }

              leaf retry {
                description 'Set number of seconds that keepalive response timeout' ;
                type uint8 {
                  range 2..60 ;

                }

                mandatory true ;
              }

            }

          }

        }

        container fqdn-isakmp-vrf-dpds {
          list fqdn-isakmp-vrf-dpd {
            key 'fqdn fqdn-vrf' ;
            leaf fqdn {
              description 'Set FQDN name' ;
              type string {
                length 1..64 ;

              }

            }

            leaf fqdn-vrf {
              description 'Set VRF name' ;
              type string {
                length 1..32 ;

              }

            }

            container keep-alive {
              leaf dpd-interval {
                description 'Set number of seconds that peer is allowed to idle' ;
                type uint16 {
                  range 10..3600 ;

                }

                mandatory true ;
              }

              leaf retry {
                description 'Set number of seconds that keepalive response timeout' ;
                type uint8 {
                  range 2..60 ;

                }

                mandatory true ;
              }

            }

          }

        }

        ncd:revise-date 2021-04-06 ;
      }

    }

  }

  rpc clear-isakmp-sa {
    description 'Clear ISAKMP SA.' ;
    input {
      container clear-para {
        config false ;
        description 'Clear parameter of ISAKMP SA.' ;
        leaf force {
          description 'Clear ISAKMP SAs in force mode.' ;
          type empty ;

        }

        container peer-para {
          description 'Specify the peer information to clear ISAKMP SA.' ;
          presence "Specify the peer information" ;
          leaf vrf-name {
            description 'VRF name.' ;
            type string {
              length 1..32 ;

            }

          }

          choice peer-ip-type {
            description 'Peer address type.' ;
            mandatory true ;
            case peer-ipv4 {
              description 'Peer IPV4 address.' ;
              leaf peer-ipv4-addr {
                description 'Peer IPV4 address.' ;
                type ncd:ipv4-address-none-zero ;

              }

            }

            case peer-ipv6 {
              description 'Peer IPV6 address.' ;
              leaf peer-ipv6-addr {
                description 'Peer IPV6 address.' ;
                type ncd:ipv6-address ;

              }

            }

          }

        }

      }

    }

    ncd:revise-date 2023-01-20 ;
  }

  container state {
    config false ;
    container isakmp {
      description 'ISAKMP state' ;
      container isakmp-sa {
        description 'SHOW ISAKMP SA' ;
        list isakmp-sa {
          description 'SHOW ISAKMP SA' ;
          key 'cki ckr' ;
          leaf cki {
            description 'Initiator cookie,note that the length is only 16 bytes.' ;
            type string {
              length 16 ;

            }

          }

          leaf ckr {
            description 'Responder cookie,note that the length is only 16 bytes.' ;
            type string {
              length 16 ;

            }

          }

          leaf local-address {
            description 'Local addres' ;
            type string {
              length 1..45 ;

            }

          }

          leaf peer-address {
            description 'Peer address' ;
            type string {
              length 1..45 ;

            }

          }

          leaf local-port {
            description 'Local ident port' ;
            type uint32 ;

          }

          leaf peer-port {
            description 'Peer ident port' ;
            type uint32 ;

          }

          leaf remote-id {
            description 'Remote identity' ;
            type string {
              length 1..67 ;

            }

          }

          leaf id-type {
            description 'Identity type' ;
            type string {
              length 1..19 ;

            }

          }

          leaf ike-version {
            description 'Ike sa version' ;
            type string {
              length 1..5 ;

            }

          }

          leaf dpd {
            description 'Identifies Dead Peer Detection function' ;
            type string {
              length 0..9 ;

            }

          }

          leaf nat-tra {
            description 'Identifies NAT Traversal' ;
            type string {
              length 0..9 ;

            }

          }

          leaf vrf-name {
            description 'VRF name' ;
            type string {
              length 0..35 ;

            }

          }

          leaf status {
            description 'Isakmp sa status' ;
            type string {
              length 1..19 ;

            }

          }

          ncd:select "cki ckr" ;
          ncd:select "peer-address vrf-name" ;
          ncd:select peer-address ;
        }

      }

    }

    ncd:revise-date 2023-03-23 ;
  }

}
