              }

              leaf router-mac {
                description 'The router MAC value.' ;
                type ncd:mac-address ;

                mandatory true ;
              }

              leaf distance {
                description 'The route priority, and the default value is 1. The range is 1-255.' ;
                type uint8 {
                  range 1..255 ;

                }

                default 1 ;
              }

              leaf metric {
                description 'The route metric, and the default value is 0. The range is 0-255.' ;
                type uint8 {
                  range 0..255 ;

                }

                default 0 ;
              }

              leaf description {
                description 'The description information of the route.' ;
                type string {
                  length 0..64 ;

                }

              }

              leaf track-name {
                description "The track object which the static route track-detection related. The default value is null, means that don't relate track-detection." ;
                type string {
                  length 1..31 ;

                }

              }

            }

            ncd:revise-date 2022-09-07 ;
          }

          ncd:revise-date 2017-11-30 ;
        }

        container nexthop {
          if-feature nexthop-resolving-delay ;

          description 'The node for IPv4 static route to set related nexthop features.' ;
          container trigger {
            description 'The node to trigger nexthop resolving.' ;
            container delay {
              description 'The node to set delay time.' ;
              leaf time {
                description 'The nexthop resolving delay time , the default value is 0, the range is 0 to 300, and the unit is second.' ;
                type uint32 {
                  range 0..300 {
                    description 'Delay-time value.' ;
                  }

                }

                units second ;
                default 0 ;
              }

            }

          }

          ncd:revise-date 2020-01-09 ;
        }

        container bfd {
          if-feature bfd-template ;

          description "The configuration for IPv4 static route to set BFD's attribute." ;
          container single-bfds {
            description "The configuration for IPv4 static route to set single-hop BFD's attributes." ;
            presence template-name ;
            list single-bfd {
              description "The configuration for single-hop BFD's template name." ;
              key 'ifname nexthop' ;
              leaf ifname {
                description 'The interface name specified.' ;
                type ncd:ifname {
                  length 1..31 ;

                }

              }

              leaf nexthop {
                description 'The nexthop address specified.' ;
                type ncd:ipv4-address ;

              }

              leaf template-name {
                description "The template name of single-hop BFD.
                These characters's ASCII unicode must be between 0x21-0x3E / 0x40-0x7E." ;
                type string {
                  length 1..31 ;

                }

                mandatory true ;
              }

            }

          }

          container multi-bfds {
            description "The configuration for IPv4 static route to set public multi-hop BFD's attributes." ;
            presence template-name ;
            list multi-bfd {
              description "The configuration for multi-hop BFD's template name." ;
              key 'nexthop local-address' ;
              leaf local-address {
                description 'The original address specified.' ;
                type ncd:ipv4-address ;

              }

              leaf nexthop {
                description 'The nexthop address specified.' ;
                type ncd:ipv4-address ;

              }

              leaf template-name {
                description "The template name of public multi-hop BFD.
                These characters's ASCII unicode must be between 0x21-0x3E / 0x40-0x7E." ;
                type string {
                  length 1..31 ;

                }

                mandatory true ;
              }

            }

          }

          container multi-bfds-vrf {
            description "The configuration for IPv4 static route to set private multi-hop BFD's attributes." ;
            presence template-name ;
            list multi-bfd-vrf {
              description "The configuration for private multi-hop BFD's template name." ;
              key 'vrfname nexthop local-address' ;
              leaf vrfname {
                description "The name of the private network VPN.
                These characters's ASCII unicode must be between 0x20-0x7E." ;
                type ncd:string-all {
                  length 1..32 ;

                }

              }

              leaf local-address {
                description 'The original address specified.' ;
                type ncd:ipv4-address ;

              }

              leaf nexthop {
                description 'The nexthop address specified.' ;
                type ncd:ipv4-address ;

              }

              leaf template-name {
                description "The template name of private multi-hop BFD.
                These characters's ASCII unicode must be between 0x21-0x3E / 0x40-0x7E." ;
                type string {
                  length 1..31 ;

                }

                mandatory true ;
              }

            }

          }

          ncd:revise-date 2020-04-03 ;
        }

        container recursion-l3evpns {
          description 'The recursion-l3evpn function for IPv4-STATIC-ROUTE.' ;
          list recursion-l3evpn {
            description 'The recursion-l3evpn function for IPv4-STATIC-ROUTE.' ;
            key vrf-name ;
            leaf vrf-name {
              description 'Specifying the VPN name.' ;
              type string {
                length 1..32 ;

              }

            }

            leaf status {
              description 'Set static route recursion L3EVPN enable or disable.' ;
              type enumeration {
                enum ENABLE {
                  value 1 ;
                  description 'Set static route recursion L3EVPN enable.' ;
                }

                enum DISABLE {
                  value 0 ;
                  description 'Set static route recursion L3EVPN disable.' ;
                }

              }

              mandatory true ;
            }

          }

          ncd:revise-date 2020-08-13 ;
        }

        container track-actions {
          description 'Static route track configuration.' ;
          list track-action {
            description 'Static route track configuration.' ;
            key 'track-name track-state' ;
            leaf track-name {
              description 'Specifying the track name.' ;
              type string {
                length 1..31 ;

              }

            }

            leaf track-state {
              description 'The track state.' ;
              type enumeration {
                enum ADMIN-DOWN {
                  value 1 ;
                  description 'Administratively down.' ;
                }

              }

            }

            leaf action {
              description 'Set static route invalid or not with the track state.' ;
              type enumeration {
                enum VALID {
                  value 1 ;
                  description 'Set static route valid.' ;
                }

                enum INVALID {
                  value 0 ;
                  description 'Set static route invalid.' ;
                }

              }

              mandatory true ;
            }

          }

          ncd:revise-date 2021-01-07 ;
        }

        container only-recurse {
          description 'The only recursion function for IPv4 static route.' ;
          container public-net {
            description 'The only recursion function for IPv4 static route in public net.' ;
            presence route-type ;
            leaf route-type {
              description 'Set the special route type of static route rescure only.' ;
              type recursion-type ;

              mandatory true ;
            }

          }

          container private-nets {
            description 'The only recursion function for IPv4 static route in private net.' ;
            list private-net {
              description 'The only recursion function for IPv4 static route in private net.' ;
              key vrf-name ;
              leaf vrf-name {
                description 'Specifying the VPN name.' ;
                type ncd:string-all {
                  length 1..32 ;

                }

              }

              leaf route-type {
                description 'Set the special route type of static route rescure only.' ;
                type recursion-type ;

                mandatory true ;
              }

            }

          }

          container mng-net {
            description 'The only recursion function for IPv4 static route in mng net.' ;
            presence route-type ;
            leaf route-type {
              description 'Set the special route type of static route rescure only.' ;
              type recursion-type ;

              mandatory true ;
            }

          }

          ncd:revise-date 2021-04-13 ;
        }

      }

      container rpm-srtv6 {
        description "The total node for IPV6-STATIC-ROUTE's all configuration commands." ;
        container route-config {
          description 'Basic configuration information for IPv6 static routes, including destination address, subnet mask, outbound interface, next hop, priority (pref), metric value (metric), tag, BFD detection, track detection, route description (name), and permanent attribute, etc.' ;
          container public-net {
            description 'The configuration for public static route.' ;
            container only-ifs {
              description 'The configuration for static route which only specifies the interface.' ;
              list only-if {
                description 'The configuration for static route which only specifies the interface.' ;
                key 'ipv6-dest-addr mask-len interface' ;
                leaf interface {
                  description 'Specify the interface name.' ;
                  type ncd:ifname {
                    length 1..31 ;

                  }

                }

                leaf ipv6-dest-addr {
                  description 'The destination address.' ;
                  type ncd:ipv6-address ;

                }

                leaf mask-len {
                  description 'The mask length.' ;
