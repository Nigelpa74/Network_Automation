                  length 0..64 ;

                }

              }

              leaf track-name {
                description "The track object which the static route track-detection related. The default value is null, means that don't relate track-detection." ;
                type string {
                  length 1..31 ;

                }

                ncd:revise-date 2018-06-28 ;
              }

            }

          }

          container dynamic-tunnels {
            description 'Routing configuration in IPv4 dynamic tunnel scene.' ;
            list dynamic-tunnel {
              description 'Routing configuration in IPv4 dynamic tunnel scene.' ;
