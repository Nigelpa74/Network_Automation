              }

              leaf vni-label {
                description 'The VNI label value, and the invalid value is 0. The range is 1-16777215.' ;
                type uint32 {
                  range 1..16777215 ;

                }

              }

              leaf router-mac {
                description 'The router MAC value.' ;
                type ncd:mac-address ;

              }

              leaf distance {
                description 'The route priority, and the default value is 1. The range is 1-255.' ;
                type uint8 {
                  range 1..255 ;

                }

                default 1 ;
              }

              leaf metric {
                description 'The route metric, and the default value is 0. The range is 0-255.' ;
                type uint8 {
                  range 0..255 ;

                }

                default 0 ;
              }

              leaf description {
                description 'The description information of the route.' ;
                type string {
                  length 0..64 ;

                }

              }

              leaf track-name {
                description "The track object which the static route track-detection related. The default value is null, means that don't relate track-detection." ;
                type string {
                  length 1..31 ;

                }

              }

            }

            ncd:revise-date 2018-06-28 ;
          }

          container dynamic-tunnels-ipv6 {
            description 'Routing configuration in IPv6 dynamic tunnel scene.' ;
            presence dynamic-ipv6 ;
            list dynamic-tunnel {
              description 'Routing configuration in IPv6 dynamic tunnel scene.' ;
              key 'vrf-name dest-addr mask-addr local-ipv6 remote-ipv6' ;
              leaf vrf-name {
                description 'The name of the private network VPN.' ;
                type string {
                  length 1..32 ;

                }

              }

              leaf dest-addr {
                description 'The destination address.' ;
                type ncd:ipv4-address ;

              }

              leaf mask-addr {
                description 'The mask address.' ;
                type ncd:ipv4-address ;

              }

              leaf local-ipv6 {
                description 'The local IPv6 address of VXLAN tunnel.' ;
                type ncd:ipv6-address-none-zero ;

              }

              leaf remote-ipv6 {
                description 'The remote IPv6 address of VXLAN tunnel.' ;
                type ncd:ipv6-address-none-zero ;

              }

              leaf vni-label {
                description 'The VNI label value, and the invalid value is 0. The range is 1-16777215.' ;
                type uint32 {
                  range 1..16777215 ;

                }

