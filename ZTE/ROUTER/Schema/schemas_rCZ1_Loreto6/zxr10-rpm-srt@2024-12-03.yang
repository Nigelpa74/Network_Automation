        container source-nexthop {
          description 'To specify the original address for static route, using for creating multiple-hops BFD session in some scenarios.' ;
          presence source-nexthop ;
          leaf loopback-name {
            description 'The loopback name specified.' ;
            type ncd:ifname {
              length 1..31 ;

            }

            mandatory true ;
          }

        }

        container source-nexthop-vrf {
          description 'To specify the original address for vpn static route, using for creating vpn multiple-hops BFD session in some scenarios.' ;
          presence source-nexthop-vrf ;
          list private-net {
            description 'To specify the original address for vpn static route, using for creating vpn multiple-hops BFD session in some scenarios.' ;
            key vrf-name ;
            leaf vrf-name {
              description 'Specifying the VPN name.' ;
              type ncd:string-all {
                length 1..32 ;

              }

