module zxr10-rpm-srt {
  namespace "http://www.zte.com.cn/zxr10/netconf/schema/rosng/rpm-srt" ;
  prefix rpm-srt ;
  yang-version 1 ;
  import zxr10-netconf-defs {
    prefix ncd ;
  }

  organization "ZTE Corporation" ;
  contact "ZTE Corporation
  Nanjing Institute of ZTE Corporation
  No.68 Zijinghua Rd. Yuhuatai District, Nanjing, China
  Tel: +86-25-52870000" ;
  description 'The netconf module to describe the function of IPv4-STATIC-ROUTE and IPv6-STATIC-ROUTE in the route protocol module.' ;
  revision 2024-12-03 {
    description '1. Add range definitions for nodes "template-name" and "vrf-name". The paths are:
"configuration/rpm-srt/rpm-srtv4/bfd/multi-bfds/multi-bfd/template-name",
"configuration/rpm-srt/rpm-srtv4/bfd/multi-bfds-vrf/multi-bfd-vrf/vrfname",
"configuration/rpm-srt/rpm-srtv4/bfd/multi-bfds-vrf/multi-bfd-vrf/template-name",
"configuration/rpm-srt/rpm-srtv4/recursion-l3evpns/recursion-l3evpn/vrf-name",
"configuration/rpm-srt/rpm-srtv4/track-actions/track-action/track-name",
"configuration/rpm-srt/rpm-srtv6/bfd/multi-bfds/multi-bfd/template-name",
"configuration/rpm-srt/rpm-srtv6/bfd/multi-bfds-vrf/multi-bfd-vrf/vrfname",
"configuration/rpm-srt/rpm-srtv6/bfd/multi-bfds-vrf/multi-bfd-vrf/template-name",
"configuration/rpm-srt/rpm-srtv6/recursion-l3evpns/recursion-l3evpn/vrf-name",
"configuration/rpm-srt/rpm-srtv/track-actions/track-action/track-name"
2. Remove the mandatory attribute from the key node. paths are "configuration/rpm-srt/rpm-srtv4/route-config/private-net/nexthop-vrfs/nexthop-vrf/nh-vrf-name" and “configuration/rpm-srt/rpm-srtv6/route-config/private-net/nexthop-vrfs/nexthop-vrf/nh-vrf-name”' ;
  }

  revision 2024-06-26 {
    description 'FRR WTR support minute with second. The paths are "".' ;
  }

  revision 2024-01-04 {
    description 'Add presence for fast reroute. The paths are "/configuration/rpm-srt/rpm-srtv4/fast-reroute/public-net" and "/configuration/rpm-srt/rpm-srtv6/fast-reroute/public-net"' ;
  }

  revision 2023-11-30 {
    description 'Add choice-case of wtr-second' ;
  }

  revision 2023-04-24 {
    description 'Add leaves "no-install" to support set no-install static route. The path are "configuration/rpm-srt/rpm-srtv4" and "configuration/rpm-srt/rpm-srtv6".' ;
  }

  revision 2023-01-30 {
    description 'Support showing the information of of IPv6 static routes. The path is "state/rpm-srt/rpm-srtv6".' ;
  }

  revision 2022-12-01 {
    description 'Add project label "All" in feature "ipv4-dest-with-ipv6-global-nh", "nexthop-resolving-delay" and "bfd-template".' ;
  }

  revision 2022-10-20 {
    description 'Add range for nexthop VPN nodes, the paths are "configuration/rpm-srt/rpm-srtv4/route-config/private-net/nh-with-vrfs/nh-with-vrf/nh-vrf-name" and "configuration/rpm-srt/rpm-srtv6/route-config/private-net/nh-with-vrfs/nh-with-vrf/nh-vrf-name".' ;
  }

  revision 2022-09-20 {
    description 'Support configurations of static route in VPN import another VPN.The path are "configuration/rpm-srt/rpm-srtv4/route-config/private-net/nexthop-vrfs" and "configuration/rpm-srt/rpm-srtv6/route-config/private-net/nexthop-vrfs".' ;
  }

  revision 2022-09-07 {
    description 'Support dynamic IPv6 tunnel in IPv6 static route, the path is configuration/rpm-srt/rpm-srtv4/route-vxlan/dynamic-tunnels-ipv6.
Support dynamic IPv4 tunnel in IPv4 static route, the path is configuration/rpm-srt/rpm-srtv6/route-vxlan/dynamic-tunnels-ipv4.' ;
  }

  revision 2022-07-14 {
    description 'Support the public IPv6 static route with IPv4 nexthop.The path is "configuration/rpm-srt/rpm-srtv6/route-config/public-net/ipv4-nhs".' ;
  }

  revision 2022-06-02 {
    description 'Support the VPN instance of nexthop.' ;
  }

  revision 2021-12-10 {
    description 'Modify the fixkeys of route-config.' ;
  }

  revision 2021-05-08 {
    description 'Add nodes sr-policy for static route.
Modify the fixkeys of route-config.' ;
  }

  revision 2021-04-13 {
    description 'Add nodes for restriction of  static route recursion.' ;
  }

  revision 2021-01-07 {
    description 'Add nodes for static route track action.' ;
  }

  revision 2020-08-19 {
    description 'Add nodes for VRF of nexthop.' ;
  }

  revision 2020-08-13 {
    description 'Add a new node to configure recursion l3evpn for IPv4 static route and IPv6 static route.
The paths are "configuration/rpm-srt/rpm-srtv4/recursion-l3evpn" and "configuration/rpm-srt/rpm-srtv6/recursion-l3evpn".' ;
  }

  revision 2020-04-26 {
    description 'Add a new node to configure recursion l3vpn for IPv6 static route.
The paths are "configuration/rpm-srt/rpm-srtv6/recursion-l3vpn".' ;
  }

  revision 2020-04-03 {
    description 'Add a new node to configure bfd template of IPv4 static route.
Add a new node to configure bfd template of IPv6 static route.
The paths are "configuration/rpm-srt/rpm-srtv4/bfd","configuration/rpm-srt/rpm-srtv6/bfd".' ;
  }

  revision 2020-01-09 {
    description 'Add new containers to configure nexthop of IPv4 static route resolving delay.
Add new containers to configure nexthop of IPv6 static route resolving delay.
The paths are "configuration/rpm-srt/rpm-srtv4/nexthop/trigger/delay","configuration/rpm-srt/rpm-srtv6/nexthop/trigger/delay".
Update the attribute id of IPv4 destination and mask.' ;
  }

  revision 2019-10-29 {
    description 'Add new project label of V6000.vRouter and V6000.vBras-C in features "ipv6-global-nh".' ;
  }

  revision 2019-09-04 {
    description 'Add new project label of SWITCH.5960 and SWITCH.99 in features "ipv6-global-nh".' ;
  }

  revision 2019-08-21 {
    description 'Add new project label of T8000 in feature "ipv4-dest-with-ipv6-global-nh".' ;
  }

  revision 2019-06-26 {
    description 'Add new project label of PTN.6100 in features "ipv6-global-nh" and "ipv4-dest-with-ipv6-global-nh".' ;
  }

  revision 2019-04-01 {
    description 'Add a features of ipv4-dest-with-ipv6-global-nh.global-v6-nhs
Add a new node global-v6-nhs in IPv4-STATIC-ROUTE to configure ipv6 global nexthop.
The paths are "configuration/rpm-srt/rpm-srtv4/private-net/global-v6-nhs","configuration/rpm-srt/rpm-srtv4/mng-net/global-v6-nhs".
Add a leaf "ipv6-nexthop" in state/rpm-srt/route-status/view-list.' ;
  }

  revision 2019-03-25 {
    description 'Add new project label of OTN 9700/8700 to support IPv6 static route.' ;
  }

  revision 2019-02-21 {
    description 'Add new project label of 65v5 to support ipv6-route.' ;
  }

  revision 2019-01-23 {
    description 'Add project label V6000(vRouter/vBras-C) on features of public-dest-address.' ;
  }

  revision 2018-12-04 {
    description 'Add the route-vxlan node for IPv6-STATIC-ROUTE. The path is "configuration/rpm-srt/rpm-srtv6/route-vxlan".
Add a feature "ipv6-vxlan" for IPv6 vxlan route.' ;
  }

  revision 2018-10-31 {
    description 'Add a new leaf global in IPv6-STATIC-ROUTE to configure IPv6 nexthop to be global.
The paths are "configuration/rpm-srt/rpm-srtv6/private-net/only-nhs/only-nh" and "configuration/rpm-srt/rpm-srtv6/mng-net/only-nhs/only-nh".
Add a feature "ipv6-global-nh" for IPv6 static route global function.' ;
  }

  revision 2018-10-28 {
    description 'Add project label PTN(6100) on features of ipv4-global-nh and ipv6-permanent.' ;
  }

  revision 2018-08-02 {
    description 'Add the permanent node for IPv6-STATIC-ROUTE to set permanent attribute. The path is "configuration/rpm-srt/rpm-srtv6/route-config".' ;
  }

  revision 2018-07-26 {
    description 'Add one enumeration value (PUBLIC) to the leaf node nhtype. The path is "state/rpm-srt/rpm-srtv4/route-status/view-list/nhtype".' ;
  }

  revision 2018-06-28 {
    description 'Add the leaf track-name for route-vxlan to support relating track-detection. The path is "configuration/rpm-srt/rpm-srtv4/route-vxlan/static-tunnels/static-tunnel".
Add the container dynamic-tunnels for route-vxlan to support dynamic tunnel route. The path is "configuration/rpm-srt/rpm-srtv4/route-vxlan/dynamic-tunnels".' ;
  }

  revision 2018-05-30 {
    description 'Add a new node global-v4-nhs in IPv6-STATIC-ROUTE to configure IPv4 nexthop to be global.
The paths are "configuration/rpm-srt/rpm-srtv6/private-net/global-v4-nhs" and "configuration/rpm-srt/rpm-srtv6/mng-net/global-v4-nhs".
Add a feature "ipv4-global-nh-feature" for IPv6 static route global function.' ;
  }

  revision 2018-05-10 {
    description 'Add a new node publics in IPv4-STATIC-ROUTE and IPv6-STATIC-ROUTE to configure nexthop to be public.
The paths are "configuration/rpm-srt/rpm-srtv4/private-net/publics","configuration/rpm-srt/rpm-srtv4/mng-net/publics","configuration/rpm-srt/rpm-srtv6/private-net/publics",and "configuration/rpm-srt/rpm-srtv6/mng-net/publics".
Add a feature "public-dest-address" for public dest-address function.' ;
  }

  revision 2018-01-26 {
    description 'Modify the leaf name l3vni-label to vni-label for static VXLAN route.' ;
  }

  revision 2017-11-30 {
    description 'Add the route-vxlan node for IPv4-STATIC-ROUTE. The path is "configuration/rpm-srt/rpm-srtv4/route-vxlan".' ;
  }

  revision 2016-05-26 {
    description 'Add the recursion-l3vpn node for IPv4-STATIC-ROUTE. The path is "configuration/rpm-srt/rpm-srtv4/recursion-l3vpn".' ;
  }

  revision 2015-11-03 {
    description 'Add the source-nexthop-vrf node for IPv4-STATIC-ROUTE to set vpn peer-bfd local address. The path is "configuration/rpm-srt/rpm-srtv4/source-nexthop-vrf".' ;
  }

  revision 2015-07-28 {
    description 'Modify the "config" attribute of the state node and its leaf nodes.' ;
  }

  revision 2015-04-03 {
    description 'Add the preference-decrement node for IPv4-STATIC-ROUTE to set preference decrement when the route has been related with track detection. The path is "configuration/rpm-srt/rpm-srtv4/route-config".' ;
  }

  revision 2015-04-02 {
    description 'Add the tag-value node for IPv6-STATIC-ROUTE to set tag value. The path is "configuration/rpm-srt/rpm-srtv6/route-config".' ;
  }

  revision 2015-02-28 {
    description 'Add the dynamic-protect node for IPv6-STATIC-ROUTE to protect the dynamic route. The path is "configuration/rpm-srt/rpm-srtv6/dynamic-protect".' ;
  }

  revision 2014-08-07 {
    description 'Add the update-delay node for IPv4-STATIC-ROUTE to set update-delay time. The path is "configuration/rpm-srt/rpm-srtv4/update-delay".' ;
  }

  revision 2014-07-01 {
    description 'Add the dynamic-protect node for IPv4-STATIC-ROUTE to protect the dynamic route. The path is "configuration/rpm-srt/rpm-srtv4/dynamic-protect".' ;
  }

  revision 2014-05-08 {
    description 'Modify the description of fast-reroute node in rpm-srtv4 module.' ;
  }

  revision 2014-04-22 {
    description 'Add the routing status query function for IPV4-STATIC-ROUTE module.' ;
  }

  revision 2014-03-19 {
    description "Modify the attribute's length of track-name and description." ;
  }

  revision 2014-03-18 {
    description '1.Add a new attribute ifnh-flag for IPv4-STATIC-ROUTE and IPv6-STATIC-ROUTE to label both-if-nh node.
2.Delete the regular expression of if-nexthop and the ipv6-if-nh node.' ;
  }

  revision 2013-08-15 {
    description 'The initial version.' ;
  }

  feature public-dest-address {
    description 'The anycast-mac-address configuration is used to configure nexthop to be public.' ;
  }

  feature ipv4-global-nh {
    description 'This configuration is used to configure IPv4 global nexthop for IPv6 static route.' ;
  }

  feature ipv6-permanent {
    description 'This configuration is used to specify permanent IPv6 static route.' ;
  }

  feature ipv6-global-nh {
    reference "This configuration is used to configure IPv6 global nexthop for IPv6 static route." ;
  }

  feature ipv6-vxlan {
    description 'The feature is for IPv6 vxlan route.' ;
  }

  feature ipv4-dest-with-ipv6-global-nh {
    description 'This configuration is used to configure IPv6 global nexthop for IPv4 static route.' ;
  }

  feature nexthop-resolving-delay {
    description 'This configuration is used to configure IPv4 and IPv6 static route nexthop resolving delay.' ;
  }

  feature bfd-template {
    description "This configuration is used to configure IPv4 and IPv6 static route BFD's template." ;
  }

  typedef protect-type {
    type enumeration {
      enum RIP {
        value 1 ;
        description 'Static route protect RIP route.' ;
      }

      enum OSPF {
        value 2 ;
        description 'Static route protect OSPFv2 route.' ;
      }

      enum BGP {
        value 4 ;
        description 'Static route protect BGP route.' ;
      }

      enum ISIS {
        value 8 ;
        description 'Static route protect ISIS route.' ;
      }

    }

    description 'Define the route type which the static route can protect.' ;
  }

  typedef recursion-type {
    type enumeration {
      enum DIRECT {
        value 1 ;
        description 'Static route can recurse direct route only.' ;
      }

    }

    description 'Define the route type which the static route can recurse.' ;
  }

  typedef address-family {
    type enumeration {
      enum IPv4 {
        value 2 ;
      }

      enum IPv6 {
        value 24 ;
      }

    }

  }

  typedef network-type {
    type enumeration {
      enum MAIN {
        value 1 ;
      }

      enum VRF {
        value 2 ;
        description 'The private static routes.' ;
      }

      enum MNG {
        value 3 ;
        description 'The mng static routes.' ;
      }

      enum ALL {
        value 4 ;
        description 'All static routes.' ;
      }

    }

  }

  typedef interface-status {
    type enumeration {
      enum none {
        value 0 ;
      }

      enum up {
        value 1 ;
      }

      enum down {
        value 2 ;
      }

    }

  }

  container configuration {
    description 'The configuration information processing of IPv4-STATIC-ROUTE and IPv6-STATIC-ROUTE module.' ;
    container rpm-srt {
      description 'The configuration information processing of IPv4-STATIC-ROUTE and IPv6-STATIC-ROUTE module.' ;
      container rpm-srtv4 {
        description "The total node for IPV4-STATIC-ROUTE's all configuration commands." ;
        container route-config {
          description 'Basic configuration information for IPv4 static routes, including destination address, subnet mask, outbound interface, next hop, priority (pref), metric value (metric), tag, BFD detection, track detection, route description (name), and permanent attribute, etc.' ;
          container public-net {
            description 'The configuration for public static route.' ;
            container only-ifs {
              description 'The configuration for static route which only specifies the interface.' ;
              list only-if {
                description 'The configuration for static route which only specifies the interface.' ;
                key 'dest-addr mask-addr interface' ;
                leaf dest-addr {
                  description 'The destination address of route.' ;
                  type ncd:ipv4-address ;

                }

                leaf mask-addr {
                  description 'The mask of route.' ;
                  type ncd:ipv4-address ;

                }

                leaf interface {
                  description 'The interface name of route.' ;
                  type ncd:ifname {
                    length 1..31 ;

                  }

                }

                leaf preference {
                  description 'The route priority and the default value is 1. The range is 1-255.' ;
                  type uint8 {
                    range 1..255 ;

                  }

                  default 1 ;
                }

                leaf metric {
                  description 'The route metric, and the default value is 0. The range is 0-255.' ;
                  type uint8 {
                    range 0..255 ;

                  }

                  default 0 ;
                }

                leaf tag-value {
                  description 'The route tag, and the default value is 0. The range is 0-4294967295.' ;
                  type uint32 {
                    range 0..4294967295 ;

                  }

                  default 0 ;
                }

                leaf track-name {
                  description "The track object name which the static route track-detection related. The default value is null, means that don't relate track-detection." ;
                  type string {
                    length 1..31 ;

                  }

                }

                leaf preference-decrement {
                  description 'The preference decrement can be set when the route has been related with track detection.' ;
                  type uint8 {
                    range 0..255 ;

                  }

                  default 0 ;
                  ncd:revise-date 2015-04-03 ;
                }

                leaf description {
                  description 'The description of the static route information. The default value is empty, means no description information.' ;
                  type string {
                    length 1..64 ;

                  }

                }

                leaf permanent {
                  description 'Whether a permanent static route, the default is 0 means no, and 1 means yes. The range is 0-1.' ;
                  type uint8 {
                    range 0..1 ;

                  }

                  default 0 ;
                }

                leaf no-install {
                  type uint8 {
                    range 0..1 ;

                  }

                  description 'Indicates whether the static route does not deliver the forwarding table, the default is 0 means delivered to the forwarding table, and 1 means not delivered to the forwarding table. The range is 0-1.' ;
                  ncd:revise-date 2023-04-24 ;
                }

              }

            }

            container only-nhs {
              description 'The configuration for static route which only specifies the nexthop.' ;
              list only-nh {
                description 'The configuration for static route which only specifies the nexthop.' ;
                key 'dest-addr mask-addr nexthop' ;
                leaf dest-addr {
                  description 'The destination address of route.' ;
                  type ncd:ipv4-address ;

                }

                leaf mask-addr {
                  description 'The mask of route.' ;
                  type ncd:ipv4-address ;

                }

                leaf nexthop {
                  description 'The nexthop of route.' ;
                  type ncd:ipv4-address ;

                }

                leaf preference {
                  description 'The route priority, and the default value is 1. The range is 1-255.' ;
                  type uint8 {
                    range 1..255 ;

                  }

                  default 1 ;
                }

                leaf metric {
                  description 'The route metric, and the default value is 0. The range is 0-255.' ;
                  type uint8 {
                    range 0..255 ;

                  }

                  default 0 ;
                }

                leaf tag-value {
                  description 'The route tag, and the default value is 0. The range is 0-4294967295.' ;
                  type uint32 {
                    range 0..4294967295 ;

                  }

                  default 0 ;
                }

                leaf bfd-button {
                  description 'Whether associated BFD detection, the default is 0 means no, and 1 means yes. The range is 0-1.' ;
                  type uint8 {
                    range 0..1 ;

                  }

                  default 0 ;
                }

                leaf track-name {
                  description "The track object which the static route track-detection related. The default value is null, means that don't relate track-detection." ;
                  type string {
                    length 1..31 ;

                  }

                }

                leaf preference-decrement {
                  description 'The preference decrement can be set when the route has been related with track detection.' ;
                  type uint8 {
                    range 0..255 ;

                  }

                  default 0 ;
                  ncd:revise-date 2015-04-03 ;
                }

                leaf description {
                  description 'The description of the static route information. The default value is empty, means no description information.' ;
                  type string {
                    length 1..64 ;

                  }

                }

                leaf permanent {
                  description 'Whether a permanent static route, the default is 0 means no, and 1 means yes. The range is 0-1.' ;
                  type uint8 {
                    range 0..1 ;

                  }

                  default 0 ;
                }

                leaf no-install {
                  type uint8 {
                    range 0..1 ;

                  }

                  default 0 ;
                  description 'Indicates whether the static route does not deliver the forwarding table, the default is 0 means delivered to the forwarding table, and 1 means not delivered to the forwarding table. The range is 0-1.' ;
                  ncd:revise-date 2023-04-24 ;
                }

              }

            }

            container both-if-nhs {
              description 'The configuration for static route which both specify the interface and the nexthop.' ;
              list both-if-nh {
                description 'The configuration for static route which both specify the interface and the nexthop.' ;
                key 'dest-addr mask-addr interface if-nexthop' ;
                leaf dest-addr {
                  description 'The destination address.' ;
                  type ncd:ipv4-address ;

                }

                leaf mask-addr {
                  description 'The mask.' ;
                  type ncd:ipv4-address ;

                }

                leaf interface {
                  description 'The interface.' ;
                  type ncd:ifname {
                    length 1..31 ;

                  }

                }

                leaf if-nexthop {
                  description 'The nexthop of route.' ;
                  type ncd:ipv4-address ;

                }

                leaf preference {
                  description 'The route priority, and the default value is 1. The range is 1-255.' ;
                  type uint8 {
                    range 1..255 ;

                  }

                  default 1 ;
                }

                leaf metric {
                  description 'The route metric, and the default value is 0. The range is 0-255.' ;
                  type uint8 {
                    range 0..255 ;

                  }

                  default 0 ;
                }

                leaf tag-value {
                  description 'The route tag, and the default value is 0. The range is 0-4294967295.' ;
                  type uint32 {
                    range 0..4294967295 ;

                  }

                  default 0 ;
                }

                leaf bfd-button {
                  description 'Whether associated BFD detection, the default is 0 means no, and 1 means yes. The range is 0-1.' ;
                  type uint8 {
                    range 0..1 ;

                  }

                  default 0 ;
                }

                leaf track-name {
                  description "The track object which the static route track-detection related. The default value is null, means that don't relate track-detection." ;
                  type string {
                    length 1..31 ;

                  }

                }

                leaf preference-decrement {
                  description 'The preference decrement can be set when the route has been related with track detection.' ;
                  type uint8 {
                    range 0..255 ;

                  }

                  default 0 ;
                  ncd:revise-date 2015-04-03 ;
                }

                leaf description {
                  description 'The description of the static route information. The default value is empty, means no description information.' ;
                  type string {
                    length 1..64 ;

                  }

                }

                leaf permanent {
                  description 'Whether a permanent static route, the default is 0 means no, and 1 means yes. The range is 0-1.' ;
                  type uint8 {
                    range 0..1 ;

                  }

                  default 0 ;
                }

                leaf no-install {
                  type uint8 {
                    range 0..1 ;

                  }

                  default 0 ;
                  description 'Indicates whether the static route does not deliver the forwarding table, the default is 0 means delivered to the forwarding table, and 1 means not delivered to the forwarding table. The range is 0-1.' ;
                  ncd:revise-date 2023-04-24 ;
                }

              }

            }

            container nexthop-vrfs {
              description 'Configure static routes with nexthop in VPN instance.' ;
              list nexthop-vrf {
                description 'Configure static routes with nexthop in VPN instance.' ;
                key 'dest-addr mask-addr' ;
                leaf dest-addr {
                  description 'The destination address.' ;
                  type ncd:ipv4-address ;

                }

                leaf mask-addr {
                  description 'The mask.' ;
                  type ncd:ipv4-address ;

                }

                leaf nh-vrf-name {
                  description 'The name of the private network VPN.' ;
                  type ncd:string-all {
                    length 1..32 ;

                  }

                  mandatory true ;
                }

                leaf preference {
                  description 'The route priority, and the default value is 1. The range is 1-255.' ;
                  type uint8 {
                    range 1..255 ;

                  }

                  default 1 ;
                }

                leaf description {
                  description 'The description of the static route information. The default value is empty, means no description information.' ;
                  type string {
                    length 1..64 ;

                  }

                }

                leaf metric {
                  description 'The route metric, and the default value is 0. The range is 0-255.' ;
                  type uint8 {
                    range 0..255 ;

                  }

                  default 0 ;
                  ncd:revise-date 2022-09-20 ;
                }

                leaf track-name {
                  description "The track object which the static route track-detection related. The default value is null, means that don't relate track-detection." ;
                  type string {
                    length 1..31 ;

                  }

                  ncd:revise-date 2022-09-20 ;
                }

                leaf no-install {
                  type uint8 {
                    range 0..1 ;

                  }

                  default 0 ;
                  description 'Indicates whether the static route does not deliver the forwarding table, the default is 0 means delivered to the forwarding table, and 1 means not delivered to the forwarding table. The range is 0-1.' ;
                  ncd:revise-date 2023-04-24 ;
                }

              }

              ncd:revise-date 2020-08-19 ;
            }

            container sr-policys {
              description 'The configuration for static route which only specifies the SR Policy.' ;
              list sr-policy {
