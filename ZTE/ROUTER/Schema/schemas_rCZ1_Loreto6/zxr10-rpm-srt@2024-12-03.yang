              key 'vrf-name ipv6-dest-addr mask-len local-ip remote-ip' ;
              leaf vrf-name {
                description 'The name of the private network VPN.' ;
                type string {
                  length 1..32 ;

                }

              }

              leaf ipv6-dest-addr {
                description 'The destination address.' ;
                type ncd:ipv6-address ;

              }

              leaf mask-len {
                description 'The mask lenth.' ;
                type uint8 ;

              }

              leaf local-ip {
                description 'The local IP address of VXLAN tunnel.' ;
                type ncd:ipv4-address-none-zero ;

              }

              leaf remote-ip {
                description 'The remote IP address of VXLAN tunnel.' ;
                type ncd:ipv4-address-none-zero ;

              }

              leaf vni-label {
                description 'The VNI label value, and the invalid value is 0. The range is 1-16777215.' ;
                type uint32 {
                  range 1..16777215 ;

                }

                mandatory true ;
              }

              leaf router-mac {
                description 'The router MAC value.' ;
                type ncd:mac-address ;

                mandatory true ;
              }

              leaf distance {
                description 'The route priority, and the default value is 1. The range is 1-255.' ;
                type uint8 {
                  range 1..255 ;

                }

                default 1 ;
              }

              leaf metric {
                description 'The route metric, and the default value is 0. The range is 0-255.' ;
                type uint8 {
                  range 0..255 ;

                }

                default 0 ;
              }

              leaf description {
                description 'The description information of the route.' ;
                type string {
                  length 0..64 ;

                }

              }

              leaf track-name {
                description "The track object which the static route track-detection related. The default value is null, means that don't relate track-detection." ;
                type string {
                  length 1..31 ;

                }

              }

            }

            ncd:revise-date 2022-09-07 ;
          }

          ncd:revise-date 2018-12-04 ;
        }

        container nexthop {
          if-feature nexthop-resolving-delay ;

          description 'The node for IPv6 static route to set related nexthop features.' ;
          container trigger {
            description 'The node to trigger nexthop resolving.' ;
            container delay {
              description 'The node to set delay time.' ;
              leaf time {
                description 'The nexthop resolving delay time , the default value is 0, the range is 0 to 300, and the unit is second.' ;
                type uint32 {
                  range 0..300 {
                    description 'Delay-time value.' ;
                  }

                }

                units second ;
                default 0 ;
              }

            }

          }

          ncd:revise-date 2020-01-09 ;
        }

        container bfd {
          if-feature bfd-template ;

          description "The configuration for IPv6 static route to set BFD's attribute." ;
          container single-bfds {
            description "The configuration for IPv6 static route to set single-hop BFD's attributes." ;
            presence template-name ;
            list single-bfd {
              description "The configuration for IPv6 static route to set single-hop BFD's attributes." ;
              key 'ifname nexthop' ;
              leaf ifname {
                description 'The interface name specified.' ;
                type ncd:ifname {
                  length 1..31 ;

                }

              }

              leaf nexthop {
                description 'The nexthop address specified.' ;
                type ncd:ipv6-address ;

              }

              leaf template-name {
                description "The template name of single-hop BFD.
                These characters's ASCII unicode must be between 0x21-0x3E / 0x40-0x7E." ;
                type string {
                  length 1..31 ;

                }

                mandatory true ;
              }

            }

          }

          container multi-bfds {
            description "The configuration for IPv6 static route to set public multi-hop BFD's attributes." ;
            presence template-name ;
            list multi-bfd {
              description "The configuration for public multi-hop BFD's template name." ;
              key 'nexthop local-address' ;
              leaf local-address {
                description 'The original address specified.' ;
                type ncd:ipv6-address ;

              }

              leaf nexthop {
                description 'The nexthop address specified.' ;
                type ncd:ipv6-address ;

              }

              leaf template-name {
                description "The template name of public multi-hop BFD.
                These characters's ASCII unicode must be between 0x21-0x3E / 0x40-0x7E." ;
                type string {
                  length 1..31 ;

                }

                mandatory true ;
              }

            }

          }

          container multi-bfds-vrf {
            description "The configuration for IPv6 static route to set multi-hop BFD's attributes." ;
            presence template-name ;
            list multi-bfd-vrf {
              description "The configuration for private multi-hop BFD's template name." ;
              key 'vrfname nexthop local-address' ;
              leaf vrfname {
                description "The name of the private network VPN.
                These characters's ASCII unicode must be between 0x20-0x7E." ;
                type ncd:string-all {
                  length 1..32 ;

                }

              }

              leaf local-address {
                description 'The original address specified.' ;
                type ncd:ipv6-address ;

              }

              leaf nexthop {
                description 'The nexthop address specified.' ;
                type ncd:ipv6-address ;

              }

              leaf template-name {
                description "The template name of private multi-hop BFD.
                These characters's ASCII unicode must be between 0x21-0x3E / 0x40-0x7E." ;
                type string {
                  length 1..31 ;

                }

                mandatory true ;
              }

            }

          }

          ncd:revise-date 2020-04-03 ;
        }

        container recursion-l3evpns {
          description 'The recursion-l3evpn function for IPv6-STATIC-ROUTE.' ;
          list recursion-l3evpn {
            description 'The recursion-l3evpn function for IPv6-STATIC-ROUTE.' ;
            key vrf-name ;
            leaf vrf-name {
              description 'Specifying the VPN name.' ;
              type string {
                length 1..32 ;

              }

            }

            leaf status {
              description 'Set static route recursion L3EVPN enable or disable.' ;
              type enumeration {
                enum ENABLE {
                  value 1 ;
                  description 'Set static route recursion L3EVPN enable.' ;
                }

                enum DISABLE {
                  value 0 ;
                  description 'Set static route recursion L3EVPN disable.' ;
                }

              }

              mandatory true ;
            }

          }

          ncd:revise-date 2020-08-13 ;
        }

        container track-actions {
          description 'Static route track configuration.' ;
          list track-action {
            description 'Static route track configuration.' ;
            key 'track-name track-state' ;
            leaf track-name {
              description 'Specifying the track name.' ;
              type string {
                length 1..31 ;

              }

            }

            leaf track-state {
              description 'The track state.' ;
              type enumeration {
                enum ADMIN-DOWN {
                  value 1 ;
                  description 'Administratively down.' ;
                }

              }

            }

            leaf action {
              description 'Set static route invalid or not with the track state.' ;
              type enumeration {
                enum VALID {
                  value 1 ;
                  description 'Set static route valid.' ;
                }

                enum INVALID {
                  value 0 ;
                  description 'Set static route invalid.' ;
                }

              }

              mandatory true ;
            }

          }

          ncd:revise-date 2021-01-07 ;
        }

        container only-recurse {
          description 'The only recursion function for IPv6 static route.' ;
          container public-net {
            description 'The only recursion function for IPv6 static route in public net.' ;
            presence route-type ;
            leaf route-type {
              description 'Set the special route type of static route rescure only.' ;
              type recursion-type ;

              mandatory true ;
            }

          }

          container private-nets {
            description 'The only recursion function for IPv6 static route in private net.' ;
            list private-net {
              description 'The only recursion function for IPv6 static route in private net.' ;
              key vrf-name ;
              leaf vrf-name {
                description 'Specifying the VPN name.' ;
                type ncd:string-all {
                  length 1..32 ;

                }

              }

              leaf route-type {
                description 'Set the special route type of static route rescure only.' ;
                type recursion-type ;

                mandatory true ;
              }

            }

          }

          container mng-net {
            description 'The only recursion function for IPv6 static route in mng net.' ;
            presence route-type ;
            leaf route-type {
              description 'Set the special route type of static route rescure only.' ;
              type recursion-type ;

              mandatory true ;
            }

          }

          ncd:revise-date 2021-04-13 ;
        }

      }

    }

  }

  container state {
    config false ;
    description 'The information query of IPv4-STATIC-ROUTE and IPv6-STATIC-ROUTE module.' ;
    container rpm-srt {
      description 'The information query of IPv4-STATIC-ROUTE and IPv6-STATIC-ROUTE module.' ;
      container rpm-srtv4 {
        description 'The information query of IPv4-STATIC-ROUTE module.' ;
        container route-status {
          description 'The routing status query.' ;
          list view-list {
            description 'The list of routing status query.' ;
            key 'objtype vrfname addr mask nhtype nexthop ifname' ;
            leaf objtype {
              description 'The route type. The "MAIN" means the public route, the "VRF" means private route, the "MNG" means mng route, and the "ALL" means all routes (which is not used now).' ;
              type enumeration {
                enum MAIN {
                  value 1 ;
                  description 'The public static routes.' ;
                }

                enum VRF {
                  value 2 ;
                  description 'The private static routes.' ;
                }

                enum MNG {
                  value 3 ;
                  description 'The mng static routes.' ;
                }

                enum ALL {
                  value 4 ;
                  description 'All static routes.' ;
                }

              }

            }

            leaf vrfname {
              description 'The name of the private network VPN. The "" means public route.' ;
              type ncd:string-all {
                length 0..32 ;

              }

            }

            leaf addr {
              description 'The destination address.' ;
              type ncd:ipv4-address ;

            }

            leaf mask {
              description 'The mask.' ;
              type ncd:ipv4-address ;

            }

            leaf nhtype {
              description 'The nexthop type. The "IP" means configuration only with nexthop, the "IF" means configuration only with interface, the "IFIP" means configuration both with interface and nexthop, the "PUBLIC" means configuration with public.' ;
              type enumeration {
                enum IP {
                  value 1 ;
                  description 'Only has nexthop.' ;
                }

                enum IF {
                  value 2 ;
                  description 'Only has interface.' ;
                }

                enum IFIP {
                  value 3 ;
                  description 'Both have nexthop and interface.' ;
                }

                enum PUBLIC {
                  value 4 ;
                  description 'The nexthop is public.' ;
                }

              }

            }

            leaf nexthop {
              description 'The route nexthop.' ;
              type ncd:ipv4-address ;

            }

            leaf ifname {
              description 'The interface name of route.' ;
              type ncd:string-all ;

            }

            leaf route-status {
              description 'The route status. The "VALID" means that route is valid, the "INVALID" means that route is invalid, and the "NOTEXIST" means route is not exist (which is not used now).' ;
              type enumeration {
                enum VALID {
                  value 0 ;
                  description 'Route is valid.' ;
                }

                enum INVALID {
                  value 1 ;
                  description 'Route is invalid.' ;
                }

                enum NOTEXIST {
                  value 2 ;
                  description 'Route is not exist.' ;
                }

              }

              default VALID ;
            }

            leaf route-tag {
              description 'The route tag, and the default value is 0. The range is 0-4294967295' ;
              type uint32 {
                range 0..4294967295 ;

              }

              default 0 ;
            }

            leaf is-used-backup {
              description 'The route is backup route or not. The "YES" means yes, and the "NO" means no.' ;
              type enumeration {
                enum NO {
                  value 0 ;
                  description 'The route is not backup route.' ;
                }

                enum YES {
                  value 1 ;
                  description 'The route is backup route.' ;
                }

              }

              default NO ;
            }

            leaf ipv6-nexthop {
              if-feature ipv4-dest-with-ipv6-global-nh ;

              description 'The route IPv6 nexthop.' ;
              type ncd:ipv6-address ;

              ncd:revise-date 2019-04-01 ;
            }

            leaf preference {
              type uint8 ;

              ncd:revise-date 2023-01-30 ;
            }

            leaf interface-status {
              type interface-status ;

              ncd:revise-date 2023-01-30 ;
            }

            leaf tunnel-id {
              type uint32 ;

              ncd:revise-date 2023-01-30 ;
            }

          }

        }

      }

      container rpm-srtv6 {
        container route-status {
          list view-list {
            key 'objtype vrfname prefix prefix-length ipv6-nexthop ifname nexthop' ;
            leaf objtype {
              type network-type ;

            }

            leaf vrfname {
              type string ;

            }

            leaf prefix {
              type ncd:ipv6-address ;

            }

            leaf prefix-length {
              type uint8 ;

            }

            leaf ipv6-nexthop {
              type ncd:ipv6-address ;

            }

            leaf ifname {
              type ncd:string-all ;

            }

            leaf nexthop {
              type ncd:ipv4-address ;

            }

            leaf route-status {
              description 'The route status. The "VALID" means that route is valid, the "INVALID" means that route is invalid, and the "NOTEXIST" means route is not exist (which is not used now).' ;
              type enumeration {
                enum VALID {
                  value 0 ;
                  description 'Route is valid.' ;
                }

                enum INVALID {
                  value 1 ;
                  description 'Route is invalid.' ;
                }

                enum NOTEXIST {
                  value 2 ;
                  description 'Route is not exist.' ;
                }

              }

              default VALID ;
            }

            leaf preference {
              type uint8 ;

            }

            leaf interface-status {
              type interface-status ;

            }

            leaf tunnel-id {
              type uint32 ;

            }

          }

        }

        ncd:revise-date 2023-01-30 ;
      }

    }

  }

}
