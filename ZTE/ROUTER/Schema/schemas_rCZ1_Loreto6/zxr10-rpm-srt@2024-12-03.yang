        }

        container fast-reroute {
          description "The node for IPv4-STATIC-ROUTE's FRR function." ;
          container public-net {
            description 'Enable or disable the switch of FRR function in public network.' ;
            presence enable ;
            leaf wtr-value {
              type uint8 {
                range 0..12 ;

              }

              description 'Set the WTR(WaitToRestore) time in minute, the range is 0-12.' ;
              default 0 ;
              units mins ;
            }

            leaf wtr-second-with-minute {
              description 'Set the WTR(WaitToRestore) time in second, the range is 0-59. This leaf must set with the leaf "wtr-value".' ;
              type uint32 {
                range 0..59 ;

              }

              units sec ;
              ncd:revise-date 2024-06-26 ;
            }

            leaf wtr-second {
              type uint32 {
                range 1..720 ;

              }

              description 'Set the WTR(WaitToRestore) time in second, the range is 0-720.' ;
              units sec ;
              ncd:revise-date 2023-11-30 ;
            }

            ncd:revise-date 2013-08-15 ;
          }

          container private-nets {
            description 'Enable or disable the switch of FRR function in private network.' ;
            list private-net {
              description 'Enable or disable the switch of FRR function in private network.' ;
              key vrf-name ;
              leaf vrf-name {
                description 'Specifying the VPN name' ;
                type ncd:string-all {
                  length 1..32 ;

                }

              }

              leaf wtr-value {
                type uint8 {
                  range 0..12 ;

                }

                default 0 ;
                units mins ;
                description 'Set the WTR(WaitToRestore) time in minute, the range is 0-12.' ;
              }

              leaf wtr-second-with-minute {
                type uint32 {
                  range 0..59 ;

                }

                units sec ;
                description 'Set the WTR(WaitToRestore) time in second, the range is 0-720.' ;
                ncd:revise-date 2024-06-26 ;
              }

              leaf wtr-second {
                type uint32 {
                  range 1..720 ;

                }

                description 'Set the WTR(WaitToRestore) time in second, the range is 0-720.' ;
                units sec ;
                ncd:revise-date 2023-11-30 ;
              }

            }

            ncd:revise-date 2013-08-15 ;
          }

        }

        container dynamic-protect {
          description 'The function node for IPv4-STATIC-ROUTE to protect the dynamic route(RIP, OSPFv2, ISIS, BGP etc).' ;
          container public-nets {
            description 'Enable or disable the function of dynamic-route-protection in public network.' ;
            list public-net {
              description 'Enable or disable the function of dynamic-route-protection in public network.' ;
              key route-type ;
              leaf route-type {
                description 'Specify the route type (RIP, OSPF, BGP, ISIS) which is needed to protect.' ;
