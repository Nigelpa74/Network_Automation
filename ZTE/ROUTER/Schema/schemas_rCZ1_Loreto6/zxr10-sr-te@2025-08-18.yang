                units second ;
                mandatory true ;
              }

              leaf policy-type {
                type enumeration {
                  enum srv6 {
                    value 0 ;
                  }

                }

                description 'The path setup type of policy.' ;
                mandatory true ;
              }

              description 'Configure a delay for deleting original local SIDs.' ;
