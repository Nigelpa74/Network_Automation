  feature static-sr-tunnel-netconf-get-compress-num {
    description 'The number of compressed static SR tunnels when netconf get.' ;
  }

  feature static-sr-tunnel-compress-num {
    description 'The number of compressed static SR tunnels.' ;
  }

  feature rate-statistics {
    description 'The feature of rate statistics.' ;
    ncd:revise-date 2022-05-12 ;
  }

  feature srv6-srh-local-end-x-reduce {
    description '1.Add the leaf /configuration/segment-routing/traffic-eng/sr-policy/policy/srv6-srh-local-end-x-reduce' ;
