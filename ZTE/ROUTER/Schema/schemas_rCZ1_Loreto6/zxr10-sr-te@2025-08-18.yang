                description 'Use slice prefix on reverse path for SBFD' ;
              }

              enum encaps {
                value 1 ;
                description 'Use no slice prefix on reverse path for SBFD' ;
              }

            }

            default insert ;
            if-feature global-policy-src-bfd-encap-type ;

            ncd:revise-date 2024-01-22 ;
          }

          container policy-sbfd {
            description 'The global configuration of SR policy sbfd.When there is no sbfd configuration under the SR policy instance, use the global configuration.' ;
            leaf template-name {
              description 'The template name of SR policy sbfd.' ;
              type string {
                length 1..31 ;

              }

            }

            ncd:revise-date 2020-05-18 ;
          }

          container policy-sl-sbfd {
            description 'The global configuration of SR policy segment list sbfd.When there is no segment list sbfd configuration under the SR policy instance, use the global configuration.' ;
            leaf template-name {
              description 'The template name of SR policy segment list sbfd.' ;
              type string {
                length 1..31 ;

              }

            }

            leaf echo {
              description 'The echo configuration of SR policy segment list sbfd.' ;
              type enumeration {
                enum disabled {
                  value 0 ;
                }

                enum enabled {
                  value 1 ;
                }

              }

