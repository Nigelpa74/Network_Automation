                        description 'The value of srv6-sid.' ;
                        type ncd:ipv6-address ;

                        mandatory true ;
                      }

                      leaf path-verification {
                        description 'The configuration of srv6-path path-verification.' ;
                        type enumeration {
                          enum none {
                            value 0 ;
                          }

                          enum enabled {
                            value 1 ;
                          }

                          enum disabled {
                            value 2 ;
                          }

                        }

                        default none ;
                        ncd:revise-date 2021-09-13 ;
                      }

                      container compress {
                        presence "Configuration of compress" ;
                        leaf flavor {
                          description 'Config unified encapsulate type.' ;
                          type enumeration {
                            enum uet-32 {
                              value 1 ;
                            }

                            enum uet-128 {
                              value 2 ;
                            }

                          }

                          mandatory true ;
                        }

                        leaf block-lenth {
                          description 'The configuration of  block length.' ;
                          type uint8 {
                            range 1..128 ;

                          }

                          mandatory true ;
                        }

                        ncd:revise-date 2022-01-05 ;
                      }

                    }

                  }

                }

              }

            }

          }

          ncd:revise-date 2018-05-14 ;
        }

        container sr-tunnel {
          list tunnel {
            description 'The sr tunnel configuration list.' ;
            max-elements 131070 ;
            key tunnel-name ;
            leaf tunnel-name {
              description 'The tunnel name.' ;
              type string {
                length 10..31 ;

                pattern "te_tunnel[0-9]{1,22}" ;

              }

            }

            leaf activation {
              description 'The activation of tunnel.' ;
              type enumeration {
                enum disabled {
                  value 0 ;
                }

                enum enabled {
                  value 1 ;
                }

              }

              default enabled ;
              ncd:revise-date 2017-10-13 ;
            }

            leaf hsb-enable {
              description 'Enable hot-standby for tunnel.' ;
              type enumeration {
                enum disabled {
                  value 0 ;
                }

                enum enabled {
                  value 1 ;
                }

              }

              default disabled ;
              ncd:revise-date 2020-10-20 ;
            }

            leaf entropy-label {
              description 'Configure whether the tunnel uses entropy labels.' ;
              type empty ;

              ncd:revise-date 2019-08-09 ;
            }

            leaf destination {
              description 'The destination of tunnel.' ;
              type ncd:ipv4-address {
                pattern "([1-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5])(.([0-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5])){3}" ;

              }

            }

            leaf track-name {
              description 'The track name.' ;
              type string {
                length 1..31 ;

              }

            }

            leaf alias-name {
              description 'Configuration of tunnel alias name.' ;
              type string {
                length 1..63 ;

              }

            }

            leaf path-setup-type {
              description 'The path setup type of tunnel.' ;
              type enumeration {
                enum sr-mpls {
                  value 0 ;
                }

                enum srv6 {
                  value 1 ;
                }

              }

              default sr-mpls ;
              ncd:revise-date 2018-05-14 ;
            }

            leaf path-verification {
              description 'The configuration of tunnel path-verification.' ;
              type enumeration {
                enum none {
                  value 0 ;
                }

                enum enabled {
                  value 1 ;
                }

                enum disabled {
                  value 2 ;
                }

              }

              default none ;
              ncd:revise-date 2021-01-21 ;
            }

            leaf color {
              description 'The color of tunnel.' ;
              type uint32 {
                range 1..4294967295 ;

              }

              ncd:revise-date 2018-05-14 ;
            }

            leaf sid-algo {
              description 'The SID algorithm definition number for SR tunnel.' ;
              type uint8 {
                range 128..255 ;

              }

              ncd:revise-date 2019-12-20 ;
            }

            leaf metric-type {
              description 'The metric type of tunnel.' ;
              type enumeration {
                enum igp {
                  value 0 ;
                }

                enum delay {
                  value 1 ;
                }

                enum te {
                  value 2 ;
                }

              }

              default igp ;
              ncd:revise-date 2020-03-28 ;
            }

            leaf drop-upon-invalid {
              description 'The drop-upon-invalid of tunnel.' ;
              type enumeration {
                enum disabled {
                  value 0 ;
                }

                enum enabled {
                  value 1 ;
                }

              }

              default disabled ;
              ncd:revise-date 2020-09-18 ;
            }

            leaf qos-ineffective {
              type enumeration {
                enum enabled {
                  value 1 ;
                }

                enum disabled {
                  value 0 ;
                }

              }

              description 'Traffic shaping of QOS is ineffective.' ;
              default disabled ;
              if-feature srte-car-qos-ineff-or-unshare ;

              ncd:revise-date 2024-04-10 ;
            }

            leaf statistical-unshare {
              type enumeration {
                enum disabled {
                  value 0 ;
                }

                enum enabled {
                  value 1 ;
                }

              }

              description 'The configuration of tunnel statistical unshare.' ;
              default disabled ;
              if-feature srte-car-qos-ineff-or-unshare ;

              ncd:revise-date 2024-04-10 ;
            }

            container destination-ipv6 {
              description 'The ipv6 destination of tunnel.' ;
              leaf destination-ipv6 {
                description 'The ipv6 destination of tunnel.' ;
                type ncd:ipv6-address {
                  pattern '((:|[0-9a-fA-F]{0,4}):)([0-9a-fA-F]{0,4}:){0,5}((([0-9a-fA-F]{0,4}:)?(:|[0-9a-fA-F]{0,4}))|(((25[0-5]|2[0-4][0-9]|[01]?[0-9]?[0-9])\.){3}(25[0-5]|2[0-4][0-9]|[01]?[0-9]?[0-9])))(%[\p{N}\p{L}]+)?' ;

                  pattern '(([^:]+:){6}(([^:]+:[^:]+)|(.*\..*)))|((([^:]+:)*[^:]+)?::(([^:]+:)*[^:]+)?)(%.+)?' ;

                }

              }

              ncd:revise-date 2018-05-14 ;
            }

            container affinity {
              container main-affinity {
                description "The affinity function configuration of tunnel's master lsp." ;
                container bit-positions {
                  description 'The configuration of affinity bit position.The affinity of bit and name types is mutually exclusive.' ;
                  list bit-position {
                    description 'The configuration of affinity bit position.The affinity of bit and name types is mutually exclusive.' ;
                    max-elements 32 ;
                    key position ;
                    leaf affinity-type {
                      description 'The tunnel configuration of affinity type,exclude-any(1)/include-any(2)/include-all(3).' ;
                      type enumeration {
                        enum exclude-any {
                          value 1 ;
                          description 'Configure the exclude-any affinity.' ;
                        }

                        enum include-any {
                          value 2 ;
                          description 'Configure the include-any affinity.' ;
                        }

                        enum include-all {
                          value 3 ;
                          description 'Configure the include-all affinity.' ;
                        }

                      }

                      mandatory true ;
                    }

                    leaf position {
                      description 'The tunnel configuration of affinity bit position.' ;
                      type uint8 {
                        range 0..31 ;

                      }

                    }

                  }

                }

                container bit-names {
                  description 'The configuration of affinity name.The affinity of bit and name types is mutually exclusive.' ;
                  list bit-name {
                    description 'The configuration of affinity name.The affinity of bit and name types is mutually exclusive.' ;
                    max-elements 32 ;
                    key name ;
                    leaf affinity-type {
                      description 'The tunnel configuration of affinity type,exclude-any(1)/include-any(2)/include-all(3).' ;
                      type enumeration {
                        enum exclude-any {
                          value 1 ;
                          description 'Configure the exclude-any affinity.' ;
                        }

                        enum include-any {
                          value 2 ;
                          description 'Configure the include-any affinity.' ;
                        }

                        enum include-all {
                          value 3 ;
                          description 'Configure the include-all affinity.' ;
                        }

                      }

                      mandatory true ;
                    }

                    leaf name {
                      description 'The configuration of affinity bit name.' ;
                      type string {
                        length 1..32 ;

                      }

                    }

                  }

                }

              }

              ncd:revise-date 2019-10-12 ;
            }

            container escape-path {
              description 'configuration of escape path.' ;
              presence "configuration of escape path." ;
              leaf escape-path-enable {
                description 'Enable escape path function of the tunnel.' ;
                type enumeration {
                  enum disabled {
                    value 0 ;
                  }

                  enum enabled {
                    value 1 ;
                  }

                }

                default disabled ;
              }

              container sr-path {
                description 'The escape path of SR tunnel.' ;
                choice path-type {
                  description 'Path Selection Type.' ;
                  case name-based {
                    description 'Based on the name of the sr path selection.' ;
                    leaf name {
                      description 'The sr path name.' ;
                      type string {
                        length 1..64 ;

                      }

                      mandatory true ;
                    }

                  }

                  case id-based {
                    description 'Based on the id of the sr path selection.' ;
                    leaf id {
                      description 'The sr path ID.' ;
                      type uint16 {
                        range 1..65535 ;

                      }

                      mandatory true ;
                    }

                  }

                }

                ncd:revise-date 2020-03-04 ;
              }

              ncd:revise-date 2018-08-27 ;
            }

            container ref-hsb {
              description 'Enable backup path of a tunnel.' ;
              presence "configuration of ref-hsb" ;
              leaf ref_hsb_enable {
                description 'The tunnel setup reference to hsb enable.' ;
                type enumeration {
                  enum disabled {
                    value 0 ;
                  }

                  enum enabled {
                    value 1 ;
                  }

                }

                default disabled ;
              }

            }

            container sr-path {
              description 'The path of SR tunnel.' ;
              presence "The path of SR tunnel" ;
              list tunnel-sr-path {
                description 'The path of SR tunnel.' ;
                max-elements 262140 ;
                key path-role ;
                leaf path-role {
                  description 'The role of sr path.' ;
                  type enumeration {
                    enum master {
                      value 1 ;
                    }

                    enum slave {
                      value 2 ;
                    }

                  }

                }

                choice path-type {
                  description 'Path Selection Type.' ;
                  mandatory true ;
                  case name-based {
                    description 'Based on the name of the sr path selection.' ;
                    leaf name {
                      description 'The sr path name.' ;
                      type string {
                        length 1..64 ;

                      }

                      mandatory true ;
                    }

                  }

                  case id-based {
                    description 'Based on the id of the sr path selection.' ;
                    leaf id {
                      description 'The sr path ID.' ;
                      type uint16 {
                        range 1..65535 ;

                      }

                      mandatory true ;
                    }

                  }

                }

              }

            }

            container srv6-path {
              description 'The path of SRv6 tunnel.' ;
              list tunnel-srv6-path {
                description 'The path of SRv6 tunnel.' ;
                max-elements 262140 ;
                key path-role ;
                leaf path-role {
                  description 'The role of SRv6 path.' ;
                  type enumeration {
                    enum master {
                      value 1 ;
                    }

                    enum slave {
                      value 2 ;
                    }

                  }

                }

                leaf path-name {
                  description 'The name of SRv6 path.' ;
                  type string {
                    length 1..64 ;

                  }

                  mandatory true ;
                }

              }

              ncd:revise-date 2018-05-14 ;
            }

            container bfd {
              description 'configuration of bfd' ;
              presence "configuration of bfd" ;
              list tunnel-bfd {
                description 'BFD is set in a tunnel.' ;
                max-elements 100 ;
                key bfd-enable ;
                leaf bfd-enable {
                  description 'The tunnel BFD enable.' ;
                  type enumeration {
                    enum master {
                      value 1 ;
                    }

                    enum slave {
                      value 2 ;
                    }

                  }

                }

                choice detect-param {
                  description 'Detect param.' ;
                  mandatory true ;
                  case template {
                    description 'Bfd template name.' ;
                    leaf template-name {
                      description 'The tunnel bfd template name.' ;
                      type string {
                        length 1..31 ;

                      }

                      mandatory true ;
                    }

                    ncd:revise-date 2020-04-18 ;
                  }

                  case detect-params {
                    description 'Detect params.' ;
                    leaf min-tx-interval {
                      description 'The tunnel BFD min transmit interval.' ;
                      type uint32 {
                        range 1..65535 ;

                      }

                      units ms ;
                      mandatory true ;
                    }

                    leaf min-rx-interval {
                      description 'The tunnel BFD min receive interval.' ;
                      type uint32 {
                        range 1..65535 ;

                      }

                      units ms ;
                      mandatory true ;
                    }

                    leaf detect-multiple {
                      description 'The tunnel BFD detecting multiple.' ;
                      type uint16 {
                        range 3..50 ;

                      }

                      mandatory true ;
                    }

                  }

                }

                choice reverse-path {
                  description 'Reverse path.' ;
                  case reverse-tunnel {
                    description 'Selection reverse tunnel.' ;
                    leaf reverse-tunnelid {
                      description 'The tunnel bfd associated reverse tunnelid.' ;
                      type uint16 {
                        range 1..65535 {
                          description 'The tunnel bfd reverse tunnel id range' ;
                        }

                      }

                    }

                  }

                  case ld-rd {
                    description 'Local and Remote discriminator for BFD.' ;
                    container ld-rd {
                      description 'Local and Remote discriminator for BFD.' ;
                      presence "Local and Remote discriminator for BFD." ;
                      leaf ld {
                        description 'Local discriminator for BFD.' ;
                        type uint32 {
                          range 1..4294967295 ;

                        }

                        mandatory true ;
                      }

                      leaf rd {
                        description 'Remote discriminator for BFD.' ;
                        type uint32 {
                          range 1..4294967295 ;

                        }

                        mandatory true ;
                      }

                    }

                    ncd:revise-date 2019-08-07 ;
                  }

                  ncd:revise-date 2017-10-16 ;
                }

              }

            }

            container sbfd {
              description 'configuration of sbfd' ;
              list tunnel-sbfd {
                description 'S-BFD is set in a tunnel.' ;
                max-elements 100 ;
                key sbfd-enable ;
                leaf sbfd-enable {
                  description 'The tunnel S-BFD enable.' ;
                  type enumeration {
                    enum master {
                      value 3 ;
                    }

                    enum slave {
                      value 4 ;
                    }

                  }

                }

                choice detect-param {
                  description 'Detect param.' ;
                  mandatory true ;
                  case template {
                    description 'Bfd template name.' ;
                    leaf template-name {
                      description 'The tunnel bfd template name.' ;
                      type string {
                        length 1..31 ;

                      }

                      mandatory true ;
                    }

                    ncd:revise-date 2020-04-18 ;
                  }

                  case detect-params {
                    description 'Detect params.' ;
                    leaf min-tx-interval {
                      description 'The tunnel S-BFD min transmit interval.' ;
                      type uint32 {
                        range 1..65535 ;

                      }

                      units ms ;
                      mandatory true ;
                    }

                    leaf detect-multiple {
                      description 'The tunnel S-BFD detecting multiple.' ;
                      type uint16 {
                        range 3..50 ;

                      }

                      mandatory true ;
                    }

                  }

                }

                container reverse-path {
                  description 'The tunnel S-BFD associated reverse path.' ;
                  choice path-type {
                    description 'Path Selection Type.' ;
                    case label-based {
                      description 'Based on the label path selection.' ;
                      leaf mpls-label {
                        description 'The tunnel S-BFD associated reverse mpls label.' ;
                        type uint32 {
                          range 16..1048575 ;

                        }

                      }

                    }

                    case sr-path-id-based {
                      description 'Based on the id of the sr path selection.' ;
                      leaf sr-path-id {
                        description 'The sr path ID.' ;
                        type uint16 {
                          range 1..65535 ;

                        }

                      }

                    }

                    case sr-path-name-based {
                      description 'Based on the name of the sr path selection.' ;
                      leaf sr-path-name {
                        description 'The sr path name.' ;
                        type string {
                          length 1..64 ;

                        }

                      }

                    }

                  }

                }

              }

              ncd:revise-date 2019-05-22 ;
            }

            container path-option {
              description 'Tunnel path option configuration.' ;
              presence "Tunnel path option configuration." ;
              list tunnel-path-option {
                description 'Tunnel path option configuration.' ;
                max-elements 786420 ;
                key option-id ;
                leaf option-id {
                  description 'The number of path-option.' ;
                  type uint8 {
                    range 1..16 ;

                  }

                }

                choice path-type {
                  description 'Path Selection Type.' ;
                  mandatory true ;
                  case dynamic {
                    description 'SR Path Selection.' ;
                    leaf dynamic {
                      description 'The path type is dynamic.' ;
                      type empty ;

                      mandatory true ;
                    }

                  }

                  case explicit-name {
                    description 'Based on the name of the explicit path selection.' ;
                    leaf explicit-path-name {
                      description 'The related explicit path name.' ;
                      type string {
                        length 1..64 ;

                      }

                      mandatory true ;
                    }

                  }

                  case explicit-id {
                    description 'Id-based explicit path selection.' ;
                    leaf explicit-path-id {
                      description 'The related explicit path ID.' ;
                      type uint16 {
                        range 1..65535 ;

                      }

                      mandatory true ;
                    }

                  }

                }

              }

            }

            container hotstandby {
              description 'The configuration of hotstandby.' ;
              presence "The configuration of hotstandby." ;
              list tunnel-hotstandby {
                description 'The configuration of hotstandby.' ;
                max-elements 786420 ;
                key path-option-id ;
                leaf path-option-id {
                  description 'The attribute is the path-option which is protected.' ;
                  type uint8 {
                    range 1..16 ;

                  }

                }

                choice path-type {
                  description 'To assign path type of backup lsp. Three types.' ;
                  mandatory true ;
                  case dynamic {
                    description 'Dynamic Path Selection.' ;
                    leaf dynamic {
                      description 'The path type is dynamic.' ;
                      type empty ;

                      mandatory true ;
                    }

                    leaf prefer {
                      description "If this attribute is configured, the backup path only can't be completely duplicated with primary path, otherwise the backup path must be different from primary path." ;
                      type boolean ;

                      default false ;
                    }

                  }

                  case explicit-id {
                    description 'Id-based explicit path selection.' ;
                    leaf explicit-path-id {
                      description 'The configured explicit path ID.' ;
                      type uint16 {
                        range 1..65535 ;

                      }

                      mandatory true ;
                    }

                    leaf id-exclude {
                      description 'This attribute can be used to indicate whether backup path need exclude primary path strictly.' ;
                      type boolean ;

                      default false ;
                    }

                  }

                  case explicit-name {
                    description 'Based on the name of the explicit path selection.' ;
                    leaf explicit-path-name {
                      description 'The configured explicit path name.' ;
                      type string {
                        length 1..64 ;

                      }

                      mandatory true ;
                    }

                    leaf name-exclude {
                      description 'This attribute can be used to indicate whether backup path need exclude primary path strictly.' ;
                      type boolean ;

                      default false ;
                    }

                  }

                }

              }

            }

            container link-limit {
              description 'The maximum of link.' ;
              presence "configuration of hop-limit" ;
              leaf link-limit-num {
