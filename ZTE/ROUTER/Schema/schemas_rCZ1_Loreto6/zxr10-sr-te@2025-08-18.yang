    description 'Configure sbfd of segment-list under candidate-path.' ;
    ncd:revise-date 2022-04-21 ;
  }

  feature ttl-mode {
    description 'The feature of TTL mode.' ;
    ncd:revise-date 2022-06-08 ;
  }

  feature sr_policy_rate_limit {
    ncd:revise-date 2022-06-28 ;
  }

  feature sr-policy-group {
    description 'The feature of SR policy group.' ;
    ncd:revise-date 2023-01-16 ;
  }

  feature sr-policy-forwarding {
    ncd:revise-date 2023-03-27 ;
  }

  feature template-policy-group {
    ncd:revise-date 2023-02-14 ;
  }

  feature src-slice-id {
    ncd:revise-date 2023-01-30 ;
  }

  feature sr-bandwidth-support-64t {
    ncd:revise-date 2023-06-17 ;
  }

  feature static-sr-tnnl-match-dscp {
    ncd:revise-date 2023-09-16 ;
  }

  typedef rsvp-rate-unit-type {
    description 'The definition of rate unit of st-te car info, see below:
    kbps  (1) Kilobits per second
    mbps  (2) Megabits per second
    gbps  (3) Gigabits per second' ;
    type enumeration {
      enum kbps {
        value 1 ;
        description 'Kilobits per second' ;
      }

      enum mbps {
        value 2 ;
        description 'Megabits per second' ;
      }

      enum gbps {
        value 3 ;
        description 'Gigabits per second' ;
      }

    }

  }

  feature global-policy-src-bfd-encap-type {
    ncd:revise-date 2024-01-22 ;
  }

  feature srte-car-qos-ineff-or-unshare {
    ncd:revise-date 2024-04-10 ;
  }

  feature sr-policy-auto-route {
    description 'The feature of SR policy auto route.' ;
    ncd:revise-date 2024-12-17 ;
  }

  feature decrease-priority-time {
    description 'Time of tunnel decrease priority time' ;
    ncd:revise-date 2025-01-02 ;
  }
  feature bsid-delay {
    ncd:revise-date 2025-07-18 ;
  }

  container state {
    config false ;
    description 'The branch of SR tunnel data model.' ;
    container sr-tunnel {
      description 'The SR tunnel information.' ;
      list tunnel {
        description 'The SR tunnel list.' ;
        key tunnel-id ;
        leaf tunnel-id {
          description 'The tunnel ID.' ;
          type uint16 ;

        }

        leaf ingress-id {
          description 'The ingress LSR ID.' ;
          type ncd:ipv4-address ;

        }

        leaf egress-id {
          description 'The egress LSR ID.' ;
          type ncd:ipv4-address ;

        }

        leaf v6-ingress-id {
          description 'The ingress v6 LSR ID.' ;
          type ncd:ipv6-address ;

          ncd:revise-date 2020-09-11 ;
        }

        leaf v6-egress-id {
          description 'The egress v6 LSR ID.' ;
          type ncd:ipv6-address ;

          ncd:revise-date 2020-09-11 ;
        }

        leaf oper-status {
          description 'The operation status of tunnel.' ;
          type enumeration {
            enum unknown {
              value 0 ;
            }

            enum up {
              value 1 ;
            }

            enum down {
              value 2 ;
            }

            enum wtr {
              value 4 ;
            }

          }

        }

        leaf master-lsp-id {
          description 'The master lsp identifier.' ;
          type uint16 ;

        }

        leaf slave-lsp-id {
          description 'The lsp identifier of slave.' ;
          type uint16 ;

        }

        leaf hsb-status {
          description 'The hsb status of tunnel.' ;
          type enumeration {
            enum none {
              value 0 ;
            }

            enum ready {
              value 1 ;
            }

            enum active {
              value 2 ;
            }

          }

        }

        leaf master-splice-label {
          description 'The master splice label.' ;
          type uint32 ;

        }

        leaf slave-splice-label {
          description 'The splice label of slave.' ;
          type uint32 ;

        }

      }

      container tunnel-sr-path {
        description 'The path of segment-routing tunnel LSP.' ;
        list sr-path-hop {
          description 'The hop of segment routing path.' ;
          key 'tunnel-id lsp-role hop-index' ;
          leaf tunnel-id {
            description 'The tunnel ID.' ;
            type uint16 ;

          }

          leaf lsp-role {
            description "The lsp role of tunnel,it's behalf of master while the value is 1 ,it's behalf of backup while the value is 2." ;
            type enumeration {
              enum master {
                value 1 ;
              }

              enum slave {
                value 2 ;
              }

            }

          }

          leaf hop-index {
            description 'The index of sr-path hop.' ;
            type uint16 ;

          }

          leaf lsp-id {
            description 'The lsp identifier.' ;
            type uint16 ;

          }

          leaf sid-type {
            description 'The sid type.' ;
            type enumeration {
              enum default {
                value 0 ;
              }

              enum node-id-v4 {
                value 1 ;
              }

              enum node-id-v6 {
                value 2 ;
              }

              enum adj-id-v4 {
                value 3 ;
              }

              enum adj-id-v6 {
                value 4 ;
              }

              enum unnum-adj-id-v4 {
                value 5 ;
              }

              enum srv6-sid {
                value 14 ;
              }

              enum srv6-node-id {
                value 18 ;
              }

              enum srv6-adj-id {
                value 19 ;
              }

              enum srv6-link-local {
                value 20 ;
              }

            }

          }

          leaf sid-val {
            description 'The sid value.' ;
            type uint32 ;

          }

          leaf node-ip {
            description 'The node IP.' ;
            type ncd:ipv4-address ;

          }

          leaf adj-local-rid {
            description 'The local router id of adjacency.' ;
            type ncd:ipv4-address ;

          }

          leaf adj-local-ip {
            description 'The local ip of adjacency.' ;
            type ncd:ipv4-address ;

          }

          leaf adj-local-id {
            description 'The local ID of adjacency.' ;
            type uint32 ;

            ncd:revise-date 2019-07-09 ;
          }

          leaf adj-peer-rid {
            description 'The peer router id of adjacency.' ;
            type ncd:ipv4-address ;

          }

          leaf adj-peer-ip {
            description 'The peer ip of adjacency.' ;
            type ncd:ipv4-address ;

          }

          leaf adj-peer-id {
            description 'The peer ID of adjacency.' ;
            type uint32 ;

            ncd:revise-date 2019-07-09 ;
          }

          leaf srv6-sid {
            description 'The SRv6 sid value.' ;
            type ncd:ipv6-address ;

            ncd:revise-date 2020-09-11 ;
          }

          leaf v6-node-ip {
            description 'The node IPv6 address.' ;
            type ncd:ipv6-address ;

            ncd:revise-date 2020-09-11 ;
          }

          leaf v6-adj-local-ip {
            description 'The local IPv6 address of adjacency.' ;
            type ncd:ipv6-address ;

            ncd:revise-date 2020-09-11 ;
          }

          leaf v6-local-id {
            description 'The local ID of v6 adjacency.' ;
            type uint32 ;

            ncd:revise-date 2020-09-11 ;
          }

          leaf v6-adj-peer-ip {
            description 'The peer IPv6 address of adjacency.' ;
            type ncd:ipv6-address ;

            ncd:revise-date 2020-09-11 ;
          }

          leaf v6-peer-id {
            description 'The peer ID of v6 adjacency.' ;
            type uint32 ;

            ncd:revise-date 2020-09-11 ;
          }

        }

      }

    }

    container static-sr {
      description 'The static SR tunnels information.' ;
      container resource {
        description 'The resource statistics of static SR tunnels.' ;
        container tunnel-perf-switch {
          description 'The number of static SR tunnels which can be turned on performance statistics switch.' ;
          leaf configured {
            description 'The number of static SR tunnels which have turned on performance statistics switch.' ;
            type uint32 ;

          }

          leaf remainder-sum {
            description 'The number of remainder static SR tunnels which can be turned on performance statistics switch.' ;
            type uint32 ;

          }

        }

      }

      container static-tunnel {
        description 'The static SR tunnels information.' ;
        list tunnel {
          description 'The static SR tunnel list.' ;
          key tunnel-id ;
          leaf tunnel-id {
            description 'The tunnel ID.' ;
            type uint32 ;

          }

          leaf associated-status {
            description 'The associated status of tunnel.' ;
            type enumeration {
              enum disabled {
                value 1 ;
              }

              enum unbound {
                value 2 ;
              }

              enum bound {
                value 3 ;
              }

            }

          }

        }

        ncd:revise-date 2020-04-10 ;
      }

      ncd:revise-date 2018-03-26 ;
    }

    container sr-policy {
      description 'The SR policy information.' ;
      container traffic-statistics {
        description 'The traffic statistics information of SR policy.' ;
        list policy {
          description 'The SR policy list.' ;
          key 'color end-point' ;
          leaf color {
            description 'The color.' ;
            type uint32 ;

          }

          leaf end-point {
            description 'The address of end-point.' ;
            type string {
              length 1..45 ;

            }

          }

          leaf in-bytes {
            description 'The number of inbound bytes.' ;
            type uint64 ;

          }

          leaf in-packets {
            description 'The number of inbound packets.' ;
            type uint64 ;

          }

          leaf e-bytes {
            description 'The number of exporting bytes.' ;
            type uint64 ;

          }

          leaf e-packets {
            description 'The number of exporting packets.' ;
            type uint64 ;

          }

          leaf e-bit-rate {
            description 'The rate of exporting bits.' ;
            type uint64 ;

            ncd:revise-date 2020-12-03 ;
          }

          leaf e-packet-rate {
            description 'The rate of exporting packets.' ;
            type uint64 ;

            ncd:revise-date 2020-12-03 ;
          }

          leaf policy-name {
            description 'The name of policy.' ;
            type string {
              length 1..63 ;

            }

            ncd:revise-date 2023-07-09 ;
          }

        }

      }

      container policy-down-reason {
        description 'The last down reason of SR policy.' ;
        list policy {
          key 'color end-point' ;
          description 'The SR policy list.' ;
          leaf color {
            type uint32 ;

            description 'The color.' ;
          }

          leaf end-point {
            type string ;

            description 'The address of end-point.' ;
          }

          leaf down-reason {
            type ncd:string-with-blank ;

            description 'The down-reason of SR Policy.' ;
          }

          container cp-bgp-s {
            list cp-bgp {
              leaf disc {
                type uint32 ;

              }

              list sl {
                leaf cfg-index {
                  type uint8 ;

                  description 'The index.' ;
                }

                leaf down-reason {
                  type ncd:string-with-blank ;

                  description 'The sl down reason.' ;
                }

                key cfg-index ;
                description 'The segment-list.' ;
              }

              key disc ;
              description 'The bgp candidate-path.' ;
              ncd:select disc ;
            }

          }

          container cp-cli-s {
            list cp-cli {
              leaf preference {
                type uint32 ;

                description 'The preference.' ;
              }

              list sl {
                leaf cfg-index {
                  type uint8 ;

                  description 'The index.' ;
                }

                leaf down-reason {
                  type ncd:string-with-blank ;

                  description 'The sl down reason.' ;
                }

                key cfg-index ;
                description 'The segment-list.' ;
              }

              key preference ;
              description 'The config candidate-path.' ;
            }

          }

          container cp-pcep-s {
            list cp-pcep {
              leaf as-num {
                type uint32 ;

                description 'The as num.' ;
              }

              leaf disc {
                type uint32 ;

                description 'The disc.' ;
              }

              leaf org-addr {
                type string ;

                description 'The org addr.' ;
              }

              list sl {
                leaf cfg-index {
                  type uint8 ;

                  description 'The index.' ;
                }

                leaf down-reason {
                  type ncd:string-with-blank ;

                  description 'The sl down reason.' ;
                }

                key cfg-index ;
                description 'The segment-list.' ;
              }

              key 'as-num disc org-addr' ;
              description 'The pcep candidate-path.' ;
              ncd:select "as-num disc org-addr" ;
            }

          }

          ncd:select "color end-point" ;
        }

        ncd:revise-date 2023-07-06 ;
      }

      list policy {
        description 'The SR policy list.' ;
        key 'color end_point' ;
        leaf color {
          type uint32 ;

          description 'The color of SR Policy.' ;
        }

        leaf end_point {
          type string ;

          description 'The address of SR Policy.' ;
        }

        leaf name {
          type string ;

          description 'The name of SR Policy.' ;
        }

        leaf mpls-label {
          type uint32 ;

        }

        leaf srv6-bsid {
          type ncd:ipv6-address ;

          description 'The bsid of SR Policy.' ;
        }

        leaf state {
          type enumeration {
            enum up {
              value 1 ;
            }

            enum down {
              value 0 ;
            }

            enum sd {
              value 2 ;
            }

          }

          description 'The state of SR Policy. When the policy can forward traffic, the value is set to TRUE.' ;
        }

        container candidate-paths {
          list candidate-path {
            description 'The candidate-path list.' ;
            key 'discriminator org_addr org_as prot_org' ;
            leaf discriminator {
              type uint32 ;

              description 'The discriminator of candidate path.' ;
            }

            leaf org_addr {
              type string ;

              description 'The org addr of candidate path.' ;
            }

            leaf org_as {
              type uint32 ;

              description 'The org as of candidate path.' ;
            }

            leaf prot_org {
              type enumeration {
                enum PCEP {
                  value 10 ;
                }

                enum BGP {
                  value 20 ;
                }

                enum CONFIG {
                  value 30 ;
                }

              }

              description 'The prot org of candidate path.' ;
            }

            leaf preference {
              type uint32 ;

              description 'The preference of candidate path.' ;
            }

            leaf name {
              type string ;

              description 'The name of candidate path.' ;
            }

            leaf active {
              type boolean ;

              description 'The availability of candidate path. True when it is active cp.' ;
            }

            leaf state {
              type enumeration {
                enum up {
                  value 1 ;
                }

                enum down {
                  value 0 ;
                }

                enum sd {
                  value 2 ;
                }

              }

              description 'The state of candidate path. True when available.' ;
            }

            container segment-lists {
              list segment-list {
                leaf sl_id {
                  type uint32 ;

                  description 'The unique id of sl.' ;
                }

                leaf weight {
                  type uint32 ;

                  description 'The weight of sl.' ;
                }

                leaf state {
                  type enumeration {
                    enum up {
                      value 3 ;
                    }

                    enum down {
                      value 4 ;
                    }

                    enum sd {
                      value 5 ;
                    }

                  }

                  description 'The state of sl. True when available.' ;
                }

                description 'The segment-list lists.' ;
                key sl_id ;
                container sids {
                  list sid {
                    key index ;
                    leaf index {
                      type uint32 ;

                    }

                    leaf mpls-label {
                      type uint32 ;

                    }

                    leaf srv6-sid {
                      type ncd:ipv6-address ;

                    }

                  }

                }

                container next-hops {
                  list next-hop {
                    key index ;
                    leaf index {
                      type uint32 ;

                    }

                    leaf ip_address {
                      type string ;

                    }

                  }

                }

                ncd:select sl_id ;
              }

              description 'The segment-lists information.' ;
            }

            ncd:select "discriminator org_addr org_as prot_org" ;
          }

          description 'The candidate-paths information.' ;
        }

        ncd:select "color end_point" ;
      }

      ncd:revise-date 2020-09-01 ;
    }

    container segment-list {
      description 'The segment-list information.' ;
      container sl-traffic-statistics {
        description 'The traffic statistics information of segment-list.' ;
        list sl {
          description 'The segment list.' ;
          key sl_id ;
          leaf sl_id {
            description 'The id.' ;
            type uint32 ;

          }

          leaf sl_index {
            description 'The index.' ;
            type uint32 ;

          }

          leaf color {
            description 'The color.' ;
            type uint32 ;

          }

          leaf end-point {
            description 'The address of end-point.' ;
            type string {
              length 1..45 ;

            }

          }

          leaf e-bytes {
            description 'The number of exporting bytes.' ;
            type uint64 ;

          }

          leaf e-packets {
            description 'The number of exporting packets.' ;
            type uint64 ;

          }

          leaf e-bit-rate {
            description 'The rate of exporting bits.' ;
            type uint64 ;

          }

          leaf e-packet-rate {
            description 'The rate of exporting packets.' ;
            type uint64 ;

          }

        }

      }

      ncd:revise-date 2023-05-04 ;
    }

  }

  container configuration {
    description 'The branch of configuration model.' ;
    container segment-routing {
      description 'The configuration of segment-routing.' ;
      container traffic-eng {
        description 'Traffic engineering.' ;
        leaf te-enable {
          description 'The global switch of segment-routing traffic-eng.' ;
          type enumeration {
            enum disabled {
              value 0 ;
            }

            enum enabled {
              value 1 ;
            }

          }

          default disabled ;
        }

        leaf bfd-affect-enable {
          description 'Enable BFD status affect tunnel creation.' ;
          type enumeration {
            enum disabled {
              value 0 ;
            }

            enum enabled {
              value 1 ;
            }

          }

          default disabled ;
          ncd:revise-date 2018-11-19 ;
        }

        leaf bfd-create-timeout {
          description 'Configure BFD creation timeout in seconds.' ;
          type uint16 {
            range 10..3600 ;

          }

          units second ;
          ncd:revise-date 2018-11-19 ;
        }

        leaf hsb-policy {
          description 'The configuration of policy hot-standby.' ;
          type enumeration {
            enum disabled {
              value 0 ;
            }

            enum enabled {
              value 1 ;
            }

          }

          default disabled ;
          ncd:revise-date 2020-03-19 ;
        }

        leaf entropy-label {
          description 'The configuration of global entropy-label.' ;
          type enumeration {
            enum disabled {
              value 0 ;
            }

            enum enabled {
              value 1 ;
            }

          }

          default disabled ;
          ncd:revise-date 2021-08-16 ;
        }

        leaf path-verification {
          description 'The configuration of global path-verification.' ;
          type enumeration {
            enum disabled {
              value 0 ;
            }

            enum enabled {
              value 1 ;
            }

            enum enabled-all {
              value 3 ;
            }

          }

          default disabled ;
          ncd:revise-date 2021-01-21 ;
        }

        leaf policy-traffic-statistics {
          description 'Enable or disable SR policy traffic statistics.' ;
          type enumeration {
            enum disabled {
              value 0 ;
            }

            enum enabled {
              value 1 ;
            }

          }

          default disabled ;
          ncd:revise-date 2020-03-26 ;
        }

        leaf path-uninterrupt-time {
          description 'Configure uninterrupted time for path change.' ;
          type uint16 {
            range 0..3600 ;

          }

          units second ;
          default 2 ;
          ncd:revise-date 2020-04-18 ;
        }

        leaf load-sharing {
          description 'Load sharing.' ;
          type enumeration {
            enum per-stream {
              value 1 ;
            }

            enum per-packet {
              value 2 ;
            }

            enum dlb {
              value 3 ;
            }

            enum per-stream-enhanced-mode {
              value 4 ;
            }

          }

