              description 'The pce initiate function of dynamic tunnel.' ;
              presence "pce initiate of dynamic tunnel" ;
              leaf pce-init-enable {
                status deprecated ;

                description 'Enable PCE init of a tunnel.' ;
                type enumeration {
                  enum disabled {
                    value 0 ;
                  }

                  enum enabled {
                    value 1 ;
                  }

                }

                default disabled ;
              }

            }

            container pce-control {
              status deprecated ;

              description 'The pce control function of dynamic tunnel.' ;
              presence "pce control of dynamic tunnel" ;
              leaf pce-control-enable {
                status deprecated ;

                description 'Enable PCE control of a tunnel.' ;
                type enumeration {
                  enum disabled {
                    value 0 ;
                  }

                  enum enabled {
                    value 1 ;
                  }

                }

                default disabled ;
              }

              leaf pce-control-addr {
                status deprecated ;

                description 'Pce control address.' ;
                type ncd:ipv4-address {
                  pattern "([1-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5])(.([0-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5])){3}" ;

                }

                ncd:revise-date 2018-08-29 ;
              }

              leaf pce-control-addr-ipv6 {
                status deprecated ;

                description 'IPv6 pce control address.' ;
                type ncd:ipv6-address {
                  pattern "([0-9a-fA-F]{1,4}:){7}([0-9a-fA-F]{0,4})$|^([0-9a-fA-F]{1,4}:){1,6}(:[0-9a-fA-F]{0,4}){1,6}$|^([:]{2})(([0-9a-fA-F]{1,4}:){0,6})([0-9a-fA-F]{1,4})$|^([0-9a-fA-F]{1,4}:){6}([0-9]{1,3}.){3}([0-9]{1,3})$|^([0-9a-fA-F]{1,4}:){1,5}(:[0-9a-fA-F]{0,4}){1,5}([0-9]{1,3}.){3}([0-9]{1,3})$|^([:]{2})(([0-9a-fA-F]{1,4}:){0,5})([0-9]{1,3}.){3}([0-9]{1,3})" ;

                }

                ncd:revise-date 2018-11-23 ;
              }

            }

            container pce {
              description 'configuration of pce.' ;
              container slave-name {
                description 'Configuration of tunnel slave name.' ;
                leaf slave-name {
                  description 'Configuration of tunnel slave name.' ;
                  type string {
                    length 1..63 ;

                  }

                }

                ncd:revise-date 2020-10-20 ;
              }

              choice pce-type {
                description 'Pce Selection Type.' ;
                case pce-init {
                  description 'The pce initiate function of dynamic tunnel.' ;
                  container pce-init-cfg {
                    description 'The pce init function of dynamic tunnel.' ;
                    leaf pce-init-enable {
                      description 'Enable PCE init of a tunnel.' ;
                      type empty ;

                    }

                  }

                }

                case pce-control {
                  description 'The pce control function of dynamic tunnel.' ;
                  container pce-control-cfg {
                    description 'The pce control function of dynamic tunnel.' ;
                    presence "pce control of dynamic tunnel" ;
                    leaf pce-control-enable {
                      description 'Enable PCE control of a tunnel.' ;
                      type empty ;

                    }

                    container control-addr {
                      description 'the PCE control address.' ;
                      choice addr-type {
                        description 'Specify the PCE control address type.' ;
                        case ipv4 {
                          description 'IPv4 address type.' ;
                          leaf pce-control-addr {
                            description 'Pce control address.' ;
                            type ncd:ipv4-address {
                              pattern "([1-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5])(.([0-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5])){3}" ;

                            }

                          }

                        }

                        case ipv6 {
                          description 'IPv6 address type.' ;
                          leaf pce-control-addr-ipv6 {
                            description 'IPv6 pce control address.' ;
                            type ncd:ipv6-address {
                              pattern "([0-9a-fA-F]{1,4}:){7}([0-9a-fA-F]{0,4})$|^([0-9a-fA-F]{1,4}:){1,6}(:[0-9a-fA-F]{0,4}){1,6}$|^([:]{2})(([0-9a-fA-F]{1,4}:){0,6})([0-9a-fA-F]{1,4})$|^([0-9a-fA-F]{1,4}:){6}([0-9]{1,3}.){3}([0-9]{1,3})$|^([0-9a-fA-F]{1,4}:){1,5}(:[0-9a-fA-F]{0,4}){1,5}([0-9]{1,3}.){3}([0-9]{1,3})$|^([:]{2})(([0-9a-fA-F]{1,4}:){0,5})([0-9]{1,3}.){3}([0-9]{1,3})" ;

                            }

                          }

                        }

                      }

                    }

                  }

                }

              }

              ncd:revise-date 2020-02-14 ;
            }

            container srv6-binding-sid {
              description 'The configuration of SRv6 binding sid.' ;
              choice srv6-bsid-type {
                description 'To assign the type of SRv6 binding sid. Two types.' ;
                case auto {
                  status obsolete {
                    ncd:revise-date 2020-06-25 ;
                  }

                  description 'Auto SRv6 binding sid.' ;
                  leaf auto {
                    status obsolete {
                      ncd:revise-date 2020-06-25 ;
                    }

                    description 'The type is auto.' ;
                    type empty ;

                  }

                }

                case static {
                  description 'static SRv6 binding sid.' ;
                  leaf static_srv6_bsid {
                    description 'The type is static.' ;
                    type ncd:ipv6-address ;

                  }

                }

              }

              ncd:revise-date 2018-05-14 ;
            }

            container auto-route {
              description 'configuration of auto-route.' ;
              presence "configuration of auto-route" ;
              leaf ar-enable {
                description 'The tunnel auto route switch.' ;
                type enumeration {
                  enum disabled {
                    value 0 ;
                  }

                  enum enabled {
                    value 1 ;
                  }

                }

                default disabled ;
              }

              leaf ar-metric-type {
                description 'Auto route metric type.' ;
                type enumeration {
                  enum igp {
                    value 0 ;
                  }

                  enum absolute {
                    value 2 ;
                  }

                  enum relative {
                    value 3 ;
                  }

                }

                default igp ;
              }

              leaf ar-relative-metric {
                description 'The relative metric of AR,it is relative to IGP metric.' ;
                type int32 {
                  range -10..10 ;

                }

                default 0 ;
              }

              leaf ar-absolute-metric {
                description 'The absolute metric of AR.' ;
                type uint32 {
                  range 1..4294967295 ;

                }

              }

              leaf ar-include-ipv6 {
                description 'The tunnel auto route ipv6 enable.' ;
                type enumeration {
                  enum disabled {
                    value 0 ;
                  }

                  enum enabled {
                    value 1 ;
                  }

                }

                default disabled ;
                ncd:revise-date 2018-11-02 ;
              }

              ncd:revise-date 2018-10-15 ;
            }

            leaf reoptimize {
              description 'Specify SR tunnel whether to open the timing re-optimization.' ;
              type empty ;

              ncd:revise-date 2019-02-15 ;
            }

            leaf reopt-hsb-lsp {
              description 'Enable hsb-lsp auto-reoptimize.' ;
              type empty ;

              ncd:revise-date 2019-02-15 ;
            }

            leaf flow-statistics {
              description 'The switch of SR tunnel flow statistics.' ;
              type enumeration {
                enum disabled {
                  value 0 ;
                }

                enum enabled {
                  value 1 ;
                }

              }

              default disabled ;
              ncd:revise-date 2019-06-13 ;
            }

            container bandwidth {
              description 'The SR tunnel bandwidth.' ;
              presence "SR tunnel bandwidth allocation." ;
              leaf bandwidth {
                description 'The SR tunnel bandwidth configuration.' ;
                type uint32 {
                  range 1..4294967295 ;

                }

                units kbps ;
                mandatory true ;
              }

              leaf unit {
                description 'The SR tunnel bandwidth unit configuration, such as kbps, mbps, gbps.' ;
                type rsvp-rate-unit-type ;

                if-feature sr-bandwidth-support-64t ;

                ncd:revise-date 2023-06-17 ;
              }

              ncd:revise-date 2019-07-19 ;
            }

            container match-dscp {
              description 'Configure match DSCP value.' ;
              presence "match DSCP value." ;
              container ipv4 {
                description 'IPv4' ;
                presence IPv4 ;
                choice ipv4 {
                  description 'IPv4' ;
                  case value {
                    description 'Configure DSCP value.' ;
                    leaf value {
                      description 'Configure DSCP value in range mode, support single DSCP value or range(max num:32;spacing mark:,) in <0-63>. For example,"1,3-5,10,20-30",etc.The DSCP values of different color in the same policy group cannot overlap.' ;
                      type ncd:range {
                        pattern "(((([0-9]|[1-5][0-9]|6[0-3])-([0-9]|[1-5][0-9]|6[0-3]))|([0-9]|[1-5][0-9]|6[0-3]))(,((([0-9]|[1-5][0-9]|6[0-3])-([0-9]|[1-5][0-9]|6[0-3]))|([0-9]|[1-5][0-9]|6[0-3]))){0,31})" ;

                      }

                    }

                  }

                  case default {
                    leaf default {
                      description 'The default SR policy. For the same address type in the same policy group, only one color can be configured with default.' ;
                      type empty ;

                    }

                  }

                }

              }

              container ipv6 {
                description 'IPv6' ;
                presence IPv6 ;
                choice ipv6 {
                  description 'IPv6' ;
                  case value {
                    description 'Configure DSCP value.' ;
                    leaf value {
                      description 'Configure DSCP value in range mode, support single DSCP value or range(max num:32;spacing mark:,) in <0-63>. For example,"1,3-5,10,20-30",etc.The DSCP values of different color in the same policy group cannot overlap.' ;
                      type ncd:range {
                        pattern "(((([0-9]|[1-5][0-9]|6[0-3])-([0-9]|[1-5][0-9]|6[0-3]))|([0-9]|[1-5][0-9]|6[0-3]))(,((([0-9]|[1-5][0-9]|6[0-3])-([0-9]|[1-5][0-9]|6[0-3]))|([0-9]|[1-5][0-9]|6[0-3]))){0,31})" ;

                      }

                    }

                  }

                  case default {
                    leaf default {
                      description 'The default SR policy. For the same address type in the same policy group, only one color can be configured with default.' ;
                      type empty ;

                    }

                  }

                }

              }

              ncd:revise-date 2021-12-23 ;
            }

            leaf reserved-for-binding {
              description 'Enable the reserved-for-binding function of a tunnel.' ;
              type enumeration {
                enum disabled {
                  value 0 ;
                }

                enum enabled {
                  value 1 ;
                }

              }

              default disabled ;
              ncd:revise-date 2022-11-08 ;
            }

            leaf decrease-priority-time {
              type uint16 {
                range 0..600 ;

              }

              description 'Time of tunnel decrease priority time.' ;
              default 0 ;
              if-feature decrease-priority-time ;

              ncd:revise-date 2025-01-02 ;
            }

          }

        }

        container static-sr {
          description 'The static SR tunnel configuration.' ;
          list static-tunnel {
            description 'The static SR tunnel configuration list.' ;
            max-elements 131070 ;
            key tunnel-name ;
            leaf tunnel-name {
              description 'The tunnel name.' ;
              type string {
                length 10..31 ;

                pattern "te_tunnel[0-9]{1,22}" ;

              }

            }

            leaf activation {
              description 'The activation of tunnel.' ;
              type enumeration {
                enum disabled {
                  value 0 ;
                }

                enum enabled {
                  value 1 ;
                }

              }

              default enabled ;
              ncd:revise-date 2018-03-26 ;
            }

            leaf color {
              description 'The color of tunnel.' ;
              type uint32 {
                range 1..4294967295 ;

              }

              ncd:revise-date 2021-04-20 ;
            }

            leaf compress-num {
              if-feature static-sr-tunnel-compress-num ;

              description 'The number of compressed tunnels.' ;
              type uint16 {
                range 1..32768 ;

              }

              ncd:revise-date 2021-07-14 ;
            }

            leaf netconf-get-compress-num {
              if-feature static-sr-tunnel-netconf-get-compress-num ;

              description 'The number of compressed tunnels when netconf get.' ;
              type uint16 {
                range 1..32768 ;

              }

              ncd:revise-date 2021-07-14 ;
            }

            leaf path-verification {
              description 'The configuration of tunnel path-verification.' ;
              type enumeration {
                enum none {
                  value 0 ;
                }

                enum enabled {
                  value 1 ;
                }

                enum disabled {
                  value 2 ;
                }

              }

              default none ;
              ncd:revise-date 2021-01-21 ;
            }

            leaf performance-switch {
              description 'The switch of tunnel performance statistics.' ;
              type enumeration {
                enum off {
                  value 0 ;
                }

                enum on {
                  value 1 ;
                }

              }

              default off ;
              ncd:revise-date 2018-03-26 ;
            }

            leaf safe-reoptimize {
              description 'The configuration of tunnel safe-reoptimize.' ;
              type enumeration {
                enum disabled {
                  value 0 ;
                }

                enum enabled {
                  value 1 ;
                }

              }

              default disabled ;
              ncd:revise-date 2021-07-09 ;
            }

            leaf track-name {
              description 'The track name.' ;
              type string {
                length 1..31 ;

              }

              ncd:revise-date 2018-11-14 ;
            }

            container role-type {
              description 'The tunnel role and direction type.' ;
              presence "Configure tunnel role and type." ;
              leaf role {
                description 'The static SR tunnel role including ingress,transit and egress.' ;
                type enumeration {
                  enum ingressNode {
                    value 1 ;
                  }

                  enum transitNode {
                    value 2 ;
                  }

                  enum egressNode {
                    value 3 ;
                  }

                }

                mandatory true ;
              }

              leaf direction-type {
                description 'The static SR tunnel direction type including unidirectional and bidirectional.' ;
                type enumeration {
                  enum bidirectional {
                    value 2 ;
                  }

                  enum unidirectional {
                    value 1 ;
                  }

                }

                mandatory true ;
              }

            }

            container triple {
              description 'The tunnel triple elements.' ;
              presence "Configure tunnel triple." ;
              leaf ingress-tunnel-id {
                description 'The ingress tunnel ID,it is used to locate ingress tunnel. This attribute is determined by product.' ;
                type uint32 {
                  range 1..264192 ;

                }

                mandatory true ;
              }

              choice ip-type {
                description 'The type of triple elements address.' ;
                mandatory true ;
                case ipv4 {
                  description 'IPv4 address.' ;
                  leaf ingress-id {
                    description 'The ingress route ID.' ;
                    type ncd:ipv4-address ;

                    mandatory true ;
                  }

                  leaf egress-id {
                    description 'The egress route ID.' ;
                    type ncd:ipv4-address ;

                    mandatory true ;
                  }

                }

                case ipv6 {
                  description 'IPv6 address.' ;
                  leaf ingress-ipv6-id {
                    description 'The ingress IPv6 route ID.' ;
                    type ncd:ipv6-address ;

                    mandatory true ;
                  }

                  leaf egress-ipv6-id {
                    description 'The egress IPv6 route ID.' ;
                    type ncd:ipv6-address ;

                    mandatory true ;
                  }

                  ncd:revise-date 2019-01-02 ;
                }

              }

            }

            container pce-control {
              description 'The tunnel pce control function.' ;
              leaf pce-control-enable {
                description 'Enable tunnel PCE control.' ;
                type enumeration {
                  enum enabled {
                    value 1 ;
                  }

                  enum disabled {
                    value 0 ;
                  }

                }

                default disabled ;
              }

              ncd:revise-date 2018-12-28 ;
            }

            container lsps {
              description 'The configured lsp of static SR tunnel.' ;
              list lsp {
                description 'Lsp list.' ;
                max-elements 1 ;
                key lsp-id ;
                leaf lsp-id {
                  description "The tunnel's lsp ID." ;
                  type uint16 {
                    range 1 ;

                  }

                }

                container positive-in-label {
                  description 'The positive in-label of static SR tunnel.' ;
                  presence "Configure positive in-label" ;
                  leaf in-label {
                    description 'The positive in-label.' ;
                    type uint32 {
                      range 16..1048575 ;

                    }

                    mandatory true ;
                  }

                }

                container positive-out-label {
                  description 'The positive out-label of static SR tunnel.' ;
                  presence "Configure positive out-label" ;
                  leaf out-label {
                    description 'The positive out-label.' ;
                    type uint32 {
                      range 16..1048575 ;

                    }

                    mandatory true ;
                  }

                }

                container reverse-in-label {
                  description 'The reverse in-label of static SR tunnel.' ;
                  presence "Configure reverse in-label" ;
                  leaf rvs-in-label {
                    description 'The reverse in-label.' ;
                    type uint32 {
                      range 16..1048575 ;

                    }

                    mandatory true ;
                  }

                }

                container reverse-out-label {
                  description 'The reverse out-label of static SR tunnel.' ;
                  presence "Configure reverse out-label" ;
                  leaf rvs-out-label {
                    description 'The reverse out-label.' ;
                    type uint32 {
                      range 16..1048575 ;

                    }

                    mandatory true ;
                  }

                }

                container positive-sr-path {
                  description 'The positive path of static SR tunnel.' ;
                  presence "Configure positive path" ;
                  choice sr-path {
                    description 'The positive path type of static SR tunnel.' ;
                    mandatory true ;
                    case id {
                      description 'The positive path ID of static SR tunnel.' ;
                      leaf path-id {
                        description 'The ID of path.' ;
                        type uint16 {
                          range 1..65535 ;

                        }

                        mandatory true ;
                      }

                    }

                    case name {
                      description 'The positive path name of static SR tunnel.' ;
                      leaf path-name {
                        description 'The name of path.' ;
                        type string {
                          length 1..64 ;

                        }

                        mandatory true ;
                      }

                    }

                  }

                }

                container reserve-sr-path {
                  description 'The reserve path of static SR tunnel.' ;
                  presence "Configure reserve path" ;
                  choice rvs-sr-path {
                    description 'The reserve path type of static SR tunnel.' ;
                    mandatory true ;
                    case rvs-id {
                      description 'The reserve path ID of static SR tunnel.' ;
                      leaf rvs-path-id {
                        description 'The ID of reserve path.' ;
                        type uint16 {
                          range 1..65535 ;

                        }

                        mandatory true ;
                      }

                    }

                    case rvs-name {
                      description 'The reserve path name of static SR tunnel.' ;
                      leaf rvs-path-name {
                        description 'The name of reserve path.' ;
                        type string {
                          length 1..64 ;

                        }

                        mandatory true ;
                      }

                    }

                  }

                }

              }

            }

            leaf flow-statistics {
              description 'The switch of static SR tunnel flow statistics.' ;
              type enumeration {
                enum disabled {
                  value 0 ;
                }

                enum enabled {
                  value 1 ;
                }

              }

              default disabled ;
              ncd:revise-date 2019-06-13 ;
            }

            container srv6-binding-sid {
              description 'The configuration of SRv6 binding sid.' ;
              choice srv6-bsid-type {
                description 'To assign the type of SRv6 binding SID.' ;
                case static {
                  description 'Static type of SRv6 binding SID.' ;
                  leaf static_srv6_bsid {
                    description 'The type is static.' ;
                    type ncd:ipv6-address ;

                  }

                }

              }

              ncd:revise-date 2021-11-08 ;
            }

            container match-dscp {
              container ipv4 {
                choice ipv4 {
                  case value {
                    leaf value {
                      description 'Configure DSCP value in range mode, support single DSCP value or range(max num:32;spacing mark:,) in <0-63>. For example,"1,3-5,10,20-30",etc.' ;
                      type ncd:range {
                        pattern "(((([0-9]|[1-5][0-9]|6[0-3])-([0-9]|[1-5][0-9]|6[0-3]))|([0-9]|[1-5][0-9]|6[0-3]))(,((([0-9]|[1-5][0-9]|6[0-3])-([0-9]|[1-5][0-9]|6[0-3]))|([0-9]|[1-5][0-9]|6[0-3]))){0,31})" ;

                      }

                    }

                    description 'DSCP value.' ;
                  }

                  case default {
                    leaf default {
                      type empty ;

                      description 'Configure the default mapping rule.' ;
                    }

                    description 'Default.' ;
                  }

                  description 'IPv4' ;
                }

                presence IPv4 ;
                description 'IPv4' ;
              }

              container ipv6 {
                choice ipv6 {
                  case value {
                    leaf value {
                      description 'Configure DSCP value in range mode, support single DSCP value or range(max num:32;spacing mark:,) in <0-63>. For example,"1,3-5,10,20-30",etc.' ;
                      type ncd:range {
                        pattern "(((([0-9]|[1-5][0-9]|6[0-3])-([0-9]|[1-5][0-9]|6[0-3]))|([0-9]|[1-5][0-9]|6[0-3]))(,((([0-9]|[1-5][0-9]|6[0-3])-([0-9]|[1-5][0-9]|6[0-3]))|([0-9]|[1-5][0-9]|6[0-3]))){0,31})" ;

                      }

                    }

                    description 'DSCP value.' ;
                  }

                  case default {
                    leaf default {
                      type empty ;

                      description 'Configure the default mapping rule.' ;
                    }

                    description 'Default.' ;
                  }

                  description 'IPv6' ;
                }

                presence IPv6 ;
                description 'IPv6' ;
              }

              presence "match DSCP value." ;
              description 'Configure match DSCP value.' ;
              if-feature static-sr-tnnl-match-dscp ;

              ncd:revise-date 2023-09-16 ;
            }

          }

          ncd:revise-date 2018-02-13 ;
        }

        container sr-policy {
          description 'Configuration of sr policy.' ;
          presence "Configuration of sr policy" ;
          list policy {
            description 'The SR policy configuration list.' ;
            max-elements 16384 ;
            key policy-name ;
            leaf policy-name {
              description 'The policy name.' ;
              type string {
                length 1..63 ;

              }

            }

            leaf path-setup-type {
              description 'The path setup type of policy.' ;
              type enumeration {
                enum sr-mpls {
                  value 0 ;
                }

                enum srv6 {
                  value 1 ;
                }

              }

              default sr-mpls ;
              ncd:revise-date 2019-11-01 ;
            }

            leaf drop-upon-invalid {
              description 'The drop-upon-invalid of policy.' ;
              type enumeration {
                enum disabled {
                  value 0 ;
                }

                enum enabled {
                  value 1 ;
                }

              }

              default disabled ;
            }

            leaf entropy-label {
              description 'The configuration of policy entropy-label.' ;
              type enumeration {
                enum none {
                  value 0 ;
                }

                enum enabled {
                  value 1 ;
                }

                enum disabled {
                  value 2 ;
                }

              }

              default none ;
              ncd:revise-date 2021-08-16 ;
            }

            leaf hsb-policy {
              description 'The configuration of policy hot-standby.' ;
              type enumeration {
                enum none {
                  value 0 ;
                }

                enum enabled {
                  value 1 ;
                }

                enum disabled {
                  value 2 ;
                }

              }

              default none ;
              ncd:revise-date 2020-03-19 ;
            }

            leaf path-verification {
              description 'The configuration of policy path-verification.' ;
              type enumeration {
                enum none {
                  value 0 ;
                }

                enum enabled {
                  value 1 ;
                }

                enum disabled {
                  value 2 ;
                }

                enum enabled-all {
                  value 3 ;
                }

              }

              default none ;
              ncd:revise-date 2021-01-21 ;
            }

            leaf traffic-statistics {
              description 'The traffic statistics of policy.' ;
              type enumeration {
                enum enabled {
                  value 1 ;
                }

                enum disabled {
                  value 2 ;
                }

              }

              ncd:revise-date 2020-03-26 ;
            }

            leaf load-sharing {
              description 'Load sharing of SR policy.' ;
              type enumeration {
                enum null {
                  value 0 ;
                }

                enum per-stream {
                  value 1 ;
                }

                enum per-packet {
                  value 2 ;
                }

                enum dlb {
                  value 3 ;
                }

                enum per-stream-enhanced-mode {
                  value 4 ;
                }

              }

              ncd:revise-date 2020-05-28 ;
            }

            leaf sid-algo {
              description 'The SID algorithm definition number for SR policy.' ;
              type uint8 {
                range 128..255 ;

              }

              ncd:revise-date 2021-01-21 ;
            }

            leaf slice-id {
              description 'The slice ID for SR policy.' ;
              type uint32 {
                range 1..65535 ;

              }

              ncd:revise-date 2021-09-27 ;
            }

            leaf srv6-compress {
              description 'Configure SRv6 compress of policy.Enable means to enable SRv6 compress, disable means to disable SRv6 compress, and none is the default value of SRv6 compress, which means that this parameter is not configured. When this parameter is not configured, show running-config segment does not display the SRv6 compress configuration.' ;
              type enumeration {
                enum none {
                  value 0 ;
                  description 'The default value of SRv6 compress is none, which means that the SRv6 compress parameter is not configured.' ;
                }

                enum enable {
                  value 1 ;
                  description 'Enable SRv6 compress parameter.' ;
                }

                enum disable {
                  value 2 ;
                  description 'disable SRv6 compress parameter.' ;
                }

              }

              default none ;
              ncd:revise-date 2021-06-11 ;
            }

            leaf srv6-bsid-encaps-type {
              description 'The configuration of SRv6 binding sid encapsulation-type.' ;
              type enumeration {
                enum encaps {
                  value 1 ;
                }

                enum insert {
                  value 2 ;
                }

                enum encaps-reduce {
                  value 3 ;
                }

                enum insert-reduce {
                  value 4 ;
                }

              }

              default encaps ;
              ncd:revise-date 2021-12-29 ;
            }

            leaf unactive-sl-sbfd-template-name {
              description 'The template name of unactive segment-list sbfd' ;
              type string {
                length 1..31 ;

              }

              ncd:revise-date 2022-03-23 ;
            }

            leaf srv6-srh-reduce {
              if-feature srv6-srh-reduce ;

              description 'The configuration of SRv6 SRH reduce.' ;
              type enumeration {
                enum none {
                  value 0 ;
                  description 'The default value of srv6-srh-reduce is none, which means that the srv6-srh-reduce parameter is not configured.' ;
                }

                enum enable {
                  value 1 ;
                  description 'srv6-srh-reduce enable' ;
                }

                enum disable {
                  value 2 ;
                  description 'srv6-srh-reduce disable' ;
                }

              }

              default none ;
              ncd:revise-date 2022-04-21 ;
            }

            leaf srv6-srh-local-end-x-reduce {
              if-feature srv6-srh-local-end-x-reduce ;

              description 'The configuration of SRH reduce local-end.x.' ;
              type enumeration {
                enum none {
                  value 0 ;
                  description 'The default value of srv6-srh-local-end-x-reduce is none, which means that the srv6-srh-local-end-x-reduce parameter is not configured.' ;
                }

                enum enable {
                  value 1 ;
                  description 'srv6-srh-local-end-x-reduce enable' ;
                }

                enum disable {
                  value 2 ;
                  description 'srv6-srh-local-end-x-reduce disable' ;
                }

              }

              default none ;
              ncd:revise-date 2022-04-21 ;
            }

            leaf max-install-cpaths {
              description 'Configure the number of standby candidate paths' ;
              type uint8 {
                range 1..2 ;

              }

              ncd:revise-date 2022-08-16 ;
            }

            leaf srv6-locator-name {
              description 'SRv6 locator name.' ;
              type string {
                length 1..31 ;

              }

              ncd:revise-date 2022-09-15 ;
            }

            leaf no-bypass {
              description 'Configure no-bypass flag in all packets over the policy' ;
              type enumeration {
                enum enabled {
                  value 1 ;
                }

                enum disabled {
                  value 2 ;
                }

              }

              ncd:revise-date 2022-12-26 ;
            }

            leaf bfd-no-bypass {
              description 'Configure no-bypass flag in BFD packets over the policy' ;
              type enumeration {
                enum enabled {
                  value 1 ;
                }

                enum disabled {
                  value 2 ;
                }

              }

              ncd:revise-date 2022-12-26 ;
            }

            leaf forwarding {
              if-feature sr-policy-forwarding ;

              description 'Configure the switch of forwarding for the SR policy.' ;
              type enumeration {
                enum enabled {
                  value 1 ;
                }

                enum disabled {
                  value 0 ;
                }

              }

              default enabled ;
              ncd:revise-date 2023-03-27 ;
            }

            leaf ipv6-source-prefix {
              description 'Configure the source slice prefix name for candidate-path.' ;
              type string {
                length 1..63 ;

              }

              ncd:revise-date 2023-11-15 ;
            }

            container end-point {
              description 'Configuration of policy color and end-point.' ;
              presence "Configuration of policy color and end-point." ;
              leaf color {
                description 'The color of policy.' ;
                type uint32 {
                  range 1..4294967295 ;

                }

                mandatory true ;
              }

              choice address-type {
                description 'Address Selection Type.' ;
                mandatory true ;
                case ipv4 {
                  description 'Configration ipv4 type of the end-point.' ;
                  leaf end-point-v4 {
                    description 'The ipv4 address of end-point.' ;
                    type ncd:ipv4-address {
                      pattern "([1-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5])(.([0-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5])){3}" ;

                    }

                    mandatory true ;
                  }

                }

                case ipv6 {
                  description 'Configration ipv6 type of the end-point.' ;
                  leaf end-point-v6 {
                    description 'The ipv6 address of end-point.' ;
                    type ncd:ipv6-address {
                      pattern '((:|[0-9a-fA-F]{0,4}):)([0-9a-fA-F]{0,4}:){0,5}((([0-9a-fA-F]{0,4}:)?(:|[0-9a-fA-F]{0,4}))|(((25[0-5]|2[0-4][0-9]|[01]?[0-9]?[0-9])\.){3}(25[0-5]|2[0-4][0-9]|[01]?[0-9]?[0-9])))(%[\p{N}\p{L}]+)?' ;

                      pattern '(([^:]+:){6}(([^:]+:[^:]+)|(.*\..*)))|((([^:]+:)*[^:]+)?::(([^:]+:)*[^:]+)?)(%.+)?' ;

                    }

                    mandatory true ;
                  }

                }

              }

            }

            container srv6-binding-sid {
              description 'The configuration of SRv6 binding sid.' ;
              choice srv6-bsid-type {
                description 'To assign the type of SRv6 binding sid. Two types.' ;
                case auto {
                  status obsolete {
                    ncd:revise-date 2020-06-25 ;
                  }

                  description 'Auto SRv6 binding sid.' ;
                  leaf auto {
                    status obsolete {
                      ncd:revise-date 2020-06-25 ;
                    }

                    description 'The type is auto.' ;
                    type empty ;

                  }

                }

                case static {
                  description 'static SRv6 binding sid.' ;
                  leaf static_srv6_bsid {
                    description 'The type is static.' ;
                    type ncd:ipv6-address ;

                  }

                }

                case dynamic {
                  description 'Automatic generation of SRv6 binding sid.' ;
                  leaf dynamic {
                    description 'Automatic generation of SRv6 binding sid.' ;
                    type enumeration {
                      enum auto {
                        value 1 ;
                        description 'Automatic generation of SRv6 binding sid.' ;
                      }

                    }

                  }

                  ncd:revise-date 2020-11-17 ;
                }

              }

              ncd:revise-date 2020-05-28 ;
            }

            container ipv6-diffserv-mode {
              description 'The configuration of SRv6 policy differentiated service mode.' ;
              choice mode {
                description 'The mode, including uniform-phb, uniform-non-phb and pipe.' ;
                case uniform-phb-mode {
                  description 'The uniform PHB mode.' ;
                  leaf uniform-phb {
                    description 'The uniform PHB mode, inheriting PHB.' ;
                    type empty ;

                    mandatory true ;
                  }

                  ncd:revise-date 2020-12-21 ;
                }

                case uniform-non-phb-mode {
                  description 'The uniform non-PHB mode.' ;
                  leaf uniform-non-phb {
                    description 'The uniform non-PHB mode, L2VPN inherits 802.1P and L3VPN inherits DSCP.' ;
                    type empty ;

                    mandatory true ;
                  }

                  ncd:revise-date 2020-12-21 ;
                }

                case pipe-mode {
                  description 'The pipe mode.' ;
                  leaf pipe {
                    description 'The pipe mode.' ;
                    type empty ;

                    mandatory true ;
                  }

                  leaf dscp-value {
                    description 'DSCP value.' ;
                    type uint8 {
                      range 0..63 ;

                    }

                    mandatory true ;
                  }

                }

                case pipe-serv {
                  description 'Mapping rules of service-class type under pipe mode.' ;
                  leaf service-class {
                    description 'Local scheduling priority.' ;
                    type enumeration {
                      enum be {
                        value 1 ;
                        description 'Best effort.' ;
                      }

                      enum af1 {
                        value 2 ;
                        description 'Assured forwarding class 1.' ;
                      }

                      enum af2 {
                        value 3 ;
                        description 'Assured forwarding class 2.' ;
                      }

                      enum af3 {
                        value 4 ;
                        description 'Assured forwarding class 3.' ;
                      }

                      enum af4 {
                        value 5 ;
                        description 'Assured forwarding class 4.' ;
                      }

                      enum ef {
                        value 6 ;
                        description 'Expedited forward.' ;
                      }

                      enum cs6 {
                        value 7 ;
                        description 'Internetwork control service class.' ;
                      }

                      enum cs7 {
                        value 8 ;
                        description 'Network control service class.' ;
                      }

                    }

                    mandatory true ;
                  }

                  leaf color {
                    description 'Local drop priority.' ;
                    type enumeration {
                      enum green {
                        value 1 ;
                        description 'Green packets.' ;
                      }

                      enum yellow {
                        value 2 ;
                        description 'Yellow packets.' ;
                      }

                      enum red {
                        value 3 ;
                        description 'Red packets.' ;
                      }

                    }

                    mandatory true ;
                  }

                  ncd:revise-date 2023-03-16 ;
                }

              }

              ncd:revise-date 2020-11-23 ;
            }

            container sbfd {
              description 'Configuration of policy sbfd.' ;
              choice sbfd-conf {
                description 'Whether to enable segment list sbfd.' ;
                case enable {
                  description 'Enable policy sbfd.' ;
                  leaf template-name {
                    description 'The template name of sbfd.' ;
                    type string {
                      length 1..31 ;

                    }

                    mandatory true ;
                  }

                  container reverse-path {
                    description 'The S-BFD associated reverse path.' ;
                    choice path-type {
                      description 'Path Selection Type.' ;
                      case mpls-label {
                        description 'The S-BFD associated reverse mpls label.' ;
                        leaf mpls-label {
                          description 'The S-BFD associated reverse mpls label.' ;
                          type uint32 {
                            range 16..1048575 ;

                          }

                        }

                      }

                      case srv6-sid {
                        description 'The S-BFD associated reverse SRv6 SID.' ;
                        leaf srv6-sid {
                          description 'The S-BFD associated reverse SRv6 SID.' ;
                          type ncd:ipv6-address ;

                        }

                        ncd:revise-date 2020-11-27 ;
                      }

                    }

                    ncd:revise-date 2020-06-06 ;
                  }

                }

                case disable {
                  description 'Disable policy sbfd.' ;
                  leaf disable {
                    description 'Disable policy sbfd.' ;
                    type empty ;

                    mandatory true ;
                  }

                }

              }

              ncd:revise-date 2020-05-18 ;
            }

            container segment-list-sbfd {
              description 'Configuration of policy segment list sbfd.' ;
              choice sbfd-conf {
                description 'Whether to enable segment list sbfd.' ;
                case enable {
                  description 'Enable policy segment list sbfd.' ;
                  leaf template-name {
                    description 'The template name of sbfd.' ;
                    type string {
                      length 1..31 ;

                    }

                    mandatory true ;
                  }

                  leaf echo {
                    description 'The echo configuration of SR policy segment list sbfd.' ;
                    type enumeration {
                      enum disabled {
                        value 0 ;
                      }

                      enum enabled {
                        value 1 ;
                      }

                    }

                    default disabled ;
                    ncd:revise-date 2021-03-17 ;
                  }

                }

                case disable {
                  description 'Disable policy segment list sbfd.' ;
                  leaf disable {
                    description 'Disable policy segment list sbfd.' ;
                    type empty ;

                    mandatory true ;
                  }

                }

              }

              ncd:revise-date 2020-04-07 ;
            }

            container candidate-path {
              description 'The configuration of policy candidate-path.' ;
              list cp {
                description 'The configuration list of SR policy candidate-path.' ;
                max-elements 16 ;
                key preference ;
                leaf preference {
                  description 'The candidate-path preference.' ;
                  type uint32 {
                    range 0..4294967295 ;

                  }

                }

                leaf path-type {
                  description 'The path type of candidate-path.' ;
                  type enumeration {
                    enum explicit {
                      value 0 ;
                    }

                    enum dynamic {
                      value 1 ;
                    }

                  }

                  default explicit ;
                  ncd:revise-date 2020-06-28 ;
                }

                leaf metric-type {
                  description 'The metric type of candidate-path.' ;
                  type enumeration {
                    enum igp {
                      value 0 ;
                    }

                    enum delay {
                      value 1 ;
                    }

                    enum te {
                      value 2 ;
                    }

                  }

                  default igp ;
                  ncd:revise-date 2020-06-28 ;
                }

                container cp-source-slice {
                  description 'Configuration of the source slice under the candidate-path mode of segment routing.' ;
                  presence "Configuration of candidate-path source slice." ;
                  leaf slice-id {
                    description 'The source slice ID of candidate-path.' ;
                    type uint32 {
                      range 1..2147483647 ;

                    }

                    mandatory true ;
                    ncd:revise-date 2024-04-28 ;
                  }

                  leaf strict-mode {
                    description 'The handle mode of candidate-path source slice.' ;
                    type enumeration {
                      enum disabled {
                        value 0 ;
                      }

                      enum enabled {
                        value 1 ;
                      }

                    }

                    default disabled ;
                  }

                  ncd:revise-date 2023-11-15 ;
                }

                container pce-delegate {
                  description 'The pce delegate function of candidate path.' ;
                  leaf enable {
                    description 'Delegate candidate path to PCE.' ;
                    type empty ;

                  }

                  container pce-addr {
                    description 'The PCE delegate address.' ;
                    choice addr-type {
                      description 'Specify the PCE address type.' ;
                      case ipv4 {
                        description 'IPv4 address type.' ;
                        leaf pce-addr-ipv4 {
                          description 'PCE IPv4 address.' ;
                          type ncd:ipv4-address {
                            pattern "([1-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5])(.([0-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5])){3}" ;

                          }

                        }

                      }

                      case ipv6 {
                        description 'IPv6 address type.' ;
                        leaf pce-addr-ipv6 {
                          description 'PCE IPv6 address.' ;
                          type ncd:ipv6-address {
                            pattern "([0-9a-fA-F]{1,4}:){7}([0-9a-fA-F]{0,4})$|^([0-9a-fA-F]{1,4}:){1,6}(:[0-9a-fA-F]{0,4}){1,6}$|^([:]{2})(([0-9a-fA-F]{1,4}:){0,6})([0-9a-fA-F]{1,4})$|^([0-9a-fA-F]{1,4}:){6}([0-9]{1,3}.){3}([0-9]{1,3})$|^([0-9a-fA-F]{1,4}:){1,5}(:[0-9a-fA-F]{0,4}){1,5}([0-9]{1,3}.){3}([0-9]{1,3})$|^([:]{2})(([0-9a-fA-F]{1,4}:){0,5})([0-9]{1,3}.){3}([0-9]{1,3})" ;

                          }

                        }

                      }

                    }

                  }

                  ncd:revise-date 2021-01-21 ;
                }

                container segment-list {
                  description 'The configuration of policy segment-list.' ;
                  list sl {
                    description 'The configuration list of SR policy segment-list.' ;
                    max-elements 16384 ;
                    key index ;
                    leaf index {
                      description 'The segment-list index.' ;
                      type uint8 {
                        range 1..255 ;

                      }

                    }

                    leaf weight {
                      description 'The segment-list weight.' ;
                      type uint32 {
                        range 1..4294967295 ;

                      }

                      default 1 ;
                    }

                    choice sl-path-type {
                      description 'Path Selection Type.' ;
                      case sr-path {
                        description 'The segment-list type is sr-path.' ;
                        container sr-path {
                          description 'The segment-list sr-path.' ;
                          choice path-type {
                            description 'Path Selection Type.' ;
                            case name-based {
                              description 'Based on the name of the sr path selection.' ;
                              leaf sr-path-name {
                                description 'The sr path name.' ;
                                type string {
                                  length 1..64 ;

                                }

                                mandatory true ;
                              }

                            }

                            case id-based {
                              description 'Based on the id of the sr path selection.' ;
                              leaf sr-path-id {
                                description 'The sr path ID.' ;
                                type uint16 {
                                  range 1..65535 ;

                                }

                                mandatory true ;
                              }

                            }

                          }

                        }

                      }

                      case srv6-path {
                        description 'The segment-list type is srv6-path.' ;
                        container srv6-path {
                          description 'The segment-list srv6-path.' ;
                          presence srv6-path ;
                          leaf srv6-path-name {
                            description 'The srv6 path name.' ;
                            type string {
                              length 1..64 ;

                            }

                            mandatory true ;
                          }

                        }

                        ncd:revise-date 2019-11-01 ;
                      }

                    }

                    container mpls-binding-sid {
                      description 'The configuration of MPLS binding SID.' ;
                      choice mpls-bsid-type {
                        description 'To assign the type of MPLS binding SID.' ;
                        case static {
                          description 'Static type of MPLS binding SID.' ;
                          leaf static_mpls_bsid {
                            description 'The configuration of static MPLS binding SID.' ;
                            type uint32 {
                              range 16..1048575 ;

                            }

                            mandatory true ;
                          }

                        }

                      }

                      ncd:revise-date 2021-07-19 ;
                    }

                    container reverse-path {
                      description 'The sbfd associated reverse path.' ;
                      choice path-type {
                        description 'Path Selection Type.' ;
                        case srv6-sid {
                          description 'The sbfd associated reverse SRv6 SID.' ;
                          leaf srv6-sid {
                            description 'The sbfd associated reverse SRv6 SID.' ;
                            type ncd:ipv6-address ;

                          }

                        }

                        case mpls-label {
                          description 'The sbfd associated reverse MPLS label.' ;
                          leaf mpls-label {
                            description 'The sbfd associated reverse MPLS label.' ;
                            type uint32 {
                              range 16..1048575 ;

                            }

                          }

                          ncd:revise-date 2021-07-19 ;
                        }

                        case srv6-xsid {
                          leaf srv6-xsid {
                            description 'The sbfd associated reverse SRv6 XSID.' ;
                            type ncd:ipv6-address ;

                          }

                          description 'The sbfd associated reverse SRv6 XSID.' ;
                          ncd:revise-date 2023-12-20 ;
                        }

                      }

                      ncd:revise-date 2021-03-17 ;
                    }

                    container srv6-binding-sid {
                      description 'The configuration of SRv6 binding SID.' ;
                      choice srv6-bsid-type {
                        description 'To assign the type of SRv6 binding SID.' ;
                        case static {
                          description 'Static type of SRv6 binding SID.' ;
                          leaf static_srv6_bsid {
                            description 'The configuration of static SRv6 binding SID.' ;
                            type ncd:ipv6-address ;

                          }

                        }

                      }

                      ncd:revise-date 2021-03-17 ;
                    }

                    leaf path-mtu {
                      description 'The configuration of segment list path MTU.' ;
                      type uint16 {
                        range 1280..9600 ;

                      }

                      units bytes ;
                      ncd:revise-date 2022-02-11 ;
                    }

                    container srv6-x-sid {
                      choice srv6-x-type {
                        case static {
                          leaf static_srv6_x_sid {
                            type ncd:ipv6-address ;

                            description 'The configuration of static SRv6 X SID.' ;
                          }

                          description 'Static type of SRv6 X SID.' ;
                        }

                        description 'To assign the type of SRv6 X SID.' ;
                      }

                      description 'The configuration of SRv6 X SID.' ;
                      ncd:revise-date 2023-12-20 ;
                    }

                  }

                }

                container affinity {
                  description 'The affinity function configuration of candidate-path.' ;
                  list bit-position {
                    description 'The configuration of affinity bit position.' ;
                    max-elements 32 ;
                    key position ;
                    leaf affinity-type {
                      description 'The configuration of affinity type,exclude-any(1)/include-any(2)/include-all(3).' ;
                      type enumeration {
                        enum exclude-any {
                          value 1 ;
                          description 'Configure the exclude-any affinity.' ;
                        }

                        enum include-any {
                          value 2 ;
                          description 'Configure the include-any affinity.' ;
                        }

                        enum include-all {
                          value 3 ;
                          description 'Configure the include-all affinity.' ;
                        }

                      }

                      mandatory true ;
                    }

                    leaf position {
                      description 'The configuration of affinity bit position.' ;
                      type uint16 {
                        range 0..31 ;

                      }

                    }

                  }

                  ncd:revise-date 2020-06-28 ;
                }

                container cspf-force-igp {
                  description 'Force IGP of the candidate path.' ;
                  presence "cspf force igp" ;
                  choice igp-type {
                    description 'IGP type.' ;
                    case force-ospf {
                      description 'Force OSPF.' ;
                      leaf ospf {
                        description 'Force OSPF.' ;
                        type empty ;

                        mandatory true ;
                      }

                      container ospf-process {
                        description 'Force OSPF process.' ;
                        presence "force ospf process" ;
                        leaf process-id {
                          description 'Force OSPF process ID.' ;
                          type uint32 ;

                          mandatory true ;
                        }

                        container ospf-area {
                          description 'Force OSPF area.' ;
                          presence "force ospf area" ;
                          leaf area-id {
                            description 'Force OSPF area ID.' ;
                            type ncd:ipv4-address ;

                            mandatory true ;
                          }

                        }

                      }

                    }

                    case force-isis {
                      description 'Force ISIS.' ;
                      leaf isis {
                        description 'Force ISIS.' ;
                        type empty ;

                        mandatory true ;
                      }

                      container isis-process {
                        description 'Force ISIS process.' ;
                        presence "force isis process" ;
                        leaf process-id {
                          description 'Force ISIS process ID.' ;
                          type uint32 ;

                          mandatory true ;
                        }

                        container isis-level {
                          description 'Force ISIS level.' ;
                          presence "force isis level" ;
                          leaf isis-level {
                            description 'Force ISIS level.' ;
                            type enumeration {
                              enum level-1 {
                                value 1 ;
                              }

                              enum level-2 {
                                value 2 ;
                              }

                            }

                            mandatory true ;
                          }

                        }

                      }

                    }

                  }

                  ncd:revise-date 2021-03-01 ;
                }

              }

            }

            container rate-statistics {
              if-feature rate-statistics ;

              description 'Describe the parameters of policy rate count to be configured.' ;
              leaf period {
                description 'The policy rate count period.
Rate period which is a multiple of 10 (seconds).' ;
                type uint32 {
                  range 10..600 ;

                }

                units seconds ;
              }

              ncd:revise-date 2022-05-12 ;
            }

            container cp-sl-sbfd {
              if-feature cp-sl-sbfd ;

              description 'Configure sbfd of segment-list under candidate-path.' ;
              list cp-sl-sbfd {
                max-elements 16 ;
                key preference ;
                leaf preference {
                  description 'The candidate-path preference.' ;
                  type uint32 {
                    range 0..4294967295 ;

                  }

                }

                leaf template-name {
                  description 'The template name of sbfd.' ;
                  type string {
                    length 1..31 ;

                  }

                }

              }

              ncd:revise-date 2022-04-21 ;
            }

            container ttl-mode {
              description 'The configuration of policy TTL mode.' ;
              choice mode {
                description 'The mode.' ;
                case pipe-mode {
                  description 'The pipe mode.' ;
                  leaf pipe {
                    description 'The pipe mode.' ;
                    type empty ;

                    mandatory true ;
                  }

                  leaf ttl-value {
                    description 'Pipe TTL value' ;
                    type uint8 {
                      range 1..255 ;

                    }

                    default 255 ;
                    ncd:revise-date 2022-10-25 ;
                  }

                }

                case uniform-mode {
                  description 'The uniform mode.' ;
                  leaf uniform {
                    description 'The uniform mode.' ;
                    type empty ;

                    mandatory true ;
                  }

                }

              }

              ncd:revise-date 2022-06-08 ;
            }

            container rate-limit {
              if-feature sr_policy_rate_limit ;

              description 'Configuration of the rate limit under the policy mode of segment routing' ;
              presence rate-limit-display ;
              leaf mode {
                description 'The policy rate limit mode.' ;
                type enumeration {
                  enum blind {
                    value 1 ;
                  }

                  enum aware {
                    value 2 ;
                  }

                }

                mandatory true ;
              }

              leaf cir {
                description 'CIR.' ;
                type uint32 {
                  range 0..4294967295 {
                    description 'The minimum value may be greater than 0, and the maximum value may be less than 4294967295, depending on the system.' ;
                  }

                }

                units kbps ;
                mandatory true ;
              }

              leaf cbs {
                description 'CBS.' ;
                type uint32 {
                  range 1..4294967295 {
                    description 'The minimum value may be greater than 1, and the maximum value may be less than 4294967295, depending on the system.' ;
                  }

                }

                units KB ;
                mandatory true ;
              }

              leaf pir {
                description 'PIR.' ;
                type uint32 {
                  range 1..4294967295 {
                    description 'The minimum value may be greater than 1, and the maximum value may be less than 4294967295, depending on the system.' ;
                  }

                }

                units kbps ;
                mandatory true ;
              }

              leaf pbs {
                description 'PBS.' ;
                type uint32 {
                  range 1..4294967295 {
                    description 'The minimum value may be greater than 1, and the maximum value may be less than 4294967295, depending on the system.' ;
                  }

                }

                units KB ;
                mandatory true ;
              }

              ncd:revise-date 2022-06-28 ;
            }

            container source-slice {
              if-feature src-slice-id ;

              description 'Configuration of the source slice under the policy mode of segment routing' ;
              presence "Configuration of sr policy source slice" ;
              leaf src-slice-id {
                description 'The source slice ID for policy.' ;
                type uint32 {
                  range 1..2147483647 ;

                }

                mandatory true ;
                ncd:revise-date 2024-04-28 ;
              }

              leaf slice-prefix {
                description 'The source slice prefix name of policy' ;
                type string {
                  length 1..63 ;

                }

                mandatory true ;
              }

              leaf strict-mode {
                description 'Configure the handle mode' ;
                type enumeration {
                  enum disabled {
                    value 0 ;
                  }

                  enum enabled {
                    value 1 ;
                  }

                }

                default disabled ;
              }

              ncd:revise-date 2023-01-30 ;
            }

            container auto-route {
              leaf ar-enable {
                type enumeration {
                  enum disabled {
                    value 0 ;
                  }

                  enum enabled {
                    value 1 ;
                  }

                }

                description 'The sr policy auto route switch.' ;
              }

              presence "configuration of auto-route." ;
              description 'configuration of auto-route.' ;
              choice ar-metric-type {
                case ar-relative-metric {
                  leaf ar-relative-metric {
                    type int32 {
                      range -10..10 ;

                    }

                    description 'The relative metric of AR,it is relative to IGP metric.' ;
                    ncd:revise-date 2023-11-03 ;
                  }

                }

                case ar-absolute-metric {
                  leaf ar-absolute-metric {
                    type uint32 {
                      range 1..4294967295 ;

                    }

                    description 'The absolute metric of AR.' ;
                    ncd:revise-date 2023-11-03 ;
                  }

                }

              }

              if-feature sr-policy-auto-route {
                ncd:revise-date 2024-12-17 ;
              }

              ncd:revise-date 2023-10-21 ;
            }

          }

          ncd:revise-date 2019-06-22 ;
        }

        container mbb {
          leaf cleanup-delay-time {
            description 'Configure cleanup delay time.' ;
            type uint16 {
              range 0..600 ;

            }

            units second ;
            default 15 ;
          }

          leaf installation-delay-time {
            description 'Configure installation delay time.' ;
            type uint16 {
              range 0..3600 ;

            }

            units second ;
            default 10 ;
          }

          ncd:revise-date 2018-07-02 ;
        }

        container policy-class {
          description "The configuration of SR tunnel's policy class." ;
          list classes {
            description 'The value of policy-class(<0-7> and 255).
The default value of policy-class is 255.

The policy-class range of 0 and 7 and 255 cannot be existed the same time.
For example 1, if we set the value 0 and 255 at the same time (255 behind), the final value is 255.
For example 2, if we set the value 255 and 0 at the same time (0 behind ), the final value is 0.
For example 3, if we set the value 0, 255, 1 and 3 at the same time the final value is 1 and 3.' ;
            key 'tnnl-name class' ;
            leaf tnnl-name {
              description 'The tunnel name.' ;
              type ncd:ifname ;

            }

            leaf class {
              description 'The value of policy class.' ;
              type uint8 ;

            }

          }

          ncd:revise-date 2018-09-25 ;
        }

        container tnnl-rate-limit {
          description 'The configuration of tunnel rate limit.' ;
          presence "configuration of tnnl-rate-limit" ;
          list tunnel {
            description 'The configuration list of tunnel rate limit.' ;
            max-elements 131072 ;
            key tunnel-name ;
            leaf tunnel-name {
              description 'The tunnel name' ;
              type ncd:ifname ;

            }

            leaf mode {
              description 'The tunnel rate limit mode.' ;
              type enumeration {
                enum blind {
                  value 1 ;
                }

                enum aware {
                  value 2 ;
                }

              }

              mandatory true ;
            }

            leaf cir {
              description 'CIR.' ;
              type uint32 {
                range 0..4294967295 {
                  description 'The minimum value may be greater than 0, and the maximum value may be less than 4294967295, depending on the system.' ;
                }

              }

              units kbps ;
              mandatory true ;
            }

            leaf cbs {
              description 'CBS.' ;
              type uint32 {
                range 1..4294967295 {
                  description 'The minimum value may be greater than 1, and the maximum value may be less than 4294967295, depending on the system.' ;
                }

              }

              units KB ;
              mandatory true ;
            }

            leaf pir {
              description 'PIR.' ;
              type uint32 {
                range 1..4294967295 {
                  description 'The minimum value may be greater than 1, and the maximum value may be less than 4294967295, depending on the system.' ;
                }

              }

              units kbps ;
              mandatory true ;
            }

            leaf pbs {
              description 'PBS.' ;
              type uint32 {
                range 1..4294967295 {
                  description 'The minimum value may be greater than 1, and the maximum value may be less than 4294967295, depending on the system.' ;
                }

              }

              units KB ;
              mandatory true ;
            }

            leaf cir-unit {
              description 'Set cir unit, such as kbps, mbps, gbps.' ;
              type rsvp-rate-unit-type ;

              if-feature sr-bandwidth-support-64t ;

              ncd:revise-date 2023-06-17 ;
            }

            leaf pir-unit {
              if-feature sr-bandwidth-support-64t ;

              type rsvp-rate-unit-type ;

              description 'Set pir unit, such as kbps, mbps, gbps.' ;
              ncd:revise-date 2023-06-17 ;
            }

          }

          ncd:revise-date 2018-12-17 ;
        }

        container color-templates {
          description 'The configuration of SR color template.' ;
          list color-template {
            description 'The color template.' ;
            key color ;
            leaf color {
              description 'The color value.' ;
              type uint32 {
                range 1..4294967295 ;

              }

            }

            leaf template-type {
              description 'Configuration of odn template type.' ;
              type enumeration {
                enum tunnel {
                  value 0 ;
                }

                enum policy {
                  value 1 ;
                }

                enum policy-group {
                  value 2 ;
                }

              }

              default tunnel ;
              ncd:revise-date 2020-12-16 ;
            }

            leaf path-verification {
              description 'The configuration of template path-verification.' ;
              type enumeration {
                enum none {
                  value 0 ;
                }

                enum enabled {
                  value 1 ;
                }

                enum disabled {
                  value 2 ;
                }

                enum enabled-all {
                  value 3 ;
                }

              }

              default none ;
              ncd:revise-date 2021-01-21 ;
            }

            container path-options {
              description 'The configuration of path option.' ;
              list path-option {
                description 'The path option configuration of template.' ;
                key option-id ;
                leaf option-id {
                  description 'The number of path-option.' ;
                  type uint8 {
                    range 1 ;

                  }

                }

                choice path-type {
                  description 'Path Selection Type.' ;
                  mandatory true ;
                  case dynamic {
                    description 'Dynamic path Selection Type.' ;
                    leaf dynamic {
                      description 'The path type is dynamic.' ;
                      type empty ;

                      mandatory true ;
                    }

                  }

                }

              }

            }

            container pce-path-compute {
              description 'The configuration of PCE compute path.' ;
              presence "pce path compute." ;
              leaf enable {
                description 'Enable the configuration of PCE compute path.' ;
                type empty ;

                mandatory true ;
              }

            }

            container pce-delegate {
              description 'The configuration of PCE delegate.' ;
              presence "pce delegate." ;
              leaf enable {
                description 'Enable the configuration of PCE delegate.' ;
                type empty ;

                mandatory true ;
              }

            }

            container policy {
              description 'Configuration of sr policy color-template.' ;
              leaf path-setup-type {
                description 'The path setup type of policy template.' ;
                type enumeration {
                  enum sr-mpls {
                    value 0 ;
                  }

                  enum srv6 {
                    value 1 ;
                  }

                  enum auto {
                    value 2 ;
                  }

                }

              }

              leaf drop-upon-invalid {
                description 'The drop-upon-invalid of policy template.' ;
                type enumeration {
                  enum disabled {
                    value 0 ;
                  }

                  enum enabled {
                    value 1 ;
                  }

                }

              }

              leaf traffic-statistics {
                description 'The traffic statistics of policy template.' ;
                type enumeration {
                  enum enabled {
                    value 1 ;
                  }

                  enum disabled {
                    value 2 ;
                  }

                }

              }

              leaf entropy-label {
                description 'The configuration of ODN policy entropy-label.' ;
                type enumeration {
                  enum enabled {
                    value 1 ;
                  }

                  enum disabled {
                    value 2 ;
                  }

                }

                ncd:revise-date 2021-08-16 ;
              }

              leaf sid-algo {
                description 'The SID algorithm definition number for SR policy.' ;
                type uint8 {
                  range 128..255 ;

                }

                ncd:revise-date 2022-06-02 ;
              }

              container sbfd {
                description 'Configuration of policy template sbfd.' ;
                choice sbfd-conf {
                  description 'Whether to enable segment list sbfd.' ;
                  case enable {
                    description 'Enable policy template sbfd.' ;
                    leaf template-name {
                      description 'The template name of sbfd.' ;
                      type string {
                        length 1..31 ;

                      }

                      mandatory true ;
                    }

                  }

                  case disable {
                    description 'Disable policy template sbfd.' ;
                    leaf disable {
                      description 'Disable policy template sbfd.' ;
                      type empty ;

                      mandatory true ;
                    }

                  }

                }

              }

              container segment-list-sbfd {
                description 'Configuration of policy template segment list sbfd.' ;
                choice sbfd-conf {
                  description 'Whether to enable segment list sbfd.' ;
                  case enable {
                    description 'Enable policy template segment list sbfd.' ;
                    leaf template-name {
                      description 'The template name of sbfd.' ;
                      type string {
                        length 1..31 ;

                      }

                      mandatory true ;
                    }

                  }

                  case disable {
                    description 'Disable policy template segment list sbfd.' ;
                    leaf disable {
                      description 'Disable policy template segment list sbfd.' ;
                      type empty ;

                      mandatory true ;
                    }

                  }

                }

              }

              container candidate-path {
                description 'The configuration of policy template candidate-path.' ;
                list cp {
                  description 'The configuration list of policy template candidate-path.' ;
                  max-elements 16 ;
                  key preference ;
                  leaf preference {
                    description 'The candidate-path preference.' ;
                    type uint32 {
                      range 0..4294967295 ;

                    }

                  }

                  leaf metric-type {
                    description 'The metric type of candidate-path.' ;
                    type enumeration {
                      enum igp {
                        value 0 ;
                      }

                      enum delay {
                        value 1 ;
                      }

                      enum te {
                        value 2 ;
                      }

                    }

                    default igp ;
                  }

                  container affinity {
                    description 'The affinity function configuration of candidate-path.' ;
                    list bit-position {
                      description 'The configuration of affinity bit position.' ;
                      max-elements 32 ;
                      key position ;
                      leaf affinity-type {
                        description 'The configuration of affinity type,exclude-any(1)/include-any(2)/include-all(3).' ;
                        type enumeration {
                          enum exclude-any {
                            value 1 ;
                            description 'Configure the exclude-any affinity.' ;
                          }

                          enum include-any {
                            value 2 ;
                            description 'Configure the include-any affinity.' ;
                          }

                          enum include-all {
                            value 3 ;
                            description 'Configure the include-all affinity.' ;
                          }

                        }

                        mandatory true ;
                      }

                      leaf position {
                        description 'The configuration of affinity bit position.' ;
                        type uint16 {
                          range 0..31 ;

                        }

                      }

                    }

                  }

                  container pce-delegate {
                    description 'The pce delegate function of candidate path.' ;
                    leaf enable {
                      description 'Delegate candidate path to PCE.' ;
                      type empty ;

                    }

                    container pce-addr {
                      description 'The PCE address.' ;
                      choice addr-type {
                        description 'Specify the PCE address type.' ;
                        case ipv4 {
                          description 'IPv4 address type.' ;
                          leaf pce-addr-ipv4 {
                            description 'PCE IPv4 address.' ;
                            type ncd:ipv4-address {
                              pattern "([1-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5])(.([0-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5])){3}" ;

                            }

                          }

                        }

                        case ipv6 {
                          description 'IPv6 address type.' ;
                          leaf pce-addr-ipv6 {
                            description 'PCE IPv6 address.' ;
                            type ncd:ipv6-address {
                              pattern "([0-9a-fA-F]{1,4}:){7}([0-9a-fA-F]{0,4})$|^([0-9a-fA-F]{1,4}:){1,6}(:[0-9a-fA-F]{0,4}){1,6}$|^([:]{2})(([0-9a-fA-F]{1,4}:){0,6})([0-9a-fA-F]{1,4})$|^([0-9a-fA-F]{1,4}:){6}([0-9]{1,3}.){3}([0-9]{1,3})$|^([0-9a-fA-F]{1,4}:){1,5}(:[0-9a-fA-F]{0,4}){1,5}([0-9]{1,3}.){3}([0-9]{1,3})$|^([:]{2})(([0-9a-fA-F]{1,4}:){0,5})([0-9]{1,3}.){3}([0-9]{1,3})" ;

                            }

                          }

                        }

                      }

                    }

                    ncd:revise-date 2021-01-21 ;
                  }

                  container cspf-force-igp {
                    description 'Force IGP of the candidate path.' ;
                    presence "cspf force igp" ;
                    choice igp-type {
                      description 'IGP type.' ;
                      case force-ospf {
                        description 'Force OSPF.' ;
                        leaf ospf {
                          description 'Force OSPF.' ;
                          type empty ;

                          mandatory true ;
                        }

                        container ospf-process {
                          description 'Force OSPF process.' ;
                          presence "force ospf process" ;
                          leaf process-id {
                            description 'Force OSPF process ID.' ;
                            type uint32 ;

                            mandatory true ;
                          }

                          container ospf-area {
                            description 'Force OSPF area.' ;
                            presence "force ospf area" ;
                            leaf area-id {
                              description 'Force OSPF area ID.' ;
                              type ncd:ipv4-address ;

                              mandatory true ;
                            }

                          }

                        }

                      }

                      case force-isis {
                        description 'Force ISIS.' ;
                        leaf isis {
                          description 'Force ISIS.' ;
                          type empty ;

                          mandatory true ;
                        }

                        container isis-process {
                          description 'Force ISIS process.' ;
                          presence "force isis process" ;
                          leaf process-id {
                            description 'Force ISIS process ID.' ;
                            type uint32 ;

                            mandatory true ;
                          }

                          container isis-level {
                            description 'Force ISIS level.' ;
                            presence "force isis level" ;
                            leaf isis-level {
                              description 'Force ISIS level.' ;
                              type enumeration {
                                enum level-1 {
                                  value 1 ;
                                }

                                enum level-2 {
                                  value 2 ;
                                }

                              }

                              mandatory true ;
                            }

                          }

                        }

                      }

                    }

                    ncd:revise-date 2021-03-01 ;
                  }

                }

              }

              ncd:revise-date 2020-12-16 ;
            }

            container policy-group {
              if-feature template-policy-group ;

              presence policy-group-enable ;
              description 'Configuration of policy-group color-template.' ;
              leaf description {
                description 'Text description of policy group.' ;
                type ncd:string-with-blank {
                  length 1..127 ;

                }

              }

              leaf auto-select-default {
                type enumeration {
                  enum disabled {
                    value 1 ;
                  }

                  enum enabled {
                    value 0 ;
                  }

                }

                description 'Enable or disable auto select default' ;
                default enabled ;
                ncd:revise-date 2024-03-13 ;
              }

              choice match-type {
                description 'Match type.' ;
                case dscp {
                  description 'DSCP.' ;
                  container match-dscp {
                    presence match-type-dscp ;
                    description 'Configure mapping rules of the DSCP type.' ;
                    container indexs {
                      description 'Configure the index of mapping rule.' ;
                      list index {
                        description 'The index of mapping rule configuration list.' ;
                        max-elements 65535 ;
                        key index-value ;
                        leaf index-value {
                          description 'Index value.' ;
                          type uint32 {
                            range 1..4294967295 ;

                          }

                        }

                        leaf dscp-address-type {
                          description 'The DSCP address type including IPv4 and IPv6.' ;
                          type enumeration {
                            enum ipv4 {
                              value 1 ;
                            }

                            enum ipv6 {
                              value 2 ;
                            }

                          }

                          mandatory true ;
                        }

                        leaf dscp-value {
                          description 'Configure DSCP value in range mode, support single DSCP value or range(max num:32;spacing mark:,) in <0-63>. For example,"1,3-5,10,20-30",etc.The DSCP values of different color in the same policy group cannot overlap.' ;
                          type ncd:range {
                            pattern "(((([0-9]|[1-5][0-9]|6[0-3])-([0-9]|[1-5][0-9]|6[0-3]))|([0-9]|[1-5][0-9]|6[0-3]))(,((([0-9]|[1-5][0-9]|6[0-3])-([0-9]|[1-5][0-9]|6[0-3]))|([0-9]|[1-5][0-9]|6[0-3]))){0,31})" ;

                          }

                          mandatory true ;
                        }

                        choice match {
                          description 'Match.' ;
                          mandatory true ;
                          case match-color {
                            description 'Configure Color values.' ;
                            leaf color {
                              description 'Color value.' ;
                              type uint32 {
                                range 1..4294967295 ;

                              }

                              mandatory true ;
                            }

                          }

                          case match-srv6-be {
                            description 'Configure Srv6-BE.' ;
                            leaf srv6-be {
                              description 'Srv6-BE.' ;
                              type empty ;

                              mandatory true ;
                            }

                          }

                        }

                      }

                    }

                    container defaults {
                      description 'Configure the default mapping rule.' ;
                      list default {
                        description 'The default of mapping rule configuration list.' ;
                        max-elements 2 ;
                        key dscp-address-type ;
                        leaf dscp-address-type {
                          description 'The DSCP address type including IPv4 and IPv6.' ;
                          type enumeration {
                            enum ipv4 {
                              value 1 ;
                            }

                            enum ipv6 {
                              value 2 ;
                            }

                          }

                        }

                        choice match {
                          description 'Match.' ;
                          mandatory true ;
                          case match-color {
                            description 'Configure Color values.' ;
                            leaf color {
                              description 'Color value.' ;
                              type uint32 {
                                range 1..4294967295 ;

                              }

                              mandatory true ;
                            }

                          }

                          case match-srv6-be {
                            description 'Configure Srv6-BE.' ;
                            leaf srv6-be {
                              description 'Srv6-BE.' ;
                              type empty ;

                              mandatory true ;
                            }

                          }

                        }

                      }

                    }

                  }

                }

                case service-class {
                  description 'Service class.' ;
                  container match-service-class {
                    presence match-type-service-class ;
                    description 'Configure mapping rules of the Service-class type.' ;
                    container indexs {
                      description 'Configure the index of mapping rule.' ;
                      list index {
                        description 'The index of mapping rule configuration list.' ;
                        max-elements 65535 ;
                        key index-value ;
                        leaf index-value {
                          description 'Index value.' ;
                          type uint32 {
                            range 1..4294967295 ;

                          }

                        }

                        leaf be {
                          description 'BE service class.' ;
                          type boolean ;

                          mandatory true ;
                        }

                        leaf af1 {
                          description 'AF1 service class.' ;
                          type boolean ;

                          mandatory true ;
                        }

                        leaf af2 {
                          description 'AF2 service class.' ;
                          type boolean ;

                          mandatory true ;
                        }

                        leaf af3 {
                          description 'AF3 service class.' ;
                          type boolean ;

                          mandatory true ;
                        }

                        leaf af4 {
                          description 'AF4 service class.' ;
                          type boolean ;

                          mandatory true ;
                        }

                        leaf ef {
                          description 'EF service class.' ;
                          type boolean ;

                          mandatory true ;
                        }

                        leaf cs6 {
                          description 'CS6 service class.' ;
                          type boolean ;

                          mandatory true ;
                        }

                        leaf cs7 {
                          description 'CS7 service class.' ;
                          type boolean ;

                          mandatory true ;
                        }

                        choice match {
                          description 'Match.' ;
                          mandatory true ;
                          case match-color {
                            description 'Configure Color values.' ;
                            leaf color {
                              description 'Color value.' ;
                              type uint32 {
                                range 1..4294967295 ;

                              }

                              mandatory true ;
                            }

                          }

                          case match-srv6-be {
                            description 'Configure Srv6-BE.' ;
                            leaf srv6-be {
                              description 'Srv6-BE.' ;
                              type empty ;

                              mandatory true ;
                            }

                          }

                        }

                      }

                    }

                    container defaults {
                      description 'Configure the default mapping rule.' ;
                      presence defaut-color ;
                      choice match {
                        description 'Match.' ;
                        mandatory true ;
                        case match-color {
                          description 'Configure Color values.' ;
                          leaf color {
                            description 'Color value.' ;
                            type uint32 {
                              range 1..4294967295 ;

                            }

                            mandatory true ;
                          }

                        }

                        case match-srv6-be {
                          description 'Configure Srv6-BE.' ;
                          leaf srv6-be {
                            description 'Srv6-BE.' ;
                            type empty ;

                            mandatory true ;
                          }

                        }

                      }

                    }

                  }

                }

              }

              ncd:revise-date 2023-02-14 ;
            }

          }

          ncd:revise-date 2019-01-15 ;
        }

        container delay {
          description 'SR TE delay function of management object' ;
          leaf delay_linkup {
            description 'The linkup of time delay response.' ;
            type uint8 {
              range 0..120 ;

            }

            units second ;
            default 0 ;
          }

          ncd:revise-date 2019-02-15 ;
        }

        container reoptimize {
          description 'The global configuration of reoptimization.' ;
          leaf frequency {
            description 'The tunnels reoptimize timer frequency in global mode. Configure tnnl-reoptimize enable node to specify which tunnel uses reoptimize function.' ;
            type int32 {
              range 30..604800 ;

            }

            units second ;
          }

          leaf delay-decrease {
            description 'Specify delay decrease event can trigger reoptimize.' ;
            type empty ;

            ncd:revise-date 2020-03-28 ;
          }

          leaf link-up {
            description 'Specify link-up event can trigger reoptimize.' ;
            type empty ;

          }

          ncd:revise-date 2019-02-15 ;
        }

        container color-maps {
          description 'The configuration of SR color mapping relation.' ;
          list color-map {
            description 'The SR color mapping.' ;
            key color ;
            leaf color {
              description 'The color value.' ;
              type uint32 {
                range 1..4294967295 ;

              }

            }

            leaf sid-algo {
              description 'The SR SID algorithm definition number.' ;
              type uint8 {
                range 128..255 ;

              }

            }

            container sr-color-mapping {
              if-feature src-slice-id ;

              description 'Color mapping under source address' ;
              presence color-map-range ;
              leaf slice-id {
                description 'The slice under the source address' ;
                type uint32 {
                  range 1..2147483647 ;

                }

                mandatory true ;
                ncd:revise-date 2024-04-28 ;
              }

              leaf prefix-name {
                description 'prefix-name' ;
                type string {
                  length 1..63 ;

                }

                mandatory true ;
              }

              leaf strict-mode {
                description 'strict-mode' ;
                type enumeration {
                  enum disabled {
                    value 0 ;
                  }

                  enum enabled {
                    value 1 ;
                  }

                }

                default disabled ;
              }

              ncd:revise-date 2023-01-30 ;
            }

          }

          ncd:revise-date 2019-12-20 ;
        }

        container flex-algo-define {
          status obsolete {
            ncd:revise-date 2021-08-17 ;
          }

          description 'The configuration of SR flexible algorithm definition.' ;
          list flex-algo {
            description 'The SR flexible algorithm definition.' ;
            key number ;
            leaf number {
              description 'The SR flexible algorithm definition number.' ;
              type uint8 {
                range 128..255 ;

              }

            }

            leaf advertise-def {
              description 'Advertise SR flexible algorithm definition.' ;
              type empty ;

            }

            leaf metric-type {
              description 'Metric type.' ;
              type enumeration {
                enum igp {
                  value 0 ;
                }

                enum te {
                  value 1 ;
                }

                enum delay {
                  value 2 ;
                }

              }

              default igp ;
            }

            leaf priority {
              description 'Priority.' ;
              type uint8 {
                range 0..255 ;

              }

              default 0 ;
            }

            container affinity {
              description 'The affinity configuration.' ;
              container bit-positions {
                description 'The configuration of affinity bit position.The affinity of bit and name types is mutually exclusive.' ;
                list bit-position {
                  description 'The configuration of affinity bit position.The affinity of bit and name types is mutually exclusive.' ;
                  key position ;
                  leaf affinity-type {
                    description 'The configuration of affinity type,exclude-any(1)/include-any(2)/include-all(3).' ;
                    type enumeration {
                      enum exclude-any {
                        value 1 ;
                        description 'Configure the exclude-any affinity.' ;
                      }

                      enum include-any {
                        value 2 ;
                        description 'Configure the include-any affinity.' ;
                      }

                      enum include-all {
                        value 3 ;
                        description 'Configure the include-all affinity.' ;
                      }

                    }

                    mandatory true ;
                  }

                  leaf position {
                    description 'The configuration of affinity bit position.' ;
                    type uint8 {
                      range 0..31 ;

                    }

                  }

                }

              }

              container bit-names {
                description 'The configuration of affinity name.The affinity of bit and name types is mutually exclusive.' ;
                list bit-name {
                  description 'The configuration of affinity name.The affinity of bit and name types is mutually exclusive.' ;
                  key name ;
                  leaf affinity-type {
                    description 'The configuration of affinity type,exclude-any(1)/include-any(2)/include-all(3).' ;
                    type enumeration {
                      enum exclude-any {
                        value 1 ;
                        description 'Configure the exclude-any affinity.' ;
                      }

                      enum include-any {
                        value 2 ;
                        description 'Configure the include-any affinity.' ;
                      }

                      enum include-all {
                        value 3 ;
                        description 'Configure the include-all affinity.' ;
                      }

                    }

                    mandatory true ;
                  }

                  leaf name {
                    description 'The configuration of affinity bit name.' ;
                    type string {
                      length 1..32 ;

                    }

                  }

                }

              }

            }

          }

          ncd:revise-date 2019-12-20 ;
        }

        container policy-group {
          if-feature sr-policy-group {
            ncd:revise-date 2023-01-16 ;
          }

          description 'The configuration of SR policy group.' ;
          presence "The configuration of SR policy group." ;
          list group {
            description 'The SR policy group configuration list.' ;
            max-elements 65535 ;
            key group-id ;
            leaf group-id {
              description 'The policy group ID.' ;
              type uint16 {
                range 1..65535 ;

              }

            }

            container end-point {
              description 'The configuration of policy group end-point.' ;
              presence "The configuration of policy group end-point." ;
              choice address-type {
                description 'The address type of end-point.' ;
                mandatory true ;
                case ipv4 {
                  description 'The IPv4 address type of end-point.' ;
                  leaf end-point-v4 {
                    description 'The IPv4 address of end-point.' ;
                    type ncd:ipv4-address ;

                    mandatory true ;
                  }

                }

                case ipv6 {
                  description 'The IPv6 address type of the end-point.' ;
                  leaf end-point-v6 {
                    description 'The IPv6 address of end-point.' ;
                    type ncd:ipv6-address ;

                    mandatory true ;
                  }

                }

              }

            }

            container color {
              description 'The configuration of policy group color.' ;
              presence "The configuration of policy group color." ;
              list colors {
                description 'The color configuration list.' ;
                max-elements 130 ;
                key 'color dscp-address-type' ;
                leaf color {
                  description 'The color value.' ;
                  type uint32 {
                    range 1..4294967295 ;

                  }

                }

                leaf dscp-address-type {
                  description 'The DSCP address type including IPv4 and IPv6.' ;
                  type enumeration {
                    enum ipv4 {
                      value 1 ;
                    }

                    enum ipv6 {
                      value 2 ;
                    }

                  }

                }

                choice dscp-type {
                  description 'The type of DSCP.' ;
                  mandatory true ;
                  case dscp-value {
                    description 'Configure DSCP value.' ;
                    leaf value {
                      description 'Configure DSCP value in range mode, support single DSCP value or range(max num:32;spacing mark:,) in <0-63>. For example,"1,3-5,10,20-30",etc.The DSCP values of different color in the same policy group cannot overlap.' ;
                      type ncd:range {
                        pattern "(((([0-9]|[1-5][0-9]|6[0-3])-([0-9]|[1-5][0-9]|6[0-3]))|([0-9]|[1-5][0-9]|6[0-3]))(,((([0-9]|[1-5][0-9]|6[0-3])-([0-9]|[1-5][0-9]|6[0-3]))|([0-9]|[1-5][0-9]|6[0-3]))){0,31})" ;

                      }

                      mandatory true ;
                    }

                  }

                  case dscp-default {
                    description 'Configure default SR policy.' ;
                    leaf default {
                      description 'The default SR policy. For the same address type in the same policy group, only one color can be configured with default.' ;
                      type empty ;

                      mandatory true ;
                    }

                  }

                }

              }

            }

            leaf group-color {
              description 'Color of SR policy group.' ;
              type uint32 {
                range 1..4294967295 ;

              }

              ncd:revise-date 2023-01-16 ;
            }

            leaf description {
              description 'Text description of sr policy group.' ;
              type ncd:string-with-blank {
                length 1..127 ;

              }

              ncd:revise-date 2023-01-16 ;
            }

            leaf auto-select-default {
              type enumeration {
                enum disabled {
                  value 1 ;
                }

                enum enabled {
                  value 0 ;
                }

              }

              description 'Enable or disable auto select default' ;
              default enabled ;
              ncd:revise-date 2024-03-13 ;
            }

            container match-service-class {
              presence match-type-service-class ;
              description 'Mapping rules of service-class type.' ;
              container indexs {
                description 'Configure the index of mapping rule.' ;
                list index {
                  description 'The index of mapping rule configuration list.' ;
                  max-elements 65535 ;
                  key index-value ;
                  leaf index-value {
                    description 'Index value.' ;
                    type uint32 {
                      range 1..4294967295 ;

                    }

                  }

                  leaf be {
                    description 'BE service class.' ;
                    type boolean ;

                    mandatory true ;
                  }

                  leaf af1 {
                    description 'AF1 service class.' ;
                    type boolean ;

                    mandatory true ;
                  }

                  leaf af2 {
                    description 'AF2 service class.' ;
                    type boolean ;

                    mandatory true ;
                  }

                  leaf af3 {
                    description 'AF3 service class.' ;
                    type boolean ;

                    mandatory true ;
                  }

                  leaf af4 {
                    description 'AF4 service class.' ;
                    type boolean ;

                    mandatory true ;
                  }

                  leaf ef {
                    description 'EF service class.' ;
                    type boolean ;

                    mandatory true ;
                  }

                  leaf cs6 {
                    description 'CS6 service class.' ;
                    type boolean ;

                    mandatory true ;
                  }

                  leaf cs7 {
                    description 'CS7 service class.' ;
                    type boolean ;

                    mandatory true ;
                  }

                  choice match {
                    description 'Match.' ;
                    mandatory true ;
                    case color {
                      description 'Color value.' ;
                      leaf color {
                        description 'Color value.' ;
                        type uint32 {
                          range 1..4294967295 ;

                        }

                        mandatory true ;
                      }

                    }

                    case srv6-be {
                      description 'SRv6 BE.' ;
                      leaf srv6-be {
                        description 'Specify IPv6 forwarding.' ;
                        type empty ;

                        mandatory true ;
                      }

                      ncd:revise-date 2023-02-14 ;
                    }

                  }

                }

              }

              container default {
                description 'Configure the default mapping rule.' ;
                presence defaut-color ;
                choice match {
                  description 'match.' ;
                  mandatory true ;
                  case color {
                    description 'Color.' ;
                    leaf color {
                      description 'Color value.' ;
                      type uint32 {
                        range 1..4294967295 ;

                      }

                      mandatory true ;
                    }

                  }

                  case srv6-be {
                    description 'SRv6 BE.' ;
                    leaf srv6-be {
                      description 'Specify IPv6 forwarding.' ;
                      type empty ;

                      mandatory true ;
                    }

                    ncd:revise-date 2023-02-14 ;
                  }

                }

              }

              ncd:revise-date 2023-01-16 ;
            }

          }

          ncd:revise-date 2020-06-01 ;
        }

        container rate-statistics {
          if-feature rate-statistics ;

          description 'Describe the parameters of global rate period to be configured.' ;
          leaf period {
            description 'The global rate count period.
Rate period which is a multiple of 10 (seconds).' ;
            type uint32 {
              range 10..600 ;

            }

            units seconds ;
            default 120 ;
          }

          ncd:revise-date 2022-05-12 ;
        }

      }

    }

  }

  container operation {
    config false ;
    container manual-reopt {
      description 'Operation about manual-reopt.' ;
      leaf tunnel-id {
        description 'Specify the tunnel(s) to be reoptimized.' ;
        type uint32 {
          range 1..65535 ;

        }

      }

      leaf all {
        description 'Configure all tunnels to be reoptimized.' ;
        type empty ;

      }

    }

    ncd:revise-date 2019-02-15 ;
  }

  notification sr-tunnel {
    description 'The SR tunnel information.' ;
    list tunnel {
      config false ;
      description 'The SR tunnel list.' ;
      key tunnel-id ;
      leaf tunnel-id {
        description 'The tunnel ID.' ;
        type uint16 ;

      }

      leaf ingress-id {
        description 'The ingress LSR ID.' ;
        type ncd:ipv4-address ;

      }

      leaf egress-id {
        description 'The egress LSR ID.' ;
        type ncd:ipv4-address ;

      }

      leaf v6-ingress-id {
        description 'The ingress v6 LSR ID.' ;
        type ncd:ipv6-address ;

        ncd:revise-date 2020-09-11 ;
      }

      leaf v6-egress-id {
        description 'The egress v6 LSR ID.' ;
        type ncd:ipv6-address ;

        ncd:revise-date 2020-09-11 ;
      }

      leaf oper-status {
        description 'The operation status of tunnel.' ;
        type enumeration {
          enum unknown {
            value 0 ;
          }

          enum up {
            value 1 ;
          }

          enum down {
            value 2 ;
          }

          enum wtr {
            value 4 ;
          }

        }

      }

      leaf master-lsp-id {
        description 'The master lsp identifier.' ;
        type uint16 ;

      }

      leaf slave-lsp-id {
        description 'The lsp identifier of slave.' ;
        type uint16 ;

      }

      leaf hsb-status {
        description 'The hsb status of tunnel.' ;
        type enumeration {
          enum none {
            value 0 ;
          }

          enum ready {
            value 1 ;
          }

          enum active {
            value 2 ;
          }

        }

      }

      leaf master-splice-label {
        description 'The master splice label.' ;
        type uint32 ;

      }

      leaf slave-splice-label {
        description 'The splice label of slave.' ;
        type uint32 ;

      }

      leaf report-reason {
        description 'The reason of report.' ;
        type enumeration {
          enum creat_succ {
            value 1 ;
          }

          enum creat_err {
            value 2 ;
          }

          enum delete_succ {
            value 3 ;
          }

          enum delete_err {
            value 4 ;
          }

          enum chg_succ {
            value 5 ;
          }

          enum chg_err {
            value 6 ;
          }

          enum state_chg {
            value 7 ;
          }

          enum hsb_binding_succ {
            value 8 ;
          }

          enum hsb_delete {
            value 9 ;
          }

          enum hsb_switch {
            value 10 ;
          }

          enum hsb_unswitch {
            value 11 ;
          }

        }

      }

    }

    list tunnel-path {
      config false ;
      description 'The path of segment-routing tunnel LSP.' ;
      key 'tunnel-id lsp-role hop-index' ;
      leaf tunnel-id {
        description 'The tunnel ID.' ;
        type uint16 ;

      }

      leaf lsp-role {
        description "The lsp role of tunnel,it's behalf of master while the value is 1 ,it's behalf of backup while the value is 2." ;
        type enumeration {
          enum master {
            value 1 ;
          }

          enum slave {
            value 2 ;
          }

        }

      }

      leaf hop-index {
        description 'The index of sr-path hop.' ;
        type uint16 ;

      }

      leaf lsp-id {
        description 'The lsp identifier.' ;
        type uint16 ;

      }

      leaf sid-type {
        description 'The sid type.' ;
        type enumeration {
          enum default {
            value 0 ;
          }

          enum node-id-v4 {
            value 1 ;
          }

          enum node-id-v6 {
            value 2 ;
          }

          enum adj-id-v4 {
            value 3 ;
          }

          enum adj-id-v6 {
            value 4 ;
          }

          enum unnum-adj-id-v4 {
            value 5 ;
          }

          enum srv6-sid {
            value 14 ;
          }

          enum srv6-node-id {
            value 18 ;
          }

          enum srv6-adj-id {
            value 19 ;
          }

          enum srv6-link-local {
            value 20 ;
          }

        }

      }

      leaf sid-val {
        description 'The sid value.' ;
        type uint32 ;

      }

      leaf node-ip {
        description 'The node IP.' ;
        type ncd:ipv4-address ;

      }

      leaf adj-local-rid {
        description 'The local router id of adjacency.' ;
        type ncd:ipv4-address ;

      }

      leaf adj-local-ip {
        description 'The local ip of adjacency.' ;
        type ncd:ipv4-address ;

      }

      leaf adj-local-id {
        description 'The local ID of adjacency.' ;
        type uint32 ;

        ncd:revise-date 2019-07-29 ;
      }

      leaf adj-peer-rid {
        description 'The peer router id of adjacency.' ;
        type ncd:ipv4-address ;

      }

      leaf adj-peer-ip {
        description 'The peer ip of adjacency.' ;
        type ncd:ipv4-address ;

      }

      leaf adj-peer-id {
        description 'The peer ID of adjacency.' ;
        type uint32 ;

        ncd:revise-date 2019-07-29 ;
      }

      leaf srv6-sid {
        description 'The SRv6 sid value.' ;
        type ncd:ipv6-address ;

        ncd:revise-date 2020-09-11 ;
      }

      leaf v6-node-ip {
        description 'The node IPv6 address.' ;
        type ncd:ipv6-address ;

        ncd:revise-date 2020-09-11 ;
      }

      leaf v6-adj-local-ip {
        description 'The local IPv6 address of adjacency.' ;
        type ncd:ipv6-address ;

        ncd:revise-date 2020-09-11 ;
      }

      leaf v6-local-id {
        description 'The local ID of v6 adjacency.' ;
        type uint32 ;

        ncd:revise-date 2020-09-11 ;
      }

      leaf v6-adj-peer-ip {
        description 'The peer IPv6 address of adjacency.' ;
        type ncd:ipv6-address ;

        ncd:revise-date 2020-09-11 ;
      }

      leaf v6-peer-id {
        description 'The peer ID of v6 adjacency.' ;
        type uint32 ;

        ncd:revise-date 2020-09-11 ;
      }

    }

  }

  notification static-sr {
    description 'The static SR tunnel information.' ;
    list tunnel {
      config false ;
      description 'The staic SR tunnel list.' ;
      key tunnel-id ;
      leaf tunnel-id {
        description 'The tunnel ID.' ;
        type uint32 ;

      }

      leaf report-reason {
        description 'The reason of report.' ;
        type enumeration {
          enum create {
            value 1 ;
          }

          enum delete {
            value 2 ;
          }

          enum associated-status-change {
            value 3 ;
          }

        }

      }

      leaf associated-status {
        description 'The associated status of tunnel.' ;
        type enumeration {
          enum disabled {
            value 1 ;
          }

          enum unbound {
            value 2 ;
          }

          enum bound {
            value 3 ;
          }

        }

      }

    }

    ncd:revise-date 2020-04-10 ;
  }

}
