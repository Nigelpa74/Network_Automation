        }

        leaf usid-bsid-fib {
          type enumeration {
            enum short-sid-only {
              value 0 ;
              description 'Install short SID only.' ;
            }

            enum long-and-short-sid {
              value 1 ;
              description 'Install both long and short SID.' ;
            }

          }

          description 'Configure the SRv6 uSID FIB installation mode. ' ;
          default short-sid-only ;
          ncd:revise-date 2024-08-16 ;
        }

        container global-config {
          description 'SR TE global common configuration.' ;
          leaf bgp-auto-del-delay-time {
            description 'Configure the delay time to delete bgp auto tunnel.' ;
            type uint16 {
              range 0..60 ;

            }

