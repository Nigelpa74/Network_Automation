                description 'Total broadcast packets received' ;
                type uint64 ;

              }

              leaf e-multicastbytes {
                description 'Total multicast bytes sent' ;
                type uint64 ;

              }

              leaf e-multicastpkts {
                description 'Total multicast packets sent' ;
                type uint64 ;

              }

              leaf e-broadcastbytes {
                description 'Total broadcast bytes sent' ;
                type uint64 ;

              }

              leaf e-broadcastpkts {
                description 'Total broadcast packets sent' ;
                type uint64 ;

              }

              leaf in-upsendpkts {
                description 'Upsend packets received' ;
                type uint64 ;

              }

              leaf e-upsendpkts {
                description 'Upsend packets sent' ;
                type uint64 ;

              }

              leaf in-v4hdrerrors {
                description 'IPv4 HdrError count received' ;
                type uint64 ;

              }

              leaf in-v4addrerrors {
                description 'IPv4 AddrError count received' ;
                type uint64 ;

              }

              leaf in-v4truncateds {
                description 'IPv4 Truncated count received' ;
                type uint64 ;

              }

              leaf in-v4bcasts {
                description 'IPv4 Bcast count received' ;
                type uint64 ;

              }

              leaf in-v4noroutes {
                description 'IPv4 NoRoute count received' ;
                type uint64 ;

              }

              leaf in-v4unknownprotos {
                description 'IPv4 Unknown protol count received' ;
                type uint64 ;

              }

              leaf in-v4discards {
                description 'IPv4 dropped frames received' ;
                type uint64 ;

              }

              leaf in-v4forwdatagrams {
                description 'IPv4 ForwDatagram count received' ;
                type uint64 ;

              }

              leaf in-v6hdrerrors {
                description 'IPv6 HdrError count received' ;
                type uint64 ;

              }

              leaf in-v6truncateds {
                description 'IPv6 Truncated count received' ;
                type uint64 ;

              }

              leaf in-v6addrerrors {
                description 'IPv6 AddrError count received' ;
                type uint64 ;

              }

              leaf in-v6bcasts {
                description 'IPv6 Bcast count received' ;
                type uint64 ;

              }

              leaf in-v6noroutes {
                description 'IPv6 NoRoute count received' ;
                type uint64 ;

              }

              leaf in-v6unknownprotos {
                description 'IPv6 Unknown protol count received' ;
                type uint64 ;

              }

              leaf in-v6discards {
                description 'IPv6 dropped frames received' ;
                type uint64 ;

              }

              leaf in-v6forwdatagrams {
                description 'IPv6 ForwDatagram count received' ;
                type uint64 ;

              }

              leaf e-v4discards {
                description 'IPv4 dropped frames sent' ;
                type uint64 ;

              }

              leaf e-v4forwdatagrams {
                description 'IPv4 ForwDatagram count sent' ;
                type uint64 ;

              }

              leaf e-v4fragreqds {
                description 'IPv4 FragReqd count sent' ;
                type uint64 ;

              }

              leaf e-v6discards {
                description 'IPv6 dropped frames sent' ;
                type uint64 ;

              }

              leaf e-v6forwdatagrams {
                description 'IPv6 ForwDatagram count sent' ;
                type uint64 ;

              }

              leaf e-v6fragreqds {
                description 'IPv6 FragReqd count sent' ;
                type uint64 ;

              }

              leaf in-unicastbytes {
                description 'Total unicast bytes received' ;
                type uint64 ;

              }

              leaf in-unicastpkts {
                description 'Total unicast packets received' ;
                type uint64 ;

              }

              leaf in-unknownunicastbytes {
                description 'Total unknow unicast bytes received' ;
                type uint64 ;

              }

              leaf in-unknownunicastpkts {
                description 'Total unknow unicast packets received' ;
                type uint64 ;

              }

              leaf in-discbytes {
                description 'Discard bytes received' ;
                type uint64 ;

              }

              leaf e-discbytes {
                description 'Discard bytes sent' ;
                type uint64 ;

              }

              leaf e-upsendcar-drop {
                description 'Upsend-car discard packets sent' ;
                type uint64 ;

              }

              leaf in-urpf-v4drppkts {
                description 'URPF V4 discards packets received' ;
                type uint64 ;

              }

              leaf in-urpf-v6drppkts {
                description 'URPF V6 discards packets received' ;
                type uint64 ;

              }

              leaf in-pktsdrop {
                description 'Total packets of dropped received.' ;
                type uint64 ;

              }

              leaf in-pktserror {
                description 'Total error packets received.' ;
                type uint64 ;

              }

              leaf e-pktsdrop {
                description 'Total packets of dropped sent.' ;
                type uint64 ;

              }

              leaf e-pktserror {
                description 'Total error packets sent.' ;
                type uint64 ;

              }

              ncd:revise-date 2016-12-13 ;
            }

            container ipsectunnel-statistics {
              description 'Describe the data nodes for the operational state of ipsec-tunnel statistics.These performace items are updated by microcode.' ;
              leaf in-bytes {
                description 'Total bytes received' ;
                type uint64 ;

              }

              leaf in-packets {
                description 'Total packets received' ;
                type uint64 ;

              }

              leaf e-bytes {
                description 'Total bytes sent' ;
                type uint64 ;

              }

              leaf e-packets {
                description 'Total packets sent' ;
                type uint64 ;

              }

              leaf in-discbytes {
                description 'Discard bytes received' ;
                type uint64 ;

              }

              leaf in-discpkts {
                description 'Discard packets received' ;
                type uint64 ;

              }

              leaf e-discbytes {
                description 'Discard bytes sent' ;
                type uint64 ;

              }

              leaf e-discpkts {
                description 'Discard packets sent' ;
                type uint64 ;

              }

              ncd:revise-date 2018-09-13 ;
            }

          }

          container defque-counters {
            description 'Describe the data nodes for the default queue detection point.' ;
            container ethdefque-statistics {
              description 'Describe the data nodes for the default queue detection point of ether interface.' ;
              leaf in-bytes-tm {
                description 'Total bytes received' ;
                type uint64 ;

              }

              leaf in-pkts-tm {
                description 'Total packets received' ;
                type uint64 ;

              }

              leaf in-dropbytes-tm {
                description 'Total bytes of dropped received' ;
                type uint64 ;

              }

              leaf in-droppkts-tm {
                description 'Total packets of dropped received' ;
                type uint64 ;

              }

              leaf e-bytes-tm {
                description 'Total bytes sent' ;
                type uint64 ;

              }

              leaf e-pkts-tm {
                description 'Total packets sent' ;
                type uint64 ;

              }

              leaf e-dropbytes-tm {
                description 'Total bytes of dropped sent' ;
                type uint64 ;

              }

              leaf e-droppkts-tm {
                description 'Total packets of dropped sent' ;
                type uint64 ;

              }

            }

            ncd:revise-date 2021-01-14 ;
          }

        }

        leaf type {
          description 'The type of the interface.' ;
          type uint16 ;

          ncd:revise-date 2020-10-16 ;
        }

      }

      list logic-interface-summary {
        description 'Show logic interface information' ;
        key name ;
        leaf name {
          description 'The name of the logic interface.

This leaf MAY be mapped to ifName by an implementation. Such an implementation MUST restrict the values for this leaf so that it matches the restrictions of ifName.' ;
          type ncd:string-all {
            length 1..31 ;

          }

        }

        leaf number {
          description 'The number of logic interface' ;
          type uint32 {
            range 0..99999999 ;

          }

        }

        leaf config-limited-number {
          if-feature config-limited-number ;

          description 'The configuration limited number of logic interface.' ;
          type uint32 ;

          ncd:revise-date 2019-04-30 ;
        }

      }

    }

    container vrfs {
      list vrf {
        leaf vrf-name {
          type leafref {
            path "/configuration/interfaces/interface-configuration/interface/vrf/ip-vrf-forwarding" ;
          }

          description 'The name of the VRF' ;
        }

        container interfaces {
          list interface {
            leaf name {
              type leafref {
                path "/configuration/interfaces/interface-configuration/interface/name" ;
              }

              description 'The name of the interface.

This leaf MAY be mapped to ifName by an implementation. Such an implementation MUST restrict the values for this leaf so that it matches the restrictions of ifName.' ;
            }

            key name ;
            description 'The list of interfaces under this VRF' ;
          }

          description 'Describe the data nodes for the state of interfaces under this VRF.' ;
        }

        key vrf-name ;
        description 'The list of VRFs with interfaces' ;
      }

      description 'Describe the data nodes for the operational state of VRFs with interfaces.' ;
      ncd:revise-date 2023-08-16 ;
    }

  }

  container operation {
    config false ;
    description 'Describe the operation nodes of interfaces.' ;
    container interfaces {
      description 'Describe the operation nodes of interfaces.' ;
      container interface-statistics {
        description 'Describe the operation nodes of interface statistics.' ;
        leaf clear-one-minute-peak-all {
          if-feature one-minute-peak ;

          description 'The operation nodes for clear the one-minute-peak-value of all eth-port.' ;
          type enumeration {
            enum all {
              value 255 ;
            }

          }

        }

        leaf clear-interface-statistics-all {
          description 'The operation nodes for clear the performace items value of all interfaces.' ;
          type enumeration {
            enum all {
              value 255 ;
            }

          }

        }

        container clear {
          description 'Describe the operation nodes for clear statistcs.' ;
          list one-minute-peak {
            if-feature one-minute-peak ;

            description 'The operation nodes for clear the one-minute-peak-value of single eth-port.' ;
            key name ;
            leaf name {
              description 'The name of ether interfaces.' ;
              type leafref {
                path "/configuration/interfaces/interface-configuration/interface/name" ;
              }

            }

          }

          list interface-statistics {
            description 'The operation nodes for clear the performace items value of single interfaces.' ;
            key name ;
            leaf name {
              description 'The name of interface which supports traffic statistics.' ;
              type leafref {
                path "/configuration/interfaces/interface-configuration/interface/name" ;
              }

            }

          }

        }

      }

    }

  }

}
