module zxr10-interfaces {
  namespace "http://www.zte.com.cn/zxr10/netconf/schema/rosng/interfaces" ;
  prefix interface ;
  yang-version 1 ;
  import zxr10-netconf-defs {
    prefix ncd ;
  }

  organization "ZTE Corporation" ;
  contact "ZTE Corporation
  Nanjing Institute of ZTE Corporation
  No.68 Zijinghua Rd. Yuhuatai District, Nanjing, China
  Tel: +86-25-52870000" ;
  description 'The netconf module to describe the Interface Management' ;
  revision 2025-03-16 {
    description 'Add container to configure counter smooth and add new feature counter-smooth.' ;
  }
  revision 2025-01-06 {
    description 'add container /interface:configuration/interface:interfaces/interface:interface-statistics/interface:traffic-statistics-change,
add container /interface:configuration/interface:interfaces/interface:interface-configuration/interface:interface/interface:interface-statistics/interface:traffic-statistics-change,
add leaf /interface:configuration/interface:interfaces/interface:interface-configuration/interface:interface/interface:interface-statistics/interface:threshold-rate-drop/interface:rate-drop/interface:check-rate-threshold,
add leaf /interface:configuration/interface:interfaces/interface:interface-configuration/interface:interface/interface:interface-statistics/interface:threshold-rate-drop/interface:rate-drop/interface:check-utilization-threshold,
add leaf /interface:configuration/interface:interfaces/interface:interface-configuration/interface:interface/interface:interface-statistics/interface:threshold-rate-drop/interface:rate-drop/interface:change-ratio-threshold,
change status of leaf /interface:configuration/interface:interfaces/interface:interface-configuration/interface:interface/interface:interface-statistics/interface:threshold-rate-drop/interface:rate-drop/interface:normal-threshold into obsolete,
change status of leaf /interface:configuration/interface:interfaces/interface:interface-configuration/interface:interface/interface:interface-statistics/interface:threshold-rate-drop/interface:rate-drop/interface:alarm-threshold into obsolete.' ;
  }

