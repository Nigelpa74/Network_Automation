    description 'The global traffic statistics function.' ;
  }

  feature one-minute-peak {
    description 'The one-minute peak statistcs function.' ;
  }

  feature logic-traffic-statistics {
    description 'The VLAN/Te-tunnel Port traffic-statistics function.' ;
  }

  feature subport-traffic-statistics {
    description 'The SubPort traffic-statistics function.' ;
  }

  feature alarm-input-fcserrors {
    description 'The configuration for input-fcserrors alarm function.' ;
    ncd:revise-date 2023-12-11 ;
  }

  feature threshold {
    description 'The threashold configuration for alarm function.' ;
  }

  feature effective-time-threshold {
    description 'The effective-time-threshold configuration for alarm function.' ;
  }

  feature anycast-mac-address {
    description 'The anycast-mac-address configuration for configure MAC address to be anycast.' ;
  }

  feature rate-statistics {
    description 'The interface rate count period set function.' ;
  }

  feature global-rate-statistics {
    description 'The global interface rate count period set function.' ;
  }

  feature ip-address-primary-sec {
    description 'IP address primary-secondary function.' ;
  }

  feature config-limited-number ;

  feature chinese-desc {
    description 'Set the chinese description of interface.' ;
  }

  feature subport-v4-traffic-statics {
    description 'The SubPort v4-traffic-statistics function.' ;
  }

  feature subport-v6-traffic-statics {
    description 'The SubPort v6-traffic-statistics function.' ;
  }

  feature shutdown-interface-alarm-shield {
    description 'shutdown-interface alarm-shield configration.' ;
  }

  feature mc-lag-address {
    description 'The multi-chassis link aggregation group function.' ;
  }

  feature extra-mc-lag-address {
    description 'The extra-multi-chassis link aggregation group function.' ;
    ncd:revise-date 2023-07-25 ;
  }

  feature channel-bandwidth {
    description 'channel bandwidth configration.' ;
    ncd:revise-date 2021-10-12 ;
  }

  feature traffic-statistics-store {
    ncd:revise-date 2022-02-24 ;
  }

  feature threshold-upsend-car-drop {
    description 'The upsend car drop threashold configuration for alarm function.' ;
    ncd:revise-date 2022-09-19 ;
  }

  feature global-threshold {
    description 'The global threashold configuration for alarm function.' ;
    ncd:revise-date 2022-09-19 ;
  }

  feature threshold-rate-drop {
    description 'The rate drop threashold configuration for alarm function.' ;
    ncd:revise-date 2023-03-03 ;
  }

  feature threshold-utilization-change {
    description 'The utilization change threashold configuration for alarm function.' ;
    ncd:revise-date 2023-03-03 ;
  }

  feature traffic-statistics-change {
    description 'The traffic statistics change configuration.' ;
    ncd:revise-date 2025-01-06 ;
  }

  feature counter-smooth {
    description 'The period attribute of the counter-smooth.' ;
    ncd:revise-date 2025-03-16 ;
  }

  container configuration {
    description 'Describe the configuration of interfaces' ;
    container interfaces {
      description 'Describe the parameters of interfaces to be configured' ;
      container interface-statistics {
        description 'Describe the parameters of interface statistics to be configured' ;
        leaf traffic-statistics-switch {
          if-feature global-traffic-statistics ;

          description 'Enable or disable the global traffic statistics. When this switch is disabled, the traffic statistics of all interfaces in the device is disabled. Otherwise it depends on the switch on the particular interface.' ;
          type enumeration {
            enum disable {
              value 0 ;
              description 'Disable the global traffic statistics' ;
            }

            enum enable {
              value 1 ;
              description 'Enable the global traffic statistics' ;
            }

          }

          default enable ;
        }

        leaf traffic-statistics-store-switch {
          if-feature traffic-statistics-store ;

          description 'The storage of traffic statistics. When this switch is enabled, The traffic statistics will be stored in the local disk.' ;
          type enumeration {
            enum disable {
              value 0 ;
              description 'Disable storing traffic statistics' ;
            }

            enum enable {
              value 1 ;
              description 'Enable storing traffic statistics' ;
            }

          }

          default disable ;
          ncd:revise-date 2022-02-24 ;
        }

        container one-minute-peak-all {
          if-feature one-minute-peak ;

          description 'Describe the one-minute-peak-value statistics to be configed for all eth-port.' ;
          leaf one-minute-peak-all {
            description 'Enable or disable one-minute-peak-value statistics for all eth-port.' ;
            type enumeration {
              enum disable {
                value 0 ;
                description 'disable one-minute-peak function.' ;
              }

              enum enable {
                value 1 ;
                description 'enable one-minute-peak function.' ;
              }

            }

            default disable ;
          }

        }

        leaf alarm-threshold {
          description 'Enable or disable the global threshold alarm.Only act on alarm type with bandwidth utilization and fcserrors.Only act on those interfaces who have not configured threshold.' ;
          type enumeration {
            enum disable {
              value 0 ;
              description 'Disable the global threshold alarm' ;
            }

            enum enable {
              value 1 ;
              description 'Enable the global threshold alarm' ;
            }

          }

          default enable ;
        }

        container rate-statistics {
          if-feature global-rate-statistics ;

          description 'Describe the parameters of rate count to be configured.' ;
          leaf period {
            description 'The interface rate count period.
Rate period which is a multiple of 10 (sec).' ;
            type uint32 {
              range 10..600 ;

            }

            units seconds ;
          }

          ncd:revise-date 2017-07-25 ;
        }

        container global-threshold {
          if-feature global-threshold ;

          description 'Describe the parameters of global threshold to be configured' ;
          list ratio-threshold {
            description 'Describe the parameters of percent-type global threshold to be configured.' ;
            key alarm-type ;
            leaf alarm-type {
              description 'The type of alarm.' ;
              type enumeration {
                enum input-utilization {
                  value 1 ;
                }

                enum output-utilization {
                  value 2 ;
                }

                enum input-fcsratio {
                  value 4 ;
                }

              }

            }

            leaf limit-ratio-low {
              description 'The lower limit range of alarm thresholds.' ;
              type uint32 {
                range 0..99 ;

              }

              default 0 ;
            }

            leaf limit-ratio-high {
              description 'The higher limit range of alarm thresholds.' ;
              type uint32 {
                range 1..100 ;

              }

            }

          }

          list count-threshold {
            description 'Describe the parameters of count-type global threshold to be configured.' ;
            key alarm-type ;
            leaf alarm-type {
              description 'The type of alarm.' ;
              type enumeration {
                enum input-fcserrors {
                  value 3 ;
                }

              }

            }

            leaf limit-count-low {
              description 'The lower limit range of alarm thresholds.' ;
              type uint32 {
                range 0..4294967294 ;

              }

              default 0 ;
            }

            leaf limit-count-high {
              description 'The higher limit range of alarm thresholds.' ;
              type uint32 {
                range 1..4294967295 ;

              }

            }

          }

          ncd:revise-date 2022-09-19 ;
        }

        container traffic-statistics-change {
          leaf rate-drop-switch {
            type enumeration {
              enum enable {
                value 1 ;
                description 'Enable the global rate drop alarm function' ;
              }

              enum disable {
                value 0 ;
                description 'Disable the global rate drop alarm function' ;
              }

            }

            description 'Enable or disable the global rate drop alarm function. When this switch is disabled, the rate drop alarm function of all interfaces in the device is disabled. Otherwise it depends on the switch on the particular interface.' ;
            default enable ;
          }

          leaf utilization-change-switch {
            type enumeration {
              enum enable {
                description 'Enable the global utilization change notice function' ;
                value 1 ;
              }

              enum disable {
                description 'Disable the global utilization change notice function' ;
                value 0 ;
              }

            }

            description 'Enable or disable the global utilization change notice function. When this switch is disabled, the utilization change notice function of all interfaces in the device is disabled. Otherwise it depends on the switch on the particular interface.' ;
            default enable ;
          }

          leaf period {
            type uint32 {
              range 120..600 ;

            }

            description 'The traffic statistics change period, which is a multiple of 10 (sec).' ;
            units seconds ;
            default 120 ;
          }

          if-feature traffic-statistics-change ;

          description 'Describe the parameters of global traffic statistics change to be configured' ;
          ncd:revise-date 2025-01-06 ;
        }

        container counter-smooths {
          description 'Interface counting smooth period configurations.' ;
          list counter-smooth {
            leaf termianl-type {
              type enumeration {
                enum mib {
                  value 1 ;
                }

                enum telemetry {
                  value 2 ;
                }

                enum netconf {
                  value 3 ;
                }

                enum cli {
                  value 4 ;
                }

              }

              description 'Terminal type of interface counting smooth period configuration.' ;
            }

            leaf counter-smooth-period {
              type uint32 {
                range 10..120 ;

              }

              description 'Smooth period which is a multiple of 10 (sec).' ;
              mandatory true ;
            }

            description 'Interface counting smooth period configuration.' ;
            key termianl-type ;
            max-elements 4 ;
          }

          if-feature counter-smooth ;

          ncd:revise-date 2025-03-16 ;
        }

      }

      container interface-configuration {
        description 'Describe the parameters of interfaces to be configured' ;
        list interface {
          description 'The list of interfaces for configuring parameters' ;
          key name ;
          leaf name {
            description 'The name of the interface.

This leaf MAY be mapped to ifName by an implementation. Such an implementation MUST restrict the values for this leaf so that it matches the restrictions of ifName.' ;
            reference "RFC 2863: The Interfaces Group MIB - ifName" ;
            type ncd:ifname ;

          }

          leaf description {
            description 'A textual description of the interface.This string should include the name of the
manufacturer, the product name and the version of the interface hardware/software.

This leaf has the same semantics as ifDescr.' ;
            reference "RFC 2863: The Interfaces Group MIB - ifDescr" ;
            type ncd:string-with-blank {
              length 1..242 ;

            }

          }

          leaf admin-status {
            description 'This leaf contains the configured, desired state of the interface.

This leaf has the same semantics as ifAdminStatus.' ;
            reference "RFC 2863: The Interfaces Group MIB - ifAdminStatus" ;
            type enumeration {
              enum disable {
                value 0 ;
                description 'Disable the desired state of the interface' ;
              }

              enum enable {
                value 1 ;
                description 'Enable the desired state of the interface' ;
              }

            }

          }

          leaf link-up-down-trap-enable {
            description 'Indicates whether linkUp/linkDown traps should be generated for this interface.

This leaf has the same semantics as ifLinkUpDownTrapEnable.' ;
            reference "RFC 2863: The Interfaces Group MIB ifLinkUpDownTrapEnable" ;
            type boolean ;

          }

          container interface-statistics {
            description 'Describe the parameters of interface statistics to be configured' ;
            leaf switch {
              if-feature logic-traffic-statistics ;

              description 'Enable or disable the current interface traffic statistics. Only when the current interface is VLAN interface or TE tunnel, the switch is effective.

Only particular interfaces can configure this traffic statistics switch. For those one can not configure this switch, the leaf of this container are not present.' ;
              type enumeration {
                enum disable {
                  value 0 ;
                  description 'Disable the current interface traffic statistics' ;
                }

                enum enable {
                  value 1 ;
                  description 'Enable the current interface traffic statistics' ;
                }

              }

            }

            container alarm-input-fcserrors {
              description 'Describe the parameters of interface input-fcserrors alarm to be configured' ;
              if-feature alarm-input-fcserrors {
                ncd:revise-date 2023-12-11 ;
              }

              leaf period {
                type uint32 {
                  range 10..65530 ;

                }

                description 'The interface input-fcserrors alarm period.
Alarm period which is an multiple of 10 (sec).' ;
                default 10 ;
                units seconds ;
              }

              ncd:revise-date 2023-12-11 ;
            }

            container subport {
              if-feature subport-traffic-statistics ;

              description 'Describe the parameters of interface statistics to be configured' ;
              leaf subport-switch {
                description 'Enable or disable subinterface traffic statistics. If the current interface is a subinterface, the subport-switch discribes enable or disable the current interface traffic statistics. Otherwise it discribes enable of disable all subinterface(s) of the current interface traffic statistics.
Whether the currnet interface enable traffic statistics, or its parent interface enable all subinterfaces traffic statistics, the traffic statistics of it is enabled. 
Only when the current interface disable traffic statistics, and its parent interface disable all subinterfaces traffic statistics, the traffic statistics of it is disabled.

Only particular interfaces can configure this traffic statistics switch. For those one can not configure this switch, the leaf of this container are not present.' ;
                type enumeration {
                  enum disable {
                    value 0 ;
                    description 'Disable subinterface traffic statistics' ;
                  }

                  enum enable {
                    value 1 ;
                    description 'Enable subinterface traffic statistics' ;
                  }

                }

              }

              container subport-v4 {
                if-feature subport-v4-traffic-statics ;

                description 'Describe the parameters of interface statistics to be configured' ;
                leaf subport-v4-switch {
                  description 'Enable or disable subinterface  v4 traffic statistics. If the current interface is a subinterface, the subport-switch discribes enable or disable the current interface v4 traffic statistics. Otherwise it discribes enable of disable all subinterface(s) of the current interface v4 traffic statistics.
Only when the currnet interface enable v4 traffic statistics, and its parent interface enable all subinterfaces v4 traffic statistics, the v4 traffic statistics of it is enabled. 
Whether the current interface disable v4 traffic statistics, or its parent interface disable all subinterfaces v4 traffic statistics, the v4 traffic statistics of it is disabled.' ;
                  type enumeration {
                    enum enable {
                      value 1 ;
                    }

                    enum disable {
                      value 0 ;
                    }

                  }

                }

                ncd:revise-date 2020-06-15 ;
              }

              container subport-v6 {
                if-feature subport-v6-traffic-statics ;

                description 'Describe the parameters of interface statistics to be configured' ;
                leaf subport-v6-switch {
                  description 'Enable or disable subinterface  v6 traffic statistics. If the current interface is a subinterface, the subport-switch discribes enable or disable the current interface v6 traffic statistics. Otherwise it discribes enable of disable all subinterface(s) of the current interface v6 traffic statistics.
Only when the currnet interface enable v6 traffic statistics, and its parent interface enable all subinterfaces v6 traffic statistics, the v6 traffic statistics of it is enabled. 
Whether the current interface disable v6 traffic statistics, or its parent interface disable all subinterfaces v6 traffic statistics, the v6 traffic statistics of it is disabled.' ;
                  type enumeration {
                    enum enable {
                      value 1 ;
                    }

                    enum disable {
                      value 0 ;
                    }

                  }

                }

                ncd:revise-date 2020-06-15 ;
              }

            }

            container one-minute-peak {
              if-feature one-minute-peak ;

              description 'Describe the one-minute-peak-value statistics to be configed' ;
              leaf one-minute-peak {
                description 'Enable or disable one-minute-peak-value statistics for single eth-port.' ;
                type enumeration {
                  enum disable {
                    value 0 ;
                  }

                  enum enable {
                    value 1 ;
                  }

                }

                default disable ;
              }

            }

            container threshold {
              if-feature threshold ;

              description 'Describe the parameters of interface threshold to be configured' ;
              list ratio-threshold {
                description 'Describe the parameters of percent-type interface threshold  to be configured.' ;
                key alarm-type ;
                leaf alarm-type {
                  description 'The type of alarm.' ;
                  type enumeration {
                    enum input-utilization {
                      value 1 ;
                    }

                    enum output-utilization {
                      value 2 ;
                    }

                    enum input-fcsratio {
                      value 4 ;
                    }

                  }

                }

                leaf limit-ratio-low {
                  description 'The lower limit range of alarm thresholds.' ;
                  type uint32 {
                    range 0..99 ;

                  }

                  default 0 ;
                }

                leaf limit-ratio-high {
                  description 'The higher limit range of alarm thresholds.' ;
                  type uint32 {
                    range 1..100 ;

                  }

                }

              }

              list count-threshold {
                description 'Describe the parameters of count-type interface threshold  to be configured.' ;
                key alarm-type ;
                leaf alarm-type {
                  description 'The type of alarm.' ;
                  type enumeration {
                    enum input-fcserrors {
                      value 3 ;
                    }

                  }

                }

                leaf limit-count-low {
                  description 'The lower limit range of alarm thresholds.' ;
                  type uint32 {
                    range 0..4294967294 ;

                  }

                  default 0 ;
                }

                leaf limit-count-high {
                  description 'The higher limit range of alarm thresholds.' ;
                  type uint32 {
                    range 1..4294967295 ;

                  }

                }

              }

            }

            container threshold-upsend-car-drop {
              if-feature threshold-upsend-car-drop ;

              description 'Describe the parameters of interface upsend car drop threshold to be configured' ;
              leaf limit-ratio {
                description 'The portlimit of alarm thresholds.' ;
                type uint32 {
                  range 0..100 ;

                }

              }

              ncd:revise-date 2022-09-19 ;
            }

            container effective-time-threshold {
              if-feature effective-time-threshold ;

              description 'Describe the parameters of interface effective-time-threshold to be configured' ;
              list ratio-threshold {
                description 'Describe the parameters of percent-type interface threshold to be configured.' ;
                key alarm-type ;
                leaf alarm-type {
                  description 'The type of alarm.' ;
                  type enumeration {
                    enum input-utilization {
                      value 1 ;
                    }

                    enum output-utilization {
                      value 2 ;
                    }

                    enum input-fcsratio {
                      value 4 ;
                    }

                  }

                }

                leaf limit-ratio-low {
                  description 'The lower limit range of alarm thresholds.' ;
                  type uint32 {
                    range 0..99 ;

                  }

                  mandatory true ;
                }

                leaf limit-begin-date {
                  description 'The begin date of effective-time-threshold configuration' ;
                  type ncd:date ;

                }

                leaf limit-begin-time {
                  description 'The begin time of effective-time-threshold configuration' ;
                  type ncd:time ;

                  mandatory true ;
                }

                leaf limit-end-date {
                  description 'The end date of effective-time-threshold configuration' ;
                  type ncd:date ;

                }

                leaf limit-end-time {
                  description 'The end time of effective-time-threshold configuration' ;
                  type ncd:time ;

                  mandatory true ;
                }

              }

              list count-threshold {
                description 'Describe the parameters of count-type interface threshold  to be configured.' ;
                key alarm-type ;
                leaf alarm-type {
                  description 'The type of alarm.' ;
                  type enumeration {
                    enum input-fcserrors {
                      value 3 ;
                    }

                  }

                }

                leaf limit-count-low {
                  description 'The lower limit range of alarm thresholds.' ;
                  type uint32 {
                    range 0..4294967294 ;

                  }

                  mandatory true ;
                }

                leaf limit-begin-date {
                  description 'The begin date of effective-time-threshold configuration' ;
                  type ncd:date ;

                }

                leaf limit-begin-time {
                  description 'The begin time of effective-time-threshold configuration' ;
                  type ncd:time ;

                  mandatory true ;
                }

                leaf limit-end-date {
                  description 'The end date of effective-time-threshold configuration' ;
                  type ncd:date ;

                }

                leaf limit-end-time {
                  description 'The end time of effective-time-threshold configuration' ;
                  type ncd:time ;

                  mandatory true ;
                }

              }

              ncd:revise-date 2016-03-15 ;
            }

            container rate-statistics {
              if-feature rate-statistics ;

              description 'Describe the parameters of rate count to be configured.' ;
              leaf period {
                description 'The interface rate count period.
Rate period which is an multiple of 10 (sec).' ;
                type uint32 {
                  range 10..600 ;

                }

                units seconds ;
              }

              ncd:revise-date 2017-01-16 ;
            }

            container threshold-rate-drop {
              if-feature threshold-rate-drop ;

              description 'Describe the parameters of interface rate drop threshold to be configured' ;
              list rate-drop {
                description 'Describe the parameters of rate-type interface threshold to be configured.' ;
                key alarm-type ;
                leaf alarm-type {
                  description 'The type of alarm.' ;
                  type enumeration {
                    enum input {
                      value 1 ;
                    }

                    enum output {
                      value 2 ;
                    }

                  }

                }

                leaf normal-threshold {
                  type uint32 {
                    range 0..4294967295 ;

                  }

                  description 'The normal threshold of rate drop alarm.' ;
                  status obsolete {
                    ncd:revise-date 2025-01-06 ;
                  }
                }

                leaf alarm-threshold {
                  type uint32 {
                    range 0..4294967295 ;

                  }

                  description 'The alarm threshold of rate drop alarm.' ;
                  status obsolete {
                    ncd:revise-date 2025-01-06 ;
                  }
                }

                leaf check-rate-threshold {
                  description 'The check rate threshold of rate drop alarm.' ;
                  default 500000000 ;
                  units bps ;
                  type uint32 {
                    range 0..4294967295 ;

                  }

                  ncd:revise-date 2025-01-06 ;
                }

                leaf check-utilization-threshold {
                  description 'The check utilization threshold of rate drop alarm.' ;
                  default 20 ;
                  type uint32 {
                    range 1..100 ;

                  }

                  ncd:revise-date 2025-01-06 ;
                }

                leaf change-ratio-threshold {
                  type uint32 {
                    range "0|50..100" ;

                  }

                  description 'The change ratio threshold of rate drop alarm.' ;
                  default 99 ;
                  ncd:revise-date 2025-01-06 ;
                }

              }

              ncd:revise-date 2023-03-03 ;
            }

            container threshold-utilization-change {
              if-feature threshold-utilization-change ;

              description 'Describe the parameters of interface utilization change threshold to be configured.' ;
              list utilization-change {
                description 'Describe the parameters of utilization-type interface threshold to be configured.' ;
                key alarm-type ;
                leaf alarm-type {
                  description 'The type of alarm.' ;
                  type enumeration {
                    enum input {
                      value 1 ;
                    }

                    enum output {
                      value 2 ;
                    }

                  }

                }

                leaf check-threshold {
                  description 'The check threshold of utilization change notice.' ;
                  type uint32 {
                    range 1..100 ;

                  }

                }

                leaf range-threshold {
                  description 'The range threshold of utilization change notice.' ;
                  type uint32 {
                    range 1..100 ;

                  }

                }

              }

              ncd:revise-date 2023-03-03 ;
            }

            container traffic-statistics-change {
              leaf rate-drop-switch {
                type enumeration {
                  enum enable {
                    value 1 ;
                    description 'Enable the interface rate drop alarm function' ;
                  }

                  enum disable {
                    description 'Disable the interface rate drop alarm function' ;
                    value 0 ;
                  }

                }

                description 'Enable or disable the interface rate drop alarm function.' ;
                default enable ;
              }

              leaf utilization-change-switch {
                type enumeration {
                  enum enable {
                    value 1 ;
                    description 'Enable the interface utilization change notice function' ;
                  }

                  enum disable {
                    description 'Enable the interface utilization change notice function' ;
                    value 0 ;
                  }

                }

                description 'Enable or disable the interface utilization change notice function. ' ;
                default enable ;
              }

              description 'Describe the parameters of interface traffic statistics change to be configured' ;
              if-feature traffic-statistics-change ;

              ncd:revise-date 2025-01-06 ;
            }

          }

          container encapsulation {
            description 'Configure the encapsulation for this interface.

Only particular interfaces support encapsulation. For interfaces that do not support encapsulation, the leafs of this container are not present.' ;
            presence "the leaf type of this container should be mandatory, and other leafs are not." ;
            leaf type {
              description 'The encapsulation type for this interface' ;
              type enumeration {
                enum ppp {
                  value 1 ;
                  description 'The encapsulation type is Point-to-Point protocol (PPP).' ;
                }

                enum hdlc {
                  value 2 ;
                  description 'The encapsulation type is High Level Data Link Control (HDLC) protocol.' ;
                }

                enum frame-relay {
                  value 3 ;
                  description 'The encapsulation type is Frame Relay.' ;
                }

                enum eos {
                  value 13 ;
                  description 'The encapsulation type is Ethernet Over Sdh.' ;
                }

                enum ces {
                  value 14 ;
                  description 'The encapsulation type is Circuit Emulation Service.' ;
                }

              }

              mandatory true ;
            }

            leaf single-comm {
              description 'Configure the protocol data packet is a single communication, and choose the protocol data packet is been received only or transported only. If this parameter does not configured, the protocol data packet is been both received and transported.' ;
              type enumeration {
                enum rx {
                  value 1 ;
                  description 'The protocol data packet is been received only.' ;
                }

                enum tx {
                  value 2 ;
                  description 'The protocol data packet is been transported only.' ;
                }

              }

            }

          }

          container switch-attribute {
            description 'Configure the switch attribute of this interface.' ;
            leaf switch-attribute {
              description 'Enable or disable the switch attribute of the interface.' ;
              type enumeration {
                enum disable {
                  value 0 ;
                  description 'Disable the switch attribute of the interface.' ;
                }

                enum enable {
                  value 1 ;
                  description 'Enable the switch attribute of the interface.' ;
                }

              }

            }

          }

          choice phys-address {
            description "The interface's address at its protocol sub-layer.



            For interfaces that do not have such an address, this node is not present." ;
            case mac-address {
              description 'Configure the MAC address of this interface.' ;
              leaf mac-address {
                description 'The MAC address of this interface

For interfaces that do not have the MAC address, this node is not present.' ;
                reference "RFC 2863: The Interfaces Group MIB - ifPhysAddress" ;
                type ncd:mac-address ;

              }

              leaf is-anycast {
                if-feature anycast-mac-address ;

                description 'Configure the MAC address to anycast. Choose true to make it to be anycast,or choose false to make it normal.' ;
                type boolean ;

                default false ;
                ncd:revise-date 2016-11-11 ;
              }

            }

            case mac-address-offset {
              description "Configure the MAC address of this interface offset.



              If the interface is a subinteface, and it's father interface has configured the MAC address, the offset is from the MAC address on it's father interface. Otherwise the offset is from the base MAC on the current device." ;
              leaf mac-address-offset {
                description "Configure the MAC address of this interface offset.



                If the interface is a subinteface, and it's father interface has configured the MAC address, the offset is from the MAC address on it's father interface. Otherwise the offset is from the base MAC on the current device." ;
                type uint32 ;

              }

            }

          }

          leaf mtu {
            description 'The maximum transmission unit with link layer of the interface.

The value of this leaf is the configuration value of MTU, may not equal the effect value.
Only particular interfaces have MTU. For interfaces that do not have this attribute, this node is not present.' ;
            type uint32 {
              range 0..9700 ;

            }

            units bytes ;
          }

          leaf mpls-mtu {
            description 'The maximum transmission unit with MPLS protocol layer of the interface.

The value of this leaf is the configuration value of MPLS MTU, may not equal the effect value.
Only particular interfaces have MPLS MTU. For interfaces that do not have this attribute, this node is not present.' ;
            type uint32 {
              range 68..9600 ;

            }

            units bytes ;
          }

          container gateway {
            description 'Configure gateway for this interface.

Only particular interfaces support gateway. For interfaces that do not support gateway, the leafs of this container are not present.' ;
            leaf is-gateway-interface {
              description 'Configure whether the interface is a gateway interface.

Only particular interfaces can be configured to be a gateway interface. For those one can not be, the leaf of this container are not present or with the value of false.' ;
              type empty ;

            }

          }

          container vrf {
            description 'The parameters of VRF on the interface to be configured.

Only particular interfaces support VRF. For interfaces that do not support VRF, the leafs of this container are not present.' ;
            leaf ip-vrf-forwarding {
              description 'Associates a VRF with the interface

Only particular interfaces support IP VRF forwarding. For interfaces that do not support IP VRF forwarding, the leafs of this container are not present.' ;
              type string {
                length 1..32 ;

              }

            }

          }

          container ip-unnumber {
            description 'The parameters of IP unnumber on the interface to be configured.

Only particular interfaces support IP unnumber. For interfaces that do not support IP unnumber, the leafs of this container are not present.' ;
            leaf ip-unnumber-name {
              description 'the name of the interface which is been ip unnumbered on.

The ip unnumbered configuration command allows you to enable IP processing on a serial interface without assigning it an explicit IP address. The ip unnumbered interface can "borrow" the IP address of another interface already configured, which conserves network and address space. 

Only particular interfaces support IP unnumber. For interfaces that do not support IP unnumber, the node is not present.' ;
              type leafref {
                path "/configuration/interfaces/interface-configuration/interface/name" ;
              }

            }

          }

          container ipv4 {
            description 'The parameters of IPv4 protocol on the interface to be configured.

Only layer 3 interfaces support IPv4 protocol. For interfaces that do not support IPv4 protocol, the leafs of this container are not present.' ;
            container addresses {
              description 'The IPv4 addresses of the interface' ;
              list address {
                description 'The list of IPv4 addresses configured on the interface.' ;
                key 'address mask primary-or-secondly' ;
                leaf address {
                  description "The IPv4 address to which this entry's addressing information pertains." ;
                  type ncd:ipv4-address ;

                }

                leaf mask {
                  description 'The subnet mask associated with the IP address of this entry.  The value of the mask is an IP address with all the network bits set to 1 and all the hosts bits set to 0.' ;
                  type ncd:ipv4-mask ;

                }

                leaf primary-or-secondly {
                  description "Describe whether this entry's address is primary or secondly.



                  Each interface can only configure one primary address, but more secondly addresses. And the secondly addresses can only be configured when the primary address is already exist." ;
                  type enumeration {
                    enum primary {
                      value 1 ;
                      description "this entry's address is primary address." ;
                    }

                    enum secondly {
                      value 2 ;
                      description "this entry's address is escondly address." ;
                    }

                  }

                }

                leaf is-mclag {
                  if-feature mc-lag-address ;

                  description 'Configure the address type. Choose true to make it to be MC-LAG address,or choose false to make it normal.' ;
                  type boolean ;

                  default false ;
                  ncd:revise-date 2021-03-03 ;
                }

                leaf is-extra-mc-lag {
                  if-feature extra-mc-lag-address ;

                  description 'Configure the address type. Choose true to make it to be EXTRA-MC-LAG address,or choose false to make it normal.' ;
                  type boolean ;

                  default false ;
                  ncd:revise-date 2023-07-25 ;
                }

              }

            }

            leaf mtu {
              description 'The maximum transmission unit with IPv4 protocol layer of the interface.

The value of this leaf is the configuration value of IPv4 MTU, may not equal the effect value.
Only particular interfaces have IPv4 MTU. For interfaces that do not have this attribute, this node is not present.' ;
              type uint32 {
                range 0..9600 ;

              }

              units bytes ;
            }

          }

          container ipv6 {
            description 'The parameters of IPv6 protocol on the interface to be configured.

Only particular interfaces support IPv6 protocol. For interfaces that do not support IPv6 protocol, the leafs of this container are not present.' ;
            leaf enable {
              description 'Enable IPv6 protocol on the interface.' ;
              type empty ;

            }

            container addresses {
              description 'The IPv6 addresses of the interface' ;
              list address {
                description 'The list of IPv6 addresses configured on the interface.' ;
                key 'address flag' ;
                leaf address {
                  description "The IPv6 address to which this entry's addressing information pertains." ;
                  type ncd:ipv6-address ;

                }

                leaf flag {
                  description "The IPv6 address type to which this entry's addressing information pertains, which includes linklocal address, anycast address, eui-64 address and unicast address." ;
                  type enumeration {
                    enum link-local {
                      value 1 ;
                      description 'IPv6 linklocal address' ;
                    }

                    enum unicast {
                      value 2 ;
                      description 'IPv6 unicast address' ;
                    }

                    enum anycast {
                      value 3 ;
                      description 'IPv6 anycast address' ;
                    }

                    enum eui-64 {
                      value 4 ;
                      description '64-bit extended unique identifier(EUI-64) address' ;
                    }

                  }

                }

                leaf prefix-len {
                  description "The prefix length to which this entry's addressing information pertains. The value of the mask prefix length is from 1 to 128." ;
                  type ncd:ipv6-mask-length {
                    range 1..128 ;

                  }

                }

                leaf is-mclag {
                  if-feature mc-lag-address ;

                  description 'Configure the address type. Choose true to make it to be MC-LAG address,or choose false to make it normal.' ;
                  type boolean ;

                  default false ;
                  ncd:revise-date 2021-03-03 ;
                }

                leaf is-extra-mc-lag {
                  if-feature extra-mc-lag-address ;

                  description 'Configure the address type. Choose true to make it to be EXTRA-MC-LAG address,or choose false to make it normal.' ;
                  type boolean ;

                  default false ;
                  ncd:revise-date 2023-07-25 ;
                }

              }

            }

            leaf mtu {
              description 'The maximum transmission unit with IPv6 protocol layer of the interface.

The value of this leaf is the configuration value of IPv6 MTU, may not equal the effect value.
Only particular interfaces have IPv6 MTU. For interfaces that do not have this attribute, this node is not present.' ;
              type uint32 {
                range 1280..9600 ;

              }

              units bytes ;
            }

          }

          container load-sharing {
            description 'The parameters of load sharing on the interface to be configured.

Only particular interfaces support load sharing. For interfaces that do not support load sharing, the leafs of this container are not present.' ;
            leaf bandwidth {
              description 'The load sharing bandwidth of the interface

Only particular interfaces support load sharing. For interfaces that do not support load sharing, this node is not present.' ;
              type uint32 {
                range 1..4294967295 ;

              }

              units "kbits / second" ;
            }

            leaf policy {
              description 'The load sharing policy of the interface

Only particular interfaces support load sharing. For interfaces that do not support load sharing, this node is not present.' ;
              type enumeration {
                enum per-destination {
                  value 0 ;
                  description 'The device distributes the packets based on the destination address.' ;
                }

                enum per-packet {
                  value 1 ;
                  description 'The device distributes the packets based on the packets.' ;
                }

              }

            }

            container priority {
              description 'The load sharing priority of the interface for dynamic load sharing.

Only particular interfaces support load sharing. For interfaces that do not support load sharing, the leafs of this container are not present.' ;
              presence "the leaf priority of this container should be mandatory, and other leafs are not." ;
              leaf priority {
                description 'The load sharing priority of the interface for dynamic load sharing. 
The traffic goes through the link with higher priority. When the traffic beyonds the bandwidth of the link, traffic beyonds the limit would go to the link with lower priority.

Only particular interfaces support load sharing. For interfaces that do not support load sharing, this node is not present.' ;
                type uint8 {
                  range 1..7 ;

                }

                mandatory true ;
              }

              leaf level {
                description 'The load sharing priority waterline of the interface for dynamic load sharing. 
When the traffic reaches the waterline*bandwidth of the link, traffic beyonds the limit would go to the link with lower priority.

Only particular interfaces support load sharing. For interfaces that do not support load sharing, this node is not present.' ;
                type uint8 {
                  range 50..95 ;

                }

                default 90 ;
              }

            }

          }

          container if-track {
            description 'The parameters of interface track to be configured.

Only particular interfaces can configure track entries.' ;
            list track {
              description 'The list of interface track entries.

Only particular interfaces can configure track entries.' ;
              key 'name type' ;
              leaf name {
                description 'The name of the track entry' ;
                type string {
                  length 1..31 ;

                }

              }

              leaf type {
                description 'The type of the track entry' ;
                type enumeration {
                  enum l2 {
                    value 1 ;
                    description 'The type of the track entry is layer2.' ;
                  }

                  enum ipv4 {
                    value 2 ;
                    description 'The type of the track entry is IPv4 protocol.' ;
                  }

                  enum ipv6 {
                    value 3 ;
                    description 'The type of the track entry is IPv6 protocol.' ;
                  }

                }

              }

              leaf is-group {
                description 'Describe whether the track entry is group or not.' ;
                type boolean ;

                mandatory true ;
              }

            }

          }

          container multicase-ecmp {
            description 'The parameters of Equal Cost Multipath (ECMP) multicast on the interface to be configured.

Only particular interfaces support ECMP. For interfaces that do not support ECMP, the leafs of this container are not present.' ;
            leaf multicase-ecmp-cost {
              description 'Equal Cost Multipath (ECMP) multicast bandwidth weight of the interface

Only particular interfaces support Equal Cost Multipath (ECMP) multicast bandwidth weight. For interfaces that do not support this attribute, this node is not present.' ;
              type uint8 {
                range 1..8 ;

              }

              default 1 ;
            }

          }

          container port-limit {
            description 'The parameters of qos on the interface to be configured.

Only particular interfaces support qos. For interfaces that do not support qos, the leafs of this container are not present or with the value of 0.' ;
            container high {
              description 'The parameters of high qos on the interface to be configured.

Only particular interfaces support high qos. For interfaces that do not support high qos, the leafs of this container are not present or with the value of 0.' ;
              presence "The parameter cir and cbs should be configured at the same time." ;
              leaf cir {
                description 'The committed information rate of high qos on the interface.

Only particular interfaces have the committed information rate. For interfaces that do not have this rate, this node is not present or with the value of 0.' ;
                type uint32 {
                  range 0..1000000 ;

                }

                units "packets / second" ;
                mandatory true ;
              }

              leaf cbs {
                description 'The committed burst size of high qos on the interface.

Only particular interfaces have the committed burst size. For interfaces that do not have this size, this node is not present or with the value of 0.' ;
                type uint32 {
                  range "0 | 16..100000" {
                    description 'The value of 0 indicates that the effective committed burst size would be adapted by the link layer, which would be different in different devices.' ;
                  }

                }

                units KB ;
                mandatory true ;
              }

            }

            container low {
              description 'The parameters of low qos on the interface to be configured.

Only particular interfaces support low qos. For interfaces that do not support low qos, the leafs of this container are not present or with the value of 0.' ;
              presence "The parameter cir and cbs should be configured at the same time." ;
              leaf cir {
                description 'The committed information rate of low qos on the interface.

Only particular interfaces have the committed information rate. For interfaces that do not have this rate, this node is not present or with the value of 0.' ;
                type uint32 {
                  range 0..1000000 ;

                }

                units "packets / second" ;
                mandatory true ;
              }

              leaf cbs {
                description 'The committed burst size of low qos on the interface.

Only particular interfaces have the committed burst size. For interfaces that do not have this size, this node is not present or with the value of 0.' ;
                type uint32 {
                  range "0 | 16..100000" {
                    description 'The value of 0 indicates that the effective committed burst size would be adapted by the link layer, which would be different in different devices.' ;
                  }

                }

                units KB ;
                mandatory true ;
              }

            }

          }

          container vlan-limit {
            description 'The parameters of VLAN qos on the interface to be configured.

Only particular interfaces support qos. For interfaces that do not support qos, the leafs of this container are not present or with the value of 0.' ;
            container high {
              description 'The parameters of VLAN high qos on the interface to be configured.

Only particular interfaces support high qos. For interfaces that do not support high qos, the leafs of this container are not present or with the value of 0.' ;
              presence "The parameter cir and cbs should be configured at the same time." ;
              leaf cir {
                description 'The committed information rate of VLAN high qos on the interface.

Only particular interfaces have the committed information rate. For interfaces that do not have this rate, this node is not present or with the value of 0.' ;
                type uint32 {
                  range 0..200000 ;

                }

                units "packets / second" ;
                mandatory true ;
              }

              leaf cbs {
                description 'The committed burst size of VLAN high qos on the interface.

Only particular interfaces have the committed burst size. For interfaces that do not have this size, this node is not present or with the value of 0.' ;
                type uint32 {
                  range "0 | 16..20000" {
                    description 'The value of 0 indicates that the effective committed burst size would be adapted by the link layer, which would be different in different devices.' ;
                  }

                }

                units KB ;
                mandatory true ;
              }

            }

            container low {
              description 'The parameters of VLAN low qos on the interface to be configured.

Only particular interfaces support low qos. For interfaces that do not support low qos, the leafs of this container are not present or with the value of 0.' ;
              presence "The parameter cir and cbs should be configured at the same time." ;
              leaf cir {
                description 'The committed information rate of VLAN low qos on the interface.

Only particular interfaces have the committed information rate. For interfaces that do not have this rate, this node is not present or with the value of 0.' ;
                type uint32 {
                  range 0..200000 ;

                }

                units "packets / second" ;
                mandatory true ;
              }

              leaf cbs {
                description 'The committed burst size of VLAN low qos on the interface.

Only particular interfaces have the committed burst size. For interfaces that do not have this size, this node is not present or with the value of 0.' ;
                type uint32 {
                  range "0 | 16..20000" {
                    description 'The value of 0 indicates that the effective committed burst size would be adapted by the link layer, which would be different in different devices.' ;
                  }

                }

                units KB ;
                mandatory true ;
              }

            }

          }

          container track-trigger {
            description 'Set interface track trigger' ;
            presence "the leaf name and track-status of this container should be mandatory, and other leafs are not." ;
            leaf name {
              description 'The name of the track entry' ;
              type string {
                length 1..31 ;

              }

              mandatory true ;
            }

            leaf track-status {
              description 'Block or shutdown the interface' ;
              type enumeration {
                enum block {
                  value 1 ;
                  description 'Block interface' ;
                }

                enum shutdown {
                  value 2 ;
                  description 'Shutdown interface' ;
                }

              }

              mandatory true ;
            }

            leaf is-group {
              description 'Describe whether the track entry is group or not.' ;
              type boolean ;

              mandatory true ;
            }

            leaf period {
              description 'Shutdown time' ;
              type uint16 {
                range 10..600 {
                  description 'shutdown time' ;
                }

              }

              units seconds ;
            }

          }

          leaf type {
            description 'The type of the interface.
When an interface entry is created, a server MAY initialize the type leaf with a valid value, e.g., if it is possible to derive the type from the name of the interface.
the leaf can only be read.' ;
            type uint16 ;

          }

          container off-line {
            description 'Indicates whether the physical state is off-line for the interface.' ;
            leaf off-line {
              description 'Indicates whether the physical state is off-line for the interface.' ;
              type empty ;

            }

          }

          leaf index {
            description 'The index of the interface.
the leaf can only be read.' ;
            type uint32 ;

            ncd:revise-date 2017-04-10 ;
          }

          container mode {
            description 'Configure the mode of interfaces' ;
            leaf type {
              description 'Configure the mode of interface virtual_template' ;
              type enumeration {
                enum ppp {
                  value 1 ;
                  description 'ppp mode' ;
                }

                enum ps-core {
                  value 2 ;
                  description 'ps-core mode' ;
                }

              }

            }

            ncd:revise-date 2017-09-09 ;
          }

          container byname-set {
            description 'The parameters of byname on the interface to be configured.' ;
            leaf byname {
              description 'Associates byname with the interface.
Only particular interfaces support byname. For interfaces that do not support byname, the leafs of this container are not present.' ;
              type string {
                length 1..32 ;

              }

            }

            ncd:revise-date 2018-06-22 ;
          }

          leaf chinese-description {
            if-feature chinese-desc ;

            description 'A textual chinese description of the interface.This string should include the name of the
manufacturer, the product name and the version of the interface hardware/software.' ;
            type ncd:string-with-blank-and-chinese {
              length 1..242 ;

            }

            ncd:revise-date 2019-07-02 ;
          }

          container bandwidth-set {
            description 'The parameters of bandwidth on the interface to be configured.' ;
            leaf bandwidth {
              description 'The bandwidth of the interface

Only particular interfaces support bandwidth. For interfaces that do not support bandwidth, this node is not present.' ;
              type uint32 {
                range 1..1000000 ;

              }

              units "mbits / second" ;
            }

            ncd:revise-date 2019-08-13 ;
          }

          container channel-bandwidth {
            if-feature channel-bandwidth ;

            description 'The parameters of channel bandwidth on the interface to be configured.' ;
            leaf bandwidth {
              description 'The channel bandwidth of the interface.' ;
              type uint32 {
                range 0..1000000 ;

              }

              units "mbits / second" ;
            }

            ncd:revise-date 2021-10-12 ;
          }

          ncd:select name ;
          ncd:select type ;
          ncd:select index ;
        }

      }

      container pw-configuration {
        description 'Describe the parameters of pseudo wires to be configured' ;
        list pw {
          description 'The list of pseudo wires for configuring parameters' ;
          key name ;
          leaf name {
            description 'The name of the pseudo wire' ;
            type ncd:ifname ;

          }

        }

      }

      container ip-address {
        description 'Configure the interface IP/IPv6 address characters.' ;
        leaf primary-secondary {
          if-feature ip-address-primary-sec ;

          description 'Configure the interface IP address primary-secondary mode.' ;
          type enumeration {
            enum enable {
              value 1 ;
              description 'Enable IP address primary-secondary mode.' ;
            }

            enum disable {
              value 0 ;
              description 'Disable IP address primary-secondary mode.' ;
            }

          }

        }

        ncd:revise-date 2019-02-18 ;
      }

      container shutdown-interface {
        description 'Configuration about interfaces which configed shutdown command.' ;
        leaf alarm-shield {
          if-feature shutdown-interface-alarm-shield ;

          description 'Interface alarm shield funciton.' ;
          type enumeration {
            enum enable {
              value 1 ;
              description 'Enable the alarm sheild function.' ;
            }

            enum disable {
              value 0 ;
              description 'Disable alarm sheild function.' ;
            }

          }

        }

        ncd:revise-date 2020-06-29 ;
      }

    }

  }

  container state {
    config false ;
    description 'Data nodes for the operational state of interfaces.' ;
    container interfaces {
      description 'Describe the data nodes for the operational state of interfaces.' ;
      list interface {
        description 'The list of interfaces on the device' ;
        key name ;
        leaf name {
          description 'The name of the interface.

This leaf MAY be mapped to ifName by an implementation. Such an implementation MUST restrict the values for this leaf so that it matches the restrictions of ifName.' ;
          reference "RFC 2863: The Interfaces Group MIB - ifName" ;
          type leafref {
            path "/configuration/interfaces/interface-configuration/interface/name" ;
          }

        }

        leaf admin-status {
          description 'The desired state of the interface.

This leaf has the same semantics as ifAdminStatus.' ;
          reference "RFC 2863: The Interfaces Group MIB - ifAdminStatus" ;
          type enumeration {
            enum down {
              value 0 ;
              description 'The desired state of the interface is down.' ;
            }

            enum up {
              value 1 ;
              description 'The desired state of the interface is up.' ;
            }

          }

        }

        leaf phy-status {
          description 'The physical state of the interface.' ;
          type enumeration {
            enum down {
              value 0 ;
              description 'The physical state of the interface is down.' ;
            }

            enum up {
              value 1 ;
              description 'The physical state of the interface is up.' ;
            }

          }

        }

        leaf oper-status {
          description 'The current operational state of the interface.

This leaf has the same semantics as ifOperStatus.' ;
          reference "RFC 2863: The Interfaces Group MIB - ifOperStatus" ;
          type enumeration {
            enum down {
              value 0 ;
              description 'The current operational state of the interface is down.' ;
            }

            enum up {
              value 1 ;
              description 'The current operational state of the interface is up.' ;
            }

          }

        }

        leaf speed {
          description "An estimate of the interface's current bandwidth in bits per second." ;
          reference "RFC 2863: The Interfaces Group MIB ifSpeed, ifHighSpeed" ;
          type uint64 ;

          units "bits / second" ;
        }

        leaf duplex-mode {
          description 'The duplex mode of the interface.

Only the physical interfaces with ether type have duplex mode. For interfaces that do not have duplex mode, this node is not present or with the value of n/a.' ;
          type enumeration {
            enum "duplex/auto" {
              value 0 ;
              description 'The duplex mode of the interface is auto negotiation.' ;
            }

            enum "duplex/full" {
              value 1 ;
              description 'The duplex mode of the interface is full duplex.' ;
            }

            enum "duplex/half" {
              value 2 ;
              description 'The duplex mode of the interface is half duplex.' ;
            }

            enum "n/a" {
              value 255 ;
              description 'The interface does not have the duplex mode.' ;
            }

          }

        }

        leaf mtu {
          description 'The maximum transmission unit with link layer of the interface.

The value of this leaf is the effective value of MTU, may not equal the configuration value.
Only particular interfaces have MTU. For interfaces that do not have this attribute, this node is not present.
This leaf has the same semantics as ifMtu.' ;
          reference "RFC 2863: The Interfaces Group MIB - ifMtu" ;
          type uint32 {
            range 0..9700 ;

          }

          units bytes ;
        }

        leaf mpls-mtu {
          description 'The maximum transmission unit with MPLS protocol layer of the interface.

The value of this leaf is the effective value of MPLS MTU, may not equal the configuration value.
Only particular interfaces have MPLS MTU. For interfaces that do not have this attribute, this node is not present.' ;
          type uint32 {
            range 68..9600 ;

          }

          units bytes ;
        }

        leaf ip-mtu {
          description 'The maximum transmission unit with IPv4 protocol layer of the interface.

The value of this leaf is the effective value of IPv4 MTU, may not equal the configuration value.
Only particular interfaces have IPv4 MTU. For interfaces that do not have this attribute, this node is not present.' ;
          type uint32 {
            range 0..9600 ;

          }

          units bytes ;
        }

        leaf ipv6-mtu {
          description 'The maximum transmission unit with IPv6 protocol layer of the interface.

The value of this leaf is the effective value of IPv6 MTU, may not equal the configuration value.
Only particular interfaces have IPv6 MTU. For interfaces that do not have this attribute, this node is not present.' ;
          type uint32 {
            range 1280..9600 ;

          }

          units bytes ;
        }

        leaf ipv4-oper-status {
          description 'The current IPv4 protocol operational state of the interface.' ;
          type enumeration {
            enum down {
              value 0 ;
              description 'The current IPv4 protocol operational state of the interface is down.' ;
            }

            enum up {
              value 1 ;
              description 'The current IPv4 protocol operational state of the interface is up.' ;
            }

          }

        }

        leaf ipv6-oper-status {
          description 'The current IPv6 protocol operational state of the interface.' ;
          type enumeration {
            enum down {
              value 0 ;
              description 'The current IPv4 protocol operational state of the interface is down.' ;
            }

            enum up {
              value 1 ;
              description 'The current IPv4 protocol operational state of the interface is up.' ;
            }

          }

        }

        leaf phys-address {
          description 'The MAC address of the interface.

Only the interfaces with ether type have such an address. For interfaces which do not have such an address (e.g., a serial line), this node should not be present or with the value of zero.' ;
          reference "RFC 2863: The Interfaces Group MIB - ifPhysAddress" ;
          type ncd:mac-address ;

        }

        leaf photo-electricity {
          description 'The photoelectric property of the interface.

Only the physical interfaces with ether type have photoelectric property. For interfaces that do not have photoelectric property, this node is not present or with the value of n/a.' ;
          type enumeration {
            enum optical {
              value 0 ;
              description 'The photoelectric property of the interface is optical.' ;
            }

            enum electric {
              value 1 ;
              description 'The photoelectric property of the interface is electric.' ;
            }

            enum "n/a" {
              value 2 ;
              description 'The interface does not have the photoelectric property.' ;
            }

            enum "pho&elec" {
              value 3 ;
              description 'The photoelectric property of the interface is optical and electronic hybrid.' ;
            }

          }

        }

        container interface-statistics {
          description 'Describe the data nodes for the operational state of interface statistics.' ;
          container common-statistics {
            description 'Describe the data nodes for the operational state of common interface statistics.' ;
            leaf last-clear-time {
              description 'The last clear traffic statistics time.' ;
              type ncd:datetime ;

            }

            leaf last-update-time {
              description 'The last time of system update new data.' ;
              type ncd:datetime ;

            }

            leaf input-bytes-rate {
              description 'The average vlaue of receive bytes rate among 120 seconds.' ;
              type uint64 ;

            }

            leaf input-pkts-rate {
              description 'The average vlaue of receive packets rate among 120 seconds.' ;
              type uint64 ;

            }

            leaf output-bytes-rate {
              description 'The average vlaue of sending bytes rate among 120 seconds.' ;
              type uint64 ;

            }

            leaf output-pkts-rate {
              description 'The average vlaue of sending packets rate among 120 seconds.' ;
              type uint64 ;

            }

            leaf input-rate-peak {
              description 'The peak vlaue of receiving bytes rate.' ;
              type uint64 ;

            }

            leaf input-rate-peak-time {
