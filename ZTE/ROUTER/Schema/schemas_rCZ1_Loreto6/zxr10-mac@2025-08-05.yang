            }

            leaf lacp {
              description 'LACP protocol control policy.' ;
              type enumeration {
                enum disable {
                  value 0 ;
                  description 'LACP not tunnelled.' ;
                }

                enum enable {
                  value 1 ;
                  description 'LACP tunnelled.' ;
                }

              }

              default disable ;
            }

            choice stp {
              description 'STP protocol control policy.' ;
              default not-tunnelled ;
              case not-tunnelled {
                description 'Not tunnelled.' ;
                leaf stp-not-tunnelled-flag {
                  description 'Not tunnelled.' ;
                  type enumeration {
                    enum not-tunnelled {
                      value 0 ;
                      description 'Not tunnelled.' ;
                    }

