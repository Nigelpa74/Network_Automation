module zxr10-mac {
  namespace "http://www.zte.com.cn/zxr10/netconf/schema/rosng/mac" ;
  prefix mac ;
  yang-version 1 ;
  import zxr10-netconf-defs {
    prefix ncd ;
  }

  organization "ZTE Corporation" ;
  contact "ZTE Corporation
  Nanjing Institute of ZTE Corporation
  No.68 Zijinghua Rd. Yuhuatai District, Nanjing, China
  Tel: +86-25-52870000" ;
  description 'The netconf module to describe MAC.' ;
  revision 2025-08-05 {
    description '1.Add a filter based on instance-name and vlan-id conditions in /mac:state/mac:mac/mac:mac-vpls-tables/mac:mac-vpls-table/ncd:select.
2.Add a filter based on instance-name and mac-address conditions in /mac:state/mac:mac/mac:mac-vpls-tables/mac:mac-vpls-table/ncd:select.
3.Add a filter based on vlan-id and mac-address conditions in /mac:state/mac:mac/mac:mac-vpls-tables/mac:mac-vpls-table/ncd:select.' ;
  }

  revision 2025-02-24 {
    description '1.Add a leaf /mac:configuration/mac:mac/mac:global-config/mac:l2-permanent-notify-enable.' ;
  }

  revision 2024-12-25 {
