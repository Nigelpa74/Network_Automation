      container global-config {
        description 'MAC global configuration.' ;
        leaf learn-enable {
          description 'Global MAC learn configuration.' ;
          type enumeration {
            enum disable {
              value 0 ;
              description 'Disable MAC learn.' ;
            }

            enum enable {
              value 1 ;
              description 'Enable MAC learn.' ;
            }

          }

          default enable ;
        }

        leaf max-mac-num {
          description 'Maximum MAC entries.' ;
          type uint32 {
            range 1..4294967295 {
              description 'Minimum is 1. Maximum and default is defined by performance parameter.' ;
            }

          }

        }

        leaf higig-learn {
          description 'Higig learn configuration.' ;
          type enumeration {
            enum disable {
              value 0 ;
              description 'Disable higig learn.' ;
            }

            enum enable {
              value 1 ;
              description 'Enable higig learn.' ;
            }

          }

          default enable ;
        }

        leaf aging-time {
          description 'MAC aging time.' ;
          type uint32 {
            range "0|10..65535" {
              description 'Unit:Second.0:disable aging.Minimum, maximum and default are defined by performance parameter.' ;
            }

          }

          units second ;
        }

        leaf alarm-threshold {
          description 'When the percent of learned MAC exceed the configuration, alarm.' ;
          type uint8 {
            range 1..100 {
              description 'Percent.' ;
            }

          }

          units percent ;
          default 80 ;
        }

        leaf clear-threshold {
          description 'When the percent of learned MAC is less than the configuration, alarm will be cleared.' ;
          type uint8 {
            range 1..100 {
              description 'Percent.' ;
            }

          }

          units percent ;
          default 72 ;
          ncd:revise-date 2022-11-16 ;
        }

        leaf default-priority-movable {
          description 'The switch of MAC movable in default priority.' ;
          type enumeration {
            enum enable {
              value 0 ;
              description 'Can move.' ;
            }

            enum disable {
              value 1 ;
              description 'Can not move.' ;
            }

          }

          default enable ;
        }

        leaf lower-priority-movable {
          description 'The switch of MAC movable in lower priority.' ;
          type enumeration {
            enum enable {
              value 0 ;
              description 'Can move.' ;
            }

            enum disable {
              value 1 ;
              description 'Can not move.' ;
            }

          }

          default enable ;
        }

        leaf normal-priority-movable {
          description 'The switch of MAC movable in normal priority.' ;
          type enumeration {
            enum enable {
              value 0 ;
              description 'Can move.' ;
            }

            enum disable {
              value 1 ;
              description 'Can not move.' ;
            }

          }

          default enable ;
        }

        leaf higher-priority-movable {
          description 'The switch of MAC movable in higher priority.' ;
          type enumeration {
            enum enable {
              value 0 ;
              description 'Can move.' ;
            }

            enum disable {
              value 1 ;
              description 'Can not move.' ;
            }

          }

          default enable ;
        }

        leaf exceed-limit-action {
          description 'The action when MAC entries is exceeding the maximum.' ;
          type enumeration {
            enum forward {
              value 0 ;
              description 'Forward.' ;
            }

            enum drop {
              value 1 ;
              description 'Drop.' ;
            }

          }

          default forward ;
        }

        leaf safe-mode-policy {
          description 'Safe mode policy.' ;
          type enumeration {
            enum disable {
              value 0 ;
              description 'Disable the policy.' ;
            }

            enum enable-alarm {
              value 1 ;
              description 'Alarm when the MAC move is illegal.' ;
            }

            enum enable-block {
              value 2 ;
              description 'Block the interface when the MAC move is illegal.' ;
            }

            enum enable-shutdown {
              value 3 ;
              description 'Shutdown the interface when the MAC move is illegal.' ;
            }

            enum enable-no-alarm {
              value 4 ;
              description 'Not alarm when the MAC move is illegal.' ;
            }

          }

          default disable ;
        }

        leaf auto-write-topermanent {
          description 'Configuration of auto writing to-permanent MAC to file.' ;
          type enumeration {
            enum disable {
              value 0 ;
              description 'Do not auto write.' ;
            }

            enum enable {
              value 1 ;
              description 'Auto write.' ;
            }

          }

          default disable ;
        }

        leaf auto-write-topermanent-interval {
          description 'Interval of auto writing to-permanent MAC.' ;
          type uint32 {
            range 1..14400 {
              description '1-14400 minutes.' ;
            }

          }

          units minute ;
          default 1440 ;
        }

        leaf forbidden-mac-reaction {
          description 'Reaction when learned forbidden MAC.' ;
          type enumeration {
            enum no-alarm {
              value 0 ;
              description 'NO alarm.' ;
            }

            enum alarm {
              value 1 ;
              description 'Alarm.' ;
            }

          }

          default no-alarm ;
        }

        leaf learn-disable-action {
          description 'Action when leaning MAC is disabled.' ;
          type enumeration {
            enum forward {
              value 0 ;
              description 'Forward.' ;
            }

            enum drop {
              value 1 ;
              description 'Drop.' ;
            }

          }

          default forward ;
        }

        leaf mac-update-notify {
          description 'Notify switch of MAC update.' ;
          type enumeration {
            enum disable {
              value 0 ;
              description 'Disable notify.' ;
            }

            enum enable {
              value 1 ;
              description 'Enable notify.' ;
            }

          }

          default disable ;
        }

        leaf mac-notify-interval {
          description 'Interval of notify.' ;
          type uint32 {
            range 5..86400 {
              description '5-86400 seconds.' ;
            }

          }

          units second ;
          default 300 ;
        }

        leaf notify-max-mac-num {
          description 'Maximum notified MAC count.' ;
          type uint32 {
            range 1..300 {
              description 'Maximum count must be in this range.' ;
            }

          }

          default 50 ;
        }

        leaf flap-period {
          description 'MAC flap period.' ;
          type uint8 {
            range 1..100 ;

          }

          units second ;
          default 10 ;
          ncd:revise-date 2024-04-11 ;
        }

        leaf flap-count {
          description 'MAC flap count.' ;
          type uint8 {
            range 1..100 ;

          }

          default 3 ;
          ncd:revise-date 2024-04-11 ;
        }

        leaf continuous-period {
          description 'Number of MAC flap continuous periods.' ;
          type uint8 {
            range 1..10 ;

          }

          default 3 ;
          ncd:revise-date 2024-04-11 ;
        }

        leaf l2-permanent-notify-enable {
          type enumeration {
            enum enable {
              value 1 ;
              description 'Enable l2-permanent MAC notify.' ;
            }

            enum disable {
              value 0 ;
              description 'Disable l2-permanent MAC notify.' ;
            }

          }

          description 'l2-permanent MAC notify Enable.' ;
          default disable ;
          ncd:revise-date 2025-02-24 ;
        }

        container auto-adapt-aging {
          description 'MAC adaptive aging function.' ;
          presence auto-adapt-aging ;
          leaf aging-time-auto-adapt {
            description 'MAC auto adapt aging time.' ;
            type uint32 {
              range 30..360 {
                description 'Unit:Second.Minimum is 30 seconds. Maximum is 360 seconds.' ;
              }

            }

            units second ;
            mandatory true ;
          }

          leaf threshold {
            description 'When the percent of MAC exceed the configuration, the system switches to the adaptive aging mode.' ;
            type uint8 {
              range 1..100 {
                description 'Percent.' ;
              }

            }

            units percent ;
            mandatory true ;
          }

          leaf hold-off {
            description 'MAC auto adapt aging hold off time.' ;
            type uint32 {
              range 0..3600 {
                description 'Unit:Second.Minimum is 0 seconds. Maximum is 3600 seconds.' ;
              }

            }

            units second ;
            mandatory true ;
          }

          ncd:revise-date 2021-08-24 ;
        }

      }

      container port-config {
        description 'MAC interface configuration.' ;
        list mac-port-config {
          description 'MAC interface configuration.' ;
          key if-name ;
          leaf if-name {
            description 'Interface name.' ;
            type ncd:ifname {
              length 1..31 {
                description 'The length of interface name.' ;
              }

            }

          }

          leaf learn-enable {
            description 'MAC learn switch.' ;
            type enumeration {
              enum disable {
                value 0 ;
                description 'Disable MAC learn.' ;
              }

              enum enable {
                value 1 ;
                description 'Enable MAC learn.' ;
              }

            }

            default enable ;
          }

          leaf max-mac-num {
            description 'Maximum MAC entries.' ;
            type uint32 {
              range 1..4294967295 {
                description 'Minimum is 1. Maximum and default is defined by performance parameter.' ;
              }

            }

          }

          leaf learn-priority {
            description 'Interface learn priority.' ;
            type enumeration {
              enum default {
                value 0 ;
                description 'Default priority.' ;
              }

              enum lower {
                value 1 ;
                description 'Lower priority.' ;
              }

              enum normal {
                value 2 ;
                description 'Normal priority.' ;
              }

              enum higher {
                value 3 ;
                description 'Higher priority.' ;
              }

            }

            default default ;
          }

          leaf exceed-limit-action {
            description 'The action when MAC entries is exceeding the maximum.' ;
            type enumeration {
              enum forward {
                value 0 ;
                description 'Forward.' ;
              }

              enum drop {
                value 1 ;
                description 'Drop.' ;
              }

              enum shutdown {
                value 2 ;
                description 'Shutdown interface.' ;
              }

            }

            default forward ;
          }

          leaf safe-mode-policy {
            description 'Safe mode policy.' ;
            type enumeration {
              enum disable {
                value 0 ;
                description 'Disable the policy.' ;
              }

              enum enable-alarm {
                value 1 ;
                description 'Alarm when the MAC move is illegal.' ;
              }

              enum enable-block {
                value 2 ;
                description 'Block the interface when the MAC move is illegal.' ;
              }

              enum enable-shutdown {
                value 3 ;
                description 'Shutdown the interface when the MAC move is illegal.' ;
              }

              enum enable-no-alarm {
                value 4 ;
                description 'Not alarm when the MAC move is illegal.' ;
              }

            }

            default disable ;
          }

          leaf to-permanent-enable {
            description 'Whether dynamic MAC can turn into permanent.' ;
            type enumeration {
              enum disable {
                value 0 ;
                description 'Disable change.' ;
              }

              enum enable {
                value 1 ;
                description 'Enable change.' ;
              }

            }

            default disable ;
          }

          leaf learn-disable-action {
            description 'Action when leaning MAC is disabled.' ;
            type enumeration {
              enum forward {
                value 0 ;
                description 'Forward.' ;
              }

              enum drop {
                value 1 ;
                description 'Drop.' ;
              }

            }

            default forward ;
          }

          leaf mac-update-notify {
            description 'Notify switch of MAC update.' ;
            type enumeration {
              enum disable {
                value 0 ;
                description 'Disable notify.' ;
              }

              enum enable {
                value 1 ;
                description 'Enable notify.' ;
              }

            }

            default disable ;
          }

          leaf dampening-policy {
            description 'Dampening policy when MAC moves.' ;
            type enumeration {
              enum none {
                value 0 ;
                description 'No policy.' ;
              }

              enum shutdown {
                value 1 ;
                description 'Shutdown policy.' ;
              }

            }

            default none ;
            ncd:revise-date 2016-06-07 ;
          }

          leaf dampening-timeout {
            description 'Dampening timeout when MAC moves.' ;
            type uint32 {
              range 0..300 {
                description '0-300 senconds, 0 means infinite.' ;
              }

            }

            units second ;
            default 60 ;
            ncd:revise-date 2016-06-07 ;
          }

          choice port-security-switch {
            case port-security-enable {
              description 'Enable port security.' ;
              leaf port-security-enable {
                type enumeration {
                  enum enable {
                    value 1 ;
                    description 'Enable MAC port security.' ;
                  }

                }

                description 'MAC port security enable.' ;
                mandatory true ;
              }

              leaf port-security-max-mac-num {
                description 'Port security maximum MAC count.' ;
                type uint32 {
                  range 1..10 {
                    description 'Minimum is 1. Maximum is 10.' ;
                  }

                }

                default 1 ;
              }

            }

            case port-security-disable {
              description 'Disable port security.' ;
              leaf port-security-disable {
                type enumeration {
                  enum disable {
                    value 0 ;
                    description 'Disable MAC port security.' ;
                  }

                }

                description 'MAC port security disable.' ;
                mandatory true ;
              }

            }

            description 'MAC port security switch.' ;
            ncd:revise-date 2024-08-13 ;
          }

          leaf port-security-aging-enable {
            description 'MAC port security aging time switch.' ;
            type enumeration {
              enum disable {
                value 0 ;
                description 'Disable MAC port security aging time.' ;
              }

              enum enable {
                value 1 ;
                description 'Enable MAC port security aging time.' ;
              }

            }

            default disable ;
            ncd:revise-date 2024-08-13 ;
          }

          leaf port-security-policy {
            type enumeration {
              enum alarm {
                value 0 ;
                description 'Alarm policy.' ;
              }

              enum drop {
                value 1 ;
                description 'Drop policy.' ;
              }

              enum shutdown {
                value 2 ;
                description 'Shutdown policy.' ;
              }

            }

            description 'Protect policy for MAC port security.' ;
            default alarm ;
            ncd:revise-date 2024-08-13 ;
          }

          container alarm-cfg {
            description 'MAC alarm configuration.' ;
            presence alarm-cfg ;
            leaf alarm-threshold {
              description 'MAC alarm threshold of interface.' ;
              type uint8 {
                range 1..100 {
                  description 'Percentage.' ;
                }

              }

              units percent ;
              mandatory true ;
            }

            leaf clear-threshold {
              description 'MAC clear threshold of interface.' ;
              type uint8 {
                range 1..100 {
                  description 'Percentage.' ;
                }

              }

              units percent ;
              mandatory true ;
            }

            ncd:revise-date 2022-12-06 ;
          }

        }

      }

      container vlan-config {
        description 'MAC VLAN configuration.' ;
        list mac-vlan-config {
          description 'MAC VLAN configuration.' ;
          key vlan-id ;
          leaf vlan-id {
            description 'VLAN ID.' ;
            type uint16 {
              range 1..4094 {
                description 'VLAN ID must be in this range.' ;
              }

            }

          }

          leaf learn-enable {
            description 'MAC learn configuration.' ;
            type enumeration {
              enum disable {
                value 0 ;
                description 'Disable MAC learn.' ;
              }

              enum enable {
                value 1 ;
                description 'Enable MAC learn.' ;
              }

            }

            default enable ;
          }

          leaf max-mac-num {
            description 'Maximum MAC entries.' ;
            type uint32 {
              range 1..4294967295 {
                description 'Minimum is 1. Maximum and default is defined by performance parameter.' ;
              }

            }

          }

          leaf exceed-limit-action {
            description 'The action when MAC entries is exceeding the maximum.' ;
            type enumeration {
              enum forward {
                value 0 ;
                description 'Forward.' ;
              }

              enum drop {
                value 1 ;
                description 'Drop.' ;
              }

            }

            default forward ;
          }

          leaf learn-disable-action {
            description 'Action when leaning MAC is disabled.' ;
            type enumeration {
              enum forward {
                value 0 ;
                description 'Forward.' ;
              }

              enum drop {
                value 1 ;
                description 'Drop.' ;
              }

            }

            default forward ;
          }

          container alarm-cfg {
            description 'MAC alarm configuration.' ;
            presence alarm-cfg ;
            leaf alarm-threshold {
              description 'MAC alarm threshold of VLAN.' ;
              type uint8 {
                range 1..100 {
                  description 'Percentage.' ;
                }

              }

              units percent ;
              mandatory true ;
            }

            leaf clear-threshold {
              description 'MAC clear threshold of VLAN.' ;
              type uint8 {
                range 1..100 {
                  description 'Percentage.' ;
                }

              }

              units percent ;
              mandatory true ;
            }

            ncd:revise-date 2022-12-06 ;
          }

        }

      }

      container forbidden-mac {
        description 'Forbidden MAC configuration.' ;
        list mac-forbidden-mac {
          description 'Forbidden MAC configuration.' ;
          key session-id ;
          leaf session-id {
            description 'Session ID.' ;
            type uint32 {
              range 1..256 {
                description 'Session ID must be in this range.' ;
              }

            }

          }

          leaf mac-address {
            description 'MAC address.' ;
            type ncd:mac-address ;

            mandatory true ;
          }

        }

      }

      container forbidden-bind-port {
        description 'Forbidden interface of learning MAC.' ;
        list mac-forbidden-bind-port {
          description 'Forbidden interface of learning MAC.' ;
          key 'if-name session-id' ;
          leaf if-name {
            description 'Interface name.' ;
            type ncd:ifname {
              length 1..31 {
                description 'The length of interface name.' ;
              }

            }

          }

          leaf session-id {
            description 'Session ID.' ;
            type uint32 {
              range 1..256 {
                description 'Session ID must be in this range.' ;
              }

            }

          }

        }

      }

    }

  }

  container operation {
    description 'Operation of MAC.' ;
    config false ;
    container mac {
      description 'Operation of MAC.' ;
      container delete-vpls-dynamic-macs {
        description 'Delete VPLS dynamic MAC entries.' ;
        list delete-vpls-dynamic-mac {
          description 'Delete VPLS dynamic MAC entries.' ;
          key instace-name ;
          leaf instace-name {
            description 'VPLS instance name.' ;
            type string {
              length 1..32 {
                description 'The length of VPLS instance name.' ;
              }

            }

          }

          leaf vlan-id {
            description 'VLAN ID.' ;
            type uint16 {
              range 1..4094 {
                description 'VLAN ID.' ;
              }

            }

          }

          leaf mac-address {
            description 'MAC address.' ;
            type ncd:mac-address ;

          }

          leaf if-name {
            description 'Interface name.' ;
            type ncd:ifname {
              length 1..31 {
                description 'The length of interface name.' ;
              }

            }

          }

        }

      }

      container to-statics {
        description 'To-static dynamic MAC address.' ;
        list to-static {
          description 'To-static dynamic MAC address.' ;
          key to-static-flag ;
          leaf to-static-flag {
            description 'To-static flag.' ;
            type enumeration {
              enum enable {
                value 7 ;
                description 'To-static MAC item.' ;
              }

              enum disable {
                value 8 ;
                description 'No to-static MAC item.' ;
              }

            }

          }

          leaf if-name {
            description 'Interface name.' ;
            type ncd:ifname {
              length 1..31 {
                description 'The length of interface name.' ;
              }

            }

          }

          leaf mac-address {
            description 'MAC address.' ;
            type ncd:mac-address ;

          }

        }

      }

      container delete-normal-no-config-mac {
        description 'Delete no-config MAC entries.' ;
        leaf if-name {
          description 'Interface name.' ;
          type ncd:ifname {
            length 1..31 {
              description 'The length of interface name.' ;
            }

          }

        }

        leaf vlan-id {
          description 'VLAN ID.' ;
          type uint16 {
            range 1..4094 {
              description 'VLAN ID must be in this range.' ;
            }

          }

        }

        leaf mac-address {
          description 'MAC address.' ;
          type ncd:mac-address ;

        }

        leaf nickname {
          description 'Nickname of TRILL MAC.' ;
          type uint16 {
            range 1..65471 {
              description 'Nickname must be in this range.' ;
            }

          }

        }

      }

      container delete-vxlan-no-config-mac {
        description 'Delete no-config VXLAN MAC.' ;
        status obsolete {
          ncd:revise-date 2017-11-15 ;
        }

        leaf mac-address {
          description 'MAC address.' ;
          type ncd:mac-address ;

        }

        leaf vlan-id {
          description 'VLAN ID.' ;
          status obsolete {
            ncd:revise-date 2016-08-11 ;
          }

          type uint16 {
            range 1..4094 {
              description 'VLAN ID must be in this range.' ;
            }

          }

        }

        leaf if-name {
          description 'Interface name.' ;
          type ncd:ifname {
            length 1..31 {
              description 'The length of interface name.' ;
            }

          }

        }

        leaf vxlan-id {
          description 'VXLAN ID.' ;
          type uint32 {
            range 1..16777215 {
              description 'VXLAN ID range.' ;
            }

          }

        }

      }

      container learn-priority-policy {
        description 'Set policies of learn priority.' ;
        presence learn-priority-policy ;
        leaf if-name {
          description 'Interface name.' ;
          type ncd:ifname {
            length 1..31 {
              description 'The length of interface name.' ;
            }

          }

          mandatory true ;
        }

        leaf no-shutdown {
          description 'Bring the interface to up.' ;
          type empty ;

          mandatory true ;
        }

        ncd:revise-date 2016-06-07 ;
      }

      container no-block-interface {
        description 'Canceling Interface Blocking.' ;
        presence no-block-interface ;
        leaf if-name {
          description 'Interface name.' ;
          type ncd:ifname ;

          mandatory true ;
        }

        leaf no-block {
          description 'Canceling Blocking.' ;
          type empty ;

          mandatory true ;
        }

        ncd:revise-date 2023-01-09 ;
      }

    }

  }

}
