                }

              }

              case tunnelled {
                description 'Tunnelled.' ;
                leaf stp-tunnelled-flag {
                  description 'Tunnelled.' ;
                  type enumeration {
                    enum tunnelled {
                      value 1 ;
                      description 'Tunnelled.' ;
                    }

                  }

                  default tunnelled ;
                }

              }

              case tunnelled-monitored {
                description 'Tunnelled and monitored.' ;
                leaf stp-tunnelled-monitored-flag {
                  description 'Tunnelled and monitored.' ;
                  type enumeration {
                    enum tunnelled-monitored {
                      value 3 ;
                      description 'Tunnelled and monitored.' ;
                    }

