          leaf port-security-enable {
            type enumeration {
              enum disable {
                value 0 ;
                description 'Disable MAC port security.' ;
              }

              enum enable {
                value 1 ;
                description 'Enable MAC port security.' ;
              }

            }

            description 'Port security switch.' ;
            default disable ;
          }

          leaf port-status {
            type enumeration {
              enum secure-down {
                value 1 ;
                description 'Port security down.' ;
              }

              enum secure-up {
                value 0 ;
                description 'Port security up.' ;
              }

            }

            description 'Port status.' ;
            default secure-up ;
          }

          leaf port-protect-action {
            description 'Protect policy for MAC port security.' ;
