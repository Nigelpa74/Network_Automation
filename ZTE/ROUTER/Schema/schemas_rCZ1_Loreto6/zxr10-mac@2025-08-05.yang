            type uint32 ;

            description 'Port security aging time.' ;
            units second ;
            default 0 ;
          }

          leaf max-mac-count {
            type uint32 ;

            description 'Maximum MAC addresses count.' ;
            default 1 ;
          }

          leaf total-mac-count {
