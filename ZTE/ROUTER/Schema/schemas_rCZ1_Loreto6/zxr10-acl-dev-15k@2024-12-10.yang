      }

    }

  }

  deviation "/acl:configuration/acl:acl/acl:templates/acl:udf-template-generals/acl:udf-template-general/acl:format/acl:segment8/acl:offset8" {
    description 'Configure offset' ;
    deviate replace {
      type uint8 {
