    }

  }

  deviation "/acl:configuration/acl:acl/acl:access-list/acl:ipv6-mixed-access-list/acl:rule/acl:src-mac-addr/acl:src-mac-range" {
    deviate not-supported ;

    description 'Source MAC address range.' ;
  }

  deviation "/acl:configuration/acl:acl/acl:access-list/acl:ipv6-mixed-access-list/acl:rule/acl:dest-mac-addr/acl:dest-mac-range" {
    deviate not-supported ;

    description 'Destination MAC address range.' ;
  }

}
