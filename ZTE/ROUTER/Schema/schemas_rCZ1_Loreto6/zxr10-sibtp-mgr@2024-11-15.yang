              description 'The source port.' ;
              type uint32 {
                range 1025..65535 ;

              }

            }

            leaf peer-port {
              description 'The peer port.' ;
              type uint32 {
                range 1025..65535 ;

              }

            }

            leaf tcp-mss {
              description 'The tcp mss.' ;
              type uint32 {
                range 68..10000 ;

              }

              default 1400 ;
            }

          }

        }

        container link-ipv4-vrf-list {
          description 'The link ipv4 vrf list.' ;
          list link-ipv4-vrf {
            description 'The ipv4 vrf link.' ;
            key 'source-ipv4 peer-ipv4 source-port peer-port vrf-name' ;
            leaf source-ipv4 {
              description 'The source ipv4.' ;
              type ncd:ipv4-address-none-zero ;

            }

            leaf peer-ipv4 {
              description 'The peer ipv4.' ;
              type ncd:ipv4-address-none-zero ;

            }

            leaf source-port {
              description 'The source port.' ;
              type uint32 {
