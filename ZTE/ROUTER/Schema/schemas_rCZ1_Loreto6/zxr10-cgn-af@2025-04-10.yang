module zxr10-cgn-af {
  namespace "http://www.zte.com.cn/zxr10/netconf/schema/rosng/cgn-af" ;
  prefix cgn-af ;
  yang-version 1 ;
  import zxr10-netconf-defs {
    prefix ncd ;
    revision-date 2017-08-15 ;
  }

  organization "ZTE Corporation" ;
  contact "ZTE Corporation
  Nanjing Institute of ZTE Corporation
  No.68 Zijinghua Rd. Yuhuatai District, Nanjing, China
  Tel: +86-25-52870000" ;
  description 'The netconf module to describe CGN.' ;
  revision 2025-04-10 {
    description 'Add http-alg-feature.' ;
  }

  revision 2024-10-31 {
    description '1）Modified some comments.
2）Add an enumeration value for the node:
configuration/af-nodes/af-node/cgn/instance-list/default-instance/location-list/location/track/type.' ;
  }

  revision 2023-12-05 {
    description 'Modify nodes:
configuration\af-nodes\af-node\cgn\pool-list\nat-pool\section-list\section\section-no range from 1-200 to 1-2000
configuration\af-nodes\af-node\cgn\pool-list\nat-pool\max-number range from 1-200 to 1-2000
configuration\af-nodes\af-node\cgn\pool-list\nat-pool\max-number default 200
configuration\af-nodes\af-node\cgn\pool-list\pat-pool\section-list\section\section-no range from 1-200 to 1-2000
configuration\af-nodes\af-node\cgn\pool-list\pat-pool\max-number range from 1-200 to 1-2000
configuration\af-nodes\af-node\cgn\pool-list\pat-pool\max-number default 200
configuration\af-nodes\af-node\cgn\pool-list\nat-pool\lock-ip-list\lock-ip\lock-ip-type\section\section-no range from 1-200 to 1-2000
configuration\af-nodes\af-node\cgn\pool-list\pat-pool\lock-ip-list\lock-ip\lock-ip-type\section\section-no range from 1-200 to 1-2000' ;
  }

  revision 2023-11-28 {
    description 'modify max-private-address-num range from 1-500000 to 1-1000000' ;
  }

  revision 2023-04-11 {
    description 'Add nodes:
configuration\af-nodes\af-node\cgn\log-list\destination\ipflow\ipflow-list\log-type' ;
  }

  revision 2022-04-14 {
    description 'Obsolete nodes as follows:
configuration\cgn\log-list\log\destination\ipflow\ipflow
configuration\cgn\log-list\log\destination\ipflow\flow-exporter-name
Add notes as follows:
configuration\cgn\log-list\log\destination\ipflow\ipflow-list' ;
  }

  revision 2022-03-02 {
    description 'Add nodes:
configuration\cgn\pool-list\pat-pool\max-idle-port-range' ;
  }

  revision 2021-09-11 {
    description 'Add nodes:
configuration\af-nodes\af-node\cgn\domain-list\domain\max-trans-per-ipv4-addr-list' ;
  }

  revision 2021-04-29 {
    description 'Add the default of the choice as follows:
configuration\global\cgn-res-alloc-disconnect' ;
  }

  revision 2021-03-31 {
    description 'Obsolete leafs as follows:
configuration\af-nodes\af-node\cgn\pool-list\nat-pool\port-alarm-value
configuration\af-nodes\af-node\cgn\instance-list\default-instance\allocate-mode
configuration\af-nodes\af-node\cgn\instance-list\instance\allocate-mode
Add leafs as follows:
configuration\af-nodes\af-node\cgn\pool-list\nat-pool\ip-alarm-value' ;
  }

  revision 2020-05-28 {
    description 'Add leafs as follows:
configuration\af-nodes\af-node\cgn\car-policy-template\car-policy-name\description
configuration\af-nodes\af-node\cgn\user-list\public-user\description
configuration\af-nodes\af-node\cgn\user-list\vrf-user\description
Modify leafs inbound-route-map length from 31 to 200' ;
  }

  revision 2020-05-16 {
    description 'Change the length of the poolname to 64.' ;
  }

  revision 2019-10-25 {
    description 'Initial version.' ;
  }

  feature static-rule-interface-feature {
    description 'Static rule interface feature.' ;
  }

  feature http-alg-feature {
    description 'HTTP ALG feature.' ;
    ncd:revise-date 2025-04-10 ;
  }

  container state {
    config false ;
    description 'The state of CGN.' ;
  }

  container configuration {
    description 'The configuration of CGN.' ;
    container af-nodes {
      description 'Configure AF node.' ;
      list af-node {
        description 'Configure AF node.' ;
        key af-name ;
        leaf af-name {
          description 'AF name.' ;
          type ncd:af-name {
            length 1..32 {
              description 'AF name.' ;
            }

          }

        }

        container cgn {
          description 'Configure CGN.' ;
          container instance-list {
            description 'The CGN instance list.' ;
            container default-instance {
              description 'Default instance.' ;
              presence default-instance ;
              leaf instance-info {
                description 'Instance information.' ;
                type empty ;

                mandatory true ;
              }

              container location-list {
                description 'The location list.' ;
                list location {
                  description 'The location.' ;
                  key node-id ;
                  leaf node-id {
                    description 'Node ID.' ;
                    type uint32 {
                      range 1..64 ;

                    }

                  }

                  leaf master-cpu {
                    description 'Master CPU.' ;
                    type ncd:cpu ;

                    mandatory true ;
                  }

                  leaf slave-cpu {
                    description 'Slave CPU.' ;
                    type ncd:cpu ;

                    default '' ;
                  }

                  container track {
                    description 'Event track information.' ;
                    presence track ;
                    leaf type {
                      description 'Track type.' ;
                      type enumeration {
                        enum object {
                          value 1 ;
                          description 'Track object.' ;
                        }

                        enum group {
                          value 2 ;
                          description 'Track group.' ;
                        }

                        enum null {
                          value 0 ;
                          description 'No track.' ;
                        }

                      }

                      mandatory true ;
                    }

                    leaf name {
                      description 'Track name.' ;
                      type string ;

                      mandatory true ;
                    }

                  }

                }

              }

              leaf resource-exhaust-action {
                description 'Resource exhaustion behavior.' ;
                type enumeration {
                  enum drop {
                    value 0 ;
                    description 'Drop if resource exhaust' ;
                  }

                  enum sendIcmpError {
                    value 1 ;
                    description 'Send ICMP error if resource exhaust' ;
                  }

                }

                default drop ;
              }

              leaf max-blocks-number {
                description 'Maximum blocks of dynamic port range.' ;
                type uint8 {
                  range 0..3 ;

                }

                default 0 ;
              }

              leaf statistics-switch {
                description 'Statistics switch.' ;
                type enumeration {
                  enum on {
                    value 1 ;
                  }

                  enum off {
                    value 0 ;
                  }

                }

                default off ;
              }

              leaf allocate-mode {
                status obsolete {
                  ncd:revise-date 2021-03-31 ;
                }

                description 'Allocate mode of dynamic port range.' ;
                type enumeration {
                  enum prefix {
                    value 1 ;
                  }

                  enum softwire {
                    value 0 ;
                  }

                }

                default prefix ;
              }

            }

            list instance {
              description 'The instance.' ;
              key instance-name ;
              leaf instance-name {
                description 'Instance name.' ;
                type string {
                  length 1..31 ;

                }

              }

              leaf instance-id {
                description 'Instance ID.' ;
                type uint32 {
                  range 1..63 ;

                }

                mandatory true ;
              }

              container location-list {
                description 'The location list.' ;
                list location {
                  description 'The location.' ;
                  key node-id ;
                  leaf node-id {
                    description 'Node ID.' ;
                    type uint32 {
                      range 1..64 ;

                    }

                  }

                  leaf master-spu {
                    description 'Master CPU.' ;
                    type ncd:cpu ;

                    mandatory true ;
                  }

                  leaf slave-spu {
                    description 'Slave CPU.' ;
                    type ncd:cpu ;

                    default '' ;
                  }

                  container track {
                    description 'Event track information.' ;
                    presence track ;
                    leaf type {
                      description 'Track type.' ;
                      type enumeration {
                        enum object {
                          value 1 ;
                          description 'Track object.' ;
                        }

                        enum group {
                          value 2 ;
                          description 'Track group.' ;
                        }

                        enum null {
                          description 'No track.' ;
                          value 0 ;
                        }

                      }

                      mandatory true ;
                    }

                    leaf name {
                      description 'Track name.' ;
                      type string ;

                      mandatory true ;
                    }

                  }

                }

              }

              leaf resource-exhaust-action {
                description 'Resource exhaustion behavior.' ;
                type enumeration {
                  enum drop {
                    value 0 ;
                    description 'Drop if resource exhaust' ;
                  }

                  enum sendIcmpError {
                    value 1 ;
                    description 'Send ICMP error if resource exhaust' ;
                  }

                }

                default drop ;
              }

              leaf max-blocks-number {
                description 'Maximum blocks of dynamic port range.' ;
                type uint8 {
                  range 0..3 ;

                }

                default 0 ;
              }

              leaf statistics-switch {
                description 'Statistics switch.' ;
                type enumeration {
                  enum on {
                    value 1 ;
                  }

                  enum off {
                    value 0 ;
                  }

                }

                default off ;
              }

              leaf allocate-mode {
                status obsolete {
                  ncd:revise-date 2021-03-31 ;
                }

                description 'Allocate mode of dynamic port range.' ;
                type enumeration {
                  enum prefix {
                    value 1 ;
                  }

                  enum softwire {
                    value 0 ;
                  }

                }

                default prefix ;
              }

            }

          }

          container car-policy-template {
            description 'CAR policy template.' ;
            list car-policy-list {
              description 'CAR policy list.' ;
              key car-policy-name ;
              leaf car-policy-name {
                description 'CAR policy name.' ;
                type string {
                  length 1..31 ;

                }

              }

              leaf instance-name {
                description 'Instance name.' ;
                type ncd:string-quesiton-mark ;

                mandatory true ;
              }

              container inbound-car {
                description 'Inbound CAR.' ;
                presence inbound-car ;
                leaf inbound-cir {
                  description 'Inbound committed information rate(kbps).' ;
                  type uint32 {
                    range 66..16777215 ;

                  }

                  mandatory true ;
                }

                leaf inbound-cbs {
                  description 'Inbound committed burst size(KB).' ;
                  type uint32 {
                    range 15..2000000 ;

                  }

                  mandatory true ;
                }

                leaf inbound-pir {
                  description 'Inbound peak information rate(kbps).' ;
                  type uint32 {
                    range 66..16777215 ;

                  }

                  mandatory true ;
                }

                leaf inbound-pbs {
                  description 'Inbound peak burst size(KB).' ;
                  type uint32 {
                    range 15..2000000 ;

                  }

                  mandatory true ;
                }

              }

              container outbound-car {
                description 'Outbound CAR.' ;
                presence outbound-car ;
                leaf outbound-cir {
                  description 'Outbound committed information rate(kbps).' ;
                  type uint32 {
                    range 66..16777215 ;

                  }

                  mandatory true ;
                }

                leaf outbound-cbs {
                  description 'Outbound committed burst size(KB).' ;
                  type uint32 {
                    range 15..2000000 ;

                  }

                  mandatory true ;
                }

                leaf outbound-pir {
                  description 'Outbound peak information rate(kbps).' ;
                  type uint32 {
                    range 66..16777215 ;

                  }

                  mandatory true ;
                }

                leaf outbound-pbs {
                  description 'Outbound peak burst size(KB).' ;
                  type uint32 {
                    range 15..2000000 ;

                  }

                  mandatory true ;
                }

              }

              leaf description {
                description 'Description.' ;
                type string {
                  length 1..64 ;

                }

                ncd:revise-date 2020-05-28 ;
              }

            }

          }

          container pool-list {
            description 'Pool list.' ;
            list nat-pool {
              description 'NAT pool.' ;
              key 'pool-id pool-name' ;
              leaf pool-id {
                description 'Pool ID.' ;
                type uint32 {
                  range 0..1999 ;

                }

              }

              leaf pool-name {
                description 'Pool name.' ;
                type string {
                  length 1..31 ;

                }

              }

              leaf instance-name {
                description 'Instance name.' ;
                type ncd:string-quesiton-mark ;

                mandatory true ;
              }

              leaf vrf-name {
                description 'VRF name.' ;
                type string {
                  length 1..32 ;

                }

              }

              leaf description {
                description 'Description.' ;
                type string {
                  length 1..63 ;

                }

              }

              leaf sib-instance {
                description 'SIB instance.' ;
                type uint32 {
                  range 1..255 ;

                }

              }

              leaf port-alarm-value {
                status obsolete {
                  ncd:revise-date 2021-03-31 ;
                }

                description 'Alarm threshold of IP utilization ratio.' ;
                type uint32 {
                  range 1..100 ;

                }

                default 80 ;
              }

              choice hot-standby-policy {
                description 'Hot standby policy.' ;
                case all {
                  description 'All.' ;
                  leaf all-live-time {
                    description 'Live time of all protocols.' ;
                    type uint32 {
                      range 1..65535 ;

                    }

                  }

                }

                case protocol {
                  description 'Protocol.' ;
                  leaf ip-live-time {
                    description 'Live time of IP protocol.' ;
                    type uint32 {
                      range 1..65535 ;

                    }

                  }

                  leaf alg-live-time {
                    description 'Live time of ALG protocol.' ;
                    type uint32 {
                      range 1..65535 ;

                    }

                  }

                }

              }

              leaf interface-name {
                description 'Interface name.' ;
                type ncd:ifname ;

              }

              container section-list {
                description 'Section list.' ;
                list section {
                  description 'Section.' ;
                  key section-no ;
                  leaf section-no {
                    description 'Section number.' ;
                    type uint32 {
                      range 1..2000 ;

                    }

                  }

                  choice section-type {
                    description 'Section type.' ;
                    mandatory true ;
                    case ip {
                      description 'IP.' ;
                      leaf start-ip {
                        description 'Start IP address.' ;
                        type ncd:ipv4-address-none-zero ;

                        mandatory true ;
                      }

                      leaf end-ip {
                        description 'End IP address.' ;
                        type ncd:ipv4-address-none-zero ;

                      }

                    }

                    case range {
                      description 'IP range.' ;
                      leaf mask-length {
                        description 'Mask length.' ;
                        type ncd:ipv4-mask ;

                        mandatory true ;
                      }

                      leaf base-ip {
                        description 'Base IP.' ;
                        type ncd:ipv4-address-none-zero ;

                        mandatory true ;
                      }

                    }

                    case interface {
                      description 'Interface address.' ;
                      leaf interface-name {
                        description 'Interface name.' ;
                        type ncd:ifname ;

                        mandatory true ;
                      }

                    }

                  }

                }

              }

              leaf hot-standby-route-metric {
                description 'Route metric of low priority pool.' ;
                type uint32 {
                  range 0..4261412864 ;

                }

                default 50 ;
              }

              leaf hot-standby-route-priority {
                description 'Route priority of low priority pool.' ;
                type uint32 {
                  range 0..254 ;

                }

                default 50 ;
              }

              leaf location-node {
                description 'Location node.' ;
                type uint16 {
                  range 1..64 ;

                }

              }

              leaf position {
                description 'The server position to obtain IP ranges.' ;
                type enumeration {
                  enum local {
                    value 1 ;
                  }

                  enum remote {
                    value 2 ;
                  }

                  enum disable {
                    value 0 ;
                  }

                }

                default disable ;
              }

              leaf ippool-name {
                description 'IP pool name.' ;
                type string {
                  length 1..64 ;

                }

              }

              leaf low {
                description 'The low threshold.' ;
                type uint32 {
                  range 1..100 ;

                }

                default 20 ;
              }

              leaf high {
                description 'The high threshold.' ;
                type uint32 {
                  range 1..100 ;

                }

                default 80 ;
              }

              leaf mask {
                description 'The mask of range.' ;
                type uint32 {
                  range 20..32 ;

                }

                default 27 ;
              }

              leaf max-number {
                description 'The max number of ranges.' ;
                default 200 ;
                type uint32 {
                  range 1..2000 ;

                }

              }

              leaf recycle {
                description 'Force recycle resources.' ;
                type enumeration {
                  enum enable {
                    value 1 ;
                  }

                  enum disable {
                    value 0 ;
                  }

                }

                default disable ;
              }

              leaf assign {
                description 'Assign obtain IP ranges policy.' ;
                type enumeration {
                  enum none {
                    value 0 ;
                    description 'Assign policy none' ;
                  }

                  enum forward {
                    value 1 ;
                    description 'Assign policy forward' ;
                  }

                  enum backward {
                    value 2 ;
                    description 'Assign policy backward' ;
                  }

                }

                default none ;
              }

              container lock-ip-list {
                description 'Lock IP list.' ;
                list lock-ip {
                  description 'Lock IP.' ;
                  key lock-ip-no ;
                  leaf lock-ip-no {
                    description 'Lock IP number.' ;
                    type uint32 {
                      range 1..10 ;

                    }

                  }

                  choice lock-ip-type {
                    description 'Lock IP type.' ;
                    case ip {
                      description 'IP.' ;
                      leaf start-ip {
                        description 'Start IP address.' ;
                        type ncd:ipv4-address-none-zero ;

                      }

                      leaf end-ip {
                        description 'End IP address.' ;
                        type ncd:ipv4-address-none-zero ;

                      }

                    }

                    case section {
                      description 'Section.' ;
                      leaf section-no {
                        description 'Section number.' ;
                        type uint32 {
                          range 1..2000 ;

                        }

                      }

                    }

                    case all {
                      description 'Lock all.' ;
                      leaf all {
                        description 'Lock all.' ;
                        type enumeration {
                          enum all {
                            value 1 ;
                            description 'Lock all.' ;
                          }

                        }

                      }

                    }

                  }

                }

              }

              leaf detect-retransmit-number {
                description 'Detect retransmit number.' ;
                type uint32 {
                  range 0..10 ;

                }

                default 0 ;
              }

              leaf detect-interval-day {
                description 'Detect interval day number.' ;
                type uint32 {
                  range 0..999 ;

                }

                default 0 ;
              }

              leaf detect-interval-hour {
                description 'Detect interval hour number.' ;
                type uint32 {
                  range 0..23 ;

                }

                default 0 ;
              }

              leaf detect-interval-minute {
                description 'Detect interval minute number.' ;
                type uint32 {
                  range 0..59 ;

                }

                default 0 ;
              }

              leaf ip-alarm-value {
                description 'Alarm threshold of IP utilization ratio.' ;
                type uint32 {
                  range 1..100 ;

                }

                default 80 ;
                ncd:revise-date 2021-03-31 ;
              }

            }

            list pat-pool {
              description 'PAT pool.' ;
              key 'pool-id pool-name' ;
              leaf pool-id {
                description 'Pool ID.' ;
                type uint32 {
                  range 0..1999 ;

                }

              }

              leaf pool-name {
                description 'Pool name.' ;
                type string {
                  length 1..31 ;

                }

              }

              leaf instance-name {
                description 'Instance name.' ;
                type ncd:string-quesiton-mark ;

                mandatory true ;
              }

              leaf address-user-ratio {
                description 'User sharing ratio.' ;
                type uint32 {
                  range 1..1000 ;

                }

              }

              leaf vrf-name {
                description 'VRF name.' ;
                type string {
                  length 1..32 ;

                }

              }

              leaf description {
                description 'Description.' ;
                type string {
                  length 1..63 ;

                }

              }

              leaf max-ports-per-address {
                description 'Max ports of each protocol for one address.' ;
                type uint32 {
                  range 1..65535 ;

                }

                default 65535 ;
              }

              leaf portrange-size {
                description 'Port range size.' ;
                type uint32 {
                  range 1..65536 ;

                }

              }

              leaf sib-instance {
                description 'SIB instance.' ;
                type uint32 {
                  range 1..255 ;

                }

              }

              leaf port-alarm-value {
                description 'Alarm threshold of IP ports utilization ratio.' ;
                type uint32 {
                  range 1..100 ;

                }

                default 80 ;
              }

              leaf port-range-alarm-value {
                description 'Alarm threshold of port range ports utilization ratio.' ;
                type uint32 {
                  range 1..100 ;

                }

                default 80 ;
              }

              leaf share-ratio-alarm-value {
                description 'Alarm threshold of sharing ratio.' ;
                type uint32 {
                  range 1..100 ;

                }

                default 80 ;
              }

              choice hot-standby-policy {
                description 'Hot standby policy.' ;
                case all {
                  description 'All.' ;
                  leaf all-live-time {
                    description 'Live time of all protocols.' ;
                    type uint32 {
                      range 1..65535 ;

                    }

                  }

                }

                case protocol {
                  description 'Protocol.' ;
                  leaf tcp-live-time {
                    description 'Live time of TCP protocol.' ;
                    type uint32 {
                      range 1..65535 ;

                    }

                  }

                  leaf udp-live-time {
                    description 'Live time of UDP protocol.' ;
                    type uint32 {
                      range 1..65535 ;

                    }

                  }

                  leaf icmp-live-time {
                    description 'Live time of ICMP protocol.' ;
                    type uint32 {
                      range 1..65535 ;

                    }

                  }

                  leaf pcp-live-time {
                    description 'Live time of PCP protocol.' ;
                    type uint32 {
                      range 1..65535 ;

                    }

                  }

                  leaf alg-live-time {
                    description 'Live time of ALG protocol.' ;
                    type uint32 {
                      range 1..65535 ;

                    }

                  }

                }

              }

              leaf portrange-start-port {
                description 'Start port.' ;
                type uint16 {
                  range 1..65535 ;

                }

                default 1 ;
              }

              leaf portrange-end-port {
                description 'End port.' ;
                type uint16 {
                  range 1..65535 ;

                }

                default 65535 ;
              }

              leaf portrange-block-alarm-value {
                description 'Alarm threshold of port range block ratio.' ;
                type uint32 {
                  range 1..100 ;

                }

                default 80 ;
              }

              leaf pool-port-alarm-value {
                description 'Alarm threshold of ports utilization ratio.' ;
                type uint32 {
                  range 1..100 ;

                }

                default 80 ;
              }

              leaf spr-block-alarm-value {
                description 'Alarm threshold of static port range block ratio.' ;
                type uint32 {
                  range 1..100 ;

                }

                default 80 ;
              }

              leaf well-known-ports-forbidden {
                description 'Well known ports forbidden.' ;
                type enumeration {
                  enum disable {
                    value 0 ;
                  }

                  enum enable {
                    value 1 ;
                  }

                }

                default disable ;
              }

              leaf forbidden-start-port {
                description 'Start port of well known ports forbidden.' ;
                type uint32 {
                  range 64..8192 ;

                }

              }

              leaf interface-name {
                description 'Interface name.' ;
                type ncd:ifname ;

              }

              container section-list {
                description 'Section list.' ;
                list section {
                  description 'Section.' ;
                  key section-no ;
                  leaf section-no {
                    description 'Section number.' ;
                    type uint32 {
                      range 1..2000 ;

                    }

                  }

                  choice section-type {
                    description 'Section type.' ;
                    mandatory true ;
                    case ip {
                      description 'IP.' ;
                      leaf start-ip {
                        description 'Start IP address.' ;
                        type ncd:ipv4-address-none-zero ;

                        mandatory true ;
                      }

                      leaf end-ip {
                        description 'End IP address.' ;
                        type ncd:ipv4-address-none-zero ;

                      }

                    }

                    case range {
                      description 'IP range.' ;
                      leaf mask-length {
                        description 'Mask length.' ;
                        type ncd:ipv4-mask ;

                        mandatory true ;
                      }

                      leaf base-ip {
                        description 'Base IP.' ;
                        type ncd:ipv4-address-none-zero ;

                        mandatory true ;
                      }

                    }

                    case interface {
                      description 'Interface address.' ;
                      leaf interface-name {
                        description 'Interface name.' ;
                        type ncd:ifname ;

                        mandatory true ;
                      }

                    }

                  }

                }

              }

              leaf hot-standby-route-metric {
                description 'Route metric of low priority pool.' ;
                type uint32 {
                  range 0..4261412864 ;

                }

                default 50 ;
              }

              leaf hot-standby-route-priority {
                description 'Route priority of low priority pool.' ;
                type uint32 {
                  range 0..254 ;

                }

                default 50 ;
              }

              leaf location-node {
                description 'Location node.' ;
                type uint16 {
                  range 1..64 ;

                }

              }

              leaf port-reserved {
                description 'Port reserved.' ;
                type uint32 {
                  range 0..4096 ;

                }

                default 64 ;
              }

              leaf position {
                description 'The server position to obtain IP ranges.' ;
                type enumeration {
                  enum local {
                    value 1 ;
                  }

                  enum remote {
                    value 2 ;
                  }

                  enum disable {
                    value 0 ;
                  }

                }

                default disable ;
              }

              leaf ippool-name {
                description 'IP pool name.' ;
                type string {
                  length 1..64 ;

                }

              }

              leaf low {
                description 'The low threshold.' ;
                type uint32 {
                  range 1..100 ;

                }

                default 20 ;
              }

              leaf high {
                description 'The high threshold.' ;
                type uint32 {
                  range 1..100 ;

                }

                default 80 ;
              }

              leaf mask {
                description 'The mask of range.' ;
                type uint32 {
                  range 20..32 ;

                }

                default 27 ;
              }

              leaf max-number {
                description 'The max number of ranges.' ;
                default 200 ;
                type uint32 {
                  range 1..2000 ;

                }

              }

              leaf max-static-port-range-blocks {
                description 'Max blocks of static portrange for one user.' ;
                type uint8 {
                  range 1..4 ;

                }

                default 1 ;
              }

              leaf recycle {
                description 'Force recycle resources' ;
                type enumeration {
                  enum enable {
                    value 1 ;
                  }

                  enum disable {
                    value 0 ;
                  }

                }

                default disable ;
              }

              leaf assign {
                description 'Assign obtain IP ranges policy.' ;
                type enumeration {
                  enum none {
                    value 0 ;
                    description 'Assign policy none' ;
                  }

                  enum forward {
                    value 1 ;
                    description 'Assign policy forward' ;
                  }

                  enum backward {
                    value 2 ;
                    description 'Assign policy backward' ;
                  }

                }

                default none ;
              }

              container lock-ip-list {
                description 'Lock IP list.' ;
                list lock-ip {
                  description 'Lock IP.' ;
                  key lock-ip-no ;
                  leaf lock-ip-no {
                    description 'Lock IP number.' ;
                    type uint32 {
                      range 1..10 ;

                    }

                  }

                  choice lock-ip-type {
                    description 'Lock IP type.' ;
                    mandatory true ;
                    case ip {
                      description 'IP.' ;
                      leaf start-ip {
                        description 'Start IP address.' ;
                        type ncd:ipv4-address-none-zero ;

                      }

                      leaf end-ip {
                        description 'End IP address.' ;
                        type ncd:ipv4-address-none-zero ;

                      }

                    }

                    case section {
                      description 'Section.' ;
                      leaf section-no {
                        description 'Section number.' ;
                        type uint32 {
                          range 1..2000 ;

                        }

                      }

                    }

                    case all {
                      description 'Lock all.' ;
                      leaf all {
                        description 'Lock all.' ;
                        type enumeration {
                          enum all {
                            value 1 ;
                            description 'Lock all.' ;
                          }

                        }

                      }

                    }

                  }

                }

              }

              leaf detect-retransmit-number {
                description 'Detect retransmit number.' ;
                type uint32 {
                  range 0..10 ;

                }

                default 0 ;
              }

              leaf detect-interval-day {
                description 'Detect interval day number.' ;
                type uint32 {
                  range 0..999 ;

                }

                default 0 ;
              }

              leaf detect-interval-hour {
                description 'Detect interval hour number.' ;
                type uint32 {
                  range 0..23 ;

                }

                default 0 ;
              }

              leaf detect-interval-minute {
                description 'Detect interval minute number.' ;
                type uint32 {
                  range 0..59 ;

                }

                default 0 ;
              }

              leaf max-idle-port-range {
                description 'Max idle port range number(0:not limit).' ;
                type uint32 {
                  range 0..2097152 ;

                }

                ncd:revise-date 2022-03-02 ;
              }

            }

          }

          container domain-list {
            description 'Domain list.' ;
            list domain {
              description 'Domain.' ;
              key domain-name ;
              leaf domain-name {
                description 'Domain name.' ;
                type string {
                  length 1..31 ;

                }

              }

              leaf domain-id {
                description 'Domain ID.' ;
                type uint32 {
                  range 1..4000 ;

                }

                mandatory true ;
              }

              leaf type {
                description 'Domain type.' ;
                type enumeration {
                  enum standalone {
                    value 1 ;
                    description 'Standalone CGN product.' ;
                  }

                  enum sr {
                    value 2 ;
                    description 'Service Router product.' ;
                  }

                  enum bras {
                    value 3 ;
                    description 'Brandband Remote Access Server/Broadband product.' ;
                  }

                  enum xgw {
                    value 4 ;
                    description 'Wireless Core Network packet switch node (GGSN).' ;
                  }

                }

                mandatory true ;
              }

              leaf ip-version-issued {
                description 'IP version issued.' ;
                type enumeration {
                  enum ipv4-issued {
                    value 1 ;
                    description 'Configure as NAT44 or NAT46.' ;
                  }

                  enum ipv6-issued {
                    value 2 ;
                    description 'Configure as DualStack-Lite or NAT64.' ;
                  }

                }

                mandatory true ;
              }

              leaf instance-name {
                description 'Instance name.' ;
                type ncd:string-quesiton-mark ;

                mandatory true ;
              }

              leaf description {
                description 'Description.' ;
                type string {
                  length 1..63 ;

                }

              }

              leaf quota-exceed-action {
                description 'The action of quota exceeded.' ;
                type enumeration {
                  enum discard {
                    value 0 ;
                    description 'Discard the packet if exceed max translations' ;
                  }

                  enum send-icmp-error {
                    value 1 ;
                    description 'Send ICMP error if exceed max translations' ;
                  }

                }

                default discard ;
              }

              leaf dns-no-limit {
                description "Don't limit the PAT sessions that destination port is DNS." ;
                type enumeration {
                  enum enable {
                    value 1 ;
                    description 'Enable limit of DNS sessions' ;
                  }

                  enum disable {
                    value 0 ;
                    description 'Disable limit of DNS sessions' ;
                  }

                }

                default disable ;
              }

              leaf max-private-address-num {
                description 'The max IPv4 number of the same user.' ;
                type uint32 {
                  range 1..1000000 {
                    description 'The max IPv4 number of the same user' ;
                  }

                }

                default 200000 ;
              }

              leaf new-session-create-speed {
                description 'Speed of new session created.' ;
                type uint32 {
                  range 1..50000 {
                    description 'Configure speed (pps)' ;
                  }

                }

              }

              container dynamic-rule-list {
                description 'Dynamic rule list.' ;
