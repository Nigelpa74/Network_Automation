                    value 0 ;
                  }

                  enum enable {
                    value 1 ;
                  }

                }

                default disable ;
              }

              leaf sr-outbound-packets {
                description 'Outbound packets of SR.' ;
                type enumeration {
                  enum disable {
                    value 0 ;
                  }

                  enum enable {
                    value 1 ;
                  }

                }

                default disable ;
              }

              leaf sr-inbound-bytes {
                description 'Inbound bytes of SR.' ;
                type enumeration {
                  enum disable {
                    value 0 ;
                  }

                  enum enable {
                    value 1 ;
                  }

                }

                default disable ;
              }

              leaf sr-outbound-bytes {
                description 'Outbound bytes of SR.' ;
                type enumeration {
                  enum disable {
                    value 0 ;
                  }

                  enum enable {
                    value 1 ;
                  }

                }

                default disable ;
              }

              container log-ipflow {
                description 'Log ipflow.' ;
                leaf ipflow-session-create-start-time {
                  description 'Start time of ipflow log when session is created.' ;
                  type enumeration {
                    enum disable {
                      value 0 ;
                    }

                    enum enable {
                      value 1 ;
                    }

                  }

                  default disable ;
                }

                leaf ipflow-session-delete-start-time {
                  description 'Start time of ipflow log when session is deleted.' ;
                  type enumeration {
                    enum disable {
                      value 0 ;
                    }

                    enum enable {
                      value 1 ;
                    }

                  }

                  default disable ;
                }

                leaf ipflow-session-delete-cgn-ip {
                  description 'Outside source IP of ipflow log when session is deleted.' ;
                  type enumeration {
                    enum disable {
                      value 0 ;
                    }

                    enum enable {
                      value 1 ;
                    }

                  }

                  default disable ;
                }

                leaf ipflow-session-delete-end-time {
                  description 'End time of ipflow log when session is deleted.' ;
                  type enumeration {
                    enum disable {
                      value 0 ;
                    }

                    enum enable {
                      value 1 ;
                    }

                  }

                  default disable ;
                }

                leaf ipflow-session-delete-inbound-bytes {
                  description 'Inbound bytes of ipflow log when session is deleted.' ;
                  type enumeration {
                    enum disable {
                      value 0 ;
                    }

                    enum enable {
                      value 1 ;
                    }

                  }

                  default disable ;
                }

                leaf ipflow-session-delete-inbound-packets {
                  description 'Inbound packets of ipflow log when session is deleted.' ;
                  type enumeration {
                    enum disable {
                      value 0 ;
                    }

                    enum enable {
                      value 1 ;
                    }

                  }

                  default disable ;
                }

                leaf ipflow-session-delete-outbound-bytes {
                  description 'Outbound bytes of ipflow log when session is deleted.' ;
                  type enumeration {
                    enum disable {
                      value 0 ;
                    }

                    enum enable {
                      value 1 ;
                    }

                  }

                  default disable ;
                }

                leaf ipflow-session-delete-outbound-packets {
                  description 'Outbound packets of ipflow log when session is deleted.' ;
                  type enumeration {
                    enum disable {
                      value 0 ;
                    }

                    enum enable {
                      value 1 ;
                    }

                  }

                  default disable ;
                }

                leaf ipflow-session-delete-vpn-id {
                  description 'VPN ID of ipflow log when session is deleted.' ;
                  type enumeration {
                    enum disable {
                      value 0 ;
                    }

                    enum enable {
                      value 1 ;
                    }

                  }

                  default disable ;
                }

                leaf ipflow-session-delete-cgn-port {
                  description 'Outside source port of ipflow log when session is deleted.' ;
                  type enumeration {
                    enum disable {
                      value 0 ;
                    }

                    enum enable {
                      value 1 ;
                    }

                  }

                  default disable ;
                }

              }

              leaf urllog-switch {
                description 'URL log switch.' ;
                type enumeration {
                  enum enable {
                    value 1 ;
                  }

                  enum disable {
                    value 0 ;
                  }

                }

                default disable ;
              }

            }

          }

          container advanced-and-pcp-service-list {
            description 'Advanced service and PCP service list.' ;
            list advanced-service {
              description 'Advanced service.' ;
              key instance-name ;
              leaf instance-name {
                description 'CGN instance name' ;
                type ncd:string-quesiton-mark {
                  length 1..31 ;

                }

              }

              leaf advanced-switch {
                description 'Switch of advanced service.' ;
                type enumeration {
                  enum enable {
                    value 1 ;
                  }

                  enum disable {
                    value 0 ;
                  }

                }

                default disable ;
              }

              choice tcp-mss-clamp {
                description 'TCP MSS clamps.' ;
                default tcp-mss-switch ;
                case tcp-mss-switch {
                  description 'TCP MSS switch' ;
                  leaf disable {
                    description 'Disable.' ;
                    type enumeration {
                      enum disable {
                        value 0 ;
                      }

                    }

                  }

                }

                case tcp-mss-auto {
                  description 'Negotiate TCP MSS automatically.' ;
                  leaf auto {
                    description 'Auto.' ;
                    type enumeration {
                      enum auto {
                        value 1 ;
                      }

                    }

                  }

                }

                case tcp-mss-value {
                  description 'TCP MSS value.' ;
                  leaf value {
                    description 'Value' ;
                    type uint16 {
                      range 64..9216 ;

                    }

                  }

                }

              }

              leaf tcp-state-track {
                description 'TCP state tracking.' ;
                type enumeration {
                  enum enable {
                    value 1 ;
                  }

                  enum disable {
                    value 0 ;
                  }

                }

                default disable ;
              }

              leaf session-mode {
                description 'Session mode.' ;
                type enumeration {
                  enum enable {
                    value 1 ;
                  }

                  enum disable {
                    value 0 ;
                  }

                }

                default disable ;
              }

              leaf pool-reuse {
                description 'Pool reuse.' ;
                type enumeration {
                  enum enable {
                    value 1 ;
                  }

                  enum disable {
                    value 0 ;
                  }

                }

                default disable ;
              }

            }

            list pcp-service {
              description 'PCP service.' ;
              key instance-name ;
              leaf instance-name {
                description 'Instance name' ;
                type ncd:string-quesiton-mark {
                  length 1..31 ;

                }

              }

              leaf pcp-switch {
                description 'PCP switch.' ;
                type enumeration {
                  enum enable {
                    value 1 ;
                  }

                  enum disable {
                    value 0 ;
                  }

                }

                default disable ;
              }

              leaf min-life-time {
                description 'Mapping minimum life time.' ;
                type uint32 {
                  range 120..86400 ;

                }

                default 120 ;
              }

              leaf max-life-time {
                description 'Maximal life time.' ;
                type uint32 {
                  range 120..86400 ;

                }

                default 86400 ;
              }

              leaf ipv4-acl {
                description 'IPv4 access control list.' ;
                type string {
                  length 1..31 ;

                }

              }

              leaf ipv6-acl {
                description 'IPv6 access control list.' ;
                type string {
                  length 1..31 ;

                }

              }

            }

            list protocol-session-timeout {
              description 'Session timeout for different protocol.' ;
              max-elements 512 ;
              key 'instance-name protocol destination-port' ;
              leaf instance-name {
                description 'Instance name.' ;
                type ncd:string-quesiton-mark {
                  length 1..31 ;

                }

              }

              leaf protocol {
                description 'Protocol.' ;
                type enumeration {
                  enum tcp {
                    value 6 ;
                  }

                  enum udp {
                    value 17 ;
                  }

                }

              }

              leaf destination-port {
                description 'Destination port.' ;
                type uint16 {
                  range 1..65535 ;

                }

              }

              leaf description {
                description 'Description.' ;
                type string {
                  length 1..63 ;

                }

                mandatory true ;
              }

              leaf timeout {
                description 'Timeout.' ;
                type uint16 {
                  range 1..7200 ;

                }

                mandatory true ;
              }

            }

          }

          container alg-list {
            description 'ALG list.' ;
            list alg-switch {
              description 'ALG switch.' ;
              key instance-name ;
              leaf instance-name {
                description 'Instance name.' ;
                type ncd:string-quesiton-mark ;

              }

              leaf ftp {
                description 'FTP.' ;
                type enumeration {
                  enum enable {
                    value 1 ;
                    description 'Enable FTP ALG' ;
                  }

                  enum disable {
                    value 0 ;
                    description 'Disable FTP ALG' ;
                  }

                }

                default disable ;
              }

              leaf icmp {
                description 'ICMP.' ;
                type enumeration {
                  enum enable {
                    value 1 ;
                    description 'Enable ICMP ALG' ;
                  }

                  enum disable {
                    value 0 ;
                    description 'Disable ICMP ALG' ;
                  }

                }

                default disable ;
              }

              leaf dns {
                description 'DNS.' ;
                type enumeration {
                  enum enable {
                    value 1 ;
                    description 'Enable DNS ALG' ;
                  }

                  enum disable {
                    value 0 ;
                    description 'Disable DNS ALG' ;
                  }

                }

                default disable ;
              }

              leaf rtsp {
                description 'RTSP.' ;
                type enumeration {
                  enum enable {
                    value 1 ;
                    description 'Enable RTSP ALG' ;
                  }

                  enum disable {
                    value 0 ;
                    description 'Disable RTSP ALG' ;
                  }

                }

                default disable ;
              }

              leaf h323 {
                description 'H323.' ;
                type enumeration {
                  enum enable {
                    value 1 ;
                    description 'Enable H323 ALG' ;
                  }

                  enum disable {
                    value 0 ;
                    description 'Disable H323 ALG' ;
                  }

                }

                default disable ;
              }

              leaf sip {
                description 'SIP.' ;
                type enumeration {
                  enum enable {
                    value 1 ;
                    description 'Enable SIP ALG' ;
                  }

                  enum disable {
                    value 0 ;
                    description 'Disable SIP ALG' ;
                  }

                }

                default disable ;
              }

              leaf pptp {
                description 'PPTP.' ;
                type enumeration {
                  enum enable {
                    value 1 ;
                    description 'Enable PPTP ALG' ;
                  }

                  enum disable {
                    value 0 ;
                    description 'Disable PPTP ALG' ;
                  }

                }

                default disable ;
              }

              leaf http {
                description 'HTTP.' ;
                type enumeration {
                  enum enable {
                    value 1 ;
                    description 'Enable HTTP ALG' ;
                  }

                  enum disable {
                    value 0 ;
                    description 'Disable HTTP ALG' ;
                  }

                }

                default disable ;
                if-feature http-alg-feature {
                  ncd:revise-date 2025-04-10 ;
                }

              }

              leaf dhcp {
                description 'DHCP.' ;
                type enumeration {
                  enum enable {
                    value 1 ;
                    description 'Enable DHCP ALG' ;
                  }

                  enum disable {
                    value 0 ;
                    description 'Disable DHCP ALG' ;
                  }

                }

                default disable ;
              }

            }

            list alg-port {
              description 'ALG port.' ;
              max-elements 16 ;
              key 'instance-name protocol port' ;
              leaf instance-name {
                description 'Instance name.' ;
                type ncd:string-quesiton-mark ;

              }

              leaf protocol {
                description 'Protocol.' ;
                type enumeration {
                  enum tcp {
                    value 6 ;
                    description 'TCP' ;
                  }

                }

              }

              leaf port {
                description 'Port.' ;
                type uint16 {
                  range 1..65535 {
                    description '1-65535' ;
                  }

                }

              }

              leaf alg-type {
                description 'ALG type.' ;
                type enumeration {
                  enum ftp {
                    value 0 ;
                    description 'FTP' ;
                  }

                }

                mandatory true ;
              }

            }

          }

          container alarm-list {
            description 'Alarm list.' ;
            list alarm {
              description 'Alarm.' ;
              key instance-name ;
              leaf instance-name {
                description 'Instance name.' ;
                type ncd:string-quesiton-mark ;

              }

              leaf alarm-switch {
                description 'Alarm switch.' ;
                type enumeration {
                  enum enable {
                    value 1 ;
                    description 'Start CGN alarm' ;
                  }

                  enum disable {
                    value 0 ;
                    description 'Stop CGN alarm' ;
                  }

                }

                default disable ;
              }

              leaf warning-switch {
                description 'Warning switch.' ;
                type enumeration {
                  enum enable {
                    value 0 ;
                    description 'Start CGN warning' ;
                  }

                  enum disable {
                    value 1 ;
                    description 'Stop CGN warning' ;
                  }

                }

                default enable ;
              }

              leaf port-range-block-alarm-switch {
                description 'Alarm switch of port range block utilization.' ;
                type enumeration {
                  enum enable {
                    value 1 ;
                    description 'Start alarm' ;
                  }

                  enum disable {
                    value 0 ;
                    description 'Stop alarm' ;
                  }

                }

                default disable ;
              }

              leaf ip-resource-threshold {
                description 'IP resource alarm threshold of NAT pool.' ;
                type uint16 {
                  range 1..100 {
                    description '<1-100>' ;
                  }

                }

                default 80 ;
              }

              leaf port-resource-threshold {
                description 'Port resource alarm threshold of PAT pool.' ;
                type uint16 {
                  range 1..100 {
                    description '<1-100>' ;
                  }

                }

                default 80 ;
              }

              leaf translations-threshold-high-level {
                description 'High level threshold of translations.' ;
                type uint16 {
                  range 1..100 ;

                }

              }

              leaf translations-threshold-middle-level {
                description 'Middle level threshold of translations.' ;
                type uint16 {
                  range 1..100 ;

                }

              }

              leaf translations-threshold {
                description 'Translations alarm threshold.' ;
                type uint16 {
                  range 1..100 {
                    description '<1-100>' ;
                  }

                }

                default 80 ;
              }

              leaf performance-statistics-switch {
                description 'Performance statistics switch.' ;
                type enumeration {
                  enum on {
                    value 1 ;
                    description 'Start CGN performance statistics switch.' ;
                  }

                  enum off {
                    value 0 ;
                    description 'Stop CGN performance statistics switch.' ;
                  }

                }

                default off ;
              }

              container local-ip-threshold {
                description 'Local IP threshold.' ;
                leaf high-level {
                  description 'High level threshold of local IP.' ;
                  type int16 {
                    range 1..100 ;

                  }

                }

                leaf middle-level {
                  description 'Middle level threshold of local IP.' ;
                  type int16 {
                    range 1..100 ;

                  }

                }

                leaf low-level {
                  description 'Low level threshold of local IP.' ;
                  type int16 {
                    range 1..100 ;

                  }

                  default 80 ;
                }

              }

              leaf static-port-range-threshold {
                description 'Static port range alarm threshold.' ;
                type uint8 {
                  range 1..100 ;

                }

                default 95 ;
              }

            }

          }

        }

        container global {
          description 'Global configuration.' ;
          leaf spu-auto-add {
            description 'SPU auto add.' ;
            type enumeration {
              enum off {
                value 0 ;
              }

              enum on {
                value 1 ;
              }

            }

            default off ;
          }

          leaf all-translations-alarm-threshold {
            description 'All translations alarm threshold.' ;
            type uint32 {
              range 1..100 ;

            }

            default 100 ;
          }

          container cgn-outside-interface-list {
            description 'CGN outside interface list.' ;
            list cgn-outside-interface {
              description 'CGN outside interface.' ;
              key interface-name ;
              leaf interface-name {
                description 'Interface name.' ;
                type ncd:ifname ;

              }

            }

          }

          choice cgn-res-alloc-disconnect {
            description 'CGN resource allocate disconnect time.' ;
            default response-delay ;
            case response-delay {
              description 'Response delay.' ;
              leaf response-delay-time {
                description 'Response delay time.' ;
                type uint32 {
                  range 0..2880 ;

                }

                default 240 ;
              }

            }

            case forever {
              description 'Forever.' ;
              leaf forever {
                description 'Forever.' ;
                type uint32 {
                  range 0..1 ;

                }

                default 0 ;
              }

            }

          }

          container log-ipflow-template {
            description 'Log ipflow.' ;
            leaf create-translation-template-nat44 {
              description 'Configure create translation ipflow templates NAT44 switch.' ;
              type enumeration {
                enum disable {
                  value 0 ;
                }

                enum enable {
                  value 1 ;
                }

              }

              default enable ;
            }

            leaf create-session-template-nat44 {
              description 'Configure create session ipflow templates NAT44 switch.' ;
              type enumeration {
                enum disable {
                  value 0 ;
                }

                enum enable {
                  value 1 ;
                }

              }

              default enable ;
            }

            leaf create-portrange-template-nat44 {
              description 'Configure create portrange ipflow templates NAT44 switch.' ;
              type enumeration {
                enum disable {
                  value 0 ;
                }

                enum enable {
                  value 1 ;
                }

              }

              default enable ;
            }

            leaf delete-translation-template-nat44 {
              description 'Configure delete translation ipflow templates NAT44 switch.' ;
              type enumeration {
                enum disable {
                  value 0 ;
                }

                enum enable {
                  value 1 ;
                }

              }

              default enable ;
            }

            leaf delete-session-template-nat44 {
              description 'Configure delete session ipflow templates NAT44 switch.' ;
              type enumeration {
                enum disable {
                  value 0 ;
                }

                enum enable {
                  value 1 ;
                }

              }

              default enable ;
            }

            leaf delete-portrange-template-nat44 {
              description 'Configure delete portrange ipflow templates NAT44 switch.' ;
              type enumeration {
                enum disable {
                  value 0 ;
                }

                enum enable {
                  value 1 ;
                }

              }

              default enable ;
            }

            leaf create-translation-template-nat64 {
              description 'Configure create translation ipflow templates NAT64 switch.' ;
              type enumeration {
                enum disable {
                  value 0 ;
                }

                enum enable {
                  value 1 ;
                }

              }

              default enable ;
            }

            leaf create-session-template-nat64 {
              description 'Configure create session ipflow templates NAT64 switch.' ;
              type enumeration {
                enum disable {
                  value 0 ;
                }

                enum enable {
                  value 1 ;
                }

              }

              default enable ;
            }

            leaf create-portrange-template-nat64 {
              description 'Configure create portrange ipflow templates NAT64 switch.' ;
              type enumeration {
                enum disable {
                  value 0 ;
                }

                enum enable {
                  value 1 ;
                }

              }

              default enable ;
            }

            leaf delete-translation-template-nat64 {
              description 'Configure delete translation ipflow templates NAT64 switch.' ;
              type enumeration {
                enum disable {
                  value 0 ;
                }

                enum enable {
                  value 1 ;
                }

              }

              default enable ;
            }

            leaf delete-session-template-nat64 {
              description 'Configure delete session ipflow templates NAT64 switch.' ;
              type enumeration {
                enum disable {
                  value 0 ;
                }

                enum enable {
                  value 1 ;
                }

              }

              default enable ;
            }

            leaf delete-portrange-template-nat64 {
              description 'Configure delete portrange ipflow templates NAT64 switch.' ;
              type enumeration {
                enum disable {
                  value 0 ;
                }

                enum enable {
                  value 1 ;
                }

              }

              default enable ;
            }

          }

        }

      }

    }

  }

}
