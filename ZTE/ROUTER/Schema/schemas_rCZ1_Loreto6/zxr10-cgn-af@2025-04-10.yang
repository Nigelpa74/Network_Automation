                          mandatory true ;
                        }

                        leaf global-ip {
                          description 'Global IP address.' ;
                          type ncd:ipv4-address-none-zero ;

                          mandatory true ;
                        }

                        leaf global-port {
                          description 'Global port.' ;
                          type uint16 {
                            range 1..65535 ;

                          }

                          mandatory true ;
                        }

                        leaf protocol {
                          description 'Protocol.' ;
