                    case nat {
                      description 'NAT.' ;
                      container nat {
                        description 'NAT.' ;
                        leaf global-ip {
                          description 'Global IP address.' ;
                          type ncd:ipv4-address-none-zero ;

                          mandatory true ;
                        }

                      }

