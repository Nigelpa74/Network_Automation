                          description 'Interface name.' ;
                          type ncd:ifname ;

                          mandatory true ;
                        }

                        leaf global-port {
                          description 'Global port.' ;
                          type uint16 {
                            range 1..65535 ;

                          }

                          mandatory true ;
                        }

                        leaf protocol {
                          description 'Protocol.' ;
                          type enumeration {
