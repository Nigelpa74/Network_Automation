        }

        ncd:revise-date 2021-10-21 ;
      }

      container mib-encode {
        description 'Encode mib file.' ;
        leaf para-value {
          default hex-ascii ;
          description 'Parameter value.' ;
          type enumeration {
            enum hex-ascii {
              value 1 ;
              description 'Hex-ascii encoding format.' ;
            }

            enum byte {
              value 2 ;
              description 'Byte encoding format.' ;
            }

          }

        }

        ncd:revise-date 2023-11-03 ;
      }

    }

  }

  container state {
    config false ;
    container alarm {
      description 'Some query operation.' ;
      list almLevel {
        description 'For query severity level of alarm. Query condition: (1) code;(2)code+tpidType;(3)none for all.' ;
        key 'code tpidType' ;
        leaf code {
          description 'Alarm code.' ;
          type uint32 ;

        }

        leaf tpidType {
          description 'The TPID type for alarm been detected.' ;
          type uint16 ;

        }

        leaf level {
          description 'Alarm severity level.' ;
          type enumeration {
            enum emergenciy {
              value 1 ;
            }

            enum alert {
              value 2 ;
            }

            enum critical {
              value 3 ;
            }

            enum error {
              value 4 ;
            }

            enum warning {
              value 5 ;
            }

            enum notice {
              value 6 ;
            }

            enum informational {
              value 7 ;
            }

            enum debug {
              value 8 ;
            }

          }

        }

        ncd:select code ;
        ncd:select "code tpidType" ;
      }

      container currentAlarm {
        description 'Current alarm info.' ;
        list flowId {
          description 'For query all alarm flow ID. Query condition: (1) almClass. (2) almFlwId + timeStamp. (3) sort' ;
          key 'almFlwId timeStamp' ;
          leaf almFlwId {
            description 'Flow ID of alarm.' ;
            type uint32 ;

          }

          leaf timeStamp {
            description 'Time stamp of this alarm.' ;
            type uint32 ;

          }

          leaf almClass {
            description 'The class of alarm.' ;
            type enumeration {
              enum common-alarm {
                value 1 ;
              }

              enum digital-perf-alarm {
                value 2 ;
              }

              enum simulation-perf-alarm {
                value 3 ;
              }

              enum switch-event {
                value 4 ;
              }

              enum common-event {
                value 5 ;
              }

            }

          }

          leaf sort {
            description 'The sort of alarm.
1:resources-full.' ;
            type uint16 ;

            ncd:revise-date 2017-08-23 ;
          }

          ncd:select almClass ;
          ncd:select "almFlwId timeStamp" ;
          ncd:select sort ;
        }

        list curRecords {
          description 'Used to search current alarm, and return type switching events. Query condition: almFlwId + timeStamp.
Four type: common alarm, protected switch event, and performence data alarm(digital or simulation).Every record is one of them.
common alarm --- almFlwId/timeStamp/code/severity/almTime/almType/almStat/almClass/description/TpidType/Tpid/srcTpidType/srcTpid/sort.
performence alarm --- almFlwId/timeStamp/code/severity/almTime/almType/almStat/almClass/description/TpidType/Tpid/srcTpidType/srcTpid/perfAlmType/threshAlmType/thPerfVal/sort.
protected switch event --- almFlwId/timeStamp/code/severity/almTime/almType/almStat/almClass/description/protectTpidType/protectTpid/reason/returnMode/prtGroupWrkStat/switchTpidType/previosTpid/currentTpid/protectType/sort.' ;
          key 'almFlwId timeStamp' ;
          leaf almFlwId {
            description 'Flow ID of alarm.' ;
            type uint32 ;

          }

          leaf timeStamp {
            description 'Time stamp of this alarm.' ;
            type uint32 ;

          }

          leaf code {
            description 'Alarm code.' ;
            type uint32 ;

          }

          leaf severity {
            description 'Secerity level for alarm.' ;
            type enumeration {
              enum emergenciy {
                value 1 ;
              }

              enum alert {
                value 2 ;
              }

              enum critical {
                value 3 ;
              }

              enum error {
                value 4 ;
              }

              enum warning {
                value 5 ;
              }

              enum notice {
                value 6 ;
              }

              enum informational {
                value 7 ;
              }

              enum debug {
                value 8 ;
              }

            }

          }

          leaf almOccurTime {
            description 'Occur time, UTC, second from 1970-1-1 00:00:00. This leaf is valid when alarm stat is occur.' ;
            type uint32 ;

            units second ;
          }

          leaf almUpdateTime {
            description 'Occur time, UTC, second from 1970-1-1 00:00:00. This leaf is valid when alarm stat is update.' ;
            type uint32 ;

            units second ;
          }

          leaf almType {
            description 'Alarm type.' ;
            type enumeration {
              enum communication-alarm {
                value 0 ;
              }

              enum qos-alarm {
                value 1 ;
              }

              enum device-alarm {
                value 2 ;
              }

              enum process-err-alarm {
                value 3 ;
              }

              enum enviroment-alarm {
                value 4 ;
              }

            }

          }

          leaf almStat {
            description 'Alarm status.' ;
            type enumeration {
              enum disappear {
                value 0 ;
              }

              enum occur {
                value 1 ;
              }

              enum update {
                value 2 ;
              }

            }

          }

          leaf almClass {
            description 'Alarm class.' ;
            type enumeration {
              enum common-alarm {
                value 1 ;
              }

              enum digital-alarm {
                value 2 ;
              }

              enum simulation-alarm {
                value 3 ;
              }

              enum switch-event {
                value 4 ;
              }

              enum common-event {
                value 5 ;
              }

            }

          }

          leaf description {
            description 'Description for alarm.' ;
            type ncd:string-all {
              length 0..512 ;

            }

          }

          leaf caption {
            description "Alarm title. The 'caption' and 'description' together constitute a complete description of the alarm. That is, the complete description = 'caption' + 'description'." ;
            type ncd:string-all {
              length 0..80 ;

            }

          }

          leaf tpidType {
            description 'The TPID type for alarm been detected.' ;
            type uint16 ;

          }

          leaf tpid {
            description 'The TPID for alarm been detected.' ;
            type binary {
              length 62..128 ;

            }

          }

          leaf tpidLen {
            description 'The TPID length for alarm been detected.' ;
            type uint8 {
              range 62..128 ;

            }

          }

          leaf srcTpidType {
            description 'The TPID type of alarm from.' ;
            type uint16 ;

          }

          leaf srcTpid {
            description 'The TPID of alarm from.' ;
            type binary {
              length 62..128 ;

            }

          }

          leaf srcTpidLen {
            description 'The TPID length of alarm from.' ;
            type uint8 {
              range 62..128 ;

            }

          }

          leaf perfAlmType {
            description 'Type of performance alarm.' ;
            type performance-alarm-type ;

          }

          leaf thAlmPeriod {
            description 'Performance alarm type, 15(5)min or 24h.' ;
            type enumeration {
              enum fifteen-minutes {
                value 15 ;
              }

              enum twenty-four-hours {
                value 24 ;
              }

              enum invalid-period {
                value 254 ;
              }

              enum five-minutes {
                value 5 ;
              }

            }

          }

          leaf thPerfVal {
            description 'The performance value when alarm occur. Length 10 bytes( see document).' ;
            type binary {
              length 10 ;

            }

          }

          leaf protectTpidType {
            description 'Protect TPID type.' ;
            type uint16 ;

          }

          leaf protectTpid {
            description 'Protect TPID (protect group).' ;
            type binary {
              length 62..128 ;

            }

          }

          leaf protectTpidLen {
            description 'Protect TPID length.' ;
            type uint8 {
              range 62..128 ;

            }

          }

          leaf reason {
            description 'Reason code for switch-event or common event. Reason code see document.' ;
            type uint16 ;

          }

          leaf returnMode {
            description 'Return mode switching events.' ;
            type enumeration {
              enum return-mode {
                value 1 ;
              }

              enum not-return-mode {
                value 2 ;
              }

              enum invalid-mode {
                value 254 ;
              }

            }

          }

          leaf prtGroupWrkStat {
            description 'Work status of protect group.' ;
            type uint32 ;

          }

          leaf swtichTpidType {
            description "The TPID type be protected. That's the TPID type of previos and current." ;
            type uint16 ;

          }

          leaf previosTpid {
            description 'Leave TPID when protecting.' ;
            type binary {
              length 62..128 ;

            }

          }

          leaf previosTpidLen {
            description 'Leave TPID length when protecting.' ;
            type uint8 {
              range 62..128 ;

            }

          }

          leaf currentTpid {
            description 'The destination TPID when protecting.' ;
            type binary {
              length 62..128 ;

            }

          }

          leaf currentTpidLen {
            description 'The destination TPID length when protecting.' ;
            type uint8 {
              range 62..128 ;

            }

          }

          leaf protectType {
            description 'Protect type.' ;
            type uint16 ;

          }

          leaf sort {
            description 'The sort of alarm.
1:resources-full.' ;
            type uint16 ;

            ncd:revise-date 2017-08-23 ;
          }

          leaf almOccurMs {
            description 'Occur millisecond. This leaf is valid when alarm stat is occur.' ;
            type uint16 ;

            units millisecond ;
            ncd:revise-date 2018-09-05 ;
          }

          leaf almUpdateMs {
            description 'Occur millisecond. This leaf is valid when alarm stat is update.' ;
            type uint16 ;

            units millisecond ;
            ncd:revise-date 2018-09-05 ;
          }

          leaf peid {
            description 'Satellite ID. 0:Invalid Value' ;
            type uint32 {
              range 0..250 ;

            }

            ncd:revise-date 2023-03-21 ;
          }

          leaf tpid-desc {
            description 'The description of TPID.' ;
            type ncd:string-all {
              length 0..127 ;

            }

            ncd:revise-date 2024-05-22 ;
          }

          leaf module {
            type ncd:string-all {
              length 0..35 ;

            }

            description 'Alarm module name.' ;
            ncd:revise-date 2025-01-06 ;
          }

          ncd:select "almFlwId timeStamp" ;
        }

      }

      container historyAlarm {
        description 'history alarm info.' ;
        list hisRecords {
          description 'Used to search current alarm. 
Query condition: 
 (1) almFlwId + timeStamp.
 (2) almClass + beginTime + endTime. 
 (3) beginTime + endTime.
 (4) sort
Four type: common alarm, common event, switch event, and performence data alarm.Every record is one of them.
common alarm --- almFlwId/timeStamp/code/severity/almOccurTime/almDisappearTime/almUpdateTime/almType/almStat/almClass/description/TpidType/Tpid/srcTpidType/srcTpid/sort.
common event --- almFlwId/timeStamp/code/severity/almOccurTime/almClass/description/TpidType/Tpid/reason.
performence alarm --- almFlwId/timeStamp/code/severity/almOccurTime/almDisappearTime/almUpdateTime/almType/almStat/almClass/description/TpidType/Tpid/srcTpidType/srcTpid/perfAlmType/threshAlmType/thPerfVal/sort.
switch event --- almFlwId/timeStamp/code/severity/almOccurTime/almDisappearTime/almUpdateTime/almType/almStat/almClass/description/protectTpidType/protectTpid/reason/returnMode/prtGroupWrkStat/switchTpidType/previosTpid/currentTpid/protectType/sort.' ;
          key 'almFlwId timeStamp' ;
          leaf almFlwId {
            description 'Flow ID of alarm.' ;
            type uint32 ;

          }

          leaf timeStamp {
            description 'Time stamp of this alarm.' ;
            type uint32 ;

