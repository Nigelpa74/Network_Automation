            type uint32 ;

            units second ;
          }

          leaf almType {
            description 'Alarm type.' ;
            type enumeration {
              enum communication-alarm {
                value 0 ;
              }

              enum qos-alarm {
                value 1 ;
              }

              enum device-alarm {
                value 2 ;
              }

              enum process-err-alarm {
                value 3 ;
              }

              enum enviroment-alarm {
                value 4 ;
              }

            }

          }

          leaf almStat {
            description 'Alarm status.' ;
            type enumeration {
              enum disappear {
                value 0 ;
              }

              enum occur {
                value 1 ;
              }

              enum update {
                value 2 ;
              }

            }

          }

          leaf almClass {
            description 'Alarm class.' ;
            type enumeration {
              enum common-alarm {
                value 1 ;
              }

              enum digital-alarm {
                value 2 ;
              }

              enum simulation-alarm {
                value 3 ;
              }

              enum switch-event {
                value 4 ;
              }

              enum common-event {
                value 5 ;
              }

            }

          }

          leaf description {
            description 'Description for alarm.' ;
            type ncd:string-all {
              length 0..512 ;

            }

          }

          leaf caption {
            description "Alarm title. The 'caption' and 'description' together constitute a complete description of the alarm. That is, the complete description = 'caption' + 'description'." ;
            type ncd:string-all {
              length 0..80 ;

            }

          }

          leaf tpidType {
            description 'The TPID type for alarm been detected.' ;
            type uint16 ;

          }

          leaf tpid {
            description 'The TPID for alarm been detected.' ;
            type binary {
              length 62..128 ;

            }

          }

          leaf tpidLen {
            description 'The TPID length for alarm been detected.' ;
            type uint8 {
              range 62..128 ;

            }

          }

          leaf srcTpidType {
            description 'The TPID type of alarm from.' ;
            type uint16 ;

          }

          leaf srcTpid {
            description 'The TPID of alarm from.' ;
            type binary {
              length 62..128 ;

            }

          }

          leaf srcTpidLen {
            description 'The TPID length of alarm from.' ;
            type uint8 {
              range 62..128 ;

            }

          }

          leaf perfAlmType {
            description 'Type of performance alarm.' ;
            type performance-alarm-type ;

          }

          leaf thAlmPeriod {
            description 'Performance alarm type, 15(5)min or 24h.' ;
            type enumeration {
              enum fifteen-minutes {
                value 15 ;
              }

              enum twenty-four-hours {
                value 24 ;
              }

              enum invalid-period {
                value 254 ;
              }

              enum five-minutes {
                value 5 ;
              }

            }

          }

          leaf thPerfVal {
            description 'The performance value when alarm occur. Length 10 bytes( see document).' ;
            type binary {
              length 10 ;

            }

          }

          leaf protectTpidType {
            description 'Protect TPID type.' ;
            type uint16 ;

          }

          leaf protectTpid {
            description 'Protect TPID (protect group).' ;
            type binary {
              length 62..128 ;

            }

          }

          leaf protectTpidLen {
            description 'Protect TPID length.' ;
            type uint8 {
              range 62..128 ;

            }

          }

          leaf reason {
            description 'Reason code for switch-event or common event. Reason code see document.' ;
            type uint16 ;

          }

          leaf returnMode {
            description 'Return mode switching events.' ;
            type enumeration {
              enum return-mode {
                value 1 ;
              }

              enum not-return-mode {
                value 2 ;
              }

              enum invalid-mode {
                value 254 ;
              }

            }

          }

          leaf prtGroupWrkStat {
            description 'Work status of protect group.' ;
            type uint32 ;

          }

          leaf swtichTpidType {
            description "The TPID type be protected. That's the TPID type of previos and current." ;
            type uint16 ;

          }

          leaf previosTpid {
            description 'Leave TPID when protecting.' ;
            type binary {
              length 62..128 ;

            }

          }

          leaf previosTpidLen {
            description 'Leave TPID length when protecting.' ;
            type uint8 {
              range 62..128 ;

            }

          }

          leaf currentTpid {
            description 'The destination TPID when protecting.' ;
            type binary {
              length 62..128 ;

            }

          }

          leaf currentTpidLen {
            description 'The destination TPID length when protecting.' ;
            type uint8 {
              range 62..128 ;

            }

          }

          leaf protectType {
            description 'Protect type.' ;
            type uint16 ;

          }

          leaf beginTime {
            description 'The start time for search.When return is useless.' ;
            type ncd:datetime ;

          }

          leaf endTime {
            description 'The end time for search.When return is useless.' ;
            type ncd:datetime ;

          }

          leaf sort {
            description 'The sort of alarm.
1:resources-full.' ;
            type uint16 ;

            ncd:revise-date 2017-08-23 ;
          }

          leaf almOccurMs {
            description 'Occur millisecond.' ;
            type uint16 ;

            units millisecond ;
            ncd:revise-date 2018-09-05 ;
          }

          leaf almUpdateMs {
            description 'Occur millisecond.' ;
            type uint16 ;

            units millisecond ;
            ncd:revise-date 2018-09-05 ;
          }

          leaf almDisappearMs {
            description 'Disappear millisecond.' ;
            type uint16 ;

            units millisecond ;
            ncd:revise-date 2018-09-05 ;
          }

          leaf peid {
            description 'Satellite ID. 0:Invalid Value' ;
            type uint32 {
              range 0..250 ;

            }

            ncd:revise-date 2023-03-21 ;
          }

          leaf module {
            type ncd:string-all {
              length 0..35 ;

            }

            description 'Alarm module name.' ;
            ncd:revise-date 2025-01-06 ;
          }

          ncd:select "almFlwId timeStamp" ;
          ncd:select "almClass beginTime endTime" ;
          ncd:select "beginTime endTime" ;
          ncd:select sort ;
        }

      }

      container notification {
        description 'Notification info.' ;
        list record {
          description 'Used to search notification. 
Query condition: 
 (1) flwid + timestamp.
 (2) begin-time + end-time.
 (3) sort.' ;
          key 'flwid timestamp' ;
          leaf flwid {
            description 'Flow ID of alarm.' ;
            type uint32 ;

          }

          leaf timestamp {
            description 'Time stamp of this alarm.' ;
            type uint32 ;

          }

          leaf code {
            description 'Alarm code.' ;
            type uint32 ;

          }

          leaf severity {
            description 'Secerity level for alarm.' ;
            type enumeration {
              enum emergenciy {
                value 1 ;
              }

              enum alert {
                value 2 ;
              }

              enum critical {
                value 3 ;
              }

              enum error {
                value 4 ;
              }

              enum warning {
                value 5 ;
              }

              enum notice {
                value 6 ;
              }

              enum informational {
                value 7 ;
              }

              enum debug {
                value 8 ;
              }

            }

          }

          leaf occur-time {
            description 'Occur time, UTC, second from 1970-1-1 00:00:00.' ;
            type uint32 ;

            units second ;
          }

          leaf classify {
            description 'Alarm type.' ;
            type enumeration {
              enum communication-alarm {
                value 0 ;
              }

              enum qos-alarm {
                value 1 ;
              }

              enum device-alarm {
                value 2 ;
              }

              enum process-err-alarm {
                value 3 ;
              }

              enum enviroment-alarm {
                value 4 ;
              }

            }

          }

          leaf description {
            description 'Description for notification.' ;
            type ncd:string-all {
              length 0..512 ;

            }

          }

          leaf caption {
            description "Title for notification. The 'caption' and 'description' together constitute a complete description of the notification. That is, the complete description = 'caption' + 'description'." ;
            type ncd:string-all {
              length 0..80 ;

            }

          }

          leaf tpid-type {
            description 'The TPID type for alarm been detected.' ;
            type uint16 ;

          }

          leaf tpid {
            description 'The TPID for alarm been detected.' ;
            type binary {
              length 62..128 ;

            }

          }

          leaf tpidLen {
            description 'The TPID length for alarm been detected.' ;
            type uint8 {
              range 62..128 ;

            }

          }

          leaf begin-time {
            description 'The start time for search.When return is useless.' ;
            type ncd:datetime ;

          }

          leaf end-time {
            description 'The end time for search.When return is useless.' ;
            type ncd:datetime ;

          }

          leaf sort {
            description 'The sort of alarm.
1:resources-full.' ;
            type uint16 ;

            ncd:revise-date 2017-08-23 ;
          }

          leaf occur-ms {
            description 'Occur millisecond.' ;
            type uint16 ;

            units millisecond ;
            ncd:revise-date 2018-09-05 ;
          }

          leaf peid {
            description 'Satellite ID. 0:Invalid Value' ;
            type uint32 {
              range 0..250 ;

            }

            ncd:revise-date 2023-03-21 ;
          }

          leaf module {
            type ncd:string-all {
              length 0..35 ;

            }

            description 'Alarm module name.' ;
            ncd:revise-date 2025-01-06 ;
          }

          ncd:select "flwid timestamp" ;
          ncd:select "begin-time end-time" ;
          ncd:select sort ;
        }

      }

    }

  }

  notification current-alarm-report {
    description 'Report alarm to network manager.
Five type: common alarm, switch event, common event and performence alarm(digital or simulation).Every record is one of them.
common alarm --- flow-id/timestamp/code/severity/alarm-time/alarm-type/alarm-status/alarm-class/description/tpid-type/tpid/tpid-length/source-tpid-type/source-tpid/source-tpid-length.
performence alarm --- flow-id/timestamp/code/severity/alarm-time/alarm-type/alarm-status/alarm-class/description/tpid-type/tpid/tpid-length/source-tpid-type/source-tpid/source-tpid-length/perf-alarm-type/perf-alarm-period/perf-alarm-value.
switch event --- flow-id/timestamp/code/severity/alarm-time/alarm-type/alarm-status/alarm-class/description/protect-tpid-type/protect-tpid/protect-tpid-length/reason/return-mode/protect-group-work-status/swtich-tpid-type/previous-tpid/previous-tpid-length/current-tpid/current-tpid-length/protect-type.
common event --- flow-id/timestamp/code/severity/occurrence-time/alarm-class/description/tpid-type/tpid/tpid-length/reason.' ;
    if-feature netconf-report ;

    leaf flow-id {
      config false ;
      description 'Flow ID of alarm.' ;
      type uint32 ;

    }

    leaf timestamp {
      config false ;
      description 'Time stamp of this alarm.' ;
      type uint32 ;

    }

    leaf code {
      config false ;
      description 'Alarm code.' ;
      type uint32 ;

    }

    leaf severity {
      config false ;
      description 'Secerity level for alarm.' ;
      type alarm-level ;

    }

    leaf occurrence-time {
      config false ;
      description 'Occurrence time, UTC, second from 1970-1-1 00:00:00. This leaf is valid when alarm stat is occur.' ;
      type uint32 ;

      units second ;
    }

    leaf update-time {
      config false ;
      description 'Occur time, UTC, second from 1970-1-1 00:00:00. This leaf is valid when alarm stat is update.' ;
      type uint32 ;

      units second ;
    }

    leaf disappeared-time {
      config false ;
      description 'Disappear time, UTC, second from 1970-1-1 00:00:00.' ;
      type uint32 ;

      units second ;
    }

    leaf alarm-type {
      config false ;
      description 'Alarm type.' ;
      type alarm-type ;

    }

    leaf alarm-status {
      config false ;
      description 'Alarm status.' ;
      type enumeration {
        enum disappear {
          value 0 ;
        }

        enum occur {
          value 1 ;
        }

        enum update {
          value 2 ;
        }

      }

    }

    leaf alarm-class {
      config false ;
      description 'Alarm class.' ;
      type enumeration {
        enum common-alarm {
          value 1 ;
        }

        enum digital-alarm {
          value 2 ;
        }

        enum simulation-alarm {
          value 3 ;
        }

        enum switch-event {
          value 4 ;
        }

        enum common-event {
          value 5 ;
        }

      }

    }

    leaf description {
      config false ;
      description 'Description for alarm.' ;
      type ncd:string-all {
        length 0..512 ;

      }

    }

    leaf caption {
      config false ;
      description "Alarm title. The 'caption' and 'description' together constitute a complete description of the alarm. That is, the complete description = 'caption' + 'description'." ;
      type ncd:string-all {
        length 0..80 ;

      }

    }

    leaf tpid-type {
      config false ;
      description 'The TPID type for alarm been detected.' ;
      type uint16 ;

    }

    leaf tpid {
      config false ;
      description 'The TPID for alarm been detected.' ;
      type binary {
        length 62..128 ;

      }

    }

    leaf tpid-length {
      config false ;
      description 'The TPID length for alarm been detected.' ;
      type uint8 {
        range 62..128 ;

      }

    }

    leaf source-tpid-type {
      config false ;
      description 'The TPID type of alarm from.' ;
      type uint16 ;

    }

    leaf source-tpid {
      config false ;
      description 'The TPID of alarm from.' ;
      type binary {
        length 62..128 ;

      }

    }

    leaf source-tpid-length {
      config false ;
      description 'The TPID length of alarm from.' ;
      type uint8 {
        range 62..128 ;

      }

    }

    leaf perf-alarm-type {
      config false ;
      description 'Type of performance alarm.' ;
      type performance-alarm-type ;

    }

    leaf perf-alarm-period {
      config false ;
      description 'Performance alarm type, 15(5)min or 24h.' ;
      type enumeration {
        enum fifteen-minutes {
          value 15 ;
        }

        enum twenty-four-hours {
          value 24 ;
        }

        enum invalid-period {
          value 254 ;
        }

        enum five-minutes {
          value 5 ;
        }

      }

    }

    leaf perf-alarm-value {
      config false ;
      description 'The performance value when alarm occur. Length 10 bytes( see document).' ;
      type binary {
        length 10 ;

      }

    }

    leaf protect-tpid-type {
      config false ;
      description 'Protect TPID type.' ;
      type uint16 ;

    }

    leaf protect-tpid {
      config false ;
      description 'Protect TPID (protect group).' ;
      type binary {
        length 62..128 ;

      }

    }

    leaf protect-tpid-length {
      config false ;
      description 'Protect TPID length.' ;
      type uint8 {
        range 62..128 ;

      }

    }

    leaf reason {
      config false ;
      description 'Reason code for switch-event or common event. Reason code see document.' ;
      type uint16 ;

    }

    leaf return-mode {
      config false ;
      description 'Return mode switching events.' ;
      type enumeration {
        enum return-mode {
          value 1 ;
        }

        enum not-return-mode {
          value 2 ;
        }

        enum invalid-mode {
          value 254 ;
        }

      }

    }

    leaf protect-group-work-status {
      config false ;
      description 'Work status of protect group.' ;
      type uint32 ;

    }

    leaf swtich-tpid-type {
      config false ;
      description "The TPID type be protected. That's the TPID type of previos and current." ;
      type uint16 ;

    }

    leaf previous-tpid {
      config false ;
      description 'Leave TPID when protecting.' ;
      type binary {
        length 62..128 ;

      }

    }

    leaf previous-tpid-length {
      config false ;
      description 'Leave TPID length when protecting.' ;
      type uint8 {
        range 62..128 ;

      }

    }

    leaf current-tpid {
      config false ;
      description 'The destination TPID when protecting.' ;
      type binary {
        length 62..128 ;

      }

    }

    leaf current-tpid-length {
      config false ;
      description 'The destination TPID length when protecting.' ;
      type uint8 {
        range 62..128 ;

      }

    }

    leaf protect-type {
      config false ;
      description 'Protect type.' ;
      type uint16 ;

    }

    leaf sort {
      config false ;
      description 'The sort of alarm.
1:resources-full.' ;
      type uint16 ;

      ncd:revise-date 2017-08-23 ;
    }

    leaf occurrence-ms {
      config false ;
      description 'Occurrence millisecond. This leaf is valid when alarm stat is occur.' ;
      type uint16 {
        range 0..999 ;

      }

      units millisecond ;
      ncd:revise-date 2018-09-05 ;
    }

    leaf update-ms {
      config false ;
      description 'Occur millisecond. This leaf is valid when alarm stat is update.' ;
      type uint16 ;

      units millisecond ;
      ncd:revise-date 2018-09-05 ;
    }

    leaf disappeared-ms {
      config false ;
      description 'Disappear millisecond. This leaf is valid when alarm stat is disappear.' ;
      type uint16 ;

      units millisecond ;
      ncd:revise-date 2018-09-05 ;
    }

    leaf peid {
      config false ;
      description 'Satellite ID. 0:Invalid Value' ;
      type uint32 {
        range 0..250 ;

      }

      ncd:revise-date 2023-03-21 ;
    }

    leaf module {
      type ncd:string-all {
        length 0..35 ;

      }

      description 'Alarm module name.' ;
      config false ;
      ncd:revise-date 2025-01-06 ;
    }

    ncd:revise-date 2014-11-28 ;
  }

