            type enumeration {
              enum emergenciy {
                value 1 ;
              }

              enum alert {
                value 2 ;
              }

              enum critical {
                value 3 ;
              }

              enum error {
                value 4 ;
              }

              enum warning {
                value 5 ;
              }

              enum notice {
                value 6 ;
              }

              enum informational {
                value 7 ;
              }

              enum debug {
                value 8 ;
              }

            }

          }

          leaf almOccurTime {
            description 'Occur time, UTC, second from 1970-1-1 00:00:00.' ;
            type uint32 ;

            units second ;
          }

          leaf almDisappearTime {
            description 'Disappear time, UTC, second from 1970-1-1 00:00:00.' ;
            type uint32 ;

            units second ;
          }

          leaf almUpdateTime {
