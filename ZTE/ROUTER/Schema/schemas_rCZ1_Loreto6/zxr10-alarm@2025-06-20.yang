  rpc alarm-clear {
    input {
      container clear-para {
        description 'The parameters for alarm clearing.' ;
        config false ;
        leaf-list alarm-flow-id {
          type uint32 ;

          description 'The alarm flow ID to be cleared. No more than 100 entries can be cleared per operation.' ;
        }

      }

    }

    description 'This operation deletes uncleared alarms on the device. ' ;
    output {
      leaf clear-result {
        type alarm-clear-result ;

        config false ;
        description 'Result of the clear operation.' ;
      }

      container flow-id-result {
        leaf processed-number {
          type uint32 ;

          description 'Number of processed flow ID.' ;
        }

        list non-existent-flow-id {
          leaf alarm-flow-id {
            type uint32 ;

            description 'The alarm flow ID.' ;
          }

          description 'List of alarm flow IDs that do not exist.' ;
        }

        description 'Result of the flow ID.' ;
        config false ;
        list success-flow-id {
          leaf alarm-flow-id {
            type uint32 ;

            description 'The alarm flow ID.' ;
          }

          description 'List of alarm flow IDs that are cleared successfully. If the clear-result node value is success, this list is not reported.' ;
        }

      }

    }

    ncd:revise-date 2025-06-20 ;
  }

}
