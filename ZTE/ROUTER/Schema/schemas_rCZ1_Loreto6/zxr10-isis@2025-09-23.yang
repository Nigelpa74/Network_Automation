              value 1 ;
              description 'The  ipv6-state of ISIS interface is down.' ;
              status current ;

            }

            enum up {
              value 2 ;
              description 'The  ipv6-state of ISIS interface is up.' ;
              status current ;

            }

          }

          config false ;
          mandatory false ;
        }

        config false ;
        ncd:revise-date 2024-10-31 ;
      }

