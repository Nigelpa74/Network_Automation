        }

        leaf ipv4-state {
          description 'The state of ISIS IPv4 interface.' ;
          type enumeration {
            enum down {
              value 1 ;
              description 'The  ipv4-state of ISIS interface is down.' ;
              status current ;

            }

            enum up {
              value 2 ;
              description 'The  ipv4-state of ISIS interface is up.' ;
              status current ;

            }

          }

          config false ;
          mandatory false ;
        }

        leaf ipv6-state {
