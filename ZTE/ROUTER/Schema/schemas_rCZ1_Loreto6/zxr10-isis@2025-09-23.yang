  revision 2013-10-30 {
    description 'The initial version.' ;
  }

  feature sr-feature {
    description 'Only for the use of 15K ,T8K and PC.' ;
    status current ;

  }

  feature pc-feature {
    description 'Router and switch PC feature.' ;
    status current ;

  }

  feature aii-feature {
    description 'Router and switch aii feature.' ;
    status current ;

  }

  feature bier-feature {
    description 'Router and switch bier feature.' ;
    status current ;

  }

  feature bier-lfa-feature {
    description 'Exclude 15K and T8K.' ;
    status current ;

    ncd:revise-date 2024-08-13 ;
  }

  feature frr-feature {
    description 'Fast reroute feature.' ;
    status current ;

    ncd:revise-date 2023-02-20 ;
  }

  feature reverse-metric-feature {
    description 'Reverse metric feature.' ;
    status current ;

    ncd:revise-date 2023-02-20 ;
  }

  feature micr-sr-feature {
    description 'Microloop prevention segment routing feature.' ;
    status current ;

    ncd:revise-date 2023-02-20 ;
  }

  feature te-link-feature {
    description 'Te link loss feature.' ;
    status current ;

    ncd:revise-date 2023-02-20 ;
  }

  feature bfd-feature {
    description 'Bfd mode feature.' ;
    status current ;

    ncd:revise-date 2023-02-20 ;
  }

  feature remote-lfa-feature {
    description 'Static remote lfa feature.' ;
    status current ;

    ncd:revise-date 2023-02-20 ;
  }

  feature intf-ldp-sync-feature {
    description 'Interface LDP-ISIS synchronization feature.' ;
    status current ;

    ncd:revise-date 2025-04-25 ;
  }

  feature srv6-adjacency-set-feature {
    description 'SRv6 adjacency set feature.' ;
    status current ;

    ncd:revise-date 2025-05-13 ;
  }

  typedef isis-level {
    description 'Level(s) will be effected on.' ;
    type enumeration {
      enum level-1 {
        value 1 ;
        description 'Level-1 will be effected on.' ;
        status current ;

      }

      enum level-2 {
        value 2 ;
        description 'Level-2 will be effected on.' ;
        status current ;

      }

      enum level-1-2 {
        value 3 ;
        description 'Level-1-2 will be effected on.' ;
        status current ;

      }

    }

  }

  typedef isis-state {
    description 'The state of some isis attributes.' ;
    type enumeration {
      enum disable {
        value 0 ;
        description 'The state is off.' ;
        status current ;

      }

      enum enable {
        value 1 ;
        description 'The state is on.' ;
        status current ;

      }

    }

  }

  container configuration {
    description 'Configuration.' ;
    container route-isis {
      description 'Route ISIS configuration.' ;
      container isis-instances {
        description 'ISIS instance information.' ;
        list isis-instance {
          description 'The information of ISIS instance.' ;
          key process-id ;
          leaf process-id {
            description 'ISIS process ID' ;
            type uint32 {
              range 0..65535 ;

            }

            config true ;
            mandatory false ;
          }

          leaf vrf-name {
            description 'VPN routing/forwarding instance (VRF) name.' ;
            type string {
              length 1..32 ;

            }

            config true ;
            mandatory false ;
          }

          container multi-instance {
            description 'Configure multiple instance.' ;
            leaf instance-id {
              description 'Instance ID.' ;
              type uint32 {
                range 1..65535 ;

              }

              config true ;
              mandatory false ;
            }

            config true ;
            ncd:revise-date 2022-08-16 ;
          }

          container system-ids {
            description 'System id.' ;
            list system-id {
              description 'System-ID.' ;
              key isis-system-id ;
              max-elements 1 ;
              leaf isis-system-id {
                description 'A system ID for an ISIS instance.' ;
                type ncd:mac-address ;

                config true ;
                mandatory false ;
              }

              leaf range {
                description 'The range of system-ID.' ;
                type uint8 {
                  range 0..32 ;

                }

                default 0 ;
                config true ;
                mandatory false ;
              }

              config true ;
            }

            config true ;
          }

          container authentications {
            description 'Authentication information.' ;
            presence "encrypted password" ;
            list authentication {
              description 'Authentication information.' ;
              key level ;
              leaf level {
                description 'Level(s) will be effected on.' ;
                type uint8 {
                  range 0..2 ;

                }

                config true ;
                mandatory false ;
              }

              choice authen-word {
                description 'Password' ;
                case word {
                  description 'Word case.' ;
                  leaf authen-pwd {
                    description 'The clear password.' ;
                    type string {
                      length 1..100 ;

                    }

                    config true ;
                    mandatory true ;
                  }

                }

                case clear {
                  description 'Authentication clear password case.' ;
                  leaf clear-pwd {
                    description 'Specify the clear password.' ;
                    type string {
                      length 1..100 ;

                    }

                    config true ;
                    mandatory true ;
                  }

                }

                case encrypted-word {
                  description 'The label of encrypted password' ;
                  leaf encrypted-pwd {
                    description 'Authentication encrypted password' ;
                    type string {
                      length 24..192 ;

                    }

                    config true ;
                    mandatory true ;
                  }

                }

                config true ;
                mandatory false ;
              }

              config true ;
            }

            config true ;
          }

          container authentication-types {
            description 'Authentication type.' ;
            presence "authen type" ;
            list authen-type {
              description 'Authentication type' ;
              key level ;
              leaf level {
                description 'Level(s) would be effected on.' ;
                type uint8 {
                  range 0..2 ;

                }

                config true ;
                mandatory false ;
              }

              leaf authen-type {
                description 'Authentication type.' ;
                type enumeration {
                  enum md5 {
                    value 1 ;
                    status current ;

                  }

                  enum text {
                    value 2 ;
                    status current ;

                  }

                }

                default text ;
                config true ;
                mandatory false ;
              }

              config true ;
            }

            config true ;
          }

          container areas {
            description 'Areas.' ;
            list area {
              description 'Area address information.' ;
              key area-addr ;
              max-elements 3 ;
              leaf area-addr {
                description 'ISIS area address' ;
                type ncd:area-id ;

                config true ;
                mandatory false ;
              }

              config true ;
            }

            config true ;
          }

          container isis-attr {
            description 'ISIS attribution.' ;
            leaf isis-protocol-state {
              description 'Flag of that system is enable.' ;
              type isis-state ;

              default enable ;
              config true ;
              mandatory false ;
            }

            leaf is-type {
              description 'Level(s) of the ISIS instance.' ;
              type isis-level ;

              default level-1-2 ;
              config true ;
              mandatory false ;
            }

            leaf i-spf {
              description 'Flag of the i-spf is enable.' ;
              type boolean ;

              config true ;
              mandatory false ;
            }

            leaf distance {
              description 'IPv4 management distance.This leaf is out of use. The value of output is invalid.' ;
              type uint8 {
                range 1..255 ;

              }

              default 115 ;
              config true ;
              mandatory false ;
            }

            leaf maximum-paths {
              description 'Maximum of paths to one destination.' ;
              type uint32 {
                range 1..128 ;

              }

              default 1 ;
              config true ;
              mandatory false ;
            }

            leaf lsp-size-originate {
              description 'LSP MTU' ;
              type uint16 {
                range 512..7680 ;

              }

              units byte ;
              default 1492 ;
              config true ;
              mandatory false ;
            }

            leaf lsp-size-recieve {
              description 'The size of LSP can be received.' ;
              type uint16 {
                range 512..7680 ;

              }

              units byte ;
              default 1492 ;
              config true ;
              mandatory false ;
            }

            leaf snp-authentication-state {
              description 'Flag of the ISIS instance whether support SNP authentication.' ;
              type enumeration {
                enum disable-snp-authentication {
                  value 0 ;
                  description 'Config disable-snp-authentication.' ;
                  status current ;

                }

                enum enable-snp-authentication {
                  value 1 ;
                  description 'Config enable-snp-authentication.' ;
                  status current ;

                }

              }

              default enable-snp-authentication ;
              config true ;
              mandatory false ;
            }

            leaf ignore-lsp-errors {
              description 'Flag of the system whether would ignore LSP checksum error.' ;
              type isis-state ;

              default enable ;
              config true ;
              mandatory false ;
            }

            leaf lsp-refresh-time {
              description 'LSP refresh interval.' ;
              type uint16 {
                range 1..65535 ;

              }

              units second ;
              default 900 ;
              config true ;
              mandatory false ;
            }

            leaf max-lsp-lifetime {
              description 'Max LSP life time.' ;
              type uint16 {
                range 1..65535 ;

              }

              units second ;
              default 1200 ;
              config true ;
              mandatory false ;
            }

            leaf restart-state {
              description 'Flag of the system whether enable GR.' ;
              type isis-state ;

              config true ;
              mandatory false ;
            }

            leaf snmp-context {
              description 'ISIS mib context name' ;
              type string {
                length 1..30 ;

              }

              config true ;
              mandatory false ;
            }

            leaf local-mt-state {
              description 'Flag of that IGP-MT is enable.' ;
              type isis-state ;

              config true ;
              mandatory false ;
            }

            leaf fast-reroute-type {
              description 'FRR type' ;
              type enumeration {
                enum down-stream-path {
                  value 1 ;
                  status current ;

                }

              }

              config true ;
              mandatory false ;
            }

            leaf hostname-dynamic {
              description 'Dynamic hostname.' ;
              type isis-state ;

              default enable ;
              config true ;
              mandatory false ;
            }

            leaf fast-flood-num {
              description 'Number of the fast flooding LSPs.' ;
              type uint8 {
                range 1..15 ;

              }

              config true ;
              mandatory false ;
            }

            leaf ipv6-frr-type {
              description 'IPv6 fast-reroute type.' ;
              type enumeration {
                enum down-stream-path {
                  value 1 ;
                  description 'The FRR type is down-stream-path.' ;
                  status current ;

                }

              }

              config true ;
              mandatory false ;
            }

            leaf ipv6-distance {
              description 'ISIS IPv6 management distance.This leaf is out of use. The value of output is invalid.' ;
              type uint8 {
                range 1..255 ;

              }

              default 115 ;
              config true ;
              mandatory false ;
            }

            leaf ipv6-maximum-paths {
              description 'Maximum of paths to one destination of IPv6.' ;
              type uint32 {
                range 1..128 ;

              }

              default 1 ;
              config true ;
              mandatory false ;
            }

            leaf ipv6-set-ol-bit {
              description 'Set IPv6 OL bit.' ;
              type boolean ;

              config true ;
              mandatory false ;
            }

            leaf mpls-ldp-auto-config {
              description 'The state of mpls ldp auto-config.' ;
              type isis-state ;

              config true ;
              mandatory false ;
            }

            leaf auto-metric-state {
              description 'Whether adjust IS-IS interface metric according to bandwidth.' ;
              type isis-state ;

              default disable ;
              config true ;
              mandatory false ;
              ncd:revise-date 2015-07-21 ;
            }

            leaf auto-metric-ref-bandwidth {
              description 'Use reference bandwidth to assign IS-IS metric' ;
              type uint32 {
                range 1..2147483648 ;

              }

              default 100 ;
              config true ;
              mandatory false ;
              ncd:revise-date 2015-07-21 ;
            }

            leaf ipv6-auto-metric-state {
              description 'Whether adjust IS-IS IPv6 interface metric according to bandwidth.' ;
              type isis-state ;

              default disable ;
              config true ;
              mandatory false ;
              ncd:revise-date 2016-08-04 ;
            }

            leaf ipv6-auto-metric-ref-bw {
              description 'Use reference bandwidth to assign IS-IS IPv6 metric' ;
              type uint32 {
                range 1..2147483648 ;

              }

              default 100 ;
              config true ;
              mandatory false ;
              ncd:revise-date 2016-08-04 ;
            }

            leaf hostname-string {
              description 'ISIS hostname for instance' ;
              type string {
                length 1..64 ;

              }

              config true ;
              mandatory false ;
              ncd:revise-date 2020-03-11 ;
            }

            leaf description {
              description 'Description of process.' ;
              type string {
                length 1..63 ;

              }

              config true ;
              mandatory false ;
              ncd:revise-date 2020-04-09 ;
            }

            leaf segment-routing-mpls-adj-sid {
              if-feature sr-feature ;

              description 'Add the application mode of segment-routing-mpls-adj-sid.' ;
              type enumeration {
                enum hybrid {
                  value 1 ;
                  description 'Hybrid mode.' ;
                  status current ;

                }

                enum static {
                  value 0 ;
                  description 'Static mode.' ;
                  status current ;

                }

              }

              default hybrid ;
              config true ;
              mandatory false ;
              ncd:revise-date 2020-04-09 ;
            }

            leaf ipv6-segment-routing-mpls-adj-sid {
              if-feature sr-feature ;

              description 'Add the application mode of ipv6-segment-routing-mpls-adj-sid.' ;
              type enumeration {
                enum hybrid {
                  value 1 ;
                  description 'Hybrid mode.' ;
                  status current ;

                }

                enum static {
                  value 0 ;
                  description 'Static mode.' ;
                  status current ;

                }

              }

              default hybrid ;
              config true ;
              mandatory false ;
              ncd:revise-date 2020-04-09 ;
            }

            leaf te-link-loss-anomalous-attach-sd {
              if-feature te-link-feature {
                ncd:revise-date 2023-02-20 ;
              }

              description 'Advertise te link loss anomalous attached with sd.' ;
              type enumeration {
                enum disable {
                  value 0 ;
                  description 'Disable advertise te link loss anomalous attached with sd.' ;
                  status current ;

                }

                enum attach-sd {
                  value 1 ;
                  description 'Advertise te link loss anomalous attached with sd.' ;
                  status current ;

                }

              }

              default disable ;
              config true ;
              mandatory false ;
              ncd:revise-date 2020-04-15 ;
            }

            leaf adjacency-hold-time {
              description 'Adjacency hold time.' ;
              type uint16 {
                range 0..65535 ;

              }

              units second ;
              default 0 ;
              config true ;
              mandatory false ;
              ncd:revise-date 2020-10-13 ;
            }

            leaf lsp-hold-time {
              description 'Lsp hold time' ;
              type uint16 {
                range 0..65535 ;

              }

              units second ;
              default 0 ;
              config true ;
              mandatory false ;
              ncd:revise-date 2020-10-13 ;
            }

            leaf te-link-bandwidth {
              description 'Advertise te link bandwidth.' ;
              type isis-state ;

              default disable ;
              config true ;
              mandatory false ;
              ncd:revise-date 2020-12-10 ;
            }

            leaf te-link-loss {
              description 'Advertise te link bandwidth.' ;
              type isis-state ;

              default disable ;
              config true ;
              mandatory false ;
              ncd:revise-date 2021-01-15 ;
            }

            leaf prefix-attribute-advertise {
              description 'Set ipv4 prefix-attribute advertise mode' ;
              type enumeration {
                enum auto {
                  value 0 ;
                  description 'Some prefix with prefix-attribute sub-TLV according to scenario' ;
                  status current ;

                }

                enum all {
                  value 1 ;
                  description 'All prefix with prefix-attribute sub-TLV' ;
                  status current ;

                }

