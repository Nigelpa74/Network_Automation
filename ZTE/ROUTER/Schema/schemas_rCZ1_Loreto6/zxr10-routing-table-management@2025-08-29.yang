module zxr10-routing-table-management {
  namespace "http://www.zte.com.cn/zxr10/netconf/schema/rosng/rtm" ;
  prefix rtm ;
  yang-version 1 ;
  import zxr10-netconf-defs {
    prefix ncd ;
  }

  organization "ZTE Corporation" ;
  contact "ZTE Corporation
  Nanjing Institute of ZTE Corporation
  No.68 Zijinghua Rd. Yuhuatai District, Nanjing, China
  Tel: +86-25-52870000" ;
  description 'The netconf module to describe the routing table management(rtm).' ;
  revision 2025-08-29 {
    description 'Modify the ttl-ignore and tos-ignore node enumeration value.' ;
  }

  revision 2025-06-08 {
    description 'Add three new leaf "ttl-ignore","tos-ignore","flowlabel" for container "rtm:ldsh-hash-key-board" and "rtm:ldsh-hash-key-global".Add a new container "/rtm:configuration/rtm:rtm/rtm:ldsh/rtm:hash/rtm:ldsh-hash-key-interface".' ;
  }

  revision 2025-03-27 {
    description 'Add container /rtm:configuration/rtm:rtm/rtm:ldsh/rtm:load-sharing-mode for load-sharing mode configuration.' ;
  }

  revision 2024-07-06 {
    description '1. Add leaf node "routeChangeType" to "changeRouteInfo/ipRoute/forward-infos/forward-info" and "changeRoute6Info/ipv6Route/forward-infos /forward-info" to add leaf node routeChangeType for telemetry to report route change types.
2. Delete the key attribute "metric" from the leaf node added in "changeRouteInfo/ipRoute/forward-infos/forward-info" and "changeRoute6Info/ipv6Route/forward-infos/forward-info".	' ;
  }

  revision 2024-06-04 {
    description 'Support the configuration of multiple factors for the upstream flow participating in the hash operation. The path is "configuration/rtm/hash/ldsh-hash-fields/ldsh-hash-field/multi-factors"' ;
  }

  revision 2024-06-01 {
    description 'Remove the project label "PC.SWITCH" from feature "hash-port-attribute"; add the project label "PC.SWITCH" to feature "hash-port-factor".' ;
  }

  revision 2024-04-07 {
    description 'Add nodes to support WTR in second. The paths are configuration/rtm/ldsh/wtr/wtr-second, configuration/rtm/ldsh/public-wtr, configuration/rtm/ldsh/private-wtr.' ;
  }

  revision 2024-04-02 {
    description 'Add case "configuration/rtm/ldsh/hash/hash-algorithm/ldsh-hash-algorithm/algorithm/hash".' ;
  }

  revision 2024-02-22 {
    description 'The notification leaf nodes "routeSummary/specific/route-owner" and "route6Summary/specific/route-owner" are defined as keys.' ;
  }

  revision 2024-01-30 {
    description 'Add choice "configuration/rtm/ldsh/hash/ldsh-hash-fields/ldsh-hash-fields/hash-element-port" to distinguish incoming port as hash factor..' ;
  }

  revision 2024-01-16 {
    description 'Add list "forward-infos" for telemetry.' ;
  }

  revision 2023-10-11 {
    description 'Add one ipv6 route owner type(bgp_fs)to the enumeration of ipv6-owner-type.
Add one route type(bgp_fs) to the list of route6-statistic.
Add one route type(bgp_fs) to the list of route6-path-statistic.
Add one ipv6 route owner type(bgp-fs)to the enumeration of owner-type.
Add one route type(bgp-fs) to the list of route-statistic.
Add one route type(bgp-fs) to the list of route-path-statistic.' ;
  }

  revision 2023-04-07 {
    description 'Add if-feature for load sharing scramble. The path is configuration/rtm/ldsh/hash/ldsh-hash-scramble.' ;
  }

  revision 2023-03-07 {
    description 'Add one ipv6 route owner type(ipv6_source)to the enumeration of ipv6-owner-type.
Add one route type(ipv6_source) to the list of route6-statistic.
Add one route type(ipv6_source) to the list of route6-path-statistic.' ;
  }

  revision 2022-11-07 {
    description 'Add node for requirement: show the routes by assigned prefix in all vrfs.' ;
  }

  revision 2022-08-15 {
    description 'Add node for selecting load-sharing hash crc polynomial, the path is configuration/rtm/ldsh/hash/ldsh-hash-polynomials.' ;
  }

  revision 2022-05-13 {
    description 'Add node for dynamic VPN routes information in list route-summary-all' ;
  }

  revision 2022-04-26 {
    description 'command load-share support new parameter:l2-l3' ;
  }

  revision 2022-02-22 {
    description "Support show VPN name with '?'." ;
  }

  revision 2022-01-26 {
    description 'Remove the container of configuration/rtm/ldsh/hash/ldsh-hash-fields/ldsh-hash-fields/hash-element/l3/l3-elements, restore the l3 leaf node.' ;
  }

  revision 2021-12-24 {
    description 'Modify for UFP-58754 show direct-forward-type in route forward table searching result.' ;
  }

  revision 2021-11-22 {
    description 'Add new node to query OSPFv2,OSPFv3,ISISv4,ISISv6,BGP4,BGP4+ global or vpn route summary for telemetry' ;
  }

  revision 2021-11-16 {
    description 'Modify for ROSNG-202625:optimize for command load-sharing support filed gtp te-id' ;
  }

  revision 2021-06-22 {
    description 'Add ignore-cword leaf which in configuration/rtm/ldsh/hash/mpls-ldsh-hash-fields/mpls-l2-ldsh-hash-field.' ;
  }

  revision 2021-05-11 {
    description 'Obsolete deprecated containers of frr6, route6, route6-path-statistic, route6-statistics, state/rtm6/route-summary-alls.' ;
  }

  revision 2021-04-15 {
    description 'Add node to set hash fields element of ignoring protocols.' ;
  }

  revision 2021-03-06 {
    description 'Add nodes for MPAR routes.' ;
  }

  revision 2020-10-16 {
    description 'Add one route owner type(npt_v6)to the enumeration of owner-type.
Add one route type(npt_v6) to the list of route6-statistic.
Add one route type(npt_v6) to the list of route6-path-statistic.' ;
  }

  revision 2020-05-05 {
    description 'add gateway leaf in instance node iproute\iproute6' ;
  }

  revision 2020-03-23 {
    description 'Modify the data type of vpnname nodes to support more VPN(such as DCN).' ;
    reference "container frr/route/route-statistics/route-path-statistics/route-summary-alls
    container frr6/route6/route6-statistics/route6-path-statistics/route6-summary-alls" ;
  }

  revision 2020-02-13 {
    description 'Add new nodes for incoming port number to hash fields. The paths are "configuration/rtm/ldsh/hash/ldsh-hash-fields/ldsh-hash-fields/incoming-port-num","configuration/rtm/ldsh/hash/mpls-ldsh-hash-fields/mpls-ldsh-hash-field/incoming-port-num" and "configuration/rtm/ldsh/hash/mpls-ldsh-hash-fields/mpls-l2-hash-field/incoming-port-num".' ;
  }

  revision 2019-11-29 {
    description 'Add new nodes to display the status of slave nexthop. The paths are "state/rtm/frr/ipfrr/route-slave-status" and "state/rtm6/frr6/ipfrr6/route6-slave-status".' ;
  }

  revision 2019-10-29 {
    description 'Rollback the element value of enum named owner-type.
Rollback the element value of enum name ipv6-owner-type.
Reason: Network management can not update cause of the modification of the enum.' ;
  }

  revision 2019-07-23 {
    description 'Add one route owner type(bgp-evpn) to the enumeration of owner-type.
Add one route type(bgp-evpn) to the list of route-statistic.
Add one route type(bgp-evpn) to the list of route-path-statistic.
Add one route type(bgp-evpn) to the list of route6-statistic.

Add one route type(bgp-evpn) to the list of route6-path-statistic.' ;
  }

  revision 2019-05-28 {
    description 'Add a notification node of changed IPv6 routes, the path is "changeRoute6Info".' ;
  }

  revision 2019-01-23 {
    description 'Add a notification node of changed IP routes, the path is "changeRouteInfo".' ;
  }

  revision 2019-01-10 {
    description 'Add new owner-type dynamic-leased-line into model.' ;
  }

  revision 2018-07-20 {
    description 'Modify for suit ipv4 route have ipv6 nexthop case.' ;
  }

  revision 2018-07-12 {
    description 'Add one route owner type(nat-mask) to the enumeration of owner-type.
Add one route type(nat-mask) to the list of route-statistic.
Add one route type(nat-mask) to the list of route-path-statistic.
Add one route type(srv6) to the list of route6-statistic.
Add one route type(srv6) to the list of route6-path-statistic.
Add one route owner type(srv6) to the enumeration of ipv6-owner-type.' ;
  }

  revision 2017-03-09 {
    description 'Add the state node for IPv4 forwarding route.
The path is "state/rtm/route/forward-info".' ;
  }

  revision 2017-02-06 {
    description 'Add two route owner type(sgw and bras-pool) to the enumeration of owner-type.
Add two route type(sgw and bras-pool) to the list of route-statistic.
Add two route type(sgw and bras-pool) to the list of route-path-statistic.
Add one route type(bras-pool) to the list of route6-statistic.
Add one route type(bras-pool) to the list of route6-path-statistic.
Add one route owner type(bras-pool) to the enumeration of ipv6-owner-type.' ;
  }

  revision 2017-01-13 {
    description '1.Add the mpls-l2-ldsh-hash-field list in configuration/rtm/ldsh/mpls-ldsh-hash-fields.' ;
  }

  revision 2016-10-26 {
    description 'This Netconf module provides IPv4/IPv6 routes statistics of global and all VPN routes
this version add two nodes:
1 state/rtm/route-summary-alls
2 state/rtm6/route-summary-alls' ;
  }

  revision 2016-04-16 {
    description 'This Netconf module provides commonly used textual conventions for RTM.
This version add four nodes:
1.state\rtm6\route6-statistics\route6-statistics\user-network;
2.state\rtm6\route6-statistics\route6-statistics\user-special;
3.state\rtm6\route6-path-statistics\route6-path-statistics\user-network;
4.state\rtm6\route6-path-statistics\route6-path-statistics\user-special;
This version add two new values:user-network and user-special in choice ipv6-owner-type.' ;
  }

  revision 2015-05-18 {
    description 'This Netconf module provides commonly used textual conventions for RTM.
This version add two nodes:
1.state\rtm6\route6-statistics\route6-statistics\ldp-area;
2.state\rtm6\route6-path-statistics\route6-path-statistics\ldp-area;
This version add a new value:ldp-area in choice ipv6-owner-type.' ;
  }

  revision 2015-05-07 {
    description "This Netconf module provides commonly used textual conventions for RTM.

    This version change the MimDateType of iproute6's route-owner." ;
  }

  revision 2015-04-15 {
    description "This Netconf module provides commonly used textual conventions for RTM.

    This version change the MimDateType of iproute6's route-owner." ;
  }

  revision 2015-02-10 {
    description 'This Netconf module provides commonly used textual conventions for RTM.
This version change spell of msp and lsp.' ;
  }

  revision 2015-02-02 {
    description "This Netconf module provides commonly used textual conventions for RTM.

    This version change the MimDateType of iproute's route-owner." ;
  }

  revision 2015-01-19 {
    description 'This Netconf module provides commonly used textual conventions for RTM.
This version change the valuemap of ipv6 on ldsh-hash-key-board and ldsh-hash-key-global.' ;
  }

  revision 2014-12-05 {
    description 'This Netconf module provides commonly used textual conventions for RTM.
This version add filter for ldsh-hash-key.' ;
  }

  revision 2014-09-16 {
    description 'This Netconf module provides commonly used textual conventions for RTM.
This version add route frr status for state iproute.' ;
  }

  revision 2014-07-09 {
    description 'This Netconf module provides commonly used textual conventions for RTM.
This version add state for statistics of fib.' ;
  }

  revision 2014-05-12 {
    description 'This Netconf module provides commonly used textual conventions for RTM.
This version add state for information of ipv6 route.' ;
  }

  revision 2014-04-30 {
    description 'This Netconf module provides commonly used textual conventions for RTM.
This version change mim action of ldsh-hash-fields,mpls-ldsh-hash-fields and ldsh-hash-algorithm.' ;
  }

  revision 2014-04-11 {
    description 'This Netconf module provides commonly used textual conventions for RTM.
This version add state of route statistic.' ;
  }

  revision 2014-03-27 {
    description 'This Netconf module provides commonly used textual conventions for RTM.
This version add configuration about mpls ldsh hash configuration,hash scramble and bandwidth refresh.' ;
  }

  revision 2014-02-20 {
    description 'This Netconf module provides commonly used textual conventions for RTM.
This version deal spelling mistake of owner-type bgp-label and vpn-label.' ;
  }

  revision 2014-02-11 {
    description 'This Netconf module provides commonly used textual conventions for RTM.
This version deal spelling mistake of owner-type static-vrf-global-nh.' ;
  }

  revision 2013-12-10 {
    description 'This Netconf module provides commonly used textual conventions for RTM.
This version select the leaf route-nexthop and route-ifname as key of ip-route.' ;
  }

  revision 2013-10-10 {
    description 'This Netconf module provides commonly used textual conventions for RTM.
This version add information about route for state, and add configuration about ldsh.' ;
  }

  revision 2013-08-05 {
    description 'This Netconf module provides commonly used textual conventions for RTM.
This version changes the query condition.Adding objtype to identify the frr in global routing table or vpn routing table.' ;
  }

  revision 2013-07-30 {
    description 'This Netconf module provides commonly used textual conventions for RTM.
This version changes the enumeration of forward-status.' ;
  }

  revision 2013-07-18 {
    description 'This Netconf module provides commonly used textual conventions for RTM.
This version changes the module name form zxr10-rtm to zxr10-routing-table-management.' ;
  }

  revision 2013-06-13 {
    description 'This Netconf module provides commonly used textual conventions for RTM.
It is initial version.' ;
  }

  feature changeRouteInfo {
    description 'This function is for the information of changed routes.' ;
  }

  feature ldsh-scramble {
    description 'For load sharing scramble.' ;
    ncd:revise-date 2023-04-07 ;
  }

  feature hash-port-attribute {
    description 'Set incoming port number as attribute.' ;
    ncd:revise-date 2024-01-30 ;
  }

  feature hash-port-factor {
    description 'Set incoming port number as hash factor.' ;
    ncd:revise-date 2024-01-30 ;
  }

  feature ldsh-wtr-second {
    description 'Set load sharing WTR in second.' ;
    ncd:revise-date 2024-04-07 ;
  }

  feature ldsh-network-wtr {
    description 'Set load sharing WTR in second.' ;
    ncd:revise-date 2024-04-07 ;
  }

  feature hash-key-flowlabel {
    description 'For load sharing hash-key flowlabel.' ;
    ncd:revise-date 2025-06-08 ;
  }

  typedef owner-type {
    type enumeration {
      enum init {
        value 0 ;
        description 'This owner should not appear.' ;
      }

      enum static {
        value 1 ;
        description 'Route owner is static.' ;
      }

      enum direct {
        value 2 ;
        description 'Route owner is direct.' ;
      }

      enum broadcast {
        value 3 ;
        description 'Route owner is broadcast.' ;
      }

      enum multicast {
        value 4 ;
        description 'Route owner is multicast.' ;
      }

      enum martian {
        value 5 ;
        description 'Route owner is martian.' ;
      }

      enum address {
        value 6 ;
        description 'Route owner is address.' ;
      }

      enum ospf {
        value 7 ;
        description 'Route owner is ospf.' ;
      }

      enum bgp {
        value 8 ;
        description 'Route owner is bgp.' ;
      }

      enum bgp-label {
        value 9 ;
        description 'Route owner is bgp-label.' ;
      }

      enum rip {
        value 10 ;
        description 'Route owner is rip.' ;
      }

      enum isis-l1 {
        value 11 ;
        description 'Route owner is isis-l1.' ;
      }

      enum isis-l2 {
        value 12 ;
        description 'Route owner is isis-l2.' ;
      }

      enum icmp {
        value 13 ;
        description 'Route owner is icmp.' ;
      }

      enum snmp {
        value 14 ;
        description 'Route owner is snmp.' ;
      }

      enum nat {
        value 15 ;
        description 'Route owner is nat.' ;
      }

      enum natpt {
        value 16 ;
        description 'Route owner is natpt.' ;
      }

      enum vrrp {
        value 17 ;
        description 'Route owner is vrrp.' ;
      }

      enum ppp {
        value 18 ;
        description 'Route owner is ppp.' ;
      }

      enum asbr-vpn {
        value 19 ;
        description 'Route owner is asbr-vpn.' ;
      }

      enum rsvp-te {
        value 20 ;
        description 'Route owner is rsvp-te.' ;
      }

      enum user-ipaddress {
        value 21 ;
        description 'Route owner is user-ipaddress.' ;
      }

      enum user-network {
        value 22 ;
        description 'Route owner is user-network.' ;
      }

      enum static-vrf-global-nh {
        value 23 ;
        description 'Route owner is static-vrf-global-nh.' ;
      }

      enum IPSec {
        value 24 ;
        description 'Route owner is IPSec.' ;
      }

      enum vpn-label {
        value 25 ;
        description 'Route owner is vpn-label.' ;
      }

      enum psbusi-address {
        value 26 ;
        description 'Route owner is psbusi-address.' ;
      }

      enum psuser-address {
        value 27 ;
        description 'Route owner is psuser-address.' ;
      }

      enum ldp-area {
        value 28 ;
        description 'Route owner is ldp-area.' ;
      }

      enum user-special {
        value 29 ;
        description 'Route owner is user-special.' ;
      }

      enum dhcp-default {
        value 30 ;
        description 'Route owner is dhcp-default.' ;
      }

      enum dhcp-static {
        value 31 ;
        description 'Route owner is dhcp-static.' ;
      }

      enum slnat64 {
        value 32 ;
        description 'Route owner is slnat64.' ;
      }

      enum ves {
        value 33 ;
        description 'Route owner is ves.' ;
      }

      enum bras-pool {
        value 34 ;
        description 'Route owner is bras-pool.' ;
      }

      enum hagp {
        value 35 ;
        description 'Route owner is hybrid-access-gateway-protocol.' ;
      }

      enum nat-mask {
        value 36 ;
        description 'Route owner is nat-mask.' ;
      }

      enum dynamic-leased-line {
        value 37 ;
        description 'Route owner is dynamic-leased-line' ;
      }

      enum bgp-evpn {
        value 38 ;
        description 'Route owner is bgp-evpn.' ;
      }

      enum bgp-fs {
        value 39 ;
        description 'Route owner is bgp-flowspec.' ;
      }

    }

    description 'The owner type of nexthop.' ;
  }

  typedef forward-status {
    type enumeration {
      enum master {
        value 0 ;
        description 'The master nexthop of this frr is active.' ;
      }

      enum slave {
        value 1 ;
        description 'The slave nexthop of this frr is active.' ;
      }

      enum no-forwarding {
        value 2 ;
        description 'There is no active nexthop for this frr.' ;
      }

      enum wtr {
        value 3 ;
        description 'This frr is waiting for cutback.' ;
      }

    }

    description 'The forwarding status of frr.' ;
  }

  typedef select-module {
    type enumeration {
      enum global {
        value 1 ;
        description 'The frr in global routing table.' ;
      }

      enum vpn {
        value 2 ;
        description 'The frr in vpn routing table.' ;
      }

      enum global-vpn {
        value 3 ;
        description 'The frr in global routing table or vpn routing table.' ;
      }

      enum dynamic-vpnv4 {
        value 4 ;
        description 'The frr in dynamic-vpnv4 routing table.' ;
      }

      enum dynamic-vpnv6 {
        value 5 ;
        description 'The frr in dynamic-vpnv6 routing table.' ;
      }

      enum dynamic-evpn {
        value 6 ;
        description 'The frr in dynamic-evpn routing table.' ;
      }

    }

    description 'The select module of frr.' ;
  }

  typedef ipv6-owner-type {
    type enumeration {
      enum init {
        value 0 ;
        description 'Route owner is init.' ;
      }

      enum kernel {
        value 1 ;
        description 'Route owner is kernel.' ;
      }

      enum direct {
        value 2 ;
        description 'Route owner is connect.' ;
      }

      enum static {
        value 3 ;
        description 'Route owner is static.' ;
      }

      enum rip {
        value 4 ;
        description 'Route owner is rip.' ;
      }

      enum ripng {
        value 5 ;
        description 'Route owner is ripng.' ;
      }

      enum ospfv2 {
        value 6 ;
        description 'Route owner is ospfv2.' ;
      }

      enum ospfv3 {
        value 7 ;
        description 'Route owner is ospfv3.' ;
      }

      enum bgp {
        value 8 ;
        description 'Route owner is bgp.' ;
      }

      enum isis_l1 {
        value 9 ;
        description 'Route owner is isis_l1.' ;
      }

      enum isis_l2 {
        value 10 ;
        description 'Route owner is isis_l2.' ;
      }

      enum icmp {
        value 11 ;
        description 'Route owner is icmp.' ;
      }

      enum multicast {
        value 12 ;
        description 'Route owner is multicast.' ;
      }

      enum user_ipaddr {
        value 13 ;
        description 'Route owner is user_ipaddr.' ;
      }

      enum vrrp {
        value 14 ;
        description 'Route owner is vrrp.' ;
      }

      enum ppp {
        value 15 ;
        description 'Route owner is ppp.' ;
      }

      enum nd {
        value 16 ;
        description 'Route owner is nd.' ;
      }

      enum address {
        value 17 ;
        description 'Route owner is address.' ;
      }

      enum dhcp {
        value 18 ;
        description 'Route owner is dhcp.' ;
      }

      enum sf_nat64 {
        value 19 ;
        description 'Route owner is sf_nat64.' ;
      }

      enum sl_nat64 {
        value 20 ;
        description 'Route owner is sl_nat64.' ;
      }

      enum aftr {
        value 21 ;
        description 'Route owner is aftr.' ;
      }

      enum bgp-label {
        value 22 ;
        description 'Route owner is bgp-label.' ;
      }

      enum psbusi-address {
        value 23 ;
        description 'Route owner is psbusi-address.' ;
      }

      enum psuser-address {
        value 24 ;
        description 'Route owner is psuser-address.' ;
      }

      enum ldp-area {
        value 25 ;
        description 'Route owner is ldp-area.' ;
      }

      enum user-network {
        value 26 ;
        description 'Route owner is user-network.' ;
      }

      enum user-special {
        value 27 ;
        description 'Route owner is user-special.' ;
      }

      enum bras-pool {
        value 28 ;
        description 'Route owner is bras-pool.' ;
      }

      enum srv6 {
        value 30 ;
        description 'Route owner is SRv6.' ;
      }

      enum dynamic-leased-line {
        value 31 ;
        description 'Route owner is dynamic-leased-line.' ;
      }

      enum bgp-evpn {
        value 32 ;
        description 'Route owner is bgp-evpn.' ;
      }

      enum npt_v6 {
        value 33 ;
        description 'Route owner is network-prefix-translation IPv6.' ;
      }

      enum mpra {
        value 34 ;
        description 'Multicast policy reserved address routes.' ;
      }

      enum ipv6_source {
        value 35 ;
      }

      enum bgp_fs {
        value 36 ;
        description 'Route owner is bgp-flowspec.' ;
      }

    }

  }

  typedef change-type {
    type enumeration {
      enum create {
        value 1 ;
      }

      enum update {
        value 2 ;
      }

      enum delete {
        value 3 ;
      }

    }

  }

  typedef slave-status {
    type enumeration {
      enum enable {
        value 0 ;
        description 'The slave nexthop is available.' ;
      }

      enum disable {
        value 1 ;
        description 'The slave nexthop is unavailable.' ;
      }

    }

  }

  typedef forward-type {
    type enumeration {
      enum init {
        value 0 ;
      }

      enum direct {
        value 1 ;
      }

    }

    description 'The forward type of nexthop.' ;
  }

  typedef hash-polynomial {
    type enumeration {
      enum polynomial1 {
        value 1 ;
        description 'Select hash polynomial1.' ;
      }

      enum polynomial2 {
        value 2 ;
        description 'Select hash polynomial2.' ;
      }

      enum polynomial3 {
        value 3 ;
        description 'Select hash polynomial3.' ;
      }

      enum polynomial4 {
        value 4 ;
        description 'Select hash polynomial4.' ;
      }

      enum polynomial5 {
        value 5 ;
        description 'Select hash polynomial5.' ;
      }

      enum polynomial6 {
        value 6 ;
        description 'Select hash polynomial6.' ;
      }

    }

    description 'Selection of load-sharing hash polynomial.' ;
  }

  typedef ecmp-or-ucmp {
    type enumeration {
      enum ucmp {
        value 0 ;
        description 'Select unequal cost multiple path mode.' ;
      }

      enum ecmp {
        description 'Select equal cost multiple path mode.' ;
        value 1 ;
      }

    }

    description 'Selection of load-sharing-mode.' ;
  }

  container state {
    config false ;
    description 'This module show the forwarding information of routing table management.' ;
    container rtm {
      description 'This module show information about routing table management(rtm).' ;
      container fib-statistics {
        description 'The statistic of fib resource.' ;
        leaf fib-used {
          description 'The statistic of used fib.' ;
          type uint32 ;

        }

        leaf fib-free {
          description 'The statistic of unused fib.' ;
          type uint32 ;

        }

      }

      container frr {
        description 'This module show the forwarding information of frr.' ;
        list ipfrr {
          description 'This module show the forwarding information of ip frr.
For the frr of global,need select objtype(1),route-dest,route-prefix.
For all frr of global,need select objtype(1).
For the frr of the vpn,need select objtype(2),route-vrfname,route-dest,route-prefix.
For all frr of the vpn,need select objtype(2),route-vrfname.
For all frr of global and all vpn,need select objtype(3).' ;
          key 'objtype route-vrfname route-dest route-prefix' ;
          leaf objtype {
            description 'The select module of ipfrr.' ;
            type select-module ;

          }

          leaf route-vrfname {
            description 'VRF name of the route.' ;
            type ncd:string-quesiton-mark {
              length 0..32 ;

            }

          }

          leaf route-dest {
            description 'The destination IP address of this route.' ;
            type ncd:ipv4-address ;

          }

          leaf route-prefix {
            description 'The mask of this route.' ;
            type ncd:ipv4-mask ;

          }

          leaf route-master-nexthop {
            description 'The nexthop of master route.' ;
            type string ;

            mandatory true ;
          }

          leaf route-master-ifname {
            description 'The local interface name through which the master next hop of this route should be reached.' ;
            type string {
              length 0..31 ;

            }

            mandatory true ;
          }

          leaf route-master-owner {
            description 'The protocol of master route.' ;
            type owner-type ;

            mandatory true ;
          }

          leaf route-master-label {
            description 'The out label of master route.' ;
            type uint32 {
              range 0..4294967295 ;

            }

            mandatory true ;
          }

          leaf route-master-priority {
            description 'The priority of master route.' ;
            type uint8 {
              range 0..255 ;

            }

            mandatory true ;
          }

          leaf route-master-metric {
            description 'The metric of master route.' ;
            type uint32 {
              range 0..4294967295 ;

            }

            mandatory true ;
          }

          leaf route-master-is-pe {
            description "Whether the next hop of master route is PE.

            Ture:It's pe.

            False:It's not pe." ;
            type boolean ;

            mandatory true ;
          }

          leaf route-slave-nexthop {
            description 'The nexthop of slave route.' ;
            type string ;

            mandatory true ;
          }

          leaf route-slave-ifname {
            description 'The local interface name through which the slave next hop of this route should be reached.' ;
            type string {
              length 0..31 ;

            }

            mandatory true ;
          }

          leaf route-slave-owner {
            description 'The protocol of slave route.' ;
            type owner-type ;

            mandatory true ;
          }

          leaf route-slave-label {
            description 'The out label of slave route.' ;
            type uint32 {
              range 0..4294967295 ;

            }

            mandatory true ;
          }

          leaf route-slave-priority {
            description 'The priority of slave route.' ;
            type uint8 {
              range 0..255 ;

            }

            mandatory true ;
          }

          leaf route-slave-metric {
            description 'The metric of slave route.' ;
            type uint32 {
              range 0..4294967295 ;

            }

            mandatory true ;
          }

          leaf route-slave-is-pe {
            description "Whether the next hop of slave route is PE.

            True:It's pe.

            False:It's not pe." ;
            type boolean ;

            mandatory true ;
          }

          leaf route-forwarding-status {
            description 'Forwarding status of frr.' ;
            type forward-status ;

            mandatory true ;
          }

          leaf route-slave-status {
            description 'The status of slave nexthop.' ;
            type slave-status ;

            ncd:revise-date 2019-11-29 ;
          }

          ncd:select "objtype route-vrfname route-dest route-prefix" ;
          ncd:select "objtype route-dest route-prefix" ;
          ncd:select "objtype route-vrfname" ;
          ncd:select objtype ;
        }

      }

      container route {
        description 'This module show the forwarding infor of route.' ;
        list iproute {
          description 'This module show the forwarding infor of ip route.
For all route of global,need select objtype(1).
For the special protocol route of global, need select object(1),route-owner.
For exact match the route of global,need select objtype(1),route-dest,route-prefix and route-match-type(true).
For best match the route of global,need select objtype(1),route-dest and route-prefix.
For all route of the vrf,need select objtype(2),route-vpnname.
For the special protocol route of the vrf, need select object(2),route-owner.
For exact match the route of the vrf,need select objtype(2),route-vpnname,route-dest,route-prefix and route-match-type(true).
For best match the route of the vrf,need select objtype(2),route-vpnname,route-dest and route-prefix.' ;
          key 'objtype route-vpnname route-owner route-dest route-prefix route-is-exact-match route-nexthop route-ifname' ;
          leaf objtype {
            description 'The select module of fib.' ;
            type select-module ;

          }

          leaf route-vpnname {
            description 'VRF name of the route.' ;
            type ncd:string-quesiton-mark {
              length 0..32 ;

            }

          }

          leaf route-owner {
            description 'The protocol of route.' ;
            type owner-type ;

          }

          leaf route-dest {
            description 'The destination IP address of this route.' ;
            type ncd:ipv4-address ;

          }

          leaf route-prefix {
            description 'The mask of this route.' ;
            type ncd:ipv4-mask ;

          }

          leaf route-is-exact-match {
            description 'The match type of route.True is exact match,false is best match.' ;
            type boolean ;

          }

          leaf route-nexthop {
            description 'The nexthop of route.' ;
            type string ;

          }

          leaf route-ifname {
            description 'The local interface name through which the next hop of this route should be reached.' ;
            type string {
              length 0..31 ;

            }

          }

          leaf route-priority {
            description 'The priority of route.' ;
            type uint8 {
              range 0..255 ;

            }

            mandatory true ;
          }

          leaf route-metric {
            description 'The metric of route.' ;
            type uint32 {
              range 0..4294967295 ;

            }

            mandatory true ;
          }

          leaf route-has-frr {
            description 'Route frr relation flag.' ;
            type boolean ;

            mandatory true ;
          }

          leaf route-is-valid {
            description 'route valid flag.' ;
            type boolean ;

            mandatory true ;
          }

          leaf route-is-backup {
            description 'Route is frr back path.' ;
            type empty ;

          }

          leaf route-gw {
            description 'The gateway of route.' ;
            type string ;

            ncd:revise-date 2020-05-05 ;
          }

          leaf route-forward-type {
            type forward-type ;

            ncd:revise-date 2021-12-24 ;
          }

          ncd:select objtype ;
          ncd:select "objtype route-owner" ;
          ncd:select "objtype route-dest route-prefix route-is-exact-match" ;
          ncd:select "objtype route-vpnname" ;
          ncd:select "objtype route-vpnname route-owner" ;
          ncd:select "objtype route-vpnname route-dest route-prefix route-is-exact-match" ;
          ncd:select "objtype route-vpnname route-dest route-prefix" ;
          ncd:select "objtype route-dest route-prefix" ;
        }

        list forward-info {
          description 'The forwarding information for IPv4 route.
For the best match route of global,need select objtype(1),route-dest.
For the exact match route of global,need select objtype(1),route-dest,route-mask.
For the best match route of the vpn,need select objtype(2),route-vrfname,route-dest.
For the best match route of the vpn,need select objtype(2),route-vrfname,route-dest,route-mask.' ;
          key 'objtype vpnname dest mask forward-index' ;
          leaf objtype {
            description 'The select module of the route.' ;
            type select-module ;

          }

          leaf vpnname {
            description 'The VPN name of the route.' ;
            type ncd:string-quesiton-mark {
              length 0..32 ;

            }

          }

          leaf dest {
            description 'The destination IP address of the route.' ;
            type ncd:ipv4-address ;

          }

          leaf mask {
            description 'The mask of the route.' ;
            type ncd:ipv4-mask ;

          }

          leaf forward-index {
            description 'The forwarding index of the route.' ;
            type uint32 {
              range 0..4294967295 ;

            }

          }

          leaf ifname {
            description 'The local interface name through which the next hop of this route should be reached.' ;
            type string {
              length 0..31 ;

            }

          }

          leaf nexthop {
            description 'The forwarding nexthop of the route.' ;
            type string ;

          }

          leaf label {
            description 'The forwarding label stack of the route' ;
            type string {
              length 0..31 ;

            }

          }

          ncd:revise-date 2017-03-09 ;
          ncd:select "objtype vpnname dest mask" ;
          ncd:select "objtype vpnname dest" ;
          ncd:select "objtype dest mask" ;
          ncd:select "objtype dest" ;
        }

      }

      container route-statistics {
