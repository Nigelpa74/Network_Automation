      container route6-forward {
        description 'Show the forwarding information of IPv6 routes.' ;
        list iproute6 {
          description 'This module show the forwarding infor of ipv6 route.' ;
          key 'objtype vpnname owner dest mask route6-is-exact-match nexthop ifname' ;
          leaf objtype {
            description 'The select module of fib.' ;
            type select-module ;

          }

          leaf vpnname {
            description 'VRF name of the route.' ;
            type ncd:string-quesiton-mark ;

          }

          leaf owner {
            description 'The protocol of route.' ;
            type ipv6-owner-type ;

          }

          leaf dest {
            description 'The destination address of this route.' ;
            type ncd:ipv6-address ;

          }

          leaf mask {
            description 'The mask length of this route.' ;
            type uint32 {
              range 0..128 ;

            }

          }

          leaf route6-is-exact-match {
            description 'Whether exact match route.' ;
            type boolean ;

          }

          leaf nexthop {
            description 'The nexthop of route.' ;
            type ncd:ipv6-address ;

          }

          leaf ifname {
            description 'The local interface name through which the next hop of this route should be reached.' ;
            type string {
              length 0..32 ;

            }

          }

          leaf priority {
            description 'The priority of route.' ;
            type uint32 ;

          }

          leaf metric {
            description 'The metric of route.' ;
            type uint32 ;

          }

          leaf route6-has-frr {
            description 'Route frr relation flag.' ;
            type boolean ;

          }

          leaf route6-is-valid {
            description 'route valid flag.' ;
            type boolean ;

          }

          leaf route6-is-backup {
            description 'Route is frr back path.' ;
            type empty ;

          }

          leaf gw {
            description 'The gateway of route.' ;
            type string ;

            ncd:revise-date 2020-05-05 ;
          }

          leaf forward-type {
            type forward-type ;

            ncd:revise-date 2021-12-24 ;
          }

          ncd:select objtype ;
          ncd:select "objtype vpnname" ;
          ncd:select "objtype owner" ;
          ncd:select "objtype vpnname owner" ;
          ncd:select "objtype dest mask route6-is-exact-match" ;
          ncd:select "objtype vpnname dest mask route6-is-exact-match" ;
          ncd:select "objtype vpnname dest mask" ;
          ncd:select "objtype dest mask" ;
        }

        ncd:revise-date 2020-03-23 ;
      }

      container frr6-forward {
        description 'Show the forwarding information of IPv6 FRR.' ;
        list ipfrr6 {
          description 'Show the forwarding information of IPv6 FRR.
For the frr of global,need select objtype(1),route6-dest,route6-prefixlen.
For the frr of the vpn,need select objtype(2),route6-vpnname,route6-dest,route6-prefixlen.
For all frr of global,need select objtype(1).
For all frr of the vpn,need select objtype(2),route6-vpnname.
For all frr of global and all vpn,need select objtype(3).' ;
          key 'objtype vpnname dest mask' ;
          leaf objtype {
            description 'The select module of ipv6 frr.' ;
            type select-module ;

          }

          leaf vpnname {
            description 'VRF name of the route.' ;
            type ncd:string-quesiton-mark ;

          }

          leaf dest {
            description 'The destination IP address of this route.' ;
            type ncd:ipv6-address ;

          }

          leaf mask {
            description 'The mask length of this route.' ;
            type uint32 {
              range 0..128 ;

            }

          }

          leaf master-nexthop {
            description 'The nexthop of master route.' ;
            type ncd:ipv6-address ;

          }

          leaf master-ifname {
            description 'The local interface name through which the master next hop of this route should be reached.' ;
            type string {
              length 0..32 ;

            }

          }

          leaf master-priority {
            description 'The priority of master route.' ;
            type uint32 ;

          }

          leaf master-metric {
            description 'The metric of master route.' ;
            type uint32 ;

          }

          leaf master-owner {
            description 'The protocol of master route.' ;
            type ipv6-owner-type ;

          }

          leaf master-label {
            description 'The out label of master route.' ;
            type uint32 ;

          }

          leaf master-is-pe {
            description 'Whether the next hop of master route is PE.' ;
            type boolean ;

          }

          leaf slave-nexthop {
            description 'The nexthop of slave route.' ;
            type ncd:ipv6-address ;

          }

          leaf slave-ifname {
            description 'The local interface name through which the slave next hop of this route should be reached.' ;
            type string {
              length 0..32 ;

            }

          }

          leaf slave-priority {
            description 'The priority of slave route.' ;
            type uint32 ;

          }

          leaf slave-metric {
            description 'The metric of slave route.' ;
            type uint32 ;

          }

          leaf slave-owner {
            description 'The protocol of slave route.' ;
            type ipv6-owner-type ;

          }

          leaf slave-label {
            description 'The out label of slave route.' ;
            type uint32 ;

          }

          leaf slave-is-pe {
            description 'Whether the next hop of slave route is PE.' ;
            type boolean ;

          }

          leaf frr-status {
            description 'Forwarding status of frr.' ;
            type forward-status ;

          }

          leaf slave-status {
            description 'The status of slave nexthop.' ;
            type slave-status ;

          }

          ncd:select objtype ;
          ncd:select "objtype vpnname" ;
          ncd:select "objtype dest mask" ;
          ncd:select "objtype vpnname dest mask" ;
        }

        ncd:revise-date 2020-03-23 ;
      }

