          leaf route6-slave-label {
            description 'The out label of slave route.' ;
            type uint32 ;

          }

          leaf route6-slave-is-pe {
            description 'Whether the next hop of slave route is PE.' ;
            type boolean ;

          }

          leaf route6-frr-status {
            description 'Forwarding status of frr.' ;
            type forward-status ;

          }

          leaf route6-slave-status {
            description 'The status of slave nexthop.' ;
            type slave-status ;

            ncd:revise-date 2019-11-29 ;
          }

          ncd:select objtype ;
          ncd:select "objtype route6-vpnname" ;
          ncd:select "objtype route6-dest route6-prefixlen" ;
          ncd:select "objtype route6-vpnname route6-dest route6-prefixlen" ;
        }

      }

      container route-summary-alls {
        status obsolete {
          ncd:revise-date 2021-05-11 ;
        }

        leaf capacity {
          description 'The performance parameters of IPv6 route' ;
          type uint32 ;

        }

        leaf used-route-count {
          description 'The used count of IPv6 route' ;
          type uint32 ;

          default 0 ;
        }

        list route-summary-all {
          description 'The count of IPv6 route for global and all VRF,but do not support the query conditions' ;
          key 'objtype route-vpnname' ;
          leaf objtype {
            description 'The select module of IPv6 route statistic for global and all VRF.' ;
            type select-module ;

          }

          leaf route-vpnname {
            description 'VRF name of the route.' ;
            type string {
              length 0..32 ;

            }

          }

          leaf route-count {
            description 'The count of IPv6 route for global or VRF' ;
            type uint32 ;

            default 0 ;
          }

        }

        ncd:revise-date 2016-10-26 ;
      }

      container route6-all-routes {
        description 'This modules show all vrf by specify route6 addr' ;
        list all-routes {
          key 'objtype vpnname dest prefixlen forward-index rd' ;
          leaf objtype {
            description 'The select module of fib.' ;
            type select-module ;

          }

          leaf vpnname {
            description 'VRF name of the route.' ;
            type ncd:string-quesiton-mark {
              length 0..32 ;

            }

          }

          leaf dest {
            description 'The destination address of this route.' ;
            type ncd:ipv6-address ;

          }

          leaf prefixlen {
            description 'The mask length of this route.' ;
            type uint32 ;

          }

          leaf forward-index {
            description 'The forward-index used by internal breakpoints,user does not care about this field' ;
            type uint32 ;

          }

          leaf rd {
            description 'RD of the Dynamic vrf route.' ;
            type ncd:string-quesiton-mark ;

          }

          leaf owner {
            description 'The protocol of route.' ;
            type ipv6-owner-type ;

          }

          leaf ifname {
            description 'The local interface name through which the next hop of this route should be reached.' ;
            type string ;

          }

          leaf priority {
            description 'The priority of route.' ;
            type uint32 ;

          }

          leaf metric {
            description 'The metric of route.' ;
            type uint32 ;

          }

          leaf nexthop {
            description 'The nexthop of route.' ;
            type ncd:ipv6-address ;

          }

          ncd:select dest ;
        }

        ncd:revise-date 2022-11-07 ;
      }

    }

  }

  container configuration {
    description 'This module config ldsh precision configuration.' ;
    container rtm {
      description 'This module config information about routing table management(rtm).' ;
      container ldsh {
        description 'This module config information aboutldsh.' ;
        container bandwidth {
          description 'Specifies ldsh response outer ldsh bandwidth changes.' ;
          leaf unaware {
            description 'Specifies ldsh response outer ldsh bandwidth changes.' ;
            type empty ;

          }

        }

        container wtr {
          description 'Config WTR time of ECMP. The range is 1 to 720 seconds.' ;
          presence "ldsh wtr time" ;
          leaf time {
            description 'The minute part of WTR.' ;
            type uint8 {
              range 0..12 {
                description 'Ecmp wtr time is 0 to 12 min.' ;
              }

            }

            units min ;
            mandatory true ;
          }

          leaf wtr-second {
            type uint32 {
              range 0..59 ;

            }

            description 'The second part of WTR.' ;
            units sec ;
            if-feature ldsh-wtr-second ;

            ncd:revise-date 2024-04-07 ;
          }

        }

        container hash {
          description 'Config information about ldsh hash configuration.' ;
          container ldsh-hash-scramble {
            description 'This module set hash scramble.' ;
            leaf scramble-value {
              description 'This module set hash scramble.' ;
              type uint32 {
                range 1..65535 ;

              }

              default 1 ;
            }

            if-feature ldsh-scramble ;

          }

          container ldsh-hash-fields {
            description 'This module config the hash configuration of ldsh.' ;
            list ldsh-hash-fields {
              description 'This module config the hash configuration of ldsh.
When config ipv4 enable,ipv6 need be configed false.
When config ipv6 enable,ipv4 need be configed false.' ;
              key 'ipv4 ipv6 board-name' ;
              leaf ipv4 {
                description 'Config ipv4 address family.' ;
                type boolean ;

              }

              leaf ipv6 {
                description 'Config ipv6 address family.' ;
                type boolean ;

              }

              leaf board-name {
                description 'Config board name,and "global" meaning config all boards.' ;
                type string {
                  length 1..33 ;

                }

              }

              choice hash-element {
                description 'Config information participating hash operation.' ;
                mandatory true ;
                case l3 {
                  description 'Config l3 information of upstream flow participating hash operation.' ;
                  leaf l3 {
                    description 'Config l3 information of upstream flow participating hash operation.' ;
                    type empty ;

                    mandatory true ;
                    ncd:revise-date 2022-01-26 ;
                  }

                  leaf ignore-protocol {
                    description 'Enable or disable' ;
                    type empty ;

                    ncd:revise-date 2022-01-26 ;
                  }

                }

                case l4 {
                  description 'Config l4 information of upstream flow participating hash operation.' ;
                  leaf l4 {
                    description 'Config l4 information of upstream flow participating hash operation.' ;
                    type empty ;

                    mandatory true ;
                  }

                }

                case l3src {
                  description 'Config l3 original information of upstream flow participating hash operation.' ;
                  leaf l3src {
                    description 'Config l3 original information of upstream flow participating hash operation.' ;
                    type empty ;

                    mandatory true ;
                  }

                }

                case gtp {
                  description 'Config gtp information of upstream flow participating hash operation.' ;
                  container gtp-elements {
                    leaf gtp {
                      description 'Config gtp information of upstream flow participating hash operation.' ;
                      type empty ;

                      mandatory true ;
                    }

                    leaf te-id {
                      description 'Enable or disable the ability to use the TE tunnel ID in HASH field.' ;
                      type empty ;

                    }

                  }

                  ncd:revise-date 2021-11-16 ;
                }

                case l2-l3 {
                  description 'Config l2-l3 information of upstream flow participating hash operation.' ;
                  leaf l2-l3 {
                    description 'Config l2-l3 information of upstream flow participating hash operation.' ;
                    type empty ;

                    mandatory true ;
                  }

                  ncd:revise-date 2022-04-26 ;
                }

                if-feature hash-port-attribute {
                  ncd:revise-date 2024-01-30 ;
                }

              }

              leaf incoming-port-num {
                description 'Enable or disable the ability to use the incoming port number in HASH field.' ;
                type enumeration {
                  enum disable {
                    value 0 ;
                  }

                  enum enable {
                    value 1 ;
                  }

                }

                if-feature hash-port-attribute {
                  ncd:revise-date 2024-01-30 ;
                }

                ncd:revise-date 2020-02-13 ;
              }

              choice hash-element-port {
                case l3-factor {
                  leaf l3-factor {
                    type empty ;

                    description 'Config l3 information of upstream flow participating hash operation.' ;
                  }

                  description 'Config l3 information of upstream flow participating hash operation.' ;
                }

                case l4-factor {
                  leaf l4-factor {
                    type empty ;

                    description 'Config l4 information of upstream flow participating hash operation.' ;
                  }

                  description 'Config l4 information of upstream flow participating hash operation.' ;
                }

                case l3src-factor {
                  leaf l3src-factor {
                    type empty ;

                    description 'Config l3 original information of upstream flow participating hash operation.' ;
                  }

                  description 'Config l3 original information of upstream flow participating hash operation.' ;
                }

                case l2-l3-factor {
                  leaf l2-l3-factor {
                    type empty ;

                    description 'Config l2-l3 information of upstream flow participating hash operation.' ;
                  }

                  description 'Config l2-l3 information of upstream flow participating hash operation.' ;
                }

                case incoming-port-num-factor {
                  leaf incoming-port-num-factor {
                    type empty ;

                    description 'Enable or disable the ability to use the incoming port number in HASH field.' ;
                  }

                  description 'Config incoming-port-num information of upstream flow participating hash operation.' ;
                }

                if-feature hash-port-factor ;

                description 'Config information participating hash operation.' ;
                case n-tuple {
                  container n-tuple {
                    leaf src-ip {
                      type empty ;

                      description 'The IP address of the sending host or device.' ;
                    }

                    leaf dst-ip {
                      type empty ;

                      description 'The IP address of the receiving host or device.' ;
                    }

                    leaf protocol {
                      type empty ;

                      description 'The transport layer protocol type.' ;
                    }

                    leaf src-port {
                      type empty ;

                      description 'The port number used by the application sending the packets.' ;
                    }

                    leaf dst-port {
                      type empty ;

                      description ' The port number used by the application receiving the packets.' ;
                    }

                    description 'Configure multiple factors of the upstream flow participating in the hash operation.' ;
                  }

                  if-feature hash-port-factor ;

                  description 'Configure multiple factors of the upstream flow participating in the hash operation.' ;
                  ncd:revise-date 2024-06-04 ;
                }

                ncd:revise-date 2024-01-30 ;
              }

            }

          }

          container ldsh-hash-key-board {
            description 'This module config the hash precise configuration of ldsh for the board.' ;
            list ldsh-hash-key-board {
              description 'This module config the hash precise configuration of ldsh for the board.' ;
              key 'ipv6 board-name' ;
              leaf ipv6 {
                description 'Config ipv6 address family.
It must be selected temporarily.' ;
                type boolean ;

              }

              leaf board-name {
                description 'Config board name.' ;
                type string {
                  length 1..33 {
                    description "The board name can't be null." ;
                  }

                }

              }

              leaf lsb {
                description 'Config low byte of ip address participating hash operation.' ;
                type boolean ;

                mandatory true ;
              }

              leaf msb {
                description 'Config high byte of ip address participating hash operation.' ;
                type boolean ;

                mandatory true ;
              }

              leaf ttl-ignore {
                type enumeration {
                  enum disable {
                    value 2 ;
                  }

                  enum enable {
                    value 1 ;
                  }

                }

                description 'Config TTL(Time To Live) participating hash operation.' ;
                ncd:revise-date 2025-06-08 ;
              }

              leaf tos-ignore {
                type enumeration {
                  enum disable {
                    value 2 ;
                  }

                  enum enable {
                    value 1 ;
                  }

                }

                description 'Config TOS(Type Of Service) participating hash operation.' ;
                ncd:revise-date 2025-06-08 ;
              }

              leaf flowlabel {
                type enumeration {
                  enum disable {
                    value 2 ;
                  }

                  enum enable {
                    value 1 ;
                  }

                  enum no-config {
                    value 0 ;
                  }

                }

                description 'Config flow-label participating hash operation.The IPv4 protocol does not support flowlabel, so it must be of the "no-config" enumeration type.' ;
                if-feature hash-key-flowlabel ;

                ncd:revise-date 2025-06-08 ;
              }

            }

          }

          container ldsh-hash-algorithm {
            description 'Config hash operation algorithm.' ;
            list ldsh-hash-algorithm {
              description 'Config hash operation algorithm.' ;
              key board-name ;
              leaf board-name {
                description 'Config board name,and "global" meaning config all boards.' ;
                type string {
                  length 1..33 ;

                }

              }

              choice algorithm {
                description 'Choice crc configuration.' ;
                mandatory true ;
                case crc16 {
                  description 'Config crc16 algorithm.' ;
                  leaf crc16 {
                    description 'Config crc16 algorithm.' ;
                    type empty ;

                    mandatory true ;
                  }

                }

                case crc32 {
                  description 'Config crc32 algorithm.' ;
                  leaf crc32 {
                    description 'Config crc32 algorithm.' ;
                    type empty ;

                    mandatory true ;
                  }

                }

                case hash {
                  leaf hash {
                    type empty ;

                    description 'Config hash algorithm.' ;
                    mandatory true ;
                  }

                  description 'Config hash algorithm.' ;
                  ncd:revise-date 2024-04-02 ;
                }

              }

            }

          }

          container ldsh-hash-key-global {
            description 'This module config the hash precise configuration of ldsh for all boards.' ;
            list ldsh-hash-key-global {
              description 'This module config the hash precise configuration of ldsh for all boards.' ;
              key ipv6 ;
              leaf ipv6 {
                description 'Config ipv6 address family.
It must be selected temporarily.' ;
                type boolean ;

              }

              leaf lsb {
                description 'Config low byte of ip address participating hash operation.' ;
                type boolean ;

                mandatory true ;
              }

              leaf msb {
                description 'Config high byte of ip address participating hash operation.' ;
                type boolean ;

                mandatory true ;
              }

              leaf ttl-ignore {
                type enumeration {
                  enum disable {
                    value 2 ;
                  }

                  enum enable {
                    value 1 ;
                  }

                }

                description 'Config TTL(Time To Live) participating hash operation.' ;
                ncd:revise-date 2025-06-08 ;
              }

              leaf tos-ignore {
                type enumeration {
                  enum disable {
                    value 2 ;
                  }

                  enum enable {
                    value 1 ;
                  }

                }

                description 'Config TOS(Type Of Service) participating hash operation.' ;
                ncd:revise-date 2025-06-08 ;
              }

              leaf flowlabel {
                type enumeration {
                  enum disable {
                    value 2 ;
                  }

                  enum enable {
                    value 1 ;
                  }

                  enum no-config {
                    value 0 ;
                  }

                }

                description 'Config flow-label participating hash operation.The IPv4 protocol does not support flowlabel, so it must be of the "no-config" enumeration type.' ;
                if-feature hash-key-flowlabel ;

                ncd:revise-date 2025-06-08 ;
              }

            }

          }

          container mpls-ldsh-hash-fields {
            description 'This module config the hash configuration of mpls ldsh.' ;
            list mpls-ldsh-hash-field {
              description 'This module config the hash configuration of mpls ldsh.' ;
              key board-name ;
              leaf board-name {
                description 'Config board name,and "global" meaning config all boards.' ;
                type string {
                  length 1..33 ;

                }

              }

              choice hash-element {
                description 'Config information participating hash operation.' ;
                mandatory true ;
                case ip-l3 {
                  description 'Config the ip ternary group information as hash factor.' ;
                  leaf ip-l3 {
                    description 'Config the ip ternary group information as hash factor.' ;
                    type empty ;

                    mandatory true ;
                  }

                }

                case ip-l4 {
                  description 'Config the ip quintuple group information as hash factor.' ;
                  leaf ip-l4 {
                    description 'Config the ip quintuple group information as hash factor.' ;
                    type empty ;

                    mandatory true ;
                  }

                }

                case label {
                  description 'Config label information as hash factor.' ;
                  leaf label {
                    description 'Config label information as hash factor.' ;
                    type empty ;

                    mandatory true ;
                  }

                }

              }

              leaf incoming-port-num {
                description 'Enable or disable the ability to use the incoming port number in MPLS HASH field.' ;
                type enumeration {
                  enum disable {
                    value 0 ;
                  }

                  enum enable {
                    value 1 ;
                  }

                }

                ncd:revise-date 2020-02-13 ;
              }

            }

            list mpls-l2-ldsh-hash-field {
              description 'This module is the hash configuration of mpls l2 ldsh.' ;
              key board-name ;
              leaf board-name {
                description 'Config board name,and "global" meaning config all boards.' ;
                type string {
                  length 1..32 {
                    description 'The length of board-name.' ;
                  }

                }

              }

              leaf incoming-port {
                description 'The hash incoming-port enable or not.' ;
                type enumeration {
                  enum disable {
                    value 0 ;
                    description 'The hash incoming-port is disable.' ;
                  }

                  enum enable {
                    value 1 ;
                    description 'The hash incoming-port is enable.' ;
                  }

                }

                default disable ;
                ncd:revise-date 2020-02-13 ;
              }

              leaf ignore-cword {
                description 'The hash ignore-cword enable or not.' ;
                type enumeration {
                  enum disable {
                    value 0 ;
                    description 'The hash does not ignore cword.' ;
                  }

                  enum enable {
                    value 1 ;
                    description 'The hash ignore cword.' ;
                  }

                }

                default disable ;
                ncd:revise-date 2021-06-22 ;
              }

              ncd:revise-date 2017-01-13 ;
            }

          }

          container ldsh-hash-polynomials {
            description 'This module config the hash polynomial selection of load-sharing.' ;
            list ldsh-hash-polynomial {
              description 'This module config the hash polynomial selection of load-sharing.' ;
              key board-name ;
              leaf board-name {
                description 'Config board name,default is "global".' ;
                type ncd:string-all ;

              }

              leaf hash-polynomial {
                description 'The result of load-sharing hash polynomial selection.' ;
                type hash-polynomial ;

                mandatory true ;
              }

            }

            ncd:revise-date 2022-08-15 ;
          }

          container ldsh-hash-key-interface {
            description 'This module config the hash precise configuration of ldsh for the interface.' ;
            container ipv4-hash-keys {
              description 'This module config the  ipv4 address family hash precise configuration of ldsh.' ;
              list ipv4-hash-key {
                description 'This module config the  ipv4 address family hash precise configuration of ldsh.' ;
                key interface ;
                leaf interface {
                  type ncd:ifname ;

                  description 'Config interface name.' ;
                }

                leaf lsb {
                  type boolean ;

                  description 'Config low byte of ip address participating hash operation.' ;
                }

                leaf msb {
                  type boolean ;

                  description 'Config high byte of ip address participating hash operation.' ;
                }

                leaf ttl-ignore {
                  type enumeration {
                    enum disable {
                      value 2 ;
                    }

                    enum enable {
                      value 1 ;
                    }

                  }

                  description 'Config TTL(Time To Live) participating hash operation.' ;
                }

                leaf tos-ignore {
                  type enumeration {
                    enum disable {
                      value 2 ;
                    }

                    enum enable {
                      value 1 ;
                    }

                  }

                  description 'Config TOS(Type Of Service) participating hash operation.' ;
                }

              }

            }

            container ipv6-hash-keys {
              description 'This module config the  ipv6 address family hash precise configuration of ldsh.' ;
              list ipv6-hash-key {
                leaf interface {
                  type ncd:ifname ;

                  description 'Config interface name.' ;
                }

                leaf lsb {
                  type boolean ;

                  description 'Config low byte of ip address participating hash operation.' ;
                }

                leaf msb {
                  type boolean ;

                  description 'Config high byte of ip address participating hash operation.' ;
                }

                leaf ttl-ignore {
                  type enumeration {
                    enum disable {
                      value 2 ;
                    }

                    enum enable {
                      value 1 ;
                    }

                  }

                  description 'Config TTL(Time To Live) participating hash operation.' ;
                }

                leaf tos-ignore {
                  type enumeration {
                    enum disable {
                      value 2 ;
                    }

                    enum enable {
                      value 1 ;
                    }

                  }

                  description 'Config TOS(Type Of Service) participating hash operation.' ;
                }

                leaf flowlabel {
                  type enumeration {
                    enum disable {
                      value 2 ;
                    }

                    enum enable {
                      value 1 ;
                    }

                    enum no-config {
                      value 0 ;
                    }

                  }

                  description 'Config flow-label participating hash operation.' ;
                  if-feature hash-key-flowlabel {
                    ncd:revise-date 2025-06-08 ;
                  }

                }

                description 'This module config the  ipv6 address family hash precise configuration of ldsh.' ;
                key interface ;
              }

            }

            ncd:revise-date 2025-06-08 ;
          }

        }

        container network-wtr {
          leaf public-wtr {
            type uint32 {
              range 1..720 ;

            }

            description 'Config WTR time of ECMP in public network.' ;
          }

          leaf private-wtr {
            type uint32 {
              range 1..720 ;

            }

            description 'Config WTR time of ECMP in private network.' ;
          }

          if-feature ldsh-network-wtr ;

          ncd:revise-date 2024-04-07 ;
        }

        container load-sharing-mode {
          description 'Config information about load-sharing mode, equal cost multiple path or unequal cost multiple path.' ;
          leaf mode {
            type ecmp-or-ucmp ;

            description 'The result of load-sharing-mode selection.' ;
          }

          ncd:revise-date 2025-03-27 ;
        }

      }

    }

  }

  notification changeRouteInfo {
    description 'Notification of the change for IPv4 route.' ;
    if-feature changeRouteInfo ;

    list ipRoute {
      config false ;
      description 'The forwarding info list of changed IPv4 routes.' ;
      key 'vrfName addr mask' ;
      leaf vrfName {
        description 'Name of the VPN to which a prefix belongs.' ;
        type string {
          length 0..32 ;

        }

      }

      leaf addr {
        description 'Destination IP address.' ;
        type ncd:ipv4-address ;

      }

      leaf mask {
        description 'Mask of an IP address.' ;
        type ncd:ipv4-mask ;

      }

      leaf changeType {
        description 'The type of current change.' ;
        type uint8 {
          range 1..3 ;

        }

      }

      container forward-infos {
        list forward-info {
          description 'The forwarding information of the route.' ;
          key 'nexthop interface-name owner' ;
          config false ;
          leaf nexthop {
            type string {
              length 0..70 ;

            }

            description 'The forwarding nexthop of the route.' ;
          }

          leaf interface-name {
            type string {
              length 0..31 ;

            }

            description 'The local interface name through which the next hop of this route should be reached.' ;
          }

          leaf owner {
            type string {
              length 0..31 ;

            }

            description 'The protocol of route.' ;
          }

          leaf metric {
            type uint32 {
              range 0..4294967295 ;

            }

            description 'The metric of route.' ;
          }

          leaf routeChangeType {
            type uint8 {
              range 1..3 ;

            }

            description 'The type of current change.' ;
            ncd:revise-date 2024-07-06 ;
          }

        }

        description 'The forwarding information of the route.' ;
        ncd:revise-date 2024-01-16 ;
      }

    }

    ncd:revise-date 2019-01-23 ;
  }

  notification changeRoute6Info {
    description 'Notification of the change for IPv6 route.' ;
    if-feature changeRouteInfo ;

    list ipv6route {
      config false ;
      description 'The forwarding info list of changed IPv6 routes.' ;
      key 'vrfName addr maskLength' ;
      leaf vrfName {
        description 'Name of the VPN to which a prefix belongs.' ;
        type string {
          length 0..32 ;

        }

      }

      leaf addr {
        description 'Destination IPv6 address.' ;
        type ncd:ipv6-address ;

      }

      leaf maskLength {
        description 'Mask length of an IP address.' ;
        type uint32 ;

      }

      leaf changeType {
        description 'The type of current change.' ;
        type uint8 {
          range 1..3 ;

        }

      }

      container forward-infos {
        list forward-info {
          leaf nexthop {
            type string {
              length 0..70 ;

            }

            description 'The forwarding nexthop of the route.' ;
          }

          leaf interface-name {
            type string {
              length 0..31 ;

            }

            description 'The local interface name through which the next hop of this route should be reached.' ;
          }

          leaf owner {
            type string {
              length 0..31 ;

            }

            description 'The protocol of route.' ;
          }

          leaf metric {
            type uint32 {
              range 0..4294967295 ;

            }

            description 'The metric of route.' ;
          }

          key 'nexthop interface-name owner' ;
          description 'The forwarding information of the route.' ;
          config false ;
          leaf routeChangeType {
            type uint8 {
              range 1..3 ;

            }

            description 'The type of current change.' ;
            ncd:revise-date 2024-07-06 ;
          }

        }

        description 'The forwarding information of the route.' ;
        ncd:revise-date 2024-01-16 ;
      }

    }

    ncd:revise-date 2019-05-28 ;
  }

  notification routeSummary {
    list specific {
      config false ;
      key 'vrfName route-owner' ;
      leaf vrfName {
        description 'Vrf name' ;
        type ncd:string-quesiton-mark ;

      }

      leaf route-owner {
        description 'Protocol name' ;
        type string ;

      }

      leaf route-count {
        description 'Route summary' ;
        type uint32 ;

      }

    }

    list vpnAll {
      config false ;
      description 'BGP/OSPF/ISIS vrf route summary' ;
      key route-owner ;
      leaf route-owner {
        description 'Protocol type' ;
        type string ;

      }

      leaf route-count {
        description 'Route summary' ;
        type uint32 ;

      }

    }

    list all {
      config false ;
      description 'BGP/OSPF/ISIS global or vrf route summary' ;
      key route-owner ;
      leaf route-owner {
        description 'Protocol type' ;
        type string ;

      }

      leaf route-count {
        description 'Route summary' ;
        type uint32 ;

      }

    }

    ncd:revise-date 2021-11-22 ;
  }

  notification route6Summary {
    list vpnAll {
      config false ;
      description 'BGP/OSPF/ISIS vrf route summary' ;
      key route-owner ;
      leaf route-owner {
        description 'Protocol name' ;
        type string ;

      }

      leaf route-count {
        description 'Route summary' ;
        type uint32 ;

      }

    }

    list specific {
      config false ;
      key 'vrfName route-owner' ;
      leaf vrfName {
        description 'Vrf name' ;
        type ncd:string-quesiton-mark ;

      }

      leaf route-owner {
        description 'Protocol name' ;
        type string ;

      }

      leaf route-count {
        description 'Route summary' ;
        type uint32 ;

      }

    }

    list all {
      config false ;
      description 'BGP/OSPF/ISIS global or vrf route summary' ;
      key route-owner ;
      leaf route-owner {
        description 'Protocol name' ;
        type string ;

      }

      leaf route-count {
        description 'Route summary' ;
        type uint32 ;

      }

    }

    ncd:revise-date 2021-11-22 ;
  }

}
