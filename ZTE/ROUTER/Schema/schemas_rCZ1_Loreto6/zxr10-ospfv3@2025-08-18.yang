  revision 2014-01-13 {
    description 'Initial version.' ;
  }

  feature distance-policy {
    description 'The feature is for distance-policy.' ;
  }

  feature segment-routing {
    description 'SR support labels' ;
  }

  feature srv6-adjacency-set {
    description 'The feature is for adjacency-set.' ;
    ncd:revise-date 2025-05-14 ;
  }

  container configuration {
    description 'Configuration.' ;
    container ospfv3 {
      description 'OSPFv3 configuration.' ;
      container global {
        leaf memory-overload-protection {
          type enumeration {
            enum enable {
              value 1 ;
              description 'Enable memory overload protection' ;
            }

            enum disable {
              value 0 ;
              description 'Disable memory overload protection' ;
            }

          }

          description 'Configure memory overload protection for OSPFv3.' ;
          default disable ;
        }

        description 'OSPFv3 global configuration.' ;
        ncd:revise-date 2025-06-30 ;
      }

      container processes {
        description 'OSPFv3 process configuration.' ;
        list process {
          description 'OSPFv3 process configuration.' ;
          key proc-id ;
          leaf proc-id {
            description 'OSPFv3 process ID.' ;
            type uint32 {
              range 1..65535 ;

            }

          }

          leaf vrf-name {
            description 'VPN routing/forwarding instance (VRF) name.' ;
            type string {
              length 1..32 ;

            }

          }

          leaf bfd-enable {
            description 'BFD configuration of OSPFv3 process.' ;
            type empty ;

          }

          leaf bfd-template {
            description 'Configure BFD template for OSPFv3.' ;
            type string {
              length 1..31 ;

            }

            ncd:revise-date 2020-06-21 ;
          }

          leaf default-metric {
            description 'Default metric of Type 5 LSA.' ;
            type uint32 {
              range 1..16777214 ;

            }

            default 20 ;
          }

          leaf maximum-paths {
            description 'Maximum of paths to one destination.The default value of product can be customized with performance parameters.If not, the default value is 1.' ;
            type uint32 {
              range 1..128 ;

            }

            default 1 ;
          }

          leaf fast-reroute {
            description 'Fast-reroute.' ;
            type empty ;

          }

          leaf nsf {
            description 'Non-stop forwarding.' ;
            type empty ;

          }

          leaf grace-period {
            description 'The max period of a graceful restart.' ;
            type uint32 {
              range 1..1800 ;

            }

            units second ;
            default 120 ;
          }

          leaf ispf {
            description 'Incremental SPF computation.' ;
            type empty ;

          }

          leaf ldp-igp-sync {
            description 'Configure MPLS LDP IGP sync.' ;
            type empty ;

            ncd:revise-date 2015-12-08 ;
          }

          leaf cap-vrf-lite {
            description 'Configure capability vrf lite' ;
            type empty ;

            ncd:revise-date 2016-06-23 ;
          }

          leaf reference-bandwidth {
            description 'The reference bandwidth in terms of Mbps.' ;
            type uint32 {
              range 1..4000000 ;

            }

            units Mbps ;
            default 100 ;
            ncd:revise-date 2017-05-18 ;
          }

          leaf te-link-bandwidth {
            description 'Set TE link bandwidth capability' ;
            type enumeration {
              enum disable {
                value 0 ;
                description 'Set TE link bandwidth disable' ;
              }

              enum enable {
                value 1 ;
                description 'Set TE link bandwidth enable' ;
              }

            }

            default disable ;
            ncd:revise-date 2021-06-15 ;
          }

          leaf te-link-delay {
            description 'Set OSPF TE link delay' ;
            type enumeration {
              enum enable {
                value 1 ;
                description 'Enable TE link delay' ;
              }

              enum disable {
                value 2 ;
                description 'Disable TE link delay' ;
              }

            }

            default disable ;
            ncd:revise-date 2020-02-19 ;
          }

          leaf rfc1583-value {
            type enumeration {
              enum enable {
                value 1 ;
                description 'enable' ;
              }

              enum disable {
                value 0 ;
                description 'disable' ;
              }

            }

            default disable ;
            description 'Ospf compatible with rfc1583 when calculating external route' ;
            ncd:revise-date 2023-03-27 ;
          }

          container frr-policy {
            description 'Configure OSPF backup route policy.' ;
            presence frr-policy ;
            choice policy-type {
              description 'Configure OSPF backup route policy type.' ;
              mandatory true ;
              case route-policy {
                description 'Configure OSPF backup route-policy.' ;
                leaf route-policy-name {
                  description 'Configure route-policy name.' ;
                  type string {
                    length 1..200 {
                      description 'Name of the route-policy,characters from 1 to 200.' ;
                    }

                  }

                  mandatory true ;
                }

              }

            }

            ncd:revise-date 2017-07-05 ;
          }

          container router-id {
            description 'Router-id.' ;
            presence router-id-presence ;
            leaf router-id {
              description 'Router-id.' ;
              type ncd:ipv4-address ;

              mandatory true ;
            }

          }

          container distance {
            description 'Distance of OSPF route.' ;
            leaf external {
              description 'Distance for external routes.' ;
              type uint8 {
                range 1..255 ;

              }

              default 110 ;
            }

            leaf inter-area {
              description 'Distance for inter-area routes.' ;
              type uint8 {
                range 1..255 ;

              }

              default 110 ;
            }

            leaf intra-area {
              description 'Distance for intra-area routes.' ;
              type uint8 {
                range 1..255 ;

              }

              default 110 ;
            }

          }

          container distribute-list {
            description 'Filter networks in routing updates.' ;
            container distribute-list-in {
              description 'Filter incoming routing updates.' ;
              presence dl-in-presence ;
              container policy-name {
                description 'Policy name.' ;
                choice policy-name {
                  description 'Policy name.' ;
                  mandatory true ;
                  case access-list {
                    description 'Access list.' ;
                    leaf acl-name {
                      description 'Access list name.' ;
                      type string {
                        length 1..31 ;

                      }

                      mandatory true ;
                    }

                  }

                  case route-map {
                    description 'Route-map.' ;
                    leaf route-map-name {
                      description 'Route-map name.' ;
                      type string {
                        length 1..200 ;

                      }

                      mandatory true ;
                    }

                  }

                }

              }

            }

          }

          container prefix-priority {
            description 'Priority for prefix convergence.' ;
            presence prefix-priority-presence ;
            container prefix-lists {
              description 'Prefix-list for prefix convergence.' ;
              presence prefix-list-presence ;
              list prefix-list {
                description 'Prefix-list for prefix convergence.' ;
                key priority ;
                leaf priority {
                  description 'Priority for prefix.' ;
                  type enumeration {
                    enum critical {
                      value 1 ;
                      description 'Critical priority.' ;
                    }

                    enum high {
                      value 2 ;
                      description 'High priority.' ;
                    }

                    enum medium {
                      value 3 ;
                      description 'Medium priority.' ;
                    }

                  }

                }

                leaf prefix-name {
                  description 'Prefix-list name.' ;
                  type string {
                    length 1..169 ;

                  }

                  mandatory true ;
                }

              }

            }

            container tags {
              description 'Tag value for prefix convergence.' ;
              presence tags-presence ;
              list tag {
                description 'Tag value for prefix convergence.' ;
                key 'priority tag-value' ;
                leaf priority {
                  description 'Priority for prefix.' ;
                  type enumeration {
                    enum critical {
                      value 1 ;
                      description 'Critical priority.' ;
                    }

                    enum high {
                      value 2 ;
                      description 'High priority.' ;
                    }

                    enum medium {
                      value 3 ;
                      description 'Medium priority.' ;
                    }

                  }

                }

                leaf tag-value {
                  description 'Tag value of prefix.' ;
                  type uint32 {
                    range 0..4294967295 ;

                  }

                }

              }

            }

          }

          container redistribute {
            description 'Redistribute.' ;
            container redistribute-ospf {
              description 'Redistribute information from OSPF.' ;
              presence redistribute-ospf-presence ;
              list redistribute-ospf {
                description 'Redistribute information from OSPF.' ;
                key ospf-proc-id ;
                leaf ospf-proc-id {
                  description 'OSPF process ID for redistribute.' ;
                  type uint32 {
                    range 1..65535 ;

                  }

                }

                leaf metric {
                  description 'Metric for redistributed routes.' ;
                  type uint32 {
                    range 1..16777214 ;

                  }

                }

                leaf metric-type {
                  description 'Metric type for redistributed routes.' ;
                  type enumeration {
                    enum ext-2 {
                      value 0 ;
                      description 'External metric-type 2.' ;
                    }

                    enum ext-1 {
                      value 1 ;
                      description 'External metric-type 1.' ;
                    }

                  }

                  default ext-2 ;
                }

                leaf route-map-name {
                  description 'Route map reference.' ;
                  type string {
                    length 1..200 ;

                  }

                }

                leaf tag {
                  description 'Tag for redistributed routes.' ;
                  type uint32 {
                    range 0..4294967295 ;

                  }

                  default 0 ;
                }

                leaf with-origin-metric {
                  description 'Use origin metric of the route.' ;
                  type empty ;

                  ncd:revise-date 2016-12-08 ;
                }

                leaf host-only {
                  type empty ;

                  ncd:revise-date 2019-06-20 ;
                }

              }

            }

            container redistribute-isis {
              description 'Redistribute information from ISIS.' ;
              presence redistribute-isis-presence ;
              list redistribute-isis {
                description 'Redistribute information from ISIS.' ;
                key isis-proc-id ;
                leaf isis-proc-id {
                  description 'ISIS process ID for redistribute.' ;
                  type uint32 {
                    range 0..65535 ;

                  }

                }

                leaf metric {
                  description 'Metric for redistributed routes.' ;
                  type uint32 {
                    range 1..16777214 ;

                  }

                }

                leaf metric-type {
                  description 'Metric type for redistributed routes.' ;
                  type enumeration {
                    enum ext-2 {
                      value 0 ;
                      description 'External metric-type 2.' ;
                    }

                    enum ext-1 {
                      value 1 ;
                      description 'External metric-type 1.' ;
                    }

                  }

                  default ext-2 ;
                }

                leaf route-map-name {
                  description 'Route map reference.' ;
                  type string {
                    length 1..200 ;

                  }

                }

                leaf tag {
                  description 'Tag for redistributed routes.' ;
                  type uint32 {
                    range 0..4294967295 ;

                  }

                  default 0 ;
                }

                leaf with-origin-metric {
                  description 'Use origin metric of the route.' ;
                  type empty ;

                  ncd:revise-date 2016-12-08 ;
                }

                leaf host-only {
                  type empty ;

                  ncd:revise-date 2019-06-20 ;
                }

              }

            }

            container redistribute-other {
              description 'Redistribute information from other protocol.' ;
              presence redistribute-other-presence ;
              list redistribute-other {
                description 'Redistribute information from other protocol.' ;
                key protocol ;
                leaf protocol {
                  description 'Route protocol.' ;
                  type enumeration {
                    enum static {
                      value 1 ;
                      description 'Static routes.' ;
                    }

                    enum connected {
                      value 2 ;
                      description 'Connected routes.' ;
                    }

                    enum rip {
                      value 3 ;
                      description 'Routing information protocol (RIPNG).' ;
                    }

                    enum bgp {
                      value 6 ;
                      description 'Border gateway protocol for ipv6 (BGP).' ;
                    }

                    enum subscriber-host {
                      value 7 ;
                      description "Bras subscriber's host routes." ;
                    }

                    enum aftr {
                      value 8 ;
                      description 'AFTR routes.' ;
                    }

                    enum sf-nat64 {
                      value 9 ;
                      description 'Stateful NAT64 routes.' ;
                    }

                    enum sl-nat64 {
                      value 10 ;
                      description 'Stateless NAT64 routes.' ;
                    }

                    enum dhcp-pd {
                      value 11 ;
                      description 'DHCP-PD routes.' ;
                    }

                    enum subscriber-aggregation {
                      value 14 ;
                      description "Bras subscriber's aggregation routes." ;
                    }

                    enum user-special {
                      value 15 ;
                      description 'User special routes.' ;
                    }

                    enum bras-pool {
                      value 16 ;
                      description 'Bras-pool routes.' ;
                    }

                    enum zenic-local {
                      value 17 ;
                      description 'Zenic-local routes.' ;
                    }

                    enum dyn-leasedline {
                      value 18 ;
                      description 'Dynamic-leased-line routes assigned by AAA' ;
                    }

                    enum bgp-ext {
                      value 20 ;
                      description 'BGP external routes.' ;
                    }

                    enum bgp-int {
                      value 21 ;
                      description 'BGP internal routes.' ;
                    }

                    enum nd-host {
                      value 22 ;
                      description 'ND-HOST routes.' ;
                    }

                  }

                }

                leaf metric {
                  description 'Metric for redistributed routes.' ;
                  type uint32 {
                    range 1..16777214 ;

                  }

                }

                leaf metric-type {
                  description 'Metric type for redistributed routes.' ;
                  type enumeration {
                    enum ext-2 {
                      value 0 ;
                      description 'External metric-type 2.' ;
                    }

                    enum ext-1 {
                      value 1 ;
                      description 'External metric-type 1.' ;
                    }

                  }

                  default ext-2 ;
                }

                leaf route-map-name {
                  description 'Route map reference.' ;
                  type string {
                    length 1..200 ;

                  }

                }

                leaf tag {
                  description 'Tag for redistributed routes.' ;
                  type uint32 {
                    range 0..4294967295 ;

                  }

                  default 0 ;
                }

                leaf with-origin-metric {
                  description 'Use origin metric of the route.' ;
                  type empty ;

                  ncd:revise-date 2016-12-08 ;
                }

                leaf host-only {
                  type empty ;

                  ncd:revise-date 2019-06-20 ;
                }

                leaf asno {
                  description 'Autonomous system number(valid for BGP only).' ;
                  type ncd:asn-dot {
                    length 1..11 ;

                  }

                  ncd:revise-date 2022-12-21 ;
                }

              }

            }

            container redistribute-ps {
              description 'Redistribute PS route.' ;
              list redistribute-ps {
                description 'Redistribute PS route.' ;
                key type ;
                leaf type {
                  description 'PS route type.' ;
                  type enumeration {
                    enum ps-busi-addr {
                      value 12 ;
                      description 'ps-busi-addr routes.' ;
                    }

                    enum ps-user-addr {
                      value 13 ;
                      description 'ps-user-addr routes.' ;
                    }

                  }

                }

                leaf with-origin-metric {
                  description 'Use origin metric of the route.' ;
                  type empty ;

                }

                leaf metric {
                  description 'Metric for redistributed routes.' ;
                  type uint32 {
                    range 1..16777214 ;

                  }

                }

                leaf metric-type {
                  description 'Metric type for redistributed routes.' ;
                  type enumeration {
                    enum ext-2 {
                      value 0 ;
                      description 'External metric-type 2.' ;
                    }

                    enum ext-1 {
                      value 1 ;
                      description 'External metric-type 1.' ;
                    }

                  }

                  default ext-2 ;
                }

                leaf route-map-name {
                  description 'Route map reference.' ;
                  type string {
                    length 1..200 ;

                  }

                }

                leaf tag {
                  description 'Tag for redistributed routes.' ;
                  type uint32 {
                    range 0..4294967295 ;

                  }

                  default 0 ;
                }

                leaf host-only {
                  type empty ;

                  ncd:revise-date 2019-06-20 ;
                }

              }

              ncd:revise-date 2015-05-04 ;
            }

          }

          container summary-prefixs {
            description 'Summarize external routes matching prefix/length.' ;
            list summary-prefix {
              description 'Summarize external routes matching prefix/length.' ;
              key 'summary-prefix prefix-len' ;
              leaf summary-prefix {
                description 'IPv6 address prefix.' ;
                type ncd:ipv6-address ;

              }

              leaf prefix-len {
                description 'Prefix length.' ;
                type ncd:ipv6-mask-length ;

              }

              container tag {
                description 'Tag for convergence routes.' ;
                presence tag ;
                leaf tag {
                  type uint32 {
                    range 0..4294967295 ;

                  }

                  description 'Tag for convergence routes.' ;
                  mandatory true ;
                }

                leaf tag-flag {
                  type enumeration {
                    enum tag-valid {
                      value 1 ;
                      description 'tag-valid' ;
                    }

                    enum tag-invalid {
                      value 0 ;
                      description 'tag-invalid' ;
                    }

                  }

                  description 'Tag flag.If the tag value exists,tag-flag must be set to tag-valid.' ;
                  mandatory true ;
                }

                ncd:revise-date 2024-07-15 ;
              }

            }

          }

          container timers-throttle {
            description 'Timers for throttle.' ;
            presence throttle-presence ;
            container spf {
              description 'Ospf SPF throttle timers' ;
              presence spf ;
              leaf hold-time {
                description 'Hold time for SPF calculation in milliseconds' ;
                type uint32 {
                  range 1..600000 {
                    description 'Hold time for SPF calculation in milliseconds' ;
                  }

                }

                units millisecond ;
                mandatory true ;
              }

              leaf delay-time {
                description 'Min delay for SPF calculation in milliseconds' ;
                type uint32 {
                  range 1..600000 {
                    description 'Min delay for SPF calculation in milliseconds' ;
                  }

                }

                units millisecond ;
                mandatory true ;
              }

              leaf max-delay-time {
