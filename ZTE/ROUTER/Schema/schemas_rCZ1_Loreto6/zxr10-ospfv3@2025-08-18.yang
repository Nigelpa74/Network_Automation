          leaf external-lsa-count {
            description 'Count of external LSA.' ;
            type uint32 ;

          }

          leaf route-count {
            description 'Count of route.' ;
            type uint32 ;

          }

          leaf default-metric {
            description 'Default metric of Type 5 LSA.' ;
            type uint32 {
              range 1..16777214 ;

            }

          }

          container area-count {
            description 'Count of area.' ;
            leaf total-count {
              description 'Count of area.' ;
              type uint32 ;

            }

            leaf normal-count {
              description 'Count of normal area.' ;
              type uint32 ;

            }

            leaf stub-count {
              description 'Count of stub area.' ;
              type uint32 ;

            }

          }

          container areas {
            description 'OSPFv3 area.' ;
            list area {
              description 'OSPFv3 area.' ;
              key area-id ;
              leaf area-id {
                description 'OSPFv3 area ID in IP address format.' ;
                type ncd:ipv4-address ;

              }

              leaf interface-count {
                description 'Count of interface.' ;
                type uint32 ;

              }

              container ipsec {
                description 'IPSEC configuration of area.' ;
                leaf spi-id {
                  description 'Security parameters index ID.' ;
                  type uint32 {
                    range 256..32767 ;

                  }

                }

                leaf type {
                  description 'Type of authentication or encryption.' ;
                  type enumeration {
                    enum authentication {
                      value 1 ;
                    }

                    enum encryption {
                      value 2 ;
                    }

                  }

                }

                leaf authentication-algorithm {
                  description 'Type of authentication algorithm.' ;
                  type enumeration {
                    enum md5 {
                      value 1 ;
                      description 'Message Digest Algorithm.' ;
                    }

                    enum sha1 {
                      value 2 ;
                      description 'Secure Hash Algorithm.' ;
                    }

                    enum keychain {
                      value 4 ;
                      description 'Use keychain for authentication.' ;
                    }

                  }

                }

                leaf encryption-algorithm {
                  description 'Type of encryption algorithm.' ;
                  type enumeration {
                    enum null {
                      value 1 ;
                      description 'NULL encryption.' ;
                    }

                    enum des {
                      value 2 ;
                      description 'Data Encrypt Standard algorithm.' ;
                    }

                    enum triple-des {
                      value 3 ;
                      description 'Triple Data Encryption algorithm.' ;
                    }

                    enum aes-cbc {
                      value 4 ;
                      description 'Advanced Encryption Standard algorithm.' ;
                    }

                    enum keychain-encryption {
                      value 6 ;
                      description 'Use keychain for encryption.' ;
                    }

                  }

                }

              }

              leaf area-type {
                description 'Type of area.' ;
                type enumeration {
                  enum stub {
                    value 1 ;
                  }

                  enum normal {
                    value 2 ;
                  }

                  enum nssa {
                    value 3 ;
                  }

                }

              }

              leaf default-cost {
                description "Stub's advertised default summary cost." ;
                type uint32 {
                  range 0..16777215 ;

                }

              }

              leaf spf-calculate-times {
                description 'SPF calculate times.' ;
                type uint32 ;

              }

              leaf ispf-calculate-times {
                description 'Incremental SPF calculate times' ;
                type uint32 ;

              }

              leaf lsa-count {
                description 'Count of LSA.' ;
                type uint32 ;

              }

              leaf unknown-lsa-count {
                description 'Count of unknown LSA.' ;
                type uint32 ;

              }

            }

          }

          ncd:select process-id ;
        }

      }

      container interfaces {
        description 'OSPFv3 interface.' ;
        container normal-interfaces {
          description 'OSPFv3 normal interface.' ;
          list normal-interface {
            description 'OSPFv3 normal interface.' ;
            key 'process-id area-id interface-name' ;
            leaf process-id {
              description 'OSPFv3 process ID.' ;
              type uint32 {
                range 1..65535 ;

              }

            }

            leaf area-id {
              description 'OSPFv3 area ID in IP address format.' ;
              type ncd:ipv4-address ;

            }

            leaf interface-name {
              description 'Interface name.' ;
              type ncd:ifname {
                length 1..31 ;

              }

            }

            leaf admin-state {
              description 'Interface admin state.' ;
              type enumeration {
                enum up {
                  value 1 ;
                }

                enum down {
                  value 2 ;
                }

              }

            }

            leaf protocol-state {
              description 'Interface protocol state.' ;
              type enumeration {
                enum up {
                  value 1 ;
                }

                enum down {
                  value 2 ;
                }

              }

            }

            leaf linklocal-address {
              description 'Link-local address.' ;
              type ncd:ipv6-address ;

            }

            leaf interface-id {
              description 'Interface ID.' ;
              type uint32 {
                range 0..4294967295 ;

              }

            }

            leaf instance-id {
              description 'Interface ID.' ;
              type uint8 ;

            }

            leaf network-type {
              description 'Network type.' ;
              type enumeration {
                enum Nbma {
                  value 3 ;
                }

                enum Point-to-point {
                  value 1 ;
                }

                enum Point-to-multipoint {
                  value 4 ;
                }

                enum P-to-mp-nb {
                  value 5 ;
                }

                enum Broadcast {
                  value 2 ;
                }

                enum Loopback {
                  value 6 ;
                }

              }

            }

            leaf cost {
              description 'Cost value of OSPFv3 interface.' ;
              type uint32 {
                range 1..65535 ;

              }

            }

            leaf transmit-delay {
              description 'LSA transmit delay over link.' ;
              type uint32 {
                range 1..65535 ;

              }

              units second ;
            }

            leaf interface-state {
              description 'State of OSPF interface machine.' ;
              type enumeration {
                enum Down {
                  value 1 ;
                  description 'This is the initial interface state.' ;
                }

                enum Standby {
                  value 2 ;
                  description 'In this state, the interface is one of multiple interfaces to a link and this interface is designated Standby and is not sending or receiving control packets.' ;
                }

                enum Loopback {
                  value 3 ;
                  description "In this state, the router's interface to the network is looped back." ;
                }

                enum Waiting {
                  value 4 ;
                  description 'In this state, the router is trying to determine the identity of the (Backup) Designated Router for the network.' ;
                }

                enum Point-to-point {
                  value 5 ;
                  description 'In this state, the interface is operational, and connects either to a physical point-to-point network or to a virtual link.' ;
                }

                enum DROther {
                  value 6 ;
                  description 'The interface is to a broadcast or NBMA network on which another router has been selected to be the Designated Router.' ;
                }

                enum Backup {
                  value 7 ;
                  description 'In this state, the router itself is the Backup Designated Router on the attached network.' ;
                }

                enum DR {
                  value 8 ;
                  description 'In this state, this router itself is the Designated Router on the attached network.' ;
                }

              }

            }

            leaf priority {
              description 'Router priority.' ;
              type uint32 {
                range 0..255 ;

              }

            }

            leaf ldp-sync-config {
              description 'MPLS LDP IGP sync.' ;
              type enumeration {
                enum disable {
                  value 0 ;
                  description 'MPLS LDP IGP sync is disabled.' ;
                }

                enum enable {
                  value 1 ;
                  description 'MPLS LDP IGP sync is enabled.' ;
                }

              }

              ncd:revise-date 2015-12-08 ;
            }

            leaf ldp-sync-state {
              description 'MPLS LDP IGP sync of the interface.' ;
              type enumeration {
                enum unachieve {
                  value 0 ;
                  description 'MPLS LDP IGP sync state is unachieved.' ;
                }

                enum achieve {
                  value 1 ;
                  description 'MPLS LDP IGP sync state is achieved.' ;
                }

                enum unknown {
                  value 2 ;
                  description 'MPLS LDP IGP sync state is unknown.' ;
                }

              }

              ncd:revise-date 2015-12-08 ;
            }

            leaf ldp-link-state {
              description 'Router lsa link state caused by MPLS LDP IGP state.' ;
              type enumeration {
                enum send-max-metric {
                  value 0 ;
                  description 'MPLS LDP IGP link state is sending max metric.' ;
                }

                enum unreachable {
                  value 1 ;
                  description 'MPLS LDP IGP link state is unreachable.' ;
                }

                enum send-normal-metric {
                  value 2 ;
                  description 'MPLS LDP IGP link state is sending normal metric.' ;
                }

                enum send-increase-metric {
                  value 3 ;
                  description 'MPLS LDP IGP link state is sending increase metric.' ;
                }

              }

              ncd:revise-date 2015-12-08 ;
            }

            leaf no-cut-edge {
              description 'There is alternate path for the directly connected network.' ;
              type empty ;

              ncd:revise-date 2015-12-08 ;
            }

            leaf dr {
              description 'Designated Router ID.' ;
              type ncd:ipv4-address ;

            }

            leaf dr-linklocal-address {
              description 'Link-local address of the DR.' ;
              type ncd:ipv6-address ;

            }

            leaf bdr {
              description 'Backup designated Router ID.' ;
              type ncd:ipv4-address ;

            }

            leaf bdr-linklocal-address {
              description 'Link-local address of the BDR.' ;
              type ncd:ipv6-address ;

            }

            leaf hello-interval {
              description 'Time between hello packets.' ;
              type uint32 {
                range 1..65535 ;

              }

              units second ;
            }

            leaf dead-interval {
              description 'Interval after which a neighbor is declared dead.' ;
              type uint32 {
                range 1..65535 ;

              }

              units second ;
            }

            leaf wait-interval {
              description 'The Interval that interface exit waiting state.' ;
              type uint32 {
                range 0..65535 ;

              }

              units second ;
            }

            leaf retransmit-interval {
              description 'Time between retransmitting lost link state advertisements.' ;
              type uint32 {
                range 1..65535 ;

              }

              units second ;
              default 5 ;
            }

            leaf neighbor-count {
              description 'Count of neighbor.' ;
              type uint32 ;

            }

            leaf full-neighbor-count {
              description 'Full neighbor count.' ;
              type uint32 ;

            }

            leaf linklsa-suppress {
              description 'Link lsa suppress.' ;
              type empty ;

            }

            leaf damp-state {
              description 'Link damp state of the interface.' ;
              type enumeration {
                enum inactive {
                  value 0 ;
                  description 'Link Damp state of this interface is inactive.' ;
                }

                enum active {
                  value 1 ;
                  description 'Link Damp state of this interface is active.' ;
                }

              }

              ncd:revise-date 2017-03-31 ;
            }

            leaf damp-remain {
              description 'Link damp remaining time.' ;
              type uint32 {
                range 0..3600000 {
                  description 'Link damp remaining time.' ;
                }

              }

              ncd:revise-date 2017-03-31 ;
            }

            container ipsec {
              description 'IPSEC states of interface.' ;
              leaf spi-id {
                description 'Security parameters index ID.' ;
                type uint32 ;

              }

              leaf type {
                description 'Type of authentication or encryption.' ;
                type enumeration {
                  enum authentication-null {
                    value 1 ;
                  }

                  enum encryption-null {
                    value 2 ;
                  }

                  enum authentication {
                    value 3 ;
                  }

                  enum encryption {
                    value 4 ;
                  }

                }

              }

              leaf authentication-algorithm {
                description 'Type of authentication algorithm.' ;
                type enumeration {
                  enum md5 {
                    value 1 ;
                    description 'Message Digest Algorithm.' ;
                  }

                  enum sha1 {
                    value 2 ;
                    description 'Secure Hash Algorithm.' ;
                  }

                  enum keychain {
                    value 4 ;
                    description 'Use keychain for authentication.' ;
                  }

                }

              }

              leaf encryption-algorithm {
                description 'Type of encryption algorithm.' ;
                type enumeration {
                  enum null {
                    value 1 ;
                    description 'NULL encryption.' ;
                  }

                  enum des {
                    value 2 ;
                    description 'Data Encrypt Standard algorithm.' ;
                  }

                  enum triple-des {
                    value 3 ;
                    description 'Triple Data Encryption algorithm.' ;
                  }

                  enum aes-cbc {
                    value 4 ;
                    description 'Advanced Encryption Standard algorithm.' ;
                  }

                  enum keychain-encryption {
                    value 6 ;
                    description 'Use keychain for encryption.' ;
                  }

                }

              }

              leaf state {
                description 'State of IPSEC.' ;
                type enumeration {
                  enum down {
                    value 0 ;
                  }

                  enum start {
                    value 1 ;
                  }

                  enum rekeying-add-new-in {
                    value 2 ;
                  }

                  enum rekeying-add-new-out {
                    value 3 ;
                  }

                  enum rekeying-del-old-in {
                    value 4 ;
                  }

                  enum up {
                    value 5 ;
                  }

                }

              }

            }

            ncd:select interface-name ;
            ncd:select process-id ;
            ncd:select "process-id interface-name" ;
          }

        }

        container virtual-interfaces {
          description 'OSPFv3 virtual interface.' ;
          list virtual-interface {
            description 'OSPFv3 virtual interface.' ;
            key 'process-id area-id neighbor-id' ;
            leaf process-id {
              description 'OSPFv3 process ID.' ;
              type uint32 {
                range 1..65535 ;

              }

            }

            leaf area-id {
              description 'OSPFv3 area ID in IP address format.' ;
              type ncd:ipv4-address ;

            }

            leaf neighbor-id {
              description 'Router ID of the virtual link neighbor.' ;
              type ncd:ipv4-address ;

            }

            leaf interface-id {
              description 'Virtual interface ID.' ;
              type uint32 {
                range 2147483648..4294967294 ;

              }

            }

            leaf state {
              description 'State of the virtual link.' ;
              type enumeration {
                enum down {
                  value 0 ;
                  description 'The virtual-link is down.' ;
                }

                enum up {
                  value 1 ;
                  description 'The virtual-link is up.' ;
                }

              }

            }

            leaf neighbor-ipv6-address {
              description 'IPv6 address of the virtual neighbor.' ;
              type ncd:ipv6-address ;

            }

            leaf out-interface-name {
              description 'The outgoing interface name of virtual interface.' ;
              type ncd:ifname {
                length 1..31 ;

              }

            }

            leaf cost {
              description 'Cost value of OSPFv3 virtual link interface.' ;
              type uint32 {
                range 1..65535 ;

              }

            }

            leaf hello-interval {
              description 'Time between hello packets over virtual link.' ;
              type uint32 {
                range 1..8192 ;

              }

              units second ;
              default 10 ;
            }

            leaf dead-interval {
              description 'Interval after which a virtual neighbor is declared dead.' ;
              type uint32 {
                range 1..8192 ;

              }

              units second ;
            }

            leaf wait-interval {
              description 'Interval after which a virtual interface to exit the waiting state.' ;
              type uint32 {
                range 1..8192 ;

              }

              units second ;
            }

            leaf retransmit-interval {
              description 'Time between retransmitting lost link state advertisements over virtual link.' ;
              type uint32 {
                range 1..8192 ;

              }

              units second ;
              default 5 ;
            }

            leaf transmit-delay {
              description 'LSA transmit delay over virtual link.' ;
              type uint32 {
                range 1..8192 ;

              }

              units second ;
              default 1 ;
            }

            leaf interface-state {
              description 'State of the virtual interface.' ;
              type enumeration {
                enum Down {
                  value 1 ;
                  description 'This is the initial interface state.' ;
                }

                enum Point-to-point {
                  value 5 ;
                  description 'In this state, the interface is operational, and connects either to a physical point-to-point network or to a virtual link.' ;
                }

              }

            }

            leaf neighbor-state {
              description 'State of the virtual neighbor.' ;
              type enumeration {
                enum Down {
                  value 1 ;
                  description 'This is the initial state of a neighbor conversation.' ;
                }

                enum Init {
                  value 3 ;
                  description 'In this state, an Hello packet has recently been seen from the neighbor.' ;
                }

                enum 2-Way {
                  value 4 ;
                  description 'In this state, communication between the two routers is bidirectional.' ;
                }

                enum ExStart {
                  value 5 ;
                  description 'This is the first step in creating an adjacency between the two neighboring routers.' ;
                }

                enum Exchange {
                  value 6 ;
                  description 'In this state the router is describing its entire link state database by sending Database Description packets to the neighbor.' ;
                }

                enum Loading {
                  value 7 ;
                  description 'In this state, Link State Request packets are sent to the neighbor asking for the more recent LSAs that have been discovered (but not yet received) in the Exchange state.' ;
                }

                enum Full {
                  value 8 ;
                  description 'In this state, the neighboring routers are fully adjacent.' ;
                }

              }

            }

            container ipsec {
              description 'IPSEC states of virtual link.' ;
              leaf spi-id {
                description 'Security parameters index ID.' ;
                type uint32 {
                  range 256..32767 ;

                }

              }

              leaf type {
                description 'Type of authentication or encryption.' ;
                type enumeration {
                  enum authentication {
                    value 3 ;
                    description 'Authentication type.' ;
                  }

                  enum encryption {
                    value 4 ;
                    description 'Encryption type.' ;
                  }

                }

              }

              leaf authentication-algorithm {
                description 'Type of authentication algorithm.' ;
                type enumeration {
                  enum md5 {
                    value 1 ;
                    description 'Message Digest Algorithm.' ;
                  }

                  enum sha1 {
                    value 2 ;
                    description 'Secure Hash Algorithm.' ;
                  }

                  enum keychain {
                    value 4 ;
                    description 'Use keychain for authentication.' ;
                  }

                }

              }

              leaf encryption-algorithm {
                description 'Type of encryption algorithm.' ;
                type enumeration {
                  enum null {
                    value 1 ;
                    description 'NULL encryption.' ;
                  }

                  enum des {
                    value 2 ;
                    description 'Data Encrypt Standard algorithm.' ;
                  }

                  enum triple-des {
                    value 3 ;
                    description 'Triple Data Encryption algorithm.' ;
                  }

                  enum aes-cbc {
                    value 4 ;
                    description 'Advanced Encryption Standard algorithm.' ;
                  }

                  enum keychain-encryption {
                    value 6 ;
                    description 'Use keychain for encryption.' ;
                  }

                }

              }

              leaf state {
                description 'State of IPSEC.' ;
                type enumeration {
                  enum down {
                    value 0 ;
                    description 'Down state.' ;
                  }

                  enum start {
                    value 1 ;
                    description 'Start state.' ;
                  }

                  enum rekeying-add-new-in {
                    value 2 ;
                    description 'Rekeying(add-new-in) state.' ;
                  }

                  enum rekeying-add-new-out {
                    value 3 ;
                    description 'Rekeying(add-new-out) state.' ;
                  }

                  enum rekeying-del-old-in {
                    value 4 ;
                    description 'Rekeying(del-old-in) state.' ;
                  }

                  enum up {
                    value 5 ;
                    description 'Up state.' ;
                  }

                }

              }

            }

            ncd:select process-id ;
          }

        }

      }

      container neighbors {
        description 'OSPFv3 neighbor.' ;
        container normal-neighbors {
          description 'OSPFv3 normal neighbor.' ;
          list normal-neighbor {
            description 'OSPFv3 normal neighbor.' ;
            key 'process-id area-id interface-name neighbor-id' ;
            leaf process-id {
              description 'OSPFv3 process ID.' ;
              type uint32 {
                range 1..4294967295 ;

              }

            }

            leaf area-id {
              description 'OSPFv3 area ID in IP address format.' ;
              type ncd:ipv4-address ;

            }

            leaf interface-name {
              description 'The outgoing interface name of  interface.' ;
              type ncd:ifname {
                length 1..31 ;

              }

            }

            leaf neighbor-id {
              description 'Router ID of the neighbor.' ;
              type ncd:ipv4-address ;

            }

            leaf interface-id {
              description 'Interface ID.' ;
              type uint32 ;

            }

            leaf neighbor-linklocal-address {
              description 'Link-local address of neighbor.' ;
              type ncd:ipv6-address ;

            }

            leaf priority {
              description 'Neighbor router priority.' ;
              type uint32 {
                range 0..255 ;

              }

            }

            leaf neighbor-state {
              description 'Neighbor router state.' ;
              type enumeration {
                enum Init {
                  value 3 ;
                }

                enum 2-Way {
                  value 4 ;
                }

                enum Exstart {
                  value 5 ;
                }

                enum Exchange {
                  value 6 ;
                }

                enum Loading {
                  value 7 ;
                }

                enum Full {
                  value 8 ;
                }

              }

            }

            leaf neighbor-role {
              description 'State of the interface.' ;
              type enumeration {
                enum DR {
                  value 1 ;
                }

                enum Backup {
                  value 2 ;
                }

                enum DROther {
                  value 3 ;
                }

              }

            }

            leaf state-change-times {
              description 'Neighbor router state change times.' ;
              type uint32 ;

            }

            leaf dr {
              description 'Designated Router ID.' ;
              type ncd:ipv4-address ;

            }

            leaf bdr {
              description 'Backup designated Router ID.' ;
              type ncd:ipv4-address ;

            }

            leaf retransmit-list-count {
              description 'Database retransmit packet count.' ;
              type uint32 ;

            }

            leaf dd-list-count {
              description 'DD packet count in list.' ;
              type uint32 ;

            }

            leaf request-list-count {
              description 'Request packet count in list.' ;
              type uint32 ;

            }

            leaf dead-time {
              description 'Dead Time.' ;
              type string {
                length 1..15 ;

              }

            }

            leaf full-time {
              description 'Neighbor full time.' ;
              type string {
                length 1..15 ;

              }

            }

            leaf options-field {
              description 'Options field of neighbor.' ;
              type uint32 ;

            }

            container options {
              description 'Options of neighbor.' ;
              leaf v6-bit {
                description 'If this bit is clear, the router/link should be excluded from IPv6 routing calculations.' ;
                type empty ;

              }

              leaf e-bit {
                description 'This bit describes the way AS-external-LSAs are flooded.' ;
                type empty ;

              }

              leaf n-bit {
                description 'This bit indicates whether or not the router is attached to an NSSA.' ;
                type empty ;

              }

              leaf r-bit {
                description "This bit (the `Router' bit) indicates whether the originator is an active router." ;
                type empty ;

              }

              leaf dc-bit {
                description "This bit describes the router's handling of demand circuits." ;
                type empty ;

              }

            }

            ncd:select neighbor-id ;
            ncd:select "process-id neighbor-id" ;
            ncd:select process-id ;
            ncd:select interface-name ;
            ncd:select "interface-name neighbor-id" ;
            ncd:select "process-id interface-name" ;
            ncd:select "process-id interface-name neighbor-id" ;
          }

        }

        container virtual-neighbors {
          description 'OSPFv3 virtual neighbor.' ;
          list virtual-neighbor {
            description 'OSPFv3 virtual neighbor.' ;
            key 'process-id transit-area-id neighbor-id' ;
            leaf process-id {
              description 'OSPFv3 process ID.' ;
              type uint32 {
                range 1..65535 ;

              }

            }

            leaf transit-area-id {
              description 'OSPFv3 virtual link transit area ID in IP address format.' ;
              type ncd:ipv4-address ;

            }

            leaf neighbor-id {
              description 'Router ID of the neighbor.' ;
              type ncd:ipv4-address ;

            }

            leaf area-id {
              description 'OSPFv3 area ID in IP address format.' ;
              type ncd:ipv4-address ;

            }

            leaf out-interface-name {
              description 'The outgoing interface name of virtual interface.' ;
              type ncd:ifname {
                length 1..31 ;

              }

            }

            leaf interface-id {
              description 'Interface ID.' ;
              type uint32 ;

            }

            leaf neighbor-ipv6-address {
              description 'IPv6 address of the virtual neighbor.' ;
              type ncd:ipv6-address ;

            }

            leaf priority {
              description 'Neighbor router priority.' ;
              type uint32 {
                range 0..255 ;

              }

            }

            leaf neighbor-state {
              description 'Neighbor router state.' ;
              type enumeration {
                enum Down {
                  value 1 ;
                }

                enum Init {
                  value 3 ;
                }

                enum 2-Way {
                  value 4 ;
                }

                enum Exstart {
                  value 5 ;
                }

                enum Exchange {
                  value 6 ;
                }

                enum Loading {
                  value 7 ;
                }

                enum Full {
                  value 8 ;
                }

              }

            }

            leaf state-change-times {
              description 'Neighbor router state change times.' ;
              type uint32 ;

            }

            leaf retransmit-list-count {
              description 'Database retransmit packet count.' ;
              type uint32 ;

            }

            leaf dd-list-count {
              description 'DD packet count in list.' ;
              type uint32 ;

            }

            leaf request-list-count {
              description 'Request packet count in list.' ;
              type uint32 ;

            }

            leaf dead-time {
              description 'Dead Time.' ;
              type string {
                length 1..15 ;

              }

            }

            leaf full-time {
              description 'Neighbor full time.' ;
              type string {
                length 1..15 ;

              }

            }

            leaf options-field {
              description 'Options field of neighbor.' ;
              type uint32 ;

            }

            container options {
              description 'Options of neighbor.' ;
              leaf v6-bit {
                description 'If this bit is clear, the router/link should be excluded from IPv6 routing calculations.' ;
                type empty ;

              }

              leaf e-bit {
                description 'This bit describes the way AS-external-LSAs are flooded.' ;
                type empty ;

              }

              leaf n-bit {
                description 'This bit indicates whether or not the router is attached to an NSSA.' ;
                type empty ;

              }

              leaf r-bit {
                description "This bit (the `Router' bit) indicates whether the originator is an active router." ;
                type empty ;

              }

              leaf dc-bit {
                description "This bit describes the router's handling of demand circuits." ;
                type empty ;

              }

            }

          }

        }

      }

    }

    ncd:revise-date 2015-03-26 ;
  }

  container operation {
    config false ;
    description 'Operation model.' ;
    container ospfv3 {
      description 'Operation of OSPFv3.' ;
      container clear {
        description 'Clear Operation.' ;
        container process {
          description 'Clear an OSPFv3 process based on the process-id.' ;
          leaf process-id {
            description 'OSPFv3 process ID.' ;
            type uint32 {
              range 1..65535 ;

            }

          }

        }

      }

    }

    ncd:revise-date 2015-03-26 ;
  }

  notification notification {
    description 'notification of OSPFv3,only telemetry upload is supported.' ;
    container neighbors {
      config false ;
      description 'OSPFv3 normal neighbors.' ;
      container normal-nbrs {
        description 'OSPFv3 normal neighbor.' ;
        list normal-nbr {
          description 'OSPFv3 normal neighbor.' ;
          key 'proc-id area-ip if-name nbr-id' ;
          leaf proc-id {
            description 'OSPFv3 process ID.' ;
            type uint32 {
              range 1..65535 ;

            }

          }

          leaf area-ip {
            description 'OSPFv3 area ID in IP address format.' ;
            type ncd:ipv4-address ;

          }

          leaf if-name {
            description 'The outgoing interface name of  interface.' ;
            type ncd:ifname {
              length 1..31 ;

            }

          }

          leaf nbr-id {
            description 'Router ID of the neighbor.' ;
            type ncd:ipv4-address ;

          }

          leaf nbr-state {
            description 'The state of OSPF neighbor.' ;
            type enumeration {
              enum Down {
                value 0 ;
                description 'The state of OSPF neighbor is Down.' ;
              }

              enum Attempt {
                value 1 ;
                description 'The state of OSPF neighbor is Attempt.' ;
              }

              enum Init {
                value 2 ;
                description 'The state of OSPF neighbor is Init.' ;
              }

              enum 2-Way {
                value 3 ;
