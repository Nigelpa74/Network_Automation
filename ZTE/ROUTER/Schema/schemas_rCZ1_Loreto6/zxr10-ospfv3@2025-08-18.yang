                        type uint32 {
                          range 1..65535 ;

                        }

                      }

                    }

                  }

                  container cost-lag-down {
                    description 'Configure interface cost when link detects lag down.' ;
                    choice cost-lag-down {
                      description 'Configure interface cost when link detects lag down.' ;
                      case increase-value {
                        description 'Set increase cost when link detects lag down.' ;
