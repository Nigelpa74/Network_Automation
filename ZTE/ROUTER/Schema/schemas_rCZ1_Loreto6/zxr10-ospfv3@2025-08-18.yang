                description 'Hold time for LSA arrival in milliseconds' ;
                type uint32 {
                  range 0..600000 {
                    description 'Hold time for LSA arrival in milliseconds' ;
                  }

                }

                units millisecond ;
                mandatory true ;
              }

              leaf delay-time {
                description 'Min delay for LSA arrival in milliseconds' ;
                type uint32 {
                  range 0..600000 {
                    description 'Min delay for LSA arrival in milliseconds' ;
                  }

                }

                units millisecond ;
                mandatory true ;
              }

              leaf max-delay-time {
                description 'Max delay for LSA arrival in milliseconds' ;
                type uint32 {
                  range 0..600000 {
                    description 'Max delay for LSA update in milliseconds' ;
                  }

                }

                units millisecond ;
                mandatory true ;
              }

            }

          }

          container notify-default-route {
            description 'Notify default route.' ;
            presence notify-default-route-presence ;
            leaf always {
              description 'Generate a type-5 LSA even if there is no default route.' ;
              type empty ;

            }

            leaf metric {
              description 'Metric of generated type-5 LSA.' ;
              type uint32 {
                range 1..16777214 ;

              }

              default 1 ;
            }

            leaf metric-type {
              description 'Metric type of generated type-5 LSA.' ;
              type enumeration {
                enum ext-2 {
                  value 0 ;
                  description 'External metric-type 2.' ;
                }

                enum ext-1 {
                  value 1 ;
                  description 'External metric-type 1.' ;
                }

              }

              default ext-2 ;
            }

            leaf route-map {
              description 'Route map reference.' ;
              type string {
                length 1..200 ;

              }

            }

            leaf rib-match-prefix-list {
              description 'Name of the prefix-list.' ;
              type string {
                length 1..169 ;

              }

              ncd:revise-date 2022-09-19 ;
            }

          }

          container areas {
            description 'OSPFv3 area configuration.' ;
            list area {
              description 'OSPFv3 area configuration.' ;
              key area-id ;
              leaf area-id {
                description 'OSPFv3 area ID in IP address format.' ;
                type ncd:ipv4-address ;

              }

              leaf bfd {
                description 'BFD configuration of OSPFv3 area.' ;
                type enumeration {
                  enum enable {
                    value 1 ;
                    description 'Enable BFD capability of the area.' ;
                  }

                  enum disable {
                    value 2 ;
                    description 'Disable BFD capability of the area.' ;
                  }

                }

              }

              leaf bfd-template {
                description 'Configure BFD template for OSPFv3 area.' ;
                type string {
                  length 1..31 ;

                }

                ncd:revise-date 2020-06-21 ;
              }

              leaf ldp-igp-sync {
                description 'Configure MPLS LDP IGP sync.' ;
                type enumeration {
                  enum enable {
                    value 1 ;
                    description 'Enable MPLS LDP IGP sync.' ;
                  }

                  enum disable {
                    value 2 ;
                    description 'Disable MPLS LDP IGP sync.' ;
                  }

                }

                ncd:revise-date 2015-12-08 ;
              }

              container ranges {
                description 'Summarize inter-area routes matching prefix/length.' ;
                list range {
                  description 'Summarize inter-area routes matching prefix/length.' ;
                  key 'prefix prefix-len' ;
                  leaf prefix {
                    description 'IPv6 address prefix.' ;
                    type ncd:ipv6-address ;

                  }

                  leaf prefix-len {
                    description 'Prefix length.' ;
                    type ncd:ipv6-mask-length ;

                  }

                  leaf not-advertise {
                    description 'DoNotAdvertise this range.' ;
                    type empty ;

                  }

                }

                list nssa-range {
                  description 'Summarize routes when nssa abr translates type-7 routes to type-5 lsa' ;
                  key 'prefix prefix-len' ;
                  leaf prefix {
