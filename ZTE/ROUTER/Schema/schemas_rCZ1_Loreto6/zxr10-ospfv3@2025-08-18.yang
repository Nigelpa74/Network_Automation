                value 0 ;
                description 'The flapping state of OSPF neighbor is normal.' ;
              }

              enum holdDown {
                value 1 ;
                description 'The flapping state of OSPF neighbor is holdDown.' ;
              }

              enum maxCost {
                value 2 ;
                description 'The flapping state of OSPF neighbor is maxCost.' ;
              }

            }

          }

        }

      }

    }

    container nbr-cnts {
      description 'OSPFv3 neighbor count information.' ;
      list nbr-cnt {
        leaf proc-id {
          type uint32 {
            range 1..65535 ;

