                        }

                      }

                      units millisecond ;
                      mandatory true ;
                    }

                    ncd:revise-date 2017-03-31 ;
                  }

                  container network-type {
                    description 'Network type of OSPFv3 interface.' ;
                    choice network-type {
                      description 'Network type of OSPFv3 interface.' ;
                      case broadcast {
                        description 'Broadcast.' ;
                        leaf broadcast {
                          description 'Broadcast.' ;
                          type empty ;

                          mandatory true ;
                        }

                      }

                      case nbma {
                        description 'Non-broadcast multiple access.' ;
                        leaf nbma {
                          description 'Non-broadcast multiple access.' ;
                          type empty ;

                          mandatory true ;
                        }

                      }

                      case point-to-point {
                        description 'Point-to-point.' ;
                        leaf point-to-point {
                          description 'Point-to-point.' ;
                          type empty ;

                          mandatory true ;
                        }

                      }

                      case point-to-multipoint {
                        description 'Point-to-multipoint.' ;
                        leaf point-to-multipoint {
                          description 'Point-to-multipoint.' ;
                          type empty ;

                          mandatory true ;
                        }

                      }

                      case p-to-mp-nb {
                        description 'Point-to-multipoint non-broadcast.' ;
                        leaf p-to-mp-nb {
                          description 'Point-to-multipoint non-broadcast.' ;
                          type empty ;

                          mandatory true ;
                        }

                      }

                    }

