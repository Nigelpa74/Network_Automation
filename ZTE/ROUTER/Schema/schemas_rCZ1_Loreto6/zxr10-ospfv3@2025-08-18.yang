                      length 1..31 ;

                    }

                  }

                  leaf instance-id {
                    description 'Instance ID of OSPFv3 interface.' ;
                    type uint32 {
                      range 0..255 ;

                    }

                    default 0 ;
                  }

                  leaf bfd {
                    description 'BFD configuration of OSPFv3 interface.' ;
                    type enumeration {
                      enum enable {
                        value 1 ;
                        description 'Enable BFD capability of the interface.' ;
                      }

                      enum disable {
                        value 2 ;
                        description 'Disable BFD capability of the interface.' ;
                      }

                    }

                  }

                  leaf bfd-template {
                    description 'Configure BFD template for OSPFv3 interface.' ;
                    type string {
                      length 1..31 ;

                    }

                    ncd:revise-date 2020-06-21 ;
                  }

                  leaf cost {
                    description 'Cost value of OSPFv3 interface.' ;
                    type uint32 {
                      range 1..65535 ;

                    }

                  }

                  leaf hello-interval {
                    description 'Time between hello packets.' ;
                    type uint32 {
                      range 1..65535 ;

                    }

                    units second ;
                  }

                  leaf dead-interval {
                    description 'Interval after which a neighbor is declared dead.' ;
                    type uint32 {
                      range 1..65535 ;

                    }

                    units second ;
                  }

                  leaf retransmit-interval {
                    description 'Time between retransmitting lost link state advertisements.' ;
                    type uint32 {
                      range 1..65535 ;

                    }

                    units second ;
                    default 5 ;
                  }

                  leaf transmit-delay {
                    description 'LSA transmit delay.' ;
                    type uint32 {
                      range 1..65535 ;

                    }

                    units second ;
                    default 1 ;
                  }

                  leaf priority {
                    description 'Router priority.' ;
                    type uint32 {
                      range 0..255 ;

                    }

                    default 1 ;
                  }

                  leaf mtu-ignore {
                    description 'Ignore the mtu mismatch when exchanging DD packet.' ;
                    type empty ;

                  }

                  leaf linklsa-suppress-enable {
                    description 'DONOT originate link LSA.' ;
                    type empty ;

                  }

                  leaf fast-reroute-disable {
                    description 'Disable this interface FRR capability.' ;
                    type empty ;

                  }

                  leaf passive {
                    description 'Control routing updates on an interface.' ;
                    type empty ;

                  }

                  leaf ldp-igp-sync {
                    description 'Enable MPLS LDP IGP sync.' ;
                    type enumeration {
                      enum enable {
                        value 1 ;
                        description 'Enable MPLS LDP IGP sync.' ;
                      }

                      enum disable {
                        value 2 ;
                        description 'Disable MPLS LDP IGP sync.' ;
                      }

                    }

                    ncd:revise-date 2015-12-08 ;
                  }

                  container link-damping {
                    description 'Configure interface cost and time when link is in damping status' ;
                    presence link-damping ;
                    container cost {
                      description 'Configure interface cost when link is in damping status' ;
                      choice cost {
                        description 'Configure interface cost when link is in damping status' ;
                        mandatory true ;
                        case maximum {
                          description 'Set maximum cost when link is in damping status' ;
                          leaf maximum {
                            description 'Set maximum cost when link is in damping status' ;
                            type empty ;

                            mandatory true ;
                          }

                        }

                        case increase-value {
                          description 'Set increase cost when link is in damping status' ;
                          leaf increase-value {
                            description 'Set increase cost when link is in damping status' ;
                            type uint32 {
                              range 100..10000 {
                                description 'Set increase cost range when link is in damping status' ;
                              }

                            }

                            mandatory true ;
                          }

                        }

                      }

                    }

                    leaf damping-time {
                      description 'Configure interface damping time' ;
