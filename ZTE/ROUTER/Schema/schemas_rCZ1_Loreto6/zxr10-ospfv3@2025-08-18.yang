              }

              enum Attempt {
                value 1 ;
                description 'The state of OSPF neighbor is Attempt.' ;
              }

              enum Init {
                value 2 ;
                description 'The state of OSPF neighbor is Init.' ;
              }

              enum 2-Way {
                value 3 ;
                description 'The state of OSPF neighbor is 2-Way.' ;
              }

              enum ExStart {
                value 4 ;
                description 'The state of OSPF neighbor is Exstart.' ;
              }

              enum Exchange {
                value 5 ;
                description 'The state of OSPF neighbor is Exchange.' ;
              }

              enum Loading {
                value 6 ;
                description 'The state of OSPF neighbor is Loading.' ;
              }

              enum Full {
                value 7 ;
                description 'The state of OSPF neighbor is Full.' ;
              }

              enum DependUpon {
                value 8 ;
              }

            }

          }

        }

      }

    }

    container interfaces {
      config false ;
      description 'OSPFv3 interfaces.' ;
      container normal-ifs {
        description 'OSPFv3 normal interfaces.' ;
        list normal-if {
          description 'OSPFv3 normal interface.' ;
          key 'proc-id area-ip if-name' ;
          leaf proc-id {
            description 'OSPFv3 process ID.' ;
            type uint32 {
              range 1..65535 ;

            }

          }

          leaf area-ip {
            description 'OSPFv3 area ID in IP address format.' ;
            type ncd:ipv4-address ;

          }

          leaf if-name {
            description 'Interface name.' ;
            type ncd:ifname {
              length 1..31 ;

            }

          }

          leaf if-state {
            description 'State of OSPF interface machine.' ;
            type enumeration {
              enum Down {
                value 1 ;
                description 'This is the initial interface state.' ;
              }

              enum Standby {
                value 2 ;
                description 'In this state, the interface is one of multiple interfaces to a link and this interface is designated Standby and is not sending or receiving control packets.' ;
              }

              enum Loopback {
                value 3 ;
                description "In this state, the router's interface to the network is looped back." ;
              }

              enum Waiting {
                value 4 ;
                description 'In this state, the router is trying to determine the identity of the (Backup) Designated Router for the network.' ;
              }

              enum Point-to-point {
                value 5 ;
                description 'In this state, the interface is operational, and connects either to a physical point-to-point network or to a virtual link.' ;
              }

              enum DROther {
                value 6 ;
                description 'The interface is to a broadcast or NBMA network on which another router has been selected to be the Designated Router.' ;
              }

              enum Backup {
                value 7 ;
                description 'In this state, the router itself is the Backup Designated Router on the attached network.' ;
              }

              enum DR {
                value 8 ;
                description 'In this state, this router itself is the Designated Router on the attached network.' ;
              }

              enum DependUpon {
                value 0 ;
                description 'The depend upon state of interface.' ;
              }

            }

          }

          leaf event {
            description 'Change event of OSPFv3 interface machine.' ;
            type string {
              length 1..31 ;

            }

          }

        }

      }

      container virtual-links {
        description 'OSPFv3 virtual interface.' ;
        list virtual-link {
          description 'OSPFv3 virtual interface.' ;
          key 'proc-id transit-area-ip nbr-id' ;
          leaf proc-id {
            description 'OSPFv3 process ID.' ;
            type uint32 {
              range 1..65535 ;

            }

          }

          leaf transit-area-ip {
            description 'OSPFv3 transit area ip in IP address format.' ;
            type ncd:ipv4-address ;

          }

          leaf nbr-id {
            description 'Router ID of the virtual link neighbor.' ;
            type ncd:ipv4-address ;

          }

          leaf if-state {
            description 'State of OSPF interface machine.' ;
            type enumeration {
              enum Down {
                value 1 ;
                description 'This is the initial interface state.' ;
              }

              enum Standby {
                value 2 ;
                description 'In this state, the interface is one of multiple interfaces to a link and this interface is designated Standby and is not sending or receiving control packets.' ;
              }

              enum Loopback {
                value 3 ;
                description "In this state, the router's interface to the network is looped back." ;
              }

              enum Waiting {
                value 4 ;
                description 'In this state, the router is trying to determine the identity of the (Backup) Designated Router for the network.' ;
              }

              enum Point-to-point {
                value 5 ;
                description 'In this state, the interface is operational, and connects either to a physical point-to-point network or to a virtual link.' ;
              }

              enum DROther {
                value 6 ;
                description 'The interface is to a broadcast or NBMA network on which another router has been selected to be the Designated Router.' ;
              }

              enum Backup {
                value 7 ;
                description 'In this state, the router itself is the Backup Designated Router on the attached network.' ;
              }

              enum DR {
                value 8 ;
                description 'In this state, this router itself is the Designated Router on the attached network.' ;
              }

              enum DependUpon {
                value 0 ;
                description 'The depend upon state of interface.' ;
              }

            }

          }

          leaf event {
            description 'Change event of OSPFv3 interface machine.' ;
            type string {
              length 1..31 ;

            }

          }

        }

      }

    }

    container nbr-flapping {
      config false ;
      description 'OSPFv3 neighbor flapping information.' ;
      container nbrs {
        description 'OSPFv3 neighbor information.' ;
        list nbr {
          description 'OSPFv3 neighbor.' ;
          key 'proc-id area-ip if-name nbr-id' ;
          leaf proc-id {
            description 'OSPFv3 process ID.' ;
            type uint32 {
