                  }

                  leaf metric {
                    description 'nssa range metric' ;
                    type uint32 {
                      range 1..16777214 ;

                    }

                  }

                  leaf tag {
                    description 'nssa range tag' ;
                    type uint32 ;

                  }

                  ncd:revise-date 2020-05-21 ;
                }

              }

              container interfaces {
                description 'OSPFv3 interface configuration.' ;
                list interface {
                  description 'OSPFv3 interface configuration.' ;
