                  range 1..600000 {
                    description 'Hold time for LSA update in milliseconds' ;
                  }

                }

                units millisecond ;
                mandatory true ;
              }

              leaf delay-time {
                description 'Min delay for LSA update in milliseconds' ;
                type uint32 {
                  range 1..600000 {
                    description 'Min delay for LSA update in milliseconds' ;
                  }

                }

                units millisecond ;
                mandatory true ;
              }

              leaf max-delay-time {
                description 'Max delay for LSA update in milliseconds' ;
                type uint32 {
                  range 1..600000 {
                    description 'Max delay for LSA update in milliseconds' ;
                  }

                }

                units millisecond ;
                mandatory true ;
              }

            }

            container lsa-arrival {
              description 'Ospf LSA arrival throttle timers' ;
              presence lsa-arrival ;
