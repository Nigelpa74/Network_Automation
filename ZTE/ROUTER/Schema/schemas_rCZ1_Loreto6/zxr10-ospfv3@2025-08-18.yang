                description 'The state of OSPF neighbor is Full.' ;
              }

              enum DependUpon {
                value 8 ;
              }

            }

          }

        }

      }

      container virtual-nbrs {
        description 'OSPFv3 virtual neighbor.' ;
        list virtual-nbr {
          description 'OSPFv3 virtual neighbor.' ;
          key 'proc-id transit-area-ip neighbor-id' ;
          leaf proc-id {
            description 'OSPFv3 process ID.' ;
            type uint32 {
              range 1..65535 ;

            }

          }

          leaf transit-area-ip {
            description 'OSPFv3 virtual link transit area ID in IP address format.' ;
            type ncd:ipv4-address ;

          }

          leaf neighbor-id {
            description 'Router ID of the neighbor.' ;
            type ncd:ipv4-address ;

          }

          leaf nbr-state {
