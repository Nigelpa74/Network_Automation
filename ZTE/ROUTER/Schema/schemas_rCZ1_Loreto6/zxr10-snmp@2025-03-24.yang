module zxr10-snmp {
  namespace "http://www.zte.com.cn/zxr10/netconf/schema/rosng/snmp" ;
  prefix snmp ;
  yang-version 1 ;
  import zxr10-netconf-defs {
    prefix ncd ;
    revision-date 2021-01-19 ;
  }

  organization "ZTE Corporation" ;
  contact "ZTE Corporation
  Nanjing Institute of ZTE Corporation
  No.68 Zijinghua Rd. Yuhuatai District, Nanjing, China
  Tel: +86-25-52870000" ;
  revision 2025-03-24 {
    description '(1) Add aes192/aes256 enumeration type in /snmp:configuration/snmp:snmp/snmp:global-configuration/snmp:users/snmp:user/snmp:password/snmp:clear-password/snmp:clear-auth/snmp:clear-priv/snmp:priv-type
(2) Add aes192/aes256 enumeration type in /snmp:configuration/snmp:snmp/snmp:global-configuration/snmp:users/snmp:user/snmp:password/snmp:encrypted-password/snmp:encrypted-auth/snmp:encrypted-priv/snmp:priv-type' ;
  }

  revision 2024-04-22 {
    description '(1) Add container named suppress.
path: /configuration/snmp/global-configuration/suppress.' ;
  }

  revision 2024-03-29 {
    description '(1) Add 4 containers named send-policy.
path1: /configuration/snmp/global-configuration/trap/host/trap/public-network/ipv4-hosts/ipv4-host/send-policy.
path2: /configuration/snmp/global-configuration/trap/host/trap/public-network/ipv6-hosts/ipv6-host/send-policy.
path3: /configuration/snmp/global-configuration/trap/host/trap/private-network/ipv4-hosts/ipv4-host/send-policy.
path4: /configuration/snmp/global-configuration/trap/host/trap/private-network/ipv6-hosts/ipv6-host/send-policy.' ;
  }

  revision 2023-01-30 {
    description '(1) Add container groups. path:/configuration/snmp/global-configuration/groups.
(2) Add container users. path:/configuration/snmp/global-configuration/users.
(3) Add container contexts. path:/configuration/snmp/global-configuration/contexts.
(4) Add container engine-id. path:/configuration/snmp/global-configuration/engine-id.
(5) Add feature node snmp-user.' ;
  }

  revision 2022-12-10 {
    description '(1) Add container packetsize. path:/configuration/snmp/global-configuration/packetsize.
(2) Add leaf max-size. path:/configuration/snmp/global-configuration/packetsize/max-size.' ;
  }

  revision 2022-11-14 {
    description '(1) Add all of product labels to feature snmp-trap;(2) Add all of product labels to feature snmp-inform;' ;
  }

  revision 2021-11-11 {
    description '(1) Add container trap-source. path:/configuration/snmp/global-configuration/trap-source.
(2) Add container inform. path:/configuration/snmp/global-configuration/inform.
(3) Add the projects T8000 15K M6000-S supported by feature node "snmp-trap".
(4) Add feature node snmp-inform.' ;
  }

  revision 2021-03-09 {
    description 'Add container trap-source-profiles.' ;
  }

  revision 2021-01-06 {
    description 'Add container oid-views.' ;
  }

  revision 2020-03-25 {
    description 'Modify encrypted community length from 64 to 64-200.' ;
  }

  revision 2018-10-18 {
    description 'Add container get-next-cache.' ;
  }

  revision 2018-06-21 {
    description 'Snmp supports all projects.' ;
  }

  revision 2018-04-11 {
    description 'Add domain-hosts container.' ;
  }

  revision 2018-02-07 {
    description 'Add access list configuration.' ;
  }

  revision 2017-11-01 {
    description 'Intial version' ;
  }

  feature snmp-trap ;

  feature snmp-inform {
    ncd:revise-date 2021-11-11 ;
  }

  feature snmp-user {
    ncd:revise-date 2023-01-30 ;
  }

  container configuration {
    description 'Configuration model.' ;
    container snmp {
      description 'SNMP configuration model.' ;
      container global-configuration {
        description 'SNMP global configuration model.' ;
        container inform {
          description 'Inform related information.' ;
          container enable-inform {
            if-feature snmp-inform ;

            description 'Inform switch.' ;
            presence enable-tinform ;
            list enable-inform-list {
              description 'Inform switch table.' ;
              key inform-bits ;
              leaf inform-bits {
                description 'Enable SNMP inform.' ;
                type enumeration {
                  enum snmp {
                    value 1 ;
                  }

                  enum bgp {
                    value 2 ;
                  }

                  enum mac {
                    value 3 ;
                  }

                  enum ospf {
                    value 4 ;
                  }

                  enum stp {
                    value 5 ;
                  }

                  enum ppp {
                    value 6 ;
                  }

                  enum arp {
                    value 7 ;
                  }

                  enum rmon {
                    value 8 ;
                  }

                  enum udld {
                    value 9 ;
                  }

                  enum cfm {
                    value 10 ;
                  }

                  enum efm {
                    value 11 ;
                  }

                  enum lacp {
                    value 12 ;
                  }

                  enum mc-elam {
                    value 13 ;
                  }

                  enum tcp {
                    value 14 ;
                  }

                  enum sctp {
                    value 15 ;
                  }

                  enum stalarm {
                    value 16 ;
                  }

                  enum cps {
                    value 17 ;
                  }

                  enum interface {
                    value 18 ;
                  }

                  enum acl {
                    value 19 ;
                  }

                  enum fib {
                    value 20 ;
                  }

                  enum pim {
                    value 21 ;
                  }

                  enum isis {
                    value 22 ;
                  }

                  enum rip {
                    value 23 ;
                  }

                  enum msdp {
                    value 24 ;
                  }

                  enum aps {
                    value 25 ;
                  }

                  enum config {
                    value 26 ;
                  }

                  enum am {
                    value 27 ;
                  }

                  enum um {
                    value 28 ;
                  }

                  enum system {
                    value 29 ;
                  }

                  enum ldp {
                    value 30 ;
                  }

                  enum pwe3 {
                    value 31 ;
                  }

                  enum vpn {
                    value 32 ;
                  }

                  enum mpls-oam {
                    value 33 ;
                  }

                  enum ptp {
                    value 34 ;
                  }

                  enum tunnel-te {
                    value 35 ;
                  }

                  enum radius {
                    value 36 ;
                  }

                  enum dhcp {
                    value 37 ;
                  }

                  enum bfd {
                    value 38 ;
                  }

                  enum ippool {
                    value 39 ;
                  }

                  enum ntp {
                    value 40 ;
                  }

                  enum ssm {
                    value 41 ;
                  }

                  enum sqa {
                    value 42 ;
                  }

                  enum ipsec {
                    value 43 ;
                  }

                  enum cgn {
                    value 44 ;
                  }

                  enum vrrp {
                    value 45 ;
                  }

                  enum ftp_tftp {
                    value 46 ;
                  }

                  enum ping-trace {
                    value 47 ;
                  }

                  enum gm {
                    value 48 ;
                  }

                }

              }

            }

          }

          container host {
            description 'Specify hosts to receive SNMP inform.' ;
            container inform {
              description 'Host information to receive INFORM.' ;
              container public-network {
                description 'Configure the host address as the public network address.' ;
                container ipv4-hosts {
                  if-feature snmp-inform ;

                  description 'The configuration to receive inform of the host address is IPv4.' ;
                  list ipv4-host {
                    description 'The host address configured to receive informs is the list of hosts for IPv4.(Note: at least one of the 48 module types is configured, otherwise the function does not work.)' ;
                    key 'ipv4-addr community-or-user' ;
                    leaf ipv4-addr {
                      description 'Configure IPv4 address.' ;
                      type ncd:ipv4-address-none-zero ;

                    }

                    leaf community-or-user {
                      description 'SNMP v2c community string or SNMPv3 user name (1-32 characters).' ;
                      type string {
                        length 1..32 ;

                      }

                    }

                    choice version {
                      description 'SNMP version to use for inform messages.' ;
                      mandatory true ;
                      case version2 {
                        description 'Use SNMPv2c.' ;
                        leaf SNMPv2c {
                          description 'Use SNMPv2c.' ;
                          type empty ;

                          mandatory true ;
                        }

                      }

                      case version3 {
                        description 'Use SNMPv3.' ;
                        leaf SNMPv3 {
                          description 'Use SNMPv3.' ;
                          type empty ;

                          mandatory true ;
                        }

                        leaf security-level {
                          description 'Configure the security level of inform.' ;
                          type enumeration {
                            enum noauth {
                              value 1 ;
                            }

                            enum auth {
                              value 2 ;
                            }

                            enum priv {
                              value 3 ;
                            }

                          }

                          mandatory true ;
                        }

                      }

                    }

                    leaf timeout {
                      description 'Timeout.' ;
                      type uint32 {
                        range 100..3000 ;

                      }

                      units 10ms ;
                    }

                    leaf retry-count {
                      description 'The number of retransmission.' ;
                      type uint16 {
                        range 0..255 ;

                      }

                    }

                    leaf engine-id {
                      description 'Engine ID.' ;
                      type string {
                        length 10..64 ;

                      }

                    }

                    leaf udp-port {
                      description "The inform host's UDP port number." ;
                      type uint32 {
                        range 1..65535 ;

                      }

                      default 162 ;
                    }

                    leaf snmp {
                      description 'Allow SNMP-type informs.' ;
                      type empty ;

                    }

                    leaf bgp {
                      description 'Allow BGP-type informs.' ;
                      type empty ;

                    }

                    leaf mac {
                      description 'Allow MAC-type informs.' ;
                      type empty ;

                    }

                    leaf ospf {
                      description 'Allow OSPF-type informs.' ;
                      type empty ;

                    }

                    leaf stp {
                      description 'Allow STP-type informs.' ;
                      type empty ;

                    }

                    leaf ppp {
                      description 'Allow PPP-type informs.' ;
                      type empty ;

