                      description 'Allow APS-type traps.' ;
                      type empty ;

                    }

                    leaf config {
                      description 'Allow CONFIG-type traps.' ;
                      type empty ;

                    }

                    leaf am {
                      description 'Allow AM-type traps.' ;
                      type empty ;

                    }

                    leaf um {
                      description 'Allow UM-type traps.' ;
                      type empty ;

                    }

                    leaf system {
                      description 'Allow SYSTEM-type traps.' ;
                      type empty ;

                    }

                    leaf ldp {
                      description 'Allow LDP-type traps.' ;
                      type empty ;

                    }

                    leaf pwe3 {
                      description 'Allow PWE3-type traps.' ;
                      type empty ;

                    }

                    leaf vpn {
                      description 'Allow VPN-type traps.' ;
                      type empty ;

                    }

                    leaf mpls-oam {
                      description 'Allow MPLS-OAM-type traps.' ;
                      type empty ;

                    }

                    leaf ptp {
                      description 'Allow PTP-type traps.' ;
                      type empty ;

                    }

                    leaf tunnel-te {
                      description 'Allow TUNNEL-TE-type traps.' ;
                      type empty ;

                    }

                    leaf radius {
                      description 'Allow RADIUS-type traps.' ;
                      type empty ;

                    }

                    leaf dhcp {
                      description 'Allow DHCP-type traps.' ;
                      type empty ;

                    }

                    leaf bfd {
                      description 'Allow BFD-type traps.' ;
                      type empty ;

                    }

                    leaf ippool {
                      description 'Allow IPPOOL-type traps.' ;
                      type empty ;

                    }

                    leaf ntp {
                      description 'Allow NTP-type traps.' ;
                      type empty ;

                    }

                    leaf ssm {
                      description 'Allow SSM-type traps.' ;
                      type empty ;

                    }

                    leaf sqa {
                      description 'Allow SQA-type traps.' ;
                      type empty ;

                    }

                    leaf ipsec {
                      description 'Allow IPSEC-type traps.' ;
                      type empty ;

                    }

                    leaf cgn {
                      description 'Allow CGN-type traps.' ;
                      type empty ;

                    }

                    leaf vrrp {
                      description 'Allow VRRP-type traps.' ;
                      type empty ;

                    }

                    leaf ftp_tftp {
                      description 'Allow FTP-TFTP-type traps.' ;
                      type empty ;

                    }

                    leaf ping-trace {
                      description 'Allow PING-TRACE-type traps.' ;
                      type empty ;

                    }

                    leaf gm {
                      description 'Allow GM-type traps.' ;
                      type empty ;

                    }

                  }

                  ncd:revise-date 2018-04-11 ;
                }

              }

            }

          }

        }

        container community {
          description 'Configure community information.' ;
          container clear-communitys {
            description 'Configure clear community information.' ;
            list clear-community {
              description 'Configure clear community information table.' ;
              key name ;
              leaf name {
                description 'Configure clear community.' ;
                type string {
                  length 1..32 ;

                }

              }

              leaf view-name {
                description 'Configure view name associated with community.' ;
                type string {
                  length 1..32 ;

                }

                default DefaultView ;
              }

              leaf access {
                description 'Configure the read and write permissions of the community.' ;
                type enumeration {
                  enum read-only {
                    value 1 ;
                  }

                  enum read-write {
                    value 2 ;
                  }

                }

                default read-only ;
              }

              leaf show-clear {
                description 'Configure whether show the clear community.' ;
                type empty ;

              }

              leaf ipv4-acl {
                description 'Configure IPv4 ACL name associated with community.' ;
                type string {
                  length 1..31 ;

                }

              }

              leaf ipv6-acl {
                description 'Configure IPv6 ACL name associated with community.' ;
                type string {
                  length 1..31 ;

                }

              }

            }

          }

          container encrypted-communitys {
            description 'Configure encrypted community information.' ;
            list encrypted-community {
              description 'Configure encrypted community information table.' ;
              key name ;
              leaf name {
                description 'Configure encrypted community.' ;
                type string {
                  length 64..200 ;

                }

              }

              leaf view-name {
                description 'Configure view name associated with community.' ;
                type string {
                  length 1..32 ;

                }

                default DefaultView ;
              }

              leaf access {
                description 'Configure the read and write permissions of the community.' ;
                type enumeration {
                  enum read-only {
                    value 1 ;
                  }

                  enum read-write {
                    value 2 ;
                  }

                }

                default read-only ;
              }

              leaf ipv4-acl {
                description 'Configure IPv4 ACL name associated with community.' ;
                type string {
                  length 1..31 ;

                }

              }

              leaf ipv6-acl {
                description 'Configure IPv6 ACL name associated with community.' ;
                type string {
                  length 1..31 ;

                }

              }

            }

          }

        }

        container version {
          description 'Configure the SNMP version' ;
          leaf v1 {
            description 'Configure the SNMPv1 version.' ;
            type empty ;

          }

          leaf v2c {
            description 'Configure the SNMPv2c version.' ;
            type empty ;

          }

          leaf v3 {
            description 'Configure the SNMPv3 version.' ;
            type empty ;

          }

          leaf listen-port {
            description 'Configure the listen port.' ;
            type uint16 {
              range "161 | 1024..20000" ;

            }

            default 161 ;
          }

        }

        container views {
          description 'Configure the view list.' ;
          list view {
            description 'view list' ;
            key 'name subtree-oid' ;
            leaf name {
              description 'view name' ;
              type string {
                length 1..32 ;

              }

            }

            leaf subtree-oid {
              description 'The oid of subtree' ;
              type string {
                length 1..79 ;

                pattern "([^.]*)" ;

              }

            }

            leaf type {
              description 'type:included or excluded' ;
              type enumeration {
                enum included {
                  value 1 ;
                }

                enum excluded {
                  value 2 ;
                }

              }

              mandatory true ;
            }

          }

        }

        container access-list {
          description 'Configure access list' ;
          container ipv6-acl {
            description 'Configure IPv6 ACL' ;
            leaf name {
              description 'Configure an IPv6-type ACL to control the SNMP protocol to access the host.' ;
              type string {
                length 1..31 ;

              }

            }

          }

          container ipv4-acl {
            description 'Configure IPv4 ACL' ;
            leaf name {
              description 'Configure an IPv4-type ACL to control the SNMP protocol to access the host.' ;
              type string {
                length 1..31 ;

              }

            }

          }

          ncd:revise-date 2018-02-07 ;
        }

        container get-next-cache {
          description 'Configure SNMP get-next cache aging time.' ;
          presence get-next-cache ;
          leaf age-time {
            description 'Set cache aging time. Valid range is 1~30 seconds.' ;
            type uint8 {
              range 1..30 ;

            }

            mandatory true ;
          }

          ncd:revise-date 2018-10-18 ;
        }

        container oid-views {
          description '1. Configuration view. Only the OID mode is supported.
2. If this command and the views node are configured at the same time, first check whether the packet OID matches the OID of the current view. If yes, the rights are subject to this command. If not, the rights are subject to the views node.
3. The OID name is not unique. One name can correspond to multiple OIDs. If you want to exclude or contain an OID and the views node cannot be controlled, configure this node. For other scenarios, views node is recommended because the OID name is more explicit.' ;
          list oid-view {
            description 'View table.' ;
            key 'name subtree-oid' ;
            leaf name {
              description 'View name. The default view names AllView and DefaultView cannot be configured.' ;
              type string {
                length 1..32 ;

              }

            }

            leaf subtree-oid {
              description 'View subtree. Only the OID can be configured.' ;
              type string {
                length 1..250 ;

              }

            }

            leaf type {
              description 'Subtree type of the view. Options: Include and Exclude.' ;
              type enumeration {
                enum included {
                  value 1 ;
                }

                enum excluded {
                  value 2 ;
                }

              }

              mandatory true ;
            }

          }

          ncd:revise-date 2021-01-06 ;
        }

        container trap-source-profiles {
          description 'Application Scenario
1. This command needs to be configured only when it is necessary to specify a different source address for each NM or a different agent address for each NM SNMP v1 version trap. Otherwise, the global source address command (snmp-server trap-source) is used to configure the source address of trap or the agent address of SNMP v1 trap.

Precautions
1. When the NM IP address and vrf name exist in this table, the global source address command is ignored. If there are multiple policies with the same IP address and VRF name, the first policy is selected in ascending order.

2. If this command is used to associate an interface, if the interface fails to obtain the IPv4 or IPv6 address (the address type is the same as that of the NM), the source address is specified by the transmission protocol. The agent address in SNMP v1 trap is not specified.
3. When the NM address is of the IPv4 type, the agent address needs to be specified in SNMP v1 trap. When the NM address is IPv6, the agent address does not need to be specified.
4. A maximum of 2048 policies can be configured.' ;
          list trap-source-profile {
            description 'Trap source address profile table.' ;
            key name ;
            leaf name {
              description 'Profile name.' ;
              type string {
                length 1..32 ;

              }

            }

            choice host {
              description 'Configures the host address.' ;
              case host-ipv4 {
                description 'Configure the IPv4 address and VRF name of the NM.' ;
                container host-ipv4 {
                  description 'Configure the IPv4 address and VRF name of the NM.' ;
                  leaf vrf-name {
                    description 'VRF name.' ;
                    type string {
                      length 1..32 ;

                    }

                  }

                  leaf ip-address {
                    description 'Configure the IPv4 address.' ;
                    type ncd:ipv4-address-none-zero ;

                    mandatory true ;
                  }

                }

              }

              case host-ipv6 {
                description 'Configure the NM IPv6 address.' ;
                container host-ipv6 {
                  description 'Configure the IPv6 address and VRF name of the NM.' ;
                  leaf vrf-name {
                    description 'VRF name.' ;
                    type string {
                      length 1..32 ;

                    }

                  }

                  leaf ip-address {
                    description 'Configure the IPv6 address.' ;
                    type ncd:ipv6-address-none-zero ;

                    mandatory true ;
                  }

                }

              }

            }

            choice source {
              description 'Configure the trap source address.' ;
              mandatory true ;
              case source-ipv4 {
                description 'Configure the source address: IPv4.' ;
                leaf source-ipv4 {
                  description 'Configure the source address: IPv4.' ;
                  type ncd:ipv4-address-none-zero ;

                }

              }

              case source-ipv6 {
                description 'Configure the source address: IPv6.' ;
                leaf source-ipv6 {
                  description 'Configure the source address: IPv6.' ;
                  type ncd:ipv6-address-none-zero ;

                }

              }

              case source-interface {
                description 'Configure the source interface.' ;
                leaf source-interface {
                  description 'Configure the source interface.' ;
                  type ncd:ifname ;

                }

              }

            }

          }

          ncd:revise-date 2021-03-09 ;
        }

        container trap-source {
          description 'Specify the source address of SNMP trap.' ;
          leaf source-ipv4 {
            description 'Configure the source address: IPv4.' ;
            type ncd:ipv4-address-none-zero ;

          }

          leaf source-ipv6 {
            description 'Configure the source address: IPv6.' ;
            type ncd:ipv6-address-none-zero ;

          }

          leaf source-interface {
            description 'Configure the source interface.' ;
            type ncd:ifname ;

          }

          ncd:revise-date 2021-11-11 ;
        }

        container packet-size {
          description 'Set the maximum length of SNMP organization message.' ;
          leaf max-size {
            description 'Set the maximum length of the organization message. Valid range: 484-61440, unit: byte.' ;
            type uint32 {
              range 484..61440 ;

            }

            units byte ;
            default 8192 ;
          }

          ncd:revise-date 2022-12-10 ;
        }

        container groups {
          description 'Configure group information.' ;
          list group-context {
            description 'Configure group information list.' ;
            key 'group-name security-level context-name' ;
            leaf group-name {
              description 'Name of the group' ;
              type string {
                length 1..32 ;

              }

            }

            leaf security-level {
              description 'Security level of the group' ;
              type enumeration {
                enum noauth {
                  value 1 ;
                  description 'Group using the no-auth-no-priv security level.' ;
                }

                enum auth {
                  value 2 ;
                  description 'Group using the auth-no-priv security level.' ;
                }

                enum priv {
                  value 3 ;
                  description 'Group using SNMPv3 auth-priv security level' ;
                }

              }

            }

            leaf context-name {
              description 'Snmp group context name' ;
              type string {
                length 1..30 ;

              }

            }

            choice match {
              description 'Snmp server group match choice' ;
              mandatory true ;
              case exact {
                leaf match-exact {
                  description 'Exactly match context name' ;
                  type empty ;

                }

              }

              case prefix {
                leaf match-prefix {
                  description 'Match context name prefix' ;
                  type empty ;

                }

              }

            }

            leaf read-view {
              description 'Specify a read view for the group' ;
              type string {
                length 1..32 ;

              }

            }

            leaf write-view {
              description 'Specify a write view for the group' ;
              type string {
                length 1..32 ;

              }

            }

            leaf notify-view {
              description 'Specify a notify view for the group' ;
              type string {
                length 1..32 ;

              }

            }

          }

          list group {
            description 'Configure group information list with no context.' ;
            key 'group-name security-level' ;
            leaf group-name {
              description 'Name of the group' ;
              type string {
                length 1..32 ;

              }

            }

            leaf security-level {
              description 'Security level of the group' ;
              type enumeration {
                enum noauth {
                  value 1 ;
                  description 'Group using the no-auth-no-priv security level.' ;
                }

                enum auth {
                  value 2 ;
                  description 'Group using the auth-no-priv security level.' ;
                }

                enum priv {
                  value 3 ;
                  description 'Group using SNMPv3 auth-priv security level' ;
                }

              }

            }

            leaf read-view {
              description 'Specify a read view for the group' ;
              type string {
                length 1..32 ;

              }

            }

            leaf write-view {
              description 'Specify a write view for the group' ;
              type string {
                length 1..32 ;

              }

            }

            leaf notify-view {
              description 'Specify a notify view for the group' ;
              type string {
                length 1..32 ;

              }

            }

          }

          ncd:revise-date 2023-01-30 ;
        }

        container users {
          if-feature snmp-user ;

          description 'Configuring SNMPv3 User Information' ;
          list user {
            description 'User table' ;
            key user-name ;
            leaf user-name {
              description 'username of SNMP' ;
              type string {
                length 1..32 ;

              }

            }

            leaf group-name {
              description 'group name associated with the user' ;
              type string {
                length 1..32 ;

              }

              mandatory true ;
            }

            choice password {
              description 'user password of SNMP' ;
              case clear-password {
                description 'Plaintext password, including the authentication and encryption passwords. If the plaintext password is configured, a ciphertext password will be generated. Please operate the ciphertext password branch if remove authentication or encryption passwords are required' ;
                container clear-auth {
                  description 'configure plaintext authentication or encryption passwords' ;
                  presence clear-auth ;
                  leaf auth-type {
                    description 'authentication type' ;
                    type enumeration {
                      enum md5 {
                        value 1 ;
                      }

                      enum sha {
                        value 2 ;
                      }

                      enum sha256 {
                        value 4 ;
                      }

                      enum sha384 {
                        value 5 ;
                      }

                      enum sha512 {
                        value 6 ;
                      }

                    }

                    mandatory true ;
                  }

                  leaf auth-password {
                    description 'plaintext authentication password' ;
                    type string {
                      length 1..128 ;

                    }

                    mandatory true ;
                  }

                  container clear-priv {
                    description 'configure a plaintext encryption password' ;
                    presence clear-priv ;
                    leaf priv-type {
                      description 'encryption type' ;
                      type enumeration {
                        enum des56 {
                          value 6 ;
                        }

                        enum aes128 {
                          value 8 ;
                        }

                        enum aes192 {
                          value 9 ;
                        }

                        enum aes256 {
                          value 10 ;
                        }

                      }

                      mandatory true ;
                    }

                    leaf priv-password {
                      description 'plaintext encrypted password' ;
                      type string {
                        length 1..128 ;

                      }

                      mandatory true ;
                    }

                  }

                }

              }

              case encrypted-password {
                description 'ciphertext password' ;
                container encrypted-auth {
                  description 'configure ciphertext authentication or encryption passwords' ;
                  presence encrypted-auth ;
                  leaf auth-type {
                    description 'authentication type' ;
                    type enumeration {
                      enum md5 {
                        value 1 ;
                      }

                      enum sha {
                        value 2 ;
                      }

                      enum sha256 {
                        value 4 ;
                      }

                      enum sha384 {
                        value 5 ;
                      }

                      enum sha512 {
                        value 6 ;
                      }

                    }

                    mandatory true ;
                  }

                  leaf auth-password {
                    description 'ciphertext authentication password' ;
                    type string {
                      length 32..200 ;

                    }

                    mandatory true ;
                  }

                  container encrypted-priv {
                    description 'configure a ciphertext encryption password' ;
                    presence encrypted-priv ;
                    leaf priv-type {
                      description 'encryption type' ;
                      type enumeration {
                        enum des56 {
                          value 6 ;
                        }

                        enum aes128 {
                          value 8 ;
                        }

                        enum aes192 {
                          value 9 ;
                        }

                        enum aes256 {
                          value 10 ;
                        }

                      }

                      mandatory true ;
                    }

                    leaf priv-password {
                      description 'ciphertext encrypted password' ;
                      type string {
                        length 32..200 ;

                      }

                      mandatory true ;
                    }

                  }

                }

              }

            }

          }

          ncd:revise-date 2023-01-30 ;
        }

        container contexts {
          description 'Configure the name of SNMP context.' ;
          list context {
            description 'Configure the name of SNMP context.The maximum number of configurations is 50.' ;
            key name ;
            max-elements 50 ;
            leaf name {
              description 'SNMP context name.' ;
              type string {
                length 1..30 ;

              }

            }

          }

          ncd:revise-date 2023-01-30 ;
        }

        container engine-id {
          description 'Configure the engine id of SNMP.' ;
          leaf engine-id {
            description 'The engine id of SNMP.There is a default value for the engine id, but the default values are different for different devices.' ;
            type string {
              length 1..24 ;

            }

          }

          ncd:revise-date 2023-01-30 ;
        }

        container suppress {
          leaf authen-failure-alarm {
            type enumeration {
              enum enable {
                value 1 ;
                description 'Enable authentication-failure-alarm suppression.' ;
              }

              enum disable {
                value 2 ;
                description 'Disable authentication-failure-alarm suppression.' ;
              }

            }

            description 'Configure authentication-failure-alarm suppression switch.' ;
            default enable ;
          }

          description 'Configure suppression policy.' ;
          ncd:revise-date 2024-04-22 ;
        }

      }

    }

  }

}
