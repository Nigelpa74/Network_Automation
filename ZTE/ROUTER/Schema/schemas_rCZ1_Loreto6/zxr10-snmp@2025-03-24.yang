                      type empty ;

                    }

                    leaf sqa {
                      description 'Allow SQA-type informs.' ;
                      type empty ;

                    }

                    leaf ipsec {
                      description 'Allow IPSEC-type informs.' ;
                      type empty ;

                    }

                    leaf cgn {
                      description 'Allow CGN-type informs.' ;
                      type empty ;

                    }

                    leaf vrrp {
                      description 'Allow VRRP-type informs.' ;
                      type empty ;

                    }

                    leaf ftp_tftp {
                      description 'Allow FTP-TFTP-type informs.' ;
                      type empty ;

                    }

                    leaf ping-trace {
                      description 'Allow PING-TRACE-type informs.' ;
                      type empty ;

                    }

                    leaf gm {
                      description 'Allow GM-type informs.' ;
                      type empty ;

                    }

                  }

                }

                container ipv6-hosts {
                  if-feature snmp-inform ;

                  description 'The configuration to receive inform of the host address is IPv6.' ;
                  list ipv6-host {
                    description 'The host address configured to receive informs is the list of hosts for IPv6.(Note: at least one of the 48 module types is configured, otherwise the function does not work.)' ;
                    key 'ipv6-addr community-or-user' ;
                    leaf ipv6-addr {
                      description 'Configure IPv6 address.' ;
                      type ncd:ipv6-address ;

                    }

                    leaf community-or-user {
                      description 'SNMP v2c community string or SNMPv3 user name (1-32 characters).' ;
                      type string {
                        length 1..32 ;

                      }

                    }

                    choice version {
                      description 'SNMP version to use for trap messages.' ;
                      mandatory true ;
                      case version2c {
                        description 'Use SNMPv2c.' ;
                        leaf SNMPv2c {
                          description 'Use SNMPv2c.' ;
                          type empty ;

