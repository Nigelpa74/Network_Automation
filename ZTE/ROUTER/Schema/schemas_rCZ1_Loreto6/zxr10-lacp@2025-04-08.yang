      container peer-link {
        description 'Describe the peer-link interface to be configured.' ;
        leaf interface-name {
          description 'The interface name of peer-link.' ;
          type ncd:ifname ;

        }

        leaf auto-mapping-vxlan {
          description 'Auto mapping VXLAN.' ;
          type empty ;

          if-feature auto-mapping-vxlan ;

          ncd:revise-date 2023-08-03 ;
        }

        ncd:revise-date 2017-07-12 ;
      }

    }

  }

  container state {
    config false ;
    description 'Describe the state of Link Aggregation Control Protocol.' ;
    container lacp {
      description 'Describe the state of LACP.' ;
      list smartgroup {
        description 'Describe the state of smartgroup.' ;
        key interface-name ;
        leaf interface-name {
          description 'The interface name of smartgroup.' ;
          type ncd:ifname ;

        }

        leaf mac {
          description 'The MAC of smartgroup.' ;
          type ncd:mac-address ;

        }

        leaf enable-mclag {
          description 'Is MC-LAG enabled by smartgroup.' ;
          type enumeration {
            enum enable {
              value 1 ;
              description 'The smartgroup has enabled MC-LAG.' ;
            }

            enum disable {
              value 2 ;
              description 'The smartgroup has not enabled MC-LAG.' ;
            }

          }

        }

        leaf protect-state {
          description 'The protect state of smartgroup.' ;
          type enumeration {
            enum "non-m/s-relation" {
              value 0 ;
              description 'Non master/slave relation.' ;
            }

            enum "m/s-relation" {
              value 1 ;
              description 'Master/slave relation.' ;
            }

            enum waiting-recovery {
              value 2 ;
              description 'Waiting for recovery.' ;
            }

            enum non-recovery {
              value 3 ;
              description 'Non recovery.' ;
            }

            enum master-signal-failure {
              value 4 ;
              description 'Master signal failure.' ;
            }

            enum slave-signal-failure {
              value 5 ;
              description 'Slave signal failure.' ;
            }

          }

          ncd:revise-date 2018-01-08 ;
        }

      }

      list port {
        description 'Describe the state of member port.' ;
        key interface-name ;
        leaf interface-name {
          description 'The interface name of member port.' ;
          type ncd:ifname ;

        }

        leaf smartgroup-id {
          description 'The group id bound by member port.' ;
          type uint32 ;

        }

        leaf actor-oper-key {
          description 'The actor operate key of member port.' ;
          type uint32 ;

        }

        leaf actor-oper-state {
          description 'The actor operate state of member port.' ;
          type uint32 ;

        }

        leaf partner-oper-key {
          description 'The partner operate key of member port.' ;
          type uint32 ;

        }

        leaf partner-oper-state {
          description 'The partner operate state of member port.' ;
          type uint32 ;

        }

        leaf partner-port-priority {
          description 'The partner port priority of member port.' ;
          type uint32 ;

        }

        leaf lacp-state {
          description 'The LACP port state of member port. LACP has two port states, active and inactive.' ;
          type enumeration {
            enum inactive {
              value 1 ;
              description 'The LACP port state is inactive.' ;
            }

            enum active {
              value 2 ;
              description 'The LACP port state is active.' ;
            }

          }

        }

        leaf partner-system-priority {
          description 'The partner system priority of member port.' ;
          type uint32 ;

        }

        leaf partner-system-mac {
          description 'The partner system MAC of member port.' ;
          type ncd:mac-address ;

        }

      }

      list mclag {
        description 'Describe the state of MC-LAG.' ;
        key interface-name ;
        leaf interface-name {
          description 'The interface name of smartgroup.' ;
          type ncd:ifname ;

        }

        leaf actor-roid {
          description 'The actor roid of MC-LAG.' ;
          type uint64 ;

          ncd:revise-date 2020-06-30 ;
        }

        leaf actor-node-id {
          description 'The actor node id of MC-LAG.' ;
          type uint32 ;

          ncd:revise-date 2020-06-30 ;
        }

        leaf actor-back-up {
          description 'The actor backup attribute of MC-LAG.' ;
          type enumeration {
            enum disable {
              value 1 ;
              description 'The MC-LAG actor has not configured backup attribute.' ;
            }

            enum enable {
              value 2 ;
              description 'The MC-LAG actor has configured backup attribute.' ;
            }

          }

        }

        leaf partner-system-mac {
          description 'The partner system MAC of MC-LAG.' ;
          type ncd:mac-address ;

        }

        leaf partner-system-priority {
          description 'The partner system priority of MC-LAG.' ;
          type uint32 ;

        }

        leaf partner-priority {
          description 'The partner priority of MC-LAG.' ;
          type uint32 ;

        }

        leaf partner-roid {
          description 'The partner roid of MC-LAG.' ;
          type uint64 ;

        }

        leaf parnter-node-id {
          description 'The partner node id of MC-LAG.' ;
          type uint32 ;

        }

        leaf work-mode {
          description 'The work mode of MC-LAG. Only the smartgroup with 802.3ad is effective.' ;
          type enumeration {
            enum none {
              value 0 ;
              description 'None mode' ;
            }

            enum auto {
              value 1 ;
              description 'Auto mode' ;
            }

            enum force-master {
              value 2 ;
              description 'Force-master mode' ;
            }

            enum force-backup {
              value 3 ;
              description 'Force-backup mode' ;
            }

            enum na {
              value 4 ;
              description 'Invalid mode' ;
            }

          }

          ncd:revise-date 2018-11-20 ;
        }

        leaf state {
          description 'The state of MC-LAG.' ;
          type enumeration {
            enum none {
              value 0 ;
              description 'The MC-LAG has not been established.' ;
            }

            enum ms {
              value 1 ;
              description 'The MC-LAG is in master and slave state.' ;
            }

            enum ms-nonRevertive {
              value 2 ;
              description 'The MC-LAG is in master and slave state, but cannot be revertive.' ;
            }

            enum ms-wtr {
              value 3 ;
              description 'The MC-LAG is in master and slave state, and is waiting for recovery.' ;
            }

            enum ms-continueToWtr {
              value 4 ;
              description 'The MC-LAG is in master and slave state, but needs to continue to wait for recovery.' ;
            }

            enum ms-manualSwitch {
              value 5 ;
              description 'The MC-LAG is in master and slave state, but is also in manual switch state.' ;
            }

            enum load-sharing {
              value 6 ;
              description 'The MC-LAG is in load-sharing state.' ;
            }

            enum abnormal {
              value 7 ;
              description 'The MC-LAG is in abnormal state.' ;
            }

            enum peer-unknown {
              value 8 ;
              description 'The MC-LAG is interrupted and cannot get peer information.' ;
            }

          }

          ncd:revise-date 2018-11-20 ;
        }

        leaf actor-smartgroup-state {
          description 'The actor smartgroup state of MC-LAG.' ;
          type enumeration {
            enum down {
              value 0 ;
              description 'The state is down.' ;
            }

            enum up {
              value 1 ;
              description 'The state is up.' ;
            }

          }

          ncd:revise-date 2018-11-20 ;
        }

        leaf partner-smartgroup-state {
          description 'The partner smartgroup state of MC-LAG.' ;
          type enumeration {
            enum down {
              value 0 ;
              description 'The state is down.' ;
            }

            enum up {
              value 1 ;
              description 'The state is up.' ;
            }

            enum unknown {
              value 2 ;
              description 'The state is unknown.' ;
            }

          }

          ncd:revise-date 2018-11-20 ;
        }

      }

      list member {
        description 'Describe the member port information of smartgroup.' ;
        key interface-name ;
        leaf interface-name {
          description 'The interface name of smartgroup.' ;
          type ncd:ifname ;

        }

        container ports {
          description 'Describe the information of member port.' ;
          list port {
            description 'Describe the information of member port.' ;
            key port-name ;
            leaf port-name {
              description 'The interface name of member port.' ;
              type ncd:ifname ;

            }

            leaf port-state {
              description 'The state of member port. LACP has two port states, active and inactive.' ;
              type enumeration {
                enum inactive {
                  value 1 ;
                  description 'The LACP port state is inactive.' ;
                }

                enum active {
                  value 2 ;
                  description 'The LACP port state is active.' ;
                }

              }

            }

            leaf port-mode {
              description 'The mode of member port.' ;
              type enumeration {
                enum passive {
                  value 1 ;
                  description 'The port mode is passive.' ;
                }

                enum on {
                  value 2 ;
                  description 'The port mode is on.' ;
                }

                enum active {
                  value 3 ;
                  description 'The port mode is active.' ;
                }

              }

              ncd:revise-date 2021-07-16 ;
            }

            leaf ptx-state {
              description 'The periodic transmission machine state of member port.' ;
              type enumeration {
                enum no-periodic {
                  value 1 ;
                  description 'Periodic transmissions are disabled.' ;
                }

                enum fast-periodic {
                  value 2 ;
                  description 'Periodic transmissions are enabled at a fast transmission rate.' ;
                }

                enum slow-periodic {
                  value 3 ;
                  description 'Periodic transmissions are enabled at a slow transmission rate.' ;
                }

                enum periodic-tx {
                  value 4 ;
                  description 'Transitory state entered on periodic timer expiry.' ;
                }

              }

              ncd:revise-date 2021-07-16 ;
            }

            leaf agg-state {
              description 'The aggregation state of member port.' ;
              type enumeration {
                enum active {
                  value 0 ;
                  description 'The LACP port aggregation state is active.' ;
                }

                enum inactive {
                  value 1 ;
                  description 'The LACP port aggregation state is inactive.' ;
                }

                enum loop {
                  value 2 ;
                  description 'The LACP port aggregation state is loop.' ;
                }

              }

              ncd:revise-date 2021-07-16 ;
            }

            leaf periodic-time {
              description 'The number of seconds between periodic transmissions of member port.' ;
              type uint16 ;

              units second ;
              ncd:revise-date 2021-07-16 ;
            }

            leaf port-priority {
              description 'The port priority of member port.' ;
              type uint16 ;

              ncd:revise-date 2021-07-16 ;
            }

            leaf oper-key {
              description 'The operational key of member port.' ;
              type uint16 ;

              ncd:revise-date 2021-07-16 ;
            }

            leaf oper-state {
              description 'The operational state of member port.' ;
              type uint8 ;

              ncd:revise-date 2021-07-16 ;
            }

            leaf rx-state {
              description 'The receive machine state of member port.' ;
              type enumeration {
                enum initialize {
                  value 1 ;
                  description 'The LACP port receive machine state is initialize.' ;
                }

                enum port-disabled {
                  value 2 ;
                  description 'The LACP port receive machine state is port disabled.' ;
                }

                enum lacp-disabled {
                  value 3 ;
                  description 'The LACP port receive machine state is LACP disabled.' ;
                }

                enum expired {
                  value 4 ;
                  description 'The LACP port receive machine state is expired.' ;
                }

                enum defaulted {
                  value 5 ;
                  description 'The LACP port receive machine state is defaulted.' ;
                }

                enum current {
                  value 6 ;
                  description 'The LACP port receive machine state is current.' ;
                }

              }

              ncd:revise-date 2021-07-16 ;
            }

            leaf mux-state {
              description 'The mux state of member port.' ;
              type enumeration {
                enum detached {
                  value 1 ;
                  description 'The LACP port mux machine state is detached.' ;
                }

                enum waiting {
                  value 2 ;
                  description 'The LACP port mux machine state is waiting.' ;
                }

                enum attached {
                  value 3 ;
                  description 'The LACP port mux machine state is attached.' ;
                }

                enum collecting {
                  value 4 ;
                  description 'The LACP port mux machine state is collecting.' ;
                }

                enum distributing {
                  value 5 ;
                  description 'The LACP port mux machine state is distributing.' ;
                }

                enum collecting-distributing {
                  value 6 ;
                  description 'The LACP port mux machine state is collecting and distributing.' ;
                }

              }

              ncd:revise-date 2021-07-16 ;
            }

          }

        }

        ncd:revise-date 2016-11-16 ;
      }

    }

  }

  container operation {
    config false ;
    description 'Describe the operation of Link Aggregation Control Protocol.' ;
    container lacp {
      description 'Describe the operation of LACP.' ;
      container clear {
        description 'Clear the packet count.' ;
        choice clear-choice {
          description 'Clear the packet count.' ;
          case group-id-case {
            description 'Clear the packet count of smartgroup.' ;
            leaf group-id {
              description 'Clear the packet count of smartgroup, its maximum value depends on the performance parameters.' ;
              type uint32 {
                range 1..99999999 {
                  description 'The maximum value depends on the performance parameters.
The minimum value(the second range) depends on the performance parameters.' ;
                }

              }

            }

          }

          case all-case {
            description 'Clear the packet count of all smartgroups.' ;
            leaf all {
              description 'Clear the packet count of all smartgroups.' ;
              type empty ;

            }

          }

        }

      }

      container forceswitch {
        description 'The force swith operation of smartgroup.' ;
        leaf interface-name {
          description 'The interface name of smartgroup.' ;
          type ncd:ifname ;

        }

      }

    }

  }

}
