  feature lacp-protocol-packet {
    description 'Set the rule of the control plane sending protocol packet for smartgroup.' ;
  }

  feature lacp-fast-respond {
    description 'The fast respond of smartgroup.' ;
  }

  feature mclag-ip-use-global {
    description 'The IP address of MC-LAG uses the IP address configured globally.' ;
  }

  feature auto-mapping-vxlan {
    description 'Auto mapping VXLAN.' ;
    ncd:revise-date 2023-08-03 ;
  }

  feature negotiation-flag {
    ncd:revise-date 2023-09-08 ;
  }

  feature port-selection {
    description 'The port selection of smartgroup.' ;
    ncd:revise-date 2023-12-01 ;
  }

  feature mclag-role-selection-rule {
    description 'The rule of global MC-LAG role selection.' ;
    ncd:revise-date 2024-01-11 ;
  }

  feature monitor-esi-df-election {
    description 'The monitor ESI DF election of smartgroup.' ;
    ncd:revise-date 2024-04-03 ;
  }

  feature lag-bfd-to-satellite {
    description 'Lag Bfd to-satellite' ;
    ncd:revise-date 2024-04-08 ;
  }

  feature mclag-standalone {
    description 'The parameter of MC-LAG standalone to be configured.' ;
    ncd:revise-date 2024-05-13 ;
  }

  feature lacp-load-balance-factor {
    description 'The parameter of LACP load balance factor to be configured.' ;
    ncd:revise-date 2024-08-09 ;
  }

  feature smartgroup-preferred-up {
    description 'The protocol preferred up flag of smartgroup.' ;
    ncd:revise-date 2024-12-09 ;
  }
  
  feature mclag-apply-arp-proxy {
    description 'The parameter of MC-LAG apply ARP proxy to be configured.' ;
    ncd:revise-date 2025-03-27 ;
  }

  feature mclag-apply-nd-proxy {
    description 'The parameter of MC-LAG apply ND proxy to be configured.' ;
    ncd:revise-date 2025-03-27 ;
  }
  
  container configuration {
    description 'Describe the configuration of Link Aggregation Control Protocol.' ;
    container lacp {
      description 'Describe the parameters of LACP to be configured.' ;
      container global {
        description 'Describe the global parameters to be configured.' ;
        leaf system-priority {
          description 'The global system priority. In the case of the smartgroup-priority leaf of smartgroup list is not configured, this value will be used.' ;
          type uint16 {
            range 1..65535 ;

          }

          default 32768 ;
        }

        leaf system-active-number {
          status obsolete {
            ncd:revise-date 2018-12-21 ;
          }

          description 'The global system active number, its maximum value depends on the performance parameters. In the case of the active-number leaf of smartgroup list is not configured, this value will be used.' ;
          type uint32 {
            range 1..1024 {
              description 'The maximum value depends on the performance parameters.' ;
            }

          }

          default 1 ;
        }

        leaf alarm-to-notification {
          description 'The flag that turns alarm to notification, its default value depends on the performance parameters.' ;
          type enumeration {
            enum disable {
              value 0 ;
              description 'Disable the alarm to notification function.' ;
            }

            enum enable {
              value 1 ;
              description 'Enable the alarm to notification function.' ;
            }

          }

          ncd:revise-date 2018-06-12 ;
        }

        leaf service-switch {
          description 'LACP service switch, its default value depends on the performance parameters.' ;
          type enumeration {
            enum disable {
              value 0 ;
              description 'Disable LACP service.' ;
            }

            enum enable {
              value 1 ;
              description 'Enable LACP service.' ;
            }

          }

          ncd:revise-date 2018-07-18 ;
        }

        container mclag {
          description 'Describe the parameters of global MC-LAG to be configured.' ;
          container mclag-backoff {
            description 'Describe the parameters of global MC-LAG backoff to be configured.' ;
            leaf backoff {
              description 'The backoff of global MC-LAG.' ;
              type enumeration {
                enum disable {
                  value 1 ;
                  description 'Disable global MC-LAG backoff .' ;
                }

                enum enable {
                  value 0 ;
                  description 'Enable global MC-LAG backoff.' ;
                }

              }

              default enable ;
            }

            leaf mode {
              description 'The backoff mode of global MC-LAG. Its default value which is between [aggressive,hold] and generally aggressive, depends on product specification.' ;
              type enumeration {
                enum aggressive {
                  value 0 ;
                  description 'The backoff mode of global MC-LAG is aggressive.' ;
                }

                enum hold {
                  value 1 ;
                  description 'The backoff mode of global MC-LAG is hold.' ;
                }

              }

              ncd:revise-date 2021-07-12 ;
            }

          }

          container mclag-ccheck-critical {
            description 'Describe the parameters of global MC-LAG consistency check to be configured.' ;
            presence "critical-type should be mandatory" ;
            leaf critical-type {
              description 'The consistency check type of global MC-LAG is critical.' ;
              type empty ;

              mandatory true ;
            }

            leaf mode {
              description 'The consistency check mode of global MC-LAG.' ;
              type enumeration {
                enum loose {
                  value 0 ;
                  description 'The consistency check mode of global MC-LAG is loose.' ;
                }

                enum strict {
                  value 1 ;
                  description 'The consistency check mode of global MC-LAG is strict.' ;
                }

              }

              default loose ;
            }

          }

