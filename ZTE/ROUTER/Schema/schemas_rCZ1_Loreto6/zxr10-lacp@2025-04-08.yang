                  description 'The IPv4 destination address of MC-LAG.' ;
                  type ncd:ipv4-address ;

                  mandatory true ;
                }

                container vrf {
                  description 'Describe the parameters of MC-LAG VRF name to be configured.' ;
                  choice vrf-choice {
                    description 'The VRF name of MC-LAG.' ;
                    case vrf-name-case {
                      description 'The VRF name of MC-LAG, whose name cannot be mng.' ;
                      leaf vrf-name {
                        description 'The VRF name of MC-LAG, whose name cannot be mng.' ;
                        type string {
                          length 1..32 ;

                        }

                      }

                    }

                    case vrf-mng-case {
                      description 'The VRF mng instance of MC-LAG.' ;
                      leaf vrf-mng {
                        description 'The VRF mng instance of MC-LAG.' ;
                        type empty ;

                      }

                    }

                  }

                }

                ncd:revise-date 2020-06-30 ;
              }

              container mclag-ipv6-address {
                description 'Describe the parameters of MC-LAG IPv6 source and destination address to be configured.' ;
                presence "source-address and destination-address should be mandatory" ;
                leaf source-address {
                  description 'The IPv6 source address of MC-LAG.' ;
                  type ncd:ipv6-address-none-zero ;

                  mandatory true ;
                }

                leaf destination-address {
                  description 'The IPv6 destination address of MC-LAG.' ;
                  type ncd:ipv6-address-none-zero ;

                  mandatory true ;
                }

                container vrf {
                  description 'Describe the parameters of MC-LAG VRF name to be configured.' ;
                  choice vrf-choice {
                    description 'The VRF name of MC-LAG.' ;
                    case vrf-name-case {
                      description 'The VRF name of MC-LAG, whose name cannot be mng.' ;
                      leaf vrf-name {
                        description 'The VRF name of MC-LAG, whose name cannot be mng.' ;
                        type string {
                          length 1..32 ;

                        }

                      }

                    }

                    case vrf-mng-case {
                      description 'The VRF mng instance of MC-LAG.' ;
                      leaf vrf-mng {
                        description 'The VRF mng instance of MC-LAG.' ;
                        type empty ;

                      }

                    }

                  }

                }

                ncd:revise-date 2020-06-30 ;
              }

            }

            leaf port-dispersion {
              description 'The port dispersion switch of smartgroup.' ;
              type enumeration {
                enum off {
                  value 0 ;
                  description 'Close the port dispersion switch.' ;
                }

                enum on {
                  value 1 ;
                  description 'Open the port dispersion switch.' ;
                }

              }

              default off ;
              ncd:revise-date 2016-03-28 ;
            }

            leaf negotiation-flag {
              description 'The negotiation flag of smartgroup.Only the value of bond-mode leaf is 802.3ad can this attribute be configured.' ;
              type uint8 {
                range 0..1 ;

              }

              default 0 ;
              if-feature negotiation-flag ;

              ncd:revise-date 2016-08-25 ;
            }

            leaf sd-detection {
              description 'The SD detection switch of smartgroup.' ;
              type enumeration {
                enum disable {
                  value 0 ;
                  description 'Close the SD detection switch.' ;
                }

                enum enable {
                  value 1 ;
                  description 'Open the SD detection switch.' ;
                }

              }

              default disable ;
              ncd:revise-date 2017-07-20 ;
            }

            leaf data-selector {
              description "The data receive mode of smartgroup's members. Smartgroup has two modes, selective and merging." ;
              type enumeration {
                enum selective {
                  value 0 ;
                  description 'Selective mode' ;
                }

                enum merging {
                  value 1 ;
                  description 'Merging mode' ;
                }

              }

              default selective ;
              ncd:revise-date 2018-09-13 ;
            }

            container protocol-packet {
              if-feature lacp-protocol-packet ;

              description 'The rule of the control plane sending protocol packet for smartgroup,its default value depends on the performance parameters.' ;
              choice protocol-packet-choice {
                description 'The rule of the control plane sending protocol packet for smartgroup,its default value depends on the performance parameters.' ;
                case load-balance-case {
                  description 'The rule of the control plane sending protocol packet for smartgroup is load balance mode.' ;
                  leaf load-balance {
                    description 'The rule of the control plane sending protocol packet for smartgroup is load balance mode.' ;
                    type empty ;

                    mandatory true ;
                  }

                  leaf mode {
                    description 'The load sharing strategy of smartgroup, its default value depends on the performance parameters.' ;
                    type enumeration {
                      enum per-destination {
                        value 10 ;
                        description 'The load-balance mode is per-destination.' ;
                      }

                      enum per-packet {
                        value 11 ;
                        description 'The load-balance mode is per-packet.' ;
                      }

                    }

                    mandatory true ;
                  }

                }

                case random-case {
                  description 'The rule of the control plane sending protocol packet for smartgroup is random selection.' ;
                  leaf random {
                    description 'The rule of the control plane sending protocol packet for smartgroup is random selection.' ;
                    type empty ;

                  }

                }

                case ip-fixed-case {
                  description 'The rule of the control plane sending protocol packet for smartgroup is fixed selection by destination.' ;
                  leaf ip-fixed {
                    description 'The rule of the control plane sending protocol packet for smartgroup is fixed selection by destination.' ;
                    type empty ;

                  }

                }

              }

              ncd:revise-date 2020-01-02 ;
            }

            leaf fsm-mode {
              description 'The finite state machine mode of smartgroup. Smartgroup has two modes, normal and fast. Its default value which is between [normal,fast] and generally normal, depends on product specification.' ;
              type enumeration {
                enum normal {
                  value 0 ;
                  description 'The finite state machine mode of smartgroup is normal.' ;
                }

                enum fast {
                  value 1 ;
                  description 'The finite state machine mode of smartgroup is fast.' ;
                }

              }

              ncd:revise-date 2020-06-30 ;
            }

            leaf speed-reassign {
              description 'The speed field reassignment of smartgroup.' ;
              type enumeration {
                enum disable {
                  value 0 ;
                  description 'The speed field reassignment of smartgroup is disable.' ;
                }

                enum enable {
                  value 1 ;
                  description 'The speed field reassignment of smartgroup is enable.' ;
                }

              }

              default disable ;
              ncd:revise-date 2020-06-30 ;
            }

            container lag-bfd {
              description 'The lag-bfd of smartgroup.' ;
              presence "destination should be mandatory" ;
              leaf source {
                description 'The source IP of lag-bfd.' ;
                type ncd:ipv4-address-none-zero ;

              }

              leaf destination {
                description 'The destination IP of lag-bfd.' ;
                type ncd:ipv4-address-none-zero ;

                mandatory true ;
              }

              container time-type {
                description 'The time or template parameters of lag-bfd.' ;
                choice time-type-choice {
                  description 'The time or template parameters of lag-bfd.' ;
                  case time-case {
                    description 'The time parameters of lag-bfd.' ;
                    container time {
                      description 'The time parameters of lag-bfd.' ;
                      presence "min-tx and min-rx and multiplier should be mandatory" ;
                      leaf min-tx {
                        description 'The minimum send interval of lag-bfd, its minimum value and maximum value depend on the performance parameters.' ;
                        type uint32 {
                          range 1..65535 ;

                        }

                        units millisecond ;
                        mandatory true ;
                      }

                      leaf min-rx {
                        description 'The minimum receive interval of lag-bfd, its minimum value and maximum value depend on the performance parameters.' ;
                        type uint32 {
                          range 1..65535 ;

                        }

                        units millisecond ;
                        mandatory true ;
                      }

                      leaf multiplier {
                        description 'The detect multiplier of lag-bfd.' ;
                        type uint8 {
                          range 3..50 ;

                        }

                        mandatory true ;
                      }

                    }

                  }

                  case template-case {
                    description 'The template parameters of lag-bfd.' ;
                    leaf template {
                      description 'The template parameters of lag-bfd.' ;
                      type string {
                        length 1..31 ;

                      }

                    }

                  }

                }

              }

              ncd:revise-date 2020-08-31 ;
            }

            container lag-bfd-ipv6 {
              description 'The lag-bfd ipv6 of smartgroup.' ;
              presence "destination should be mandatory" ;
              leaf source {
                description 'The source IP of lag-bfd ipv6.' ;
                type ncd:ipv6-address-none-zero ;

              }

              leaf destination {
                description 'The destination IP of lag-bfd ipv6.' ;
                type ncd:ipv6-address-none-zero ;

                mandatory true ;
              }

              container time-type {
                description 'The time or template parameters of lag-bfd ipv6.' ;
                choice time-type-choice {
                  description 'The time or template parameters of lag-bfd ipv6.' ;
                  case time-case {
                    description 'The time parameters of lag-bfd ipv6.' ;
                    container time {
                      description 'The time parameters of lag-bfd ipv6.' ;
                      presence "min-tx and min-rx and multiplier should be mandatory" ;
                      leaf min-tx {
                        description 'The minimum send interval of lag-bfd ipv6, its minimum value and maximum value depend on the performance parameters.' ;
                        type uint32 {
                          range 1..65535 {
                            description 'The minimum value and maximum value depend on the performance parameters.' ;
                          }

                        }

                        units millisecond ;
                        mandatory true ;
                      }

                      leaf min-rx {
                        description 'The minimum receive interval of lag-bfd ipv6, its minimum value and maximum value depend on the performance parameters.' ;
                        type uint32 {
                          range 1..65535 {
                            description 'The minimum value and maximum value depend on the performance parameters.' ;
                          }

                        }

                        units millisecond ;
                        mandatory true ;
                      }

                      leaf multiplier {
                        description 'The detect multiplier of lag-bfd ipv6.' ;
                        type uint8 {
                          range 3..50 ;

                        }

                        mandatory true ;
                      }

                    }

                  }

                  case template-case {
                    description 'The template parameters of lag-bfd ipv6.' ;
                    leaf template {
                      description 'The template parameters of lag-bfd ipv6.' ;
                      type string {
                        length 1..31 ;

                      }

                    }

                  }

                }

              }

              ncd:revise-date 2020-08-31 ;
            }

            leaf admin-status-linkage {
              description 'The admin status linkage switch of smartgroup, its default value depends on the performance parameters.' ;
              type enumeration {
                enum disable {
                  value 0 ;
                  description 'Disable admin status linkage.' ;
                }

                enum enable {
                  value 1 ;
                  description 'Enable admin status linkage.' ;
                }

              }

              default disable ;
              ncd:revise-date 2020-09-09 ;
            }

            leaf smartgroup-constant-up {
              description 'The protocol constant up flag of smartgroup.' ;
              type empty ;

              ncd:revise-date 2020-09-15 ;
            }

            leaf smartgroup-preferred-up {
              type empty ;

              description 'The protocol preferred up flag of smartgroup.' ;
              if-feature smartgroup-preferred-up ;

              ncd:revise-date 2024-12-09 ;
            }

            container preempt {
              description 'The preempt parameter of smartgroup.' ;
              leaf switch {
                description 'The preempt switch of smartgroup.' ;
                type enumeration {
                  enum disable {
                    value 0 ;
                    description 'The preempt switch of smartgroup is disable.' ;
                  }

                  enum enable {
                    value 1 ;
                    description 'The preempt switch of smartgroup is enable.' ;
                  }

                }

                default enable ;
              }

              leaf delay-time {
                description 'The preempt delay time of smartgroup.' ;
                type uint32 {
                  range 0..180 ;

                }

                units second ;
                default 0 ;
              }

              ncd:revise-date 2020-10-12 ;
            }

            leaf delay-down-time {
              description 'The delay down time of smartgroup. Its default value which is between 0-180 and generally 0, depends on product specification.' ;
              type uint32 {
                range 0..180 ;

              }

              units second ;
              ncd:revise-date 2020-12-28 ;
            }

            leaf system-mac {
              description 'The system MAC of smartgroup.' ;
              type ncd:mac-address-none-zero ;

              ncd:revise-date 2021-04-20 ;
            }

            leaf node-id {
              description 'The node ID of smartgroup.' ;
              type uint32 {
                range 0..7 ;

              }

              default 0 ;
              ncd:revise-date 2021-04-20 ;
            }

            leaf port-key {
              description 'The port key of smartgroup.' ;
              type uint16 {
                range 1..65535 ;

              }

              ncd:revise-date 2021-07-12 ;
            }

            leaf port-selection {
              type enumeration {
                enum speed {
                  description 'Port selection based on speed.' ;
                  value 1 ;
                }

              }

              description 'The port selection of smartgroup.' ;
              if-feature port-selection ;

              ncd:revise-date 2023-12-01 ;
            }

            leaf monitor-esi-df-election {
              type enumeration {
                enum enable {
                  value 1 ;
                  description 'Enable monitor ESI DF election.' ;
                }

                enum disable {
                  value 0 ;
                  description 'Disable monitor ESI DF election.' ;
                }

              }

              description 'The monitor ESI DF election of smartgroup.' ;
              default disable ;
              if-feature monitor-esi-df-election ;

              ncd:revise-date 2024-04-03 ;
            }

            container load-balance-factor {
              leaf src-ip {
                type empty ;

                description 'The IP address of the sending host or device.' ;
              }

              leaf dst-ip {
                type empty ;

                description 'The IP address of the receiving host or device.' ;
              }

              leaf l3-protocol {
                type empty ;

                description 'The transport layer protocol type.' ;
              }

              leaf src-port {
                type empty ;

                description 'The port number used by the application sending the packets.' ;
              }

              leaf dst-port {
                type empty ;

                description ' The port number used by the application receiving the packets.' ;
              }

              leaf src-mac {
                type empty ;

                description 'The MAC address of the sending host or device.' ;
              }

              leaf dst-mac {
                type empty ;

                description 'The MAC address of the receiving host or device.' ;
              }

              leaf outer-vlan {
                type empty ;

                description 'The outer vlan id of the receiving packet.' ;
              }

              description 'The load balance factor of smartgroup.' ;
              if-feature lacp-load-balance-factor ;

              ncd:revise-date 2024-08-09 ;
            }

            leaf state-dampening {
              type enumeration {
                enum enable {
                  value 1 ;
                  description 'Enable state dampening.' ;
                }

                enum disable {
                  value 0 ;
                  description 'Disable state dampening.' ;
                }

              }

              description 'The state dampening switch of smartgroup.' ;
              default disable ;
              ncd:revise-date 2024-11-25 ;
            }

            leaf lag-bfd-state-linkage {
              type enumeration {
                enum disable {
                  description 'Disable LAG BFD state linkage.' ;
                  value 0 ;
                }

                enum enable {
                  description 'Enable LAG BFD state linkage.' ;
                }

              }

              description 'LAG BFD state linkage.' ;
              default disable ;
              ncd:revise-date 2025-04-08 ;
            }

          }

        }

        container ports {
          description 'Describe the parameters of member port to be configured.' ;
          list port {
            description 'Describe the parameters of member port to be configured.' ;
            key interface-name ;
            leaf interface-name {
              description 'The interface name of member port.' ;
              type ncd:ifname ;

            }

            leaf smartgroup-id {
              description 'The group id bound by member port, its maximum value depends on the performance parameters.' ;
              type uint32 {
                range 1..99999999 {
                  description 'The maximum value depends on the performance parameters.
The minimum value(the second range) depends on the performance parameters.' ;
                }

              }

              mandatory true ;
            }

            leaf mode {
              description 'The bind mode of member port. Member port has three bind modes, on and passive and active.' ;
              type enumeration {
                enum passive {
                  value 1 ;
                  description 'The bind mode is passive.' ;
                }

                enum on {
                  value 2 ;
                  description 'The bind mode is on.' ;
                }

                enum active {
                  value 3 ;
                  description 'The bind mode is active.' ;
                }

              }

              mandatory true ;
            }

            leaf port-priority {
              description 'The priority of member port.' ;
              type uint16 {
                range 1..65535 ;

              }

              default 32768 ;
            }

            leaf timeout {
              description 'The timeout type of member port. Timeout has two types, long and short.' ;
              type enumeration {
                enum long {
                  value 0 ;
                  description 'The time-out type is long.' ;
                }

                enum short {
                  value 1 ;
                  description 'The time-out type is short.' ;
                }

              }

              default long ;
            }

            leaf back-up {
              description 'The backup attribute of member port. Only the value of bond-mode leaf is on can this attribute be configured.' ;
              type empty ;

            }

            leaf track {
              description 'The track name of member port.' ;
              type string {
                length 1..31 ;

              }

            }

            container lag-bfd {
              description 'The lag-bfd of member port.' ;
              presence "destination should be mandatory" ;
              leaf source {
                description 'The source IP of lag-bfd.' ;
                type ncd:ipv4-address-none-zero ;

              }

              leaf destination {
                description 'The destination IP of lag-bfd.' ;
                type ncd:ipv4-address-none-zero ;

                mandatory true ;
              }

              choice time-type-choice {
                description 'The time or template parameters of lag-bfd.' ;
                case time-case {
                  description 'The time parameters of lag-bfd.' ;
                  container time {
                    description 'The time parameters of lag-bfd.' ;
                    presence "min-tx and min-rx and multiplier should be mandatory" ;
                    leaf min-tx {
                      description 'The minimum send interval of lag-bfd, its minimum value and maximum value depend on the performance parameters.' ;
                      type uint32 {
                        range 1..65535 {
                          description 'The minimum value and maximum value depend on the performance parameters.' ;
                        }

                      }

                      units millisecond ;
                      mandatory true ;
                    }

                    leaf min-rx {
                      description 'The minimum receive interval of lag-bfd, its minimum value and maximum value depend on the performance parameters.' ;
                      type uint32 {
                        range 1..65535 {
                          description 'The minimum value and maximum value depend on the performance parameters.' ;
                        }

                      }

                      units millisecond ;
                      mandatory true ;
                    }

                    leaf multiplier {
                      description 'The detect multiplier of lag-bfd.' ;
                      type uint8 {
                        range 3..50 ;

                      }

                      mandatory true ;
                    }

                  }

                }

                case template-case {
                  description 'The template parameters of lag-bfd.' ;
                  leaf template {
                    description 'The template parameters of lag-bfd.' ;
                    type string {
                      length 1..31 ;

                    }

                  }

                  ncd:revise-date 2020-08-31 ;
                }

              }

              container discriminator {
                description 'The discriminator of lag-bfd.' ;
                presence "ld and rd should be mandatory" ;
                leaf ld {
                  description 'The local discriminator of lag-bfd. Its default range 1-4294967295, depends on product specification.' ;
                  type uint32 {
                    range 1..4294967295 ;

                  }

                  mandatory true ;
                }

                leaf rd {
                  description 'The remote discriminator of lag-bfd.' ;
                  type uint32 {
                    range 1..4294967295 ;

                  }

                  mandatory true ;
                }

                ncd:revise-date 2022-06-30 ;
              }

            }

            leaf negotiation-mac {
              description 'The negotiation MAC of member port.Only the value of bond-mode leaf is 802.3ad can this attribute be configured.' ;
              type ncd:mac-address-none-zero ;

              ncd:revise-date 2016-09-19 ;
            }

            leaf unconditional-active {
              description 'The unconditional active flag of member port.Only the value of bond-mode leaf is 802.3ad can this attribute be configured.' ;
              type empty ;

              ncd:revise-date 2016-10-10 ;
            }

            leaf description {
              description 'Member port description.' ;
              type ncd:string-with-blank {
                length 1..64 ;

              }

              ncd:revise-date 2020-06-19 ;
            }

            container lag-bfd-ipv6 {
              description 'The lag-bfd ipv6 of member port.' ;
              presence "destination should be mandatory" ;
              leaf source {
                description 'The source IP of lag-bfd ipv6.' ;
                type ncd:ipv6-address-none-zero ;

