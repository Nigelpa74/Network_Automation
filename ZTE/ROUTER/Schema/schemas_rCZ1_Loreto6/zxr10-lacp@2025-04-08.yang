                      }

                      case encrypted-case {
                        leaf encrypted-password {
                          type string {
                            length 84 ;

                          }

                          description 'The encrypted password.' ;
                          mandatory true ;
                        }

                        description 'Encrypted the password.' ;
                      }

                      description 'Set MC-LAG authentication password.' ;
                      mandatory true ;
                    }

                    description 'MC-LAG authentication mode is HMAC-SHA256.' ;
                    presence "password should be mandatory" ;
                  }

                  description 'MC-LAG authentication mode is HMAC-SHA256.' ;
                }

                case sm4-case {
                  container sm4 {
                    choice password-choice {
