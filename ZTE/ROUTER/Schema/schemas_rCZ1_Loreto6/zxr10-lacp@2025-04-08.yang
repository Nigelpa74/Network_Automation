                case hmac-sha256-case {
                  container hmac-sha256 {
                    choice password-choice {
                      case clear-case {
                        leaf clear-password {
                          type string {
                            length 8..16 ;

                          }

                          description 'The clear password.' ;
                          mandatory true ;
                        }

