              presence lag-bfd-to-satellite ;
              choice time-type-choice {
                description 'The time or template parameters of lag-bfd to-satellite.' ;
                case time-case {
                  description 'The time parameters of lag-bfd to-satellite.' ;
                  container time {
                    description 'The time parameters of lag-bfd to-satellite.' ;
