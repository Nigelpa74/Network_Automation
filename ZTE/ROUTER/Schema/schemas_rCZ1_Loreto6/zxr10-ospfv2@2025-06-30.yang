                description 'Set TE link bandwidth disable' ;
              }

              enum enable {
                value 1 ;
                description 'Set TE link bandwidth enable' ;
              }

            }

            default disable ;
            ncd:revise-date 2021-06-15 ;
          }

          leaf te-link-delay {
            description 'Set TE link delay enable' ;
            type enumeration {
              enum enable {
                value 1 ;
                description 'enable' ;
              }

              enum disable {
                value 2 ;
                description 'disable' ;
              }

            }

            default disable ;
            ncd:revise-date 2020-02-04 ;
          }

          leaf frr-host-only {
            description 'Filter OSPF backup route based on host' ;
            type empty ;

            ncd:revise-date 2022-03-28 ;
          }

          leaf frr-remote-srlg-protection {
            description 'Config OSPF fast-reroute remote-srlg-protection' ;
            type enumeration {
              enum enable {
                value 1 ;
                description 'Enable fast-reroute remote-srlg-protection' ;
              }

              enum disable {
                value 0 ;
                description 'Disable fast-reroute remote-srlg-protection' ;
              }

            }

            default disable ;
            ncd:revise-date 2022-07-11 ;
          }

          container frr-policy {
            description 'Configure OSPF backup route policy.' ;
