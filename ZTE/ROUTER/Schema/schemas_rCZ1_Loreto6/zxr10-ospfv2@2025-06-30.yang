                    type uint32 {
                      range 1..65535 {
                        description 'Time between hello packets,Seconds' ;
                      }

                    }

                    units second ;
                  }

                  leaf mtu-ignore {
                    description 'Ignore the mtu mismatch when exchanging DD packet' ;
                    type enumeration {
                      enum config {
                        value 1 ;
                        description 'config' ;
                      }

                      enum no-config {
                        value 2 ;
                        description 'no-config' ;
                      }

                    }

                    default no-config ;
                  }

                  leaf priority {
