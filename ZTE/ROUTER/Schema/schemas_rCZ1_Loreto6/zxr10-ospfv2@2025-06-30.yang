                          }

                          leaf deaddelay {
                            description 'Dead delay,Seconds' ;
                            type uint32 {
                              range 1..8192 {
                                description 'Dead delay,Seconds' ;
                              }

                            }

                            units second ;
                          }

                          choice auth-password-type {
                            case unencrypted {
                              leaf authenkey {
                                description 'virtual authentication key' ;
                                type string {
                                  length 1..8 ;

                                }

                                mandatory true ;
                              }

                            }

                            case encrypted {
                              leaf encry-authenkey {
                                description 'virtual encrypted authentication key' ;
                                type string {
                                  length 1..128 ;

                                }

                                mandatory true ;
                              }

                              ncd:revise-date 2019-12-16 ;
                            }

                          }

                          container md5s {
                            list md5 {
                              key key-id ;
                              leaf key-id {
                                type uint32 {
                                  range 1..255 ;

                                }

                              }

                              container secret-key {
