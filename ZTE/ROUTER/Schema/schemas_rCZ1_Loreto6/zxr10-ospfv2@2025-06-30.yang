                value 1 ;
                description 'disable' ;
              }

              enum enable {
                value 2 ;
                description 'enable' ;
              }

            }

            default enable ;
          }

          leaf nsf {
            description 'Non-stop forwarding' ;
            type enumeration {
              enum enable {
                value 1 ;
                description 'enable' ;
              }

              enum disable {
                value 2 ;
                description 'disable' ;
              }

            }

            default disable ;
          }

          leaf local-mt {
