  container state {
    config false ;
    description 'State of OSPFv2.' ;
    container ospfv2 {
      description 'State of OSPFv2.' ;
      container processes {
        description 'OSPFv2 process.' ;
        list process {
          description 'OSPFv2 process.' ;
          key process-id ;
          leaf process-id {
            description 'Ospf process ID.' ;
            type uint32 {
              range 1..65535 ;

            }

          }

          leaf router-id {
            description 'Ospf router id.' ;
            type ncd:ipv4-address ;

          }

          leaf vrf-name {
            description 'Vrf name.' ;
            type string {
              length 1..32 ;

            }

          }

          leaf state {
            description 'Process state.' ;
            type enumeration {
              enum enable {
                value 1 ;
              }

              enum disable {
                value 2 ;
              }

              enum restarting-for-lsa-limit {
                value 3 ;
              }

              enum disabling {
                value 4 ;
              }

            }

          }

          leaf domain-id-type {
            description 'Domain ID type(only valid for domain ID in IP address format).' ;
            type uint8 ;

          }

          leaf domain-id {
            description 'Domain ID in IP address format.' ;
            type ncd:ipv4-address ;

          }

          leaf enable-time {
            description 'Process enable time.' ;
            type string ;

          }

          leaf interface-count {
            description 'Interface count of the process.' ;
            type uint32 {
              range 0..4294967295 ;

            }

          }

          leaf neighbor-count {
            description 'Neighbor count of the process.' ;
            type uint32 {
              range 0..4294967295 ;

            }

          }

          leaf full-neighbor-count {
            description 'Full neighbor count of the process.' ;
            type uint32 {
              range 0..4294967295 ;

            }

          }

          leaf virtual-link-count {
            description 'Virtual link count of the process.' ;
            type uint32 {
              range 0..4294967295 ;

            }

          }

          leaf ttl-security-state {
            description 'TTL security check state.' ;
            type enumeration {
              enum enable {
                value 1 ;
                description 'TTL security enable.' ;
              }

              enum disable {
                value 2 ;
                description 'TTL security disable.' ;
              }

            }

          }

          leaf ttl-security-hops {
            description 'TTL security check hops.' ;
            type uint8 {
              range 1..254 ;

            }

          }

          container area-count {
            description 'Area count.' ;
            leaf total-count {
              description 'Total area count.' ;
              type uint32 {
                range 0..4294967295 ;

              }

            }

            leaf normal-count {
              description 'Normal area count.' ;
              type uint32 {
                range 0..4294967295 ;

              }

            }

            leaf stub-count {
              description 'STUB area count.' ;
              type uint32 {
                range 0..4294967295 ;

              }

            }

            leaf nssa-count {
              description 'NSSA area count.' ;
              type uint32 {
                range 0..4294967295 ;

              }

            }

          }

          container lsa-count {
            description 'LSA count.' ;
            leaf total-count {
              description 'Total LSA count.' ;
              type uint32 {
                range 0..4294967295 ;

              }

            }

            leaf ase-count {
              description 'Ase LSA count.' ;
              type uint32 {
                range 0..4294967295 ;

              }

            }

            leaf gr-count {
              description 'Gr LSA count.' ;
              type uint32 {
                range 0..4294967295 ;

              }

            }

            leaf received-new-count {
              description 'Received new LSA count.Not only include the LSAs in current LSDB,but also include the LSAs that had been flushed previously.' ;
              type uint32 {
                range 0..4294967295 ;

              }

            }

            leaf self-originated-count {
              description 'Self-originated LSA count.Not only include the LSAs in current LSDB,but also include the LSAs that had been flushed previously.' ;
              type uint32 {
                range 0..4294967295 ;

              }

            }

            leaf non-self-originated-count {
              description 'non-self-originated LSA count.Not only include the LSAs in current LSDB,but also include the LSAs that had been flushed previously.' ;
              type uint32 {
                range 0..4294967295 ;

              }

            }

          }

          container lsa-limit {
            description 'Limit number of non-self originated LSAs that Ospf process can receive.' ;
            leaf max-lsa-count {
              description 'Max number of non self-generated LSAs can receive.' ;
              type uint32 {
                range 1..4294967294 ;

              }

            }

            leaf current-lsa-count {
              description 'Current number of non self-generated LSAs can receive.' ;
              type uint32 {
                range 0..4294967294 ;

              }

            }

            leaf warning-threshold {
              description 'Threshold value(%) at which to give a warning' ;
              type uint8 {
                range 1..100 ;

              }

              units percent ;
            }

            leaf only-send-warning {
              description 'Only give a warning when threshold is exceeded.' ;
              type empty ;

            }

            leaf limit-time {
              description 'Time during which limit-state continue.' ;
              type uint32 {
                range 1..65535 ;

              }

              units minute ;
            }

            leaf refresh-time {
              description 'Mins after which limit-count can be refreshed.' ;
              type uint32 {
                range 1..65535 ;

              }

              units minute ;
            }

            leaf limit-count {
              description 'Maximum times OSPF can enter limit-state.' ;
              type uint32 {
                range 1..65535 ;

              }

            }

            leaf current-limit-count {
              description 'Current times OSPF can enter limit-state.' ;
              type uint32 {
                range 0..65535 ;

              }

            }

            leaf permanently-ignore-all-neighbors {
              description 'Permanently ignoring all neighbors for lsa limit.' ;
              type empty ;

            }

            container time-remaining {
              description 'Time remaining.' ;
              leaf enter-limit-state {
                description 'Time remaining to enter limit state.' ;
                type string ;

              }

              leaf refresh-limit-count {
                description 'Time remaining to refresh limit count.' ;
                type string ;

              }

              leaf ignore-all-neighbors {
                description 'Time remaining to ignore all neighbors.' ;
                type string ;

              }

            }

          }

          container nsf {
            description 'Non stop forwarding.' ;
            leaf state {
              description 'NSF state.' ;
              type enumeration {
                enum enable {
                  value 1 ;
                  description 'NSF enable.' ;
                }

                enum disable {
                  value 2 ;
                  description 'NSF disable.' ;
                }

              }

            }

            leaf last-nsf-restart-time {
              description 'Last nsf restart happened how long ago.' ;
              type string ;

            }

            leaf last-nsf-restart-use-time {
              description 'Last nsf restart use time.' ;
              type uint32 {
                range 0..4294967295 ;

              }

              units second ;
            }

          }

          container max-metric {
            description 'Maximum metric of router LSA.' ;
            leaf take-effect-time {
              description 'The time at which max-metric router LSA took effect.' ;
              type string ;

            }

            leaf disable-time {
              description 'The time at which max-metric router LSA disable.' ;
              type string ;

            }

            leaf originate-router-lsas-with-max-metric {
              description 'Originate router LSAs with max metric.' ;
              type empty ;

            }

            leaf time-remaining {
              description 'time remaining for originating router LSAs with maximum metric.' ;
              type string ;

            }

            leaf state {
              description 'Max metric state.' ;
              type enumeration {
                enum active {
                  value 1 ;
                  description 'max-metric state is active.' ;
                }

                enum inactive {
                  value 2 ;
                  description 'max-metric state is inactive.' ;
                }

              }

            }

            container condition {
              description 'Condition of originating router LSAs with maximum metric.' ;
              choice condition {
                description 'Condition of originating router LSAs with maximum metric.' ;
                case always {
                  description 'Always.' ;
                  leaf always {
                    description 'Always.' ;
                    type empty ;

                  }

                }

                case on-startup-wait-for-bgp {
                  description 'On startup while BGP is converging.' ;
                  leaf on-startup-wait-for-bgp {
                    description 'On startup while BGP is converging.' ;
                    type empty ;

                  }

                }

                case on-startup-wait-for-timeout {
                  description 'On startup for a time.' ;
                  leaf on-startup-wait-for-timeout {
                    description 'On startup for a time.' ;
                    type empty ;

                  }

                  leaf timeout {
                    description 'The time after startup to originate max metric router LSA.' ;
                    type uint32 {
                      range 5..86400 ;

                    }

                    units second ;
                  }

                }

              }

            }

          }

          container areas {
            description 'Area.' ;
            list area {
              description 'Area.' ;
              key area-id ;
              leaf area-id {
                description 'Area ID.' ;
                type ncd:ipv4-address ;

              }

              leaf state {
                description 'Area state.' ;
                type enumeration {
                  enum enable {
                    value 1 ;
                    description 'area is enable.' ;
                  }

                  enum disable {
                    value 2 ;
                    description 'area is disable.' ;
                  }

                }

              }

              leaf demand-circuit-available {
                description 'Demand circuit available.' ;
                type empty ;

              }

              leaf enable-time {
                description 'Area enable time.' ;
                type string ;

              }

              leaf area-type {
                description 'Area type.' ;
                type enumeration {
                  enum stub {
                    value 1 ;
                    description 'Stub area.' ;
                  }

                  enum nssa {
                    value 2 ;
                    description 'Nssa area.' ;
                  }

                  enum normal {
                    value 3 ;
                    description 'Normal area.' ;
                  }

                }

              }

              leaf stub-no-summary {
                description 'Do not send summary LSA into stub area.' ;
                type empty ;

              }

              leaf stub-default-cost {
                description 'Default cost of stub area.' ;
                type uint32 {
                  range 1..65535 ;

                }

              }

              leaf nssa-default-metric {
                description 'Default metric of nssa area.' ;
                type uint32 {
                  range 1..16777214 ;

                }

              }

              leaf authentication-type {
                description 'Authentication type.' ;
                type enumeration {
                  enum null {
                    value 1 ;
                    description 'No authentication.' ;
                  }

                  enum simple-password {
                    value 2 ;
                    description 'Simple password authentication.' ;
                  }

                  enum message-digest {
                    value 3 ;
                    description 'Message-digest authentication.' ;
                  }

                  enum keychain {
                    value 4 ;
                    description 'Keychain authentication.' ;
                  }

                }

              }

              container sending-sa {
                description 'Sending SA.' ;
                leaf authen-keyid {
                  description 'Authentication keyid.' ;
                  type uint8 {
                    range 0..255 {
                      description 'Authentication keyid, from 0 to 255' ;
                    }

                  }

                }

                leaf authen-algorithm {
                  description 'Authentication algorithm.' ;
                  type enumeration {
                    enum md5 {
                      value 1 ;
                      description 'Authentication algorithm is md5.' ;
                    }

                    enum hmac-md5 {
                      value 2 ;
                      description 'Authentication algorithm is hmac-md5.' ;
                    }

                    enum sm3 {
                      value 3 ;
                      description 'Authentication algorithm is sm3.' ;
                    }

                    enum hmac-sm3 {
                      value 4 ;
                      description 'Authentication algorithm is hmac-sm3.' ;
                    }

                    enum sha256 {
                      value 5 ;
                      description 'Authentication algorithm is sha256.' ;
                    }

                    enum hmac-sha256 {
                      value 6 ;
                      description 'Authentication algorithm is hmac-sha256.' ;
                    }

                    enum sha1 {
                      value 7 ;
                      description 'Authentication algorithm is sha1.' ;
                    }

                    enum hmac-sha1-12 {
                      value 8 ;
                      description 'Authentication algorithm is hmac-sha1-12.' ;
                    }

                    enum hmac-sha1-20 {
                      value 9 ;
                      description 'Authentication algorithm is hmac-sha1-20.' ;
                    }

                  }

                }

                leaf authen-keychain {
                  description 'Authentication keychain.' ;
                  type string {
                    length 1..31 {
                      description 'Name of keychain,characters from 1 to 31' ;
                    }

                  }

                }

                ncd:revise-date 2016-01-18 ;
              }

              leaf spf-calculation-times {
                description 'SPF calculation times.' ;
                type uint32 {
                  range 0..4294967295 ;

                }

              }

              leaf ispf-calculation-times {
                description 'ISPF calculation times.' ;
                type uint32 {
                  range 0..4294967295 ;

                }

              }

              leaf interface-count {
                description 'Interface count of the area.' ;
                type uint32 {
                  range 0..4294967295 ;

                }

              }

              leaf up-interface-count {
                description 'Up interface count of the area.' ;
                type uint32 {
                  range 0..4294967295 ;

                }

              }

              leaf intra-inter-lsa-count {
                description 'Intra/inter LSA count of the area.' ;
                type uint32 {
                  range 0..4294967295 ;

                }

              }

              leaf area-filter-out {
                description 'Policy name that filter networks sent from this area.' ;
                type string {
                  length 1..169 ;

                }

              }

              leaf area-filter-in {
                description 'Policy name that filter networks sent to this area.' ;
                type string {
                  length 1..169 ;

                }

              }

              leaf summary-range-count {
                description 'Summary range count.' ;
                type uint32 {
                  range 0..4294967295 ;

                }

              }

              container summary-ranges {
                description 'Summary range of the area.' ;
                list summary-range {
                  description 'Summary range of the area.' ;
                  key 'ip-address subnet-mask' ;
                  leaf ip-address {
                    description 'IP address of the range.' ;
                    type ncd:ipv4-address ;

                  }

                  leaf subnet-mask {
                    description 'Subnet mask of the range.' ;
                    type ncd:ipv4-mask ;

                  }

                  leaf advertise-state {
                    description 'Advertise state of the range.' ;
                    type enumeration {
                      enum advertise {
                        value 1 ;
                      }

                      enum not-advertise {
                        value 2 ;
                      }

                    }

                  }

                  ncd:select "ip-address subnet-mask" ;
                }

              }

            }

          }

          ncd:select process-id ;
        }

      }

      container interfaces {
        description 'OSPFv2 interfaces.' ;
        container normal-interfaces {
          description 'OSPFv2 interface.' ;
          list normal-interface {
            description 'OSPFv2 interface.' ;
            key 'process-id area-id interface-name' ;
            leaf process-id {
              description 'OSPF process ID.' ;
              type uint32 {
                range 1..65535 {
                  description 'Ospf process ID from 1 to 65535' ;
                }

              }

            }

            leaf area-id {
              description 'Area ID.' ;
              type ncd:ipv4-address ;

            }

            leaf interface-name {
              description 'Interface name.' ;
              type ncd:ifname {
                length 1..31 {
                  description 'Interface name' ;
                }

              }

            }

            leaf admin-state {
              description 'Admin state.' ;
              type enumeration {
                enum down {
                  value 0 ;
                  description 'Admin state is down.' ;
                }

                enum up {
                  value 1 ;
                  description 'Admin state is up.' ;
                }

              }

            }

            leaf protocol-state {
              description 'Protocol state of the interface.' ;
              type enumeration {
                enum disable {
                  value 0 ;
                  description 'Protocol state is disable.' ;
                }

                enum enable-SD-down {
                  value 1 ;
                  description 'Protocol state is enable-SD-down.' ;
                }

                enum enable {
                  value 2 ;
                  description 'Protocol state is enable.' ;
                }

              }

            }

            leaf track-state {
              description 'Track state.' ;
              type enumeration {
                enum down {
                  value 0 ;
                  description 'Track state is down.' ;
                }

                enum up {
                  value 1 ;
                  description 'Track state is up.' ;
                }

                enum unknown {
                  value 2 ;
                  description 'Track state is unknown.' ;
                }

              }

            }

            leaf ip-address {
              description 'IP address of the interface.' ;
              type ncd:ipv4-address ;

            }

            leaf ip-mask {
              description 'IP mask of the interface.' ;
              type ncd:ipv4-mask ;

            }

            leaf up-time {
              description 'Up time of the interface.' ;
              type string {
                length 1..15 {
                  description 'Up time of the interface' ;
                }

              }

            }

            leaf demand-circuit {
              description 'Demand circuit.' ;
              type empty ;

            }

            leaf suppress-hello {
              description 'Suppress hello.' ;
              type empty ;

            }

            leaf interface-state {
              description 'Interface state.' ;
              type enumeration {
                enum Down {
                  value 0 ;
                  description 'Down state.' ;
                }

                enum Loopback {
                  value 1 ;
                  description 'Loopback state.' ;
                }

                enum Waiting {
                  value 2 ;
                  description 'Waiting state.' ;
                }

                enum Point-to-point {
                  value 3 ;
                  description 'Point-to-point state.' ;
                }

                enum DR {
                  value 4 ;
                  description 'DR state.' ;
                }

                enum Backup {
                  value 5 ;
                  description 'Backup state.' ;
                }

                enum DROther {
                  value 6 ;
                  description 'DROther state.' ;
                }

              }

            }

            leaf cost {
              description 'Cost value of the interface.' ;
              type uint32 {
                range 0..65535 {
                  description 'Interface cost' ;
                }

              }

            }

            leaf priority {
              description 'Interface priority.' ;
              type uint32 {
                range 0..255 {
                  description 'Router priority' ;
                }

              }

            }

            leaf network-type {
              description 'Network type of the interface.' ;
              type enumeration {
                enum Broadcast {
                  value 1 ;
                  description 'Network type is Broadcast.' ;
                }

                enum Nbma {
                  value 2 ;
                  description 'Network type is Nbma.' ;
                }

                enum Point-to-point {
                  value 3 ;
                  description 'Network type is Point-to-point.' ;
                }

                enum Point-to-multipoint {
                  value 4 ;
                  description 'Network type is Point-to-multipoint.' ;
                }

                enum P-to-mp-nb {
                  value 5 ;
                  description 'Network type is P-to-mp-nb.' ;
                }

                enum Loopback {
                  value 7 ;
                  description 'Network type is Loopback.' ;
                }

              }

            }

            leaf transmit-delay {
              description 'Link state transmit delay.' ;
              type uint32 {
                range 1..65535 {
                  description 'Link state transmit delay,Seconds' ;
                }

              }

              units second ;
            }

            leaf authentication-type {
              description 'Authentication Type.' ;
              type enumeration {
                enum null {
                  value 0 ;
                  description 'Authentication type is null.' ;
                }

                enum simple-password {
                  value 1 ;
                  description 'Authentication type is simple-password.' ;
                }

                enum message-digest {
                  value 2 ;
                  description 'Authentication type is message-digest.' ;
                }

                enum keychain {
                  value 3 ;
                  description 'Authentication type is keychain.' ;
                }

              }

            }

            container sending-sa {
              leaf authen-keyid {
                description 'Authentication keyid.' ;
                type uint8 {
                  range 0..255 {
                    description 'Authentication keyid, from 0 to 255' ;
                  }

                }

              }

              leaf authen-algorithm {
                description 'Authentication algorithm.' ;
                type enumeration {
                  enum md5 {
                    value 1 ;
                    description 'Authentication algorithm is md5.' ;
                  }

                  enum hmac-md5 {
                    value 2 ;
                    description 'Authentication algorithm is hmac-md5.' ;
                  }

                  enum sm3 {
                    value 3 ;
                    description 'Authentication algorithm is sm3.' ;
                  }

                  enum hmac-sm3 {
                    value 4 ;
                    description 'Authentication algorithm is hmac-sm3.' ;
                  }

                  enum sha256 {
                    value 5 ;
                    description 'Authentication algorithm is sha256.' ;
                  }

                  enum hmac-sha256 {
                    value 6 ;
                    description 'Authentication algorithm is hmac-sha256.' ;
                  }

                  enum sha1 {
                    value 7 ;
                    description 'Authentication algorithm is sha1.' ;
                  }

                  enum hmac-sha1-12 {
                    value 8 ;
                    description 'Authentication algorithm is hmac-sha1-12.' ;
                  }

                  enum hmac-sha1-20 {
                    value 9 ;
                    description 'Authentication algorithm is hmac-sha1-20.' ;
                  }

                }

              }

              leaf authen-keychain {
                description 'Authentication keychain.' ;
                type string {
                  length 1..31 {
                    description 'Name of keychain,characters from 1 to 31' ;
                  }

                }

              }

              ncd:revise-date 2016-01-18 ;
            }

            leaf ttl-security-state {
              description 'OSPF ttl-security.' ;
              type enumeration {
                enum disable {
                  value 0 ;
                  description 'TTL security disable.' ;
                }

                enum enable {
                  value 1 ;
                  description 'TTL security enable.' ;
                }

              }

              units hop ;
            }

            leaf ttl-security-hops {
              description 'OSPF ttl-security hop count.' ;
              type uint8 {
                range 1..254 {
                  description 'Ttl-security hops' ;
                }

              }

            }

            leaf ldp-sync {
              description 'MPLS LDP IGP sync.' ;
              type enumeration {
                enum disable {
                  value 0 ;
                  description 'LDP sync disable.' ;
                }

                enum enable {
                  value 1 ;
                  description 'LDP sync enable.' ;
                }

              }

            }

            leaf ldp-sync-state {
              description 'LDP sync of the interface.' ;
              type enumeration {
                enum unachieve {
                  value 0 ;
                  description 'The LDP sync-state is unachieved.' ;
                }

                enum achieve {
                  value 1 ;
                  description 'The LDP sync-state is achieved.' ;
                }

                enum unknown {
                  value 2 ;
                  description 'The LDP sync-state is unknown.' ;
                }

              }

            }

            leaf ldp-autoconfig {
              description 'MPLS LDP IGP autoconfig function.' ;
              type enumeration {
                enum disable {
                  value 0 ;
                  description 'LDP autoconfig disable.' ;
                }

                enum enable {
                  value 1 ;
                  description 'LDP autoconfig enable.' ;
                }

              }

            }

            leaf ldp-link-state {
              description 'LDP link state.' ;
              type enumeration {
                enum send-normal-metric {
                  value 0 ;
                  description 'Router lsa link state is sending normal metric.' ;
                }

                enum send-max-metric {
                  value 1 ;
                  description 'Router lsa link state is sending max metric.' ;
                }

                enum unreachable {
                  value 2 ;
                  description 'Router lsa link state is unreachable.' ;
                }

                enum send-increase-metric {
                  value 3 ;
                  description 'Router lsa link state is sending increase metric.' ;
                }

              }

              ncd:revise-date 2015-12-24 ;
            }

            leaf no-cut-edge {
              description 'There is alternate path for the directly connected network.' ;
              type empty ;

              ncd:revise-date 2015-12-24 ;
            }

            leaf sd-status {
              description 'SD status.' ;
              type enumeration {
                enum appear {
                  value 1 ;
                  description 'SD status appears.' ;
                }

                enum disappear {
                  value 2 ;
                  description 'SD status disappears.' ;
                }

              }

              ncd:revise-date 2015-06-01 ;
            }

            leaf cost-link-sd {
              description 'The cost for interface in sd status' ;
              type uint16 ;

              ncd:revise-date 2015-06-01 ;
            }

            leaf damp-state {
              description 'Link damp state of the interface.' ;
              type enumeration {
                enum inactive {
                  value 0 ;
                  description 'Link Damp state of this interface is inactive.' ;
                }

                enum active {
                  value 1 ;
                  description 'Link Damp state of this interface is active.' ;
                }

              }

              ncd:revise-date 2017-04-05 ;
            }

            leaf damp-remain {
              description 'Link damp remaining time.' ;
              type uint32 {
                range 0..3600000 {
                  description 'Link damp remaining time.' ;
                }

              }

              ncd:revise-date 2017-04-05 ;
            }

            leaf hello-interval {
              description 'Time between hello packets.' ;
              type uint32 {
                range 1..65535 {
                  description 'Time between hello packets,Seconds' ;
                }

              }

              units second ;
            }

            leaf dead-interval {
              description 'Interval after which a neighbor is declared dead.' ;
              type uint32 {
                range 1..65535 {
                  description 'Interval after which a neighbor is declared dead,Seconds' ;
                }

              }

              units second ;
            }

            leaf retransmit-interval {
              description 'Time between retransmitting lost link state advertisements.' ;
              type uint32 {
                range 1..65535 {
                  description 'Time between retransmitting lost link state advertisements,Seconds' ;
                }

              }

              units second ;
            }

            leaf dr {
              description 'Designated Router.' ;
              type ncd:ipv4-address ;

            }

            leaf dr-ip-address {
              description 'IP address of Designated Router.' ;
              type ncd:ipv4-address ;

            }

            leaf bdr {
              description 'Backup Designated Router.' ;
              type ncd:ipv4-address ;

            }

            leaf bdr-ip-address {
              description 'IP address of Backup Designated Router.' ;
              type ncd:ipv4-address ;

            }

            leaf neighbor-count {
              description 'Neighbor count.' ;
              type uint32 {
                range 0..65536 ;

              }

            }

            leaf full-neighbor-count {
              description 'Number of full neighbors.' ;
              type uint32 {
                range 0..65536 ;

              }

            }

            container neighbors {
              description 'OSPF neighbor.' ;
              list neighbor {
                description 'OSPF neighbor.' ;
                key neighbor-id ;
                leaf neighbor-id {
                  description 'The router-id of neighbor route.' ;
                  type ncd:ipv4-address ;

                }

                leaf neighbor-role {
                  description 'The role of neighbor route.' ;
                  type enumeration {
                    enum DR {
                      value 1 ;
                      description 'The role of the neighbor is DR.' ;
                    }

                    enum Backup {
                      value 2 ;
                      description 'The role of the neighbor is Backup.' ;
                    }

                    enum DROther {
                      value 3 ;
                      description 'The role of the neighbor is DROther.' ;
                    }

                  }

                }

