                  leaf authenkey-p {
                    description 'Password to be configured' ;
                    type string {
                      length 1..128 {
                        description 'Password to be configured' ;
                      }

                    }

                  }

                  leaf ldp-igp-sync {
                    description 'Config MPLS LDP IGP sync' ;
                    type enumeration {
                      enum no-config {
                        value 0 ;
                      }

                      enum enable {
                        value 1 ;
                      }

                      enum disable {
                        value 2 ;
                      }

                    }

                    default no-config ;
                  }

                  leaf ldp-autoconfig {
                    description 'Config MPLS LDP IGP autoconfig' ;
