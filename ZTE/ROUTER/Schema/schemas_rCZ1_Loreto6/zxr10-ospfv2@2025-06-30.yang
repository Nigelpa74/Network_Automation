            leaf retransmit-list-count {
              description "Number of elements in neighbor's retransmit queue list." ;
              type uint32 ;

            }

            leaf dd-list-count {
              description "Number of elements in neighbor's DD list." ;
              type uint32 ;

            }

            leaf request-list-count {
              description "Number of elements in neighbor's request list." ;
              type uint32 ;

            }

            leaf dead-time {
              description 'Interval after which a neighbor is declared dead.' ;
              type string {
                length 1..15 ;

              }

            }

            leaf options-field {
              description 'Option of neighbor.' ;
              type uint8 ;

            }

            container options {
              description 'The options field.' ;
              leaf tos-bit {
                description 'This bit describes whether use the type of service.' ;
                type empty ;

              }

              leaf e-bit {
                description 'This bit describes the way AS-external-LSAs are flooded.' ;
                type empty ;

              }

              leaf mc-bit {
                description 'This bit describes whether IP multicast datagrams are forwarded according to the specifications.' ;
                type empty ;

              }

              leaf n-bit {
                description 'The area of router is NSSA area.' ;
                type empty ;

                ncd:revise-date 2015-06-17 ;
              }

              leaf ea-bit {
                description "This bit describes the router's willingness to receive and forward External-Attributes-LSAs." ;
                type empty ;

              }

              leaf dc-bit {
                description "This bit describes the router's handling of demand circuits." ;
                type empty ;

              }

              leaf o-bit {
                description "This bit describes the router's willingness to receive and forward Opaque-LSAs as specified." ;
                type empty ;

              }

              leaf dn-bit {
                description 'This bit is used to ensure that if any CE router sends this type 3 LSA to a PE router, the PE router will not redistribute it further.' ;
                type empty ;

              }

            }

            leaf full-time {
              description 'The during time that neighbor is in the full state.' ;
              type string {
                length 1..15 ;

              }

            }

            ncd:select process-id ;
          }

        }

      }

      container vertexes {
        description 'OSPFv2 vertex.' ;
        list vertex {
          description 'OSPFv2 vertex.' ;
          key 'process-id area-id vertex-type advertising-router link-state-id' ;
          leaf process-id {
            description 'OSPF process ID.' ;
            type uint32 {
              range 1..65535 ;

            }

          }

          leaf area-id {
            description 'Area ID.' ;
            type ncd:ipv4-address ;

          }

          leaf vertex-type {
            description 'Vertex type.' ;
            type enumeration {
              enum Router {
                value 0 ;
                description 'Router vertex.' ;
              }

              enum Network {
                value 1 ;
                description 'Network vertex.' ;
              }

            }

          }

          leaf advertising-router {
            description 'Advertising router.' ;
            type ncd:ipv4-address ;

          }

          leaf link-state-id {
            description 'Link state ID' ;
            type ncd:ipv4-address ;

          }

          leaf primary-nh-cost {
            description 'Primary nexthop cost of vertex.' ;
            type uint32 {
              range 1..4294967295 ;

            }

          }

          container nexthops {
            description 'Nexthop.' ;
            list nexthop {
              description 'Nexthop.' ;
              key 'primary-nh-if-index primary-nh-type primary-nh-ip' ;
              leaf primary-nh-if-index {
                description 'Interface index of primary nexthop.' ;
                type uint32 {
                  range 1..4294967295 ;

                }

              }

              leaf primary-nh-type {
                description 'Type of primary nexthop.' ;
                type enumeration {
                  enum Nh-nbr {
                    value 1 ;
                    description 'Nexthop for neighbor.' ;
                  }

                  enum Nh-tunnel {
                    value 2 ;
                    description 'Nexthop for tunnel.' ;
                  }

                  enum Nh-virtual {
                    value 3 ;
                    description 'Nexthop for virtual.' ;
                  }

                  enum Nh-local {
                    value 4 ;
                    description 'Nexthop for local.' ;
                  }

                  enum Nh-shamlink {
                    value 5 ;
                    description 'Nexthop for shamlink.' ;
                  }

                }

              }

              leaf primary-nh-ip {
                description 'Ip address of primary nexthop.' ;
                type ncd:ipv4-address ;

              }

              leaf primary-nh-if-name {
                description 'Interface name of primary nexthop.' ;
                type ncd:ifname {
                  length 1..31 ;

                }

              }

              container backup-nexthops {
                description 'Backup nexthop.' ;
                container dynamic-remote-lfas {
                  description 'Dynamic remote LFA.' ;
                  list dynamic-remote-lfa {
                    description 'Dynamic remote LFA.' ;
                    key 'nh-if-index nh-type nh-ip' ;
                    leaf nh-if-index {
                      description 'Interface index of drlfa nexthop.' ;
                      type uint32 {
                        range 1..4294967295 ;

                      }

                    }

                    leaf nh-type {
                      description 'Type of of drlfa nexthop.' ;
                      type enumeration {
                        enum Nh-nbr {
                          value 1 ;
                          description 'Nexthop for neighbor.' ;
                        }

                        enum Nh-tunnel {
                          value 2 ;
                          description 'Nexthop for tunnel.' ;
                        }

                        enum Nh-virtual {
                          value 3 ;
                          description 'Nexthop for virtual.' ;
                        }

                        enum Nh-local {
                          value 4 ;
                          description 'Nexthop for local.' ;
                        }

                        enum Nh-shamlink {
                          value 5 ;
                          description 'Nexthop for shamlink.' ;
                        }

                      }

                    }

                    leaf nh-ip {
                      description 'Ip address of drlfa nexthop .' ;
                      type ncd:ipv4-address ;

                    }

                    leaf nh-if-name {
                      description 'Interface name of drlfa nexthop.' ;
                      type ncd:ifname {
                        length 1..31 {
                          description 'Backup next hop interface name' ;
                        }

                      }

                    }

                    leaf nh-cost {
                      description 'Cost of drlfa nexthop.' ;
                      type uint32 {
                        range 1..4294967295 {
                          description 'Backup next hop cost' ;
                        }

                      }

                    }

                    leaf session-type {
                      description 'Session type.' ;
                      type enumeration {
                        enum mpls-ldp {
                          value 1 ;
                          description 'MPLS LDP.' ;
                        }

                      }

                    }

                    leaf peer-session-id {
                      description 'Peer session id.' ;
                      type ncd:ipv4-address ;

                    }

                    leaf peer-metric {
                      description 'Peer metric.' ;
                      type uint32 ;

                    }

                    leaf protect-type-s-pq {
                      description 'The protect type of S to PQ.' ;
                      type enumeration {
                        enum NULL {
                          value 0 ;
                          description 'Protect type is NULL.' ;
                        }

                        enum Link {
                          value 1 ;
                          description 'Link protection.' ;
                        }

                        enum Node {
                          value 2 ;
                          description 'Node protection.' ;
                        }

                        enum Link-node {
                          value 3 ;
                          description 'Link and node protection.' ;
                        }

                      }

                    }

                    leaf protect-type-pq-d {
                      description 'The protect type of PQ to D.' ;
                      type enumeration {
                        enum NULL {
                          value 0 ;
                          description 'NULL' ;
                        }

                        enum Node {
                          value 1 ;
                          description 'Node protection.' ;
                        }

                        enum Downstream {
                          value 2 ;
                          description 'Downstream protection.' ;
                        }

                        enum Node-downstream {
                          value 3 ;
                          description 'Node and downstream protection.' ;
                        }

                      }

                    }

                    leaf update-time {
                      description 'Update time.' ;
                      type string ;

                    }

                    leaf session-status {
                      description 'Session status.' ;
                      type enumeration {
                        enum Down {
                          value 0 ;
                          description 'Session status is Down.' ;
                        }

                        enum Up {
                          value 1 ;
                          description 'Session status is Up.' ;
                        }

                      }

                    }

                  }

                }

              }

            }

          }

          ncd:select process-id ;
          ncd:select advertising-router ;
          ncd:select "process-id advertising-router" ;
        }

        ncd:revise-date 2015-10-20 ;
      }

    }

    ncd:revise-date 2015-03-26 ;
  }

  container operation {
    config false ;
    description 'Operation mode.' ;
    container ospfv2 {
      description 'Operation of OSPFv2.' ;
      container clear {
        description 'Clear Operation.' ;
        container process {
          description 'Reset an OSPF process based on the process ID.' ;
          leaf process-id {
            description 'OSPF process ID.' ;
            type uint32 {
              range 1..65535 ;

            }

          }

        }

        container redistribution {
          description 'Clear OSPF route redistribution based on the process ID.' ;
          leaf process-id {
            description 'OSPF process ID.' ;
            type uint32 {
              range 1..65535 ;

            }

          }

        }

      }

    }

    ncd:revise-date 2015-03-26 ;
  }

  notification notification {
    description 'Notification of OSPFv2,only telemetry upload is supported.' ;
    container neighbors {
      config false ;
      description 'OSPFv2 neighbor.' ;
      container normal-nbrs {
        description 'normal-neighbors' ;
        list normal-nbr {
          description 'OSPFv2 normal neighbor.' ;
          key 'proc-id area-ip if-name nbr-id' ;
          leaf proc-id {
            description 'OSPF process ID.' ;
            type uint32 {
              range 1..65535 {
                description 'Ospf process ID.' ;
              }

            }

          }

          leaf area-ip {
            description 'OSPF area ID.' ;
            type ncd:ipv4-address ;

          }

          leaf if-name {
            description 'Interface name.' ;
            type ncd:ifname {
              length 1..31 {
                description 'The length of interface name from 1 to 31.' ;
              }

            }

          }

          leaf nbr-id {
            description 'Router ID of the neighbor.' ;
            type ncd:ipv4-address ;

          }

          leaf nbr-state {
            description 'The state of OSPF neighbor.' ;
            type enumeration {
              enum Down {
                value 0 ;
                description 'The state of OSPF neighbor is Down.' ;
              }

              enum Attempt {
                value 1 ;
                description 'The state of OSPF neighbor is Attempt.' ;
              }

              enum Init {
                value 2 ;
                description 'The state of OSPF neighbor is Init.' ;
              }

              enum 2-Way {
                value 3 ;
                description 'The state of OSPF neighbor is 2-Way.' ;
              }

              enum ExStart {
                value 4 ;
                description 'The state of OSPF neighbor is ExStart.' ;
              }

              enum Exchange {
                value 5 ;
                description 'The state of OSPF neighbor is Exchange.' ;
              }

              enum Loading {
                value 6 ;
                description 'The state of OSPF neighbor is Loading.' ;
              }

              enum Full {
                value 7 ;
                description 'The state of OSPF neighbor is Full.' ;
              }

              enum Unknown {
                value 8 ;
              }

            }

          }

        }

      }

      container virtual-nbrs {
        description 'OSPFv2 virtual neighbor.' ;
        list virtual-nbr {
          description 'OSPFv2 virtual neighbor.' ;
          key 'proc-id transit-area-ip nbr-id' ;
          leaf proc-id {
            description 'OSPF process ID.' ;
            type ncd:terminal-based-uint32 {
              range 1..65535 {
                description 'OSPF process ID.' ;
              }

            }

          }

          leaf transit-area-ip {
            description 'The transit area of virtual link.' ;
            type ncd:ipv4-address ;

          }

          leaf nbr-id {
            description 'Router ID of the neighbor.' ;
            type ncd:ipv4-address ;

          }

          leaf nbr-state {
            description 'The state of OSPF neighbor.' ;
            type enumeration {
              enum Down {
                value 0 ;
                description 'The state of OSPF neighbor is Down.' ;
              }

              enum Attempt {
                value 1 ;
                description 'The state of OSPF neighbor is Attempt.' ;
              }

              enum Init {
                value 2 ;
                description 'The state of OSPF neighbor is Init.' ;
              }

              enum 2-Way {
                value 3 ;
                description 'The state of OSPF neighbor is 2-Way.' ;
              }

              enum ExStart {
                value 4 ;
                description 'The state of OSPF neighbor is ExStart.' ;
              }

              enum Exchange {
                value 5 ;
                description 'The state of OSPF neighbor is Exchange.' ;
              }

              enum Loading {
                value 6 ;
                description 'The state of OSPF neighbor is Loading.' ;
              }

              enum Full {
                value 7 ;
                description 'The state of OSPF neighbor is Full.' ;
              }

              enum Unknown {
                value 8 ;
              }

            }

          }

        }

      }

      container shamlink-nbrs {
        description 'OSPFv2 sham-link neighbor.' ;
        list shamlink-nbr {
          description 'OSPFv2 sham-link neighbor.' ;
          key 'proc-id area-ip local-ip nbr-ip' ;
          leaf proc-id {
            description 'OSPF process ID.' ;
            type uint32 {
              range 1..65535 {
                description 'OSPF process ID.' ;
              }

            }

          }

          leaf area-ip {
            description 'OSPF area ID.' ;
            type ncd:ipv4-address ;

          }

          leaf local-ip {
            description 'Local ip address of sham-link.' ;
            type ncd:ipv4-address ;

          }

          leaf nbr-ip {
            description 'IP address of the neighbor.' ;
            type ncd:ipv4-address ;

          }

          leaf nbr-state {
            description 'The state of OSPF neighbor.' ;
            type enumeration {
              enum Down {
                value 0 ;
                description 'The state of OSPF neighbor is Down.' ;
              }

              enum Attempt {
                value 1 ;
                description 'The state of OSPF neighbor is Attempt.' ;
              }

              enum Init {
                value 2 ;
                description 'The state of OSPF neighbor is Init.' ;
              }

              enum 2-Way {
                value 3 ;
                description 'The state of OSPF neighbor is 2-Way.' ;
              }

              enum ExStart {
                value 4 ;
                description 'The state of OSPF neighbor is ExStart.' ;
              }

              enum Exchange {
                value 5 ;
                description 'The state of OSPF neighbor is Exchange.' ;
              }

              enum Loading {
                value 6 ;
                description 'The state of OSPF neighbor is Loading.' ;
              }

              enum Full {
                value 7 ;
                description 'The state of OSPF neighbor is Full.' ;
              }

              enum Unknown {
                value 8 ;
              }

            }

          }

        }

      }

    }

    container interfaces {
      config false ;
      container normal-ifs {
        description 'OSPFv2 interface.' ;
        list normal-if {
          description 'OSPFv2 interface.' ;
          key 'proc-id if-name area-ip' ;
          leaf proc-id {
            description 'OSPFv2 process ID.' ;
            type uint32 {
              range 1..65535 {
                description 'Ospf process ID.' ;
              }

            }

          }

          leaf area-ip {
            description 'OSPF area ID.' ;
            type ncd:ipv4-address ;

          }

          leaf if-name {
            description 'OSPFv2 interface name.' ;
            type ncd:ifname {
              length 1..31 {
                description 'The length of interface name from 1 to 31.' ;
              }

            }

          }

          leaf if-state {
            description 'OSPFv2 interface state.' ;
            type enumeration {
              enum Down {
                value 0 ;
                description 'Down state.' ;
              }

              enum Loopback {
                value 1 ;
                description 'Loopback state.' ;
              }

              enum Waiting {
                value 2 ;
                description 'Waiting state.' ;
              }

              enum Point-to-point {
                value 3 ;
                description 'Point-to-point state.' ;
              }

              enum DR {
                value 4 ;
                description 'DR state.' ;
              }

              enum Backup {
                value 5 ;
                description 'Backup state.' ;
              }

              enum DROther {
                value 6 ;
                description 'DROther state.' ;
              }

              enum Unknown {
                value 7 ;
              }

            }

          }

          leaf event {
            description 'OSPFv2 interface state change reason.' ;
            type string {
              length 1..31 {
                description 'The length of interface state change reason from 1 to 31.' ;
              }

            }

          }

        }

      }

      container virtual-links {
        list virtual-link {
          key 'proc-id transit-area-ip nbr-id' ;
          leaf proc-id {
            description 'Ospf process ID.' ;
            type uint32 {
              range 1..65535 {
                description 'Ospf process ID.' ;
              }

            }

          }

          leaf transit-area-ip {
            description 'The transit area of virtual link.' ;
            type ncd:ipv4-address ;

          }

          leaf nbr-id {
            description 'ID associated with virtual link neighbor.' ;
            type ncd:ipv4-address ;

          }

          leaf if-state {
            description 'OSPFv2 interface state.' ;
            type enumeration {
              enum Down {
                value 0 ;
                description 'Down state.' ;
              }

              enum Loopback {
                value 1 ;
                description 'Loopback state.' ;
              }

              enum Waiting {
                value 2 ;
                description 'Waiting state.' ;
              }

              enum Point-to-point {
                value 3 ;
                description 'Point-to-point state.' ;
              }

              enum DR {
                value 4 ;
                description 'DR state.' ;
              }

              enum Backup {
                value 5 ;
                description 'Backup state.' ;
              }

              enum DROther {
                value 6 ;
                description 'DROther state.' ;
              }

              enum Unknown {
                value 7 ;
                description 'Unknown state.' ;
              }

            }

            default Down ;
          }

          leaf event {
            description 'OSPFv2 interface state change reason.' ;
            type string {
              length 1..31 {
                description 'The length of interface state change reason from 1 to 31.' ;
              }

            }

          }

        }

      }

      container sham-links {
        list sham-link {
          key 'proc-id area-ip local-ip nbr-ip' ;
          leaf proc-id {
            description 'OSPF process ID.' ;
            type uint32 {
              range 1..65535 {
                description 'Ospf process ID from 1 to 65535' ;
              }

            }

          }

          leaf area-ip {
            description 'Area ID.' ;
            type ncd:ipv4-address ;

          }

          leaf local-ip {
            description 'Local ip address of sham-link.' ;
            type ncd:ipv4-address ;

          }

          leaf nbr-ip {
            description 'IP address of the neighbor.' ;
            type ncd:ipv4-address ;

          }

          leaf if-state {
            description 'OSPFv2 interface state.' ;
            type enumeration {
              enum Down {
                value 0 ;
                description 'Down state.' ;
              }

              enum Loopback {
                value 1 ;
                description 'Loopback state.' ;
              }

              enum Waiting {
                value 2 ;
                description 'Waiting state.' ;
              }

              enum Point-to-point {
                value 3 ;
                description 'Point-to-point state.' ;
              }

              enum DR {
                value 4 ;
                description 'DR state.' ;
              }

              enum Backup {
                value 5 ;
                description 'Backup state.' ;
              }

              enum DROther {
                value 6 ;
                description 'DROther state.' ;
              }

              enum Unknown {
                value 7 ;
                description 'Unknown state.' ;
              }

            }

            default Down ;
          }

          leaf event {
            description 'OSPFv2 interface state change reason.' ;
            type string {
              length 1..31 {
                description 'The length of interface state change reason from 1 to 31.' ;
              }

            }

          }

        }

      }

    }

    container nbr-flapping {
      config false ;
      description 'OSPFv2 neighbor flapping.' ;
      container nbrs {
        description 'neighbors' ;
        list nbr {
          description 'OSPFv2 neighbor.' ;
          key 'proc-id area-ip if-name nbr-id' ;
          leaf proc-id {
            description 'OSPF process ID.' ;
            type uint32 {
              range 1..65535 {
                description 'Ospf process ID.' ;
              }

            }

          }

          leaf area-ip {
            description 'OSPF area ID.' ;
            type ncd:ipv4-address ;

          }

          leaf if-name {
            description 'Interface name.' ;
            type ncd:ifname {
              length 1..31 {
                description 'The length of interface name from 1 to 31.' ;
              }

            }

          }

          leaf nbr-id {
            description 'Router ID of the neighbor.' ;
            type ncd:ipv4-address ;

          }

          leaf flapping-state {
            description 'OSPF neighbor flapping state.' ;
            type enumeration {
              enum normal {
                value 0 ;
                description 'The flapping state of OSPF neighbor is normal.' ;
              }

              enum holdDown {
                value 1 ;
                description 'The flapping state of OSPF neighbor is holdDown.' ;
              }

              enum maxCost {
                value 2 ;
                description 'The flapping state of OSPF neighbor is maxCost.' ;
              }

            }

          }

        }

      }

    }

    container nbr-cnts {
      description 'OSPFv2 neighbor count information.' ;
      list nbr-cnt {
        leaf proc-id {
          type uint32 {
            range 1..65535 ;

          }

          description 'OSPFv2 process ID.' ;
        }

        leaf total-nbr-cnt {
          type uint32 ;

          description 'The total count of OSPF neighbors.' ;
        }

        leaf full-nbr-cnt {
          type uint32 ;

          description 'The count of OSPF adjacent neighbors.' ;
        }

        key proc-id ;
        description 'OSPFv2 neighbor count.' ;
      }

      ncd:revise-date 2023-05-17 ;
    }

    container sample {
      container neighbors {
        container normal-nbrs {
          list normal-nbr {
            leaf proc-id {
              type uint32 {
                range 1..65535 {
                  description 'Ospf process ID.' ;
                }

              }

              description 'OSPF process ID.' ;
            }

            leaf area-ip {
              type ncd:ipv4-address ;

              description 'OSPF area ID.' ;
            }

            leaf if-name {
              type ncd:ifname {
                length 1..31 {
                  description 'The length of interface name from 1 to 31.' ;
                }

              }

              description 'Interface name.' ;
            }

            leaf nbr-id {
              type ncd:ipv4-address ;

              description 'Router ID of the neighbor.' ;
            }

            leaf nbr-state {
              type enumeration {
                enum Down {
                  value 0 ;
                  description 'The state of OSPF neighbor is Down.' ;
                }

                enum Attempt {
                  value 1 ;
                  description 'The state of OSPF neighbor is Attempt.' ;
                }

                enum Init {
                  value 2 ;
                  description 'The state of OSPF neighbor is Init.' ;
                }

                enum 2-Way {
                  value 3 ;
                  description 'The state of OSPF neighbor is 2-Way.' ;
                }

                enum ExStart {
                  value 4 ;
                  description 'The state of OSPF neighbor is ExStart.' ;
                }

                enum Exchange {
                  value 5 ;
                  description 'The state of OSPF neighbor is Exchange.' ;
                }

                enum Loading {
                  value 6 ;
                  description 'The state of OSPF neighbor is Loading.' ;
                }

                enum Full {
                  value 7 ;
                  description 'The state of OSPF neighbor is Full.' ;
                }

                enum Unknown {
                  value 8 ;
                }

              }

              description 'The state of OSPF neighbor.' ;
            }

            key 'proc-id area-ip if-name nbr-id' ;
            description 'OSPFv2 normal neighbor.' ;
          }

          description 'normal-neighbors' ;
        }

        description 'OSPFv2 neighbor.' ;
      }

      container nbr-cnts {
        list nbr-cnt {
          leaf proc-id {
            type uint32 {
              range 1..65535 ;

            }

            description 'OSPFv2 process ID.' ;
          }

          leaf total-nbr-cnt {
            type uint32 ;

            description 'The total count of OSPF neighbors.' ;
          }

          leaf full-nbr-cnt {
            type uint32 ;

            description 'The count of OSPF adjacent neighbors.' ;
          }

          key proc-id ;
          description 'OSPFv2 neighbor count.' ;
        }

        description 'OSPFv2 neighbor count information.' ;
      }

      description 'Periodic sampling of OSPFv2,only telemetry upload is supported.' ;
      ncd:revise-date 2025-02-05 ;
    }

    ncd:revise-date 2022-01-11 ;
  }

