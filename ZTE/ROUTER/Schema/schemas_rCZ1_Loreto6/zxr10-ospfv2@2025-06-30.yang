                    enum no-config {
                      value 0 ;
                      description 'no-config' ;
                    }

                    enum enable {
                      value 1 ;
                      description 'enable' ;
                    }

                    enum disable {
                      value 2 ;
                      description 'disable' ;
                    }

                  }

                  default no-config ;
                }

                leaf auto-flag {
