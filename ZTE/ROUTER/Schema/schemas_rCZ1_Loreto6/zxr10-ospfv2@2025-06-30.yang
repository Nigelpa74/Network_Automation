              units second ;
            }

            leaf retransmit-interval {
              description 'Time between retransmitting lost link state advertisements,Seconds.' ;
              type uint32 {
                range 1..8192 {
                  description 'Time between retransmitting lost link state advertisements,Seconds.' ;
                }

              }

              units second ;
            }

            leaf neighbor-state {
              description 'State machine of neighbor.' ;
              type enumeration {
                enum Down {
                  value 0 ;
                  description 'This is the initial state of a neighbor conversation.' ;
                }

                enum Init {
                  value 2 ;
                  description 'In this state, an Hello packet has recently been seen from the neighbor.' ;
                }

                enum 2-Way {
                  value 3 ;
                  description 'In this state, communication between the two routers is bidirectional.' ;
                }

                enum ExStart {
                  value 4 ;
                  description 'This is the first step in creating an adjacency between the two neighboring routers.' ;
                }

                enum Exchange {
                  value 5 ;
                  description 'In this state the router is describing its entire link state database by sending Database Description packets to the neighbor.' ;
                }

                enum Loading {
                  value 6 ;
                  description 'In this state, Link State Request packets are sent to the neighbor asking for the more recent LSAs that have been discovered (but not yet received) in the Exchange state.' ;
                }

                enum Full {
                  value 7 ;
                  description 'In this state, the neighboring routers are fully adjacent.' ;
                }

              }

            }

            leaf dead-time {
              description 'Remain time for neighbor.' ;
              type string {
                length 1..15 ;

              }

            }

            leaf full-time {
              description 'Full time of neighbor.' ;
              type string {
                length 1..15 ;

              }

            }

            leaf options-field {
              description 'Option of neighbor.' ;
              type uint8 ;

              ncd:revise-date 2015-06-17 ;
            }

            container options {
              description 'The options field.' ;
              leaf tos-bit {
                description "This bit describes the router's supporting of tos." ;
                type empty ;

              }

              leaf e-bit {
                description 'The area of router is transit area.' ;
                type empty ;

              }

              leaf mc-bit {
                description 'This bit describes whether IP multicast datagrams are forwarded.' ;
                type empty ;

              }

              leaf n-bit {
                description 'The area of router is NSSA area.' ;
