              }

              leaf dc-bit {
                description "This bit describes the router's handling of demand circuits." ;
                type empty ;

              }

              leaf o-bit {
                description "This bit describes the router's willingness to receive and forward opaque-LSAS." ;
                type empty ;

              }

              leaf dn-bit {
                description 'When a type 3 LSA is sent from a PE router to a CE router, the DN bit in the LSA Options field MUST be set.' ;
                type empty ;

              }

              ncd:revise-date 2015-06-17 ;
            }

            ncd:select process-id ;
          }

