  revision 2013-12-19 {
    description 'Initial version.' ;
  }

  feature ti-lfa {
    description 'The feature is for TI-LFA.' ;
  }

  feature segment-routing {
    description 'SR support labels' ;
  }

  feature distance-policy {
    description 'The feature is for distance-policy.' ;
  }

  container configuration {
    description 'Configure OSPFV2 parameters.' ;
    container global {
        description 'Configure OSPFv2 global parameters.' ;

        leaf memory-overload-protection {
          type enumeration {
            enum enable {
              value 1 ;
              description 'Enable memory overload protection' ;
            }

            enum disable {
              value 0 ;
              description 'Disable memory overload protection' ;
            }

          }

          description 'Configure memory overload protection for OSPFv2.' ;
          default disable ;
        }
        ncd:revise-date 2025-06-30 ;

      }
    container ospfv2 {
      description 'Configure OSPFV2 parameters.' ;
      container processes {
        description 'Ospf Instance' ;
        list process {
          description 'Ospf Instance' ;
          key pro-id ;
          leaf pro-id {
            description 'Ospf process ID' ;
            type uint32 {
              range 1..65535 {
                description 'Ospf process ID from 1 to 65535' ;
              }

            }

          }

          leaf vrf-name {
            description 'Vrf name' ;
            type string {
              length 1..32 {
                description 'Characters from 1 to 32' ;
              }

            }

          }

          leaf lsa-pacing {
            description 'Ospf LSA group pacing timers,Secs between group of LSA being refreshed' ;
            type uint32 {
              range 1..1800 {
                description 'Secs between group of LSA being refreshed' ;
              }

            }

            units second ;
            default 1 ;
          }

          leaf timer-frr {
            description 'Ospf ipfrr spf timers, hold time in secs between consecutive spf' ;
            type uint32 {
              range 1..65535 {
                description 'Ospf ipfrr spf timers, hold time in secs between consecutive spf' ;
              }

            }

            units second ;
            default 1 ;
          }

          leaf maximum-paths {
            description 'Maximum number of parallel routes OSPF can support.The default value of product can be customized with performance parameters.If not, the default value is 1.' ;
            type uint32 {
              range 1..128 {
                description 'Maximum number of parallel routes OSPF can support' ;
              }

            }

            default 1 ;
          }

          leaf default-metric {
            description 'Ospf default metric' ;
            type uint32 {
              range 1..16777214 {
                description 'Ospf default metric form 1 to 16777214' ;
              }

            }

            default 20 ;
          }

          leaf auto-cost {
            description 'Calculate OSPF interface cost according to bandwidth, the reference bandwidth in terms of Mbps' ;
            type uint32 {
              range 1..4000000 {
                description 'The reference bandwidth in terms of Mbps' ;
              }

            }

            units Mbps ;
            default 100 ;
          }

          leaf debug-flag {
            description 'Ospf debug information' ;
            type enumeration {
              enum disable {
                value 1 ;
                description 'disable' ;
              }

              enum enable {
                value 2 ;
                description 'enable' ;
              }

            }

            default enable ;
          }

          leaf cap-opaque {
            description 'Ospf Opaque LSA function' ;
            type enumeration {
              enum disable {
                value 1 ;
                description 'disable' ;
              }

              enum enable {
                value 2 ;
                description 'enable' ;
              }

            }

            default enable ;
          }

          leaf cap-vrflite {
            description 'Ignore ospf vrf loop-prevention' ;
            type enumeration {
              enum enable {
                value 1 ;
                description 'enable' ;
              }

              enum disable {
                value 2 ;
                description 'disable' ;
              }

            }

            default disable ;
          }

          leaf rfc1583-value {
            description 'Ospf compatible with rfc1583 when calculating external route' ;
