              }

              enum disable {
                value 2 ;
                description 'disable' ;
              }

            }

            default disable ;
          }

          leaf ttl-security {
            description 'Configure all interfaces ttl-security hops' ;
            type int32 {
              range 1..254 {
                description 'Ttl-security hops' ;
              }

