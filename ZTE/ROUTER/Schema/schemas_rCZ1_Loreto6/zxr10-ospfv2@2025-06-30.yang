            }

            container bfd-parameter {
              description 'BFD parameters.' ;
              presence bfd-parameter ;
              leaf interval {
                description 'Minimum send interval.' ;
                type uint32 {
                  range 1..65535 ;

                }

                units millisecond ;
                mandatory true ;
              }

              leaf min-rx {
                description 'Minimum receive interval' ;
                type uint32 {
                  range 1..65535 ;

                }

                units millisecond ;
                mandatory true ;
              }

              leaf multiplier {
                description 'Multiplier.' ;
                type uint32 {
                  range 3..50 ;

                }

                mandatory true ;
              }

            }

          }

          container bfd-template {
