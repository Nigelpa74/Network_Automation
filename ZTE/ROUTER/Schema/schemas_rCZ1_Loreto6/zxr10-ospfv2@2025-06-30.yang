                                      type string {
                                        length 1..16 ;

                                      }

                                      mandatory true ;
                                    }

                                  }

                                  case encrypted {
                                    leaf encry-secret-key {
                                      description 'Encrypted password to be configured' ;
                                      type string {
                                        length 1..128 ;

                                      }

                                      mandatory true ;
                                    }

                                    ncd:revise-date 2019-12-16 ;
                                  }

                                }

                                leaf delay-time {
                                  description 'A period of time in minutes' ;
                                  type uint32 {
                                    range 0..100000 ;

                                  }

                                  units minute ;
                                  default 0 ;
                                }

                              }

                            }

                          }

                          container authtype {
                            description 'The authentication type of virtual link' ;
                            container authtype {
                              description 'The authentication type of virtual link' ;
                              choice authtype {
                                description 'The authentication type of virtual link' ;
                                case null {
                                  description 'No authentication' ;
                                  container null {
                                    description 'No authentication' ;
                                    presence null ;
                                    leaf null {
