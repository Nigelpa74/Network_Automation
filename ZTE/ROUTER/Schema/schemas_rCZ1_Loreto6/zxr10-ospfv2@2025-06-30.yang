                            type uint32 {
                              range 1..8192 {
                                description 'Retransmit interval,Seconds' ;
                              }

                            }

                            units second ;
                            default 5 ;
                          }

                          leaf transmitdelay {
                            description 'Transmit delay,Seconds' ;
                            type uint32 {
                              range 1..8192 {
                                description 'Transmit delay,Seconds' ;
                              }

                            }

                            units second ;
                            default 1 ;
                          }

                          leaf deadinterval {
