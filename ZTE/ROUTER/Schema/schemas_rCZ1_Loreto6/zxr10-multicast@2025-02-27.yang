              ncd:select vrf-name ;
            }

            ncd:revise-date 2016-11-29 ;
          }

        }

      }

    }

    ncd:revise-date 2015-03-31 ;
  }

  container operation {
    config false ;
    description 'Operation module.' ;
    container multicast {
      description 'Multicast' ;
      container public {
        description 'Public mode of multicast' ;
        container clear {
          description 'Clear node' ;
          container mroutes {
            description 'Multicast route.' ;
            list source-group {
              description 'Clear mroute of the designed source and group address.' ;
              key 'group source' ;
              leaf group {
                description 'Group address' ;
                type ncd:ipv4-address ;

              }

              leaf source {
                description 'Source address' ;
                type ncd:ipv4-address ;

              }

            }

            list group {
              description 'Clear mroute of the designed group address.' ;
              key group ;
              leaf group {
                description 'Group address' ;
                type ncd:ipv4-address ;

              }

            }

            container mroute {
              description 'Clear multicast public route.' ;
              leaf public {
                description 'Public' ;
                type empty ;

              }

            }

          }

        }

      }

      container private {
        description 'Private mode of multicast' ;
        container clear {
          description 'Clear node' ;
          container mroutes {
            description 'Multicast route.' ;
            list source-group {
              description 'Clear mroute of the designed vrf name,source and group address.' ;
              key 'vrf-name group source' ;
              leaf vrf-name {
                description 'VRF name' ;
                type string {
                  length 1..32 ;

                }

              }

              leaf group {
                description 'Group address' ;
                type ncd:ipv4-address ;

              }

              leaf source {
                description 'Source address' ;
                type ncd:ipv4-address ;

              }

            }

            list group {
              description 'Clear mroute of the designed vrf name and group address.' ;
              key 'vrf-name group' ;
              leaf vrf-name {
                description 'VRF name' ;
                type string {
                  length 1..32 ;

                }

              }

              leaf group {
                description 'Group address' ;
                type ncd:ipv4-address ;

              }

            }

            list mroute {
              description 'Clear mroute of the designed vrf name.' ;
              key vrf-name ;
              leaf vrf-name {
                description 'VRF name' ;
                type string {
                  length 1..32 ;

                }

              }

            }

          }

        }

      }

    }

    ncd:revise-date 2015-03-31 ;
  }

  notification mroute-summary {
    container all {
      config false ;
      description 'global and vrf mroute summary' ;
      leaf xg-count {
        description 'Total number of XG routes' ;
        type uint32 ;

      }

      leaf sg-count {
        description 'Total number of SG routes' ;
        type uint32 ;

      }

      leaf total-count {
        description 'Total number of multicast routes' ;
        type uint32 ;

      }

    }

    list specific {
      config false ;
      key vrf-name ;
      leaf vrf-name {
        description 'VRF name' ;
        type ncd:string-quesiton-mark ;

      }

      leaf xg-count {
        description 'Total number of XG routes' ;
        type uint32 ;

      }

      leaf sg-count {
        description 'Total number of SG routes' ;
        type uint32 ;

      }

      leaf total-count {
        description 'Total number of multicast routes' ;
        type uint32 ;

      }

    }

    ncd:revise-date 2021-12-08 ;
  }

}
