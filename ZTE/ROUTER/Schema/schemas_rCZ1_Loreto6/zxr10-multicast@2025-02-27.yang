    description '1.modify the length of the leaf: /configuration/ip-multicast/vrf-multicasts/vrf-multicast/vrfname ;' ;
  }

  revision 2015-01-20 {
    description '1.modify the range and description of the leaf: /configuration/ip-multicast/multicast/global/downstream-limit ;
2.modify the description of the leaf: /configuration/ip-multicast/multicast/global/mroute-limit ;' ;
  }

  revision 2014-09-01 {
    description '1.modify the range of the leaf: /configuration/ip-multicast/multicast/global/multipath-sghash;
2.modify the range of the leaf: /configuration/ip-multicast/vrf-multicasts/vrf-multicast/multipath-sghash;
3.modify the name of enum item of the leaf: /configuration/ip-multicast/multicast/global/multipath-sghash;
4.modify the name of enum item of the leaf: /configuration/ip-multicast/vrf-multicasts/vrf-multicast/multipath-sghash.' ;
  }

  revision 2014-07-25 {
    description "1.Add mdt-auto-discovery leaf node to /configuration/ip-multicast/vrf-multicasts/vrf-multicast.

    2./configuration/ip-multicast/vrf-multicasts/vrf-multicast/mdt-default's leaf node is changed to the choice node of mdt-default.

    3./configuration/ip-multicast/vrf-multicasts/vrf-multicast/mdt-data's leaf nodes are changed to the choice node of mdt-data." ;
  }

  revision 2014-04-10 {
    description 'modify the rang of mroute-limit from 1..131070 to 1..131072 
delete the default value of tos-value' ;
  }

  revision 2014-02-21 {
    description 'Initial version' ;
  }

  feature mvpn-cross-as {
    description 'Only for the use of HighEndPacket.15K,HighEndPacket.15K-GM,PC.MSE,6100 and MSE.M6000-S;add for the use of MSR.ASR,MSR.ZSRV2,PTN.6500,PTN.6700,PTN.65V5,PTN.61-SSP,PTN.61V5_1,HighEndRouter.T8000,MSE.M6000,MSE.xGW,FN.C600,FN.C89E,OTN.9700,OTN.8700,OTN.7000,MW.NR8000,V6000.vBRAS-C,V6000.CDB and ROSNG-V.COMMON.' ;
  }

  feature mvpn-switch-threshold {
    description 'Only for the use of HighEndPacket.15K,HighEndPacket.15K-GM,6100 and PC.MSE.' ;
  }

  container configuration {
    description 'Configuration model.' ;
    container ip-multicast {
      description 'Ip multicast' ;
      container multicast {
        description 'Multicast routing' ;
        presence multicast ;
        container global {
          description 'Global config' ;
          leaf mroute-limit {
            description "The max number of the multicast routes. It's top limit depends on ability of the device." ;
            type uint32 {
              range 1..262144 {
                description 'The max number of the multicast routes.' ;
              }

            }

          }

          leaf bgp-auto-discovery-inter-as {
            if-feature mvpn-cross-as ;

            description 'BGP auto-discovery of inter-AS MVPN.' ;
            type empty ;

            ncd:revise-date 2022-05-18 ;
          }

          leaf nsf-time {
            description 'NSF lifetime' ;
            type int32 {
              range 30..1800 {
                description 'NSF lifetime' ;
              }

            }

            units second ;
            default 60 ;
          }

          leaf downstream-limit {
            description "The max number of the multicast route forward table downstreams. It's top limit depends on ability of the device." ;
            type int32 {
              range 1..1024 {
                description 'The max number of the multicast route forward table downstreams.' ;
              }

            }

          }

          leaf damping-threshold {
            description 'Mroute flap damping threshold' ;
            type uint32 {
              range 2..100 {
                description 'Mroute flap damping threshold' ;
              }

            }

            default 5 ;
          }

          leaf multipath-sghash {
            description 'Multipath' ;
            type enumeration {
              enum s-hash-basic {
                value 1 ;
                description 'Multicast s-hash-basic' ;
              }

              enum sg-hash-basic {
                value 2 ;
                description 'Multicast s-g-hash basic' ;
              }

              enum sg-hash-nexthop-based {
                value 3 ;
                description 'Multicast s-g-hash next-hop-based' ;
              }

              enum sg-hash-balance {
                value 4 ;
                description 'Multicast s-g-hash balance' ;
              }

              enum g-hash-basic {
                value 5 ;
                description 'Multicast g-hash-basic' ;
              }

            }

          }

          leaf longest-match {
            description 'Nexthop longest match' ;
            type empty ;

          }

          leaf static-first {
            description 'Nexthop static first' ;
            type empty ;

          }

          leaf tos-value {
            description 'DSCP value' ;
            type uint8 {
              range 0..63 {
                description 'DSCP value' ;
              }

            }

          }

          leaf damping-enable {
            description 'Mroute flap damping enable' ;
            type empty ;

          }

          leaf rpf-proxy-vector {
            description 'RPF proxy vector for MDT.' ;
            type empty ;

          }

          leaf rpf-proxy-vector-mbgp {
            description 'RPF proxy vector ACL for MBGP.' ;
            type string {
              length 1..31 ;

            }

            ncd:revise-date 2015-11-20 ;
          }

          leaf mroute-limit-p-instance {
            description "The max number of the multicast routes attached to the global instance. It's top limit depends on ability of the device." ;
            type uint32 {
              range 1..262144 {
                description 'The max number of the multicast routes attached to the global instance.' ;
              }

            }

            ncd:revise-date 2015-11-26 ;
          }

          leaf ecmp-select-cost-first {
            description 'ECMP selecting of multicast route' ;
            type empty ;

            ncd:revise-date 2019-02-25 ;
          }

          leaf mvpn-frr-policy {
            description 'MVPN FRR policy.
2:hot-root-standby' ;
            type enumeration {
              enum hot-root-standby {
                value 2 ;
              }

            }

            ncd:revise-date 2020-06-20 ;
          }

          leaf mvpn-frr-detect-type {
            description 'MVPN FRR detect type.
1:stream detect' ;
            type enumeration {
              enum stream {
                value 1 ;
              }

            }

            ncd:revise-date 2021-07-01 ;
          }

          leaf mvpn-frr-egress-wtr {
            description 'Egress WTR delay time(second).' ;
            type uint16 {
              range 1..600 ;

            }

            ncd:revise-date 2020-06-20 ;
          }

          leaf ecmp-select-reference-bandwidth {
            description 'Select multicast nexthop based on reference bandwidth in terms of 10Gbps.' ;
            type empty ;

            ncd:revise-date 2021-01-19 ;
          }

          leaf mvpn-switchover-threshold-infinity {
            description 'ACL for MVPN tunnel never switch to data tree.' ;
            type string {
              length 1..31 ;

            }

            ncd:revise-date 2022-12-26 ;
          }

          leaf pim-neighbor-auto-discovery {
            description 'PIM neighbor auto discovery' ;
            type empty ;

            ncd:revise-date 2021-04-08 ;
          }

          leaf mvpn-frr-egress-wtr-infinity {
            description 'MVPN FRR egress WTR infinity.' ;
            type empty ;

            ncd:revise-date 2021-07-01 ;
          }

          leaf mvpn-frr-policy-acl {
            description 'MVPN FRR policy ACL.' ;
            type string {
              length 1..31 ;

            }

            ncd:revise-date 2021-07-01 ;
          }

          leaf mvpn-frr-support-ipmsi {
            description 'MVPN FRR support I-PMSI.' ;
            type empty ;

            ncd:revise-date 2022-12-26 ;
          }

          leaf mvpn-upstream-pe-select {
            description 'MVPN upstream PE select policy
1:lowest-addr-first
2:bgp-route-policy
3:bytewise-exclusive-or-hash' ;
            type enumeration {
              enum lowest-addr-first {
                value 1 ;
              }

              enum bgp-route-policy {
                value 2 ;
              }

              enum bytewise-exclusive-or-hash {
                value 3 ;
              }

            }

            ncd:revise-date 2021-10-13 ;
          }

          leaf mvpn-import-msdp {
            description 'MVPN SA import from MSDP.' ;
            type empty ;

            ncd:revise-date 2022-11-14 ;
          }

          leaf mvpn-export-msdp {
            description 'MVPN SA export to MSDP.' ;
            type empty ;

            ncd:revise-date 2022-11-14 ;
          }

          leaf mvpn-pim-hello-silent {
            description 'Disables the sending and receiving of PIM hello packets over MVPN tunnel.' ;
            type empty ;

            ncd:revise-date 2023-03-09 ;
          }

        }

        container monitor {
          description 'Monitor config' ;
          container intfs {
            description 'Monitor interface' ;
            list intf {
              description 'Monitor interface' ;
              max-elements 20 ;
              key intf-name ;
              leaf intf-name {
                description 'Interface name' ;
                type ncd:ifname {
                  length 1..31 ;

                }

              }

            }

          }

          container routers {
            description 'Monitor multicast routing table' ;
            list router {
              description 'Monitor multicast route table' ;
              max-elements 1000 ;
              key 'intf source group' ;
              leaf intf {
                description 'Interface name' ;
                type ncd:ifname {
                  length 1..31 ;

                }

              }

              leaf source {
                description 'Source address' ;
                type ncd:ipv4-address ;

              }

              leaf group {
                description 'Group address' ;
                type ncd:ipv4-address ;

              }

            }

          }

          container router-nointfs {
            description 'Monitor multicast route table' ;
            list router-nointf {
              description 'Monitor multicast route table' ;
              max-elements 1000 ;
              key 'source group' ;
              leaf source {
                description 'Source address' ;
                type ncd:ipv4-address ;

              }

              leaf group {
                description 'Group address' ;
                type ncd:ipv4-address ;

              }

            }

          }

        }

        container flt {
          description 'Filter config' ;
          container routes {
            description 'Monitor multicast route mode' ;
            list route {
              description 'Monitor multicast route mode' ;
              max-elements 1000 ;
              key 'source group' ;
              leaf source {
                description 'Source address' ;
                type ncd:ipv4-address ;

              }

              leaf group {
                description 'Group address' ;
                type ncd:ipv4-address ;

              }

              leaf flt-mode {
                description 'Route mode' ;
                type enumeration {
                  enum include {
                    value 0 ;
                    description 'Include mode' ;
                  }

                  enum exclude {
                    value 1 ;
                    description 'Exclude mode' ;
                  }

                }

                mandatory true ;
              }

            }

          }

          container rintfs {
            description 'Monitor multicast route interface' ;
            list rintf {
              description 'Monitor multicast route interface' ;
              max-elements 1000 ;
              key 'interface source group' ;
              leaf interface {
                description 'Interface name' ;
                type ncd:ifname {
                  length 1..31 ;

                }

              }

              leaf source {
                description 'Source address' ;
                type ncd:ipv4-address ;

              }

              leaf group {
                description 'Group address' ;
                type ncd:ipv4-address ;

              }

              leaf mr-type {
                description 'Route interface type' ;
                type enumeration {
                  enum add {
                    value 0 ;
                    description 'Route interface type' ;
                  }

                  enum delete {
                    value 1 ;
                    description 'Route interface type' ;
                  }

                }

                mandatory true ;
              }

            }

          }

          container fintfs {
            description 'Monitor multicast interface' ;
            list fintf {
              description 'Monitor multicast interface' ;
              max-elements 1000 ;
              key interface ;
              leaf interface {
                description 'Interface name' ;
                type ncd:ifname {
                  length 1..31 ;

                }

              }

              leaf mr-mode {
                description 'Route interface mode' ;
                type enumeration {
                  enum include {
                    value 0 ;
                    description 'Include mode' ;
                  }

                  enum exclude {
                    value 1 ;
                    description 'exclude mode' ;
                  }

                }

                mandatory true ;
              }

              leaf mr-type {
                description 'Route interface type' ;
                type enumeration {
                  enum add {
                    value 0 ;
                    description 'Add type' ;
                  }

                  enum delete {
                    value 1 ;
                    description 'Delete type' ;
                  }

                }

                mandatory true ;
              }

            }

          }

        }

        container forward-policy {
          description 'Forward policy' ;
          presence forward ;
          leaf acl {
            description 'Access list name' ;
            type string {
              length 1..31 ;

            }

          }

          leaf option {
            description 'Forward multicast traffic option' ;
            type enumeration {
              enum per-packet {
                value 1 ;
                description 'Forward multicast traffic by packet' ;
              }

              enum per-user {
                value 2 ;
                description 'Forward multicast traffic by user' ;
              }

              enum per-stream {
                value 3 ;
                description 'Forward multicast traffic by stream' ;
              }

            }

            mandatory true ;
          }

        }

        container biers {
          description 'Multicast BIER.' ;
          list bier {
            description 'Bit index explicit replication.' ;
            max-elements 256 ;
            key subdomain-id ;
            leaf subdomain-id {
              description 'Subdomain ID.' ;
              type uint8 {
                range 0..255 ;

              }

            }

            leaf bsl {
              description 'Bitstring length.' ;
              type enumeration {
                enum 256 {
                  value 3 ;
                }

                enum 512 {
                  value 4 ;
                }

              }

              ncd:revise-date 2020-12-22 ;
            }

            leaf entropy {
              description 'Entropy enable.' ;
              type empty ;

              ncd:revise-date 2021-03-17 ;
            }

            container bfer-indexs {
              description 'Bit forwarding egress routers index.' ;
              list bfer-index {
                description 'BFER index.' ;
                max-elements 65535 ;
                key 'index prefix' ;
                leaf index {
                  description 'BFER index.' ;
                  type uint32 {
                    range 1..100 ;

                  }

                }

                leaf prefix {
                  description 'BFER prefix.' ;
                  type ncd:ipv4-address ;

                }

              }

            }

          }

          ncd:revise-date 2017-10-18 ;
        }

        container nexthops {
          description 'Multicast static nexthop' ;
          list nexthop {
            description 'Multicast static nexthop' ;
            max-elements 3200 ;
            key 'intf-name ip-addr ip-mask next-hop-addr' ;
            leaf intf-name {
              description 'Interface name' ;
              type ncd:ifname {
                length 1..31 ;

              }

            }

            leaf ip-addr {
              description 'Prefix of destination IP address' ;
              type ncd:ipv4-address ;

            }

            leaf ip-mask {
              description 'Network mask' ;
              type ncd:ipv4-mask ;

            }

            leaf next-hop-addr {
              description 'Nexthop' ;
              type ncd:ipv4-address ;

            }

            leaf slave {
              description 'slave nexthop' ;
              type empty ;

            }

            leaf track-name {
              description 'Nexthop track name' ;
              type string {
                length 1..31 ;

              }

              ncd:revise-date 2017-01-09 ;
            }

            container nexthop-routes {
              description 'Select mroute' ;
              list nexthop-route {
                description 'Select mroute' ;
                max-elements 500 ;
                key 'ip-source ip-group' ;
                leaf ip-source {
                  description 'Source address' ;
                  type ncd:ipv4-address ;

                }

                leaf ip-group {
                  description 'Group address' ;
                  type ncd:ipv4-address ;

                }

              }

            }

          }

        }

        container nexthop-fallbacks {
          description 'Alternate routing table for nexthop lookup.' ;
          list nexthop-fallback {
            description 'Alternate routing table for nexthop lookup.' ;
            key 'ip-addr ip-mask' ;
            leaf ip-addr {
              description 'Prefix of destination IP address.' ;
              type ncd:ipv4-address ;

            }

            leaf ip-mask {
              description 'Network mask.' ;
              type ncd:ipv4-mask ;

            }

            leaf vrf-name {
              description 'VRF name.' ;
              type string {
                length 1..32 ;

              }

              mandatory true ;
            }

          }

          ncd:revise-date 2015-12-09 ;
        }

        container nexthop-path-lists {
          description 'Multicast static nexthop for RPF vector path list.' ;
          list nexthop-path-list {
            description 'Multicast static nexthop for RPF vector path list.' ;
            key 'ip-addr ip-mask' ;
            leaf ip-addr {
              description 'Prefix of destination IP address.' ;
              type ncd:ipv4-address ;

            }

            leaf ip-mask {
              description 'Network mask.' ;
              type ncd:ipv4-mask ;

            }

            leaf rpf-path-name {
              description 'RPF path name.' ;
              type string {
                length 1..31 ;

              }

              mandatory true ;
            }

          }

          ncd:revise-date 2019-09-29 ;
        }

        container smdms {
          description 'configure L2 oif mapping mode' ;
          list smdm {
            description 'configure L2 oif mapping mode' ;
            key intf-name ;
            leaf intf-name {
              description 'Interface name' ;
              type ncd:ifname ;

            }

          }

        }

        container ttls {
          description 'Multicast forwarding TTL limit' ;
          list ttl {
            description 'Multicast forwarding TTL limit' ;
            key intf-name ;
            leaf intf-name {
              description 'Interface name' ;
              type ncd:ifname ;

            }

            leaf ttl-num {
              description 'TTL limit' ;
              type int32 {
                range 1..255 ;

              }

              mandatory true ;
            }

          }

        }

        container boundarys {
          description 'Multicast forwarding boundary' ;
          list boundary {
            description 'Multicast forwarding boundary' ;
            max-elements 64 ;
            key intf-name ;
            leaf intf-name {
              description 'Interface name' ;
              type ncd:ifname {
                length 1..31 ;

              }

            }

            leaf aclname {
              description 'Access list name for group  prefix' ;
              type string {
                length 1..31 ;

              }

              mandatory true ;
            }

          }

        }

        container rejectinbounds {
          description 'Multicast reject inbound data' ;
          list rejectinbound {
            description 'Multicast reject inbound data' ;
            max-elements 64 ;
            key intfname ;
            leaf intfname {
              description 'Multicast reject inbound  interface name' ;
              type ncd:ifname ;

            }

          }

        }

        container segment-border {
          if-feature mvpn-cross-as ;

          description 'Border router for segmented multicast.' ;
          container intra-as {
            description 'Intra-AS segment border router.' ;
            presence intra-as ;
            leaf intra-as-enable {
              description 'Intra-AS enable.' ;
              type empty ;

              mandatory true ;
            }

            leaf intra-seg-nexthop {
              description 'Segmented nexthop of Intra-AS.' ;
              type empty ;

            }

          }

          container inter-as {
            description 'Inter-AS segment border router.' ;
            presence inter-as ;
            leaf inter-as-enable {
              description 'Inter-AS enable.' ;
              type empty ;

              mandatory true ;
            }

            leaf inter-seg-nexthop {
              description 'Segmented nexthop of Inter-AS.' ;
              type empty ;

            }

          }

          ncd:revise-date 2016-11-29 ;
        }

        container mtunnel {
          if-feature mvpn-cross-as ;

          description 'Interface used to set MDT source address' ;
          presence mtunnel ;
          leaf intf-name {
            description 'Interface name' ;
            type ncd:ifname {
              length 1..31 ;

            }

            mandatory true ;
          }

          ncd:revise-date 2016-11-29 ;
        }

        container mvpn {
          if-feature mvpn-cross-as ;

          description 'MVPN provider mtunnel' ;
          presence tunnel ;
          leaf provider-tunnel {
            description 'MVPN provider mtunnel' ;
            type enumeration {
              enum rsvp-te {
                value 1 ;
                description 'Provide rsvp-te  mtunnel' ;
              }

              enum mldp-p2mp {
                value 2 ;
                description 'Provide mldp-p2mp mtunnel' ;
              }

              enum bier {
                value 11 ;
                description 'Provide bier mtunnel' ;
              }

            }

            mandatory true ;
          }

          leaf sub-domain-id {
            description 'BIER sub-domain-id.' ;
            type uint8 {
              range 0..255 ;

            }

            ncd:revise-date 2020-06-20 ;
          }

          leaf bfd-enable {
            description 'BFD enable.' ;
            type empty ;

            ncd:revise-date 2020-06-20 ;
          }

          leaf bfd-template {
            description 'BFD template name.' ;
            type string {
              length 1..31 ;

            }

            ncd:revise-date 2020-06-20 ;
          }

          ncd:revise-date 2016-11-29 ;
        }

        container router-id {
          description 'Multicast router ID.' ;
          presence router-id ;
          leaf router-id {
            description 'Multicast router ID.' ;
            type ncd:ipv4-address ;

            mandatory true ;
          }

          ncd:revise-date 2019-08-29 ;
        }

        container rpf-vector-path-lists {
          description 'RPF proxy vector for path list.' ;
          list rpf-vector-path-list {
            description 'RPF proxy vector for path list.' ;
            key 'rpf-path-name rpf-path-index' ;
            leaf rpf-path-name {
              description 'RPF path name.' ;
              type string {
                length 1..31 ;

              }

            }

            leaf rpf-path-index {
              description 'RPF path index.' ;
              type uint32 {
                range 1..65535 ;

              }

            }

            leaf vector-address {
              description 'RPF vector address.' ;
              type ncd:ipv4-address ;

              mandatory true ;
            }

            leaf vector-type {
              description 'RPF vector type.' ;
              type enumeration {
                enum loose {
                  value 0 ;
                }

                enum strict {
                  value 4 ;
                }

              }

              mandatory true ;
            }

          }

          ncd:revise-date 2019-09-29 ;
        }

        container evpn-tunnel {
          description 'EVPN tunnel' ;
          presence evpn-tunnel ;
          leaf intf-name {
            description 'Interface name' ;
            type ncd:ifname {
              length 1..31 ;

            }

            mandatory true ;
          }

          ncd:revise-date 2019-11-06 ;
        }

        container spmsi-bier-infos {
          description 'MVPN S-PMSI BIER information.' ;
          list spmsi-bier-info {
            description 'MVPN S-PMSI BIER information.' ;
            key subdomain-id ;
            leaf subdomain-id {
              description 'Subdomain ID.' ;
              type uint8 {
                range 0..255 ;

              }

            }

            leaf acl-name {
              description 'ACL name.' ;
              type string {
                length 1..31 ;

              }

              mandatory true ;
            }

          }

          ncd:revise-date 2020-10-27 ;
        }

        container msid {
          description 'MSID.' ;
          presence msid ;
          leaf prefix-addr {
            description 'Prefix address.' ;
            type ncd:ipv6-address ;

            mandatory true ;
          }

          leaf prefix-len {
            description 'Prefix mask length.' ;
            type uint8 {
              range 32..108 ;

            }

            mandatory true ;
          }

          ncd:revise-date 2021-03-17 ;
        }

        container mroute-usage-rates {
          description 'Multicast route usage rate.' ;
          list mroute-usage-rate {
            description 'Multicast route usage rate.' ;
            key mroute-type ;
            leaf mroute-type {
              description 'Multicast route type.' ;
              type enumeration {
                enum xg {
                  value 1 ;
                  description 'The multicast (*,G) route' ;
                }

                enum sg {
                  value 2 ;
                  description 'The multicast (S,G) route' ;
                }

                enum total {
                  value 3 ;
                  description 'The multicast total route' ;
                }

              }

            }

            leaf threshold {
              description 'Multicast route generation threshold to set.' ;
              type uint32 {
                range 1..100 {
                  description 'Threshold value (%) at which to give a warning.' ;
                }

              }

              default 80 ;
            }

            leaf clear-threshold {
              description 'Multicast route clearance threshold to set.' ;
              type uint32 {
                range 1..100 {
                  description 'Threshold value (%) at which to clear the warning.' ;
                }

              }

              default 72 ;
            }

          }

          ncd:revise-date 2023-09-11 ;
        }

      }

      container vrf-multicasts {
        description 'VRF instance' ;
        list vrf-multicast {
          description 'VRF instance' ;
          key vrfname ;
          leaf vrfname {
            description 'VRF name' ;
            type string {
              length 1..32 ;

            }

          }

          leaf longest-match {
            description 'Nexthop longest match' ;
            type empty ;

          }

          leaf static-first {
            description 'Nexthop static first' ;
            type empty ;

          }

          leaf multipath-sghash {
            description 'Multipath' ;
            type enumeration {
              enum s-hash-basic {
                value 1 ;
                description 'Multicast s-hash' ;
              }

              enum sg-hash-basic {
                value 2 ;
                description 'Multicast s-g-hash basic' ;
              }

              enum sg-hash-nexthop-based {
                value 3 ;
                description 'Multicast s-g-hash next-hop-based' ;
              }

              enum sg-hash-balance {
                value 4 ;
                description 'Multicast s-g-hash balance' ;
              }

              enum g-hash-basic {
                value 5 ;
                description 'Multicast g-hash-basic' ;
              }

            }

          }

          leaf mdt-auto-discovery {
            description 'MDT auto discovery' ;
            type empty ;

          }

          leaf mroute-limit-c-instance {
            description "The max number of the multicast routes attached to the VRF instance. It's top limit depends on ability of the device." ;
            type uint32 {
              range 1..262144 {
                description 'The max number of the multicast routes attached to the VRF instance.' ;
              }

            }

            ncd:revise-date 2015-11-26 ;
          }

          leaf bgp-auto-discovery-inter-as {
            if-feature mvpn-cross-as ;

            description 'BGP auto-discovery of inter-AS MVPN.' ;
            type empty ;

            ncd:revise-date 2016-11-29 ;
          }

          leaf bgp-auto-discovery-segmented {
            if-feature mvpn-cross-as ;

            description 'BGP auto-discovery of segmented multicast.' ;
            type empty ;

            ncd:revise-date 2016-11-29 ;
          }

          leaf mvpn-switchover-holdtime {
            description 'Holdtime which data tree switch back to default tree' ;
            type uint16 {
              range 30..600 ;

            }

            ncd:revise-date 2019-01-21 ;
          }

          leaf mvpn-switchover-interval {
            description 'Delay time which default tree switch to data tree' ;
            type uint16 {
              range 3..65535 ;

            }

            ncd:revise-date 2016-11-29 ;
          }

          leaf mvpn-switchover-threshold-infinity {
            description 'ACL for MVPN tunnel never switch to data tree.' ;
            type string {
              length 1..31 ;

            }

            ncd:revise-date 2017-06-05 ;
          }

          leaf pim-neighbor-auto-discovery {
            description 'PIM neighbor auto discovery' ;
            type empty ;

            ncd:revise-date 2019-01-21 ;
          }

          leaf ecmp-select-cost-first {
            description 'ECMP selecting of multicast route' ;
            type empty ;

            ncd:revise-date 2019-02-25 ;
          }

          leaf mvpn-upstream-pe-select {
            description 'MVPN upstream PE select policy
1:lowest-addr-first
2:bgp-route-policy
3:bytewise-exclusive-or-hash' ;
            type enumeration {
              enum lowest-addr-first {
                value 1 ;
              }

              enum bgp-route-policy {
                value 2 ;
              }

              enum bytewise-exclusive-or-hash {
                value 3 ;
              }

            }

            ncd:revise-date 2019-07-15 ;
          }

          leaf mvpn-frr-policy {
            description 'MVPN FRR policy.
1:warm-root-standby
2:hot-root-standby' ;
            type enumeration {
              enum warm-root-standby {
                value 1 ;
              }

              enum hot-root-standby {
                value 2 ;
              }

            }

            ncd:revise-date 2019-04-12 ;
          }

          leaf mvpn-frr-detect-type {
            description 'MVPN FRR detect type.
1:stream detect
2:peer BFD detect' ;
            type enumeration {
              enum stream {
                value 1 ;
              }

              enum peer-bfd {
                value 2 ;
              }

            }

            ncd:revise-date 2019-04-12 ;
          }

          leaf mvpn-frr-ingress-wtr {
            description 'Ingress WTR delay time(second).' ;
            type uint16 {
              range 1..600 ;

            }

            ncd:revise-date 2019-04-12 ;
          }

          leaf mvpn-frr-egress-wtr {
            description 'Egress WTR delay time(second).' ;
            type uint16 {
              range 1..600 ;

            }

            ncd:revise-date 2019-04-12 ;
          }

          leaf mvpn-wildcards-spmsi {
            description 'MVPN wildcards SPMSI.' ;
            type empty ;

            ncd:revise-date 2019-07-15 ;
          }

          leaf mvpn-spt-only {
            description 'MVPN spt only mode' ;
            type empty ;

            ncd:revise-date 2019-11-06 ;
          }

          leaf mvpn-send-site-only {
            description 'MVPN send site only mode' ;
            type empty ;

            ncd:revise-date 2019-11-06 ;
          }

          leaf mvpn-receive-site-only {
            description 'MVPN receive site only mode' ;
            type empty ;

            ncd:revise-date 2019-11-06 ;
          }

          leaf mvpn-spmsi-tunnel {
            description 'MVPN SPMSI mtunnel' ;
            type enumeration {
              enum rsvp-te {
                value 1 ;
                description 'Provide rsvp-te  mtunnel' ;
              }

              enum mldp-p2mp {
                value 2 ;
                description 'Provide mldp-p2mp mtunnel' ;
              }

              enum ingress-replication {
                value 6 ;
                description 'Provide ingress replication mtunnel' ;
              }

            }

            ncd:revise-date 2019-11-06 ;
          }

          leaf ecmp-select-reference-bandwidth {
            description 'Select multicast nexthop based on reference bandwidth in terms of 10Gbps.' ;
            type empty ;

            ncd:revise-date 2021-01-19 ;
          }

          leaf mvpn-frr-egress-wtr-infinity {
            description 'MVPN FRR egress WTR infinity.' ;
            type empty ;

            ncd:revise-date 2021-07-01 ;
          }

          leaf mvpn-frr-policy-acl {
            description 'MVPN FRR policy ACL.' ;
            type string {
              length 1..31 ;

            }

            ncd:revise-date 2021-07-01 ;
          }

          leaf mvpn-frr-support-ipmsi {
            description 'MVPN FRR support I-PMSI.' ;
            type empty ;

            ncd:revise-date 2022-12-26 ;
          }

          leaf mvpn-source-active-acl {
            description 'MVPN source active A-D route ACL.' ;
            type string {
              length 1..31 ;

            }

            ncd:revise-date 2022-01-04 ;
          }

          leaf mvpn-import-msdp {
            description 'MVPN SA import from MSDP.' ;
            type empty ;

            ncd:revise-date 2021-12-08 ;
          }

          leaf mvpn-export-msdp {
            description 'MVPN SA export to MSDP.' ;
            type empty ;

            ncd:revise-date 2022-11-14 ;
          }

          leaf mvpn-pim-hello-silent {
            description 'Disables the sending and receiving of PIM hello packets over MVPN tunnel.' ;
            type empty ;

            ncd:revise-date 2023-03-09 ;
          }

          container mvpn-switchover-threshold {
            if-feature mvpn-switch-threshold ;

            description 'MVPN tunnel switchover threshold.' ;
            presence mvpn-switchover-threshold ;
            leaf threshold {
              description 'MVPN tunnel switchover threshold(Kbps).' ;
              type uint32 {
                range 1..4294967295 ;

              }

              mandatory true ;
            }

            leaf acl {
              description 'ACL for MVPN tunnel switchover.' ;
              type string {
                length 1..31 ;

              }

              mandatory true ;
            }

            ncd:revise-date 2017-02-21 ;
          }

          container mtunnel {
            description 'Interface used to set MDT source address' ;
            presence mtunnel ;
            leaf intf-name {
              description 'Interface name' ;
              type ncd:ifname {
                length 1..31 ;

              }

              mandatory true ;
            }

          }

          container mdt-default {
            description 'Default MDT' ;
            choice mdt-default {
              description 'Default MDT' ;
              case mdt-default-group {
                description 'MDT default group' ;
                leaf group {
                  description 'IP multicast group address' ;
                  type ncd:ipv4-address-none-zero ;

                  mandatory true ;
                }

              }

              case mpls-mldp {
                description 'MDT P2MP mLDP default distribution tree' ;
                container mdt-defaults {
                  description 'Default MDT' ;
                  list mdt-default {
                    description 'Default MDT' ;
                    max-elements 3200 ;
                    key root-addr ;
                    leaf root-addr {
                      description 'Remote root address' ;
                      type ncd:ipv4-address-none-zero ;

                    }

                  }

                }

              }

            }

          }

          container mdt-data {
            description 'Data MDT' ;
            choice mdt-data {
              description 'Data MDT' ;
              case mdt-data-group {
                description 'MDT data group' ;
                leaf acl {
                  description 'Access list name' ;
                  type string {
                    length 1..31 ;

                  }

                }

                leaf group {
                  description 'IP multicast group address' ;
                  type ncd:ipv4-address-none-zero ;

                  mandatory true ;
                }

                leaf mask {
                  description 'Wildcard bits' ;
                  type ncd:ipv4-imask ;

                  mandatory true ;
                }

              }

              case mpls-mldp {
                description 'MDT P2MP mLDP data distribution tree' ;
                leaf num-tree {
                  description 'Data tree number' ;
                  type uint32 {
                    range 1..5000 {
                      description 'MDT data num tree' ;
                    }

                  }

                  mandatory true ;
                }

              }

            }

          }

          container flt {
            description 'Filter config' ;
            container rintfs {
              description 'Monitor multicast route interface' ;
              list rintf {
                description 'Monitor multicast route interface' ;
                max-elements 1000 ;
                key 'interface source group' ;
                leaf interface {
                  description 'Interface name' ;
                  type ncd:ifname {
                    length 1..31 ;

                  }

                }

                leaf source {
                  description 'Source address' ;
                  type ncd:ipv4-address ;

                }

                leaf group {
                  description 'Group address' ;
                  type ncd:ipv4-address ;

                }

                leaf type {
                  description 'Route interface type' ;
                  type enumeration {
                    enum add {
                      value 0 ;
                      description 'Route interface type' ;
                    }

                    enum delete {
                      value 1 ;
                      description 'Route interface type' ;
                    }

                  }

                  mandatory true ;
                }

              }

            }

            container fintfs {
              description 'Monitor multicast interface' ;
              list fintf {
                description 'Monitor multicast interface' ;
                max-elements 1000 ;
                key interface ;
                leaf interface {
                  description 'Interface name' ;
                  type ncd:ifname {
                    length 1..31 ;

                  }

                }

                leaf mode {
                  description 'Route interface mode' ;
                  type enumeration {
                    enum include {
                      value 0 ;
                      description 'Route interface mode' ;
                    }

                    enum exclude {
                      value 1 ;
                      description 'Route interface mode' ;
                    }

                  }

                  mandatory true ;
                }

                leaf type {
                  description 'Route interface type' ;
                  type enumeration {
                    enum add {
                      value 0 ;
                      description 'Add type' ;
                    }

                    enum delete {
                      value 1 ;
                      description 'Delete type' ;
                    }

                  }

                  mandatory true ;
                }

              }

            }

            container routes {
              description 'Monitor multicast route mode' ;
              list route {
                description 'Monitor multicast route mode' ;
                max-elements 1000 ;
                key 'source group' ;
                leaf source {
                  description 'Source address' ;
                  type ncd:ipv4-address ;

                }

                leaf group {
                  description 'Group address' ;
                  type ncd:ipv4-address ;

                }

                leaf mode {
                  description 'Route mode' ;
                  type enumeration {
                    enum include {
                      value 0 ;
                      description 'Include mode' ;
                    }

                    enum exclude {
                      value 1 ;
                      description 'Exclude mode' ;
                    }

                  }

                  mandatory true ;
                }

              }

            }

          }

          container forward-policys {
            description 'Forward policy' ;
            presence forward ;
            leaf acl {
              description 'Access list name' ;
              type string {
                length 1..31 ;

              }

            }

            leaf options {
              description 'Forward multicast traffic option' ;
              type enumeration {
                enum per-packet {
                  value 1 ;
                  description 'Forward multicast traffic by packet' ;
                }

                enum per-user {
                  value 2 ;
                  description 'Forward multicast traffic by user' ;
                }

                enum per-stream {
                  value 3 ;
                  description 'Forward multicast traffic by stream' ;
                }

              }

              mandatory true ;
            }

          }

          container nexthops {
            description 'Multicast static nexthop' ;
            list nexthop {
              description 'Multicast static nexthop' ;
              max-elements 3200 ;
              key 'intf-name ip-addr ip-mask next-hop-addr' ;
              leaf intf-name {
                description 'Interface name' ;
                type ncd:ifname {
                  length 1..31 ;

                }

              }

              leaf ip-addr {
                description 'Prefix of destination IP address' ;
                type ncd:ipv4-address ;

              }

              leaf ip-mask {
                description 'Network mask' ;
                type ncd:ipv4-mask ;

              }

              leaf next-hop-addr {
                description 'Nexthop' ;
                type ncd:ipv4-address ;

              }

              leaf slave {
                description 'slave nexthop' ;
                type empty ;

              }

              leaf track-name {
                description 'Nexthop track name' ;
                type string {
                  length 1..31 ;

                }

                ncd:revise-date 2017-01-09 ;
              }

            }

          }

          container nexthop-fallbacks {
            description 'Alternate routing table for nexthop lookup.' ;
            list nexthop-fallback {
              description 'Alternate routing table for nexthop lookup.' ;
              key 'ip-addr ip-mask' ;
              leaf ip-addr {
                description 'Prefix of destination IP address.' ;
                type ncd:ipv4-address ;

              }

              leaf ip-mask {
                description 'Network mask.' ;
                type ncd:ipv4-mask ;

              }

              container instance {
                description 'Fallback instance.' ;
                choice instance {
                  description 'Fallback instance.' ;
                  mandatory true ;
                  case p-instance {
                    description 'Public instance.' ;
                    leaf global {
                      description 'Public instance.' ;
                      type empty ;

                    }

                  }

                  case c-instance {
                    description 'Customer instance.' ;
                    leaf vrf-name {
                      description 'VRF name.' ;
                      type string {
                        length 1..32 ;

                      }

                    }

                  }

                }

              }

            }

            ncd:revise-date 2015-12-09 ;
          }

          container mvpn {
            description 'MVPN provider mtunnel' ;
            presence tunnel ;
            leaf provider-tunnel {
              description 'MVPN provider mtunnel' ;
              type enumeration {
                enum rsvp-te {
                  value 1 ;
                  description 'Provide rsvp-te  mtunnel' ;
                }

                enum mldp-p2mp {
                  value 2 ;
                  description 'Provide mldp-p2mp mtunnel' ;
                }

                enum ingress-replication {
                  value 6 ;
                  description 'Provide ingress replication mtunnel' ;
                }

                enum bier {
                  value 11 ;
                  description 'Provide bier mtunnel' ;
                }

                enum static-vxlan {
                  value 126 ;
                  description 'Provide static-vxlan mtunnel' ;
                }

              }

              mandatory true ;
            }

            leaf sub-domain-id {
              description 'BIER sub-domain-id.' ;
              type uint8 {
                range 0..255 ;

              }

              ncd:revise-date 2018-08-10 ;
            }

            leaf bfd-enable {
              description 'BFD enable.' ;
              type empty ;

              ncd:revise-date 2020-06-20 ;
            }

            leaf bfd-template {
              description 'BFD template name.' ;
              type string {
                length 1..31 ;

              }

              ncd:revise-date 2020-06-20 ;
            }

            leaf leaf-info-required {
              description 'Leaf Information Required bit set in Intra-AS I-PMSI A-D route.' ;
              type empty ;

              ncd:revise-date 2025-02-27 ;
            }

          }

          container p2mp-template {
            description 'MVPN TE P2MP template' ;
            presence p2mp-template ;
            leaf name {
              description 'Template name(1-32 characters)' ;
              type string {
                length 1..32 {
                  description 'Template name' ;
                }

              }

              mandatory true ;
            }

            ncd:revise-date 2019-01-21 ;
          }

          container mvpn-frr-peer-bfd-ipv4s {
            description 'MVPN frr peer-bfd config information' ;
            list mvpn-frr-peer-bfd-ipv4 {
              description 'MVPN frr peer-bfd config information' ;
              key 'local-addr remote-addr' ;
              leaf local-addr {
                description 'Specify local IPv4 address' ;
                type ncd:ipv4-address-none-zero ;

              }

              leaf remote-addr {
                description 'Specify remote IPv4 address' ;
                type ncd:ipv4-address-none-zero ;

              }

            }

            ncd:revise-date 2019-01-21 ;
          }

          container mvpn-spmsi-aggregation {
            description 'MVPN SPMSI aggregation config information.' ;
            choice mvpn-spmsi-aggregation {
              description 'MVPN SPMSI aggregation config information.' ;
              case type {
                description 'MVPN SPMSI aggregation source-based.' ;
                leaf type {
                  description 'MVPN SPMSI aggregation type.' ;
                  type enumeration {
                    enum source-based {
                      value 1 ;
                    }

                  }

                  mandatory true ;
                }

              }

              case count {
                description 'MVPN SPMSI aggregation count.' ;
                leaf count {
                  description 'MVPN SPMSI aggregation count.' ;
                  type uint32 {
                    range 1..131072 ;

                  }

                  mandatory true ;
                }

              }

            }

            ncd:revise-date 2019-07-15 ;
          }

          container router-id {
            description 'Multicast router ID.' ;
            presence router-id ;
            leaf router-id {
              description 'Multicast router ID.' ;
              type ncd:ipv4-address ;

              mandatory true ;
            }

            ncd:revise-date 2019-08-29 ;
          }

          container spmsi-bier-infos {
            description 'MVPN S-PMSI BIER information.' ;
            list spmsi-bier-info {
              description 'MVPN S-PMSI BIER information.' ;
              key subdomain-id ;
              leaf subdomain-id {
                description 'Subdomain ID.' ;
                type uint8 {
                  range 0..255 ;

                }

              }

              leaf acl-name {
                description 'ACL name.' ;
                type string {
                  length 1..31 ;

                }

                mandatory true ;
              }

            }

            ncd:revise-date 2020-10-27 ;
          }

          container mvpn-spmsi-policys {
            description 'MVPN S-PMSI policy for group prefix and source prefix.' ;
            list mvpn-spmsi-policy {
              description 'MVPN S-PMSI policy for group prefix and source prefix.' ;
              key 'group-addr group-mask source-addr source-mask' ;
              leaf group-addr {
                description 'Group address.' ;
                type ncd:ipv4-address ;

              }

              leaf group-mask {
                description 'Group mask.' ;
                type ncd:ipv4-mask ;

              }

              leaf source-addr {
                description 'Source address.' ;
                type ncd:ipv4-address ;

              }

              leaf source-mask {
                description 'Source mask.' ;
                type ncd:ipv4-mask ;

              }

              choice policy {
                description 'MVPN S-PMSI policy.' ;
                mandatory true ;
                case tunnel-type {
                  description 'MVPN S-PMSI tunnel type.' ;
                  leaf tunnel-type {
                    description 'MVPN S-PMSI tunnel type.' ;
                    type enumeration {
                      enum rsvp-te {
                        value 1 ;
                      }

                      enum mldp-p2mp {
                        value 2 ;
                      }

                    }

                    mandatory true ;
                  }

                  leaf template-name {
                    description 'Template name(1-32 characters).' ;
                    type string {
                      length 1..32 ;

                    }

                  }

                  leaf threshold-value {
                    description 'MVPN tunnel switchover threshold(Kbps).' ;
                    type uint32 {
                      range 1..4294967295 ;

                    }

                  }

                }

                case threshold {
                  description 'MVPN tunnel switchover threshold(Kbps).' ;
                  leaf threshold {
                    description 'MVPN tunnel switchover threshold(Kbps).' ;
                    type uint32 {
                      range 1..4294967295 ;

                    }

                    mandatory true ;
                  }

                }

                case threshold-infinity {
                  description 'MVPN tunnel never switch to data tree.' ;
                  leaf threshold-infinity {
                    description 'MVPN tunnel never switch to data tree.' ;
                    type empty ;

                    mandatory true ;
                  }

                }

              }

            }

            ncd:revise-date 2022-02-10 ;
          }

        }

      }

    }

  }

  container state {
    config false ;
    description 'State module.' ;
    container multicast {
      description 'Multicast module show info.' ;
      container public {
        description 'Public mode of multicast' ;
        container mroutes {
          description 'Multicast route information.' ;
          list mroute {
            description 'Multicast route information.' ;
            key 'group-addr source-addr' ;
            leaf group-addr {
              description 'Group address' ;
              type ncd:ipv4-address ;

            }

            leaf source-addr {
              description 'Source address' ;
              type ncd:ipv4-address ;

            }

            leaf rp-addr {
              description 'RP address' ;
              type ncd:ipv4-address ;

            }

            leaf iif-name {
              description 'Incoming interface name' ;
              type ncd:string-all {
                length 0..31 ;

              }

            }

            leaf secondary-rpf-intf {
              description 'Secondary RPF interface name' ;
              type ncd:string-all {
                length 0..31 ;

              }

            }

            leaf mrt-flag {
              description 'Mroute flag.
NS:SPT upsend,RT:Reg upsend,MT:Tunnel,NTP:NTP join,DPU:Damping enable,DPD:Damping del,B:Bidir,SU:Slave in use.' ;
              type ncd:string-all {
                length 0..31 ;

              }

            }

            leaf mrt-type {
              description 'Mroute type:"STATIC","DYNAMIC".' ;
              type ncd:string-all {
                length 0..19 ;

              }

            }

            leaf iif-flag {
              description 'Incoming interface flag.
NS:SPT upsend.' ;
              type ncd:string-all {
                length 0..31 ;

              }

            }

            leaf fallback-vrf {
              description 'The upstream VRF name of mroute.' ;
              type string {
                length 0..32 ;

              }

              ncd:revise-date 2015-12-09 ;
            }

            list oif-list {
              description 'Downstream interface list' ;
              key 'oif-name type' ;
              leaf oif-name {
                description 'Downstream interface name' ;
                type ncd:string-all {
                  length 0..31 ;

                }

              }

              leaf type {
                description 'Save the breakpoint types of the outcoming interface, not used for the query criteria.
For xg,1:mroute outcoming interface,2:outcoming interface added by xg filter,3:outcoming interface added by xg global filter.
For sg,1:mroute outcoming interface,2:outcoming interface added by sg filter,3:outcoming interface added by xg filter,4:outcoming interface added by sg global filter.' ;
                type int32 ;

              }

              leaf oif-flag {
                description 'Downstream interface flag.
F:Forward,RT:Reg upsend,MT:Tunnel,S:Syn mrt,DF:DF,FLT:Flt add, FD:Flt del.' ;
                type ncd:string-all ;

              }

              leaf mvrf-name {
                description 'Mdt route VRF name' ;
                type ncd:string-all {
                  length 0..32 ;

                }

              }

              ncd:select oif-name ;
            }

            list fallback-extranet {
              description 'Fallback extranet receiver info.' ;
              key vrf-name ;
              leaf vrf-name {
                description 'VRF name.' ;
                type string {
                  length 1..32 ;

                }

              }

              ncd:revise-date 2015-12-09 ;
            }

            list bier-info {
              description 'Bit index explicit replication information.' ;
              key 'subdomain-id bfer-prefix' ;
              leaf subdomain-id {
                description 'Subdomain ID.' ;
                type uint8 {
                  range 0..255 ;

                }

              }

              leaf bfer-prefix {
                description 'BFER prefix.' ;
                type string {
                  length 1..39 ;

                }

              }

              leaf bfr-id {
                description 'BFR ID.' ;
                type uint16 {
                  range 0..65535 ;

                }

              }

              ncd:revise-date 2020-06-20 ;
              ncd:select bfer-prefix ;
            }

            ncd:select "group-addr source-addr iif-name" ;
            ncd:select "group-addr source-addr" ;
            ncd:select "group-addr iif-name" ;
            ncd:select "source-addr iif-name" ;
            ncd:select source-addr ;
            ncd:select group-addr ;
            ncd:select iif-name ;
          }

        }

        container summary {
          description 'The summary information of mroute' ;
          leaf xg-count {
            description 'XG summary' ;
            type uint32 ;

          }

          leaf sg-count {
            description 'SG summary' ;
            type uint32 ;

          }

          leaf mroute-count {
            description 'XG and SG mroute summary' ;
            type uint32 ;

          }

        }

        container briefs {
          description 'The brief information of mroute' ;
          list brief {
            description 'The brief information of mroute' ;
            key 'group source' ;
            leaf group {
              description 'Group address' ;
              type ncd:ipv4-address ;

            }

            leaf source {
              description 'Source address' ;
              type ncd:ipv4-address ;

            }

            leaf type {
              description 'Mroute type:"STATIC","DYNAMIC".' ;
              type string {
                length 1..11 ;

              }

            }

            ncd:select "group source" ;
            ncd:select group ;
            ncd:select source ;
          }

        }

        container nexthops {
          description 'The nexthop information of mroute' ;
          list nexthop {
            description 'The nexthop information of mroute' ;
            key 'dest-addr type' ;
