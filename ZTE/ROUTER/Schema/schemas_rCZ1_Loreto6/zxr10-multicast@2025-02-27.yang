              ncd:select vrf-name ;
              ncd:select "vrf-name tunnel-id tunnel-type" ;
            }

            ncd:revise-date 2023-10-12 ;
          }

          container spmsi-infos {
            description 'MVPN SPMSI information.' ;
            list spmsi-info {
              description 'MVPN SPMSI information.' ;
              key 'vrf-name tunnel-id tunnel-type' ;
              leaf vrf-name {
                description 'VPN Routing/Forwarding instance name.' ;
                type string {
                  length 1..32 ;

                }

              }

              leaf tunnel-id {
                description 'Tunnel ID.' ;
                type uint32 ;

              }

              leaf tunnel-type {
                description 'Tunnel type.
0:No-Tunnel
1:TE-P2MP
2:mLDP-P2MP
3:PIM-SSM
4:PIM-SM
5:PIM-BIDIR
6:INGRESS-RPL
7:mLDP-MP2MP
11:BIER' ;
                type enumeration {
                  enum No-Tunnel {
                    value 0 ;
                  }

                  enum TE-P2MP {
                    value 1 ;
                  }

                  enum mLDP-P2MP {
                    value 2 ;
                  }

                  enum PIM-SSM {
                    value 3 ;
                  }

                  enum PIM-SM {
                    value 4 ;
                  }

                  enum PIM-BIDIR {
                    value 5 ;
                  }

                  enum INGRESS-RPL {
                    value 6 ;
                  }

                  enum mLDP-MP2MP {
                    value 7 ;
                  }

                  enum BIER {
                    value 11 ;
                  }

                }

              }

              leaf tunnel-state {
                description 'Tunnel state.' ;
                type ncd:string-all {
                  length 0..15 ;

                }

              }

              leaf tunnel-attr {
                description 'Tunnel attribute.' ;
                type ncd:string-all {
                  length 0..119 ;

                }

              }

              leaf gbier-info {
                description 'GBIER information.' ;
                type ncd:string-all {
                  length 0..119 ;

                }

              }

              leaf root-info {
                description 'Root information.' ;
                type ncd:string-all {
                  length 0..79 ;

                }

              }

              container leaf-infos {
                description 'Leaf information.' ;
