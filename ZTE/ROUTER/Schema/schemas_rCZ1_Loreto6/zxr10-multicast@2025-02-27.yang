              leaf tunnel-type {
                description 'Tunnel type.
0:No-Tunnel
1:TE-P2MP
2:mLDP-P2MP
3:PIM-SSM
4:PIM-SM
5:PIM-BIDIR
6:INGRESS-RPL
7:mLDP-MP2MP
11:BIER' ;
                type enumeration {
                  enum No-Tunnel {
                    value 0 ;
                  }

                  enum TE-P2MP {
                    value 1 ;
                  }

                  enum mLDP-P2MP {
                    value 2 ;
                  }

                  enum PIM-SSM {
                    value 3 ;
                  }

                  enum PIM-SM {
                    value 4 ;
                  }

                  enum PIM-BIDIR {
                    value 5 ;
                  }

                  enum INGRESS-RPL {
                    value 6 ;
                  }

                  enum mLDP-MP2MP {
                    value 7 ;
                  }

                  enum BIER {
                    value 11 ;
                  }

                }

              }

              leaf tunnel-state {
                description 'Tunnel state.
0:Root
1:Leaf' ;
                type enumeration {
                  enum Root {
                    value 0 ;
                  }

                  enum Leaf {
                    value 1 ;
                  }

                }

              }

              leaf vrf-name {
                description 'The VRF name of MVPN mtunnel.If the instance of MVPN is public, the value of the node is "", else is VRF name.' ;
                type ncd:string-all {
                  length 0..32 ;

                }

