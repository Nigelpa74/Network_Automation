                ncd:revise-date 2016-11-29 ;
              }

              container leaf-ads {
                status obsolete {
                  ncd:revise-date 2016-11-29 ;
                }

                description 'Leaf-AD auto discovery route.' ;
                list leaf-ad {
                  description 'Leaf-AD auto discovery route.' ;
                  key 'ad-state type spmsi-rd spmsi-source spmsi-group spmsi-origin-ip origin-ip' ;
                  leaf ad-state {
                    description 'AD route state.
0:Remote
1:Local' ;
                    type enumeration {
                      enum Remote {
                        value 0 ;
                      }

                      enum Local {
                        value 1 ;
                      }

                    }

                  }

                  leaf type {
                    description 'AD route type.
2:Inter-AS
3:Spmsi-AD' ;
                    type enumeration {
                      enum Inter-AS {
                        value 2 ;
                      }

                      enum Spmsi-AD {
                        value 3 ;
                      }

                    }

                  }

                  leaf spmsi-rd {
                    description 'Spmsi-AD RD.' ;
                    type string {
                      length 0..23 ;

                    }

                  }

                  leaf spmsi-source {
                    description 'Spmsi-AD source address.' ;
                    type ncd:ipv4-address ;

                  }

                  leaf spmsi-group {
                    description 'Spmsi-AD group address.' ;
                    type ncd:ipv4-address ;

                  }

                  leaf spmsi-origin-ip {
                    description 'Spmsi-AD origin IP address.' ;
                    type ncd:ipv4-address ;

                  }

                  leaf origin-ip {
                    description 'Origin IP address.' ;
                    type ncd:ipv4-address ;

                  }

                  leaf uptime {
                    description 'Uptime.' ;
                    type string {
                      length 0..15 ;

                    }

                  }

                  ncd:select origin-ip ;
                }

              }

              container leaf-auto-discoveries {
                description 'Leaf-AD auto discovery route.' ;
                list leaf-auto-discovery {
                  description 'Leaf-AD auto discovery route.' ;
                  key 'type sub-rd sub-source sub-group sub-origin-ip origin-ip' ;
                  leaf type {
                    description 'AD route type.
1:Intra-AS
2:Inter-AS
3:Spmsi-AD' ;
                    type enumeration {
                      enum Intra-AS {
                        value 1 ;
                      }

                      enum Inter-AS {
                        value 2 ;
                      }

                      enum Spmsi-AD {
                        value 3 ;
                      }

                    }

                  }

                  leaf sub-rd {
                    description 'Sub RD.' ;
                    type string {
                      length 0..23 ;

                    }

                  }

                  leaf sub-source {
                    description 'Sub source address.' ;
                    type ncd:ipv4-address ;

                  }

                  leaf sub-group {
                    description 'Sub group address.' ;
                    type ncd:ipv4-address ;

                  }

                  leaf sub-origin-ip {
                    description 'Sub origin IP address.' ;
                    type string {
                      length 1..39 ;

                    }

                  }

                  leaf origin-ip {
                    description 'Origin IP address.' ;
                    type string {
                      length 1..39 ;

                    }

                  }

                  leaf ad-state {
                    description 'AD route state.
0:Remote
1:Local
2:Local/Remote' ;
                    type enumeration {
                      enum Remote {
                        value 0 ;
                      }

                      enum Local {
                        value 1 ;
                      }

                      enum "Local/Remote" {
                        value 2 ;
                      }

                    }

                  }

                  leaf uptime {
                    description 'Uptime.' ;
                    type string {
                      length 0..15 ;

                    }

                  }

                  ncd:select origin-ip ;
                }

                ncd:revise-date 2016-11-29 ;
              }

              container source-actives {
                description 'Source active auto discovery route.' ;
                list source-active {
                  description 'Source active auto discovery route.' ;
                  key 'ad-state rd source group' ;
                  leaf ad-state {
                    description 'AD route state.
0:Remote
1:Local' ;
                    type enumeration {
                      enum Remote {
                        value 0 ;
                      }

                      enum Local {
                        value 1 ;
                      }

                    }

                  }

                  leaf rd {
                    description 'RD.' ;
                    type string {
                      length 0..23 ;

                    }

                  }

                  leaf source {
                    description 'Source address.' ;
                    type ncd:ipv4-address ;

                  }

                  leaf group {
                    description 'Group address.' ;
                    type ncd:ipv4-address ;

                  }

                  leaf uptime {
                    description 'Uptime.' ;
                    type string {
                      length 0..15 ;

                    }

                  }

                  ncd:select ad-state ;
                }

              }

              container xg-joins {
                description 'XG join route.' ;
                list xg-join {
                  description 'XG join route.' ;
                  key 'ad-state rd source-as rp-addr group' ;
                  leaf ad-state {
                    description 'AD route state.
0:Remote
1:Local' ;
                    type enumeration {
                      enum Remote {
                        value 0 ;
                      }

                      enum Local {
                        value 1 ;
                      }

                    }

                  }

                  leaf rd {
                    description 'RD.' ;
                    type string {
                      length 0..23 ;

                    }

                  }

                  leaf source-as {
                    description 'Source autonomous system number.' ;
                    type uint32 ;

                  }

                  leaf rp-addr {
                    description 'RP address.' ;
                    type ncd:ipv4-address ;

                  }

                  leaf group {
                    description 'Group address.' ;
                    type ncd:ipv4-address ;

                  }

                  leaf uptime {
                    description 'Uptime.' ;
                    type string {
                      length 0..15 ;

                    }

                  }

                  ncd:select ad-state ;
                }

                ncd:revise-date 2015-08-12 ;
              }

              container sg-joins {
                description 'SG join route.' ;
                list sg-join {
                  description 'SG join route.' ;
                  key 'ad-state rd source-as source group' ;
                  leaf ad-state {
                    description 'AD route state.
0:Remote
1:Local' ;
                    type enumeration {
                      enum Remote {
                        value 0 ;
                      }

                      enum Local {
                        value 1 ;
                      }

                    }

                  }

                  leaf rd {
                    description 'RD.' ;
                    type string {
                      length 0..23 ;

                    }

                  }

                  leaf source-as {
                    description 'Source autonomous system number.' ;
                    type uint32 ;

                  }

                  leaf source {
                    description 'Source address.' ;
                    type ncd:ipv4-address ;

                  }

                  leaf group {
                    description 'Group address.' ;
                    type ncd:ipv4-address ;

                  }

                  leaf uptime {
                    description 'Uptime.' ;
                    type string {
                      length 0..15 ;

                    }

                  }

                  ncd:select ad-state ;
                }

              }

              ncd:select vrf-name ;
              ncd:select source ;
              ncd:select group ;
              ncd:select "vrf-name source" ;
              ncd:select "vrf-name group" ;
              ncd:select "source group" ;
              ncd:select "vrf-name source group" ;
            }

          }

          container ad-summarys {
            description 'The summary information of AD route.' ;
            list ad-summary {
              description 'The summary information of AD route.' ;
              key vrf-name ;
              leaf vrf-name {
                type string {
                  length 1..32 ;

                }

              }

              leaf intra-as-local {
                description 'Local intra-AS route summary.' ;
