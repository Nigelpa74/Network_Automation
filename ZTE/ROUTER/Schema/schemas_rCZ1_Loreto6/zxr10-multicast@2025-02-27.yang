                description 'Downstream interface flag.
Mdt:Mdt nexthop
Down:Interface down
S:Slave 
M:Master' ;
                type ncd:string-all {
                  length 0..31 ;

                }

              }

              leaf remote-pe {
                description 'Remote PE address.' ;
                type string {
                  length 0..39 ;

                }

                ncd:revise-date 2021-08-16 ;
              }

              leaf real-nexthop {
                description 'Real nexthop address.' ;
                type string {
                  length 0..39 ;

                }

              }

              ncd:select "nexthop oif-name" ;
            }

            ncd:select dest-addr ;
