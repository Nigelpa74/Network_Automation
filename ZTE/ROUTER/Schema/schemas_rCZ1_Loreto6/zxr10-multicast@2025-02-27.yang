                }

                description 'Spmsi-AD auto discovery route.' ;
                list spmsi-ad {
                  description 'Spmsi-AD auto discovery route.' ;
                  key 'ad-state rd source group origin-ip' ;
                  leaf ad-state {
                    description 'AD route state.
0:Remote
1:Local' ;
                    type enumeration {
                      enum Remote {
                        value 0 ;
                      }

                      enum Local {
                        value 1 ;
                      }

                    }

                  }

                  leaf rd {
                    description 'RD.' ;
                    type string {
                      length 0..23 ;

                    }

                  }

                  leaf source {
                    description 'Source address.' ;
                    type ncd:ipv4-address ;

                  }

                  leaf group {
                    description 'Group address.' ;
                    type ncd:ipv4-address ;

                  }

                  leaf origin-ip {
                    description 'Origin IP address.' ;
                    type ncd:ipv4-address ;

                  }

                  leaf spmsi-tunnel {
                    description 'Spmsi tunnel.' ;
                    type ncd:string-all {
                      length 0..79 ;

                    }

                  }

                  leaf uptime {
                    description 'Uptime.' ;
                    type string {
                      length 0..15 ;

                    }

                  }

                  ncd:select origin-ip ;
                }

              }

              container spmsi-auto-discoveries {
                description 'Spmsi-AD auto discovery route.' ;
                list spmsi-auto-discovery {
                  description 'Spmsi-AD auto discovery route.' ;
                  key 'rd source group origin-ip' ;
                  leaf rd {
                    description 'RD.' ;
                    type string {
                      length 0..23 ;

                    }

                  }

                  leaf source {
                    description 'Source address.' ;
                    type ncd:ipv4-address ;

                  }

                  leaf group {
                    description 'Group address.' ;
                    type ncd:ipv4-address ;

                  }

                  leaf origin-ip {
                    description 'Origin IP address.' ;
                    type string {
                      length 1..39 ;

                    }

                  }

                  leaf root-tunnel {
                    description 'Root tunnel.' ;
                    type ncd:string-all {
                      length 0..79 ;

                    }

                  }

                  leaf ad-state {
                    description 'AD route state.
0:Remote
1:Local
2:Local/Remote' ;
                    type enumeration {
                      enum Remote {
                        value 0 ;
                      }

                      enum Local {
                        value 1 ;
                      }

                      enum "Local/Remote" {
                        value 2 ;
