                  length 1..32 ;

                }

              }

              leaf source {
                description 'Source address.' ;
                type ncd:ipv4-address ;

              }

              leaf group {
                description 'Group address.' ;
                type ncd:ipv4-address ;

              }

              leaf intf-state {
                description 'Interface state.
IFT - Receive from P-tunnel
OFT - Send to P-tunnel
OFNL - Downstream join state' ;
                type string {
                  length 0..15 ;

                }

