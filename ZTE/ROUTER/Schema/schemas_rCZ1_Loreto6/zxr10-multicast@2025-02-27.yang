                  description 'Leaf information.' ;
                  key 'egress-pe mpls-label' ;
                  leaf egress-pe {
                    description 'Egress PE.' ;
                    type ncd:string-all {
                      length 1..39 ;

                    }

                  }

                  leaf mpls-label {
                    description 'MPLS label.' ;
                    type uint32 ;

                  }

                  leaf bier-prefix {
                    description 'BIER prefix address..' ;
                    type ncd:string-all {
                      length 0..39 ;

                    }

                  }

                  leaf bier-bfr-id {
