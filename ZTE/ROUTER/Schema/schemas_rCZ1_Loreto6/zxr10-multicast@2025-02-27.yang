              description 'Destination address' ;
              type ncd:ipv4-address ;

            }

            leaf type {
              description 'Type:"Mstatic nexthop","Mdt nexthop","Mbgp nexthop","Migp nexthop","Rtm nexthop"' ;
              type ncd:string-all {
                length 0..31 ;

              }

              ncd:revise-date 2015-08-28 ;
            }

            leaf time {
              description 'Nexthop create time' ;
              type ncd:string-all {
                length 0..31 ;

              }

            }

            leaf user {
              description 'Nexthop user:"PIM","DM","MSDP","MSN","MVPN"' ;
              type ncd:string-all {
                length 0..31 ;

              }

            }

            leaf metric {
              description 'Metric' ;
              type uint32 ;

            }

            leaf preference {
              description 'Preference' ;
              type uint32 ;

            }

            leaf mask-len {
              description 'Mask length' ;
              type uint16 ;

            }

            leaf flag {
              description 'Flag.
L:Local,C:Connect,UNR:Unreachable unicast,CTOP:Across the backbone' ;
              type ncd:string-all {
                length 0..31 ;

              }

            }

            leaf fallback-vrf {
              description 'The VRF name of fallback nexthop.' ;
              type string {
                length 0..32 ;

              }

