              }

              leaf leaf-ad-remote {
                description 'Remote leaf-AD route summary.' ;
                type uint32 ;

              }

              leaf leaf-ad-all {
                description 'Leaf-AD route summary.' ;
                type uint32 ;

              }

              leaf source-active-local {
