  container state {
    config false ;
    description 'TACPLUS state info.' ;
    container tacplus {
      description 'TACPLUS state info.' ;
      container group-state {
        description 'TACPLUS group state info.' ;
        list server-group-state {
          description 'Show TACPLUS group state.' ;
          key group-name ;
          leaf group-name {
            description 'Name of server group (1-31 characters).' ;
            type string {
              length 1..31 {
                description 'Name of server group (1-31 characters).' ;
              }

            }

            ncd:revise-date 2015-03-30 ;
          }

          leaf state {
            description 'Tacplus group-server state.' ;
            type group-state ;

          }

        }

      }

    }

