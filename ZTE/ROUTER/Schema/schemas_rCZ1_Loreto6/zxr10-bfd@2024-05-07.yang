          container ipv4-discriminators {
            description 'IPv4 discriminators.' ;
            list ipv4-discriminator {
              description 'IPv4 discriminators.' ;
              key ipv4-address ;
              leaf ipv4-address {
                description 'IPv4 address.' ;
                type ncd:ipv4-address-none-zero ;

              }

            }

          }

        }

        ncd:revise-date 2019-05-31 ;
      }

      container template-paras {
        description 'Configure BFD template parameter.' ;
        list template-para {
          description 'Configure BFD template parameter.' ;
          key template-name ;
          leaf template-name {
            description 'Template name for BFD.' ;
            type string {
              length 1..31 {
                description 'Template name for BFD.' ;
              }

            }

          }

          leaf interval {
            description 'BFD control packets TX interval in milliseconds,the range and default value of this parameter depends on the device,default range 10-990.' ;
            type uint32 {
              range 1..65535 {
                description 'BFD TX interval.' ;
              }

            }

          }

          leaf min-rx {
            description 'BFD control packets min RX in milliseconds,the range and default value of this parameter depends on the device,default range 10-990.' ;
            type uint32 {
              range 1..65535 {
                description 'BFD RX interval.' ;
              }

            }

          }

          leaf multiplier {
            description 'BFD detect multiplier, the default value of this parameter depends on the device.' ;
            type uint8 {
              range 3..50 {
                description 'BFD detect multiplier.' ;
              }

            }

          }

          leaf location-policy {
            if-feature location-board ;

            description 'BFD location policy.' ;
            type policy-set ;

            ncd:revise-date 2020-02-20 ;
          }

          container location-board {
            if-feature location-board ;

            description 'Configure BFD location board parameter.' ;
            list board {
              description 'BFD location board.' ;
              key name ;
              leaf name {
                description 'Location board name.' ;
                type ncd:board {
                  length 1..31 ;

                }

              }

              leaf secondary {
                description 'Secondary board flag.' ;
                type uint8 {
                  range 0..1 {
                    description 'Secondary flag' ;
                  }

                }

                default 0 ;
              }

            }

            ncd:revise-date 2020-02-20 ;
          }

          leaf min-echo-rx-interval {
            description 'BFD echo packets TX interval in milliseconds,the range depends on the device,default range 10-990.' ;
            type uint32 {
              range 1..65535 {
                description 'BFD echo RX interval.' ;
              }

            }

            ncd:revise-date 2020-07-11 ;
          }

          leaf dscp {
            description 'Configure BFD packet DSCP value.' ;
            type uint8 {
              range 0..63 {
                description 'Configure BFD packet DSCP value.' ;
              }

            }

            ncd:revise-date 2020-09-15 ;
          }

          leaf mpls-bfd-ip-router-alert {
            type switch-set ;

            description 'If send BFD packets with router alert option' ;
            ncd:revise-date 2024-01-08 ;
          }

        }

        ncd:revise-date 2019-11-21 ;
      }

      container auto-sessions {
        description 'batch creating BFD sessions by protocols' ;
        container sr-be-sbfd {
          description 'batch creating SR-BE seamless BFD sessions by protocols' ;
          list sessions {
            description 'configuration instances of BFD sessions.' ;
            key bfd-type ;
            leaf bfd-type {
              description 'the type of BFD sessions.' ;
              type enumeration {
                enum MPLS-IPv4 {
                  value 1 ;
                  description 'MPLS IPv4 SR-BE SBFD' ;
                }

              }

            }

            leaf ip-prefix-name {
              description 'IP prefix name.' ;
              type string {
                length 1..169 ;

              }

            }

            leaf template-name {
              description 'template name of time parameters.' ;
              type string {
                length 1..31 ;

              }

            }

            leaf source {
              description 'Source address for SR BE BFD.' ;
              type ncd:ipv4-address-none-zero ;

              ncd:revise-date 2021-05-20 ;
            }

            ncd:revise-date 2021-09-18 ;
          }

        }

        container srv6-be-sbfd {
          container not-filtered {
            presence session ;
            leaf template-name {
              description 'template name of time parameters.' ;
              type string {
                length 1..31 ;

              }

            }

            leaf source {
              description 'Source address for SRv6 BE BFD.' ;
              type ncd:ipv6-address-none-zero ;

            }

          }

          list filtered {
            key ip-prefix-name ;
            leaf ip-prefix-name {
              description 'IP prefix name.' ;
              type string {
                length 1..169 ;

              }

              mandatory true ;
            }

            leaf template-name {
              description 'template name of time parameters.' ;
              type string {
                length 1..31 ;

              }

            }

            leaf source {
              description 'Source address for SRv6 BE BFD.' ;
              type ncd:ipv6-address-none-zero ;

            }

          }

          ncd:revise-date 2021-05-20 ;
        }

        ncd:revise-date 2020-03-24 ;
      }

      container batch-sessions {
        if-feature srv6-be ;

        description 'Create BFD sessions in batches.' ;
        container srv6-be-sbfd {
          description 'SRv6-BE seamless BFD.' ;
          list srv6-be {
            description 'SRv6-BE BFD.' ;
            key 'prefix prefix-len' ;
            leaf prefix {
              description 'Prefix.' ;
              type ncd:ipv6-address-none-zero ;

              mandatory true ;
            }

            leaf prefix-len {
              description 'Prefix length.' ;
              type uint8 {
                range 8..120 ;

              }

              mandatory true ;
            }

            leaf range {
              description 'The quantity of prefix.' ;
              type uint16 {
                range 1..256 ;

              }

              mandatory true ;
            }

            leaf template-name {
              description 'template name of time parameters.' ;
              type string {
                length 1..31 ;

              }

            }

            leaf source {
              description 'Source address for SRv6 BE BFD.' ;
              type ncd:ipv6-address-none-zero ;

            }

          }

        }

        ncd:revise-date 2021-06-22 ;
      }

    }

  }

  container state {
