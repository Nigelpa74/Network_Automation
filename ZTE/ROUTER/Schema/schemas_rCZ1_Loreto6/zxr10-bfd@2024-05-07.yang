              }

            }

            ncd:revise-date 2020-04-20 ;
          }

        }

        container reflector-source {
          description 'The source IP address of reflector.' ;
          leaf ipv4-address {
            description 'IPv4 address.' ;
            type ncd:ipv4-address-none-zero ;

          }

        }

        container reflector-source-ipv6 {
          description 'The IPv6 source address of reflector.' ;
          leaf ipv6-address {
            description 'IPv6 address.' ;
            type ncd:ipv6-address-none-zero ;

          }

          ncd:revise-date 2020-04-20 ;
        }

        container reflector-discriminator {
          description 'Configure reflector discriminator.' ;
          container integer-discriminators {
            description 'Interger discriminators.' ;
            list integer-discriminator {
              description 'Interger discriminators.' ;
