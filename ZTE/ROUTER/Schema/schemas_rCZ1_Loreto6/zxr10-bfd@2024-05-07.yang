                  }

                }

                container time-negotiation {
                  description 'Configure BFD time negotiation parameter.' ;
                  leaf interval {
                    description 'BFD control packets TX interval in milliseconds, the range and default value of this parameter depends on the device, default range is 10-990, default value is 50.' ;
                    type uint32 {
                      range 1..65535 {
                        description 'BFD TX interval.' ;
                      }

                    }

                  }

                  leaf min-rx {
                    description 'BFD control packets min RX in milliseconds, the range and default value of this parameter depends on the device,default range is 10-990, default value is 50.' ;
                    type uint32 {
                      range 1..65535 {
                        description 'BFD RX interval.' ;
                      }

                    }

                  }

                  leaf multiplier {
                    description 'BFD detect multiplier, the default value of this parameter depends on the device,  default is 3.' ;
                    type uint8 {
                      range 3..50 {
                        description 'BFD detect multiplier.' ;
                      }

                    }

                  }

                }

                leaf template-name {
                  if-feature template-for-session ;

                  description 'Template name.' ;
                  type string {
                    length 1..31 ;

                  }

                }

              }

              ncd:revise-date 2020-07-07 ;
            }

            case srv6-be-bfd {
              if-feature srv6-be ;

              container srv6-be-bfd {
                description 'SRv6 BE BFD.' ;
                leaf peer-address {
                  description 'Peer address.' ;
                  type ncd:ipv6-address-none-zero ;

                  mandatory true ;
                }

                leaf mask-length {
                  description 'Mask length for SRv6 BE BFD.' ;
                  type uint32 {
                    range 1..128 {
                      description 'Mask length for SRv6 BE BFD.' ;
                    }

                  }

                  mandatory true ;
                  ncd:revise-date 2020-09-30 ;
                }

                leaf ld {
                  description 'Local discriminator for SRv6 BE BFD,the range of this parameter depends on the device,default range 1-4294967295.' ;
                  type uint32 {
                    range 1..4294967295 {
                      description 'Local discriminator for SR BE BFD,the range of this parameter depends on the device,default range 1-4294967295.' ;
                    }

                  }

                }

                choice rd-format {
                  description 'Format of remote discriminator.' ;
                  case integer {
                    description 'Integer.' ;
                    leaf rd {
                      description 'Integer format.' ;
                      type uint32 {
                        range 1..4294967295 {
                          description 'Remote discriminator for SRv6 BE BFD.' ;
                        }

                      }

                    }

                  }

                  case ip {
                    description 'IP adress.' ;
                    leaf ipv4-rd {
                      description 'IP format.' ;
                      type ncd:ipv4-address-none-zero ;

                    }

                  }

                  ncd:revise-date 2021-03-25 ;
                }

                choice source-type {
                  description 'Source type.' ;
                  case source {
                    description 'Normal source.' ;
                    leaf source {
                      description 'IPv6 source address.' ;
                      type ncd:ipv6-address-none-zero ;

                      mandatory true ;
                    }

                  }

                  case slice {
                    description 'Specify source with slice-id,slice-prefix and strict-mode.' ;
                    container slice {
                      description 'Specify source with slice-id,slice-prefix and strict-mode.' ;
                      leaf source-slice-id {
                        description 'Source slice ID,the range of this parameter depends on the device,default range 1-2147483647.' ;
                        type uint32 {
                          range 1..2147483647 {
                            description 'Source slice ID,the range of this parameter depends on the device,default range 1-65535.' ;
                          }

                        }

                        mandatory true ;
                      }

                      leaf slice-prefix {
                        description 'Source slice prefix name.' ;
                        type string {
                          length 1..63 {
                            description 'Source slice prefix name' ;
                          }

                        }

                        mandatory true ;
                      }

                      leaf strict-mode {
                        description 'Strict mode.' ;
                        type empty ;

                      }

                    }

                  }

                  ncd:revise-date 2023-02-17 ;
                }

                container time-negotiation {
                  description 'Configure BFD time negotiation parameter.' ;
                  leaf interval {
                    description 'BFD control packets TX interval in milliseconds, the range and default value of this parameter depends on the device, default range is 10-990, default value is 50.' ;
                    type uint32 {
                      range 1..65535 {
                        description 'BFD TX interval.' ;
                      }

                    }

                  }

                  leaf min-rx {
                    description 'BFD control packets min RX in milliseconds, the range and default value of this parameter depends on the device,default range is 10-990, default value is 50.' ;
                    type uint32 {
                      range 1..65535 {
                        description 'BFD RX interval.' ;
                      }

                    }

                  }

                  leaf multiplier {
                    description 'BFD detect multiplier, the default value of this parameter depends on the device,  default is 3.' ;
                    type uint8 {
                      range 3..50 {
                        description 'BFD detect multiplier.' ;
                      }

                    }

                  }

                }

                leaf template-name {
                  if-feature template-for-session ;

                  description 'Template name.' ;
                  type string {
                    length 1..31 ;

                  }

                }

              }

              ncd:revise-date 2020-08-08 ;
            }

          }

          container dscp {
            description 'Configure BFD packet DSCP value.' ;
            leaf dscp {
              description 'Configure BFD packet DSCP value.' ;
              type uint8 {
                range 0..63 {
                  description 'Configure BFD packet DSCP value.' ;
                }

              }

              default 56 ;
            }

          }

          container cv-stop {
            description 'Configure BFD cv-stop strategy.' ;
            leaf cv-stop {
              description 'Configure cv-stop strategy of BFD session.' ;
              type enumeration {
                enum disable {
                  value 0 ;
                  description 'Close cv-stop strategy' ;
                }

                enum enable {
                  value 1 ;
                  description 'Open cv-stop strategy' ;
                }

              }

              default disable ;
            }

          }

          container admin-down-paras {
            if-feature session-admin-down ;

            description 'Administratively shutdown BFD session.' ;
            leaf admin-down {
              description 'Administratively shutdown BFD session.' ;
              type uint8 {
                range 1 {
                  description 'Administratively shutdown BFD session.' ;
                }

              }

            }

            leaf notify-client {
              description 'If notify client admin-down when session down.' ;
              type switch-set ;

              default disable ;
            }

            ncd:revise-date 2019-09-29 ;
          }

          container session-description {
            description 'The description of seamless BFD session.' ;
            leaf description {
              description 'The description of seamless BFD session.' ;
              type ncd:string-with-blank {
                length 1..80 {
                  description 'Max be 80 characters.' ;
                }

              }

            }

            ncd:revise-date 2020-08-26 ;
          }

        }

        ncd:revise-date 2019-05-31 ;
      }

      container interface-paras {
        description 'Configure BFD interface parameter.' ;
        list interface-para {
          description 'Configure BFD interface parameter.' ;
          key if-name ;
          leaf if-name {
            description 'Interface name for BFD. Only used for IPv4 and IPv6 link BFD.' ;
            type ncd:ifname {
              length 1..31 {
                description 'Interface name for BFD. Only used for IPv4 and IPv6 link BFD.' ;
              }

            }

          }

          leaf interval {
            description 'BFD control packets TX interval in milliseconds,the range and default value of this parameter depends on the device,default range 10-990, default value is 50.' ;
            type uint32 {
              range 1..65535 {
                description 'BFD TX interval.' ;
              }

            }

          }

          leaf min-rx {
            description 'BFD control packets min RX in milliseconds,the range and default value of this parameter depends on the device,default range 10-990, default value is 50.' ;
            type uint32 {
              range 1..65535 {
                description 'BFD RX interval.' ;
              }

            }

