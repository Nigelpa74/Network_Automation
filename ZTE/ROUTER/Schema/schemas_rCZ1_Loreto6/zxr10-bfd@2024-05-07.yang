              description 'If single-arm echo is enabled for IPv4 single-hop BFD of this interface.' ;
              type enumeration {
                enum disable {
                  value 0 ;
                  description 'Single-arm echo disabled.' ;
                }

                enum enable {
                  value 1 ;
                  description 'Single-arm echo enabled.' ;
                }

              }

              default disable ;
            }

            leaf ipv6-single-arm-echo {
              description 'If single-arm echo is enabled for IPv6 single-hop BFD of this interface.' ;
              type enumeration {
                enum disable {
                  value 0 ;
                  description 'Single-arm echo disabled.' ;
                }

                enum enable {
                  value 1 ;
                  description 'Single-arm echo enabled.' ;
                }

              }

              default disable ;
            }

            leaf ipv4-echo-source {
              description 'Source address of IPv4 echo BFD.' ;
              type ncd:ipv4-address-none-zero ;

              ncd:revise-date 2023-11-14 ;
            }

            leaf ipv6-echo-source {
              description 'Source address of IPv6 echo BFD.' ;
              type ncd:ipv6-address ;

              ncd:revise-date 2023-11-14 ;
            }

            ncd:revise-date 2019-07-12 ;
          }

          container echo-paras {
            description 'Echo parameters.' ;
            leaf min-echo-rx-interval {
              description 'BFD echo packets TX interval in milliseconds,the range depends on the device,default range 10-990.' ;
              type uint32 {
                range 1..65535 {
                  description 'BFD echo RX interval.' ;
                }

              }

            }

            ncd:revise-date 2019-07-12 ;
          }

          container interface-description {
            description 'The description of interface.' ;
            leaf description {
              description 'The description of interface.' ;
              type ncd:string-with-blank {
                length 1..80 {
                  description 'Max be 80 characters.' ;
                }

              }

            }

            ncd:revise-date 2020-08-26 ;
          }

        }

      }

      container ipv4-lag-para {
        description 'Configure global parameters of IPv4 lag-bfd.' ;
        leaf ipv4-lag-src {
          description 'Configure global source address of IPv4 lag-bfd.' ;
          type ncd:ipv4-address-none-zero ;

        }

        ncd:revise-date 2016-11-23 ;
      }

      container ipv6-lag-para {
        description 'Configure global parameters of IPv6 lag-bfd.' ;
        leaf ipv6-lag-src {
          description 'Configure global source address of IPv6 lag-bfd.' ;
          type ncd:ipv6-address ;

        }

        ncd:revise-date 2016-11-23 ;
      }

      container seamless-paras {
        description 'Configure parameters for Seamless BFD.' ;
        container remote-target {
          description 'Configure the mapping of remote IP address and remote discriminator.' ;
          container ipv4-remote-targets {
            description 'Configure the mapping of remote IPv4 address and remote discriminator.' ;
            list ipv4-remote-target {
              description 'Configure the mapping of remote IPv4 address and remote discriminator.' ;
              key ipv4-address ;
              leaf ipv4-address {
                description 'IPv4 address.' ;
                type ncd:ipv4-address-none-zero ;

              }

              leaf discriminator {
                description 'Discriminator.' ;
                type uint32 {
                  range 1..4294967295 ;

                }

              }

            }

          }

          container ipv6-remote-targets {
            description 'Configure the mapping of remote IPv6 address and remote discriminator.' ;
            list ipv6-remote-target {
              description 'Configure the mapping of remote IPv6 address and remote discriminator.' ;
              key ipv6-address ;
              leaf ipv6-address {
                description 'IPv6 address.' ;
                type ncd:ipv6-address-none-zero ;

              }

              choice rd-format {
                description 'Format of remote discriminator.' ;
                mandatory true ;
                case integer {
                  description 'Integer.' ;
                  leaf discriminator {
                    description 'Integer format.' ;
                    type uint32 {
                      range 1..4294967295 ;

                    }

                    mandatory true ;
                  }

