              length 0..47 {
                description 'Local address for BFD session.' ;
              }

            }

          }

          leaf remote-address {
            description 'Remote address for SingleHop,SubSingleHop, MultiHop,RSVP-TUNNEL-Active,Static-RSVP-TUNNEL,RSVP-LSP-Active,Bidirection-RSVP-LSP,L2link,Lag,SRv6 BE BFD sessions. extend tunnle id for MLDP,MTE BFD BFD passive sessions.' ;
            type string {
              length 0..47 {
                description 'Remote address for BFD session.' ;
              }

            }

          }

          leaf if-name {
            description 'Output interface for BFD session.' ;
            type string {
              length 0..32 {
                description 'Output interface for BFD session.' ;
              }

            }

          }

          leaf vrf-name {
            description 'VRF name for BFD session.' ;
            type string {
              length 0..36 {
                description 'VRF name for BFD session.' ;
              }

            }

          }

          leaf fec-address {
            description 'FEC address for LDP/SR BE/generic BFD.' ;
            type string ;

          }

          leaf mask-length {
            description 'Mask length.' ;
            type uint8 ;

          }

          leaf tunnel-id {
            description 'TE TunnelID for RSVP BFD.' ;
            type uint32 ;

          }

          leaf lsp-id {
            description 'Lspid for RSVP LSP BFD.' ;
            type uint16 ;

          }

          leaf lsp-role {
            description 'Lsp role for RSVP LSP BFD,include maste and slave.' ;
            type enumeration {
              enum --- {
                value 0 ;
              }

              enum master {
                value 1 ;
              }

              enum slave {
                value 2 ;
              }

            }

          }

          leaf pw-name {
            description 'PW name for PW BFD.' ;
            type string {
              length 0..32 {
                description 'PW name for PW BFD.' ;
              }

            }

          }

          leaf pw-ttl {
            description 'PW TTL value for PW BFD.' ;
            type uint16 ;

          }

          leaf rx-count {
            description 'Count of received BFD Control packets.' ;
            type uint32 ;

          }

          leaf tx-count {
            description 'Count of transmitting BFD Control packets.' ;
            type uint32 ;

          }

          leaf up-time {
            description 'Time of BFD session at UP states.' ;
            type ncd:string-with-blank {
              length 0..63 {
                description 'Time of BFD session at UP states.' ;
              }

            }

          }

          leaf local-diag {
            description "Local system's reason for the last change in BFD session state." ;
            type uint32 ;

          }

          leaf min-tx-interval {
            description 'Minimum interval of transmitting BFD Control packets.' ;
            type uint32 ;

          }

          leaf max-tx-interval {
            description 'Maximum interval of transmitting BFD Control packets.' ;
            type uint32 ;

          }

          leaf avg-tx-interval {
            description 'Average interval values of transmitting BFD Control packets.' ;
            type uint32 ;

          }

          leaf min-rx-interval {
            description 'Minimum interval of received BFD Control packets.' ;
            type uint32 ;

          }

          leaf max-rx-interval {
            description 'Maximum interval of received BFD Control packets.' ;
            type uint32 ;

          }

          leaf avg-rx-interval {
            description 'Average interval values of received BFD Control packets.' ;
            type uint32 ;

          }

          leaf local-tx {
            description "Local system's interval of transmitting BFD Control packets." ;
            type uint32 ;

          }

          leaf local-rx {
            description "Local system's interval of received BFD Control packets." ;
            type uint32 ;

          }

          leaf local-multiplier {
            description "Local system's detection time multiplier." ;
            type uint8 ;

          }

          leaf received-tx {
            description "Remote system's interval of transmitting BFD Control packets." ;
            type uint32 ;

          }

          leaf received-rx {
            description "Remote system's interval of received BFD Control packets." ;
            type uint32 ;

          }

          leaf received-multiplier {
            description "Remote system's detection time multiplier." ;
            type uint8 ;

          }

          leaf p-bit {
            description "Local system's poll bit." ;
            type uint8 ;

          }

          leaf f-bit {
            description "Local system's final bit." ;
            type uint8 ;

          }

          leaf hold-down {
            description "Local system's holding Down time." ;
            type uint32 ;

          }

          leaf dest-udpport {
            description 'UDP destination port of BFD session.' ;
            type uint16 ;

          }

          leaf rcv-phyif {
            description 'Physical interface name of receiving packets by control plane.' ;
            type string {
              length 0..31 {
                description 'Physical interface name of receiving packets by control plane.' ;
              }

            }

          }

          leaf summary-detect-type {
            description 'Summary detect type for BFD session.' ;
            type enumeration {
              enum ip {
                value 0 ;
              }

              enum ldp {
                value 1 ;
              }

              enum rsvp {
                value 2 ;
              }

              enum l2 {
                value 3 ;
              }

              enum pw {
                value 4 ;
              }

              enum lag {
                value 5 ;
              }

              enum srbe {
                value 6 ;
              }

              enum mldp {
                value 7 ;
              }

              enum mte {
                value 8 ;
              }

              enum srpath {
                value 9 ;
              }

              enum Srv6Te {
                value 10 ;
              }

              enum Srv6Lsp {
                value 11 ;
              }

              enum Srv6PolicySl {
                value 13 ;
              }

              enum Srv6Policy {
                value 14 ;
              }

              enum SrMplsPolicy {
                value 15 ;
              }

              enum MvpnBier {
                value 16 ;
              }

              enum GEN-LSP {
                value 17 ;
              }

              enum SrMplsPolicySL {
                value 18 ;
              }

              enum Srv6Be {
                value 12 ;
              }

              enum Srv6EvpnVpws {
                value 19 ;
              }

            }

          }

          leaf leaf-id {
            description 'Leaf id for MTE/MLDP BFD.' ;
            type uint32 ;

            ncd:revise-date 2019-05-20 ;
          }

          leaf opaque-type {
            description 'MLDP Opaque type' ;
            type enumeration {
              enum Tunnel-Id {
                value 1 ;
              }

              enum Invalid {
                value 0 ;
              }

            }

            ncd:revise-date 2019-05-20 ;
          }

          leaf p2mp-id {
            description 'P2MP ID  for MTE.' ;
            type uint32 ;

            ncd:revise-date 2019-05-20 ;
          }

          leaf seamless-mode {
            description 'If BFD is seamless.' ;
            type enumeration {
              enum disable {
                value 0 ;
                description 'Seamless disable.' ;
              }

              enum enable {
                value 1 ;
                description 'Seamless enable.' ;
              }

            }

            ncd:revise-date 2019-05-31 ;
          }

          leaf seamless-role {
            description 'The role of Seamless BFD.' ;
            type enumeration {
              enum Invalid {
                value 0 ;
                description 'Not seamless.' ;
              }

              enum Initiator {
                value 1 ;
                description 'Initiator' ;
              }

              enum Reflector {
                value 2 ;
                description 'Reflector' ;
              }

            }

            ncd:revise-date 2019-05-31 ;
          }

          leaf detect-mode {
            description 'Actual detect mode.' ;
            type detect-mode ;

            ncd:revise-date 2019-07-12 ;
          }

          leaf path-id {
            description 'PATH ID for SR-PATH.' ;
            type uint32 ;

            ncd:revise-date 2019-11-21 ;
          }

          leaf path-index {
            description 'PATH INDEX for SR-PATH.' ;
            type uint32 ;

            ncd:revise-date 2020-02-20 ;
          }

          leaf path-type {
            description 'PATH TYPE for SR-PATH.' ;
            type string ;

            ncd:revise-date 2020-02-20 ;
          }

          leaf template-name {
            if-feature location-board ;

            description 'Template name.' ;
            type string {
              length 1..31 {
                description 'Template name.' ;
              }

            }

            ncd:revise-date 2020-02-20 ;
          }

          leaf working-board {
            if-feature location-board ;

            description 'Working Board name.' ;
            type string {
              length 1..31 {
                description 'Working board Name.' ;
              }

            }

            ncd:revise-date 2020-02-20 ;
          }

          leaf standby-board {
            if-feature location-board ;

            description 'Standby board name.' ;
            type string {
              length 1..31 {
                description 'Protect board name.' ;
              }

            }

            ncd:revise-date 2020-02-20 ;
          }

          leaf sub-domain-id {
            description 'Sub-domain ID.' ;
            type uint8 ;

            ncd:revise-date 2020-07-02 ;
          }

          leaf bfr-id {
            description 'Bit-Forwarding Router ID.' ;
            type uint16 ;

            ncd:revise-date 2020-07-02 ;
          }

          leaf mpls-label {
            description 'mpls label.' ;
            type uint32 ;

            ncd:revise-date 2020-07-02 ;
          }

          leaf flex-algo {
            description 'Flex-algo ID.' ;
            type uint8 {
              range 128..255 {
                description 'Flex-algo ID for SR BE BFD,the range of this parameter is 128-255.' ;
              }

            }

            ncd:revise-date 2021-11-02 ;
          }

          leaf slice-id {
            description 'Slice ID.' ;
            type uint32 {
              range 1..2147483647 {
                description 'Slice ID.' ;
              }

            }

            ncd:revise-date 2023-02-17 ;
          }

          leaf slice-prefix {
            description 'Slice prefix name.' ;
            type string {
              length 1..63 {
                description 'Slice prefix name.' ;
              }

            }

            ncd:revise-date 2023-02-17 ;
          }

          leaf strict-mode {
            description 'Whether strict mode is on or off.' ;
            type uint8 {
              range 1 {
                description 'Strict mode.' ;
              }

            }

            ncd:revise-date 2023-02-17 ;
          }

          leaf echo-source {
            description 'Echo source  for SingleHop session working on echo mode.' ;
            type string {
              length 0..47 {
                description 'Echo source  for SingleHop session working on echo mode.' ;
              }

            }

            ncd:revise-date 2023-11-23 ;
          }

          leaf remote-state {
            description 'Remote state for BFD session.' ;
            type enumeration {
              enum ADMINDOWN {
                value 0 ;
              }

              enum DOWN {
                value 1 ;
              }

              enum INIT {
                value 2 ;
              }

              enum UP {
                value 3 ;
              }

            }

            ncd:revise-date 2023-12-27 ;
          }

          leaf ip-router-alert {
            type switch-set ;

            description 'If send BFD packets with router alert option.' ;
            ncd:revise-date 2024-01-08 ;
          }

          ncd:select ld ;
          ncd:select summary-detect-type ;
          ncd:select "local-address remote-address summary-detect-type" ;
          ncd:select "fec-address summary-detect-type" ;
          ncd:select "tunnel-id summary-detect-type" ;
          ncd:select "if-name summary-detect-type" ;
          ncd:select "pw-name summary-detect-type" ;
          ncd:select "ld instance-name" ;
          ncd:select "summary-detect-type path-id" ;
          ncd:select "summary-detect-type sub-domain-id bfr-id" ;
        }

      }

    }

  }

  notification notification-bfd-sessions {
    description 'Notification of BFD sessions.' ;
    container bfd-sessions {
      description 'Notification of BFD sessions.' ;
      config false ;
      list bfd-session {
        description 'The detail notification information of BFD session.' ;
        key 'ld instance-name' ;
        leaf ld {
          description 'Local discriminator for BFD session.' ;
          type uint32 ;

        }

        leaf instance-name {
          description 'Instance name for BFD session.' ;
          type string {
            length 0..64 {
              description 'Instance name for BFD session.' ;
            }

          }

        }

        leaf rd {
          description 'Remote discriminator for BFD session.' ;
          type uint32 ;

        }

        leaf protocol-type {
          description 'Protocol type for BFD session.' ;
          type ncd:string-with-blank {
            length 0..128 {
              description 'Protocol type for BFD session.' ;
            }

          }

        }

        leaf detect-type {
          description 'Detail detect type for BFD session.' ;
          type enumeration {
            enum SingleHop {
              value 0 ;
            }

            enum MultiHop {
              value 1 ;
            }

            enum LDP-Active {
              value 2 ;
            }

            enum LDP-Passive {
              value 3 ;
            }

            enum RSVP-TUNNEL-Active {
              value 4 ;
            }

            enum RSVP-LSP-Active {
              value 5 ;
            }

            enum RSVP-Passive {
              value 6 ;
            }

            enum PwType {
              value 7 ;
            }

            enum L2link {
              value 8 ;
            }

            enum Bidirection-RSVP-LSP {
              value 9 ;
            }

            enum Static-LDP {
              value 10 ;
            }

            enum Static-RSVP-TUNNEL {
              value 11 ;
            }

            enum Lag {
              value 12 ;
            }

            enum SubSingleHop {
              value 13 ;
            }

            enum SrBe {
              value 14 ;
            }

            enum Mldp {
              value 15 ;
            }

            enum Mldp-Passive {
              value 16 ;
            }

            enum Mte {
              value 17 ;
            }

            enum Mte-Passive {
              value 18 ;
            }

            enum SrPath {
              value 19 ;
            }

            enum Srv6Te {
              value 20 ;
            }

            enum Srv6Lsp {
              value 21 ;
            }

            enum Srv6PolicySl {
              value 23 ;
            }

            enum Srv6Policy {
              value 24 ;
            }

            enum SrMplsPolicy {
              value 25 ;
            }

            enum MvpnBier {
              value 26 ;
            }

            enum MvpnBier-Passive {
              value 27 ;
            }

            enum GEN-LSP-Active {
              value 28 ;
            }

            enum GEN-LSP-Passive {
              value 29 ;
            }

            enum SrMplsPolicySL {
              value 30 ;
            }

            enum Srv6Be {
              value 22 ;
            }

            enum Srv6EvpnVpws {
              value 31 ;
            }

          }

        }

        leaf state {
          description 'State for BFD session.' ;
          type enumeration {
            enum ADMINDOWN {
              value 0 ;
            }

            enum DOWN {
              value 1 ;
            }

            enum INIT {
              value 2 ;
            }

            enum UP {
              value 3 ;
            }

          }

        }

        leaf local-diag {
          description "Local system's reason for the last change in BFD session state." ;
          type uint32 ;

        }

        leaf delete-flag {
          description 'If BFD session delete or not.' ;
          type boolean ;

          default false ;
        }

        leaf down-reason {
          description 'Down reason of BFD session.' ;
          type enumeration {
            enum RCV_ADMINDOWN {
              value 0 ;
            }

            enum LP_OFF_LINE {
              value 1 ;
            }

            enum INTERFACE_DELETE {
              value 2 ;
            }

            enum FAIL_TO_CHOOSE_BOARD {
              value 3 ;
            }

            enum FTM_UP_DOWN {
              value 4 ;
            }

            enum DETECT_TIME_OUT {
              value 5 ;
            }

            enum UP_RCV_DOWN {
              value 6 ;
            }

            enum LINKLOCAL_DELETE {
              value 7 ;
            }

            enum V6INTERFACE_DISABLE {
              value 8 ;
            }

            enum AC_DOWN {
              value 9 ;
            }

            enum STATE_REROLL {
              value 10 ;
            }

            enum INTERFACE_NOT_SUPPORT {
              value 11 ;
            }

            enum CREATE_BUT_NOT_UP {
              value 12 ;
            }

            enum AUTH_CHANGE {
              value 13 ;
            }

            enum SHUT_DOWN {
              value 14 ;
            }

            enum SUB_SESSION_DOWN {
              value 15 ;
            }

            enum SUB_SESSION_DELETE {
              value 16 ;
            }

            enum FTM_FIRST_PKT_TIMEOUT {
              value 17 ;
            }

          }

        }

        leaf local-address {
          description 'Local address for SingleHop,SubSingleHop, MultiHop BFD session. Root address for MLDP,MTE BFD session.' ;
          type string {
            length 0..47 {
              description 'Local address for BFD session.' ;
            }

          }

        }

        leaf remote-address {
          description 'Remote address for SingleHop,SubSingleHop, MultiHop,RSVP-TUNNEL-Active,Static-RSVP-TUNNEL,RSVP-LSP-Active,Bidirection-RSVP-LSP,L2link,Lag BFD sessions. extend tunnle id for MLDP,MTE BFD BFD passive sessions.' ;
          type string {
            length 0..47 {
              description 'Remote address for BFD session.' ;
            }

          }

        }

        leaf if-name {
          description 'Output interface for BFD session.' ;
          type string {
            length 0..32 {
              description 'Output interface for BFD session.' ;
            }

          }

        }

        leaf vrf-name {
          description 'VRF name for BFD session.' ;
          type string {
            length 0..36 {
              description 'VRF name for BFD session.' ;
            }

          }

        }

        leaf fec-address {
          description 'FEC address for LDP BFD.' ;
          type string ;

        }

        leaf mask-length {
          description 'Mask length.' ;
          type uint8 ;

        }

        leaf tunnel-id {
          description 'TE TunnelID for RSVP BFD.' ;
          type uint32 ;

        }

        leaf lsp-id {
          description 'Lspid for RSVP LSP BFD.' ;
          type uint16 ;

        }

        leaf lsp-role {
          description 'Lsp role for RSVP LSP BFD,include maste and slave.' ;
          type enumeration {
            enum --- {
              value 0 ;
            }

            enum master {
              value 1 ;
            }

            enum slave {
              value 2 ;
            }

          }

        }

        leaf pw-name {
          description 'PW name for PW BFD.' ;
          type string {
            length 0..32 {
              description 'PW name for PW BFD.' ;
            }

          }

        }

        leaf pw-ttl {
          description 'PW TTL value for PW BFD.' ;
          type uint16 ;

        }

        leaf leaf-id {
          description 'Leaf id for MTE/MLDP BFD.' ;
          type uint32 ;

          ncd:revise-date 2019-05-20 ;
        }

        leaf opaque-type {
          description 'MLDP Opaque type.' ;
          type enumeration {
            enum Tunnel-Id {
              value 1 ;
            }

            enum Invalid {
              value 0 ;
            }

          }

          ncd:revise-date 2019-05-20 ;
        }

        leaf p2mp-id {
          description 'P2MP ID  for MTE.' ;
          type uint32 ;

          ncd:revise-date 2019-05-20 ;
        }

        leaf path-id {
          description 'PATH ID for SR-PATH.' ;
          type uint32 ;

          ncd:revise-date 2019-11-21 ;
        }

        leaf path-index {
          description 'PATH INDEX for SR-PATH.' ;
          type uint32 ;

          ncd:revise-date 2020-02-20 ;
        }

        leaf path-type {
          description 'PATH TYPE for SR-PATH.' ;
          type string ;

          ncd:revise-date 2020-02-20 ;
        }

        leaf sub-domain-id {
          description 'Sub-domain ID.' ;
          type uint8 ;

          ncd:revise-date 2020-07-02 ;
        }

        leaf bfr-id {
          description 'Bit-Forwarding Router ID.' ;
          type uint16 ;

          ncd:revise-date 2020-07-02 ;
        }

        leaf mpls-label {
          description 'mpls label.' ;
          type uint32 ;

          ncd:revise-date 2020-07-02 ;
        }

        leaf flex-algo {
          description 'Flex-algo ID.' ;
          type uint8 {
            range 128..255 {
              description 'Flex-algo ID for SR BE BFD,the range of this parameter is 128-255.' ;
            }

          }

          ncd:revise-date 2021-11-02 ;
        }

        leaf slice-id {
          description 'Slice ID.' ;
          type uint32 {
            range 1..2147483647 {
              description 'Slice ID.' ;
            }

          }

          ncd:revise-date 2023-02-17 ;
        }

        leaf slice-prefix {
          description 'Slice prefix name.' ;
          type string {
            length 1..63 {
              description 'Slice prefix name.' ;
            }

          }

          ncd:revise-date 2023-02-17 ;
        }

        leaf strict-mode {
          description 'Whether strict mode is on or off.' ;
          type uint8 {
            range 1 {
              description 'Strict mode.' ;
            }

          }

          ncd:revise-date 2023-02-17 ;
        }

        leaf echo-source {
          description 'Echo source  for SingleHop session working on echo mode.' ;
          type string {
            length 0..47 {
              description 'Echo source  for SingleHop session working on echo mode.' ;
            }

          }

          ncd:revise-date 2023-11-23 ;
        }

        leaf ip-router-alert {
          type switch-set ;

          description 'If send BFD packets with router alert option.' ;
          ncd:revise-date 2024-01-08 ;
        }

      }

    }

    ncd:revise-date 2016-11-23 ;
  }

}
