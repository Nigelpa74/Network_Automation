  revision 2013-10-14 {
    description 'Initial version.' ;
  }

  feature backpath-check ;

  feature session-admin-down {
    description 'Session admin-down' ;
  }

  feature location-board {
    description 'BFD location board configuration.' ;
  }

  feature template-for-session {
    description 'BFD session configration with template name.' ;
  }

  feature track-interface {
    description 'Track interface state.' ;
    ncd:revise-date 2024-01-17 ;
  }

  feature dcn {
    description 'BFD session configration with DCN.' ;
  }

  feature mode {
    description 'BFD negotiation mode' ;
  }

  feature gen-lsp-bfd {
    description 'Generic LSP BFD detect type.' ;
  }

  feature extend-max-ld-set ;

  feature srv6-be {
    description 'SRv6 BE BFD function.' ;
  }

  typedef detect-mode {
    description 'Detect mode.' ;
    type enumeration {
      enum Asynchronous {
        value 1 ;
        description 'Asynchronous mode' ;
      }

      enum Single-arm-echo {
        value 2 ;
        description 'Single-arm-echo mode' ;
      }

    }

  }

  typedef interface-check {
    description 'Whether check receiving interface is same with sending interface of ECHO BFD.' ;
    type enumeration {
      enum disable {
        value 0 ;
        description 'Do not check receiving interface.' ;
      }

      enum enable {
        value 1 ;
        description 'Check receiving interface.' ;
      }

    }

  }

  typedef lsp-ping-reply {
    type enumeration {
      enum not-reply {
        value 0 ;
      }

      enum according-to-reply-mode {
        value 1 ;
      }

    }

    description 'If send echo reply' ;
  }

  typedef switch-set {
    description 'Configure is enable or disable.' ;
    type enumeration {
      enum disable {
        value 0 ;
        description 'Disable.' ;
      }

      enum enable {
        value 1 ;
        description 'Enable.' ;
      }

    }

  }

  typedef policy-set {
    description 'Configure location board policy.' ;
    type enumeration {
      enum standalone {
        value 1 ;
        description 'Choose only one board.' ;
      }

      enum redundant {
        value 2 ;
        description 'Choose two boards.' ;
      }

    }

  }

  container configuration {
    description 'Configuration model info.' ;
    container bfd {
      description 'Configure BFD parameters.' ;
      container global {
        description 'Configure BFD global parameters.' ;
        leaf multiport {
          description 'Configure multicast IPv4 address for l2-bfd.' ;
          type ncd:ipv4-address ;

          default 224.0.0.250 ;
        }

        container location-paras {
          description 'Configure BFD local parameters.' ;
          list resource-board {
            description 'Configure BFD resource board' ;
            key if-name ;
            leaf if-name {
              description 'Configure BFD location interface.' ;
              type ncd:ifname {
                length 1..31 {
                  description 'Output interface for p2mp' ;
                }

              }

            }

          }

          ncd:revise-date 2019-05-09 ;
        }

        container passive-suppresses {
          description 'Configure BFD passive suppression' ;
          list passive-suppress {
            description 'Suppress passive BFD' ;
            key suppress-type ;
            leaf suppress-type {
              description 'Suppress passive BFD' ;
              type enumeration {
                enum p2mp-passive {
                  value 1 ;
                  description 'P2MP passive BFD' ;
                }

                enum p2p-passive {
                  value 2 ;
                  description 'P2P passive BFD' ;
                }

              }

            }

          }

          ncd:revise-date 2019-05-09 ;
        }

        container ipv4-echo-paras {
          description 'IPv4 echo parameters.' ;
          leaf ipv4-echo-source {
            description 'Global source address of IPv4 echo BFD.' ;
            type ncd:ipv4-address-none-zero ;

          }

          ncd:revise-date 2019-07-12 ;
        }

        container ipv6-echo-paras {
          description 'IPv6 echo parameters.' ;
          leaf ipv6-echo-source {
            description 'Global source address of IPv6 echo BFD.' ;
            type ncd:ipv6-address ;

          }

          ncd:revise-date 2019-07-12 ;
        }

        container backpath-check {
          if-feature backpath-check ;

          description 'Check RSVP-TE back-path if match with forward path.' ;
          leaf backpath-check {
            description 'Check RSVP-TE back-path if match with forward path.' ;
            type enumeration {
              enum disable {
                value 0 ;
                description 'Disable RSVP BFD backpath check with forward path' ;
              }

              enum enable {
                value 1 ;
                description 'Enable RSVP BFD backpath check with forward path' ;
              }

            }

          }

          container exclude-tunnels {
            description 'Add exception which not do back-path check.' ;
            list exclude {
              description 'Add exception which not do back-path check.' ;
              key tunnel-id ;
              leaf tunnel-id {
                description 'The tunnel-id which not do back-path check.' ;
                type uint32 {
                  range 1..4294967295 {
                    description 'TE TunnelID for RSVP TUNNEL BFD,the range of this parameter depends on the device.' ;
                  }

                }

              }

            }

          }

          ncd:revise-date 2019-09-26 ;
        }

        container board-paras {
          description 'Configure BFD location board parameters.' ;
          leaf policy {
            if-feature location-board ;

            description 'BFD location policy.' ;
            type policy-set ;

          }

          list board {
            if-feature location-board ;

            description 'BFD location board.' ;
            key name ;
            leaf name {
              description 'Board name.' ;
              type ncd:board {
                length 1..31 {
                  description 'Board name.' ;
                }

              }

            }

          }

          ncd:revise-date 2020-02-20 ;
        }

        container mode {
          if-feature mode ;

          description 'Configure BFD negotiation mode.' ;
          leaf mode {
            type enumeration {
              enum software {
                value 0 ;
                description 'Negotiate by software.' ;
              }

              enum hardware {
                value 1 ;
                description 'Negotiate by hardware' ;
              }

            }

            default software ;
          }

          ncd:revise-date 2020-07-01 ;
        }

        container extend-max-ld-set {
          if-feature extend-max-ld-set ;

          description 'Configure BFD extend max discriminator' ;
          leaf extend-max-ld-set {
            description 'Configure BFD extend maximum discriminator' ;
            type enumeration {
              enum disable {
                value 0 ;
                description 'Disable the extended maximum LD.' ;
              }

              enum enable {
                value 1 ;
                description 'Enable the extended maximum LD.' ;
              }

            }

            default disable ;
          }

          ncd:revise-date 2020-07-23 ;
        }

        container ignore-mismatch-down-packet {
          description 'Configure BFD the adility of ignoring error packets.' ;
          leaf ignore-mismatch-down-packet {
            description 'When the state of BFD session is up, ignore received error packets.' ;
            type enumeration {
              enum disable {
                value 0 ;
                description 'Disable the ability of ignoring error packets.' ;
              }

              enum enable {
                value 1 ;
                description 'Enable the ability of ignoring error packets.' ;
              }

            }

            default enable ;
          }

          ncd:revise-date 2021-06-09 ;
        }

        container mpls-bfd-paras {
          leaf ip-router-alert {
            description 'If send BFD packets with router alert option' ;
            type switch-set ;

            default disable ;
          }

          description 'LSP BFD parameters' ;
          ncd:revise-date 2024-01-08 ;
        }

        container periodic-lsp-ping-paras {
          description 'LSP BFD parameters' ;
          leaf reply-policy {
            type lsp-ping-reply ;

            description 'If send echo reply for BFD' ;
            default not-reply ;
          }

          ncd:revise-date 2024-01-08 ;
        }

      }

      container sessions {
        description 'Configure BFD instance parameters.' ;
        list session {
          description 'Configure BFD instance parameters.' ;
          key instance-name ;
          leaf instance-name {
            description 'Instance name for BFD session.' ;
            type string {
              length 1..64 {
                description 'Instance name for BFD session.' ;
              }

            }

          }

          choice detect-type {
            description 'Detect type for BFD session.' ;
            mandatory true ;
            case v4-link-bfd {
              description 'Single-hop IPv4 BFD.' ;
              container v4-link-bfd {
                description 'Single-hop IPv4 BFD.' ;
                leaf local-address {
                  description 'Local address for IPv4 link BFD.' ;
                  type ncd:ipv4-address ;

                  mandatory true ;
                }

                leaf remote-address {
                  description 'Remote address for IPv4 link BFD.' ;
                  type ncd:ipv4-address ;

                  mandatory true ;
                }

                leaf if-name {
