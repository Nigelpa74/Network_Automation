            leaf unicast-inrate-bps {
              description 'The unicast input bytes rate.' ;
              type uint64 {
                range 1..18446744073709551615 {
                  description 'The range of unicast input packets rate.' ;
                }

              }

              units bps ;
            }

            leaf unicast-inrate-pps {
              description 'The unicast input packets rate.' ;
              type uint32 {
                range 1..4294967295 {
                  description 'The range of unicast input packets rate.' ;
                }

              }

