          container qos-parameters {
            description 'The QoS parameters of PW.' ;
            choice qos-params-type {
              description 'The QoS parameters type of PW.' ;
              case bandwidth-params {
                description 'The bandwidth parameters of PW.' ;
                container bandwidth {
                  description 'The bandwidth of PW.' ;
                  presence bandwidth ;
                  leaf cir {
                    description 'The committed bandwidth value of the PW.' ;
                    type uint32 {
                      range "0 | 1..4294967295" {
                        description 'The range of the committed bandwidth value.' ;
                      }

                    }

                    units kbps ;
                    mandatory true ;
                  }

                  leaf cbs {
                    description 'The committed burst size value of the PW.' ;
                    type uint32 {
                      range 1..4294967295 {
                        description 'The range of committed burst size value.' ;
                      }

                    }

                    units KB ;
                  }

                  leaf pir {
                    description 'The peak bandwidth value of the PW.' ;
                    type uint32 {
                      range "0 | 1..4294967295" {
                        description 'The range of peak bandwidth value.' ;
                      }

                    }

                    units kbps ;
                  }

                  leaf pbs {
                    description 'The excess burst size value of the PW.' ;
                    type uint32 {
                      range 1..4294967295 {
                        description 'The range of excess burst size value.' ;
                      }

                    }

                    units KB ;
                  }

                }

              }

              case rate-limit-params {
                description 'The rate limit parameters of PW.' ;
                container rate-limit {
                  description 'The rate limit of PW.' ;
                  presence rate-limit ;
                  leaf mode {
                    description 'The mode of PW rate limit.' ;
                    type enumeration {
                      enum blind {
                        value 1 ;
                        description 'The mode of PW rate limit is blind.' ;
                      }

                      enum aware {
                        value 2 ;
                        description 'The mode of PW rate limit is aware.' ;
                      }

                    }

                    mandatory true ;
                  }

                  leaf cir {
                    description 'The committed information rate value of PW rate limit.' ;
                    type uint32 {
                      range "0 | 1..4294967295" {
                        description 'The range of committed information rate value.' ;
                      }

                    }

                    units kbps ;
                    mandatory true ;
                  }

                  leaf cbs {
                    description 'The committed burst size value of PW rate limit.' ;
                    type uint32 {
                      range 1..4294967295 {
                        description 'The range of committed burst size value.' ;
                      }

                    }

                    units KB ;
                    mandatory true ;
                  }

                  leaf pir {
                    description 'The peak information rate value of PW rate limit.' ;
                    type uint32 {
                      range "0 | 1..4294967295" {
                        description 'The range of peak information rate value.' ;
                      }

                    }

                    units kbps ;
                    mandatory true ;
                  }

                  leaf pbs {
                    description 'The peak burst size value of PW rate limit.' ;
                    type uint32 {
                      range 1..4294967295 {
                        description 'The range of peak burst size value.' ;
                      }

                    }

                    units KB ;
                    mandatory true ;
                  }

                  leaf red {
                    description 'The packet color parameter.' ;
                    type enumeration {
                      enum forward {
                        value 1 ;
                        description 'The packet action is forward.' ;
                      }

                      enum discard {
                        value 2 ;
                        description 'The packet action is discard.' ;
                      }

                    }

                    ncd:revise-date 2019-03-25 ;
                  }

                }

              }

            }

          }

          container vccv-bfd-params {
            description 'The VCCV BFD parameters info of PW.' ;
            leaf vccv-bfd {
              description 'The BFD capability of the PW.' ;
