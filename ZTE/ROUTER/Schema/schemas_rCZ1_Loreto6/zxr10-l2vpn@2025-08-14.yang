                enum green {
                  value 1 ;
                  description 'The QoS packet colour is green.' ;
                }

                enum yellow {
                  value 2 ;
                  description 'The QoS packet colour is yellow.' ;
                }

                enum red {
                  value 3 ;
                  description 'The QoS packet colour is red.' ;
                }

              }

            }

            leaf ac-fault-associate {
