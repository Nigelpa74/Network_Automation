                        leaf local-vpws-id {
                          description 'Config local VPWS ID.' ;
                          type uint32 {
                            range 4096..4294967294 {
                              description 'The range of local VPWS ID.' ;
                            }

                          }

                          mandatory true ;
                        }

                        leaf remote-vpws-id {
                          description 'Config remote VPWS ID.' ;
                          type uint32 {
                            range 4096..4294967294 {
                              description 'The range of remote VPWS ID.' ;
                            }

                          }

                          mandatory true ;
                        }

                        leaf encapsulation {
                          description 'The encapsulation of the EVPN-PW.' ;
                          type enumeration {
                            enum tagged {
                              value 4 ;
                              description 'The default encapsulation is tagged.' ;
                            }

                            enum raw {
                              value 5 ;
                              description 'The default encapsulation is raw.' ;
                            }

                          }

                        }

                        leaf control-word {
                          description 'The control-word capability.' ;
                          type enumeration {
                            enum not-preferred {
                              value 0 ;
                              description 'The control-word capability is not preferred.' ;
                            }

                            enum preferred {
                              value 1 ;
                              description 'The control-word capability is preferred.' ;
                            }

                          }

                          default not-preferred ;
                        }

                        leaf tunnel-policy-name {
                          description 'The tunnel policy name.' ;
                          type string {
                            length 1..63 {
                              description 'The length of tunnel policy name.' ;
                            }

                          }

                        }

                        leaf track-name {
                          description 'The name of the track object.' ;
                          type string {
                            length 1..31 {
                              description 'The length of track name.' ;
                            }

                          }

                        }

                        container tunnel-destination {
                          description 'The address as tunnel destination.' ;
                          choice destination-type {
                            description 'The tunnel destination type.' ;
                            case ipv6 {
                              description 'The tunnel destination type is ipv6.' ;
                              leaf tunnel-destination-ipv6 {
                                description 'IPv6 address as tunnel destination.' ;
                                type ncd:ipv6-address {
                                  pattern "([0-9a-fA-F]{1,4}:){7}([0-9a-fA-F]{0,4})$|^([0-9a-fA-F]{1,4}:){1,6}(:[0-9a-fA-F]{0,4}){1,6}$|^([:]{2})(([0-9a-fA-F]{1,4}:){0,6})([0-9a-fA-F]{1,4})$|^([0-9a-fA-F]{1,4}:){6}([0-9]{1,3}.){3}([0-9]{1,3})$|^([0-9a-fA-F]{1,4}:){1,5}(:[0-9a-fA-F]{0,4}){1,5}([0-9]{1,3}.){3}([0-9]{1,3})$|^([:]{2})(([0-9a-fA-F]{1,4}:){0,5})([0-9]{1,3}.){3}([0-9]{1,3})" ;

                                }

                              }

                            }

                            case ipv4 {
                              description 'The tunnel destination type is ipv4.' ;
                              leaf tunnel-destination-ipv4 {
                                description 'IPv4 address as tunnel destination.' ;
                                type ncd:ipv4-address-none-zero ;

                              }

                            }

                          }

                        }

                      }

                    }

                    case srv6 {
                      description 'The local encapsulation is SRv6.' ;
                      container evpn-vpws-srv6 {
                        description 'SRv6 encapsulation of EVPN VPWS.' ;
                        presence evpn-vpws-srv6 ;
