            container martini-discovery {
              if-feature martini-discovery ;

              description 'Martini auto discovery configuration info.' ;
              presence "Martini discovery type" ;
              container martini-params {
                description 'Martini auto discovery configuration parameter.' ;
                list martini-vpls-params {
                  description 'Martini auto discovery configuration parameter of VPLS.' ;
                  key vpls-id ;
                  leaf vpls-id {
                    description 'VPLS instance auto-discovery identifier.' ;
                    type union {
                      type ncd:asn-nn ;

                      type ncd:ipadd-nn ;

                    }

                  }

                  leaf sspw-target-differ-from-ldp {
                    description 'The target PE address is different from the target LDP identifier.' ;
                    type empty ;

                    ncd:revise-date 2022-12-05 ;
                  }

                }

              }

              container route-target-params {
                description 'The route target params.' ;
                list route-target {
                  description 'The route target.' ;
                  key 'rt-value effect-type' ;
                  leaf rt-value {
                    description 'The route target parameter.' ;
                    type union {
                      type ncd:asn-nn ;

                      type ncd:ipadd-nn ;

                    }

                  }

                  leaf effect-type {
                    description 'The route target effect type.' ;
                    type enumeration {
                      enum export {
                        value 2 ;
                        description 'The route target effect type is export.' ;
                      }

                      enum import {
                        value 3 ;
                        description 'The route target effect type is import.' ;
                      }

                    }

                  }

                }

              }

              container pw-details-params {
                description 'The PW details params.' ;
                list pw-details {
                  description 'The PW details info.' ;
                  key peer-address ;
                  leaf peer-address {
                    description 'The IP address of remote endpoint.' ;
                    type ncd:ipv4-address-none-zero ;

                  }

                  leaf encap-type {
                    description 'The encapsulation type of the auto PW.' ;
                    type enumeration {
                      enum ethernet-tagged {
                        value 4 ;
                        description 'The encapsulation type of the auto PW is ethernet tagged.' ;
                      }

                      enum ethernet {
                        value 5 ;
                        description 'The encapsulation type of the auto PW is ethernet.' ;
                      }

                    }

                    default ethernet ;
                  }

                  leaf tunnel-policy-name {
                    description 'The tunnel policy name of the auto PW.' ;
                    type string {
                      length 1..63 {
                        description 'The length of tunnel policy name.' ;
                      }

                    }

                  }

                  leaf control-word {
                    description 'The control-word capability of the auto PW.' ;
                    type enumeration {
                      enum not-preferred {
                        value 0 ;
                        description 'The control-word capability of the auto PW is not preferred.' ;
                      }

                      enum preferred {
                        value 1 ;
                        description 'The control-word capability of the auto PW is preferred.' ;
                      }

                    }

                    default not-preferred ;
                  }

                  leaf traffic-enable {
                    description 'The traffic statistics status of Martini PW.' ;
                    type enumeration {
                      enum disable {
                        value 0 ;
                        description 'The traffic statistics status of Martini PW is disable.' ;
                      }

                      enum enable {
                        value 1 ;
                        description 'The traffic statistics status of Martini PW is enable.' ;
                      }

                    }

                    default disable ;
                  }

                  leaf vccv-flow-label {
                    description 'The flow-label for VCCV packets without standard flow-labels.' ;
                    type empty ;

                    ncd:revise-date 2022-03-15 ;
                  }

                  container vccv-bfd-params {
                    description 'The VCCV BFD parameters info of Martini PW.' ;
