                  description 'The description range of instance.' ;
                }

              }

            }

            leaf mtu {
              type uint16 {
                range 60..65535 {
                  description 'The range of MTU.' ;
                }

              }

              description 'The MTU value of the remote monitor instance.' ;
              default 1500 ;
              ncd:revise-date 2025-08-14 ;
            }

            leaf mtu-mismatch-ignore {
              type empty ;

              description 'Ignore the MTU mismatch in the PW negotiation.' ;
              ncd:revise-date 2025-08-14 ;
            }

            container monitor-pw-bind {
              description 'Remote monitor PW binding instance info.' ;
              list pw-instance-bind {
                description 'PW binding instance configuration info.' ;
                key pw-name ;
                leaf pw-name {
                  description 'The name of the PW in the bind.' ;
                  type ncd:ifname ;

                }

              }

            }

          }

        }

        container admin-vpls-instances {
          if-feature admin-vpls-instances ;

          description 'The administrator VPLS instances configuration info.' ;
          list admin-vpls-instance {
            description 'The admin VPLS instance.' ;
            key instance-name ;
            leaf instance-name {
              description 'The name of the administrator VPLS instance.' ;
              type string {
                length 1..32 {
                  description 'The length of instance name.' ;
                }

              }

            }

            leaf description {
              description 'The description of the administrator VPLS instance.' ;
              type ncd:string-with-blank {
                length 1..104 {
                  description 'The description range of instance.' ;
                }

              }

            }

            leaf mtu {
              type uint16 {
                range 60..65535 {
                  description 'The range of MTU.' ;
                }

              }

              description 'The MTU value of the administrator VPLS instance.' ;
              default 1500 ;
              ncd:revise-date 2025-08-14 ;
            }

            leaf mtu-mismatch-ignore {
              type empty ;

              description 'Ignore the MTU mismatch in the PW negotiation.' ;
              ncd:revise-date 2025-08-14 ;
            }

            container admin-vpls-pw-bind {
              description 'Administrator VPLS PW binding instance info.' ;
              list pw-instance-bind {
                description 'PW binding instance configuration info.' ;
                key pw-name ;
                leaf pw-name {
                  description 'The name of the PW in the bind.' ;
                  type ncd:ifname ;

                }

              }

            }

          }

        }

        container evpn-vpls-instances {
          description 'The EVPN VPLS instances configuration info.' ;
          list evpn-vpls-instance {
            description 'The EVPN VPLS instance configuration info.' ;
            key instance-name ;
            leaf instance-name {
              description 'The name of the EVPN VPLS instance.' ;
              type string {
                length 1..32 {
                  description 'The length of instance name.' ;
                }

              }

            }

            leaf service-id {
              description 'The service ID of EVPN VPLS instance,the service ID attribute cannot be modified or removed after its owner instance created.' ;
              type uint32 {
                range 1..65535 {
                  description 'The range of service ID.' ;
                }

              }

              ncd:revise-date 2017-11-15 ;
            }

            leaf equivalent-vxlan-id {
              description 'The equivalent VXLAN ID,the equivalent VXLAN attribute cannot be modified or removed after its owner instance created.' ;
              type uint32 {
                range 1..16777215 {
                  description 'The equivalent VXLAN ID range.' ;
                }

              }

              ncd:revise-date 2018-01-26 ;
            }

            leaf qualified {
              description 'The qualified flag of the EVPN VPLS instance.' ;
              type enumeration {
                enum unqualified {
                  value 0 ;
                  description 'The EVPN VPLS instance is unqualified.' ;
                }

                enum qualified {
                  value 1 ;
                  description 'The EVPN VPLS instance is qualified.' ;
                }

              }

              default unqualified ;
              ncd:revise-date 2019-04-30 ;
            }

            leaf shared-flood-list {
              description 'A common flood-list shared by these MAC spaces.' ;
              type enumeration {
                enum disable {
                  value 0 ;
                  description 'The EVPN VPLS instance shared-flood-list is disabled.' ;
                }

                enum enable {
                  value 1 ;
                  description 'The EVPN VPLS instance shared-flood-list is enabled.' ;
                }

              }

              default disable ;
              ncd:revise-date 2023-01-31 ;
            }

            leaf wtr-time {
              type uint8 {
                range 0..12 {
                  description 'The length of WTR time in minute.' ;
                }

              }

              description 'Set minutes in WTR. Requires setting wtr-second-with-minute simultaneously. The range is 0-12(minutes).' ;
              default 3 ;
              units min ;
              ncd:revise-date 2019-02-15 ;
            }

            leaf wtr-second-with-minute {
              type uint8 {
                range 0..59 {
                  description 'The length of WTR second time in minute.' ;
                }

              }

              description 'Set seconds in WTR. Requires setting wtr-time node simultaneously. The range is 0-59(seconds).' ;
              units second ;
              ncd:revise-date 2024-08-13 ;
            }

            leaf second {
              type uint32 {
                range 0..720 {
                  description 'The length of WTR time in second.' ;
                }

              }

              description 'Set seconds in WTR. Cannot be configured simultaneously with wtr-time node or wtr-second-with-minute node. The range is 0-720(seconds). ' ;
              units second ;
              ncd:revise-date 2023-12-12 ;
            }

            leaf encapsulation {
              description 'The encapsulation type of the EVPN.' ;
              type enumeration {
                enum tagged {
                  value 4 ;
                  description 'The encapsulation type is tagged.' ;
                }

                enum raw {
                  value 5 ;
                  description 'The encapsulation type is raw.' ;
                }

              }

              ncd:revise-date 2019-09-17 ;
            }

            leaf originator-ip {
              description 'Configure originator IP interface.' ;
              type ncd:ifname ;

              ncd:revise-date 2019-06-29 ;
            }

            leaf df-election {
              description 'choose mode of DF.' ;
              type enumeration {
                enum lowest-preference {
                  value 1 ;
                  description 'The adjacent-node with lowest-preference is DF' ;
                }

                enum highest-preference {
                  value 2 ;
                  description 'The adjacent-node with highest-preference is DF' ;
                }

              }

              ncd:revise-date 2018-07-08 ;
            }

            leaf entropy-label {
              description 'Enable or disable entropy label.' ;
              type enumeration {
                enum disable {
                  value 0 ;
                  description 'The entropy label is disable.' ;
                }

                enum enable {
                  value 1 ;
                  description 'The entropy label is enable.' ;
                }

              }

              default disable ;
              ncd:revise-date 2019-08-10 ;
            }

            leaf instance-description {
              description 'The description of the instance.' ;
              type ncd:string-with-blank {
                length 1..104 {
                  description 'The description range of instance.' ;
                }

              }

              ncd:revise-date 2019-09-29 ;
            }

            leaf unknown-unicast {
              description 'Configure unknown unicast suppression.' ;
              type enumeration {
                enum suppress {
                  value 1 ;
                  description 'The unknown-unicast is suppressed.' ;
                }

                enum unsuppress {
                  value 0 ;
                  description 'The unknown-unicast is unsuppressed.' ;
                }

              }

              default unsuppress ;
              ncd:revise-date 2020-03-25 ;
            }

            leaf umr {
              description 'Configure the VPLS EVPN UMR role.' ;
              type enumeration {
                enum distributor {
                  value 1 ;
                  description 'Config UMR as distributor.' ;
                }

                enum receiver {
                  value 2 ;
                  description 'Config UMR as receiver.' ;
                }

                enum native {
                  value 3 ;
                  description 'Config UMR as native.' ;
                }

              }

              ncd:revise-date 2020-12-14 ;
            }

            leaf best-path {
              description 'Select the best path nexthop-priority.' ;
              type enumeration {
                enum ipv4 {
                  value 1 ;
                  description 'Select IPv4 nexthop.' ;
                }

                enum ipv6 {
                  value 2 ;
                  description 'Select IPv6 nexthop.' ;
                }

              }

              ncd:revise-date 2021-04-27 ;
            }

            leaf best-path-sr {
              description 'Configure the best route selection rule in the SR domain.' ;
              type enumeration {
                enum te-tunnel {
                  value 1 ;
                  description 'Route recursived to TE tunnel preferred.' ;
                }

                enum end-point {
                  value 2 ;
                  description 'Route with smaller end-point address preferred.' ;
                }

              }

              ncd:revise-date 2022-03-24 ;
            }

            leaf link-acl-name {
              description 'The template of link ACL name.' ;
              type string {
                length 1..31 {
                  description 'The length of link ACL name.' ;
                }

              }

              ncd:revise-date 2021-05-27 ;
            }

            leaf mtu {
              description 'The MTU value of the VPLS EVPN instance.' ;
              type uint16 {
                range 60..65535 {
                  description 'The range of MTU.' ;
                }

              }

              default 1500 ;
              ncd:revise-date 2021-11-01 ;
            }

            leaf default-color {
              description 'Configure default color.' ;
              type uint32 {
                range 1..4294967295 ;

              }

              ncd:revise-date 2021-11-25 ;
            }

            leaf mtu-mismatch-ignore {
              description 'Ignore the MTU mismatch in the PW negotiation.' ;
              type empty ;

              ncd:revise-date 2022-09-13 ;
            }

            leaf esi-proxy {
              description "Null-ESI-ACs should be a normal ESI from an external PE's viewpoint." ;
              type enumeration {
                enum single-homed-as-single-active {
                  value 1 ;
                  description 'Viewed as a single-active ESI by external PEs.' ;
                }

                enum single-homed-as-all-active {
                  value 2 ;
                  description 'Viewed as an all-active ESI by external PEs.' ;
                }

              }

              ncd:revise-date 2022-10-10 ;
            }

            container evpn-redundancy-adjust {
              description 'Redundancy-mode adjustment for remote EVPN routes.' ;
              leaf frr {
                description 'Fast-Reroute (FRR) protection mode.' ;
                type empty ;

              }

              leaf load-balance {
                description 'Load-Balance (LB) protection mode.' ;
                type empty ;

              }

              ncd:revise-date 2022-09-19 ;
            }

            container evpn-multicast {
              description 'Enter EVPN VPLS multicast configuration mode.' ;
              leaf signal-smet {
                description 'Selective multicast flag.' ;
                type enumeration {
                  enum smet {
                    value 1 ;
                    description 'The signal selective multicast value.' ;
                  }

                }

              }

              leaf signal-sync {
                description 'Selective multicast synchronization.' ;
                type enumeration {
                  enum synchronization {
                    value 1 ;
                    description 'The signal synchronization value.' ;
                  }

                }

              }

              leaf signal-igmp-proxy {
                description 'Selective multicast IGMP proxy.' ;
                type enumeration {
                  enum igmp-proxy {
                    value 1 ;
                    description 'Selective multicast IGMP proxy value.' ;
                  }

                }

              }

              leaf signal-mld-proxy {
                type enumeration {
                  enum mld-proxy {
                    description 'Selective multicast MLD proxy value.' ;
                    value 1 ;
                  }

                }

                description 'Selective multicast MLD proxy.' ;
                ncd:revise-date 2023-05-09 ;
              }

              ncd:revise-date 2021-06-16 ;
            }

            container split-horizon-params {
              description 'Configure split-horizon parameters.' ;
              leaf scenario {
                description 'Scenario of dividing split-horizon scopes.' ;
                type enumeration {
                  enum ac-isolate {
                    value 1 ;
                    description 'Different ACs are isolated from each other.' ;
                  }

                  enum multi-chassis-ac-isolate {
                    value 2 ;
                    description 'AC-isolation between different chassis' ;
                  }

                }

              }

              ncd:revise-date 2022-02-15 ;
            }

            container neighbour-ipv4 {
              description 'The neighbour address type is IPv4.' ;
              list neighbor-ipv4-params {
                description 'IPv4 address parameters.' ;
                key ipv4-address ;
                leaf ipv4-address {
                  description 'IPv4 address.' ;
                  type ncd:ipv4-address-none-zero ;

                }

                leaf domain-border {
                  description 'Domain boundary.' ;
                  type enumeration {
                    enum split-horizon-scope {
                      value 1 ;
                      description 'Configure splitHorizonBypass flag' ;
                    }

                  }

                }

              }

              ncd:revise-date 2022-02-15 ;
            }

            container neighbour-ipv6 {
              description 'The neighbour address type is IPv6.' ;
              list neighbor-ipv6-params {
                description 'IPv6 address parameters.' ;
                key ipv6-address ;
                leaf ipv6-address {
                  description 'IPv6 address.' ;
                  type ncd:ipv6-address ;

                }

                leaf domain-border {
                  description 'Domain boundary.' ;
                  type enumeration {
                    enum split-horizon-scope {
                      value 1 ;
                      description 'Configure splitHorizonBypass flag' ;
                    }

                  }

                }

              }

              ncd:revise-date 2022-02-15 ;
            }

            container traffic-statistics-params {
              description 'The traffic statistics of L2VPN service.' ;
              leaf traffic-enable {
                description 'The traffic statistics status of VPLS EVPN service.' ;
                type enumeration {
                  enum disable {
                    value 0 ;
                    description 'The traffic statistics status of VPLS EVPN service is disable.' ;
                  }

                  enum enable {
                    value 1 ;
                    description 'The traffic statistics status of VPLS EVPN service is enable.' ;
                  }

                }

                default disable ;
              }

              ncd:revise-date 2021-06-07 ;
            }

            container ip-move-dampening {
              description 'Dampening for the IP mobility among certain MACs.' ;
              leaf move-dampening-flag {
                description 'Disable or enable IP move-dampening.' ;
                type enumeration {
                  enum disable {
                    value 0 ;
                    description 'Disable IP move-dampening.' ;
                  }

                  enum enable {
                    value 1 ;
                    description 'Enable IP move-dampening.' ;
                  }

                }

                default disable ;
              }

              leaf move-dampening-count {
                description 'Set IP move-dampening count attribute.' ;
                type uint32 {
                  range 1..4294967295 {
                    description 'The range of IP move dampening count.Its maximum value depends on product,between 1-30 and to be 30 ingenerally;Its minmum value depends on product,between 1-30 and to be 1 ingenerally.' ;
                  }

                }

              }

              leaf move-dampening-interval {
                description 'Set IP move-dampening time interval attribute.' ;
                type uint32 {
                  range 1..4294967295 {
                    description 'The range of IP move dampening interval.Its maximum value depends on product,between 1-900 and to be 900 ingenerally;Its minmum value depends on product,between 1-900 and to be 1 ingenerally.' ;
                  }

                }

                units seconds ;
              }

              leaf move-dampening-timeout {
                description 'Set IP move-dampening retry timeout attribute.' ;
                type uint32 {
                  range 0..4294967295 {
                    description 'The range of IP move dampening timeout.Its maximum value depends on product,between 0-1200 and to be 1200 ingenerally;Its minmum value depends on product,between 0-1200 and to be 0 ingenerally.' ;
                  }

                }

                units seconds ;
              }

              ncd:revise-date 2019-12-18 ;
            }

            container evpn-vpls-ds-mode {
              description 'The DS mode of the EVPN VPLS instance.' ;
              leaf ds-mode {
                description 'The DS service mode of the EVPN VPLS instance.' ;
                type enumeration {
                  enum uniform {
                    value 1 ;
                    description 'DS mode is uniform.' ;
                  }

                  enum pipe {
                    value 2 ;
                    description 'DS mode is pipe.' ;
                  }

                  enum shortPipe {
                    value 3 ;
                    description 'DS mode is shortPipe.' ;
                  }

                }

              }

              leaf service-class {
                description 'The DS service class and local scheduling priority of the EVPN VPLS instance.' ;
                type enumeration {
                  enum be {
                    value 1 ;
                    description 'The DS service class is be.' ;
                  }

                  enum af1 {
                    value 2 ;
                    description 'The DS service class is af1.' ;
                  }

                  enum af2 {
                    value 3 ;
                    description 'The DS service class is af2.' ;
                  }

                  enum af3 {
                    value 4 ;
                    description 'The DS service class is af3.' ;
                  }

                  enum af4 {
                    value 5 ;
                    description 'The DS service class is af4.' ;
                  }

                  enum ef {
                    value 6 ;
                    description 'The DS service class is ef.' ;
                  }

                  enum cs6 {
                    value 7 ;
                    description 'The DS service class is cs6.' ;
                  }

                  enum cs7 {
                    value 8 ;
                    description 'The DS service class is cs7.' ;
                  }

                }

              }

              leaf colour {
                description 'The DS packet colour of the EVPN VPLS instance.' ;
                type enumeration {
                  enum green {
                    value 1 ;
                    description 'The DS packet colour is green.' ;
                  }

                  enum yellow {
                    value 2 ;
                    description 'The DS packet colour is yellow.' ;
                  }

                  enum red {
                    value 3 ;
                    description 'The DS packet colour is red.' ;
                  }

                }

              }

              ncd:revise-date 2019-06-10 ;
            }

            container route-map-params {
              description 'Route map parameters.' ;
              leaf export-map-name {
                description 'Export route map name.' ;
                type string {
                  length 1..200 {
                    description 'The length of export route map name.' ;
                  }

                }

              }

              leaf import-map-name {
                description 'Import route map name.' ;
                type string {
                  length 1..200 {
                    description 'The length of import route map name.' ;
                  }

                }

              }

              ncd:revise-date 2018-12-17 ;
            }

            container ac-fault-associate {
              description 'AC fault associate PW status or not.' ;
              leaf associate-pw {
                description 'AC fault associate PW status or not.' ;
                type enumeration {
                  enum not-associate-pw {
                    value 0 ;
                    description 'AC fault not associate PW status or signal.' ;
                  }

                  enum associate-pw-status {
                    value 1 ;
                    description 'AC fault associate PW status notify to PWE3.' ;
                  }

                  enum associate-pw-signal {
                    value 2 ;
                    description 'AC fault associate PW signal release notify to PWE3.' ;
                  }

                }

                default not-associate-pw ;
              }

              leaf spoke-pw-as-ac {
                description 'Spoke PW as AC or not.' ;
                type enumeration {
                  enum not-as-ac {
                    value 0 ;
                    description 'Spoke PW not as AC to calculate status.' ;
                  }

                  enum as-ac {
                    value 1 ;
                    description 'Spoke PW as AC to calculate status.' ;
                  }

                }

                default not-as-ac ;
              }

              leaf multi-homed-ce-pool {
                description 'Treat ACs as being attached to the same CE-pool.' ;
                type empty ;

              }

              ncd:revise-date 2022-02-15 ;
            }

            container ce-pool {
              description 'A set of CEs which are substitutes of one another.' ;
              leaf active-threshold {
                description 'The threshold for a CE-pool to be treated as up.' ;
                type uint8 {
                  range 1..100 {
                    description "The percent of a CE-pool's active ACs." ;
                  }

                }

              }

              ncd:revise-date 2022-02-15 ;
            }

            container rt-2 {
              description 'EVPN route-type 2 (MAC/IP Advertisement Route).' ;
              leaf single-active-esi-not-preferred {
                description "Type 2 route's single active ESI is not preferred." ;
                type empty ;

              }

              leaf originate {
                description 'Whether to generate EVPN MAC/IP Routes per EVPN VPLS basis.' ;
                type enumeration {
                  enum enable {
                    value 1 ;
                    description 'Local EVPN MAC/IP routes are generated.' ;
                  }

                  enum disable {
                    value 0 ;
                    description 'No local EVPN MAC/IP routes are generated.' ;
                  }

                }

                default enable ;
                ncd:revise-date 2023-01-10 ;
              }

              ncd:revise-date 2022-05-12 ;
            }

            container evpn-vpls-rd {
              description 'EVPN VPLS route distinguisher params.' ;
              presence evpn-vpls-rd ;
              choice rd-type {
                description 'RD generation type.' ;
                case rd-manual {
                  description 'RD configured manually.' ;
                  leaf rd {
                    description 'The route distinguisher parameter.' ;
                    type union {
                      type ncd:asn-nn ;

                      type ncd:ipadd-nn ;

                      type ncd:asnd-nn ;

                    }

                    mandatory true ;
                  }

                }

                case rd-auto {
                  description 'RD generated automatically.' ;
                  leaf template-based {
                    description 'Automatically generated RD based on RD template.' ;
                    type empty ;

                    mandatory true ;
                  }

                  ncd:revise-date 2022-04-20 ;
                }

              }

            }

            container bridge-interface {
              if-feature bridge-interface ;

              description 'EVPN VPLS bridge interface.' ;
              presence bridge-interface ;
              leaf interface-name {
                description 'The name of the bridge interface.' ;
                type ncd:ifname ;

                mandatory true ;
              }

            }

            container bridge-mapping {
              if-feature bridge-mapping ;

              description 'EVPN VPLS bridge mapping params.' ;
              list mapping-interface {
                description 'EVPN VPLS bridge mapping interface params.' ;
                key interface-name ;
                leaf interface-name {
                  description 'The name of the bridge interface.' ;
                  type ncd:ifname ;

                }

              }

              ncd:revise-date 2017-11-17 ;
            }

            container evpn-vpls-dynamic-vxlan {
              description 'EVPN VPLS VXLAN params.' ;
              presence evpn-vpls-dynamic-vxlan ;
              leaf dynamic-vxlan {
                description 'EVPN VPLS VXLAN auto-discovery mode.' ;
                type enumeration {
                  enum auto-discovery-vxlan {
                    value 1 ;
                    description 'VXLAN EVPN auto-discovery mode.' ;
                  }

                }

                mandatory true ;
              }

              container route-target-params {
                description 'The route target params.' ;
                list route-target {
                  description 'The route target.' ;
                  key 'rt-value effect-type' ;
                  leaf rt-value {
                    description 'RT attribute value.' ;
                    type union {
                      type ncd:asn-nn ;

                      type ncd:ipadd-nn ;

                      type ncd:asnd-nn ;

                    }

                  }

                  leaf effect-type {
                    description 'The route target effect type.' ;
                    type enumeration {
                      enum export {
                        value 2 ;
                        description 'The route target effect type is export.' ;
                      }

                      enum import {
                        value 3 ;
                        description 'The route target effect type is import.' ;
                      }

                    }

                  }

                  leaf split-horizon {
                    description 'Split-horizon group,the range is A-Z.' ;
                    type string {
                      length 1..51 ;

                    }

                    ncd:revise-date 2016-12-26 ;
                  }

                  leaf evi-rt-flag {
                    type enumeration {
                      enum evi-rt {
                        value 1 ;
                        description 'The EVI-RT flag is enable.' ;
                      }

                    }

                    description 'The EVI-RT flag.' ;
                    ncd:revise-date 2023-05-09 ;
                  }

                }

              }

              container evpn-vpls-vni-labels {
                description 'VXLAN dynamic VNI labels.' ;
                list evpn-vpls-vni-label {
                  description 'VXLAN dynamic VNI label.' ;
                  key vni-label ;
                  leaf vni-label {
                    description 'VNI label.' ;
                    type uint32 {
                      range 1..16777215 {
                        description 'The VNI label range.' ;
                      }

                    }

                  }

                  leaf split-horizon {
                    description 'Split-horizon group,the range is A-Z.' ;
                    type string {
                      length 1..51 ;

                    }

                    ncd:revise-date 2016-12-26 ;
                  }

                }

                list evpn-vpls-equivalent-vni-label {
                  description 'VXLAN equivalent VNI label.' ;
                  key vni-label ;
                  leaf vni-label {
                    description 'The equivalent VNI label.' ;
                    type uint32 {
                      range 1..16777215 {
                        description 'The equivalent VNI label range.' ;
                      }

                    }

                  }

                  leaf split-horizon {
                    description 'Split-horizon group,the range is A-Z.' ;
                    type string {
                      length 1..51 ;

                    }

                    mandatory true ;
                  }

                  ncd:revise-date 2016-12-26 ;
                }

              }

              container vtep-interface {
                status obsolete {
                  ncd:revise-date 2019-10-29 ;
                }

                description 'VTEP interface for broadcast tunnel.' ;
                presence vtep-interface ;
                leaf interface-name {
                  description 'The name of the VTEP interface.' ;
                  type ncd:ifname {
                    length 1..31 {
                      description 'The length of VTEP interface.' ;
                    }

                  }

                  mandatory true ;
                }

                ncd:revise-date 2017-09-07 ;
              }

              container vni-symmetric-params {
                description 'VNI label symmetric check parameters.' ;
                leaf symmetric-flag {
                  description 'The VNI label symmetric check flag.' ;
                  type enumeration {
                    enum unforced {
                      value 0 ;
                      description 'Not forced check VNI label symmetric.' ;
                    }

                    enum forced {
                      value 1 ;
                      description 'Forced check VNI label symmetric.' ;
                    }

                  }

                  default unforced ;
                }

                ncd:revise-date 2018-12-17 ;
              }

              container rt-2-params {
                description 'RT2 parameters.' ;
                choice rt-2-params-type {
                  description 'RT2 parameters type.' ;
                  case rt-2-label {
                    description 'RT2 label parameters.' ;
                    container single-label {
                      description 'RT2 single-label.' ;
                      presence single-label ;
                      leaf single-label-enable {
                        description 'Single label enable flag.' ;
                        type empty ;

                        mandatory true ;
                      }

                      leaf enhanced {
                        description 'Single label enhanced flag.' ;
                        type empty ;

                      }

                    }

                  }

                  case rt-2-gateway {
                    description 'RT2 gateway parameters.' ;
                    container self-as-gateway {
                      description 'RT2 self as gateway.' ;
                      leaf self-as-gateway-enable {
                        description 'Self as gateway enable flag.' ;
                        type empty ;

                      }

                    }

                  }

