      list pw-list {
        description 'PW list query info.It contains the following attributes:PW list ID and status.' ;
        key pw-list-id ;
        leaf pw-list-id {
          description 'The identification of PW list.' ;
          type uint32 {
            range 1..4096 {
              description 'The range of PW list ID.' ;
            }

          }

        }

        leaf status {
          description 'The status of PW list.' ;
          type enumeration {
            enum unknown {
              value 0 ;
              description 'PW list state is unknown.' ;
            }

            enum down {
              value 1 ;
              description 'PW list state is down.' ;
            }

            enum up {
              value 2 ;
              description 'PW list state is up.' ;
            }

          }

        }

      }

      list mc-protect-group {
        description 'The multiple chassis protect group query info.' ;
        key local-pw-name ;
        leaf local-pw-name {
          description 'The local PW name of multiple chassis protect group.' ;
          type ncd:ifname {
            length 1..31 {
              description 'The length of local PW name.' ;
            }

          }

        }

        leaf group-id {
          description 'The multiple chassis protect group identification.' ;
          type uint32 {
            range 1..8192 {
              description 'The range of multiple chassis protect group identification.' ;
            }

          }

        }

        leaf switch-flag {
          description 'The switch flag of the multiple chassis protect group.' ;
          type enumeration {
            enum yes {
              value 1 ;
              description 'The switch flag of the multiple chassis protect group is yes.' ;
            }

            enum no {
              value 2 ;
              description 'The switch flag of the multiple chassis protect group is no.' ;
            }

          }

        }

        container dni-pw-peer-info {
          description 'The DNI-PW peer information in mc protect group.' ;
          leaf peer-useable {
            description 'The DNI-PW peer chassis useable flag.' ;
            type enumeration {
              enum unknown {
                value 0 ;
                description 'Peer chassis is unknown.' ;
              }

              enum unuseable {
                value 1 ;
                description 'Peer chassis is unuseable.' ;
              }

              enum useable {
                value 2 ;
                description 'Peer chassis is useable.' ;
              }

            }

          }

          leaf peer-protect-type {
            description 'The DNI-PW peer PW protect type.' ;
            type enumeration {
              enum unknown {
                value 0 ;
                description 'The DNI-PW peer protect type is unknown.' ;
              }

              enum 1:1-unidirectional-receiving-selective {
                value 1 ;
                description 'The DNI-PW peer protect type is 1:1 unidirectional receiving selective.' ;
              }

              enum 1:1-bidirectional-receiving-selective {
                value 2 ;
                description 'The DNI-PW peer protect type is 1:1 bidirectional receiving selective.' ;
              }

              enum 1:1-unidirectional-receiving-both {
                value 3 ;
                description 'The DNI-PW peer protect type is 1:1 unidirectional receiving both.' ;
              }

              enum 1:1-bidirectional-receiving-both {
                value 4 ;
                description 'The DNI-PW peer protect type is 1:1 bidirectional receiving both.' ;
              }

              enum "1+1-unidirectional-receiving-selective" {
                value 5 ;
                description 'The DNI-PW peer protect type is 1+1 unidirectional receiving selective.' ;
              }

              enum "1+1-bidirectional-receiving-selective" {
                value 6 ;
                description 'The DNI-PW peer protect type is 1+1 bidirectional receiving selective.' ;
              }

              enum "1+1-unidirectional-receiving-both" {
                value 7 ;
                description 'The DNI-PW peer protect type is 1+1 unidirectional receiving both.' ;
              }

              enum "1+1-bidirectional-receiving-both" {
                value 8 ;
                description 'The DNI-PW peer protect type is 1+1 bidirectional receiving both.' ;
              }

            }

          }

          leaf peer-mc-role {
            description 'The DNI-PW peer PW MC role.' ;
            type enumeration {
              enum unknown {
                value 0 ;
                description 'The DNI-PW peer MC role is unknown.' ;
              }

              enum master {
                value 1 ;
                description 'The DNI-PW peer MC role is master.' ;
              }

              enum slave {
                value 2 ;
                description 'The DNI-PW peer MC role is slave.' ;
              }

            }

          }

          leaf peer-iccp-id {
            description 'The DNI-PW peer ICCP ID.' ;
            type uint32 {
              range 0..4294967295 {
                description 'The ICCP identification range.' ;
              }

            }

          }

          leaf peer-pw-state {
            description 'The DNI-PW peer PW state.' ;
            type enumeration {
              enum unknown {
                value 0 ;
                description 'The DNI-PW peer PW state is unknown.' ;
              }

              enum down {
                value 1 ;
                description 'The DNI-PW peer PW state is down.' ;
              }

              enum up {
                value 2 ;
                description 'The DNI-PW peer PW state is up.' ;
              }

            }

          }

        }

      }

      container inst-count {
        description 'L2VPN instances count.' ;
        leaf configured-vpls {
          description 'The number of VPLS instances which has been configured.' ;
          type uint32 ;

          default 0 ;
        }

        leaf configured-vpws {
          description 'The number of VPWS instances which has been configured.' ;
          type uint32 ;

          default 0 ;
        }

        leaf configured-vlss {
          description 'The number of VLSS instances which has been configured.' ;
          type uint32 ;

          default 0 ;
        }

        leaf configured-mspw {
          description 'The number of MSPW instances which has been configured.' ;
          type uint32 ;

          default 0 ;
        }

        leaf maximum-vpls {
          description 'The maximum number of VPLS instances which can be configured.' ;
          type uint32 ;

        }

        leaf maximum-vpws {
          description 'The maximum number of VPWS instances which can be configured.' ;
          type uint32 ;

        }

        leaf maximum-vlss {
          description 'The maximum number of VLSS instances which can be configured.' ;
          type uint32 ;

        }

        leaf maximum-mspw {
          description 'The maximum number of MSPW instances which can be configured.' ;
          type uint32 ;

        }

        leaf remaining-vpls {
          description 'The number of remaining VPLS which has not been configured.' ;
          type uint32 ;

          default 0 ;
        }

        leaf remaining-vpws {
          description 'The number of remaining VPWS which has not been configured.' ;
          type uint32 ;

          default 0 ;
        }

      }

      container kompella-pw {
        description 'Kompella PW forwarding table query info.' ;
        list kompella-pw-info {
          description 'Kompella PW forwarding table query info.' ;
          key 'rd remote-veid' ;
          leaf rd {
            description 'The route distinguisher parameter.' ;
            type union {
              type ncd:asn-nn ;

              type ncd:ipadd-nn ;

            }

          }

          leaf remote-veid {
            description 'The remote VE identification for the VPLS instance.' ;
            type uint16 {
              range 0..65535 {
                description 'The VE ID value.' ;
              }

            }

          }

          leaf vpn-name {
            description 'The name of the L2VPN instance.' ;
            type string {
              length 1..32 {
                description 'The length of instance name.' ;
              }

            }

          }

          leaf pw-name {
            description 'The name of the auto PW.' ;
            type ncd:ifname {
              length 1..31 {
                description 'The length of auto PW name.' ;
              }

            }

            ncd:revise-date 2015-10-30 ;
          }

          leaf peer-address {
            description "The remote peer's IP address of the Kompella PW." ;
            type ncd:ipv4-address-none-zero ;

          }

          leaf mtu {
            description 'The MTU value of the Kompella PW.' ;
            type uint16 ;

            default 1500 ;
          }

          leaf protocol-type {
            description 'Protocol type of Kompella PW.' ;
            type enumeration {
              enum bgp {
                value 0 ;
                description 'The protocol type is BGP.' ;
              }

            }

          }

          leaf pw-type {
            description 'L2VPN PW type. Assigned values are specified in IANA Allocations for Pseudowire Edge to Edge Emulation (PWE3).' ;
            type enumeration {
              enum unknown {
                value 0 ;
                description 'The PW type is unknown.' ;
              }

              enum dlciOld {
                value 1 ;
                description 'The PW type is FR-DLCI old.' ;
              }

              enum atmSdu {
                value 2 ;
                description 'The PW type is ATM-AAL5-SDU.' ;
              }

              enum atmCell {
                value 3 ;
                description 'The PW type is ATM-CELL.' ;
              }

              enum vlan {
                value 4 ;
                description 'The PW type is VLAN.' ;
              }

              enum ethernet {
                value 5 ;
                description 'The PW type is ethernet.' ;
              }

              enum hdlc {
                value 6 ;
                description 'The PW type is HDLC.' ;
              }

              enum ppp {
                value 7 ;
                description 'The PW type is PPP.' ;
              }

              enum sdhCESoM {
                value 8 ;
                description 'The PW type is SONET/SDH Circuit Emulation Service over MPLS.' ;
              }

              enum atmVCCn {
                value 9 ;
                description 'The PW type is ATM n-to-one VCC.' ;
              }

              enum atmVPCn {
                value 10 ;
                description 'The PW type is ATM n-to-one VPC.' ;
              }

              enum ipL2 {
                value 11 ;
                description 'The PW type is IP-L2.' ;
              }

              enum atmVCC1 {
                value 12 ;
                description 'The PW type is ATM one-to-one VCC.' ;
              }

              enum atmVPC1 {
                value 13 ;
                description 'The PW type is ATM one-to-one VPC.' ;
              }

              enum atmPDU {
                value 14 ;
                description 'The PW type is ATM AAL5 PDU VCC.' ;
              }

              enum frPort {
                value 15 ;
                description 'The PW type is FR port.' ;
              }

              enum sdhCEoP {
                value 16 ;
                description 'The PW type is SONET/SDH Circuit Emulation over Packet.' ;
              }

              enum saTopE1 {
                value 17 ;
                description 'The PW type is Structure-agnostic E1 over Packet.' ;
              }

              enum saTopT1 {
                value 18 ;
                description 'The PW type is Structure-agnostic T1 (DS1) over Packet.' ;
              }

              enum saTopE3 {
                value 19 ;
                description 'The PW type is Structure-agnostic E3 over Packet.' ;
              }

              enum saTopT3 {
                value 20 ;
                description 'The PW type is Structure-agnostic T3 (DS3) over Packet.' ;
              }

              enum ceSoPSNB {
                value 21 ;
                description 'The PW type is CESoPSN basic.' ;
              }

              enum tdmAAL1 {
                value 22 ;
                description 'The PW type is TDMoIP AAL1.' ;
              }

              enum ceSoPSNC {
                value 23 ;
                description 'The PW type is CESoPSN TDM with CAS.' ;
              }

              enum tdmAAL2 {
                value 24 ;
                description 'The PW type is TDMoIP AAL2.' ;
              }

              enum dlciNew {
                value 25 ;
                description 'The PW type is FR-DLCI.' ;
              }

            }

          }

          leaf create-time {
            description 'The create time of the Kompella PW.' ;
            type ncd:string-with-blank ;

          }

          leaf last-status-change-time {
            description 'The last status change time of the Kompella PW.' ;
            type ncd:string-with-blank ;

          }

          leaf local-label {
            description 'The local label of the Kompella PW.' ;
            type uint32 ;

          }

          leaf remote-label {
            description 'The remote label of the Kompella PW.' ;
            type uint32 ;

          }

          leaf auto-pwname {
            description 'The interface name of the auto PW.' ;
            type ncd:ifname {
              length 1..31 {
                description 'The length of auto PW interface name.' ;
              }

            }

          }

          leaf negotiated-cword {
            description 'The negotiated control word of the Kompella PW (0:notPreferred;1:preferred).' ;
            type enumeration {
              enum notPreferred {
                value 0 ;
                description 'The negotiated cword of the PW is not preferred.' ;
              }

              enum preferred {
                value 1 ;
                description 'The negotiated cword of the PW is preferred.' ;
              }

            }

          }

          leaf relation-pwname {
            description 'The relation PW name when have Kompella PW FRR.' ;
            type ncd:ifname {
              length 0..31 {
                description 'The length of relation PW name.It may be null.' ;
              }

            }

          }

          leaf frr-type {
            description 'The type of Kompella PW FRR.' ;
            type enumeration {
              enum null {
                value 0 ;
                description 'The FRR type is null.' ;
              }

              enum frr_primary {
                value 1 ;
                description 'The FRR type is primary.' ;
              }

              enum frr_secondary {
                value 2 ;
                description 'The FRR type is secondary.' ;
              }

            }

          }

          leaf pw-state {
            description 'The state of the Kompella PW.' ;
            type enumeration {
              enum down {
                value 1 ;
                description 'The state of the Kompella PW is down.' ;
              }

              enum up {
                value 2 ;
                description 'The state of the Kompella PW is up.' ;
              }

            }

          }

          leaf pw-sequence {
            description 'The sequence status of Kompella PW.' ;
            type enumeration {
              enum disable {
                value 0 ;
                description 'The PW sequence is disable.' ;
              }

              enum enable {
                value 1 ;
                description 'The PW sequence is enable.' ;
              }

            }

            default disable ;
          }

          leaf active-status {
            description 'The Kompella PW active state.' ;
            type enumeration {
              enum enable {
                value 0 ;
                description 'The Kompella PW active state is enable.' ;
              }

              enum disable {
                value 1 ;
                description 'The Kompella PW active state is disable.' ;
              }

            }

            default enable ;
          }

          leaf bandwidth {
            description 'The bandwidth value of Kompella PW.' ;
            type uint32 {
              range 0..4294967295 {
                description 'The range of the bandwidth value.' ;
              }

            }

            units kbps ;
          }

          container outter-fwd-info {
            description 'The outer forwarding info of Kompella PW.' ;
            list outter-fwd {
              description 'The outer forwarding info of Kompella PW.' ;
              key number ;
              leaf number {
                description 'The PSN outer forwarding number of the Kompella PW.' ;
                type uint32 {
                  range 1..64 {
                    description 'The range of outer forwarding number.' ;
                  }

                }

              }

              leaf outlabel1 {
                description 'The PSN outer label 1 of the Kompella PW.' ;
                type uint32 ;

              }

              leaf outlabel2 {
                description 'The PSN outer label 2 of the Kompella PW.' ;
                type uint32 ;

              }

              leaf outlabel3 {
                description 'The PSN outer label 3 of the Kompella PW.' ;
                type uint32 ;

              }

              leaf outlabel4 {
                description 'The PSN outer label 4 of the Kompella PW.' ;
                type uint32 ;

              }

              leaf outlabel5 {
                type uint32 ;

                description 'The PSN outer label 5 of the Kompella PW.' ;
                ncd:revise-date 2025-04-14 ;
              }

              leaf outlabel6 {
                type uint32 ;

                description 'The PSN outer label 6 of the Kompella PW.' ;
                ncd:revise-date 2025-04-14 ;
              }

              leaf outlabel7 {
                type uint32 ;

                description 'The PSN outer label 7 of the Kompella PW.' ;
                ncd:revise-date 2025-04-14 ;
              }

              leaf outlabel8 {
                type uint32 ;

                description 'The PSN outer label 8 of the Kompella PW.' ;
                ncd:revise-date 2025-04-14 ;
              }

              leaf outlabel9 {
                type uint32 ;

                description 'The PSN outer label 9 of the Kompella PW.' ;
                ncd:revise-date 2025-04-14 ;
              }

              leaf outlabel10 {
                type uint32 ;

                description 'The PSN outer label 10 of the Kompella PW.' ;
                ncd:revise-date 2025-04-14 ;
              }

              leaf outlabel11 {
                type uint32 ;

                description 'The PSN outer label 11 of the Kompella PW.' ;
                ncd:revise-date 2025-04-14 ;
              }

              leaf outlabel12 {
                type uint32 ;

                description 'The PSN outer label 12 of the Kompella PW.' ;
                ncd:revise-date 2025-04-14 ;
              }

              leaf outlabel13 {
                type uint32 ;

                description 'The PSN outer label 13 of the Kompella PW.' ;
                ncd:revise-date 2025-04-14 ;
              }

              leaf outlabel14 {
                type uint32 ;

                description 'The PSN outer label 14 of the Kompella PW.' ;
                ncd:revise-date 2025-04-14 ;
              }

              leaf outlabel15 {
                type uint32 ;

                description 'The PSN outer label 15 of the Kompella PW.' ;
                ncd:revise-date 2025-04-14 ;
              }

              leaf outlabel16 {
                type uint32 ;

                description 'The PSN outer label 16 of the Kompella PW.' ;
                ncd:revise-date 2025-04-14 ;
              }

              leaf outlabel17 {
                type uint32 ;

                description 'The PSN outer label 17 of the Kompella PW.' ;
                ncd:revise-date 2025-04-14 ;
              }

              leaf outlabel18 {
                type uint32 ;

                description 'The PSN outer label 18 of the Kompella PW.' ;
                ncd:revise-date 2025-04-14 ;
              }

              leaf outlabel19 {
                type uint32 ;

                description 'The PSN outer label 19 of the Kompella PW.' ;
                ncd:revise-date 2025-04-14 ;
              }

              leaf outlabel20 {
                type uint32 ;

                description 'The PSN outer label 20 of the Kompella PW.' ;
                ncd:revise-date 2025-04-14 ;
              }

              leaf outlabel21 {
                type uint32 ;

                description 'The PSN outer label 21 of the Kompella PW.' ;
                ncd:revise-date 2025-04-14 ;
              }

              leaf outlabel22 {
                type uint32 ;

                description 'The PSN outer label 22 of the Kompella PW.' ;
                ncd:revise-date 2025-04-14 ;
              }

              leaf outlabel23 {
                type uint32 ;

                description 'The PSN outer label 23 of the Kompella PW.' ;
                ncd:revise-date 2025-04-14 ;
              }

              leaf outlabel24 {
                type uint32 ;

                description 'The PSN outer label 24 of the Kompella PW.' ;
                ncd:revise-date 2025-04-14 ;
              }

              leaf out-interface {
                description 'The name of the PSN outer interface.' ;
                type string {
                  length 0..31 {
                    description 'The length of interface name.' ;
                  }

                }

              }

              leaf tunnel-id {
                description 'PSN tunnel ID.' ;
                type uint32 ;

              }

            }

            ncd:revise-date 2015-08-04 ;
          }

          container tunnel-policy-result {
            description 'The result of the tunnel policy.' ;
            leaf result-type {
              description 'The result type of the tunnel policy.' ;
              type enumeration {
                enum te-tunnel {
                  value 1 ;
                  description 'The select result is TE tunnel.' ;
                }

                enum te-ecmp {
                  value 2 ;
                  description 'The select result is TE ECMP.' ;
                }

                enum te-ldsh {
                  value 3 ;
                  description 'The select result is TE LDSH.' ;
                }

                enum te-ldshv6 {
                  value 4 ;
                  description 'The select result is TE LDSHv6.' ;
                }

                enum ldp-lsp {
                  value 5 ;
                  description 'The select result is LDP LSP.' ;
                }

                enum sr-be {
                  value 6 ;
                  description 'The select result is SR BE.' ;
                }

                enum gre-tunnel {
                  value 7 ;
                  description 'The select result is GRE tunnel.' ;
                }

                enum unsupported-type {
                  value 8 ;
                  description 'The select result is not supported.' ;
                }

                enum srv6-te-tunnel {
                  value 9 ;
                  description 'The select result is SRv6 TE tunnel.' ;
                }

                enum sr-policy-group {
                  value 10 ;
                  description 'The select result is SR policy group.' ;
                }

                enum bgp {
                  value 11 ;
                  description 'The select result is BGP.' ;
                }

                enum be {
                  value 12 ;
                  description 'The select result is BE.' ;
                }

              }

            }

            leaf result-id {
              description 'The forward table ID of the tunnel policy selection result.' ;
              type uint32 ;

            }

            ncd:revise-date 2020-10-21 ;
          }

          ncd:select vpn-name ;
          ncd:select remote-veid ;
          ncd:select "remote-veid vpn-name" ;
        }

      }

      container pw-count {
        description 'The PW count query table.' ;
        leaf configured-pw {
          description 'The number of PW which has been configured.' ;
          type uint32 ;

          default 0 ;
        }

        leaf maximum-pw {
          description 'The maximum number of PW which can be configured.' ;
          type uint32 ;

          default 0 ;
        }

        leaf traffic-enable-pw {
          description 'The number of PW which enabled traffic statistics.' ;
          type uint32 ;

          default 0 ;
        }

        leaf remaining-pw {
          description 'The number of remaining PW which has not been configured.' ;
          type uint32 ;

          default 0 ;
        }

      }

      container access-pw-group {
        description 'Access PW group query table.' ;
        list access-pw-group-info {
          description 'Access PW protect group query info.' ;
          key redirect-pw-name ;
          leaf redirect-pw-name {
            description 'The PW name which access PW group redirect to.' ;
            type ncd:ifname {
              length 1..31 {
                description 'The length of redirect PW name.' ;
              }

            }

          }

          leaf pw-group-id {
            description 'The access protect group identification.' ;
            type uint32 {
              range 1..8192 {
                description 'The range of access protect group identification.' ;
              }

            }

          }

          leaf local-ac-name {
            description 'The local access interface name.' ;
            type ncd:ifname {
              length 1..31 {
                description 'The length of local AC name.' ;
              }

            }

          }

          leaf access-pw-name {
            description 'The access PW name of access PW protect group.' ;
            type ncd:ifname {
              length 1..31 {
                description 'The length of access PW name.' ;
              }

            }

          }

          leaf switch-flag {
            description 'The switch flag of access protect group.' ;
            type enumeration {
              enum yes {
                value 1 ;
                description 'The switch flag of the access protect group is yes.' ;
              }

              enum no {
                value 2 ;
                description 'The switch flag of the access protect group is no.' ;
              }

            }

          }

        }

      }

      container ac-protect-group {
        list ac-protect-group-info {
          leaf local-ac-name {
            type ncd:ifname {
              length 1..31 {
                description 'The length of redirect PW name.' ;
              }

            }

            description 'The local AC interface name.' ;
          }

          leaf pw-group-id {
            type uint32 {
              range 1..8192 {
                description 'The range of access protect group identification.' ;
              }

            }

            description 'The AC protect group identification.' ;
          }

          leaf access-pw-name {
            type ncd:ifname {
              length 1..31 {
                description 'The length of access PW name.' ;
              }

            }

            description 'The access PW name of AC protect group.' ;
          }

          leaf switch-flag {
            type enumeration {
              enum yes {
                value 1 ;
                description 'The switch flag of the AC protect group is yes.' ;
              }

              enum no {
                value 2 ;
                description 'The switch flag of the AC protect group is no.' ;
              }

            }

            description 'The switch flag of AC protect group.' ;
          }

          key local-ac-name ;
          description 'AC protect group query info.' ;
        }

        description 'AC protect group query table.' ;
        ncd:revise-date 2024-01-02 ;
      }

    }

  }

  container configuration {
    description 'L2VPN module configuration info.' ;
    container l2vpn {
      description 'L2VPN module configure root node.It contains service instances,PW specification,protect-rules.' ;
      container l2vpn-global {
        description 'L2VPN enable flag.' ;
        presence l2vpn-global ;
        leaf global-enable {
          description 'The enable status of L2VPN service.' ;
          type enumeration {
            enum enable {
              value 1 ;
              description 'The enable status of L2VPN service is enable.' ;
            }

          }

          mandatory true ;
        }

        leaf traffic-enable {
          description 'The enable status of PW statistics.' ;
          type enumeration {
            enum disable {
              value 0 ;
              description 'The enable status of L2VPN service statistics is disable.' ;
            }

            enum enable {
              value 1 ;
              description 'The enable status of L2VPN service statistics is enable.' ;
            }

          }

          default disable ;
        }

        leaf pw-rate-statistics-period {
          description 'PW rate period set.' ;
          type uint32 {
            range 10..600 {
              description 'The range of PW rate statistics period.' ;
            }

          }

          units second ;
          default 120 ;
          ncd:revise-date 2019-06-13 ;
        }

        leaf srv6-evpn-next-header {
          description 'Specify SRv6 next header type.' ;
          type enumeration {
            enum ethernet-143 {
              value 0 ;
              description 'The SRv6 next header type field is 143(Ethernet).' ;
            }

            enum compatible-59 {
              value 1 ;
              description 'The SRv6 next header type field is 59(IPv6-NoNxt).' ;
            }

          }

          default ethernet-143 ;
          ncd:revise-date 2022-03-28 ;
        }

        leaf vpls-irb-track-state {
          status current ;

          type enumeration {
            enum track-vpls-state {
              value 1 ;
              description 'VPLS IRB interface track the VPLS instance state.' ;
            }

          }

          if-feature vpls-irb-track-vpls-state ;

          description 'VPLS IRB interface track the VPLS instance state.' ;
          ncd:revise-date 2024-01-23 ;
        }

        leaf vpls-irb-track-vpls-state {
          description 'VPLS IRB interface track the VPLS instance state.' ;
          status obsolete {
            ncd:revise-date 2023-12-23 ;
          }

          type enumeration {
            enum track-vpls-state {
              value 1 ;
              description 'VPLS IRB interface track the VPLS instance state.' ;
            }

          }

          if-feature vpls-irb-track-vpls-state ;

          ncd:revise-date 2023-09-21 ;
        }

        container dni-detect {
          if-feature dni-detect ;

          description 'Config DNI-PW associate peer BFD.' ;
          presence dni-detect ;
          leaf peer {
            description 'Specify remote IPv4 address.' ;
            type ncd:ipv4-address-none-zero ;

            mandatory true ;
          }

          leaf source {
            description 'Specify local IPv4 address.' ;
            type ncd:ipv4-address-none-zero ;

            mandatory true ;
          }

          ncd:revise-date 2016-02-22 ;
        }

        container multi-chassis-protection {
          description 'Global multiple chassis protection time.' ;
          presence multi-chassis-protection ;
          leaf suspicious-time {
            description "The temporary suspicion on the AC's recovery." ;
            type uint16 {
              range 10..5000 {
                description 'Suspicious time(ms).' ;
              }

            }

            units ms ;
            mandatory true ;
          }

          leaf protection-scenario {
            description 'Configure protection scenario.' ;
            type enumeration {
              enum kompella-pw {
                value 1 ;
                description 'Configure Kompella PW.' ;
              }

            }

            mandatory true ;
          }

          ncd:revise-date 2022-03-12 ;
        }

        container global-session-selectors {
          status obsolete {
            ncd:revise-date 2023-09-09 ;
          }

          description 'The global session selector.' ;
          leaf global-session-selector {
            description 'The global session selector.' ;
            type enumeration {
              enum target-session-only {
                value 1 ;
                description 'The global session selector is target-session-only.' ;
              }

            }

          }

          ncd:revise-date 2020-03-25 ;
        }

        container specify-session-selectors {
          status obsolete {
            ncd:revise-date 2023-09-09 ;
          }

          description 'Specify the session selector.' ;
          list specify-session-selector {
            description 'Specify the session selector.' ;
            key peer ;
            leaf peer {
              description 'Specify the session peer address.' ;
              type ncd:ipv4-address-none-zero ;

            }

            leaf local-router-id {
              description 'Specify the session local router ID.' ;
              type ncd:ipv4-address-none-zero ;

              mandatory true ;
            }

          }

          ncd:revise-date 2020-03-25 ;
        }

        container evpn-evi-specific-sub-interfaces {
          description 'Specify the IRB interface attach the EVPN VPWS as subinterface.' ;
          list evpn-evi-specific-sub-interface {
            description 'Specify the IRB interface attach the EVPN VPWS as subinterface.' ;
            key bridge-interface-name ;
            leaf bridge-interface-name {
              description 'The name of the bridge interface name.' ;
              type ncd:ifname ;

            }

          }

          ncd:revise-date 2021-07-14 ;
        }

        container evpn-irb {
          description 'EVPN IRB parameters.' ;
          presence evpn-irb ;
          leaf signal-default-gateway {
            description 'Signal default gateway extended community.' ;
            type empty ;

            mandatory true ;
          }

          leaf strict {
            description 'No sticky flag carried along with default gateway.' ;
            type empty ;

          }

          ncd:revise-date 2022-04-20 ;
        }

        container l2vpn-rd-template {
          description 'L2VPN RD template.' ;
          leaf evpn-rd {
            description 'RD of EVPN type.' ;
            type union {
              type ncd:asn-nn ;

              type ncd:ipadd-nn ;

              type ncd:asnd-nn ;

            }

          }

          ncd:revise-date 2022-04-20 ;
        }

        container l2vpn-evpn-prefix-sid {
          description 'Config L2VPN EVPN prefix-sid delete-delay.' ;
          presence l2vpn-evpn-prefix-sid ;
          leaf delete-delay {
            type empty ;

            description 'Delay to delete.' ;
            mandatory true ;
          }

          leaf delay-time {
            type uint8 {
              range 1..30 ;

            }

            description 'Delay time(min).' ;
            units min ;
          }

          ncd:revise-date 2024-10-11 ;
        }

        leaf l2vpn-usid-fib {
          type enumeration {
            enum short-sid-only {
              description 'Install short SID only.' ;
              value 0 ;
            }

            enum long-sid-only {
              description 'Install long SID only.' ;
              value 1 ;
            }

            enum long-and-short-sid {
              description 'Install both long and short SID.' ;
              value 2 ;
            }

          }

          description 'Configure the L2VPN SRv6 uSID FIB installation mode.' ;
          default short-sid-only ;
          ncd:revise-date 2024-04-01 ;
        }

      }

      container protect-rules {
        description 'The PW protect rules configuration info.' ;
        list protect-group {
          description 'The protect group configuration info.It contains common protect-group,single-dni-pwgroup,dual-dni-pwgroup.' ;
          key interface-name ;
          leaf interface-name {
            description 'The PW name of protect group.' ;
            type ncd:ifname {
              length 1..31 {
                description 'The length of PW or redirect PW name.' ;
              }

            }

          }

          leaf mc-pw-role {
            description 'The MC-PW role which is configured with the PW protectable.' ;
            type enumeration {
              enum null {
                value 0 ;
                description 'The MC-PW role is null.' ;
              }

              enum mc-master {
                value 1 ;
                description 'The MC-PW role is MC-master.' ;
              }

              enum mc-slave {
                value 2 ;
                description 'The MC-PW role is MC-slave.' ;
              }

            }

            mandatory true ;
          }

          leaf pfs-bits {
            description 'The negotiation mode of the PW protectable.' ;
            type enumeration {
              enum null {
                value 0 ;
                description 'The negotiation mode is null.' ;
              }

              enum independent {
                value 1 ;
                description 'The negotiation mode is independent.' ;
              }

              enum master {
                value 2 ;
                description 'The negotiation mode is master.' ;
              }

              enum slave {
                value 3 ;
                description 'The negotiation mode is slave.' ;
              }

            }

            default null ;
          }

          leaf regard-of-ac {
            description 'The advertise type of the PW protectable.' ;
            type enumeration {
              enum regard-of-ac {
                value 0 ;
                description 'The advertise type is regard of AC.' ;
              }

              enum regardless-of-ac {
                value 1 ;
                description 'The advertise type is regardless of AC.' ;
              }

            }

            default regard-of-ac ;
          }

          leaf ignore-remote-pfs-bits {
            description 'Ignore or not remote pfs-bits status,(1:ignore,0:not-ignore).' ;
            type enumeration {
              enum not-ignore-remote-pfs-bits {
                value 0 ;
                description 'Not ignore remote pfs-bits.' ;
              }

              enum ignore-remote-pfs-bits {
                value 1 ;
                description 'Ignore remote pfs-bits.' ;
              }

            }

            default not-ignore-remote-pfs-bits ;
            ncd:revise-date 2021-05-20 ;
          }

          container protect-strategy {
            description 'The PW protect strategy configuration info.' ;
            presence protect-strategy ;
            choice group-type {
              description 'The PW protect group type.It contains common protect-group,single-dni-pwgroup,dual-dni-pwgroup.' ;
              case common-group {
                description 'Common PW protect group.' ;
                container common-group-params {
                  description 'The common PW protect group parameters.' ;
                  presence common-group-params ;
                  leaf protect-type {
                    description 'The protect type of the PW protect strategy.' ;
                    type enumeration {
                      enum one-by-one {
                        value 1 ;
                        description 'The protect type of the PW protect strategy is one by one.' ;
                      }

                      enum one-plus-one {
                        value 2 ;
                        description 'The protect type of the PW protect strategy is one plus one.' ;
                      }

                    }

                    mandatory true ;
                  }

                  leaf direction {
                    description 'The protected direction of the PW protect strategy.' ;
                    type enumeration {
                      enum unidirectional {
                        value 1 ;
                        description 'The protected direction of the PW protect strategy is unidirectional.' ;
                      }

                      enum bidirectional {
                        value 2 ;
                        description 'The protected direction of the PW protect strategy is bidirectional.' ;
                      }

                    }

                    default unidirectional ;
                  }

                  leaf receiver-parameters {
                    description 'The protected receiver of the PW protect strategy.' ;
                    type enumeration {
                      enum selective {
                        value 1 ;
                        description 'The protected receiver of the PW protect strategy is selective.' ;
                      }

                      enum both {
                        value 2 ;
                        description 'The protected receiver of the PW protect strategy is both.' ;
                      }

                    }

                    default selective ;
                  }

                  leaf aps-mode {
                    description 'The APS mode of the PW protect strategy.' ;
                    type enumeration {
                      enum null {
                        value 0 ;
                        description 'The APS mode of the PW protect strategy is null.' ;
                      }

                      enum aps {
                        value 1 ;
                        description 'The APS mode of the PW protect strategy is APS.' ;
                      }

                    }

                    mandatory true ;
                  }

                  container backup-pw-params {
                    description 'The protect PW configuration parameters info.' ;
                    list protect-pw {
                      description 'The protect PW configuration info.' ;
                      key protect-pwname ;
                      leaf protect-pwname {
                        description 'The protect PW name.' ;
                        type ncd:ifname {
                          length 1..31 {
                            description 'The length of protect PW name.' ;
                          }

                        }

                      }

                      leaf protect-distance {
                        description 'The distance between back-up PW and protected PW.' ;
                        type uint16 {
                          range 1..255 {
                            description 'The value of distance between back-up PW and protected PW.' ;
                          }

                        }

                      }

                    }

                  }

                }

              }

              case single-dni-pwgroup {
                description 'Single DNI-PW protect group.' ;
                container single-dni-pwgroup-params {
                  description 'The single DNI-PW protect group parameters.' ;
                  presence single-dni-pwgroup-params ;
                  leaf mc-protect-type {
                    description 'The MC protect type of the PW protect strategy.' ;
                    type enumeration {
                      enum mc-protection {
                        value 2 ;
                      }

                    }

                    mandatory true ;
                  }

                  leaf helper {
                    description 'The protect strategy of the single DNI-PW.' ;
                    type enumeration {
                      enum one-by-one {
                        value 1 ;
                        description 'The protect strategy of the single DNI-PW is one-by-one.' ;
                      }

                      enum one-puls-one {
                        value 2 ;
                        description 'The protect strategy of the single DNI-PW is one-plus-one.' ;
                      }

                    }

                  }

                  leaf direction {
                    description 'The protected direction of the PW protect strategy.' ;
                    type enumeration {
                      enum unidirectional {
                        value 1 ;
                        description 'The protected direction of the PW protect strategy is unidirectional.' ;
                      }

                      enum bidirectional {
                        value 2 ;
                        description 'The protected direction of the PW protect strategy is bidirectional.' ;
                      }

                    }

                  }

                  leaf receiver-parameters {
                    description 'The protected receiver of the PW protect strategy.' ;
                    type enumeration {
                      enum selective {
                        value 1 ;
                        description 'The protected receiver of the PW protect strategy is selective.' ;
                      }

                      enum both {
                        value 2 ;
                        description 'The protected receiver of the PW protect strategy is both.' ;
                      }

                    }

                  }

                  container inter-chassis-params {
                    description 'Inter chassis protect PW configure parameters.' ;
                    list inter-chassis-protect-pw {
                      description 'Inter chassis protect PW configure info.' ;
                      key inter-chassis-protect-pwname ;
                      leaf inter-chassis-protect-pwname {
                        description 'Inter chassis protect PW name.' ;
                        type ncd:ifname {
                          length 1..31 {
                            description 'The length of inter-chassis protect PW name.' ;
                          }

                        }

                      }

                    }

                  }

                }

              }

              case dual-dni-pwgroup {
                description 'Dual DNI-PW protect group.' ;
                container dual-dni-pwgroup-params {
                  description 'The dual DNI-PW protect group parameters.' ;
                  presence dual-dni-pwgroup-params ;
                  leaf dual-dni-protect-type {
                    description 'The protect type of dual DNI-PW.' ;
                    type enumeration {
                      enum mc-and-access-pw {
                        value 3 ;
                        description 'The value of the MC protect type is mc-and-access-pw.' ;
                      }

                    }

                    mandatory true ;
                  }

                  container backup-mc-pw-params {
                    description 'The backup MC-PW parameters of dual DNI-PW.' ;
                    presence backup-mc-pw-params ;
                    list backup-mc-pw {
                      description 'Backup MC-PW configure info.' ;
                      key backup-mc-pwname ;
                      leaf backup-mc-pwname {
                        description 'Backup MC-PW name.' ;
                        type ncd:ifname {
                          length 1..31 {
                            description 'The length of backup MC-PW name.' ;
                          }

                        }

                      }

                    }

                  }

                  container access-pw-params {
                    description 'The access protect PW parameters of dual DNI-PW.' ;
                    presence access-pw-params ;
                    list access-protect-pw {
                      description 'Access protect PW configure info.' ;
                      key access-protect-pwname ;
                      leaf access-protect-pwname {
                        description 'Access protect PW name.' ;
                        type ncd:ifname {
                          length 1..31 {
                            description 'The length of access PW name.' ;
                          }

                        }

                      }

                      container ce-side-params {
                        description 'The CE side parameters of access protect PW.' ;
                        presence ce-side-params ;
                        leaf ce-side {
                          description 'The CE side configuration of access protect PW.' ;
                          type enumeration {
                            enum "1+1" {
                              value 1 ;
                              description 'The CE decides to 1+1 between two nodes.' ;
                            }

                            enum 1:1 {
                              value 2 ;
                              description 'The CE decides to 1:1 between two nodes.' ;
                            }

                            enum load-balance {
                              value 3 ;
                              description 'The CE decides to load-balance between two nodes.' ;
                            }

                          }

                          mandatory true ;
                        }

                      }

                    }

                  }

                }

              }

              case enhanced-dni-pwgroup {
                if-feature enhanced-dni-pwgroup ;

                description 'Enhanced DNI-PW protect group.' ;
                container enhanced-dni-pwgroup-params {
                  description 'The enhanced DNI-PW protect group parameters.' ;
                  presence enhanced-dni-pwgroup-params ;
                  leaf enhanced-dni-protect-type {
                    description 'The protect type of enhanced DNI-PW.' ;
                    type enumeration {
                      enum enhanced-mc-and-access-pw {
                        value 5 ;
                        description 'The value of the enhanced MC-PW protect type is enhanced-mc-and-access-pw.' ;
                      }

                    }

                    mandatory true ;
                  }

                  container backup-mc-pw-shortcut-params {
                    description 'The shortcut backup MC-PW parameters of enhanced DNI-PW.' ;
                    presence backup-mc-pw-shortcut-params ;
                    list backup-mc-pw-shortcut {
                      description 'The shortcut backup MC-PW configure info.' ;
                      key backup-mc-shortcut-pwname ;
                      leaf backup-mc-shortcut-pwname {
                        description 'The shortcut backup MC-PW name.' ;
                        type ncd:ifname ;

                      }

                    }

                  }

                  container access-pw-params {
                    description 'The access protect PW parameters of enhanced DNI-PW.' ;
                    presence access-pw-params ;
                    list access-protect-pw {
                      description 'Access protect PW configure info.' ;
                      key access-protect-pwname ;
                      leaf access-protect-pwname {
                        description 'Access protect PW name.' ;
                        type ncd:ifname ;

                      }

                      container ce-side-params {
                        description 'The CE side parameters of access protect PW.' ;
                        presence ce-side-params ;
                        leaf ce-side {
                          description 'The CE side configuration of access protect PW.' ;
                          type enumeration {
                            enum "1+1" {
                              value 1 ;
                              description 'The CE decides to 1+1 between two nodes.' ;
                            }

                            enum 1:1 {
                              value 2 ;
                              description 'The CE decides to 1:1 between two nodes.' ;
                            }

                            enum load-balance {
                              value 3 ;
                              description 'The CE decides to load-balance between two nodes.' ;
                            }

                          }

                          mandatory true ;
                        }

                      }

                    }

                  }

                }

                ncd:revise-date 2016-03-30 ;
              }

            }

          }

          container iccp-connection {
            description 'Inter-Chassis Communication Protocol(ICCP)configuration info.' ;
            presence iccp-connection ;
            leaf iccp-groupid {
              description 'Inter-Chassis Communication Protocol(ICCP) group ID.The maximum value is determined by the parameters of performance.' ;
              type uint32 {
                range 1..4294967295 {
                  description 'The value of ICCP group identification.' ;
                }

              }

              mandatory true ;
            }

            leaf iccp-group-roid {
              description 'Inter-Chassis Communication Protocol(ICCP) ROID.' ;
              type uint64 {
                range 1..18446744073709551615 {
                  description 'The value of ICCP group ROID.' ;
                }

              }

              mandatory true ;
            }

          }

          container mc-selection {
            description 'To select a single active PW from the two MC-PWs.' ;
            presence mc-selection ;
            leaf mc-selection-type {
              description 'The multiple chassis selection type of the PW protect strategy.' ;
              type enumeration {
                enum mc-selection {
                  value 0 ;
                  description 'The MC selection type is mc-selection.' ;
                }

                enum oam-mapping {
                  value 1 ;
                  description 'The MC selection type is oam-mapping.' ;
                }

              }

              mandatory true ;
            }

          }

        }

      }

      container pw-specification {
        description 'PW specification configuration info.' ;
        list pw-entry {
          description 'PW entry configuration info.' ;
          key pw-name ;
          leaf pw-name {
            description 'The name of the PW.' ;
            type ncd:ifname ;

          }

          leaf neighbour {
            description "The remote peer's IP address of the PW." ;
            type ncd:ipv4-address ;

            mandatory true ;
          }

          leaf vcid {
            description 'The VC identification of the PW.' ;
            type uint32 {
              range 1..4294967295 {
                description 'The VC identification value.' ;
              }

            }

            mandatory true ;
          }

          leaf pw-type {
            description 'The PW type of the PW.' ;
            type enumeration {
              enum unknown {
                value 0 ;
                description 'The PW type is unknown.' ;
              }

              enum dlciOld {
                value 1 ;
                description 'The PW type is FR-DLCI old.' ;
              }

              enum atmSdu {
                value 2 ;
                description 'The PW type is ATM-AAL5-SDU.' ;
              }

              enum atmCell {
                value 3 ;
                description 'The PW type is ATM-CELL.' ;
              }

              enum vlan {
                value 4 ;
                description 'The PW type is VLAN.' ;
              }

              enum ethernet {
                value 5 ;
                description 'The PW type is ethernet.' ;
              }

              enum hdlc {
                value 6 ;
                description 'The PW type is HDLC.' ;
              }

              enum ppp {
                value 7 ;
                description 'The PW type is PPP.' ;
              }

              enum sdhCESoM {
                value 8 ;
                description 'The PW type is SONET/SDH Circuit Emulation Service over MPLS.' ;
              }

              enum atmVCCn {
                value 9 ;
                description 'The PW type is ATM n-to-one VCC.' ;
              }

              enum atmVPCn {
                value 10 ;
                description 'The PW type is ATM n-to-one VPC.' ;
              }

              enum ipL2 {
                value 11 ;
                description 'The PW type is IP-L2.' ;
              }

              enum atmVCC1 {
                value 12 ;
                description 'The PW type is ATM one-to-one VCC.' ;
              }

              enum atmVPC1 {
                value 13 ;
                description 'The PW type is ATM one-to-one VPC.' ;
              }

              enum atmPDU {
                value 14 ;
                description 'The PW type is ATM AAL5 PDU VCC.' ;
              }

              enum frPort {
                value 15 ;
                description 'The PW type is FR port.' ;
              }

              enum sdhCEoP {
                value 16 ;
                description 'The PW type is SONET/SDH Circuit Emulation over Packet.' ;
              }

              enum saTopE1 {
                value 17 ;
                description 'The PW type is Structure-agnostic E1 over Packet.' ;
              }

              enum saTopT1 {
                value 18 ;
                description 'The PW type is Structure-agnostic T1 (DS1) over Packet.' ;
              }

              enum saTopE3 {
                value 19 ;
                description 'The PW type is Structure-agnostic E3 over Packet.' ;
              }

              enum saTopT3 {
                value 20 ;
                description 'The PW type is Structure-agnostic T3 (DS3) over Packet.' ;
              }

              enum ceSoPSNB {
                value 21 ;
                description 'The PW type is CESoPSN basic.' ;
              }

              enum tdmAAL1 {
                value 22 ;
                description 'The PW type is TDMoIP AAL1.' ;
              }

              enum ceSoPSNC {
                value 23 ;
                description 'The PW type is CESoPSN TDM with CAS.' ;
              }

              enum tdmAAL2 {
                value 24 ;
                description 'The PW type is TDMoIP AAL2.' ;
              }

              enum dlciNew {
                value 25 ;
                description 'The PW type is FR-DLCI.' ;
              }

            }

            mandatory true ;
          }

          leaf control-word {
            description 'The control-word capability of the PW.' ;
            type enumeration {
              enum not-preferred {
                value 0 ;
                description 'The control-word capability is not preferred.' ;
              }

              enum preferred {
                value 1 ;
                description 'The control-word capability is preferred.' ;
              }

            }

            default not-preferred ;
          }

          leaf signal-type {
            description 'The signal type of the PW.' ;
            type enumeration {
              enum static {
                value 0 ;
                description 'The signal type is static.' ;
              }

              enum dynamic {
                value 1 ;
                description 'The signal type is dynamic.' ;
              }

            }

            default dynamic ;
          }

          leaf local-label {
            description 'The local label of the PW.' ;
            type uint32 {
              range 16..1048575 {
                description 'The range of local label.' ;
              }

            }

          }

          leaf remote-label {
            description 'The remote label of the PW.' ;
            type uint32 {
              range 16..1048575 {
                description 'The range of remote label.' ;
              }

            }

          }

          leaf tunnel-policy-name {
            description 'The PSN tunnel policy name of the PW.' ;
            type string {
              length 1..63 {
                description 'The length of tunnel policy name.' ;
              }

            }

          }

          leaf track-name {
            description 'The name of track object that bind to the PW.' ;
            type string {
              length 1..31 {
                description 'The length of track name.' ;
              }

            }

          }

          leaf track-group-flag {
            description 'The track group flag.' ;
            type empty ;

            ncd:revise-date 2018-07-25 ;
          }

          choice track-group-notify {
            description 'Track group notify.' ;
            case fast-notify {
              description 'Track group notify fast.' ;
              leaf track-fast-notified {
                description 'Notify LDP to send messages fast.' ;
                type empty ;

              }

            }

            case notify {
              description 'Track group notify.' ;
              leaf track-notified {
                description 'Notify LDP to send messages.' ;
                type empty ;

              }

              ncd:revise-date 2022-08-13 ;
            }

            ncd:revise-date 2018-07-25 ;
          }

          leaf shutdown {
            description 'The enable status of the PW.' ;
            type enumeration {
              enum disable {
                value 0 ;
                description 'The enable status of the PW is disable.' ;
              }

              enum enable {
                value 1 ;
                description 'The enable status of the PW is enable.' ;
              }

            }

            default enable ;
          }

          leaf cword-sequencing {
            description 'The cword sequencing enable status of the PW.' ;
            type enumeration {
              enum disable {
                value 0 ;
                description 'The cword sequencing enable status is disable.' ;
              }

              enum enable {
                value 1 ;
                description 'The cword sequencing enable status is enable.' ;
              }

            }

            default disable ;
          }

          leaf cw-lbit {
            description 'The control-word L-bit capability of the PW.' ;
            type enumeration {
              enum disable {
                value 0 ;
                description 'The control-word L-bit is disable.' ;
              }

              enum enable {
                value 1 ;
                description 'The control-word L-bit is enable.' ;
              }

            }

            default enable ;
          }

          leaf sd-enable {
            description 'The enable status of the PW SD propagation.' ;
            type enumeration {
              enum disable {
                value 0 ;
                description 'The enable status of the PW SD propagation is disable.' ;
              }

              enum enable {
                value 1 ;
                description 'The enable status of the PW SD propagation is enable.' ;
              }

            }

            default disable ;
          }

          leaf raw-tag-reversed {
            description 'Raw or tagged reversed flag of the PW.' ;
            type enumeration {
              enum disable {
                value 0 ;
                description 'Raw or tagged reversed flag is disable.' ;
              }

              enum enable {
                value 1 ;
                description 'Raw or tagged reversed flag is enable' ;
              }

            }

            default disable ;
          }

          leaf cword-usage-forced {
            description 'Control-word usage forced flag of the PW.' ;
            type enumeration {
              enum force-unused {
                value 1 ;
                description 'Control-word usage forced flag is force unused.' ;
              }

              enum force-used {
                value 2 ;
                description 'Control-word usage forced flag is force used.' ;
              }

            }

          }

          leaf oam-mapping-ignoring-frr {
            description 'Oam mapping ignoring FRR or not.' ;
            type enumeration {
              enum disable {
                value 0 ;
                description 'Oam mapping not ignoring FRR.' ;
              }

              enum enable {
                value 1 ;
                description 'Oam mapping ignoring FRR.' ;
              }

            }

            default disable ;
          }

          leaf abort-mapping-to-ac {
            description 'Abort mapping to AC or not.' ;
            type enumeration {
              enum disable {
                value 0 ;
                description 'Mapping to AC normal.' ;
              }

              enum enable {
                value 1 ;
                description 'Abort mapping to AC.' ;
              }

            }

            default disable ;
          }

          leaf hard-pipe {
            description 'The hard pipe of the PW.' ;
            type enumeration {
              enum disable {
                value 0 ;
                description 'The hard pipe of the PW is disable.' ;
              }

              enum enable {
                value 1 ;
                description 'The hard pipe of the PW is enable.' ;
              }

            }

            default disable ;
            ncd:revise-date 2016-12-15 ;
          }

          leaf pfs-bits-tracked {
            description 'Preferential forwarding status bits is tracked.' ;
            type enumeration {
              enum not-tracked {
                value 0 ;
                description 'Preferential forwarding status bits is not tracked.' ;
              }

              enum tracked {
                value 1 ;
                description 'Preferential forwarding status bits is tracked.' ;
              }

            }

            default not-tracked ;
            ncd:revise-date 2019-02-15 ;
          }

          leaf pfs-bits-tracked-ignore-remote-status {
            type empty ;

            description 'Ignore remote PSN/AC status.' ;
            ncd:revise-date 2024-12-27 ;
          }

          leaf entropy-label {
            description 'Enable/Disable PW entropy label.' ;
            type enumeration {
              enum disable {
                value 0 ;
                description 'PW entropy label is disable.' ;
              }

              enum enable {
                value 1 ;
                description 'PW entropy label is enable.' ;
              }

            }

            default disable ;
            ncd:revise-date 2019-07-11 ;
          }

          leaf node-role {
            description 'The node-role of ring-tree instance.' ;
            type enumeration {
              enum common-leaf {
                value 0 ;
                description 'The node-role of ring-tree is common-leaf.' ;
              }

              enum work-root {
                value 1 ;
                description 'The node-role of ring-tree is work-root.' ;
              }

              enum protect-root {
                value 2 ;
                description 'The node-role of ring-tree is protect-root.' ;
              }

              enum work-leaf {
                value 3 ;
                description 'The node-role of ring-tree is work-leaf.' ;
              }

              enum protect-leaf {
                value 4 ;
                description 'The node-role of ring-tree is protect-leaf.' ;
              }

            }

            default common-leaf ;
            ncd:revise-date 2018-09-07 ;
          }

          leaf set-traffic-class {
            description 'Set traffic-class of PW.' ;
            type uint32 {
              range 0..7 {
                description 'The range of traffic-class.' ;
              }

            }

            ncd:revise-date 2019-08-10 ;
          }

          leaf cac-flag {
            description 'The CAC flag of PW.' ;
            type enumeration {
              enum disable {
                value 0 ;
                description 'The CAC flag is OFF.' ;
              }

              enum enable {
                value 1 ;
                description 'The CAC flag is ON.' ;
              }

            }

            default enable ;
            ncd:revise-date 2019-10-29 ;
          }

          leaf tunnel-destination-ipv6 {
            status obsolete {
              ncd:revise-date 2016-09-23 ;
            }

            description 'IPv6 address as tunnel destination.' ;
            type ncd:ipv6-address {
              pattern "([0-9a-fA-F]{1,4}:){7}([0-9a-fA-F]{0,4})$|^([0-9a-fA-F]{1,4}:){1,6}(:[0-9a-fA-F]{0,4}){1,6}$|^([:]{2})(([0-9a-fA-F]{1,4}:){0,6})([0-9a-fA-F]{1,4})$|^([0-9a-fA-F]{1,4}:){6}([0-9]{1,3}.){3}([0-9]{1,3})$|^([0-9a-fA-F]{1,4}:){1,5}(:[0-9a-fA-F]{0,4}){1,5}([0-9]{1,3}.){3}([0-9]{1,3})$|^([:]{2})(([0-9a-fA-F]{1,4}:){0,5})([0-9]{1,3}.){3}([0-9]{1,3})" ;

            }

          }

          leaf color {
            description 'The color of PW.' ;
            type uint32 {
              range 1..4294967295 {
                description 'The range of PW color.' ;
              }

            }

            ncd:revise-date 2020-02-13 ;
          }

          leaf tunnel-srv6-sid {
            description 'The SRv6 SID of the outer tunnel.' ;
            type ncd:ipv6-address-none-zero ;

            ncd:revise-date 2021-01-20 ;
          }

          leaf vccv-flow-label {
            description 'The flow-label for VCCV packets without standard flow-labels.' ;
            type empty ;

            ncd:revise-date 2022-03-07 ;
          }

          container tunnel-destination {
            description 'The address as tunnel destination.' ;
            choice destination-type {
              description 'The tunnel destination type.' ;
              case ipv6 {
                description 'The tunnel destination type is IPv6.' ;
                leaf tunnel-destination-ipv6 {
                  description 'IPv6 address as tunnel destination.' ;
                  type ncd:ipv6-address {
                    pattern "([0-9a-fA-F]{1,4}:){7}([0-9a-fA-F]{0,4})$|^([0-9a-fA-F]{1,4}:){1,6}(:[0-9a-fA-F]{0,4}){1,6}$|^([:]{2})(([0-9a-fA-F]{1,4}:){0,6})([0-9a-fA-F]{1,4})$|^([0-9a-fA-F]{1,4}:){6}([0-9]{1,3}.){3}([0-9]{1,3})$|^([0-9a-fA-F]{1,4}:){1,5}(:[0-9a-fA-F]{0,4}){1,5}([0-9]{1,3}.){3}([0-9]{1,3})$|^([:]{2})(([0-9a-fA-F]{1,4}:){0,5})([0-9]{1,3}.){3}([0-9]{1,3})" ;

                  }

                }

              }

              case ipv4 {
                description 'The tunnel destination type is IPv4.' ;
                leaf tunnel-destination-ipv4 {
                  description 'IPv4 address as tunnel destination.' ;
                  type ncd:ipv4-address-none-zero ;

                }

              }

            }

            ncd:revise-date 2016-09-23 ;
          }

          container required-vlan-parameters {
            if-feature required-vlan-pw ;

            description 'Required VLAN parameters configuration info of PW.' ;
            leaf outer-vlan-id {
              description 'Outer VLAN value of remote required.' ;
              type uint16 {
                range 1..4094 {
                  description 'The outer VLAN ID value.' ;
                }

              }

            }

            leaf inner-vlan-id {
              description 'Inner VLAN value of remote required.' ;
              type uint16 {
                range 1..4094 {
                  description 'The inner VLAN ID value.' ;
                }

              }

            }

            leaf keep-ingress-tag {
              description 'The keep ingress tag of the PW.' ;
              type enumeration {
                enum disable {
                  value 0 ;
                  description 'The keep ingress tag of the PW is disable.' ;
                }

                enum enable {
                  value 1 ;
                  description 'The keep ingress tag of the PW is enable.' ;
                }

              }

              default disable ;
            }

            leaf outer-tpid {
              description 'Outer ether-type of remote required.' ;
              type enumeration {
                enum 8100 {
                  value 0 ;
                  description 'Outer ether-type of remote required is 8100.' ;
                }

                enum 9100 {
                  value 1 ;
                  description 'Outer ether-type of remote required is 9100.' ;
                }

                enum 9200 {
                  value 2 ;
                  description 'Outer ether-type of remote required is 9200.' ;
                }

                enum 88a8 {
                  value 3 ;
                  description 'Outer ether-type of remote required is 88a8.' ;
                }

                enum 88e7 {
                  value 4 ;
                  description 'Outer ether-type of remote required is 88e7.' ;
                }

                enum 9300 {
                  value 5 ;
                  description 'Outer ether-type of remote required is 9300.' ;
                }

              }

            }

            leaf inner-tpid {
              description 'Inner ether-type of remote required.' ;
              type enumeration {
                enum 8100 {
                  value 0 ;
                  description 'Inner ether-type of remote required is 8100.' ;
                }

                enum 9100 {
                  value 1 ;
                  description 'Inner ether-type of remote required is 9100.' ;
                }

                enum 9200 {
                  value 2 ;
                  description 'Inner ether-type of remote required is 9200.' ;
                }

                enum 88a8 {
                  value 3 ;
                  description 'Inner ether-type of remote required is 88a8.' ;
                }

                enum 88e7 {
                  value 4 ;
