            presence master-pw-info ;
            leaf pw-name {
              description 'Master PW name of PW list.' ;
              type ncd:ifname {
                length 1..31 {
                  description 'The length of PW name.' ;
                }

              }

              mandatory true ;
            }

          }

          container slave-pw {
            description 'Slave PW configuration info of PW list.' ;
            list slave-pw-info {
              description 'Slave PW configuration info of PW list. The maximum number of slave PW is 128 in one PW list.' ;
              key pw-name ;
              leaf pw-name {
                description 'Slave PW name of PW list.' ;
                type ncd:ifname {
                  length 1..31 {
                    description 'The length of PW name.' ;
                  }

                }

              }

            }

          }

        }

      }

    }

  }

  container operation {
    config false ;
    description 'L2VPN module operation info.' ;
    container l2vpn {
      description 'L2VPN module operation root node.' ;
      container re-negotiate {
        if-feature operation-re-negotiate ;

        description 'L2VPN re-negotiate command.' ;
        presence re-negotiate ;
        list negotiate-pw {
          description 'PW re-negotiate.' ;
          key pw-name ;
          leaf pw-name {
            description 'The name of the PW.' ;
            type ncd:ifname ;

          }

          leaf negotiate {
            description 'Trigger control word re-negotiate.' ;
            type enumeration {
              enum disable {
                value 0 ;
                description 'The re-negotiate is disable.' ;
              }

              enum enable {
                value 1 ;
                description 'The re-negotiate is enable.' ;
              }

            }

            mandatory true ;
          }

          leaf control-word {
            description 'Re-negotiate control word.' ;
            type enumeration {
              enum disable {
                value 0 ;
                description 'Re-negotiate control word is disable.' ;
              }

              enum enable {
                value 1 ;
                description 'Re-negotiate control word is enable.' ;
              }

            }

          }

        }

      }

      container control-word {
        if-feature operation-control-word ;

        description 'L2VPN control word L-bit insert function.' ;
        presence control-word ;
        list control-lbit {
          description 'L2VPN control word L-bit insert function.' ;
          key pw-name ;
          leaf pw-name {
            description 'The name of the PW.' ;
            type ncd:ifname ;

          }

          leaf lbit-insert {
            description 'L-bit insert function. This command is only supported in TDM.' ;
            type enumeration {
              enum start {
                value 1 ;
                description 'The L-bit insert function start.' ;
              }

              enum stop {
                value 2 ;
                description 'The L-bit insert function stop.' ;
              }

            }

            mandatory true ;
          }

          leaf hold-time {
            description 'Manually L-bit insert hold time.' ;
            type uint32 {
              range 0..4294967295 {
                description 'The hold time range is 0 to 4294967295.' ;
              }

            }

            units s ;
            default 0 ;
          }

        }

      }

      container clear {
        description 'L2VPN traffic statistics clear.' ;
        container instance-statistics {
          description 'Clear the instance traffic statistics.' ;
          list instances {
            description 'Instances info of clear instance traffic statistics.' ;
            key instance-name ;
            leaf instance-name {
              description 'The instance name of clear the instance traffic statistics.' ;
              type string {
                length 1..32 {
                  description 'The length of instance name.' ;
                }

              }

            }

          }

        }

        container pw-statistics {
          description 'Clear the PW traffic statistics.' ;
          list pw-info {
            description 'PW info of clear PW traffic statistics.' ;
            key pw-name ;
            leaf pw-name {
              description 'The PW name of clear the PW traffic statistics.' ;
              type ncd:ifname ;

            }

          }

        }

        container ac-statistics {
          if-feature clear-ac-statistic ;

          description 'Clear the AC traffic statistics.' ;
          list ac-info {
            description 'AC info of clear AC traffic statistics.' ;
            key ac-name ;
            leaf ac-name {
              description 'The AC name of clear the AC traffic statistics.' ;
              type ncd:ifname ;

            }

          }

        }

        container l2vpn-statistics {
          description 'Clear the L2VPN traffic statistics.' ;
          leaf all {
            description 'Clear the L2VPN all traffic statistics.' ;
            type empty ;

          }

        }

      }

    }

  }

  rpc pwe3-signal-session {
    status obsolete {
      ncd:revise-date 2023-09-09 ;
    }

    description 'PWE3 signal session info.' ;
    input {
      container pwe3-sessions {
        description 'PWE3 sessions info.' ;
        list pwe3-session {
          description 'PWE3 session info.' ;
          key 'peer local-router-id' ;
          leaf peer {
            description 'Specify the session peer address.' ;
            type ncd:ipv4-address-none-zero ;

          }

          leaf local-router-id {
            description 'Specify the session local router ID.' ;
            type ncd:ipv4-address-none-zero ;

          }

        }

      }

    }

  }

}
