      container service-instances {
        description 'The L2VPN service instances configuration info.It contains VPLS,VPWS,MSPW,VLSS,remote-monitor instance and the instance name is unique.' ;
        container vpws-instances {
          description 'The VPWS instances configuration info.' ;
          list vpws-instance {
            description 'The VPWS instance configuration info.' ;
