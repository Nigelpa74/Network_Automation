module zxr10-l2vpn {
  namespace "http://www.zte.com.cn/zxr10/netconf/schema/rosng/l2vpn" ;
  prefix l2vpn ;
  yang-version 1 ;
  import zxr10-netconf-defs {
    prefix ncd ;
  }

  organization "ZTE Corporation" ;
  contact "ZTE Corporation
  Nanjing Institute of ZTE Corporation
  No.68 Zijinghua Rd. Yuhuatai District, Nanjing, China
  Tel: +86-25-52870000" ;
  description 'The netconf module to describe L2VPN services info.It contains state and configuration info.' ;
  revision 2025-08-14 {
    description '1.Add the mtu and mtu-mismatch-ignore leaf node which in configuration/l2vpn/service-instances/admin-vpls-instances/admin-vpls-instance.
2.Add the mtu and mtu-mismatch-ignore leaf node which in configuration/l2vpn/service-instances/remote-monitor-instance/remote-monitor-instance.' ;
  }

  revision 2025-07-16 {
    description '1.Add the enumeration of bgp and be which in state/l2vpn/pw-info/tunnel-policy-result/result-type.
2.Add the enumeration of bgp and be which in state/l2vpn/kompella-pw/kompella-pw-info/tunnel-policy-result/result-type.' ;
  }

  revision 2025-06-19 {
    description '1.Add the lst-holdoff leaf node which in configuration/l2vpn/service-instances/vpws-instances/vpws-instance/vpws-ac-bind/ac-instance-bind/ac-type/ethernet/ethernet-params.' ;
  }

  revision 2025-06-09 {
    description '1.Add label 5960x in feature l2cp-drop.
2.Add the feature of l2cp-drop-subset.' ;
  }

  revision 2025-06-03 {
    description '1.Add the mtu-mismatch-ignore leaf node which in configuration/l2vpn/service-instances/vlss-instances/vlss-instance.' ;
  }

  revision 2025-04-14 {
    description '1.Add outlabel5-outlabel24 leaf in state/l2vpn/pw-info.
2.Add outlabel5-outlabel24 leaf in state/l2vpn/kompella-pw/kompella-pw-info' ;
  }

  revision 2024-12-27 {
    description '1.Add the pfs-bits-tracked-ignore-remote-status leaf which in configuration/l2vpn/pw-specification/pw-entry.' ;
  }

  revision 2024-11-11 {
    description '1.After the auto-discovery martini is configured in VPLS instance or EVPN VPLS instance, the martini-discovery container is changed from cannot get to can get.
2.After the auto-discovery kompella is configured in VPLS instance or EVPN VPLS instance, the kompella-discovery container is changed from cannot get to can get.' ;
  }

  revision 2024-10-29 {
    description '1.The cir and pir nodes which in vpls-instance or evpn-vpls-instance cannot get when not config broadcast-traffic-rate.
2.The cir and pir nodes which in vpls-instance or evpn-vpls-instance cannot get when not config unknown-multicast-traffic-rate.
3.The cir and pir nodes which in vpls-instance or evpn-vpls-instance cannot get when not config unknown-unicast-traffic-rate.
4.The separate-in-signal nodes which in vpls-instance kompella kompella cannot get when not config encapsulation.
5.The separate-in-signal nodes which in evpn-vpls-instance kompella cannot get when not config encapsulation.' ;
  }

  revision 2024-10-11 {
    description '1.Add the l2vpn-evpn-prefix-sid container , delete-delay and delay-time leaf which in configuration/l2vpn/l2vpn-global' ;
  }

  revision 2024-08-13 {
    description '1.Delete the wtr-params choice and add the wtr , wtr-second-with-minute , wtr-second leaf which in configuration/l2vpn/service-instances/evpn-vpls-instances/evpn-vpls-instance.
2.Delete the wtr-params choice and add the wtr , wtr-second-with-minute , wtr-second leaf which in configuration/l2vpn/service-instances/vpws-community-instances/vpws-community-instance/auto-discovery-type/type/mpls-evpn/mpls-evpn-params.
3.Delete the wtr-params choice and add the wtr , wtr-second-with-minute , wtr-second leaf which in configuration/l2vpn/service-instances/vpws-community-instances/vpws-community-instance/auto-discovery-type/type/srv6-evpn/srv6-evpn-params.
4.Delete the wtr-params choice and add the wtr , wtr-second-with-minute , wtr-second leaf which in configuration/l2vpn/service-instances/vpws-community-instances/vpws-community-instance/auto-discovery-type/type/vxlan-evpn/vxlan-evpn-params.
5.Delete the wtr-params choice and add the wtr , wtr-second-with-minute , wtr-second leaf which in configuration/l2vpn/service-instances/ring-tree-instances/ring-tree-instance/revertive-mode-params.
6.Delete the wtr-params choice and add the wtr , wtr-second-with-minute , wtr-second leaf which in configuration/l2vpn/service-instances/l2vpn-p2p-services/l2vpn-p2p-service/static-srv6-evpn/srv6-remote-sid-params/srv6-remote-sid-param.' ;
  }

