  revision 2014-06-26 {
    description '1.Modify the following leaf nodes name which in state/statistics/instance-statistics,state/statistics/pw-statistics and state/statistics/ac-statistics:recvpkts changed to in-packets,recvbytes changed to in-bytes,recvpkts-rate changed to in-packets-rate,recvbytes-rate changed to in-bytes-rate,sndpkts changed to out-packets,sndbytes changed to out-bytes,sndpkts-rate changed to out-packets-rate,sndbytes-rate changed to out-bytes-rate,in-drop-pkts changed to in-drop-packets,out-drop-pkts changed to out-drop-packets,indrop-bytes-rate changed to in-drop-bytes-rate,indrop-packets-rate changed to in-drop-packets-rate,inbroadcast-bytes-rate changed to in-broadcast-bytes-rate,inbroadcast-packets-rate changed to in-broadcast-packets-rate,inunicast-bytes-rate changed to in-unknown-unicast-bytes-rate,inunicast-packets-rate changed to in-unknown-unicast-packets-rate.
