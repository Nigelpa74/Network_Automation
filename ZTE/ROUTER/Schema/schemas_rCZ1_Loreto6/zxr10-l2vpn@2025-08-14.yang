                        enum disable {
                          value 0 ;
                          description 'The BFD capability is disable.' ;
                        }

                        enum enable {
                          value 1 ;
                          description 'The BFD capability is enable.' ;
                        }

                      }

                      default disable ;
                    }

                    leaf vccv-bfd-encapsulation {
                      description 'The BFD raw encapsulation capability of the Martini PW.' ;
                      type enumeration {
                        enum ip {
                          value 0 ;
                          description 'The BFD raw encapsulation capability is IP.' ;
                        }

                        enum raw {
                          value 1 ;
                          description 'The BFD raw encapsulation capability is raw.' ;
                        }

                      }

                      default ip ;
                    }

                    leaf vccv-bfd-capability {
                      description 'The BFD signal status capability of the Martini PW.' ;
                      type enumeration {
                        enum basic {
                          value 0 ;
                          description 'The BFD signal status capability is basic.' ;
                        }

                        enum status {
                          value 1 ;
                          description 'The BFD signal status capability is status.' ;
                        }

                      }

                      default basic ;
                    }

                    leaf vccv-bfd-template-name {
                      description 'BFD template name.' ;
                      type string {
                        length 1..31 {
                          description 'The length of BFD template name.' ;
                        }

                      }

                      ncd:revise-date 2021-03-04 ;
                    }

                  }

                  leaf split-horizon-scope {
                    description 'The split-horizon-scope of Martini PW.' ;
                    type enumeration {
                      enum none {
                        value 1 ;
                        description 'No split-horizon scope joined.' ;
                      }

                      enum any {
                        value 2 ;
                        description 'All split-horizon scope joined.' ;
                      }

                    }

                  }

                  container max-traffic-rate-params {
                    description 'The maximum of traffic rate parameters.' ;
                    leaf max-traffic-rate {
                      description 'The maximum of traffic rate.' ;
                      type uint32 {
                        range 64..10000000 {
                          description 'The maximum of traffic rate.' ;
                        }

                      }

                      units kbps ;
                    }

                    leaf max-multicast-rate-percent {
                      description 'The max percent of multicast traffic rate.' ;
                      type uint32 {
                        range 1..100 {
                          description 'The max percent of multicast traffic rate.' ;
                        }

                      }

                      default 100 ;
                    }

                    leaf max-unicast-rate-percent {
                      description 'The max percent of unicast traffic rate.' ;
                      type uint32 {
                        range 1..100 {
                          description 'The max percent of unicast traffic rate.' ;
                        }

                      }

                      default 100 ;
                    }

                    leaf max-unknown-multicast-rate-percent {
                      description 'The max percent of unknown-multicast traffic rate.' ;
                      type uint32 {
                        range 1..100 {
                          description 'The max percent of unknown-multicast traffic rate.' ;
                        }

                      }

                      default 100 ;
                    }

                    leaf max-unknown-unicast-rate-percent {
                      description 'The max percent of unknown-unicast traffic rate.' ;
                      type uint32 {
                        range 1..100 {
                          description 'The max percent of unknown-unicast traffic rate.' ;
                        }

                      }

                      default 100 ;
                    }

                    leaf max-broadcast-rate-percent {
                      description 'The max percent of broadcast traffic rate.' ;
                      type uint32 {
                        range 1..100 {
                          description 'The max percent of broadcast traffic rate.' ;
                        }

                      }

                      default 100 ;
                    }

                  }

                  container mac-limit-params {
                    description 'Maximum MAC entries and action when MAC entries is exceeding the maximum.' ;
                    presence mac-entries ;
                    leaf maximum {
                      description 'Maximum MAC entries.' ;
                      type uint32 {
                        range 1..4294967295 {
                          description 'Minimum is 1. Maximum and default is defined by performance parameter.' ;
                        }

                      }

                      mandatory true ;
                    }

                    leaf action {
                      description 'The action when MAC entries is exceeding the maximum.' ;
                      type enumeration {
                        enum broadcast {
                          value 0 ;
                          description 'The action when MAC entries is exceeding the maximum is broadcast.' ;
                        }

                        enum drop {
                          value 1 ;
                          description 'The action when MAC entries is exceeding the maximum is drop.' ;
                        }

                      }

                      mandatory true ;
                    }

                    ncd:revise-date 2021-01-05 ;
                  }

                  container flow-label {
                    description 'Martini PW support flow label function.' ;
                    leaf push {
                      description 'Flow label transmit capability.' ;
                      type enumeration {
                        enum disable {
                          value 0 ;
                          description 'Flow label transmit capability is disable.' ;
                        }

                        enum enable {
                          value 1 ;
                          description 'Flow label transmit capability is enable.' ;
                        }

                      }

                      default disable ;
                    }

                    leaf pop {
                      description 'Flow label receive capability.' ;
                      type enumeration {
                        enum disable {
                          value 0 ;
                          description 'Flow label receive capability is disable.' ;
                        }

                        enum enable {
                          value 1 ;
                          description 'Flow label receive capability is enable.' ;
                        }

                      }

                      default disable ;
                    }

                    ncd:revise-date 2022-03-15 ;
                  }

                  container split-horizon-scope-params {
                    choice split-horizon-params-type {
                      case split-horizon-scope-enum {
                        leaf split-horizon-scope-enum {
                          type enumeration {
                            enum none {
                              value 1 ;
                              description 'No split-horizon scope joined.' ;
                            }

                            enum any {
                              description 'All split-horizon scope joined.' ;
                              value 2 ;
                            }

                          }

                          description 'The split-horizon-scope of Martini PW.' ;
                        }

                      }

                      case split-horizon-scope-group {
                        leaf split-horizon-scope-group {
                          type string {
                            length 1..51 {
                              description 'The length of split-horizon-scopes.' ;
                            }

                          }

                          description 'The name list of split-horizon group.' ;
                        }

                      }

                      description 'The split-horizon-scope of Martini PW type.' ;
                    }

                    description 'The split-horizon-scope of Martini PW.' ;
                    ncd:revise-date 2023-06-05 ;
                  }

                }

              }

              ncd:revise-date 2019-04-09 ;
            }

            container kompella-discovery {
              if-feature kompella-discovery ;

              description 'Kompella discovery configuration info.' ;
              presence "Kompella discovery type" ;
              container kompella-params {
                description 'Kompella auto discovery configuration parameter.' ;
                list kompella-vpls-params {
                  description 'VPLS Kompella params.' ;
                  key rd ;
                  leaf rd {
                    description 'The route distinguisher parameter.' ;
                    type union {
                      type ncd:asn-nn ;

                      type ncd:ipadd-nn ;

                    }

                  }

                  leaf ve-id {
                    description 'The VE identification for the VPLS instance.' ;
                    type uint16 {
                      range 0..65534 {
                        description 'VE-ID value.' ;
                      }

                    }

                  }

                  leaf ve-set-style {
                    description 'The style of VE set parameter.' ;
                    type enumeration {
                      enum continuous {
                        value 1 ;
                        description 'The style of VE set parameter is continuous.' ;
                      }

                      enum discrete {
                        value 2 ;
                        description 'The style of VE set parameter is discrete.' ;
                      }

                    }

                  }

                  leaf max-ve-id {
                    description 'The maximum identification for the VPLS instance.' ;
                    type uint32 {
                      range 1..79 {
                        description 'The maximum identification value.' ;
                      }

                    }

                  }

                  leaf tunnel-policy-name {
                    description 'The name of tunnel policy parameter.' ;
                    type string {
                      length 1..63 {
                        description 'The length of tunnel policy name.' ;
                      }

                    }

                  }

                  leaf traffic-enable {
                    description 'The traffic statistics status of Kompella PW.' ;
                    type enumeration {
                      enum disable {
                        value 0 ;
                        description 'The traffic statistics status of Kompella PW is disable.' ;
                      }

                      enum enable {
                        value 1 ;
                        description 'The traffic statistics status of Kompella PW is enable.' ;
                      }

                    }

                    default disable ;
                  }

                  leaf control-word {
                    description 'The control-word capability of the Kompella PW.' ;
                    type enumeration {
                      enum not-preferred {
                        value 0 ;
                        description 'The control-word capability is not preferred.' ;
                      }

                      enum preferred {
                        value 1 ;
                        description 'The control-word capability is preferred.' ;
                      }

                    }

                    default not-preferred ;
                  }

                  container encapulation {
                    description 'The encapsulation params of the Kompella PW.' ;
                    presence encapulation ;
                    leaf encapulation-type {
                      description 'Specify encapsulation mode for Kompella PW.' ;
                      type enumeration {
                        enum vlan {
                          value 4 ;
                          description 'The PW type is VLAN.' ;
                        }

                        enum ethernet {
                          value 5 ;
                          description 'The PW type is ethernet.' ;
                        }

                      }

                      mandatory true ;
                    }

                    leaf separate-in-signal {
                      description 'Encapsulation use separate PW type in signal or not.' ;
                      type enumeration {
                        enum not-separate-encap {
                          value 0 ;
                          description 'Encapsulation not use separate PW type in signal.' ;
                        }

                        enum separate-encap {
                          value 1 ;
                          description 'Encapsulation use separate PW type in signal.' ;
                        }

                      }

                      default not-separate-encap ;
                    }

                  }

                  leaf split-horizon-scope {
                    status obsolete {
                      ncd:revise-date 2022-02-15 ;
                    }

                    description 'The split-horizon-scope of Kompella PW.' ;
                    type enumeration {
                      enum none {
                        value 1 ;
                        description 'No split-horizon scope joined.' ;
                      }

                      enum any {
                        value 2 ;
                        description 'All split-horizon scopes joined.' ;
                      }

                    }

                  }

                  container multi-chassis-pw-params {
                    description 'Multiple chassis PW redundancy parameters.' ;
                    presence multi-chassis-pw-params ;
                    leaf multi-chassis-pw {
                      description 'Multiple chassis PW redundancy grouped by site ID.' ;
                      type empty ;

                      mandatory true ;
                    }

                    container temporary-standby-params {
                      description 'Multiple chassis PW redundancy temporary standby parameters.' ;
                      presence temporary-standby-params ;
                      leaf temporary-standby-time {
                        description 'Wait for other PEs to receive preference update.' ;
                        type uint32 {
                          range 1..5000 {
                            description 'The range of temporary standby time.' ;
                          }

                        }

                        units ms ;
                        mandatory true ;
                      }

                      leaf smoothly {
                        description 'Temporary standby drops packets smoothly or not.' ;
                        type empty ;

                      }

                    }

                    ncd:revise-date 2021-12-13 ;
                  }

                  container site-preference-params {
                    description 'Site preference parameters.' ;
                    presence site-preference-params ;
                    leaf site-preference {
                      description 'Configure site preference.' ;
                      type uint32 {
                        range 1..65535 {
                          description 'Set site preference' ;
                        }

                      }

                      mandatory true ;
                    }

                    leaf backup-preference {
                      description 'Site Preference Value of the other multihomed PE.' ;
                      type uint32 {
                        range 1..65535 {
                          description 'Set site preference.' ;
                        }

                      }

                    }

                    ncd:revise-date 2021-12-22 ;
                  }

                  container flow-label {
                    description 'Configure flow-label capability.' ;
                    leaf push {
                      description 'Set flow-label transmit capability.' ;
                      type enumeration {
                        enum static {
                          value 1 ;
                          description 'Push a flow-label even if R flag is not received.' ;
                        }

                        enum dynamic {
                          value 2 ;
                          description 'Push a flow-label only if R flag is received.' ;
                        }

                      }

                    }

                    leaf pop {
                      description 'Set flow-label receive capability.' ;
                      type enumeration {
                        enum static {
                          value 1 ;
                          description 'Pop a flow-label even if T flag is not received.' ;
                        }

                        enum dynamic {
                          value 2 ;
                          description 'Pop a flow-label only if T flag is received.' ;
                        }

                      }

                    }

                    ncd:revise-date 2021-12-22 ;
                  }

                  container split-horizon-scope-params {
                    description 'The split-horizon-scope of Kompella PW.' ;
                    choice split-horizon-params-type {
                      description 'The split-horizon-scope of Kompella PW type.' ;
                      case split-horizon-scope-enum {
                        description 'The split-horizon-scope of Kompella PW.' ;
