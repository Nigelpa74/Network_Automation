                        description 'The length of wtr-time.' ;
                      }

                    }

                    units min ;
                    default 3 ;
                  }

                  leaf wtr-time {
                    type uint8 {
                      range 0..12 {
                        description 'The length of WTR time in minute.' ;
                      }

                    }

                    description 'Set minutes in WTR. Requires setting wtr-second-with-minute node simultaneously. The range is 0-12(minutes).' ;
                    units min ;
                    default 3 ;
                    ncd:revise-date 2021-11-01 ;
                  }

                  leaf wtr-second-with-minute {
