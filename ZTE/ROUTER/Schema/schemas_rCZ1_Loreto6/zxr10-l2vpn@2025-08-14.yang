  container state {
    config false ;
    description 'L2VPN module state info.' ;
    container l2vpn {
      description 'L2VPN module query root node.It contains PW,PW group,traffic statistics,PW track and PW list info.' ;
      list pw-info {
        description 'PW forwarding table query info.' ;
        key pw-name ;
        leaf pw-name {
          description 'The name of the PW.' ;
          type ncd:ifname {
            length 1..31 {
              description 'The length of PW name.' ;
            }

          }

        }

        leaf vpn-name {
          description 'The name of the L2VPN instance.' ;
          type string {
            length 1..32 {
              description 'The length of instance name.' ;
            }

          }

        }

        leaf peer-address {
          description "The remote peer's IP address of the PW." ;
          type ncd:ipv4-address-none-zero ;

        }

        leaf vcid {
          description 'The VCID of the PW.' ;
          type uint32 ;

        }

        leaf pw-type {
          description 'L2VPN PW type. Assigned values are specified in IANA Allocations for Pseudowire Edge to Edge Emulation (PWE3).' ;
          type enumeration {
            enum unknown {
              value 0 ;
              description 'The PW type is unknown.' ;
            }

            enum dlciOld {
              value 1 ;
              description 'The PW type is FR-DLCI old.' ;
            }

            enum atmSdu {
              value 2 ;
              description 'The PW type is ATM-AAL5-SDU.' ;
            }

            enum atmCell {
              value 3 ;
              description 'The PW type is ATM-CELL.' ;
            }

            enum vlan {
              value 4 ;
              description 'The PW type is VLAN.' ;
            }

            enum ethernet {
              value 5 ;
              description 'The PW type is ethernet.' ;
            }

            enum hdlc {
              value 6 ;
              description 'The PW type is HDLC.' ;
            }

            enum ppp {
              value 7 ;
              description 'The PW type is PPP.' ;
            }

            enum sdhCESoM {
              value 8 ;
              description 'The PW type is SONET/SDH Circuit Emulation Service over MPLS.' ;
            }

            enum atmVCCn {
              value 9 ;
              description 'The PW type is ATM n-to-one VCC.' ;
            }

            enum atmVPCn {
              value 10 ;
              description 'The PW type is ATM n-to-one VPC.' ;
            }

            enum ipL2 {
              value 11 ;
              description 'The PW type is IP-L2.' ;
            }

            enum atmVCC1 {
              value 12 ;
              description 'The PW type is ATM one-to-one VCC.' ;
            }

            enum atmVPC1 {
              value 13 ;
              description 'The PW type is ATM one-to-one VPC.' ;
            }

            enum atmPDU {
              value 14 ;
              description 'The PW type is ATM AAL5 PDU VCC.' ;
            }

            enum frPort {
              value 15 ;
              description 'The PW type is FR port.' ;
            }

            enum sdhCEoP {
              value 16 ;
              description 'The PW type is SONET/SDH Circuit Emulation over Packet.' ;
            }

            enum saTopE1 {
              value 17 ;
              description 'The PW type is Structure-agnostic E1 over Packet.' ;
            }

            enum saTopT1 {
              value 18 ;
              description 'The PW type is Structure-agnostic T1 (DS1) over Packet.' ;
            }

            enum saTopE3 {
              value 19 ;
              description 'The PW type is Structure-agnostic E3 over Packet.' ;
            }

            enum saTopT3 {
              value 20 ;
              description 'The PW type is Structure-agnostic T3 (DS3) over Packet.' ;
            }

            enum ceSoPSNB {
              value 21 ;
              description 'The PW type is CESoPSN basic.' ;
            }

            enum tdmAAL1 {
              value 22 ;
              description 'The PW type is TDMoIP AAL1.' ;
            }

            enum ceSoPSNC {
              value 23 ;
              description 'The PW type is CESoPSN TDM with CAS.' ;
            }

            enum tdmAAL2 {
              value 24 ;
              description 'The PW type is TDMoIP AAL2.' ;
            }

            enum dlciNew {
              value 25 ;
              description 'The PW type is FR-DLCI.' ;
            }

          }

        }

        leaf local-label {
          description 'The local label of the PW.' ;
          type uint32 ;

        }

        leaf remote-label {
          description 'The remote label of the PW.' ;
          type uint32 ;

        }

        leaf pw-state {
          description 'The state of the PW.' ;
          type enumeration {
            enum down {
              value 1 ;
              description 'The state of the PW is down.' ;
            }

            enum up {
              value 2 ;
              description 'The state of the PW is up.' ;
            }

          }

        }

        leaf remote-status {
          description 'The remote status of the PW.Contain:ALLOK,PWNF,AR,AT,PSNR,PSNT,PWFS,RS,PWSA.
ALLOK - Pseudo Wire Forwarding(hex:0x00,dec:0)
PWNF  - Pseudo Wire Not Forwarding(hex:0x01,dec:1)
AR    - Local AC (ingress) Receive Fault(hex:0x02,dec:2)
AT    - Local AC (egress) Transmit Fault(hex:0x04,dec:4)
PSNR  - Local PSN-facing PW (ingress) Receive Fault(hex:0x08,dec:8)
PSNT  - Local PSN-facing PW (egress) Transmit Fault(hex:0x10,dec:16) 
PWFS  - Pseudo Wire Forwarding Standby(hex:0x20,dec:32)
RS    - Request Switchover to this PW(hex:0x40,dec:64)
PWSA  - Pseudo Wire Status All Fault(hex:0x01|0x02|0x04|0x08|0x10,dec:1|2|4|8|16)' ;
          type uint32 ;

        }

        leaf negotiated-cword {
          description 'The negotiated cword of the PW(0:not-preferred;1:preferred).' ;
          type enumeration {
            enum not-preferred {
              value 0 ;
              description 'The negotiated cword of the PW is not preferred.' ;
            }

            enum preferred {
              value 1 ;
              description 'The negotiated cword of the PW is preferred.' ;
            }

          }

        }

        leaf negotiated-vccv {
          description 'The negotiated VCCV of the PW.
When the PW state is down the negotiated-vccv is 0;When the PW state is up,the negotiated-vccv value meaning is below:
1.CC type is CWORD:if(1==negotiated-vccv & 0x01);
2.CC type is ALERT_LABEL:if(1==negotiated-vccv & 0x02);
3.CC type is TTL:if(1==negotiated-vccv & 0x04);
4.CV type is ICMP:if(1==negotiated-vccv & (0x01 << 8));
5.CV type is LSP:if(1==negotiated-vccv & (0x02 << 8));
6.CV type is BFD_BASIC_HEAD:if(1==negotiated-vccv & (0x04 << 8));
7.CV type is BFD_STATUS_HEAD:if(1==negotiated-vccv & (0x08 << 8));
8.CV type is BFD_BASIC_RAW:if(1==negotiated-vccv & (0x10 << 8));
9.CV type is BFD_STATUS_RAW:if(1==negotiated-vccv & (0x20 << 8)).' ;
          type uint16 ;

        }

        leaf create-time {
          description 'The create time of the PW.' ;
          type ncd:string-with-blank {
            length 1..64 {
              description 'The string length of create-time.' ;
            }

          }

        }

        leaf last-status-change-time {
          description 'The last status change time of the PW.' ;
          type ncd:string-with-blank {
            length 1..64 {
              description 'The string length of last-status-change-time.' ;
            }

          }

        }

        leaf track-name {
          description 'The name of PW track.' ;
          type string {
            length 1..31 {
              description 'The length of track name.' ;
            }

          }

        }

        leaf track-status {
          description 'The state of PW track.' ;
          type enumeration {
            enum unknown {
              value 0 ;
              description 'The PW track status is unknown.' ;
            }

            enum down {
              value 1 ;
              description 'The PW track status is down.' ;
            }

            enum up {
              value 2 ;
              description 'The PW track status is up.' ;
            }

          }

        }

        container outter-fwd-info {
          description 'The outer forwarding info of PW.' ;
          list outter-fwd {
            description 'The outer forwarding info of PW.' ;
            key number ;
            leaf number {
              description 'The PSN outer forwarding number of the PW.' ;
              type uint32 {
                range 1..64 {
                  description 'The range of outer forwarding number.' ;
                }

              }

            }

            leaf outlabel1 {
              description 'The PSN outer label 1 of the PW.' ;
              type uint32 ;

            }

            leaf outlabel2 {
              description 'The PSN outer label 2 of the PW.' ;
              type uint32 ;

            }

            leaf outlabel3 {
              description 'The PSN outer label 3 of the PW.' ;
              type uint32 ;

            }

            leaf outlabel4 {
              description 'The PSN outer label 4 of the PW.' ;
              type uint32 ;

            }

            leaf outlabel5 {
              type uint32 ;

              description 'The PSN outer label 5 of the PW.' ;
              ncd:revise-date 2025-04-14 ;
            }

            leaf outlabel6 {
              type uint32 ;

              description 'The PSN outer label 6 of the PW.' ;
              ncd:revise-date 2025-04-14 ;
            }

            leaf outlabel7 {
              type uint32 ;

              description 'The PSN outer label 7 of the PW.' ;
              ncd:revise-date 2025-04-14 ;
            }

            leaf outlabel8 {
              type uint32 ;

              description 'The PSN outer label 8 of the PW.' ;
              ncd:revise-date 2025-04-14 ;
            }

            leaf outlabel9 {
              type uint32 ;

              description 'The PSN outer label 9 of the PW.' ;
              ncd:revise-date 2025-04-14 ;
            }

            leaf outlabel10 {
              type uint32 ;

              description 'The PSN outer label 10 of the PW.' ;
              ncd:revise-date 2025-04-14 ;
            }

            leaf outlabel11 {
              type uint32 ;

              description 'The PSN outer label 11 of the PW.' ;
              ncd:revise-date 2025-04-14 ;
            }

            leaf outlabel12 {
              type uint32 ;

              description 'The PSN outer label 12 of the PW.' ;
              ncd:revise-date 2025-04-14 ;
            }

            leaf outlabel13 {
              type uint32 ;

              description 'The PSN outer label 13 of the PW.' ;
              ncd:revise-date 2025-04-14 ;
            }

            leaf outlabel14 {
              type uint32 ;

              description 'The PSN outer label 14 of the PW.' ;
              ncd:revise-date 2025-04-14 ;
            }

            leaf outlabel15 {
              type uint32 ;

              description 'The PSN outer label 15 of the PW.' ;
              ncd:revise-date 2025-04-14 ;
            }

            leaf outlabel16 {
              type uint32 ;

              description 'The PSN outer label 16 of the PW.' ;
              ncd:revise-date 2025-04-14 ;
            }

            leaf outlabel17 {
              type uint32 ;

              description 'The PSN outer label 17 of the PW.' ;
              ncd:revise-date 2025-04-14 ;
            }

            leaf outlabel18 {
              type uint32 ;

              description 'The PSN outer label 18 of the PW.' ;
              ncd:revise-date 2025-04-14 ;
            }

            leaf outlabel19 {
              type uint32 ;

              description 'The PSN outer label 19 of the PW.' ;
              ncd:revise-date 2025-04-14 ;
            }

            leaf outlabel20 {
              type uint32 ;

              description 'The PSN outer label 20 of the PW.' ;
              ncd:revise-date 2025-04-14 ;
            }

            leaf outlabel21 {
              type uint32 ;

              description 'The PSN outer label 21 of the PW.' ;
              ncd:revise-date 2025-04-14 ;
            }

            leaf outlabel22 {
              type uint32 ;

              description 'The PSN outer label 22 of the PW.' ;
              ncd:revise-date 2025-04-14 ;
            }

            leaf outlabel23 {
              type uint32 ;

              description 'The PSN outer label 23 of the PW.' ;
              ncd:revise-date 2025-04-14 ;
            }

            leaf outlabel24 {
              type uint32 ;

              description 'The PSN outer label 24 of the PW.' ;
              ncd:revise-date 2025-04-14 ;
            }

            leaf out-interface {
              description 'The name of the PSN out interface.' ;
              type string {
                length 0..31 {
                  description 'The length of interface name.' ;
                }

              }

            }

            leaf tunnel-id {
              description 'PSN tunnel ID.' ;
              type uint32 ;

            }

            ncd:revise-date 2015-09-14 ;
          }

          ncd:revise-date 2015-08-04 ;
        }

        container tunnel-policy-result {
          description 'The result of the tunnel policy.' ;
          leaf result-type {
            description 'The result type of the tunnel policy.' ;
            type enumeration {
              enum te-tunnel {
                value 1 ;
                description 'The select result is TE tunnel.' ;
              }

              enum te-ecmp {
                value 2 ;
                description 'The select result is TE ECMP.' ;
              }

              enum te-ldsh {
                value 3 ;
                description 'The select result is TE LDSH.' ;
              }

              enum te-ldshv6 {
                value 4 ;
                description 'The select result is TE LDSHv6.' ;
              }

              enum ldp-lsp {
                value 5 ;
                description 'The select result is LDP LSP.' ;
              }

              enum sr-be {
                value 6 ;
                description 'The select result is SR BE.' ;
              }

              enum gre-tunnel {
                value 7 ;
                description 'The select result is GRE tunnel.' ;
              }

              enum unsupported-type {
                value 8 ;
                description 'The select result is not supported.' ;
              }

              enum srv6-te-tunnel {
                value 9 ;
                description 'The select result is SRv6 TE tunnel.' ;
              }

              enum sr-policy-group {
                value 10 ;
                description 'The select result is SR policy group.' ;
              }

              enum bgp {
                value 11 ;
                description 'The select result is BGP.' ;
              }

              enum be {
                value 12 ;
                description 'The select result is BE.' ;
              }

            }

          }

          leaf result-id {
            description 'The forward table ID of the tunnel policy selection result.' ;
            type uint32 ;

          }

          ncd:revise-date 2020-10-21 ;
        }

        ncd:select vpn-name ;
        ncd:select peer-address ;
        ncd:select "vpn-name peer-address" ;
        ncd:select pw-name ;
      }

      list pw-group-info {
        description 'PW group query info.' ;
        key working-interface ;
        leaf working-interface {
          description 'The working PW/AC name of the PW protect.' ;
          type ncd:ifname {
            length 1..31 {
              description 'The length of working interface name.' ;
            }

          }

        }

        leaf pw-group-id {
          description 'The PW protect group identification.' ;
          type uint32 {
            range 1..8192 {
              description 'The range of PW group identification.' ;
            }

          }

        }

        leaf protected-pw {
          description 'The protection PW name of the PW protect strategy.' ;
          type string {
            length 1..31 {
              description 'The length of protection PW name.' ;
            }

          }

        }

        leaf switch-flag {
          description 'The switch flag of the PW protect group.' ;
          type enumeration {
            enum yes {
              value 1 ;
              description 'The switch flag of the PW protect group is no.' ;
            }

            enum no {
              value 2 ;
              description 'The switch flag of the PW protect group is yes.' ;
            }

          }

        }

        leaf work-path-status {
          description 'Working path status.' ;
          type enumeration {
            enum no-defect {
              value 0 ;
              description 'Working PW status is signal OK.' ;
            }

            enum defect {
              value 1 ;
              description 'Working PW status is signal fail.' ;
            }

            enum defect-sd {
              value 2 ;
              description 'Working PW status is signal degrade.' ;
            }

          }

          ncd:revise-date 2023-02-10 ;
        }

        leaf protect-path-status {
          description 'Protection path status.' ;
          type enumeration {
            enum no-defect {
              value 0 ;
              description 'Protect PW status is signal OK.' ;
            }

            enum defect {
              value 1 ;
              description 'Protect PW status is signal fail.' ;
            }

            enum defect-sd {
              value 2 ;
              description 'Protect PW status is signal degrade.' ;
            }

          }

          ncd:revise-date 2023-02-10 ;
        }

        container dni-pw-peer-info {
          description 'The DNI-PW peer information in common protect group.' ;
          leaf peer-useable {
            description 'The DNI-PW peer chassis useable flag.' ;
            type enumeration {
              enum unknown {
                value 0 ;
                description 'Peer chassis is unknown.' ;
              }

              enum unuseable {
                value 1 ;
                description 'Peer chassis is unuseable.' ;
              }

              enum useable {
                value 2 ;
                description 'Peer chassis is useable.' ;
              }

            }

          }

          leaf peer-protect-type {
            description 'The DNI-PW peer PW protect type.' ;
            type enumeration {
              enum unknown {
                value 0 ;
                description 'The DNI-PW peer protect type is unknown.' ;
              }

              enum 1:1-unidirectional-receiving-selective {
                value 1 ;
                description 'The DNI-PW peer protect type is 1:1 unidirectional receiving selective.' ;
              }

              enum 1:1-bidirectional-receiving-selective {
                value 2 ;
                description 'The DNI-PW peer protect type is 1:1 bidirectional receiving selective.' ;
              }

              enum 1:1-unidirectional-receiving-both {
                value 3 ;
                description 'The DNI-PW peer protect type is 1:1 unidirectional receiving both.' ;
              }

              enum 1:1-bidirectional-receiving-both {
                value 4 ;
                description 'The DNI-PW peer protect type is 1:1 bidirectional receiving both.' ;
              }

              enum "1+1-unidirectional-receiving-selective" {
                value 5 ;
                description 'The DNI-PW peer protect type is 1+1 unidirectional receiving selective.' ;
              }

              enum "1+1-bidirectional-receiving-selective" {
                value 6 ;
                description 'The DNI-PW peer protect type is 1+1 bidirectional receiving selective.' ;
              }

              enum "1+1-unidirectional-receiving-both" {
                value 7 ;
                description 'The DNI-PW peer protect type is 1+1 unidirectional receiving both.' ;
              }

              enum "1+1-bidirectional-receiving-both" {
                value 8 ;
                description 'The DNI-PW peer protect type is 1+1 bidirectional receiving both.' ;
              }

            }

          }

          leaf peer-mc-role {
            description 'The DNI-PW peer PW MC role.' ;
            type enumeration {
              enum unknown {
                value 0 ;
                description 'The DNI-PW peer MC role is unknown.' ;
              }

              enum master {
                value 1 ;
                description 'The DNI-PW peer MC role is master.' ;
              }

              enum slave {
                value 2 ;
                description 'The DNI-PW peer MC role is slave.' ;
              }

            }

          }

          leaf peer-iccp-id {
            description 'The DNI-PW peer ICCP ID.' ;
            type uint32 {
              range 0..4294967295 {
                description 'The ICCP identification range.' ;
              }

            }

          }

          leaf peer-pw-state {
            description 'The DNI-PW peer PW state.' ;
            type enumeration {
              enum unknown {
                value 0 ;
                description 'The DNI-PW peer PW state is unknown.' ;
              }

              enum down {
                value 1 ;
                description 'The DNI-PW peer PW state is down.' ;
              }

              enum up {
                value 2 ;
                description 'The DNI-PW peer PW state is up.' ;
              }

            }

          }

        }

      }

      container statistics {
        description 'Traffic statistics state info.It contains instance statistics,PW statistics and AC statistics.' ;
        list instance-statistics {
          description 'Instance statistics query info.It contains the following attributes:instance-name,recvpkts,recvbytes,recvpkts-rate,recvbytes-rate,sendpkts,sndbytes,sndpkts-rate,sndbytes-rate.' ;
          key instance-name ;
          leaf instance-name {
            description 'The name of the instance.' ;
            type string {
              length 1..32 {
                description 'The length of instance name.' ;
              }

