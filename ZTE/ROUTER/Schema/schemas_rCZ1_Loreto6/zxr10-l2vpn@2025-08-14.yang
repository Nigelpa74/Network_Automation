                    leaf control-word {
                      description 'The control-word capability.' ;
                      type enumeration {
                        enum not-preferred {
                          value 0 ;
                          description 'The control-word capability is not preferred.' ;
                        }

                        enum preferred {
                          value 1 ;
                          description 'The control-word capability is preferred.' ;
                        }

                      }

                      default not-preferred ;
                    }

                    leaf wtr-time {
                      type uint8 {
                        range 0..12 {
                          description 'The length of WTR time in minute.' ;
                        }

                      }

                      description 'Set minutes in WTR. Requires setting wtr-second-with-minute node simultaneously. The range is 0-12(minutes).' ;
                      default 3 ;
                      units min ;
                      ncd:revise-date 2019-02-15 ;
                    }

                    leaf wtr-second-with-minute {
                      type uint8 {
                        range 0..59 {
                          description 'The length of WTR second time in minute.' ;
                        }

                      }

                      description 'Set seconds in WTR. Requires setting wtr-time node simultaneously. The range is 0-59(seconds).' ;
                      units second ;
                      ncd:revise-date 2024-08-13 ;
                    }

                    leaf second {
                      type uint32 {
                        range 0..720 {
                          description 'The length of WTR time in second.' ;
                        }

                      }

                      description 'Set seconds in WTR. Cannot be configured simultaneously with wtr-time node or wtr-second-with-minute node. The range is 0-720(seconds). ' ;
                      units second ;
                      ncd:revise-date 2023-12-12 ;
