          }

          leaf first-mask-addr {
            description 'The mask address of the first prefix sid.' ;
            type ncd:ipv4-address ;

          }

          leaf first-sid {
            description 'The sid value of the first prefix sid.' ;
            type uint32 {
              range 0..4294967295 ;

