      }

      container adjacency-protect-ids {
        status obsolete {
          ncd:revise-date 2020-03-30 ;
        }

        list adjacency-protect-id {
          key 'local-interface remote-router-id sr-path-identifier' ;
          leaf local-interface {
            description 'The local interface of SR adjacency.' ;
            type ncd:ifname ;

          }

          leaf remote-router-id {
            description 'The remote router ID SR adjacency.' ;
            type ncd:ipv4-address-none-zero ;

          }

          leaf sr-path-identifier {
            description 'The protect SR path identifier.' ;
            type uint32 {
              range 1..65535 ;

            }

          }

          leaf bfd-rd {
            description 'Remote discriminator for BFD.' ;
            type ncd:ipv4-address ;

          }

          leaf bfd-template-name {
            description 'The template name for BFD.' ;
            type string {
              length 0..31 ;

            }

          }

        }

        ncd:revise-date 2019-11-20 ;
      }

    }

    container ipv6 {
      description 'The node for IPv6 segment-routing.' ;
      container global-status {
        description 'The node of global segment-routing status.' ;
        leaf status {
          description 'Enable or disable the status of global IPv6 segment-routing.' ;
          type GLOBAL-STATUS ;

          default ENABLE ;
        }

      }

      container local-prefix-sid {
        description 'The configuration node of local prefix sid.' ;
        list local-prefix-sid {
          description 'The configuration node of local prefix sid.' ;
          key 'prefix prefix-length' ;
          leaf prefix {
            description 'The destination address of local prefix sid.' ;
            type ncd:ipv6-address ;

          }

          leaf prefix-length {
            description 'The prefix length of local prefix sid.' ;
            type uint8 {
              range 0..128 ;

            }

          }

          leaf index {
            description 'The index value of local prefix sid.' ;
            type uint32 {
              range 0..4294967294 ;

            }

            default 0 ;
          }

          leaf node-flag {
            description 'The node-flag of local prefix sid.' ;
            type LOCAL-PREFIX-NODE-FLAG ;

            default FALSE ;
          }

          leaf php-flag {
            description 'The label operation of penultimate hop.' ;
            type LOCAL-PREFIX-PHP-FLAG ;

            default NULL ;
          }

        }

      }

      container mapping-server {
        if-feature mapping-server ;

        description 'The configuration node of prefix-sid-map in ipv6.' ;
        list prefix-sid-map {
          description 'The configuration node of prefix-sid-map in ipv6.' ;
          key 'prefix prefix-len' ;
          leaf prefix {
            description 'The first ipv6 prefix mapped with sid.' ;
            type ncd:ipv6-address ;

          }

          leaf prefix-len {
            description 'The lenth of first ipv6 prefix mapped with sid.' ;
            type uint8 {
              range 1..128 ;

            }

          }

          leaf first-sid {
            description 'The first SID.' ;
            type int32 {
              range 0..1048559 ;

            }

            mandatory true ;
          }

          leaf range {
            description 'The quantity of maps of prefix and sid.' ;
            type int32 {
              range 1..65535 ;

            }

            mandatory true ;
          }

        }

        ncd:revise-date 2018-09-19 ;
      }

      container adjacencys {
        description 'The configuration node of SR adjacency-SID.' ;
        list adjacency {
          description 'The configuration node of IPv6 SR adjacency-SID.' ;
          key 'local-ipv6 remote-ipv6' ;
          leaf local-ipv6 {
            description 'the local IPv6 address of IPv6 SR adjacency-SID.' ;
            type ncd:ipv6-address ;

          }

          leaf remote-ipv6 {
            description 'The remote IPv6 address of IPv6 SR adjacency-SID.' ;
            type ncd:ipv6-address ;

          }

          leaf sid {
            description 'The SID value of IPv6 SR adjacency-SID.' ;
            type int32 {
              range 16..1048575 ;

            }

            mandatory true ;
          }

        }

        ncd:revise-date 2018-12-27 ;
      }

      container adjacency-intfs {
        description 'The configuration node of SR adjacency-SID-interface unnumbered.' ;
        list adjacency-intf {
          description 'The configuration node of SR adjacency-SID-interface unnumbered.' ;
          key 'local-interface remote-router-id' ;
          leaf local-interface {
            description 'the local interface of SR adjacency-SID.' ;
            type ncd:ifname ;

          }

          leaf remote-router-id {
            description 'The remote router ID SR adjacency-SID.' ;
            type ncd:ipv6-address ;

          }

          leaf sid {
            description 'The SID value of SR adjacency-SID.' ;
            type int32 {
              range 16..1048575 ;

            }

            mandatory true ;
          }

        }

        ncd:revise-date 2019-06-10 ;
      }

      ncd:revise-date 2017-08-21 ;
    }

    container binding-sids {
      description 'The configuration node of SR binding-SID.' ;
      list binding-sid {
        description 'The configuration node of SR binding-SID.' ;
        key tunnel-id ;
        leaf tunnel-id {
          description 'The tunnel id of SR binding-SID.' ;
          type uint32 {
            range 1..4294967295 ;

          }

        }

        choice label {
          description 'Choose the type of assigning binding SID.
sid: Specify the SID value.
auto: Assign the SID automatically.' ;
          case sid {
            description 'Specify the SID value case.' ;
            leaf sid {
              description 'The SID of SR binding-SID.' ;
              type uint32 {
                range 16..1048575 ;

              }

              mandatory true ;
            }

          }

          case auto {
            description 'Assign SID automatically case.' ;
            leaf auto {
              description 'Assign SID automatically.' ;
              type enumeration {
                enum auto {
                  value 1 ;
                }

              }

              mandatory true ;
            }

            ncd:revise-date 2020-03-04 ;
          }

        }

      }

      ncd:revise-date 2018-08-07 ;
    }

    container max-sid-depths {
      if-feature msd ;

      description 'The configuration of maximum SID depth.' ;
      list max-sid-depth {
        description 'The configuration of maximum SID depth.' ;
        key type ;
        leaf type {
          description 'The sub type of MSD,such as MPLS.' ;
          type enumeration {
            enum mpls {
              value 1 ;
              description 'MPLS MSD' ;
            }

          }

        }

        leaf value {
          description 'The value of MSD.' ;
          type uint32 {
            range 0..254 {
              description 'MSD value' ;
            }

          }

          mandatory true ;
        }

      }

      leaf erld-value {
        description 'The configuration of max-sid-depth erld.' ;
        type int32 {
          range 0..254 {
            description 'ERLD value' ;
          }

        }

        ncd:revise-date 2019-10-30 ;
      }

      ncd:revise-date 2018-09-19 ;
    }

    container aiis {
      if-feature network-slice ;

      description 'The node for segment-routing administrative instance.' ;
      list aii {
        description 'The node for segment-routing administrative instances.' ;
