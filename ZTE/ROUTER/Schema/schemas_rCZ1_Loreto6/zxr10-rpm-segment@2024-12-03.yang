module zxr10-rpm-segment {
  namespace "http://www.zte.com.cn/zxr10/netconf/schema/rosng/rpm-segment" ;
  prefix rpm-segment ;
  import zxr10-netconf-defs {
    prefix ncd ;
  }

  organization "ZTE Corporation" ;
  contact "ZTE Corporation
  Nanjing Institute of ZTE Corporation
  No.68 Zijinghua Rd. Yuhuatai District, Nanjing, China
  Tel: +86-25-52870000" ;
  revision 2024-12-03 {
    description 'Remove the mandatory attribute from the key node. paths are "configuration/locators/locator/slice-end-x-sids/auto-slice-end-x-sids/auto-slice- end-x-sid/interface" and "configuration/locators/locator/slice-end-x-sids/auto-slice-end-x-sids/auto-slice-end-x-sid/nexthop"' ;
  }

  revision 2024-07-04 {
    description "Add a configuration node for the switch of automatic generation of extended routes for the uSID locator. The path is 'configuration/srv6/usid-locators/usid-locator/terminate-local-usid-lookup'." ;
  }

  revision 2024-03-25 {
    description 'Add a new locator configuration node for setting the anycast attribute of the locator.The path is “configuration/srv6/locators/locator”' ;
  }

  revision 2023-12-19 {
    description 'Add configuration node of srv6-sid-alarm-threshold.' ;
  }

  revision 2023-11-03 {
    description '1.Add new leaf of “state/srv6/local-sids/local-sid/function-type-standard”,and modify the status of node "state/srv6/local-sids/local-sid/function-type" to deprecated;
2.Add new container of "state/srv6/local-sid-statistics", and modify the status of container "state/srv6/local-sid-summary" to deprecated.' ;
  }

  revision 2023-07-17 {
    description 'Add leaf in local-sid for support segment-list ID of SRv6 SID. The paths are "state/srv6/local-sids/local-sid/segment-list-id".' ;
  }

  revision 2023-04-06 {
    description 'Modify the range of tunnel ID. The paths are configuration/ipv4/adjacency-ip-protect-tunnels/adjacency-ip-protect-tunnel and configuration/ipv4/adjacency-id-protect-tunnels/adjacency-id-protect-tunnel' ;
  }

  revision 2023-03-06 {
    description 'Add leaf in local-sid for support member of out-interface. The paths are "state/srv6/local-sids/local-sid/l2-bundle-member".' ;
  }

  revision 2023-01-13 {
    description 'Add list in local-sid for support multiple nexthops. The paths are "state/srv6/local-sids/local-sid/multiple-nexthops/multiple-nexthop".' ;
  }

  revision 2022-09-21 {
    description 'Add containers for SRv6 End.X and SRv6 End. The paths are "configuration/srv6/locators/locator/end-x-sids" and "configuration/srv6/locators/end-sids".' ;
  }

  revision 2022-08-06 {
    description 'Add containers for SRv6 slice End.X. The paths are "configuration/srv6/locators/locator/slice-end-x-sids" and "state/srv6/slice-end-x-infos".
Add new value of enumeration "SRV6-LOCAL-SID-FUNCTYPE",the value is 25.' ;
  }

  revision 2022-07-15 {
    description 'Modify the range of node "adj-sid-holdtime/holdtime".' ;
  }

  revision 2022-07-06 {
    description 'Modify the leaf node: "/configuration/srv6/adjacency/sid-hold-time".' ;
  }

  revision 2022-06-09 {
    description 'Add containers for SRv6 END.BXC. The paths are "configuration/srv6/locators/locator/end-bxc-sids"
Add new value of enumeration "SRV6-LOCAL-SID-FUNCTYPE",the value is 24.' ;
  }

  revision 2022-03-17 {
    description "Support show VPN name with '?'." ;
  }

  revision 2022-03-16 {
    description 'Modify the leaf "sid-hold-time". Its default value depends on product specification.' ;
  }

  revision 2022-03-09 {
    description "Add containers for SRv6 compressed static length. The paths are \"configuration/srv6/locators/locator/sid-rang/compress\"
    Add new leaves \"static-length-compress\", \"auto-sid-begin-compress\" and \"auto-sid-end-compress\" for get locator's compressed static length and compressed auto sid range. The path is \"state/srv6/locators/locator\"." ;
  }

  revision 2022-02-10 {
    description 'Add containers for SRv6 uSID functions. The paths are "configuration/srv6/usid-locators" and "state/srv6/usid-locators"
Add a new leaf "usid-length" for get local SRv6 uSID. The path is "state/srv6/local-sids/local-sid".
Add a new value uN in enumeration SRV6-LOCAL-SID-FUNCTYPE.' ;
  }

  revision 2022-02-09 {
    description 'Add new function types for END.B6 in SRV6-LOCAL-SID-FUNCTYPE.' ;
  }

  revision 2021-12-20 {
    description 'Add container for interface prefix sid, the path is configuration/if-prefix-sids.' ;
  }

  revision 2021-10-12 {
    description 'Modify the range of args-lenth form <16-16> to 1-64.' ;
  }

  revision 2021-09-18 {
    description 'Add container for service programming functions. The path is "configuration/service-programs".
Add a new leaf "service-programming-name" for get local SRv6 SID from service program. The path is "state/srv6/local-sids/local-sid".
Add a new value END.AS in enumeration SRV6-LOCAL-SID-FUNCTYPE.
Add a new feature "service-program" for service programming functions.' ;
  }

  revision 2021-07-26 {
    description '1. Add leaves "block-length" and "function-length" in state list locator,the path is "/rpm-segment:configuration/rpm-segment:srv6/rpm-segment:locators/rpm-segment:locator/rpm-segment:sid-range"
2. Add leaves "block-length-normal","node-length-normal"and"function-length-normal" in state list locator,the path is "/rpm-segment:state/rpm-segment:srv6/rpm-segment:locators/rpm-segment:locator"' ;
  }

  revision 2021-06-17 {
    description '1. Add a container reserved,the path is "/rpm-segment:configuration/rpm-segment:srv6/rpm-segment:locators/rpm-segment:srv6/rpm-segment:sid-range/rpm-segment:srv6/rpm-segment:reserved"
2. Add leaves "reserved-start" and "reserved-count" in state list locator,the path is "/rpm-segment:state/rpm-segment:srv6/rpm-segment:locators/rpm-segment:locator"
3. Add leaf "dynamic-length" in state list locator,the path is "/rpm-segment:state/rpm-segment:srv6/rpm-segment:locators/rpm-segment:locator"' ;
  }

  revision 2021-06-02 {
    description 'Add selects "fa-id" in "/rpm-segment:state/rpm-segment:srv6/rpm-segment:local-sids".' ;
  }

  revision 2021-03-30 {
    description 'Add a new leaf node sid-hold-time.The path is "configuration/srv6/adjacency/sid-hold-time".' ;
  }

  revision 2021-02-05 {
    description 'Add a new value END.M in enumeration SRV6-LOCAL-SID-FUNCTYPE.' ;
  }

  revision 2020-11-06 {
    description "Modify the max value of SRv6 locator's ipv6-prefix-length from 92 to 120.
    Modify the max value of SRv6 locator's block-length from 91 to 96." ;
  }

  revision 2020-10-29 {
    description 'Add a new leaf node vpls-name to support VPLS name.The paths is "state/srv6/local-sids/local-sid/vpls-name".
Add a new leaf node fa-id to support SRv6 in slice.The paths is "state/srv6/local-sids/local-sid/fa-id".' ;
  }

  revision 2020-09-22 {
    description '1. Obsolete the container srv6-sids, the path is "/rpm-segment:state/rpm-segment:srv6/rpm-segment:srv6-sids";
2. Add a container local-sids,the path is "/rpm-segment:state/rpm-segment:srv6/rpm-segment:local-sids"
3. Add a container local-sid-summary,the path is "/rpm-segment:state/rpm-segment:srv6/rpm-segment:local-sid-summary"
4. Add a typedef "SRV6-LOCAL-SID-FUNCTYPE"' ;
  }

  revision 2020-09-06 {
    description "Add nodes for SRv6 locator's flex-algorithm ID configuration and state." ;
  }

  revision 2020-08-18 {
    description 'Add new nodes for SR adjacency sid holdtime configuration. The path is "configuration/adj-sid-holdtime".' ;
  }

  revision 2020-07-25 {
    description '1. Obsolete the nodes of /rpm-segment:configuration/rpm-segment:srv6/rpm-segment:locators/rpm-segment:locator/rpm-segment:is-default;
2. Obsolete the nodes of /rpm-segment:state/rpm-segment:srv6/rpm-segment:locators/rpm-segment:locator/rpm-segment:is-default;' ;
  }

  revision 2020-06-20 {
    description 'Add new nodes for SR EPE configuration. The path is "configuration/sr-epes".' ;
  }

  revision 2020-06-06 {
    description '1.Add nodes for SRv6 locator configuration and state.
2.Obsolete the nodes of /rpm-segment:configuration/rpm-segment:srv6/rpm-segment:sid-range;
3.Obsolete the nodes of /rpm-segment:state/rpm-segment:srv6/rpm-segment:srv6-sid-range.' ;
  }

  revision 2020-05-19 {
    description 'Add a new node sr-policy-binding-sids. The paths is "configuration/sr-policy-binding-sids".' ;
  }

  revision 2020-04-18 {
    description '1. Obsolete the nodes of /rpm-segment:state/rpm-segment:ipv4/rpm-segment:adjacency-sid;
2. Obsolete the nodes of /rpm-segment:state/rpm-segment:ipv4/rpm-segment:adjacency-sid-new;
3. Obsolete the nodes of /rpm-segment:state/rpm-segment:ipv6/rpm-segment:adjacency-sid;
4. Obsolete the nodes of /rpm-segment:state/rpm-segment:ipv6/rpm-segment:adjacency-sid-new.' ;
  }

  revision 2020-03-30 {
    description 'Obsolete the nodes of configuration/ipv4/adjacency-protect-ips and configuration/ipv4/adjacency-protect-ids. Add the new nodes of configuration/ipv4/adjacency-ip-protect-tunnels and configuration/ipv4/adjacency-id-protect-tunnels.' ;
  }

  revision 2020-03-04 {
    description 'Modify node for static binding SID to a choice node. The path is configuration/binding-sids/binding-sid/label. Add a new type of assign binding SID automatically, the path is configuration/binding-sids/binding-sid/label/auto.' ;
  }

  revision 2020-02-16 {
    description 'Add nodes for SRv6 configuration and state.' ;
  }

  revision 2020-02-04 {
    description 'Modify the range of prefix-sid index to 0-4294967294.' ;
  }

  revision 2020-01-15 {
    description 'Add new nodes adjacencys and adjacency-intfs in aii to support adj-sid in slice. The paths are "configuration/aiis/aii/ipv4/adjacencys " and "configuration/aiis/aii/ipv4/adjacency-intfs".
Delete feature in configuration container fa and state leaf fa-id.' ;
  }

  revision 2019-12-21 {
    description 'Add new nodes for interface aii.The paths are "configuration/interface "and "configuration/interface/aii".' ;
  }

  revision 2019-11-20 {
    description 'Add new nodes for adjacency protect SID, the paths are configuration/ipv4/adjacencys/adjacency/protect-sid, configuration/ipv4/adjacencys/adjacency-intfs/protect-sid. Add new nodes for adjacency protect sr-path, the paths are configuration/ipv4/adjacency-protect-ips, configuration/ipv4/adjacency-protect-ids.' ;
  }

  revision 2019-11-15 {
    description 'Add new nodes aiis and fas for SR slice. The paths are "configuration/aiis" and "configuration/fas".' ;
  }

  revision 2019-10-30 {
    description 'Add a new leaf node erld to support max-sid-depth erld.The paths is "configuration/max-sid-depths/erld-value".' ;
  }

  revision 2019-09-07 {
    description 'Add containers "state/ipv4/adjacency-sid-new" and "state/ipv6/adjacency-sid-new".' ;
  }

  revision 2019-09-01 {
    description 'Add new project label of MSR to support SR.' ;
  }

  revision 2019-06-10 {
    description 'Absolute this revision
Add the query node keys "local-id", "remote-id" and "local-interface" for segment-routing adjacency SID information.
The paths are "state/ipv4/adjacency-sid" and "state/ipv6/adjacency-sid".
Add container adjacency-intfs to support unnumbered interface ADJ-SID.The paths are "configuration/ipv4/adjacency-intfs" and "configuration/ipv6/adjacency-intfs"' ;
  }

  revision 2019-05-31 {
    description '1. Obsolete the leaf node router-id. The paths is "state/ipv6/remote-prefix-sid/information/router-id".
2. Add a new leaf node router-id-str to support ipv6 address. The paths is "state/ipv6/remote-prefix-sid/information/router-id-str".' ;
  }

  revision 2019-05-10 {
    description 'Add new project label of 6700 and T8000 to support SRMS.' ;
  }

  revision 2019-04-08 {
    description 'Add new project label of MW(NR8000) to support segment-routing.' ;
  }

  revision 2019-02-21 {
    description 'Add new project label of 6100/65v5/6700 to support msd.' ;
  }

  revision 2019-02-13 {
    description 'Add the query node for ipv6 segment-routing adjacency SID information.
The path is "state/ipv6/adjacency-sid".' ;
  }

  revision 2018-12-27 {
    description 'Add a new node adjacencys. The paths is "configuration/ipv6/adjacencys".
Add new project label.' ;
  }

  revision 2018-09-19 {
    description 'Add a new node maximum-sid-depths. The paths is "configuration/maximum-sid-depths".
Add new nodes mapping-servers. The paths are "configuration/ipv4/mapping-servers" and "configuration/ipv6/mapping-servers".
Add new nodes prefix-sid-maps. The paths are "state/ipv4/prefix-sid-map" and "state/ipv6/prefix-sid-map".' ;
  }

  revision 2018-08-13 {
    description 'Add a new node adjacencys. The paths is "configuration/ipv4/adjacencys".' ;
  }

  revision 2018-08-07 {
    description 'Add a new node binding-sids. The paths is "configuration/binding-sids".' ;
  }

  revision 2018-05-29 {
    description '1. Obsolete the node remote-srgb. The paths is "state/ipv4/remote-srgb".
2. Add a new node remote-srgbs. The paths is "state/ipv4/remote-srgbs".' ;
  }

  revision 2017-08-21 {
    description '1.Add the node for IPv6 segment-routing.
The path is "configuration/ipv6".
The path is "state/ipv6".' ;
  }

  revision 2017-01-05 {
    description '1.Add the query node for segment-routing local prefix SID information.
The path is "state/ipv4/local-prefix-sid".
2.Add the query node for segment-routing remote prefix SID information.
The path is "state/ipv4/remote-prefix-sid".
3.Add the query node for segment-routing local SRGB information.
The path is "state/ipv4/local-srgb".
4.Add the query node for segment-routing remote SRGB information.
The path is "state/ipv4/remote-srgb".' ;
  }

  revision 2016-12-20 {
    description 'Add the query node for segment-routing adjacency SID information.
The path is "state/adjacency-sid".' ;
  }

  revision 2016-10-19 {
    description 'The initial version.' ;
  }

  feature mapping-server {
    description 'This configuration is used to configure the map of prefix and sid.' ;
  }

  feature msd {
    description 'This configuration is used to configure maximum SID depth.' ;
  }

  feature network-slice ;

  feature service-program {
    ncd:revise-date 2021-09-18 ;
  }

  feature if-prefix-sid {
    description 'Only for convertion of spn-isis.yang.' ;
    ncd:revise-date 2021-12-20 ;
  }

  feature end-bxc {
    description 'This configuration is used to configure END.BXC.' ;
    ncd:revise-date 2022-06-09 ;
  }

  feature slice-end-x {
    description 'This configuration is used to configure slice End.X.' ;
    ncd:revise-date 2022-08-06 ;
  }

  typedef GLOBAL-STATUS {
    description 'Value of segment routing status.' ;
    default ENABLE ;
    type enumeration {
      enum ENABLE {
        value 0 ;
      }

      enum DISABLE {
        value 1 ;
      }

    }

  }

  typedef LOCAL-PREFIX-PHP-FLAG {
    description 'The php-flag of local prefix sid.' ;
    default NULL ;
    type enumeration {
      enum EXPLICIT {
        value 1 ;
      }

      enum IMPLICIT {
        value 2 ;
      }

      enum NULL {
        value 0 ;
      }

    }

  }

  typedef LOCAL-PREFIX-NODE-FLAG {
    description 'The node-flag of local prefix sid.' ;
    default FALSE ;
    type enumeration {
      enum TRUE {
        value 1 ;
        description 'Node flag.' ;
      }

      enum FALSE {
        value 0 ;
        description 'No node flag.' ;
      }

    }

  }

  typedef ADJ-TYPE {
    description 'The type of adjacency SID.' ;
    default INVALID ;
    type enumeration {
      enum INVALID {
        value 0 ;
      }

      enum LOCAL {
        value 1 ;
      }

      enum REMOTE {
        value 2 ;
      }

    }

  }

  typedef REMOTE-PREFIX-FLAG {
    description 'The sid flag of remote prefix sid.' ;
    default NULL ;
    type enumeration {
      enum NULL {
        value 0 ;
      }

      enum IMPLICIT {
        value 1 ;
      }

      enum EXPLICIT {
        value 2 ;
      }

      enum NODE {
        value 3 ;
      }

      enum IMPLICIT-NODE {
        value 4 ;
      }

      enum EXPLICIT-NODE {
        value 5 ;
      }

    }

  }

  typedef SRV6-LOCAL-SID-FUNCTYPE {
    status deprecated ;

    description 'The function type of srv6 local sid.' ;
    type enumeration {
      enum END {
        value 1 ;
      }

      enum END.X {
        value 2 ;
      }

      enum END.B6 {
        value 3 ;
      }

      enum END.BM {
        value 4 ;
      }

      enum L3VPN.DX4 {
        value 5 ;
      }

      enum L3VPN.DX6 {
        value 6 ;
      }

      enum L3VPN.DT4 {
        value 7 ;
      }

      enum L3VPN.DT6 {
        value 8 ;
      }

      enum L3VPN.DT46 {
        value 9 ;
      }

      enum VPWS.DX2 {
        value 10 ;
      }

      enum VPWS.DX2V {
        value 11 ;
      }

      enum QVPLS.DT2U {
        value 12 ;
      }

      enum VPLS.DT2U {
        value 13 ;
      }

      enum VPLS.DX2 {
        value 14 ;
      }

      enum QVPLS.DX2 {
        value 15 ;
      }

      enum VPLS.DT2M {
        value 16 ;
      }

      enum QVPLS.DT2M {
        value 17 ;
      }

      enum END.OP {
        value 18 ;
      }

      enum END.M {
        value 19 ;
      }

      enum END.AS {
        value 20 ;
      }

      enum END_B6_ENCAP_RED {
        value 21 ;
      }

      enum END_B6_INSERT {
        value 22 ;
      }

      enum END_B6_INSERT_RED {
        value 23 ;
      }

      enum END_BXC {
        value 24 ;
      }

      enum SLICE.END.X {
        value 25 ;
      }

    }

  }

  typedef SERVICE-FUNCTION-TYPE {
    type enumeration {
      enum firewall {
        value 1 ;
      }

      enum dpi {
        value 2 ;
      }

      enum classifier {
        value 4 ;
      }

      enum load-balancer {
        value 5 ;
      }

    }

  }

  typedef SERVICE-PROXY-INNER-PKT-TYPE {
    type enumeration {
      enum IPv4 {
        value 1 ;
      }

      enum IPv6 {
        value 2 ;
      }

      enum Ethernet {
        value 3 ;
      }

    }

  }

  container configuration {
    description 'The configuration information processing of segment-routing module.' ;
    container ipv4 {
      description 'The node for IPv4 segment-routing.' ;
      container global-status {
        description 'The node of global segment-routing status.' ;
        leaf status {
          description 'Enable or disable the status of global IPv4 segment-routing.' ;
          type GLOBAL-STATUS ;

          default ENABLE ;
        }

      }

      container local-prefix-sid {
        description 'The configuration node of local prefix sid.' ;
        list local-prefix-sid {
          description 'The configuration node of local prefix sid.' ;
          key 'dest-addr mask-addr' ;
          leaf dest-addr {
            description 'The destination address of local prefix sid.' ;
            type ncd:ipv4-address ;

          }

          leaf mask-addr {
            description 'The mask address of local prefix sid.' ;
            type ncd:ipv4-address ;

          }

          leaf index {
            description 'The index value of local prefix sid.' ;
            type uint32 {
              range 0..4294967294 ;

            }

            default 0 ;
          }

          leaf node-flag {
            description 'The node-flag of local prefix sid.' ;
            type LOCAL-PREFIX-NODE-FLAG ;

            default FALSE ;
          }

          leaf php-flag {
            description 'The label operation of penultimate hop.' ;
            type LOCAL-PREFIX-PHP-FLAG ;

            default NULL ;
          }

        }

      }

      container adjacencys {
        description 'The configuration node of SR adjacency-SID.' ;
        list adjacency {
          description 'The configuration node of SR adjacency-SID.' ;
          key 'local-ip remote-ip' ;
          leaf local-ip {
            description 'The local IP address of SR adjacency-SID.' ;
            type ncd:ipv4-address ;

          }

          leaf remote-ip {
            description 'The remote IP address of SR adjacency-SID.' ;
            type ncd:ipv4-address ;

          }

          leaf sid {
            description 'The SID value of SR adjacency-SID.' ;
            type int32 ;

          }

          leaf protect-sid {
            description 'The SID of protect path.' ;
            type uint32 {
              range 16..1048575 ;

            }

            ncd:revise-date 2019-11-20 ;
          }

        }

        ncd:revise-date 2018-08-13 ;
      }

      container mapping-server {
        if-feature mapping-server ;

        description 'The configuration node of prefix-sid-map in ipv4.' ;
        list prefix-sid-map {
          description 'The configuration node of prefix-sid-map in ipv4.' ;
          key 'dest-addr mask-addr' ;
          leaf dest-addr {
            description 'The first prefix mapped with sid.' ;
            type ncd:ipv4-address ;

          }

          leaf mask-addr {
            description 'The mask address of first v4 prefix mapped with sid.' ;
            type ncd:ipv4-address ;

          }

          leaf first-sid {
            description 'The first SID.' ;
            type int32 {
              range 0..1048559 ;

            }

            mandatory true ;
          }

          leaf range {
            description 'The quantity of maps of prefix and sid.' ;
            type int32 {
              range 1..65535 ;

            }

            mandatory true ;
          }

        }

        ncd:revise-date 2018-09-19 ;
      }

      container adjacency-intfs {
        description 'The configuration node of SR adjacency-SID-interface unnumbered.' ;
        list adjacency-intf {
          description 'The configuration node of SR adjacency-SID-interface unnumbered.' ;
          key 'local-interface remote-router-id' ;
          leaf local-interface {
            description 'the local interface of SR adjacency-SID.' ;
            type ncd:ifname ;

          }

          leaf remote-router-id {
            description 'The remote router ID SR adjacency-SID.' ;
            type ncd:ipv4-address ;

          }

          leaf sid {
            description 'The SID value of SR adjacency-SID.' ;
            type int32 ;

          }

          leaf protect-sid {
            description 'The SID of protect path.' ;
            type uint32 {
              range 16..1048575 ;

            }

            ncd:revise-date 2019-11-20 ;
          }

        }

        ncd:revise-date 2019-06-10 ;
      }

      container adjacency-ip-protect-tunnels {
        description 'Set the protect tunnel of adjacency(IP type).' ;
        presence primary-tunnel-id ;
        list adjacency-ip-protect-tunnel {
          key 'loca-ip remote-ip' ;
          leaf loca-ip {
            description 'The local IP address of SR adjacency.' ;
            type ncd:ipv4-address-none-zero ;

          }

          leaf remote-ip {
            description 'The remote IP address of SR adjacency.' ;
            type ncd:ipv4-address-none-zero ;

          }

          leaf primary-tunnel-id {
            description 'The primary protect tunnel ID.' ;
            type uint32 {
              range 1..97535 ;

            }

            mandatory true ;
          }

          leaf secondary-tunnel-id {
            description 'The secondary protect tunnel ID.' ;
            type uint32 {
              range 1..97535 ;

            }

          }

        }

        ncd:revise-date 2020-03-30 ;
      }

      container adjacency-id-protect-tunnels {
        description 'Set the protect tunnel of adjacency(ID type).' ;
        presence primary-tunnel-id ;
        list adjacency-id-protect-tunnel {
          key 'local-interface remote-router-id' ;
          leaf local-interface {
            description 'The local interface of SR adjacency.' ;
            type ncd:ifname ;

          }

          leaf remote-router-id {
            description 'The remote router ID SR adjacency.' ;
            type ncd:ipv4-address-none-zero ;

          }

          leaf primary-tunnel-id {
            description 'The primary protect tunnel ID.' ;
            type uint32 {
              range 1..97535 ;

            }

            mandatory true ;
          }

          leaf secondary-tunnel-id {
            description 'The secondary protect tunnel ID.' ;
            type uint32 {
              range 1..97535 ;

            }

          }

        }

        ncd:revise-date 2020-03-30 ;
      }

      container adjacency-protect-ips {
        status obsolete {
          ncd:revise-date 2020-03-30 ;
        }

        list adjacency-protect-ip {
          key 'loca-ip remote-ip sr-path-identifier' ;
