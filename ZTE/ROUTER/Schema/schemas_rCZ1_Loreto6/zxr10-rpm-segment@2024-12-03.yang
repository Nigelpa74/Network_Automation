          description 'Segment-routing slice identifier.' ;
          type uint32 {
            range 1..4294967295 ;

          }

        }

        container ipv4 {
          description 'The node for IPv4 segment-routing.' ;
          container local-prefix-sids {
            description 'The configuration node of local prefix sid.' ;
