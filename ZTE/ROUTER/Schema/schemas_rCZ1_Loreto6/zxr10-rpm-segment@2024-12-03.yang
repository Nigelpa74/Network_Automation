    container interfaces-aiis {
      if-feature network-slice ;

      description 'The configuration of interface aii.' ;
      list interface-aii {
        description 'The configuration of interface aiis.' ;
        key 'interface-name aii' ;
        leaf interface-name {
          description 'The interface name of needing AII.' ;
          type ncd:ifname ;

        }

        leaf aii {
          description 'The configuration of interface AII.' ;
          type uint32 {
            range 1..4294967295 {
              description 'aii-value' ;
            }

          }

        }

      }

      ncd:revise-date 2019-12-21 ;
    }

    container srv6 {
      leaf global-status {
        description 'SRv6 global status configuration.' ;
        type GLOBAL-STATUS ;

        default DISABLE ;
      }

      container sid-range {
        status obsolete {
          ncd:revise-date 2020-06-06 ;
        }

        choice range-type {
          case hybrid {
            description 'Specify the SRv6 SID range is hybrid.' ;
            container hybird {
              leaf hybrid {
                description 'Specify the SRv6 SID range is hybrid.' ;
                type empty ;

                mandatory true ;
              }

              leaf prefix {
                description 'Specify the prefix.' ;
                type ncd:ipv6-address ;

                mandatory true ;
              }

              leaf prefix-length {
                description 'Specify the length of prefix.' ;
                type ncd:ipv6-mask-length {
                  range 8..68 ;

                }

                mandatory true ;
              }

              leaf static-sub-range {
                description 'Specify static sub range type in hybrid mode' ;
                type enumeration {
                  enum RANDOM {
                    value 1 ;
                  }

                }

                mandatory true ;
              }

            }

          }

          case dynamic-only {
            description 'Specify the SRv6 SID range is dynamic only' ;
            container dynamic-ony {
              leaf dynamic-only {
                description 'Specify the SRv6 SID range is dynamic only.' ;
                type empty ;

                mandatory true ;
              }

              leaf dynamic-prefix {
                description 'Specify the prefix.' ;
                type ncd:ipv6-address ;

                mandatory true ;
              }

              leaf dynamic-prefix-length {
                description 'Specify the length of prefix.' ;
                type ncd:ipv6-mask-length {
                  range 8..68 ;

                }

                mandatory true ;
              }

            }

          }

          case static-only {
            description 'Specify the SRv6 SID range is static only.' ;
            container static {
              leaf static-only {
                description 'Specify the SRv6 SID range is static only.' ;
                type empty ;

                mandatory true ;
              }

              leaf static-prefix {
                description 'Specify the prefix.' ;
                type ncd:ipv6-address ;

                mandatory true ;
              }

              leaf static-prefix-length {
                description 'Specify the length of prefix.' ;
                type ncd:ipv6-mask-length {
                  range 8..120 ;

                }

                mandatory true ;
              }

            }

          }

        }

      }

      container locators {
        description 'The configuration of SRv6 locator.' ;
        list locator {
          description 'The configuration of SRv6 locator.' ;
          key locator-name ;
          leaf locator-name {
            description "The locator's name.The max length of locator-name is 31." ;
            type string {
              length 1..31 ;

            }

          }

          leaf is-default {
            status obsolete {
              ncd:revise-date 2020-07-25 ;
            }

            description "Configure this locator's default attribute.True means configure the locator to default locator,and false means not. There is at most one default locator on a device." ;
            type boolean ;

          }

          container sid-range {
            description 'The configuration of SRv6 locator sid-range.' ;
            presence locator-range ;
            leaf ipv6-prefix {
              description 'Specify the IPv6 prefix of locator.' ;
              type ncd:ipv6-address-none-zero ;

              mandatory true ;
            }

            leaf ipv6-prefix-length {
              description 'Specify the length of prefix.' ;
              type ncd:ipv6-mask-length {
                range 8..120 ;

              }

              mandatory true ;
            }

            leaf static-length {
              description 'Specify the static opcode length of locator.' ;
              type uint8 {
                range 0..120 ;

              }

            }

            leaf args-length {
              description 'Specify the arguments length of locator.Its range is 1 to 64.' ;
              type uint8 {
                range 1..64 ;

              }

            }

            container compress {
              description "The configuration of SRv6 locator's compress attribute." ;
              presence compress ;
              leaf c-target {
                description 'Specify the compress target.' ;
                type enumeration {
                  enum 32 {
                    value 32 ;
                  }

                }

                mandatory true ;
              }

              leaf block-length {
                description 'Specify the block length.' ;
                type uint8 {
                  range 0..96 ;

                }

                mandatory true ;
              }

              container static-config {
                description "The configuration of SRv6 locator's compressed static length attribute." ;
                presence static-length ;
                leaf static-length {
                  description "The configuration of SRv6 locator's compressed static length.It's range is 0-31." ;
                  type uint8 {
                    range 0..31 ;

                  }

                  mandatory true ;
                }

                ncd:revise-date 2022-03-09 ;
              }

            }

            container reserved {
              description 'Specify the reserved opcode of locator.' ;
              presence reserved ;
              leaf reserved-start {
                description 'Specify the start of reserved opcode.' ;
                type ncd:ipv6-address-none-zero ;

                mandatory true ;
              }

              leaf reserved-count {
                description 'Specify the count of reserved opcode.' ;
                type uint32 {
                  range 1..4294967295 ;

                }

                mandatory true ;
              }

              ncd:revise-date 2021-06-17 ;
            }

            leaf block-length {
              description 'Specify the block length.' ;
              type uint8 {
                range 0..120 ;

              }

              ncd:revise-date 2021-07-26 ;
            }

            leaf function-length {
              description 'Specify the block length.' ;
              type uint8 {
                range 0..120 ;

              }

              ncd:revise-date 2021-07-26 ;
            }

          }

          leaf fa-id {
            description "The node for SRv6 locator's Flex-Algorithm identifier.It's range is 128-255." ;
            type uint32 {
              range 128..255 ;

            }

            ncd:revise-date 2020-09-06 ;
          }

          leaf anycast {
            type boolean ;

            description "Configure this locator's anycast attribute.True means configure the locator to be anycast,and false means not." ;
            default false ;
            ncd:revise-date 2024-03-25 ;
          }

          container end-bxc-sids {
            if-feature end-bxc ;

            description 'SRv6 END.BXC SID container.' ;
            list end-bxc-sid {
              description 'The configuration of SRv6 END.BXC.' ;
              key func-code ;
              leaf func-code {
                description 'Function scope of END.BXC SID.' ;
                type ncd:std-ipv6-address ;

              }

              leaf interface {
                description 'Interface name on which END.BXC SID bound with.' ;
                type ncd:ifname ;

                mandatory true ;
              }

            }

            ncd:revise-date 2022-06-09 ;
          }

          container slice-end-x-sids {
            if-feature slice-end-x ;

            description 'Configuration node of SRv6 slice End.X SID.' ;
            container auto-slice-end-x-sids {
              description 'Configuration node of the automatically allocated SRv6 slice.End.X SID.' ;
              list auto-slice-end-x-sid {
                description 'Configuration node of the automatically allocated SRv6 slice End.X SID.' ;
                key 'interface slice-id nexthop compress encapsulation-type psp usd usp' ;
                leaf interface {
                  description 'The name of interface associated with slice End.X SID.' ;
                  type ncd:ifname ;

                }

                leaf slice-id {
                  description 'The slice ID of slice End.X SID.' ;
                  type uint32 {
                    range 1..65535 ;

                  }

                }

                leaf nexthop {
                  description 'Nexthop of slice END.X SID.' ;
                  type ncd:ipv6-address-none-zero ;

                }

                leaf compress {
                  description 'The compression attribute of slice End.X SID.Use enable to enable its compression attribute. Use disable to disable its compression attribute.' ;
                  type enumeration {
                    enum enable {
                      value 1 ;
                    }

                    enum disable {
                      value 0 ;
                    }

                  }

                }

                leaf encapsulation-type {
                  description 'The encapsulation type attribute of slice End.X SID.Options: uet-32 and uet-128.' ;
                  type enumeration {
                    enum uet-32 {
                      value 1 ;
                    }

                    enum uet-128 {
                      value 0 ;
                    }

                  }

                }

                leaf psp {
                  description 'The PSP attribute of slice End.X SID.Use enable to specify the flavor be with the PSP flag. Use disable to clear the PSP flag.' ;
                  type enumeration {
                    enum enable {
                      value 1 ;
                    }

                    enum disable {
                      value 0 ;
                    }

                  }

                }

                leaf usd {
                  description 'The USD attribute of slice End.X SID.Use enable to specify the flavor be with the USD flag. Use disable to clear the USD flag.' ;
                  type enumeration {
                    enum enable {
                      value 1 ;
                    }

                    enum disable {
                      value 0 ;
                    }

                  }

                }

                leaf usp {
                  description 'The USP attribute of slice End.X SID.Use enable to specify the flavor be with the USP flag. Use disable to clear the USP flag.' ;
                  type enumeration {
                    enum enable {
                      value 1 ;
                    }

                    enum disable {
                      value 0 ;
                    }

                  }

                }

              }

            }

            ncd:revise-date 2022-08-06 ;
          }

          container end-x-sids {
            description 'Configuration node of SRv6 End.X SID.' ;
            container static-end-x-sids {
              description 'Configuration node of the static SRv6 End.X SID.' ;
              list static-end-x-sid {
                description 'Configuration node of the static SRv6 End.X SID.' ;
                key 'func-code compress' ;
                leaf compress {
                  description 'The compression attribute of End.X SID.Use enable to enable its compression attribute. Use disable to disable its compression attribute.' ;
                  type enumeration {
                    enum enable {
                      value 1 ;
                    }

                    enum disable {
                      value 0 ;
                    }

                  }

                }

                leaf func-code {
                  description 'Function scope of End.X SID.' ;
                  type ncd:std-ipv6-address ;

                }

                leaf interface {
                  description 'The name of interface associated with End.X SID.' ;
                  type ncd:ifname ;

                  mandatory true ;
                }

                leaf nexthop {
                  description 'Nexthop of END.X SID.' ;
                  type ncd:ipv6-address-none-zero ;

                  mandatory true ;
                }

                leaf encapsulation-type {
                  description 'The encapsulation type attribute of End.X SID.Options: uet-32 and uet-128.' ;
                  type enumeration {
                    enum uet-32 {
                      value 1 ;
                    }

                    enum uet-128 {
                      value 0 ;
                    }

                  }

                  mandatory true ;
                }

                leaf psp {
                  description 'The PSP attribute of End.X SID.Use enable to specify the flavor be with the PSP flag. Use disable to clear the PSP flag.' ;
                  type enumeration {
                    enum enable {
                      value 1 ;
                    }

                    enum disable {
                      value 0 ;
                    }

                  }

                  mandatory true ;
                }

                leaf usp {
                  description 'The USP attribute of End.X SID.Use enable to specify the flavor be with the USP flag. Use disable to clear the USP flag.' ;
                  type enumeration {
                    enum enable {
                      value 1 ;
                    }

                    enum disable {
                      value 0 ;
                    }

                  }

                  mandatory true ;
                }

                leaf usd {
                  description 'The USD attribute of End.X SID.Use enable to specify the flavor be with the USD flag. Use disable to clear the USD flag.' ;
                  type enumeration {
                    enum enable {
                      value 1 ;
                    }

                    enum disable {
                      value 0 ;
                    }

                  }

                  mandatory true ;
                }

              }

            }

            ncd:revise-date 2022-09-21 ;
          }

          container end-sids {
            description 'Configuration node of SRv6 End SID.' ;
            container static-end-sids {
              description 'Configuration node of the static SRv6 End SID.' ;
              list static-end-sid {
                description 'Configuration node of the static SRv6 End SID.' ;
                key 'func-code compress' ;
                leaf compress {
                  description 'The compression attribute of End SID.Use enable to enable its compression attribute. Use disable to disable its compression attribute.' ;
                  type enumeration {
                    enum enable {
                      value 1 ;
                    }

                    enum disable {
                      value 0 ;
                    }

                  }

                }

                leaf func-code {
                  description 'Function scope of End SID.' ;
                  type ncd:std-ipv6-address ;

                }

                leaf encapsulation-type {
                  description 'The encapsulation type attribute of End SID.Options: uet-32 and uet-128.' ;
                  type enumeration {
                    enum uet-32 {
                      value 1 ;
                    }

                    enum uet-128 {
                      value 0 ;
                    }

                  }

                  mandatory true ;
                }

                leaf psp {
                  description 'The PSP attribute of End SID.Use enable to specify the flavor be with the PSP flag. Use disable to clear the PSP flag.' ;
                  type enumeration {
                    enum enable {
                      value 1 ;
                    }

                    enum disable {
                      value 0 ;
                    }

                  }

                  mandatory true ;
                }

                leaf usp {
                  description 'The USP attribute of End SID.Use enable to specify the flavor be with the USP flag. Use disable to clear the USP flag.' ;
                  type enumeration {
                    enum enable {
                      value 1 ;
                    }

                    enum disable {
                      value 0 ;
                    }

                  }

                  mandatory true ;
                }

                leaf usd {
                  description 'The USD attribute of End SID.Use enable to specify the flavor be with the USD flag. Use disable to clear the USD flag.' ;
                  type enumeration {
                    enum enable {
                      value 1 ;
                    }

                    enum disable {
                      value 0 ;
                    }

                  }

                  mandatory true ;
                }

              }

            }

            ncd:revise-date 2022-09-21 ;
          }

        }

        ncd:revise-date 2020-06-06 ;
      }

      container adjacency {
        description 'SRv6 Adjacency configuration.' ;
        presence "Adjacency configuration" ;
        leaf sid-hold-time {
          description "SRv6 adjacency SID hold time in minutes.It's range is 0-20160.Its default value which is between <0>-<20160> and generally <30> ,depends on product specification.The actual default value of some products may be different from the default statement definition." ;
          type uint16 {
            range 0..20160 ;

          }

          default 30 ;
        }

        ncd:revise-date 2021-03-30 ;
      }

      container usid-locators {
        description 'The configuration of SRv6 uSID locator.' ;
        list usid-locator {
          description 'The configuration of SRv6 uSID locator.' ;
          key locator-name ;
          leaf locator-name {
            description "The uSID locator's name.The max length of locator-name is 31." ;
            type string {
              length 1..31 ;

            }

          }

          leaf fa-id {
            description "The node for SRv6 uSID locator's Flex-Algorithm identifier.It's range is 128-255." ;
            type uint32 {
              range 128..255 ;

            }

          }

          leaf anycast {
            type boolean ;

            description "Configure this locator's anycast attribute.True means configure the locator to be anycast,and false means not." ;
            default false ;
            ncd:revise-date 2024-03-25 ;
          }

          leaf terminate-local-usid-lookup {
            type boolean ;

            description 'Configure the local uSID lookup termination property of the uSID locator. Setting it to "true" means configuring it for lookup termination, and setting it to "false" means disabling lookup termination.
' ;
            default false ;
            ncd:revise-date 2024-07-04 ;
          }

          container usid-ipv6-prefix {
            description "The configuration of SRv6 uSID locator's sid-range." ;
            presence locator-range ;
            leaf ipv6-prefix {
              description 'Specify the IPv6 prefix of uSID locator.' ;
              type ncd:ipv6-address-none-zero ;

              mandatory true ;
            }

            leaf ipv6-prefix-length {
              description 'Specify the length of prefix.In this version, this parameter can only be set to 48.' ;
              type ncd:ipv6-mask-length {
                range 48 ;

              }

              mandatory true ;
            }

            leaf block-length {
              description 'Specify the block length of uSID locator.In this version, this parameter can only be set to 32.' ;
              type uint8 {
                range 32 ;

              }

              mandatory true ;
            }

            leaf static-length {
              description 'Specify the static length of locator.In this version, this parameter can only be set to 1-12.' ;
              type uint8 {
                range 1..12 ;

              }

            }

            leaf args-length {
              description 'Specify the arguments length of locator.In this version, this parameter can only be set to 16.' ;
              type uint8 {
                range 16 ;

              }

            }

          }

          container flavor {
            description "The configuration of SRv6 uSID locator's flavor." ;
            leaf psp {
              description 'Configure the PSP flag of flavor.Use enable to specify the flavor be with the PSP flag. Use disable to clear the PSP flag. This function is enabled by default.' ;
              type enumeration {
                enum enable {
                  value 1 ;
                }

                enum disable {
                  value 0 ;
                }

              }

              default enable ;
            }

            leaf usd {
              description 'Specify the flavor of uSID locator with USD. Use enable to specify the flavor be with the USD flag. Use disable to clear the USD flag. This function is disabled by default.' ;
              type enumeration {
                enum enable {
                  value 1 ;
                }

                enum disable {
                  value 0 ;
                }

              }

              default disable ;
            }

            leaf usp {
              description 'Specify the flavor of uSID locator with USP. Use enable to specify the flavor be with the USP flag. Use disable to clear the USP flag. This function is disabled by default.' ;
              type enumeration {
                enum enable {
                  value 1 ;
                }

                enum disable {
                  value 0 ;
                }

              }

              default disable ;
            }

          }

        }

        ncd:revise-date 2022-02-10 ;
      }

      ncd:revise-date 2020-02-16 ;
    }

    container sr-policys {
      description 'The configuration node of SR-policy.' ;
      presence end-point ;
      container ipv4 {
        description 'The ipv4 node of SR-policy.' ;
        container binding-sids {
          list binding-sid {
            description "The configuration of SR-policy's binding-SID." ;
            key 'color end-point-ipv4' ;
            leaf color {
              description 'The color of SR-policy.' ;
              type uint32 {
                range 1..4294967295 ;

              }

            }

            leaf end-point-ipv4 {
              description 'Specify the IPv4 address at the end-point end.' ;
              type ncd:ipv4-address-none-zero ;

            }

            choice label {
              description 'Choose the type of assigning binding SID.
sid: Specify the SID value.
auto: Assign the SID automatically.' ;
              case sid {
                description 'Specify the SID value case.' ;
                leaf sid {
                  description "The SID of SR-policy's binding-SID." ;
                  type uint32 {
                    range 16..1048575 ;

                  }

                  mandatory true ;
                }

              }

              case auto {
                description 'Assign SID automatically case.' ;
                leaf auto {
                  description 'Assign SID automatically.' ;
                  type enumeration {
                    enum auto {
                      value 1 ;
                    }

                  }

                  mandatory true ;
                }

              }

            }

          }

        }

      }

      container ipv6 {
        description 'The ipv6 node of SR-policy.' ;
        container binding-sids {
          list binding-sid {
            description "The configuration of SR-policy's binding-SID." ;
            key 'color end-point-ipv6' ;
            leaf color {
              description 'The color of SR-policy.' ;
              type uint32 {
                range 1..4294967295 ;

              }

            }

            leaf end-point-ipv6 {
              description 'Specify the IPv6 address at the end-point end.' ;
              type ncd:ipv6-address-none-zero ;

            }

            choice label {
              description 'Choose the type of assigning binding SID.
sid: Specify the SID value.
auto: Assign the SID automatically.' ;
              case sid {
                description 'Specify the SID value case.' ;
                leaf sid {
                  description "The SID of SR-policy's binding-SID." ;
                  type uint32 {
                    range 16..1048575 ;

                  }

                  mandatory true ;
                }

              }

              case auto {
                description 'Assign SID automatically case.' ;
                leaf auto {
                  description 'Assign SID automatically.' ;
                  type enumeration {
                    enum auto {
                      value 1 ;
                    }

                  }

                  mandatory true ;
                }

              }

            }

          }

        }

      }

      ncd:revise-date 2020-05-19 ;
    }

    container sr-epes {
      description 'The configuration node of SR EPE.' ;
      container ipv4-peer-sids {
        description "The IPv4 node of SR EPE's peer node." ;
        list ipv4-peer-sid {
          description "The configuration node of SR EPE's IPv4 peer node." ;
          key ipv4-address ;
          leaf ipv4-address {
            description 'The IPv4 address of peer node.' ;
            type ncd:ipv4-address-none-zero ;

          }

          leaf sid {
            description "The SID of SR EPE's peer node." ;
            type uint32 {
              range 16..1048575 ;

            }

          }

        }

      }

      container ipv6-peer-sids {
        description "The IPv6 node of SR EPE's peer node." ;
        list ipv6-peer-sid {
          description "The configuration node of SR EPE's IPv6 peer node." ;
          key ipv6-address ;
          leaf ipv6-address {
            description 'The IPv6 address of peer node.' ;
            type ncd:ipv6-address-none-zero ;

          }

          leaf sid {
            description "The SID of SR EPE's peer node." ;
            type uint32 {
              range 16..1048575 ;

            }

          }

        }

      }

      container peer-set-sids {
        description 'The peer set node of SR EPE.' ;
        list peer-set-sid {
          description "The configuration node of SR EPE's peer set." ;
          key name ;
          leaf name {
            description "The peer set's name.The max length of name is 31." ;
            type ncd:string-all ;

          }

          leaf sid {
            description "The SID of SR EPE's peer set." ;
            type uint32 {
              range 16..1048575 ;

            }

          }

        }

      }

      ncd:revise-date 2020-06-20 ;
    }

    container adj-sid-holdtime {
      description "The configuration node  of SR dynamic adjacency-SID's holdtime." ;
      leaf holdtime {
        description "Holdtime in minutes.It's range is 1-10080,and default value is 30." ;
        type uint32 {
          range 0..20160 ;

        }

        default 30 ;
      }

      ncd:revise-date 2020-08-18 ;
    }

    container service-programmings {
      if-feature service-program ;

      description 'Service programmings container.' ;
      list service-programming {
        description 'Service programming list.' ;
        key name ;
        leaf name {
          description 'Service programming name to identify a specific function.' ;
          type string {
            length 1..31 ;

          }

        }

        leaf service-type {
          description 'Service-Type defined by IANA Service Type Table (STT). Like Firewall, DPI etc...' ;
          type SERVICE-FUNCTION-TYPE ;

        }

        container pair-sid {
          description 'Service pair SID container.' ;
          container srv6 {
            description 'SRv6 Service pair SID container.' ;
            presence sid ;
            leaf sid {
              description 'SRv6 SID value.' ;
              type ncd:ipv6-address ;

              mandatory true ;
            }

          }

        }

        container binding-sid {
          description 'Service SID binding container.' ;
          container srv6 {
            description 'SRv6 Service SID binding container.' ;
            presence srv6-sid-locator ;
            leaf sid {
              description 'Function scope of SRv6 SID.' ;
              type ncd:ipv6-address ;

              mandatory true ;
            }

            leaf locator-name {
              description "Locator's name." ;
              type string ;

              mandatory true ;
            }

          }

        }

        container service-proxy {
          description 'Service Proxy for SR unaware services.' ;
          container static-proxys {
            description 'Parameters related to static service proxy.' ;
            presence proxy ;
            list static-proxy {
              description 'Static proxy list.' ;
              key id ;
              leaf id {
                description 'The ID of this static proxy.' ;
                type uint32 {
                  range 1..65535 ;

                }

              }

              leaf priority {
                description 'Output priority of this static proxy.' ;
                type uint32 {
                  range 1..65535 ;

                }

                mandatory true ;
              }

              container proxy-info {
                description 'Static proxy base info.' ;
                presence proxy-info ;
                leaf inner-packet-type {
                  description 'Defines the expected inner packet type. The value can be "IPv4","IPv6", or "Ethernet".' ;
                  type SERVICE-PROXY-INNER-PKT-TYPE ;

                  mandatory true ;
                }

                choice next-hop {
                  description 'Choose the type of next-hop.' ;
                  mandatory true ;
                  case ipv4 {
                    description 'Specify the IPv4 nexthop.' ;
                    leaf next-hop-ipv4 {
                      description 'Nexthop IPv4 address.' ;
                      type ncd:ipv4-address ;

                      mandatory true ;
                    }

                  }

                  case ipv6 {
                    description 'Specify the IPv6 nexthop.' ;
                    leaf next-hop-ipv6 {
                      description 'Nexthop IPv6 address.' ;
                      type ncd:ipv6-address ;

                      mandatory true ;
                    }

                  }

                }

                leaf out-interface-name {
                  description 'Interface name on which the packet sent to the service endpoint.' ;
                  type ncd:ifname ;

                  mandatory true ;
                }

                leaf in-interface-name {
                  description 'Interface name on which the packet received from the service endpoint.' ;
                  type ncd:ifname ;

                  mandatory true ;
                }

              }

              container packet-cache-info {
                description 'SR information to be attached on the traffic coming back from the service.' ;
                container srv6-packet-cache-info {
                  description 'SRv6 SID stack.' ;
                  container source-address {
                    description 'IPv6 source address that needs in the case if SRv6.' ;
                    leaf ipv6-source-address {
                      description 'IPv6 source address that needs in the case if SRv6.' ;
                      type ncd:ipv6-address ;

                    }

                  }

                  container srv6-sids {
                    description 'SRv6 SID list.' ;
                    presence srv6-sid ;
                    list srv6-sid {
                      description 'SRv6 SID list.' ;
                      key index ;
                      leaf index {
                        description 'Cache index. Its range is 1 to 11.' ;
                        type uint8 {
                          range 1..11 ;

                        }

                      }

                      leaf srv6-sid {
                        description 'SRv6 SID.' ;
                        type ncd:ipv6-address ;

                        mandatory true ;
                      }

                    }

                  }

                }

              }

            }

          }

        }

      }

      ncd:revise-date 2021-09-18 ;
    }

    container if-prefix-sids {
      status deprecated ;

      if-feature if-prefix-sid ;

      list if-prefix-sid {
        status deprecated ;

        key 'interface-name af-type protocol instance-id' ;
        leaf interface-name {
          status deprecated ;

          description 'Loopback interface name.' ;
          type ncd:ifname {
            length 1..31 ;

          }

        }

        leaf af-type {
          status deprecated ;

          description 'The address-family.' ;
          type enumeration {
            enum ipv4 {
              value 1 ;
              description 'IPv4' ;
            }

            enum ipv6 {
              value 2 ;
              description 'IPv6' ;
            }

          }

        }

        leaf protocol {
          status deprecated ;

          description 'The type of protocol.' ;
          type enumeration {
            enum isis {
              value 1 ;
              description 'ISIS' ;
            }

          }

        }

        leaf instance-id {
          status deprecated ;

          description 'The instance ID of protocol.' ;
          type uint32 {
            range 0..4294967295 ;

          }

        }

        leaf type {
          status deprecated ;

          description 'The type of SID.' ;
          type enumeration {
            enum index {
              value 2 ;
              description 'Index SID' ;
            }

          }

          mandatory true ;
        }

        leaf index-id {
          status deprecated ;

          description 'Index SID.' ;
          type uint32 {
            range 0..1048560 ;

          }

          mandatory true ;
        }

      }

      ncd:revise-date 2021-12-20 ;
    }

    container srv6-sid-alarm-threshold {
      description 'SRv6 alarm threshold configuration.' ;
      presence "Alarm threshold configuration" ;
      leaf occur-value {
        description 'The value of SRv6 SID alarm occur threshold.' ;
        type uint8 {
          range 1..100 ;

        }

        mandatory true ;
      }

      leaf clear-value {
        description 'The value of SRv6 SID alarm clear threshold.' ;
        type uint8 {
          range 1..100 ;

        }

        default 72 ;
      }

      ncd:revise-date 2023-12-19 ;
    }

  }

  container state {
    config false ;
    description 'The query node for segment-routing information.' ;
    container ipv4 {
      description 'The query node for IPv4 segment-routing information.' ;
      container global-status {
        description 'The query node for segment-routing global status information.' ;
        leaf status {
          description 'The query node for segment-routing global status information.' ;
          type GLOBAL-STATUS ;

          default ENABLE ;
        }

      }

      container adjacency-sid {
        status obsolete {
          ncd:revise-date 2020-04-18 ;
        }

        description 'The query node for segment-routing adjacency SID information.' ;
        list information {
          status deprecated ;

          description 'Segment-routing adjacency SID information.' ;
          key 'type local-router-id local-ip remote-router-id remote-ip sid-index' ;
          leaf type {
            description 'The type of adjacency SID.' ;
            type ADJ-TYPE ;

          }

          leaf local-router-id {
            description 'The local router ID.' ;
            type ncd:ipv4-address ;

          }

          leaf local-ip {
            description 'The local IP address.' ;
            type ncd:ipv4-address ;

          }

          leaf remote-router-id {
            description 'The remote router ID.' ;
            type ncd:ipv4-address ;

          }

          leaf remote-ip {
            description 'The remote IP address.' ;
            type ncd:ipv4-address ;

          }

          leaf sid-index {
            description 'The SID index in IP-pair.' ;
            type uint32 {
              range 0..4294967295 ;

            }

          }

          leaf sid-label {
            description 'The label of adjacency SID.' ;
            type uint32 {
              range 0..4294967295 ;

            }

          }

          leaf weight {
            description 'The weight of adjacency SID.' ;
            type uint32 {
              range 0..4294967295 ;

            }

          }

          leaf local-id {
            status obsolete {
              ncd:revise-date 2019-09-07 ;
            }

            description 'The local ID.' ;
            type uint32 ;

            ncd:revise-date 2019-06-10 ;
          }

          leaf remote-id {
            status obsolete {
              ncd:revise-date 2019-09-07 ;
            }

            description 'The remote ID.' ;
            type int32 ;

            ncd:revise-date 2019-06-10 ;
          }

          leaf local-interface {
            status obsolete {
              ncd:revise-date 2019-09-07 ;
            }

            description 'The local interface.' ;
            type ncd:string-all ;

            ncd:revise-date 2019-06-10 ;
          }

          ncd:select type ;
          ncd:select "type local-router-id local-ip remote-router-id remote-ip" ;
        }

      }

      container local-prefix-sid {
        description 'The query node for segment-routing local prefix SID information.' ;
        list information {
          description 'Segment-routing local prefix SID information.' ;
          key 'dest-addr mask-addr' ;
          leaf dest-addr {
            description 'The destination address of local prefix sid.' ;
            type ncd:ipv4-address ;

          }

          leaf mask-addr {
            description 'The mask address of local prefix sid.' ;
            type ncd:ipv4-address ;

          }

          leaf index {
            description 'The index value of local prefix sid.' ;
            type uint32 {
              range 0..4294967295 ;

            }

            default 0 ;
          }

          leaf node-flag {
            description 'The node-flag of local prefix sid.' ;
            type LOCAL-PREFIX-NODE-FLAG ;

            default FALSE ;
          }

          leaf php-flag {
            description 'The label operation of penultimate hop.' ;
            type LOCAL-PREFIX-PHP-FLAG ;

            default NULL ;
          }

          leaf aii {
            if-feature network-slice ;

            description 'The segment-routing slice identifier.' ;
            type uint32 {
              range 0..4294967295 ;

            }

            default 0 ;
            ncd:revise-date 2019-11-15 ;
          }

          leaf fa-id {
            description 'The node for segment-routing Flex-Algorithm identifier.' ;
            type uint32 {
              range 0..255 ;

            }

            ncd:revise-date 2019-11-15 ;
          }

          ncd:select "dest-addr mask-addr" ;
          ncd:select aii ;
          ncd:select fa-id ;
          ncd:select "dest-addr mask-addr aii" ;
          ncd:select "dest-addr mask-addr fa-id" ;
        }

      }

      container remote-prefix-sid {
        description 'The query node for segment-routing remote prefix SID information.' ;
        list information {
          description 'Segment-routing remote prefix SID information.' ;
          key 'dest-addr mask-addr nexthop-index' ;
          leaf dest-addr {
            description 'The destination address of remote prefix sid.' ;
            type ncd:ipv4-address ;

          }

          leaf mask-addr {
            description 'The mask address of remote prefix sid.' ;
            type ncd:ipv4-address ;

          }

          leaf nexthop-index {
            description 'The index value of nexthop.' ;
            type uint32 {
              range 0..4294967295 ;

            }

          }

          leaf prefix-sid {
            description 'The index value of remote prefix sid.' ;
            type uint32 {
              range 0..4294967295 ;

            }

            default 0 ;
          }

          leaf prefix-flag {
            description 'The flag of remote prefix sid flag.' ;
            type REMOTE-PREFIX-FLAG ;

            default NULL ;
          }

          leaf router-id {
            description 'The router ID.' ;
            type ncd:ipv4-address ;

          }

          leaf nexthop {
            description 'The nexthop address of remote prefix sid.' ;
            type ncd:ipv4-address ;

          }

          leaf nexthop-sid {
            description 'The sid value of nexthop.' ;
            type uint32 {
              range 0..4294967295 ;

            }

            default 0 ;
          }

          leaf nexthop-flag {
            description 'The flag of nexthop sid flag.' ;
            type REMOTE-PREFIX-FLAG ;

            default NULL ;
          }

          leaf aii {
            if-feature network-slice ;

            description 'The segment-routing slice identifier.' ;
            type uint32 {
              range 0..4294967295 ;

            }

            default 0 ;
            ncd:revise-date 2019-11-15 ;
          }

          leaf fa-id {
            description 'The node for segment-routing Flex-Algorithm identifier.' ;
            type uint32 {
              range 0..255 ;

            }

            default 0 ;
            ncd:revise-date 2019-11-15 ;
          }

          ncd:select "dest-addr mask-addr" ;
          ncd:select aii ;
          ncd:select fa-id ;
          ncd:select "dest-addr mask-addr aii" ;
          ncd:select "dest-addr mask-addr fa-id" ;
        }

      }

