            default NULL ;
          }

          ncd:select "prefix prefix-length" ;
        }

      }

      container remote-prefix-sid {
        description 'The query node for segment-routing remote prefix SID information.' ;
        list information {
          description 'Segment-routing remote prefix SID information.' ;
