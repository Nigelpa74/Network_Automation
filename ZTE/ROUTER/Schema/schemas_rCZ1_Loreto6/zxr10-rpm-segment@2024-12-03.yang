            description 'The start label.' ;
            type uint32 {
              range 0..4294967295 ;

            }

            default 0 ;
          }

          leaf label-end {
            description 'The end label.' ;
            type uint32 {
              range 0..4294967295 ;

            }

            default 0 ;
          }

        }

