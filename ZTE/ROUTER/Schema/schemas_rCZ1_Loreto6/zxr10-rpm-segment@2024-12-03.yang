          leaf prefix {
            description 'The destination address of remote prefix sid.' ;
            type ncd:ipv6-address ;

          }

          leaf prefix-length {
            description 'The prefix length of remote prefix sid.' ;
            type uint8 {
              range 0..128 ;

            }

          }

          leaf nexthop-index {
            description 'The index value of nexthop.' ;
            type uint32 {
              range 0..4294967295 ;

            }

          }

          leaf prefix-sid {
            description 'The index value of remote prefix sid.' ;
            type uint32 {
              range 0..4294967295 ;

            }

            default 0 ;
          }

          leaf prefix-flag {
            description 'The flag of remote prefix sid flag.' ;
            type REMOTE-PREFIX-FLAG ;

            default NULL ;
          }

          leaf router-id {
            status obsolete {
              ncd:revise-date 2019-05-31 ;
            }

            description 'The router ID.' ;
            type ncd:ipv4-address ;

          }

          leaf nexthop {
            description 'The nexthop address of remote prefix sid.' ;
            type ncd:ipv6-address ;

          }

          leaf nexthop-sid {
            description 'The sid value of nexthop.' ;
            type uint32 {
              range 0..4294967295 ;

            }

            default 0 ;
          }

          leaf nexthop-flag {
            description 'The flag of nexthop sid flag.' ;
            type REMOTE-PREFIX-FLAG ;

            default NULL ;
          }

          leaf router-id-str {
            description 'The router ID.' ;
            type string ;

            ncd:revise-date 2019-05-31 ;
          }

          ncd:select "prefix prefix-length" ;
        }

      }

      container prefix-sid-map {
        if-feature mapping-server ;

        description 'The query node for segment-routing mapping-server ipv6 prefix-sid-map information.' ;
        list information {
          description 'Segment-routing mapping-server ipv6 prefix-sid-map information.' ;
          key 'first-prefix first-prefix-len' ;
          leaf first-prefix {
            description 'The destination address of the first prefix sid.' ;
            type ncd:ipv6-address ;

          }

          leaf first-prefix-len {
            description 'The prefix length of the first prefix sid.' ;
            type uint8 {
              range 1..128 ;

            }

          }

          leaf first-sid {
            description 'The sid value of the first prefix sid.' ;
            type uint32 {
              range 0..4294967295 ;

            }

            default 0 ;
          }

          leaf range {
            description 'The quantity of maps of prefix and sid.' ;
            type uint32 {
              range 1..65535 ;

            }

          }

          leaf last-prefix {
            description 'The destination address of the last prefix sid.' ;
            type ncd:ipv6-address ;

          }

          leaf last-prefix-len {
            description 'The prefix length of the last prefix sid.' ;
            type uint8 {
              range 1..128 ;

            }

          }

          leaf last-sid {
            description 'The sid value of the last prefix sid.' ;
            type uint32 {
              range 0..4294967295 ;

            }

            default 0 ;
          }

        }

        ncd:revise-date 2018-09-19 ;
