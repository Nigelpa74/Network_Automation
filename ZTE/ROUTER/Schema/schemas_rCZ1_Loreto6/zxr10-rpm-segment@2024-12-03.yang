          leaf type {
            description 'The type of adjacency SID.' ;
            type ADJ-TYPE ;

          }

          leaf local-router-id {
            description 'The local router ID.' ;
            type ncd:ipv6-address ;

          }

          leaf local-ipv6 {
            description 'The local IPv6 address.' ;
            type ncd:ipv6-address ;

          }

          leaf remote-router-id {
            description 'The remote router ID.' ;
            type ncd:ipv6-address ;

          }

          leaf remote-ipv6 {
            description 'The remote IPv6 address.' ;
            type ncd:ipv6-address ;

          }

          leaf sid-index {
            description 'The SID index in IP-pair.' ;
            type uint32 {
              range 0..4294967295 ;

            }

          }

          leaf sid-label {
            description 'The label of adjacency SID.' ;
            type uint32 {
              range 0..4294967295 ;

            }

          }

          leaf weight {
            description 'The weight of adjacency SID.' ;
            type uint32 {
              range 0..4294967295 ;

            }

          }

          leaf local-id {
            description 'The local ID.' ;
            type uint32 ;

          }

          leaf remote-id {
            description 'The remote ID.' ;
            type int32 ;

          }

          leaf local-interface {
            description 'The local interface.' ;
            type ncd:string-all ;

          }

          ncd:select type ;
          ncd:select "type local-router-id local-ipv6 remote-router-id remote-ipv6" ;
          ncd:select "type local-router-id remote-router-id local-id remote-id" ;
        }

        ncd:revise-date 2019-09-07 ;
      }

      ncd:revise-date 2017-08-21 ;
    }

    container srv6 {
      leaf global-status {
        description 'Show the SRv6 global switch status.' ;
        type GLOBAL-STATUS ;

      }

      container srv6-sids {
        status obsolete {
          ncd:revise-date 2020-09-22 ;
        }

        description 'The SRv6 SID information.' ;
        list srv6-sid {
          key type ;
          leaf type {
            description 'The type of SRv6 SID (local or remote).' ;
            type enumeration {
              enum local {
                value 1 ;
              }

              enum remote {
                value 2 ;
              }

            }

          }

          leaf sid-prefix {
            description 'The prefix of SID.' ;
            type ncd:ipv6-prefix ;

          }

          leaf sid-length {
            description 'The prefix length of SID.' ;
            type ncd:ipv6-mask-length ;

          }

          leaf function-type {
            description 'Function type of SID.' ;
            type string ;

          }

          leaf flavor {
            description 'Flavor of SID.' ;
            type string ;

          }

          leaf nexthop {
            description 'Nexthop address.' ;
            type ncd:ipv6-address ;

          }

          leaf interface {
            description 'Output interface.' ;
            type string ;

          }

        }

      }

      container srv6-sid-range {
        status obsolete {
          ncd:revise-date 2020-06-06 ;
        }

        description 'The SRv6 SID range information.' ;
        list sid-range {
          key type ;
          leaf type {
            description 'The type of SID range.' ;
            type string ;

          }

          leaf range-prefix {
            description 'The SID range.' ;
            type ncd:ipv6-prefix ;

          }

        }

      }

      container locators {
        description 'The SRv6 locator information.' ;
        list locator {
          description 'The SRv6 locator information.' ;
          key locator-name ;
          leaf locator-name {
            description "The locator's name.The max length of locator-name is 31." ;
            type string ;

          }

          leaf range-prefix {
            description 'The locator SID range.' ;
            type ncd:ipv6-prefix ;

          }

          leaf is-default {
            status obsolete {
              ncd:revise-date 2020-07-25 ;
            }

            description "The locator's default attribute." ;
            type boolean ;

          }

          leaf static-length {
            description "The locator's static opcode length." ;
            type uint8 ;

          }

          leaf auto-sid-begin {
            description "The begin of the locator's auto SID range." ;
            type string ;

          }

          leaf auto-sid-end {
            description "The end of the locator's auto SID range." ;
            type string ;

          }

          leaf args-length {
            description "The locator's arguments opcode length." ;
            type uint8 ;

          }

          leaf compress-target {
            description "The locator's compress target." ;
            type uint8 ;

          }

          leaf block-length {
            description "The locator's compress block length." ;
            type uint8 ;

          }

          leaf node-length {
            description "The locator's compress node length." ;
            type uint8 ;

          }

          leaf function-length {
            description "The locator's compress function length." ;
            type uint8 ;

          }

          leaf fa-id {
            description "The node for SRv6 locator's Flex-Algorithm identifier." ;
            type uint32 ;

            ncd:revise-date 2020-09-06 ;
          }

          leaf dynamic-length {
            description "The locator's dynamic opcode length. The length is calculated by static length,and cannot represent the actual number of dynamic SID resources." ;
            type uint8 {
              range 0..128 ;

            }

            ncd:revise-date 2021-06-17 ;
          }

          leaf reserved-start {
            description 'Specify the start of reserved opcode.' ;
            type string {
              length 0..40 ;

            }

            ncd:revise-date 2021-06-17 ;
          }

          leaf reserved-count {
            description 'Specify the count of reserved opcode.' ;
            type uint32 {
              range 0..4294967295 ;

            }

            ncd:revise-date 2021-06-17 ;
          }

          leaf block-length-normal {
            description "The locator's block length." ;
            type uint8 {
              range 0..128 ;

            }

            ncd:revise-date 2021-07-26 ;
          }

          leaf node-length-normal {
            description "The locator's node length." ;
            type uint8 {
              range 0..128 ;

            }

            ncd:revise-date 2021-07-26 ;
          }

          leaf function-length-normal {
            description "The locator's function length." ;
            type uint8 {
              range 0..128 ;

            }

            ncd:revise-date 2021-07-26 ;
          }

          leaf static-length-compress {
            description "The locator's compressed static opcode length." ;
            type uint8 {
              range 0..32 ;

            }

            ncd:revise-date 2022-03-09 ;
          }

          leaf auto-sid-begin-compress {
            description "The begin of the locator's compressed auto SID range." ;
            type string ;

            ncd:revise-date 2022-03-09 ;
          }

          leaf auto-sid-end-compress {
            description "The end of the locator's auto SID range." ;
            type string ;

            ncd:revise-date 2022-03-09 ;
          }

          leaf anycast {
            type boolean ;

            description "The locator's anycast attribute." ;
            ncd:revise-date 2024-03-25 ;
          }

        }

        ncd:revise-date 2020-06-06 ;
      }

      container local-sids {
        description 'The SRv6 local SID information.' ;
        list local-sid {
          description 'The SRv6 local SID information.' ;
          key sid ;
          leaf sid {
            description 'The SRv6 local SID.' ;
            type ncd:ipv6-prefix ;

          }

          leaf locator-name {
            description 'The locator name of SID.' ;
            type string ;

          }

          leaf vrf-name {
            description 'The vrf name of SID.' ;
            type ncd:string-quesiton-mark ;

          }

          leaf function-type {
            type SRV6-LOCAL-SID-FUNCTYPE ;

            status deprecated ;

            description 'Old version type of SID function. It is recommended that you view the value of “function-type-standard”.' ;

            ncd:revise-date 2023-11-03 ;
          }

          leaf owner {
            description 'Owner of SID.' ;
            type string ;

          }

          leaf block-length {
            description "The SID's block length." ;
            type uint8 ;

          }

          leaf node-length {
            description "The SID's node length." ;
            type uint8 ;

          }

          leaf function-length {
            description "The SID's function length." ;
            type uint8 ;

          }

          leaf flavor {
            description 'Flavor of SID.' ;
            type string ;

          }

          leaf nexthop {
            description 'Nexthop address for SID with single nexthop. If the SID has multiple nexthops, view them in the "multi-nexthops".' ;
            type string ;

          }

          leaf out-interface {
            description 'Output interface for SID with single nexthop. If the SID has multiple nexthops, view them in the "multi-nexthops".' ;
            type string ;

          }

          leaf color {
            description "The SID's color." ;
            type uint32 ;

          }

          leaf end-point {
            description "SID's end-point." ;
            type string ;

          }

          leaf vpls-name {
            description 'The VPLS name of SID.' ;
            type string ;

            ncd:revise-date 2020-10-29 ;
          }

          leaf fa-id {
            description "The node for SRv6 local SID's Flex-Algorithm identifier." ;
            type uint8 ;

            ncd:revise-date 2020-10-29 ;
          }

          leaf service-programming-name {
            description 'The service programming name of SID.' ;
            type string ;

            ncd:revise-date 2021-09-18 ;
          }

          leaf usid-length {
            description "The SID's uSID length." ;
            type uint8 ;

            ncd:revise-date 2022-02-10 ;
          }

          leaf slice-id {
            description 'The slice ID of slice End.X SID.' ;
            type uint32 ;

            ncd:revise-date 2022-08-06 ;
          }

          container multi-nexthops {
            description 'The multiple nexthops information of SRv6 local SID. If the SID has only single nexthop, view them in the leaf "local-sid/nexthop".' ;
            list multi-nexthop {
              description 'The multiple nexthops information of SRv6 local SID' ;
              key index ;
              leaf index {
                description 'Index of multiple nexthops.' ;
                type uint32 {
                  range 1..4294967295 ;

                }

              }

              leaf nexthop {
                description 'Nexthop address.' ;
                type ncd:ipv6-address ;

              }

              leaf out-interface {
                description 'Output interface.' ;
                type string ;

              }

            }

            ncd:revise-date 2023-01-13 ;
          }

          leaf l2-bundle-member {
            description 'Member of output interface for SID.' ;
            type string ;

            ncd:revise-date 2023-03-06 ;
          }

          leaf segment-list-id {
            type uint32 {
              range 0..4294967295 ;

            }

            description 'The segment list ID' ;
            ncd:revise-date 2023-07-17 ;
          }

          leaf function-type-standard {
            description 'The standard type of SRv6 SID function from RFCs.' ;
            type string ;

            ncd:revise-date 2023-11-03 ;
          }

          ncd:select locator-name ;
          ncd:select function-type ;
          ncd:select sid ;
          ncd:select fa-id ;
          ncd:select function-type-standard ;
        }

        ncd:revise-date 2020-09-22 ;
      }

      container local-sid-summary {
        status deprecated ;

        description 'Old querying of SRv6 local SID statistics. It is recommended that you view the value of “local-sid-statistics”.' ;
        leaf total {
          status deprecated ;

          description 'The total of all SRv6 local SID.' ;
          type uint32 ;

        }

        list statistics {
          status deprecated ;

          description 'The querying of SRv6 local SID statistics by function type.' ;
          key function-type ;
          leaf function-type {
            status deprecated ;

            description 'The function type of SRv6 local SID.' ;
            type SRV6-LOCAL-SID-FUNCTYPE ;

          }

          leaf count {
            status deprecated ;

            description 'The statistics of SRv6 local SID in special function type.' ;
            type uint32 ;

          }

        }

        ncd:revise-date 2023-11-03 ;
      }

      container usid-locators {
        description 'The SRv6 uSID locator information.' ;
        list usid-locator {
          description 'The SRv6 uSID locator information.' ;
          key locator-name ;
          leaf locator-name {
            description "The uSID locator's name.The max length of locator-name is 31." ;
            type string ;

          }

          leaf ipv6-prefix {
            description "The uSID locator's SID range." ;
            type ncd:ipv6-prefix ;

          }

          leaf block-length {
            description "The uSID locator's block length." ;
            type uint8 ;

          }

          leaf usid-length {
            description "The uSID locator's uSID length." ;
            type uint8 ;

          }

          leaf static-length {
            description "The uSID locator's static length." ;
            type uint8 ;

          }

          leaf args-length {
            description "The uSID locator's arguments length." ;
            type uint8 ;

          }

          leaf flavor {
            description "The uSID locator's flavor." ;
            type string {
              length 0..32 ;

            }

          }

          leaf fa-id {
            description "The node for SRv6 uSID locator's Flex-Algorithm identifier." ;
            type uint32 ;

          }

          leaf dynamic-sid-begin-1 {
            description "The begin of the uSID locator's dynamic SID range with highest byte E (hexa) ." ;
            type ncd:ipv6-prefix ;

          }

          leaf dynamic-sid-end-1 {
            description "The end of the uSID locator's dynamic SID range with highest byte E (hexa) ." ;
            type ncd:ipv6-prefix ;

          }

          leaf dynamic-sid-begin-2 {
            description "The begin of the uSID locator's dynamic SID range with highest byte F (hexa) ." ;
            type ncd:ipv6-prefix ;

          }

          leaf dynamic-sid-end-2 {
            description "The end of the uSID locator's dynamic SID range with highest byte F (hexa) ." ;
            type ncd:ipv6-prefix ;

          }

          leaf static-sid-begin-1 {
            description "The begin of the uSID locator's static SID range with highest byte E (hexa) ." ;
            type ncd:ipv6-prefix ;

          }

          leaf static-sid-end-1 {
            description "The end of the uSID locator's static SID range with highest byte E (hexa) ." ;
            type ncd:ipv6-prefix ;

          }

          leaf static-sid-begin-2 {
            description "The begin of the uSID locator's static SID range with highest byte F (hexa) ." ;
            type ncd:ipv6-prefix ;

          }

          leaf static-sid-end-2 {
            description "The end of the uSID locator's static SID range with highest byte F (hexa) ." ;
            type ncd:ipv6-prefix ;

          }

          leaf anycast {
            type boolean ;

            description "The locator's anycast attribute." ;
            ncd:revise-date 2024-03-25 ;
          }

          leaf lookup-termination {
            type boolean ;

            description "The locator's local-usid lookup termination attribute." ;
            ncd:revise-date 2024-07-04 ;
          }

        }

        ncd:revise-date 2022-02-10 ;
      }

      container slice-end-x-infos {
        if-feature slice-end-x ;

        description 'The SRv6 slice End.X information.' ;
        list slice-end-x-info {
          description 'The SRv6 slice End.X information.' ;
          key 'locator-name out-interface nexthop slice-id compress encapsulation-type psp usp usd' ;
          leaf locator-name {
            description "The locator's name." ;
            type string {
              length 1..31 ;

            }

          }

          leaf out-interface {
            description 'Interface name on which the packet sent to the slice End.X.' ;
            type string ;

          }

          leaf nexthop {
            description 'Nexthop address.' ;
            type ncd:ipv6-address ;

          }

          leaf slice-id {
            description 'Slice ID.' ;
            type uint32 {
              range 1..4294967295 ;

            }

          }

          leaf compress {
            description 'The compress attribute of slice End.X SID. When the value is enable, it means the SID has the compression attribute.' ;
            type enumeration {
              enum enable {
                value 1 ;
              }

              enum disable {
                value 0 ;
              }

            }

          }

          leaf encapsulation-type {
            description 'The encapsulation type attribute of Slice End.X SID.The value uet-32 indicates that the next SID is 32-bit compression.' ;
            type enumeration {
              enum uet-32 {
                value 1 ;
              }

              enum uet-128 {
                value 0 ;
              }

            }

          }

          leaf psp {
            description 'The PSP attribute of slice End.X SID.' ;
            type enumeration {
              enum enable {
                value 1 ;
              }

              enum disable {
                value 0 ;
              }

            }

          }

          leaf usp {
            description 'The USP attribute of slice End.X SID.' ;
            type enumeration {
              enum enable {
                value 1 ;
              }

              enum disable {
                value 0 ;
              }

            }

          }

          leaf usd {
            description 'The USD attribute of slice End.X SID.' ;
            type enumeration {
              enum enable {
                value 1 ;
              }

              enum disable {
                value 0 ;
              }

            }

          }

          leaf state {
            description 'The status of slice End.X. Value: valid or invalid.' ;
            type enumeration {
              enum valid {
                value 1 ;
              }

              enum invalid {
                value 0 ;
              }

            }

          }

          leaf sid {
            description 'The SRv6 local slice End.X SID.If the SID is not applied for, this node has no information.' ;
            type ncd:ipv6-prefix ;

          }

          leaf block-length {
            description "The SID's block length.If the SID is not applied for, this node has no information." ;
            type uint8 ;

          }

          leaf node-length {
            description "The SID's node length. If the SID is not applied for, this node has no information." ;
            type uint8 ;

          }

          leaf function-length {
            description "The SID's function length. If the SID is not applied for, this node has no information." ;
            type uint8 ;

          }

          leaf args-length {
            description "The locator's arguments opcode length. If the SID is not applied for, this node has no information." ;
            type uint8 ;

          }

          ncd:select "locator-name out-interface nexthop slice-id" ;
          ncd:select "locator-name out-interface nexthop slice-id compress encapsulation-type psp usp usd" ;
        }

        ncd:revise-date 2022-08-06 ;
      }

      container local-sid-statistics {
        leaf total {
          type uint32 ;

          description 'The total of all SRv6 local SID.' ;
        }

        list statistics {
          leaf function-type {
            description 'The type of local SRv6 SID function.' ;
            type string ;

          }

          leaf count {
            type uint32 ;

            description 'The statistics of local SRv6 SID in special function type.' ;
          }

          key function-type ;
          description 'The querying of SRv6 local SID statistics by function type.' ;
        }

        description 'The querying of local SRv6 SID statistics by function type.' ;
	
        ncd:revise-date 2023-11-03 ;
      }

      ncd:revise-date 2020-02-16 ;
    }

  }

}
