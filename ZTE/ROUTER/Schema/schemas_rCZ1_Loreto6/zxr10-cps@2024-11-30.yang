module zxr10-cps {
  namespace "http://www.zte.com.cn/zxr10/netconf/schema/rosng/cps" ;
  prefix cps ;
  import zxr10-netconf-defs {
    prefix ncd ;
    revision-date 2014-06-24 ;
  }

  organization "ZTE Corporation" ;
  contact "ZTE Corporation
  Nanjing Institute of ZTE Corporation
  No.68 Zijinghua Rd. Yuhuatai District, Nanjing, China
  Tel: +86-25-52870000" ;
  description 'The netconf module to describe CPS(control plane security).' ;
  revision 2024-11-30 {
    description 'To be recycled openflow-lldp for flowtype-name and flowtype-name-ex.
To be recycled openflow-arp for flowtype-name and flowtype-name-ex.
To be recycled openflow-dhcp for flowtype-name and flowtype-name-ex.
To be recycled openflow-bgp for flowtype-name and flowtype-name-ex.
To be recycled openflow-ospf for flowtype-name and flowtype-name-ex.
To be recycled openflow-icmp for flowtype-name and flowtype-name-ex.
Add group1-general-flow for flowtype-name and flowtype-name-ex.
Add group2-general-flow for flowtype-name and flowtype-name-ex.
Add group3-general-flow for flowtype-name and flowtype-name-ex.
Add group4-general-flow for flowtype-name and flowtype-name-ex.
Add group5-general-flow for flowtype-name and flowtype-name-ex.
Add group6-general-flow for flowtype-name and flowtype-name-ex.
Add group7-general-flow for flowtype-name and flowtype-name-ex.
Add group8-general-flow for flowtype-name and flowtype-name-ex.
Add miscellaneous for flowtype-name and flowtype-name-ex.' ;
  }

  revision 2024-04-15 {
    description 'Add container node:/configuration/cps/alarm-detect-cycle.
Add lead node:/configuration/cps/alarm-detect-cycle/generation.
Add lead node:/configuration/cps/alarm-detect-cycle/disappear.' ;
  }

  revision 2024-03-11 {
    description 'Add high-general-flow for flowtype-name and flowtype-name-ex.
Add low-general-flow for flowtype-name and flowtype-name-ex.' ;
  }

  revision 2024-02-28 {
    description 'Add roce-data for flowtype-name and flowtype-name-ex.' ;
  }

  revision 2024-01-22 {
    description 'Add l2pt for flowtype-name and flowtype-name-ex.' ;
  }

  revision 2023-07-31 {
    description 'Add ipox-forward-traffic for flowtype-name and flowtype-name-ex.' ;
  }

  revision 2023-06-08 {
    description 'Add mmrp for flowtype-name and flowtype-name-ex.' ;
  }

  revision 2023-04-12 {
    description 'Add twamp-tcp-config for flowtype-name and flowtype-name-ex.' ;
  }

  revision 2023-02-03 {
    description 'Add isis-dynamic-known for flowtype-name and flowtype-name-ex.' ;
  }

  revision 2022-08-11 {
    description 'Add lnof-default and lnof-config and lnof-known for flowtype-name and flowtype-name-ex.' ;
  }

  revision 2022-05-09 {
    description 'Add ftp-static-known for flowtype-name and flowtype-name-ex.' ;
  }

  revision 2022-04-15 {
    description 'Add telnet-config and ssh-config for flowtype-name and flowtype-name-ex.' ;
  }

  revision 2022-03-28 {
    description 'Add 61V5_1 for feature cps-router-cmd.
Add feature back-press-profile.
Add if-feature back-press-profile to /configuration/cps/flow/backpress-profiles and /configuration/cps/flow/apply-backpress-profile.' ;
  }

  revision 2021-12-17 {
    description 'Remove "SWITCH.5960X" from feature: cpu-statis,statistics-interval,interface-statistics.' ;
  }

  revision 2021-11-08 {
    description 'Add 15K for feature:defend-policy-feature,defend-policy-whitelist,defend-policy-blacklist.' ;
  }

  revision 2021-10-29 {
    description 'Change feature of /configuration/cps/ctm from "cps-router-cmd" to "ctm".
Change feature of /state/cps/ctm from "cps-router-cmd" to "ctm".
Change feature of /configuration/cps/mng-protocol-filters from "cps-cmd" to "mng-protocol-filters".
Change feature of /state/cps/mng-protocol-filters from "cps-cmd" to "mng-protocol-filters".
Change feature of /configuration/cps/global/cps-log from "cpu-statis" to "cps-log".' ;
  }

  revision 2021-09-27 {
    description 'Add leaf node:/state/cps/statistics/interface-statistics/peak-in-rate.
              /state/cps/statistics/interface-statistics/peak-time.
Add list node:/state/cps/statistics/interface-statistics-top.
Modify max of leaf node:/configuraion/cps/statistics-interval/interval from 120 to 300.
Add feature:interface-statistics.
Change if-feature of /state/cps/statistics/interface-statistics from "cps-cmd" to "interface-statistics".' ;
  }

  revision 2021-06-22 {
    description 'Add an enumeration value snmp-static-known for flowtype-name.
Add the performance parameter of the /configuration/cps/global/cps-log node.' ;
  }

  revision 2021-05-08 {
    description 'Add cps-cmd feature for 61v5_1.' ;
  }

  revision 2021-05-06 {
    description 'Add feature for /configuration/cps/mngport-filter and /state/cps/mngport-filter,remove 99x and 5960x.' ;
  }

  revision 2021-03-05 {
    description 'Add node:/configuration/cps/global/cps-log.
Add node:/configuration/cps/global/service-policy/policy-map-name.
Add node:/configuration/cps/service-policys/service-policy/if-name.
Add node:/configuration/cps/service-policys/service-policy/policy-map-name.
Add feature of cps-service-policy.' ;
  }

  revision 2021-03-04 {
    description 'Modify if-feature of statistics-interval,from cps-router-cmd to statistics-interval.' ;
  }

  revision 2020-12-07 {
    description 'Add an enumeration value pim-crp-known,gprc-known,gprc-default,telemetry-udp for flowtype-name.' ;
  }

  revision 2020-09-25 {
    description 'Add feature of defend-policy-whitelist.
Add feature of defend-policy-blacklist.' ;
  }

  revision 2020-04-14 {
    description 'Add node:/configuration/cps/mngport-ip-packets-forward.' ;
  }

  revision 2020-04-02 {
    description 'Add feature for cps statistics.' ;
  }

  revision 2020-01-09 {
    description 'Add an enumeration value uni-nd-known for flowtype-name.' ;
  }

  revision 2019-11-06 {
    description 'Add an enumeration value openflow for flowtype-name.
Add an enumeration value lldp and openflow for mng protocol.' ;
  }

  revision 2019-07-26 {
    description 'Add an enumeration value pim-low for flowtype-name.' ;
  }

  revision 2019-06-26 {
    description 'Add nodes of /configuration/cps/defend-policy.' ;
  }

  revision 2019-04-09 {
    description 'Add max value (Perf-code)for
/configuration/cps/flow/limits/limit/rate-imit
/configuration/cps/flow/limits/limit/quota-limit
/configuration/cps/flow/limit-profiles/limit-profile-item/rate-limit
/configuration/cps/flow/limit-profiles/limit-profile-item/quota-limit' ;
  }

  revision 2018-11-29 {
    description 'Add the lable for 5960.' ;
  }

  revision 2015-07-27 {
    description "clear state node's configuration flag." ;
  }

  revision 2015-07-15 {
    description 'add flowtype enumurations.' ;
  }

  revision 2015-05-26 {
    description 'modify sequence between backpress-profiles node & apply-backpress-profiles node.
modify sequence between limit-profiles node & apply-limit-profiles node.' ;
  }

  revision 2015-03-09 {
    description "modify ctm queue-depth & rate-limit destcpu leaf node's datatype from string to enum." ;
  }

  revision 2015-01-11 {
    description "split state cps statistics flow-statistics list into three lists:
    cpu-statistics,interface-statistics,summary-statistics.
    add interface-statistics leaf node:upsend-rate,which means upsend packet's rate
    inpacket-rate,which means total inpacket's rate.
    remove all cps nodes in state mode,except for statistics." ;
  }

  revision 2015-01-06 {
    description "modify operation cps clear flowtype statistics leaf's datatype to empty
    modify operation cps clear flowtype from list to container
    modify operation cps clear gtsm statistics leaf's datatype to empty
    modify operation cps clear gtsm from list to container
    modify state cps statistics flow-statistics summary leaf's datatype to empty" ;
  }

  revision 2015-01-05 {
    description 'modify logical cpu regexpression,fix 613003103671 probolem.' ;
  }

  revision 2014-07-22 {
    description 'Modify ctm queue & rate configuration and state,change destcpu type form string to enum.' ;
  }

  revision 2014-07-14 {
    description 'Add flowtype name:openflow-controller,openflow-normal,cps-log' ;
  }

  revision 2014-05-15 {
    description "Modify mngport-filter leaf node \"any\"'s range from 0~1 to 1~1." ;
  }

  revision 2014-04-25 {
    description 'Modify flowtype statistics summary range from 0-1 to 1-1.' ;
  }

  revision 2014-03-19 {
    description 'Split CTM queue list into 2 lists, make a distinction between up-priority and down-priority.
Split Mng-port mac ipv4/v6 into 2 lists, make a distinction between any item and specified item.
Split mng-protocol filter into 2 lists, make a distinction between global item and item configured under interface.' ;
  }

  revision 2014-03-06 {
    description 'Modify flow backpress item module,add mimaction to avoid database value problem.
Modify ctm rate module,split into up ctm-rate list and down ctm-rate list.' ;
  }

  revision 2014-01-26 {
    description 'Add new fLowtype enums and mng-protocol enums.
Modify mng port rate limit range from 0-10000 to 1-10000.
Modify flow limit interface filter number from 1712 to 504.
Add Quota limit range:0-85000.
Modify uint64 derived type.' ;
  }

  revision 2014-01-23 {
    description "Modify list:backpress-item  leaf:decline's range to 1-100." ;
  }

  revision 2013-10-11 {
    description 'Initial version.' ;
  }

  feature cps-router-cmd {
    description 'cps commands for router/ZSR/xGW.' ;
  }

  feature defend-policy-feature {
    description 'Feature for defend policy.' ;
  }

  feature cpu-statis {
    description 'Feature for cpu statistics.' ;
  }

  feature defend-policy-whitelist {
    description 'Feature for defend-policy-whitelist.' ;
  }

  feature defend-policy-blacklist {
    description 'Feature for defend-policy-blacklist.' ;
  }

  feature statistics-interval {
    description 'Feature for statistics-interval.' ;
  }

  feature cps-service-policy {
    description 'Feature for cps-service-policy.' ;
  }

  feature mngport-filter {
    description 'Feature for mngport-filter.' ;
  }

  feature cps-cmd {
    description 'feature cps-router-cmd plus 61v5-1.' ;
  }

  feature interface-statistics {
    description 'feature for interface statistics.' ;
  }

  feature ctm {
    description 'Feature for ctm configuration and state.' ;
  }

  feature mng-protocol-filters {
    description 'Feature for management protocol configuration and state.' ;
  }

  feature cps-log {
    description 'Feature for cps-log.' ;
  }

  feature back-press-profile {
    description 'back-press commands for router/ZSR/xGW.' ;
  }

