  typedef flowtype-name-ex {
    description 'Flowtype name enumeration.' ;
    type enumeration {
      enum default {
        value 0 ;
      }

      enum bgp-default {
        value 1 ;
      }

      enum bgp-config {
        value 2 ;
      }

      enum bgp-known {
        value 3 ;
      }

      enum ospf-default {
        value 4 ;
      }

      enum ospf-config {
        value 5 ;
      }

      enum ospf-known {
