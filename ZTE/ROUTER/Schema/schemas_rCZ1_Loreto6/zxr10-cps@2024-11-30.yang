  container configuration {
    description 'Configuration model info.' ;
    container cps {
      description 'Control plane security configuration' ;
      container flow {
        if-feature cps-cmd ;

        description 'Flowtype operation' ;
        container limits {
          description 'Flowtype limit configurations' ;
          list limit {
            description 'Flowtype limit configuration' ;
            key 'ifname flowtype' ;
            leaf ifname {
              description 'Interface name' ;
              type ncd:ifname ;

            }

            leaf flowtype {
              description 'Flowtype name' ;
              type flowtype-name ;

            }

            leaf rate-limit {
              description 'Rate limit value(pps:packet per second)' ;
              type uint32 {
                range 0..85000 {
                  description "It's toplimit depends on ability of the device." ;
                }

              }

              units pps ;
              mandatory true ;
            }

            leaf quota-limit {
              description 'Quota limit value(pps:packet per second)' ;
              type uint32 {
                range 0..85000 {
                  description "It's toplimit depends on ability of the device." ;
                }

              }

              units pps ;
              mandatory true ;
            }

          }

        }

        container limit-profiles {
          if-feature cps-router-cmd ;

          description 'Flowtype limit profile configurations' ;
          list limit-profile {
            description 'Flowtype limit profile configuration' ;
            key profile-num ;
            max-elements 16 ;
            leaf profile-num {
              description 'Profile number' ;
              type uint8 {
                range 1..16 ;

              }

            }

          }

          list limit-profile-item {
            description 'Flow limit profile item configuration' ;
            key 'profile-num flowtype' ;
            leaf profile-num {
              description 'Profile number' ;
              type uint8 {
                range 1..16 ;

              }

            }

            leaf flowtype {
              description 'Flowtype name' ;
              type flowtype-name ;

            }

            leaf rate-limit {
              description 'Rate limit value(pps:packet per second)' ;
              type uint32 {
                range 0..85000 {
                  description "It's toplimit depends on ability of the device." ;
                }

              }

              units pps ;
              mandatory true ;
            }

            leaf quota-limit {
              description 'Quota limit value(pps:packet per second)' ;
              type uint32 {
                range 0..85000 {
                  description "It's toplimit depends on ability of the device." ;
                }

              }

              units pps ;
              mandatory true ;
            }

          }

        }

        container apply-limit-profiles {
          if-feature cps-router-cmd ;

          description 'Apply flowtype limit profile configurations' ;
          list apply-limit-profile {
            description 'Apply flowtype limit profile configuration' ;
            key ifname ;
            leaf ifname {
              description 'Interface name' ;
              type ncd:ifname {
                length 0..32 ;

              }

            }

            leaf profile-num {
              description 'Profile number' ;
              type uint8 {
                range 1..16 ;

              }

              mandatory true ;
            }

          }

        }

        container backpress-profiles {
          if-feature cps-router-cmd ;

          if-feature back-press-profile ;

          description 'Flowtype backpress profile configurations' ;
          list backpress-profile {
            description 'Flowtype backpress profile configuration' ;
            key profile-num ;
            max-elements 16 ;
            leaf profile-num {
              description 'Profile number' ;
              type uint8 {
                range 1..16 ;

              }

            }

          }

          list backpress-item {
            description 'Flowtype backpress profile item configuration' ;
            key 'profile-num overshoot-percent' ;
            max-elements 5 ;
            leaf profile-num {
              description 'Profile number' ;
              type uint8 {
                range 1..16 ;

              }

            }

            leaf overshoot-percent {
              description 'Overshoot percent' ;
              type uint8 {
                range 1..100 ;

              }

            }

            choice supress-type {
              description 'Suppress type' ;
              mandatory true ;
              case restore {
                description 'Restore' ;
                leaf restore {
                  description 'Restore default rate limit operation' ;
                  type empty ;

                  mandatory true ;
                }

              }

              case decline {
                description 'Decline' ;
                leaf decline {
                  description 'Backpress decline percent' ;
                  type uint8 {
                    range 1..100 ;

                  }

                  mandatory true ;
                }

              }

              case suspend {
                description 'Suspend' ;
                leaf suspend {
                  description 'Suspend operation' ;
                  type empty ;

                  mandatory true ;
                }

              }

            }

          }

        }

        container apply-backpress-profiles {
          if-feature cps-router-cmd ;

          if-feature back-press-profile ;

          description 'Apply backpress profile configurations' ;
          list apply-backpress-profile {
            description 'Apply backpress profile configuration' ;
            key 'ifname flowtype' ;
            leaf ifname {
              description 'Interface name' ;
              type ncd:ifname ;

            }

            leaf flowtype {
              description 'Flowtype name' ;
              type flowtype-name ;

            }

            leaf profile-num {
              description 'Profile number' ;
              type uint8 {
                range 1..16 ;

              }

              mandatory true ;
            }

          }

        }

      }

      container ctm {
        if-feature ctm ;

        description 'Ctm configuration' ;
        container queue-depths {
          description 'Queue depth configurations' ;
          container up-queue-depths {
            description 'Up queue depth configurations' ;
            list up-queue-depth {
              description 'Up queue depth configuration' ;
              key 'destcpu ifname up-priority' ;
              leaf destcpu {
                description 'Destination CPU name' ;
                type enumeration {
                  enum r-cpu {
                    value 1 ;
                    description 'r-cpu' ;
                  }

                  enum l-cpu {
                    value 2 ;
                    description 'l-cpu' ;
                  }

                }

              }

              leaf ifname {
                description 'Interface name' ;
                type ncd:ifname ;

              }

              leaf up-priority {
                description 'Up priority' ;
                type uint8 {
                  range 0..7 ;

                }

              }

              leaf queue-depth {
                description 'Queue depth value' ;
                type enumeration {
                  enum high {
                    value 1 ;
                  }

                  enum middle {
                    value 2 ;
                  }

                  enum normal {
                    value 3 ;
                  }

                  enum low {
                    value 4 ;
                  }

                }

                mandatory true ;
              }

            }

          }

          container down-queue-depths {
            description 'Down queue depth configurations' ;
            list down-queue-depth {
              description 'Down queue depth configuration' ;
              key 'destcpu ifname down-priority' ;
              leaf destcpu {
                description 'Destination CPU name' ;
                type enumeration {
                  enum r-cpu {
                    value 1 ;
                    description 'r-cpu' ;
                  }

                  enum l-cpu {
                    value 2 ;
                    description 'l-cpu' ;
                  }

                }

              }

              leaf ifname {
                description 'Interface name' ;
                type ncd:ifname ;

              }

              leaf down-priority {
                description 'Down priority' ;
                type uint8 {
                  range 16..19 ;

                }

              }

              leaf queue-depth {
                description 'Queue depth value' ;
                type enumeration {
                  enum high {
                    value 1 ;
                  }

                  enum middle {
                    value 2 ;
                  }

                  enum normal {
                    value 3 ;
                  }

                  enum low {
                    value 4 ;
                  }

                }

                mandatory true ;
              }

            }

          }

        }

        container rate-limits {
          description 'Ctm rate limit configurations' ;
          container up-rate-limits {
            description 'Ctm up-rate limit configurations' ;
            list up-rate-limit {
              description 'Ctm up-rate limit configuration' ;
              key 'destcpu board' ;
              leaf destcpu {
                description 'Destination CPU name' ;
                type enumeration {
                  enum r-cpu {
                    value 1 ;
                    description 'r-cpu' ;
                  }

                  enum l-cpu {
                    value 2 ;
                    description 'l-cpu' ;
                  }

                }

              }

              leaf board {
                description 'Source board name' ;
                type ncd:board ;

              }

              leaf up-cir {
                description 'Up cir value' ;
                type uint32 {
                  range 0..600000 ;

                }

                units kbps ;
                mandatory true ;
              }

              leaf up-cbs {
                description 'Up cbs value' ;
                type uint32 {
                  range 0..256 ;

                }

                units KByte ;
                mandatory true ;
              }

              leaf up-eir {
                description 'Up eir value' ;
                type uint32 {
                  range 0..200000 ;

                }

                units kbps ;
                mandatory true ;
              }

            }

          }

          container down-rate-limits {
            description 'Ctm up-rate limit configurations' ;
            list down-rate-limit {
              description 'Ctm up-rate limit configuration' ;
              key 'destcpu board' ;
              leaf destcpu {
                description 'Destination CPU name' ;
                type enumeration {
                  enum r-cpu {
                    value 1 ;
                    description 'r-cpu' ;
                  }

                  enum l-cpu {
                    value 2 ;
                    description 'l-cpu' ;
                  }

                }

              }

              leaf board {
                description 'Source board name' ;
                type ncd:board ;

              }

              leaf down-cir {
                description 'Down cir value' ;
                type uint32 {
                  range 0..2000000 ;

                }

                units kbps ;
                mandatory true ;
              }

              leaf down-cbs {
                description 'Down cbs value' ;
                type uint32 {
                  range 0..256 ;

                }

                units KByte ;
                mandatory true ;
              }

              leaf down-eir {
                description 'Down eir value' ;
                type uint32 {
                  range 0..2000000 ;

                }

                units kbps ;
                mandatory true ;
              }

            }

          }

        }

      }

      container mng-protocol-filters {
        if-feature mng-protocol-filters ;

        description 'Management protocol filter configurations' ;
        container mng-protocol-global-filter {
          description 'Management protocol filter configurations' ;
          list mng-protocol-filter {
            description 'Management protocol filter configuration' ;
            key mng-protocol ;
            leaf mng-protocol {
              description 'Management protocol type' ;
              type enumeration {
                enum telnet {
                  value 1 ;
                }

                enum ssh {
                  value 2 ;
                }

                enum ftp {
                  value 3 ;
                }

                enum snmp {
                  value 4 ;
                }

                enum http {
                  value 5 ;
                }

                enum ping {
                  value 6 ;
                }

                enum tftp {
                  value 7 ;
                }

              }

            }

            leaf permit-flag {
              description 'Permit or deny flag' ;
              type enumeration {
                enum permit {
                  value 1 ;
                }

                enum deny {
                  value 2 ;
                }

              }

              mandatory true ;
            }

          }

        }

        container mng-protocol-if-filters {
          description 'Management protocol interface filter configurations' ;
          list mng-protocol-if-filter {
            description 'Management protocol interface filter configuration' ;
            key 'ifname mng-protocol' ;
            leaf ifname {
              description 'Interface name' ;
              type ncd:ifname ;

            }

            leaf mng-protocol {
              description 'Management protocol type' ;
              type enumeration {
                enum telnet {
                  value 1 ;
                }

                enum ssh {
                  value 2 ;
                }

                enum ftp {
                  value 3 ;
                }

                enum snmp {
                  value 4 ;
                }

                enum http {
                  value 5 ;
                }

                enum ping {
                  value 6 ;
                }

                enum tftp {
                  value 7 ;
                }

              }

            }

            leaf permit-flag {
              description 'Permit or deny flag' ;
              type enumeration {
                enum permit {
                  value 1 ;
                }

                enum deny {
                  value 2 ;
                }

              }

              mandatory true ;
            }

          }

        }

      }

      container mngport-filter {
        if-feature mngport-filter ;

        description 'Mng port filter' ;
        container mng-mac-filters {
          description 'Mng-port mac filter configurations
mng-mac-item-filters & mng-mac-any-filter total max configuration items number is 20' ;
          container mng-mac-any-fliter {
            description 'Mng-port mac any filter configuration' ;
            presence mng-mac-any-filter ;
            leaf permit-flag {
              description 'Permit flag' ;
              type enumeration {
                enum deny {
                  value 1 ;
                }

                enum permit {
                  value 2 ;
                }

              }

              mandatory true ;
            }

          }

          container mng-mac-item-filters {
            description 'Mng-port mac filter configurations' ;
            list mng-mac-filter {
              description 'Mng-port mac filter configuration' ;
              key mac-addr ;
              max-elements 20 ;
              leaf mac-addr {
                description 'Mac address' ;
                type ncd:mac-address {
                  length 0..32 ;

                }

              }

              leaf permit-flag {
                description 'Permit flag' ;
                type enumeration {
                  enum deny {
                    value 1 ;
                  }

                  enum permit {
                    value 2 ;
                  }

                }

                mandatory true ;
              }

            }

          }

        }

        container mng-ip-filters {
          description 'Mng-port IP filter configurations
mng-ip-item-filters & mng-ip-any-filter total max configuration items number is 20' ;
          container mng-ip-any-filter {
            description 'Mng-port any IP filter configuration' ;
            presence mng-ip-any-filter ;
            leaf permit-flag {
              description 'Permit flag' ;
              type enumeration {
                enum deny {
                  value 1 ;
                }

                enum permit {
                  value 2 ;
                }

              }

              mandatory true ;
            }

          }

          container mng-ip-item-filters {
            description 'Mng-port IP filter configurations' ;
            list mng-ip-filter {
              description 'Mng-port IP filter configuration' ;
              key 'ip-addr ip-mask' ;
              max-elements 20 ;
              leaf ip-addr {
                description 'Ip address' ;
                type ncd:ipv4-address ;

              }

              leaf ip-mask {
                description 'Ip mask' ;
                type ncd:ipv4-mask ;

              }

              leaf permit-flag {
                description 'Permit flag' ;
                type enumeration {
                  enum deny {
                    value 1 ;
                  }

                  enum permit {
                    value 2 ;
                  }

                }

                mandatory true ;
              }

            }

          }

        }

        container mng-ipv6-filters {
          description 'Mng-port IPv6 filter configurations
mng-ipv6-item-filters & mng-ipv6-any-filter total max configuration items number is 20' ;
          container mng-ipv6-any-filter {
            description 'Mng-port any IPv6 filter configuration' ;
            presence mng-ipv6-any-filter ;
            leaf permit-flag {
              description 'Permit flag' ;
              type enumeration {
                enum deny {
                  value 1 ;
                }

                enum permit {
                  value 2 ;
                }

              }

              mandatory true ;
            }

          }

          container mng-ipv6-item-filters {
            description 'Mng-port IPv6 filter configurations' ;
            list mng-ipv6-filter {
              description 'Mng-port IPv6 filter configuration' ;
              key 'ipv6-addr prefix-len' ;
              max-elements 20 ;
              leaf ipv6-addr {
                description 'Ipv6 address' ;
                type ncd:ipv6-address ;

              }

              leaf prefix-len {
                description 'Ipv6 prefix length' ;
                type uint8 {
                  range 1..128 ;

                }

              }

              leaf permit-flag {
                description 'Permit flag' ;
                type enumeration {
                  enum deny {
                    value 1 ;
                  }

                  enum permit {
                    value 2 ;
                  }

                }

                mandatory true ;
              }

            }

          }

        }

        container mng-port-filters {
          description 'Mng-port port filter configurations' ;
          list mng-port-filter {
            description 'Mng-port port filter configuration' ;
            key 'protocol-type local-remote port-number' ;
            max-elements 5 ;
            leaf protocol-type {
              description 'Protocol type' ;
              type enumeration {
                enum tcp {
                  value 6 ;
                }

                enum udp {
                  value 17 ;
                }

              }

            }

            leaf local-remote {
              description 'Local or remote port flag' ;
              type enumeration {
                enum remote {
                  value 1 ;
                }

                enum local {
                  value 2 ;
                }

              }

            }

            leaf port-number {
              description 'Port number' ;
              type uint16 {
                range 1..65535 ;

              }

            }

            leaf permit-flag {
              description 'Permit flag' ;
              type enumeration {
                enum deny {
                  value 1 ;
                }

                enum permit {
                  value 2 ;
                }

              }

              mandatory true ;
            }

          }

        }

        container mng-protocol-filters {
          description 'Mng-port protocol filter configurations' ;
          list mng-protocol-filter {
            description 'Mng-port protocol filter configuration' ;
            key protocol-type ;
            leaf protocol-type {
              description 'Protocol type' ;
              type enumeration {
                enum any {
                  value 1 ;
                }

                enum arp {
                  value 2 ;
                }

                enum ftp {
                  value 3 ;
                }

                enum icmp {
                  value 4 ;
                }

                enum radius {
                  value 5 ;
                }

                enum snmp {
                  value 6 ;
                }

                enum ssh {
                  value 7 ;
                }

                enum tacacs-plus {
                  value 8 ;
                }

                enum telnet {
                  value 9 ;
                }

                enum tftp {
                  value 10 ;
                }

                enum nd {
                  value 11 ;
                }

                enum ntp {
                  value 12 ;
                }

                enum ipfrag {
                  value 13 ;
                }

                enum http {
                  value 14 ;
                }

                enum dhcp {
                  value 15 ;
                }

                enum netconf-over-tls {
                  value 16 ;
                }

                enum lldp {
                  value 17 ;
                }

                enum openflow {
                  value 18 ;
                }

              }

            }

            choice permit-or-deny {
              case permit {
                leaf permit {
                  description 'Permit flag' ;
                  type enumeration {
                    enum permit {
                      value 2 ;
                    }

                  }

                  mandatory true ;
                }

                leaf rate-limit {
                  description 'Rate limit value' ;
                  type uint32 {
                    range 1..10000 ;

                  }

                }

              }

              case deny {
                leaf deny {
                  description 'Deny flag' ;
                  type enumeration {
                    enum deny {
                      value 1 ;
                    }

                  }

                  mandatory true ;
                }

              }

            }

          }

        }

      }

      container statistics-interval {
        if-feature statistics-interval ;

        description 'Statistics interval value configuration' ;
        leaf interval {
          description 'Statistics interval value(s:second)' ;
          type uint32 {
            range "0|5..300" ;

          }

          units s ;
          default 10 ;
        }

      }

      container defend-policy {
        if-feature defend-policy-feature ;

        description 'Policy configurations.' ;
        container ipv4-white-list {
          if-feature defend-policy-whitelist ;

          description 'Configure IPv4 whitelist.' ;
          list ipv4-access-list {
            description 'Configure ipv4-access-list.' ;
            key acl-name ;
            leaf acl-name {
              description 'Name of ACL.' ;
              type string {
                length 1..31 ;

              }

            }

          }

        }

        container ipv4-black-list {
          if-feature defend-policy-blacklist ;

          description 'Configure IPv4 blacklist.' ;
          list ipv4-access-list {
            description 'Configure ipv4-access-list.' ;
            key acl-name ;
            leaf acl-name {
              description 'Name of ACL.' ;
              type string {
                length 1..31 ;

              }

            }

          }

        }

        container ipv6-white-list {
          if-feature defend-policy-whitelist ;

          description 'Configure IPv6 whitelist.' ;
          list ipv6-access-list {
            description 'Configure ipv6-access-list.' ;
            key acl-name ;
            leaf acl-name {
              description 'Name of ACL.' ;
              type string {
                length 1..31 ;

              }

            }

          }

        }

        container ipv6-black-list {
          if-feature defend-policy-blacklist ;

          description 'Configure IPv6 blacklist.' ;
          list ipv6-access-list {
            description 'Configure ipv6-access-list.' ;
            key acl-name ;
            leaf acl-name {
              description 'Name of ACL.' ;
              type string {
                length 1..31 ;

              }

            }

          }

        }

      }

      container mngport-ip-packets-forward {
        description 'IP-forwarding of management ethernet interface.' ;
        presence "ip-forwarding of management interface" ;
        leaf forwarding-switch {
          description 'forwarding switch.' ;
          type enumeration {
            enum enable {
              value 1 ;
              description 'open.' ;
            }

            enum disable {
              value 0 ;
              description 'close.' ;
            }

          }

          mandatory true ;
        }

      }

      container global {
        description 'Global configuration.' ;
        leaf cps-log {
          if-feature cps-log ;

          description 'CPS log switch.' ;
          type enumeration {
            enum on {
              value 1 ;
              description 'open.' ;
            }

            enum off {
              value 0 ;
              description 'close.' ;
            }

          }

        }

        container service-policy {
          if-feature cps-service-policy ;

          description 'CPS bind QOS strategy.' ;
          leaf policy-map-name {
            description 'Name of policy map.' ;
            type string {
              length 1..31 ;

            }

          }

        }

      }

      container service-policys {
        description 'CPS bind QOS strategy.' ;
        list service-policy {
          if-feature cps-service-policy ;

          description 'Set QOS strategy for specify interface.' ;
          key if-name ;
          leaf if-name {
            description 'Interface name.' ;
            type ncd:ifname ;

          }

          leaf policy-map-name {
            description 'Name of policy map.' ;
            type string {
              length 1..31 ;

            }

            mandatory true ;
          }

        }

      }

      container alarm-detect-cycle {
        description 'Configuration of the Alarm Detection Cycle' ;
        leaf generation {
          type uint32 {
            range 1..100 ;

          }

          description 'The cycle required for the generation of an alarm' ;
        }

        leaf disappear {
          type uint32 {
            range 1..100 ;

          }

          description 'The cycle required for the disappear of an alarm' ;
        }

        ncd:revise-date 2024-04-15 ;
      }

    }

    ncd:revise-date 2024-01-22 ;
  }

  container state {
    config false ;
    description 'State model info.' ;
    container cps {
      description 'Control plane security state' ;
      container ctm {
        if-feature ctm ;

        description 'Show CTM configurations' ;
        list rate-limit {
          description 'Show CTM rate limit configuration' ;
          key 'destcpu board up-down-ctm' ;
          leaf destcpu {
            description 'Destination CPU name' ;
            type enumeration {
              enum r-cpu {
                value 1 ;
                description 'r-cpu' ;
              }

              enum l-cpu {
                value 2 ;
                description 'l-cpu' ;
              }

            }

          }

          leaf board {
            description 'Source board name' ;
            type ncd:board ;

          }

          leaf up-down-ctm {
            description 'Up or down CTM flag' ;
            type enumeration {
              enum up {
                value 1 ;
              }

              enum down {
                value 2 ;
              }

            }

          }

          leaf cir {
            description 'Cir value' ;
            type uint32 {
              range 0..4294967295 ;

            }

            units kbps ;
          }

          leaf cbs {
            description 'Cbs value' ;
            type uint32 {
              range 0..4294967295 ;

            }

            units KByte ;
          }

          leaf eir {
            description 'Eir value' ;
            type uint32 {
              range 0..4294967295 ;

            }

            units kbps ;
          }

          ncd:select "destcpu board up-down-ctm" ;
        }

        list queue-depth {
          description 'Show CTM queue depth configuration' ;
          key 'destcpu priority-queue ifname' ;
          leaf destcpu {
            description 'Destination CPU name' ;
            type enumeration {
              enum r-cpu {
                value 1 ;
                description 'r-cpu' ;
              }

              enum l-cpu {
                value 2 ;
                description 'l-cpu' ;
              }

            }

          }

          leaf priority-queue {
            description 'Priority queue value' ;
            type uint8 {
              range "0..7|16..19" ;

            }

          }

          leaf ifname {
            description 'Interface name' ;
            type ncd:ifname ;

          }

          leaf queue-depth {
            description 'Ctm queue depth value' ;
            type enumeration {
              enum high {
                value 1 ;
              }

              enum middle {
                value 2 ;
              }

              enum normal {
                value 3 ;
              }

              enum low {
                value 4 ;
              }

            }

          }

          ncd:select "destcpu priority-queue ifname" ;
        }

      }

      container flow {
        if-feature cps-cmd ;

        description 'Show flowtype configuration' ;
        list limit {
          description 'Show interface all flowtype limit value' ;
          key 'ifname flowtype' ;
          leaf ifname {
            description 'Interface name' ;
            type ncd:ifname ;

          }

          leaf flowtype {
            description 'Flowtype name' ;
            type flowtype-name ;

          }

          leaf rate-limit {
            description 'Flowtype rate limit value(pps:packet per second)' ;
            type uint32 {
              range 0..4294967295 ;

            }

            units pps ;
          }

          leaf quota-limit {
            description 'Flowtype quota limit value(pps:packet per second)' ;
            type uint32 {
              range 0..4294967295 ;

            }

            units pps ;
          }

          ncd:select "ifname flowtype" ;
        }

      }

      container mng-protocol-filter {
        if-feature mng-protocol-filters ;

        description 'Show mng protocol filter configuration' ;
        list mng-proto-filter {
          description 'Show management protocol configuration' ;
          key 'ifname mng-protocol' ;
          leaf ifname {
            description 'Interface name' ;
            type ncd:ifname ;

          }

          leaf mng-protocol {
            description 'Management protocol type' ;
            type enumeration {
              enum telnet {
                value 1 ;
              }

              enum ssh {
                value 2 ;
              }

              enum ftp {
                value 3 ;
              }

              enum snmp {
                value 4 ;
              }

              enum http {
                value 5 ;
              }

              enum ping {
                value 6 ;
              }

              enum tftp {
                value 7 ;
              }

            }

          }

          leaf permit-or-deny {
            description 'Permit or deny flag' ;
            type enumeration {
              enum permit {
                value 1 ;
              }

              enum deny {
                value 2 ;
              }

            }

          }

          ncd:select "ifname mng-protocol" ;
        }

      }

      container mngport-filter {
        if-feature mngport-filter ;

        description 'Show management port filter configuration' ;
        list mng-mac-filter {
          description 'Show mng-port MAC address filter configuration' ;
          key mac-addr ;
          leaf mac-addr {
            description 'Mac address' ;
            type ncd:mac-address ;

          }

          leaf permit-flag {
            description 'Permit flag' ;
            type enumeration {
              enum deny {
                value 1 ;
              }

              enum permit {
                value 2 ;
              }

            }

          }

        }

        list mng-ip-filter {
          description 'Show mng-port ip address filter configuration' ;
          key 'ip-addr ip-addr-mask' ;
          leaf ip-addr {
            description 'Ip address' ;
            type ncd:ipv4-address ;

          }

          leaf ip-addr-mask {
            description 'Ip address mask' ;
            type ncd:ipv4-mask ;

          }

          leaf permit-flag {
            description 'Permit flag' ;
            type enumeration {
              enum deny {
                value 1 ;
              }

              enum permit {
                value 2 ;
              }

            }

          }

          ncd:select "ip-addr ip-addr-mask" ;
        }

        list mng-ipv6-filter {
          description 'Show mng-port ipv6 address filter configuration' ;
          key 'ipv6-addr prefix-len' ;
          leaf ipv6-addr {
            description 'Ipv6 address' ;
            type ncd:ipv6-address ;

          }

          leaf prefix-len {
            description 'Ipv6 address prefix length' ;
            type uint8 {
              range 1..128 ;

            }

          }

          leaf permit-flag {
            description 'Permit flag' ;
            type enumeration {
              enum deny {
                value 1 ;
              }

              enum permit {
                value 2 ;
              }

            }

          }

          ncd:select "ipv6-addr prefix-len" ;
        }

        list mng-port-filter {
          description 'Show mng-port port filter configuration' ;
          key 'protocol-type local-remote port-number' ;
          leaf protocol-type {
            description 'Protocol type' ;
            type enumeration {
              enum tcp {
                value 6 ;
              }

              enum udp {
                value 17 ;
              }

            }

          }

          leaf local-remote {
            description 'Local or remote port' ;
            type enumeration {
              enum remote {
                value 1 ;
              }

              enum local {
                value 2 ;
              }

            }

          }

          leaf port-number {
            description 'Port number' ;
            type uint16 {
              range 1..65535 ;

            }

          }

          leaf permit-flag {
            description 'Permit flag' ;
            type enumeration {
              enum deny {
                value 1 ;
              }

              enum permit {
                value 2 ;
              }

            }

          }

          ncd:select "protocol-type local-remote port-number" ;
        }

        list mng-protocol-filter {
          description 'Show mng-port protocol filter configuration' ;
          key protocol-type ;
          leaf protocol-type {
            description 'Protocol type' ;
            type enumeration {
              enum any {
                value 1 ;
              }

              enum arp {
                value 2 ;
              }

              enum ftp {
                value 3 ;
              }

              enum icmp {
                value 4 ;
              }

              enum radius {
                value 5 ;
              }

              enum snmp {
                value 6 ;
              }

              enum ssh {
                value 7 ;
              }

              enum tacacs-plus {
                value 8 ;
              }

              enum telnet {
                value 9 ;
              }

              enum tftp {
                value 10 ;
              }

              enum nd {
                value 11 ;
              }

              enum ntp {
                value 12 ;
              }

              enum ipfrag {
                value 13 ;
              }

              enum http {
                value 14 ;
              }

              enum dhcp {
                value 15 ;
              }

              enum netconf-over-tls {
                value 16 ;
              }

              enum lldp {
                value 17 ;
              }

              enum openflow {
                value 18 ;
              }

            }

          }

          leaf permit-flag {
            description 'Permit flag' ;
            type enumeration {
              enum deny {
                value 1 ;
              }

              enum permit {
                value 2 ;
              }

            }

          }

          leaf rate-limit {
            description 'Rate limit value' ;
            type uint32 {
              range 0..10000 ;

            }

          }

        }

      }

      container statistics {
        description 'Show statistics infomation' ;
        list gtsm-statistics {
          if-feature cps-cmd ;

          description 'Show gtsm statistics infomation' ;
          key flowtype ;
          leaf flowtype {
            description 'Flowtype name' ;
            type flowtype-name ;

          }

          leaf upsend-pkts {
            description 'Upsend packets number' ;
            type uint32 {
              range 0..4294967295 ;

            }

            units packets ;
            default 0 ;
          }

          leaf drop-pkts {
            description 'Drop packets number' ;
            type uint32 {
              range 0..4294967295 ;

            }

            units packets ;
            default 0 ;
          }

        }

        list cpu-statistics {
          if-feature cpu-statis ;

          description 'Statistics based on CPU' ;
          key 'flowtype cpuinfo' ;
          leaf flowtype {
            description 'Flowtype name' ;
            type flowtype-name ;

          }

          leaf cpuinfo {
            description 'Cpu name' ;
            type string {
              length 0..32 ;

            }

          }

          leaf in-packets {
            description 'In packets based on CPU' ;
            type ncd:uint64-8bytes ;

            units packets ;
            default 0 ;
          }

          leaf upsend-packets {
            description 'Sendout packets based on CPU' ;
            type ncd:uint64-8bytes ;

            units packets ;
            default 0 ;
          }

          ncd:select "flowtype cpuinfo" ;
          ncd:select cpuinfo ;
        }

        list interface-statistics {
          if-feature interface-statistics ;

          description 'Statistics based on interface' ;
          key 'flowtype ifname' ;
          leaf flowtype {
            description 'Flowtype name' ;
            type flowtype-name ;

          }

          leaf ifname {
            description 'Interface name' ;
            type ncd:ifname ;

          }

          leaf in-packets {
            description 'In packets' ;
            type ncd:uint64-8bytes ;

            units packets ;
            default 0 ;
          }

          leaf upsend-packets {
            description 'Upsend packets' ;
            type ncd:uint64-8bytes ;

            units packets ;
            default 0 ;
          }

          leaf drop-packets {
            description 'Drop packets' ;
            type ncd:uint64-8bytes ;

            units packets ;
            default 0 ;
          }

          leaf upsend-rate {
            description "Upsend packet's rate" ;
            type uint32 ;

            default 0 ;
          }

          leaf inpackets-rate {
            description "In-packet's rate" ;
            type uint32 ;

            default 0 ;
          }

          leaf peak-in-rate {
            description 'Peak rate' ;
            type uint32 ;

            default 0 ;
          }

          leaf peak-time {
            description 'Peak-rate time' ;
            type string ;

            default 0 ;
          }

          ncd:select "flowtype ifname" ;
          ncd:select ifname ;
        }

        list summary-statistics {
          if-feature interface-statistics ;

          description 'Statistics based on all interfaces' ;
          key flowtype ;
          leaf flowtype {
            description 'Flowtype name' ;
            type flowtype-name ;

          }

          leaf in-packets {
            description 'Summary in-packets on all interfaces' ;
            type ncd:uint64-8bytes ;

            units packets ;
            default 0 ;
          }

          leaf upsend-packets {
            description 'Summary upsend packets on all interfaces' ;
            type ncd:uint64-8bytes ;

            units packets ;
            default 0 ;
          }

          leaf drop-packets {
            description 'Summary drop packets on all interfaces' ;
            type ncd:uint64-8bytes ;

            default 0 ;
          }

        }

        list interface-statistics-top {
          if-feature interface-statistics ;

          description 'Top statistics of in-rate.' ;
          key 'flowtype ifname' ;
          leaf flowtype {
            description 'Flowtype name' ;
            type flowtype-name ;

          }

          leaf ifname {
            description 'Interface name' ;
            type ncd:ifname ;

          }

          leaf in-packets {
            description 'In packets' ;
            type ncd:uint64-8bytes ;

            units packets ;
            default 0 ;
          }

          leaf upsend-packets {
            description 'Upsend packets' ;
            type ncd:uint64-8bytes ;

            units packets ;
            default 0 ;
          }

          leaf drop-packets {
            description 'Drop packets' ;
            type ncd:uint64-8bytes ;

            units packets ;
            default 0 ;
          }

          leaf upsend-rate {
            description "Upsend packet's rate" ;
            type uint32 ;

            default 0 ;
          }

          leaf inpackets-rate {
            description "In-packet's rate" ;
            type uint32 ;

            default 0 ;
          }

          ncd:select ifname ;
        }

      }

    }

  }

  container operation {
    if-feature cps-cmd ;

    config false ;
    description 'Operation model info.' ;
    container cps {
      description 'Control plane security operation' ;
      container clear {
        description 'Clear operation' ;
        container flowtype {
          description 'Clear flowtype statistics infomation' ;
          leaf statistics {
            description 'Clear flowtype statistics' ;
            type empty ;

          }

        }

        container gtsm {
          description 'Clear gtsm statistics infomation' ;
          leaf statistics {
            description 'Clear gtsm statistics' ;
            type empty ;

          }

        }

      }

    }

  }

}
