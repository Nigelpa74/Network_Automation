                        description "The total number of packets (including bad packets) transmitted 
                                     that were between 1024 and 1518 octets in length (excluding 
                                     framing bits but including FCS octets) in current minutes 
                                     interval.";
                        type uint64;
                    }
                    leaf ethIfCMinLinkStatusChanges {
                        config false;
                        description "The total number of the link status changes on the interface
                                     in in current minutes interval.
                                     The total number is increased when the link status changes
                                     from up to down, or from down to up.";
                        type uint32;
                    }
                    leaf ethIfCMinInBwUsingRatio {
                        config false;
                        description "An estimate of the interface's received bandwidth using ratio in 
                                     current minutes interval.";
                        type int32 {
                            range 0..100;
                        }
                    }
                    leaf ethIfCMinOutBwUsingRatio {
                        config false;
                        description "An estimate of the interface's transmitted bandwidth using ratio 
                                     in current minutes interval.";
                        type int32 {
                            range 0..100;
                        }
                    }
                    leaf ethIfCMinReset {
                        description "Clear all the current minutes performance variables.
                                     When get this variable, always return 1.";
                        type enumeration {
                            enum perfReset {
                                value 1;
                                description "";
                            }
                        }
                    }
                }
            }
            container zxAnEthIfHisMinPerfTable {
                description "The minutes interval history performance data table of 
                             the ethernet interfaces.";
                list zxAnEthIfHisMinPerfEntry {
                    config false;
                    description "The minutes interval performance data entry of the 
                                 ethernet interfaces.";
                    max-elements 100;
                    key "ifIndex ethIfHMinIntervalNo";
                    leaf ifIndex {
                        description "A unique value, greater than zero, for each interface.  It
                                     is recommended that values are assigned contiguously
                                     starting from 1.  The value for each interface sub-layer
                                     must remain constant at least from one re-initialization of
                                     the entity's network management system to the next re-
                                     initialization.";
                        type int32 {
                            range 1..2147483647;
                        }
                    }
                    leaf ethIfHMinIntervalNo {
                        config false;
                        description "The performance data interval number.";
                        type int32;
                    }
                    leaf ethIfHMinIntervalValidData {
                        config false;
                        description "Performance data valid flag. 
                                     true(1) means valid.  
                                     false(2) means invalidm and the performace data is useless.";
                        type int32;
                    }
                    leaf ethIfHMinDateTime {
                        config false;
                        description "The minutes interval performance data generation time.";
                        type binary;
                    }
                    leaf ethIfHMinInOctets {
                        config false;
                        description "The total number of octets received on the interface,
                                     including framing characters in historical minutes interval.";
                        type uint64;
                    }
                    leaf ethIfHMinInPkts {
                        config false;
                        description "The total number of packets received on the interface,
                                     including framing characters in historical minutes interval.";
                        type uint64;
                    }
                    leaf ethIfHMinInUcastPkts {
                        config false;
                        description "The number of packets, delivered by this sub-layer to a
                                     higher (sub-)layer, which were not addressed to a multicast
                                     or broadcast address at this sub-layer in historical minutes
                                     interval.";
                        type uint64;
                    }
                    leaf ethIfHMinInMcastPkts {
                        config false;
                        description "The number of packets, delivered by this sub-layer to a
                                     higher (sub-)layer, which were addressed to a multicast
                                     address at this sub-layer in historical minutes interval.
                                     For a MAC layer protocol, this includes both Group and 
                                     Functional addresses.";
                        type uint64;
                    }
                    leaf ethIfHMinInBcastPkts {
                        config false;
                        description "The number of packets, delivered by this sub-layer to a
                                     higher (sub-)layer, which were addressed to a broadcast
                                     address at this sub-layer in historical minutes interval.";
                        type uint64;
                    }
                    leaf ethIfHMinInOversizedPkts {
                        config false;
                        description "The number of packets,whick above the configured MTU-size,
                                     e.g.mtu = 2000 (frames >2000 are discarded) in historical
                                     minutes interval.";
                        type uint64;
                    }
                    leaf ethIfHMinInUndersizedPkts {
                        config false;
                        description "The number of packets,whick above the min port size,
                                     the value is 64 in historical minutes interval.";
                        type uint64;
                    }
                    leaf ethIfHMinOutOctets {
                        config false;
                        description "The total number of octets transmitted out of the interface, 
                                     including framing characters in historical minutes interval.";
                        type uint64;
                    }
                    leaf ethIfHMinOutPkts {
                        config false;
                        description "The total number of packets transmitted out of the interface, 
                                     including framing characters in historical minutes interval.";
                        type uint64;
                    }
                    leaf ethIfHMinOutUcastPkts {
                        config false;
                        description "The total number of packets that higher-level protocols
                                     requested be transmitted, and which were not addressed to a
                                     multicast or broadcast address at this sub-layer, including
                                     those that were discarded or not sent in historical minutes
                                     interval.";
                        type uint64;
                    }
                    leaf ethIfHMinOutMcastPkts {
                        config false;
                        description "The total number of packets that higher-level protocols
                                     requested be transmitted, and which were addressed to a
                                     multicast address at this sub-layer, including those that
                                     were discarded or not sent in historical minutes interval.
                                     For a MAC layer protocol, this includes both Group and 
                                     functional addresses.";
                        type uint64;
                    }
                    leaf ethIfHMinOutBcastPkts {
                        config false;
                        description "The total number of packets that higher-level protocols
                                     requested be transmitted, and which were addressed to a
                                     broadcast address at this sub-layer, including those that
                                     were discarded or not sent in historical minutes interval.";
                        type uint64;
                    }
                    leaf ethIfHMinOutPausePkts {
                        config false;
                        description "A count of MAC Control frames transmitted on
                                     this interface with an opcode indicating the
                                     PAUSE operation in historical minutes interval.";
                        type uint64;
                    }
                    leaf ethIfHMinOutDiscardPkts {
                        config false;
                        description "The number of outbound packets which were chosen to be
                                     discarded even though no errors had been detected to prevent
                                     their being transmitted in historical minutes interval.";
                        type uint64;
                    }
                    leaf ethIfHMinOutCollisions {
                        config false;
                        description "A count of frames that are involved in out collision and 
                                     are subsequently transmitted successfully in historical 
                                     minutes interval.";
                        type uint64;
                    }
                    leaf ethIfHMinSingleCollisions {
                        config false;
                        description "A count of frames that are involved in a single
                                     collision, and are subsequently transmitted
                                     successfully in historical minutes interval.";
                        type uint64;
                    }
                    leaf ethIfHMinMultipleCollisions {
                        config false;
                        description "A count of frames that are involved in more
                                     than one collision and are subsequently
                                     transmitted successfully in historical minutes
                                     interval.";
                        type uint64;
                    }
                    leaf ethIfHMinFcsErrors {
                        config false;
                        description "A count of frames received on a particular
                                     interface that are an integral number of octets
                                     in length but do not pass the FCS check.  This
                                     count does not include frames received with
                                     frame-too-long or frame-too-short error in historical
                                     minutes interval.";
                        type uint64;
                    }
                    leaf ethIfHMinAlignmentErrors {
                        config false;
                        description "A count of frames received on a particular
                                     interface that are not an integral number of
                                     octets in length and do not pass the FCS check
                                     in historical minutes interval.";
                        type uint64;
                    }
                    leaf ethIfHMinInCrcErrPkts {
                        config false;
                        description "The total number of CRC errored packets received on the interface
                                     in historical minutes interval.";
                        type uint64;
                    }
                    leaf ethIfHMinInDiscardPkts {
                        config false;
                        description "The total number of discarded packets received on the interface
                                     in historical minutes interval.";
                        type uint64;
                    }
                    leaf ethIfHMinInErrPkts {
                        config false;
                        description "The total number of errored packets received on the interface
                                     in historical minutes interval.";
                        type uint64;
                    }
                    leaf ethIfHMinOutErrPkts {
                        config false;
                        description "The total number of errored packets that could not be transmitted 
                                     from the interface because of errors 
                                     in historical minutes interval.";
                        type uint64;
                    }
                    leaf ethIfHMinInDropEvents {
                        config false;
                        description "The total number of events in which packets received were 
                                     dropped by the probe due to lack of resources.
                                     Note that this number is not necessarily the number of packets 
                                     dropped; it is just the number of times this condition has been 
                                     detected in historical minutes interval.";
                        type uint64;
                    }
                    leaf ethIfHMinOutDropEvents {
                        config false;
                        description "The total number of events in which packets transmitted were 
                                     dropped by the probe due to lack of resources.
                                     Note that this number is not necessarily the number of packets 
                                     dropped; it is just the number of times this condition has been 
                                     detected in historical minutes interval.";
                        type uint64;
                    }
                    leaf ethIfHMinOutCrcErrPkts {
                        config false;
                        description "The total number of CRC errored packets transmitted out of the 
                                     interface in historical minutes interval.";
                        type uint64;
                    }
                    leaf ethIfHMinOutOversizedPkts {
                        config false;
                        description "The total number of packets transmitted that were longer than 
                                     1518 octets (excluding framing bits, but including FCS octets) 
                                     and were otherwise well formed in historical minutes 
                                     interval.";
                        type uint64;
                    }
                    leaf ethIfHMinOutUndersizedPkts {
                        config false;
                        description "The total number of packets transmitted that were less than 
                                     64 octets long (excluding framing bits, but including FCS 
                                     octets) and were otherwise well formed in historical minutes 
                                     interval.";
                        type uint64;
                    }
                    leaf ethIfHMinInFragments {
                        config false;
                        description "The total number of packets received that were less than 64 
                                     octets in length (excluding framing bits but including FCS 
                                     octets) and had either a bad Frame Check Sequence (FCS) with 
                                     an integral number of octets (FCS Error) or a bad FCS with a 
                                     non-integral number of octets (Alignment Error) in historical 
                                     minutes interval.";
                        type uint64;
                    }
                    leaf ethIfHMinOutFragments {
                        config false;
                        description "The total number of packets transmitted that were less than 64 
                                     octets in length (excluding framing bits but including FCS 
                                     octets) and had either a bad Frame Check Sequence (FCS) with an 
                                     integral number of octets (FCS Error) or a bad FCS with a 
                                     non-integral number of octets (Alignment Error) in historical 
                                     minutes interval.";
                        type uint64;
                    }
                    leaf ethIfHMinInJabbers {
                        config false;
                        description "The total number of packets received that were longer than 
                                     1518 octets (excluding framing bits, but including FCS octets), 
                                     and had either a bad Frame Check Sequence (FCS) with an integral 
                                     number of octets (FCS Error) or a bad FCS with a non-integral
                                     number of octets (Alignment Error).
                                     
                                     Note that this definition of jabber is different than the 
                                     definition in IEEE-802.3 section 8.2.1.5 (10BASE5) and section 
                                     10.3.1.4 (10BASE2). These documents define jabber as the 
                                     condition where any packet exceeds 20 ms. The allowed range to 
                                     detect jabber is between 20 ms and 150 ms in historical
                                     minutes interval.";
                        type uint64;
                    }
                    leaf ethIfHMinOutJabbers {
                        config false;
                        description "The total number of packets transmitted that were longer than 
                                     1518 octets (excluding framing bits, but including FCS octets), 
                                     and had either a bad Frame Check Sequence (FCS) with an integral 
                                     number of octets (FCS Error) or a bad FCS with a non-integral
                                     number of octets (Alignment Error).
                                     
                                     Note that this definition of jabber is different than the 
                                     definition in IEEE-802.3 section 8.2.1.5 (10BASE5) and section 
                                     10.3.1.4 (10BASE2). These documents define jabber as the 
                                     condition where any packet exceeds 20 ms. The allowed range to 
                                     detect jabber is between 20 ms and 150 ms in historical
                                     minutes interval.";
                        type uint64;
                    }
                    leaf ethIfHMinInPkts64Octets {
                        config false;
                        description "The total number of packets (including bad packets) received 
                                     that were 64 octets in length (excluding framing bits but 
                                     including FCS octets) in historical minutes interval.";
                        type uint64;
                    }
                    leaf ethIfHMinOutPkts64Octets {
                        config false;
                        description "The total number of packets (including bad packets) transmitted 
                                     that were 64 octets in length (excluding framing bits but 
                                     including FCS octets) in historical minutes interval.";
                        type uint64;
                    }
                    leaf ethIfHMinInPkts65to127Octs {
                        config false;
                        description "The total number of packets (including bad packets) received 
                                     that were between 65 and 127 octets in length (excluding 
                                     framing bits but including FCS octets) in historical 
                                     minutes interval.";
                        type uint64;
                    }
                    leaf ethIfHMinOutPkts65to127Octs {
                        config false;
                        description "The total number of packets (including bad packets) transmitted 
                                     that were between 65 and 127 octets in length (excluding 
                                     framing bits but including FCS octets) in historical minutes 
                                     interval.";
                        type uint64;
                    }
                    leaf ethIfHMinInPkts128to255Octs {
                        config false;
                        description "The total number of packets (including bad packets) received 
                                     that were between 128 and 255 octets in length (excluding 
                                     framing bits but including FCS octets) in historical minutes 
                                     interval.";
                        type uint64;
                    }
                    leaf ethIfHMinOutPkts128to255Octs {
                        config false;
                        description "The total number of packets (including bad packets) transmitted 
                                     that were between 128 and 255 octets in length (excluding 
                                     framing bits but including FCS octets) in historical minutes 
                                     interval.";
                        type uint64;
                    }
                    leaf ethIfHMinInPkts256to511Octs {
                        config false;
                        description "The total number of packets (including bad packets) received 
                                     that were between 256 and 511 octets in length (excluding 
                                     framing bits but including FCS octets) in historical minutes
                                     interval.";
                        type uint64;
                    }
                    leaf ethIfHMinOutPkts256to511Octs {
                        config false;
                        description "The total number of packets (including bad packets) transmitted 
                                     that were between 256 and 511 octets in length (excluding 
                                     framing bits but including FCS octets) in historical minutes
                                     interval.";
                        type uint64;
                    }
                    leaf ethIfHMinInPkts512to1023 {
                        config false;
                        description "The total number of packets (including bad packets) received 
                                     that were between 512 and 1023 octets in length (excluding 
                                     framing bits but including FCS octets) in historical minutes 
                                     interval.";
                        type uint64;
                    }
                    leaf ethIfHMinOutPkts512to1023 {
                        config false;
                        description "The total number of packets (including bad packets) transmitted 
                                     that were between 512 and 1023 octets in length (excluding 
                                     framing bits but including FCS octets) in historical minutes 
                                     interval.";
                        type uint64;
                    }
                    leaf ethIfHMinInPkts1024to1518 {
                        config false;
                        description "The total number of packets (including bad packets) received 
                                     that were between 1024 and 1518 octets in length (excluding 
                                     framing bits but including FCS octets) in historical minutes
                                     interval.";
                        type uint64;
                    }
                    leaf ethIfHMinOutPkts1024to1518 {
                        config false;
                        description "The total number of packets (including bad packets) transmitted 
                                     that were between 1024 and 1518 octets in length (excluding 
                                     framing bits but including FCS octets) in historical minutes 
                                     interval.";
                        type uint64;
                    }
                    leaf ethIfHMinLinkStatusChanges {
                        config false;
                        description "The total number of the link status changes on the interface
                                     in historical minutes interval.
                                     The total number is increased when the link status changes
                                     from up to down, or from down to up.";
                        type uint32;
                    }
                    leaf ethIfHMinInBwUsingRatio {
                        config false;
                        description "An estimate of the interface's received bandwidth using ratio in 
                                     historical minutes interval.";
                        type int32 {
                            range 0..100;
                        }
                    }
                    leaf ethIfHMinOutBwUsingRatio {
                        config false;
                        description "An estimate of the interface's transmitted bandwidth using ratio 
                                     in historical minutes interval.";
                        type int32 {
                            range 0..100;
                        }
                    }
                }
            }
            container zxAnEthIfMinPerfTable {
                description "";
                list zxAnEthIfMinPerfEntry {
                    config false;
                    description " ";
                    max-elements 1;
                    key "ifIndex";
                    leaf ifIndex {
                        description "A unique value, greater than zero, for each interface.  It
                                     is recommended that values are assigned contiguously
                                     starting from 1.  The value for each interface sub-layer
                                     must remain constant at least from one re-initialization of
                                     the entity's network management system to the next re-
                                     initialization.";
                        type int32 {
                            range 1..2147483647;
                        }
                    }
                    leaf numberOfMinIntervals {
                        config false;
                        description "The total number of 15-minute PM intervals for which data was collected.";
                        type int32 {
                            range 0..96;
                        }
                    }
                    leaf nonValidMinIntervals {
                        config false;
                        description "The number of 15-minute PM intervals for which the data is considered to be invalid or incomplete.";
                        type int32 {
                            range 0..96;
                        }
                    }
                }
            }
            container zxAnEthIf1DayPerfTable {
                description "";
                list zxAnEthIf1DayPerfEntry {
                    config false;
                    description "";
                    max-elements 1;
                    key "ifIndex";
                    leaf ifIndex {
                        description "A unique value, greater than zero, for each interface.  It
                                     is recommended that values are assigned contiguously
                                     starting from 1.  The value for each interface sub-layer
                                     must remain constant at least from one re-initialization of
                                     the entity's network management system to the next re-
                                     initialization.";
                        type int32 {
                            range 1..2147483647;
                        }
                    }
                    leaf numberOf1DayIntervals {
                        config false;
                        description "The total number of 15-minute PM intervals for which data was collected.";
                        type int32 {
                            range 0..7;
                        }
                    }
                    leaf nonValid1DayIntervals {
                        config false;
                        description "The number of 15-minute PM intervals for which the data is considered to be invalid or incomplete.";
                        type int32 {
                            range 0..7;
                        }
                    }
                }
            }
        }
    }
}
