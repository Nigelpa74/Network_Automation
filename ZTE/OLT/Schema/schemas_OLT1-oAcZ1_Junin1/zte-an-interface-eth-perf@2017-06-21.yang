module zte-an-interface-eth-perf {
    namespace 'http://www.zte.com.cn/zxr10/netconf/schema/rosng/zx-eth-pm';
    prefix zx-eth-pm;

    organization "ZTE Corporation";
    contact " Zhang Weiping   ZTE Corporation
                         Mail: zhang.weiping@zte.com.cn
                         Tel : 021-68896470";
    description "The MIB module for the Performance Management of ZTE 
                 Access Node interface.";
    revision 2017-06-21 {
        description "Support ethernet interface minutes performance table.";
    }
    revision 2017-03-21 {
        description "Add some historical performance objects.";
    }
    revision 2011-09-13 {
        description "Modify this mib according to standard.";
    }
    revision 2011-09-10 {
        description "Modify the description.";
    }
    revision 2011-07-02 {
        description "Initial version of this MIB module.";
    }
    container zxAnInterfaceEthPerf {
        description "";
        container zxAnEthIfPerfObjects {
            description "";
            container zxAnEthIfCurr15MinPerfTable {
                description "The 15 minutes interval performance data table of the 
                             ethernet interfaces.";
                list zxAnEthIfCurr15MinPerfEntry {
                    description "The 15 minutes interval performance data entry of the 
                                 ethernet interfaces.";
                    max-elements 100;
                    key "ifIndex";
                    leaf ifIndex {
                        description "A unique value, greater than zero, for each interface.  It
                                     is recommended that values are assigned contiguously
                                     starting from 1.  The value for each interface sub-layer
                                     must remain constant at least from one re-initialization of
                                     the entity's network management system to the next re-
                                     initialization.";
                        type int32 {
                            range 1..2147483647;
                        }
                    }
                    leaf ethIfC15MTimeElapsed {
                        config false;
                        description "Number of seconds that have elapsed since the beginning of the 
                                     current 15 minutes interval.";
                        type uint32 {
                            range 0..899;
                        }
                    }
                    leaf ethIfC15MInOctets {
                        config false;
                        description "The total number of octets received on the interface,
                                     including framing characters in current 15 minutes interval.";
                        type uint64;
                    }
                    leaf ethIfC15MInPkts {
                        config false;
                        description "The total number of packets received on the interface,
                                     including framing characters in current 15 minutes interval.";
                        type uint64;
                    }
                    leaf ethIfC15MInUcastPkts {
                        config false;
                        description "The number of packets, delivered by this sub-layer to a
                                     higher (sub-)layer, which were not addressed to a multicast
                                     or broadcast address at this sub-layer in current 15 minutes
                                     interval.";
                        type uint64;
                    }
                    leaf ethIfC15MInMcastPkts {
                        config false;
                        description "The number of packets, delivered by this sub-layer to a
                                     higher (sub-)layer, which were addressed to a multicast
                                     address at this sub-layer in current 15 minutes interval.
                                     For a MAC layer protocol, this includes both Group and 
                                     Functional addresses.";
                        type uint64;
                    }
                    leaf ethIfC15MInBcastPkts {
                        config false;
                        description "The number of packets, delivered by this sub-layer to a
                                     higher (sub-)layer, which were addressed to a broadcast
                                     address at this sub-layer in current 15 minutes interval.";
                        type uint64;
                    }
                    leaf ethIfC15MInOversizedPkts {
                        config false;
                        description "The number of packets,whick above the configured MTU-size,
                                     e.g.mtu = 2000 (frames >2000 are discarded) in current 15
                                     minutes interval.";
                        type uint64;
                    }
                    leaf ethIfC15MInUndersizedPkts {
                        config false;
                        description "The number of packets,whick above the min port size,
                                     the value is 64 in current 15 minutes interval.";
                        type uint64;
                    }
                    leaf ethIfC15MOutOctets {
                        config false;
                        description "The total number of octets transmitted out of the interface, 
                                     including framing characters in current 15 minutes interval.";
                        type uint64;
                    }
                    leaf ethIfC15MOutPkts {
                        config false;
                        description "The total number of packets transmitted out of the interface, 
                                     including framing characters in current 15 minutes interval.";
                        type uint64;
                    }
                    leaf ethIfC15MOutUcastPkts {
                        config false;
                        description "The total number of packets that higher-level protocols
                                     requested be transmitted, and which were not addressed to a
                                     multicast or broadcast address at this sub-layer, including
                                     those that were discarded or not sent in current 15 minutes
                                     interval.";
                        type uint64;
                    }
                    leaf ethIfC15MOutMcastPkts {
                        config false;
                        description "The total number of packets that higher-level protocols
                                     requested be transmitted, and which were addressed to a
                                     multicast address at this sub-layer, including those that
                                     were discarded or not sent in current 15 minutes interval.
                                     For a MAC layer protocol, this includes both Group and 
                                     Functional addresses.";
                        type uint64;
                    }
                    leaf ethIfC15MOutBcastPkts {
                        config false;
                        description "The total number of packets that higher-level protocols
                                     requested be transmitted, and which were addressed to a
                                     broadcast address at this sub-layer, including those that
                                     were discarded or not sent in current 15 minutes interval.";
                        type uint64;
                    }
                    leaf ethIfC15MOutPausePkts {
                        config false;
                        description "A count of MAC Control frames transmitted on
                                     this interface with an opcode indicating the
                                     PAUSE operation in current 15 minutes interval.";
                        type uint64;
                    }
                    leaf ethIfC15MOutDiscardPkts {
                        config false;
                        description "The number of outbound packets which were chosen to be
                                     discarded even though no errors had been detected to prevent
                                     their being transmitted in current 15 minutes interval.";
                        type uint64;
                    }
                    leaf ethIfC15MOutCollisions {
                        config false;
                        description "A count of frames that are involved in out collision and 
                                     are subsequently transmitted successfully in current 15 
                                     minutes interval.";
                        type uint64;
                    }
                    leaf ethIfC15MSingleCollisions {
                        config false;
                        description "A count of frames that are involved in a single
                                     collision, and are subsequently transmitted
                                     successfully in current 15 minutes interval.";
                        type uint64;
                    }
                    leaf ethIfC15MMultipleCollisions {
                        config false;
                        description "A count of frames that are involved in more
                                     than one collision and are subsequently
                                     transmitted successfully in current 15 minutes
                                     interval.";
                        type uint64;
                    }
                    leaf ethIfC15MFcsErrors {
                        config false;
                        description "A count of frames received on a particular
                                     interface that are an integral number of octets
                                     in length but do not pass the FCS check.  This
                                     count does not include frames received with
                                     frame-too-long or frame-too-short error in current
                                     15 minutes interval.";
                        type uint64;
                    }
                    leaf ethIfC15MAlignmentErrors {
                        config false;
                        description "A count of frames received on a particular
                                     interface that are not an integral number of
                                     octets in length and do not pass the FCS check
                                     in current 15 minutes interval.";
                        type uint64;
                    }
                    leaf ethIfC15MInCrcErrPkts {
                        config false;
                        description "The total number of CRC errored packets received on the interface
                                     in current 15-minute interval.";
                        type uint64;
                    }
                    leaf ethIfC15MInDiscardPkts {
                        config false;
                        description "The total number of discarded packets received on the interface
                                     in current 15-minute interval.";
                        type uint64;
                    }
                    leaf ethIfC15MInErrPkts {
                        config false;
                        description "The total number of errored packets received on the interface
                                     in current 15-minute interval.";
                        type uint64;
                    }
                    leaf ethIfC15MOutErrPkts {
                        config false;
                        description "The total number of errored packets that could not be transmitted 
                                     from the interface because of errors in current 15-minute 
                                     interval.";
                        type uint64;
                    }
                    leaf ethIfC15MInDropEvents {
                        config false;
                        description "The total number of events in which packets received were 
                                     dropped by the probe due to lack of resources in current 
                                     15-minute interval.
                                     Note that this number is not necessarily the number of packets 
                                     dropped; it is just the number of times this condition has been 
                                     detected.";
                        type uint64;
                    }
                    leaf ethIfC15MOutDropEvents {
                        config false;
                        description "The total number of events in which packets transmitted were 
                                     dropped by the probe due to lack of resources in current 
                                     15-minute interval.
                                     Note that this number is not necessarily the number of packets 
                                     dropped; it is just the number of times this condition has been 
                                     detected.";
                        type uint64;
                    }
                    leaf ethIfC15MOutCrcErrPkts {
                        config false;
                        description "The total number of CRC errored packets transmitted out of the 
                                     interface in current 15-minute interval.";
                        type uint64;
                    }
                    leaf ethIfC15MOutOversizedPkts {
                        config false;
                        description "The total number of packets transmitted that were longer than 
                                     1518 octets (excluding framing bits, but including FCS octets) 
                                     and were otherwise well formed in current 15-minute interval.";
                        type uint64;
                    }
                    leaf ethIfC15MOutUndersizedPkts {
                        config false;
                        description "The total number of packets transmitted that were less than 
                                     64 octets long (excluding framing bits, but including FCS 
                                     octets) and were otherwise well formed in current 15-minute 
                                     interval.";
                        type uint64;
                    }
                    leaf ethIfC15MInFragments {
                        config false;
                        description "The total number of packets received that were less than 64 
                                     octets in length (excluding framing bits but including FCS 
                                     octets) and had either a bad Frame Check Sequence (FCS) with 
                                     an integral number of octets (FCS Error) or a bad FCS with a 
                                     non-integral number of octets (Alignment Error) in current 
                                     15-minute interval.";
                        type uint64;
                    }
                    leaf ethIfC15MOutFragments {
                        config false;
                        description "The total number of packets transmitted that were less than 64 
                                     octets in length (excluding framing bits but including FCS 
                                     octets) and had either a bad Frame Check Sequence (FCS) with an 
                                     integral number of octets (FCS Error) or a bad FCS with a 
                                     non-integral number of octets (Alignment Error) in current 
                                     15-minute interval.";
                        type uint64;
                    }
                    leaf ethIfC15MInJabbers {
                        config false;
                        description "The total number of packets received that were longer than 
                                     1518 octets (excluding framing bits, but including FCS octets), 
                                     and had either a bad Frame Check Sequence (FCS) with an integral 
                                     number of octets (FCS Error) or a bad FCS with a non-integral
                                     number of octets (Alignment Error) in current 15-minute 
                                     interval.
                                     
                                     Note that this definition of jabber is different than the 
                                     definition in IEEE-802.3 section 8.2.1.5 (10BASE5) and section 
                                     10.3.1.4 (10BASE2). These documents define jabber as the 
                                     condition where any packet exceeds 20 ms. The allowed range to 
                                     detect jabber is between 20 ms and 150 ms.";
                        type uint64;
                    }
                    leaf ethIfC15MOutJabbers {
                        config false;
                        description "The total number of packets transmitted that were longer than 
                                     1518 octets (excluding framing bits, but including FCS octets), 
                                     and had either a bad Frame Check Sequence (FCS) with an integral 
                                     number of octets (FCS Error) or a bad FCS with a non-integral
                                     number of octets (Alignment Error) in current 15-minute 
                                     interval.
                                     
                                     Note that this definition of jabber is different than the 
                                     definition in IEEE-802.3 section 8.2.1.5 (10BASE5) and section 
                                     10.3.1.4 (10BASE2). These documents define jabber as the 
                                     condition where any packet exceeds 20 ms. The allowed range to 
                                     detect jabber is between 20 ms and 150 ms.";
                        type uint64;
                    }
                    leaf ethIfC15MInPkts64Octets {
                        config false;
                        description "The total number of packets (including bad packets) received 
                                     that were 64 octets in length (excluding framing bits but 
                                     including FCS octets) in current 15-minute interval.";
                        type uint64;
                    }
                    leaf ethIfC15MOutPkts64Octets {
                        config false;
                        description "The total number of packets (including bad packets) transmitted 
                                     that were 64 octets in length (excluding framing bits but 
                                     including FCS octets) in current 15-minute interval.";
                        type uint64;
                    }
                    leaf ethIfC15MInPkts65to127Octs {
                        config false;
                        description "The total number of packets (including bad packets) received 
                                     that were between 65 and 127 octets in length (excluding 
                                     framing bits but including FCS octets) in current 15-minute 
                                     interval.";
                        type uint64;
                    }
                    leaf ethIfC15MOutPkts65to127Octs {
                        config false;
                        description "The total number of packets (including bad packets) transmitted 
                                     that were between 65 and 127 octets in length (excluding 
                                     framing bits but including FCS octets) in current 15-minute 
                                     interval.";
                        type uint64;
                    }
                    leaf ethIfC15MInPkts128to255Octs {
                        config false;
                        description "The total number of packets (including bad packets) received 
                                     that were between 128 and 255 octets in length (excluding 
                                     framing bits but including FCS octets) in current 15-minute 
                                     interval.";
                        type uint64;
                    }
                    leaf ethIfC15MOutPkts128to255Octs {
                        config false;
                        description "The total number of packets (including bad packets) transmitted 
                                     that were between 128 and 255 octets in length (excluding 
                                     framing bits but including FCS octets) in current 15-minute 
                                     interval.";
                        type uint64;
                    }
                    leaf ethIfC15MInPkts256to511Octs {
                        config false;
                        description "The total number of packets (including bad packets) received 
                                     that were between 256 and 511 octets in length (excluding 
                                     framing bits but including FCS octets) in current 15-minute
                                     interval.";
                        type uint64;
                    }
                    leaf ethIfC15MOutPkts256to511Octs {
                        config false;
                        description "The total number of packets (including bad packets) transmitted 
                                     that were between 256 and 511 octets in length (excluding 
                                     framing bits but including FCS octets) in current 15-minute
                                     interval.";
                        type uint64;
                    }
                    leaf ethIfC15MInPkts512to1023 {
                        config false;
                        description "The total number of packets (including bad packets) received 
                                     that were between 512 and 1023 octets in length (excluding 
                                     framing bits but including FCS octets) in current 15-minute 
                                     interval.";
                        type uint64;
                    }
                    leaf ethIfC15MOutPkts512to1023 {
                        config false;
                        description "The total number of packets (including bad packets) transmitted 
                                     that were between 512 and 1023 octets in length (excluding 
                                     framing bits but including FCS octets) in current 15-minute 
                                     interval.";
                        type uint64;
                    }
                    leaf ethIfC15MInPkts1024to1518 {
                        config false;
                        description "The total number of packets (including bad packets) received 
                                     that were between 1024 and 1518 octets in length (excluding 
                                     framing bits but including FCS octets) in current 15-minute
                                     interval.";
                        type uint64;
                    }
                    leaf ethIfC15MOutPkts1024to1518 {
                        config false;
                        description "The total number of packets (including bad packets) transmitted 
                                     that were between 1024 and 1518 octets in length (excluding 
                                     framing bits but including FCS octets) in current 15-minute 
                                     interval.";
                        type uint64;
                    }
                    leaf ethIfC15MLinkStatusChanges {
                        config false;
                        description "The total number of the link status changes on the interface
                                     in current 15-minute interval.
                                     The total number is increased when the link status changes
                                     from up to down, or from down to up.";
                        type uint32;
                    }
                    leaf ethIfC15MInBwUsingRatio {
                        config false;
                        description "An estimate of the interface's received bandwidth using ratio in 
                                     current 15-minute interval.";
                        type int32 {
                            range 0..100;
                        }
                    }
                    leaf ethIfC15MOutBwUsingRatio {
                        config false;
                        description "An estimate of the interface's transmitted bandwidth using ratio 
                                     in current 15-minute interval.";
                        type int32 {
                            range 0..100;
                        }
                    }
                    leaf ethIfC15MReset {
                        description "Clear all the current 15-minute performance variables.
                                     When get this variable, always return 1.";
                        type enumeration {
                            enum perfReset {
                                value 1;
                                description "";
                            }
                        }
                    }
                }
            }
            container zxAnEthIfCurr1DayPerfTable {
                description "The 1 day interval performance data table of the ethernet 
                             interfaces.";
                list zxAnEthIfCurr1DayPerfEntry {
                    description "The 1 day interval performance data entry of the ethernet 
                                 interfaces.";
                    max-elements 100;
                    key "ifIndex";
                    leaf ifIndex {
                        description "A unique value, greater than zero, for each interface.  It
                                     is recommended that values are assigned contiguously
                                     starting from 1.  The value for each interface sub-layer
                                     must remain constant at least from one re-initialization of
                                     the entity's network management system to the next re-
                                     initialization.";
                        type int32 {
                            range 1..2147483647;
                        }
                    }
                    leaf ethIfC1DTimeElapsed {
                        config false;
                        description "Number of seconds that have elapsed since the beginning of the 
                                     current 1 day interval.";
                        type uint32 {
                            range 0..86399;
                        }
                    }
                    leaf ethIfC1DInOctets {
                        config false;
                        description "The total number of octets received on the interface,
                                     including framing characters in current one day interval.";
                        type uint64;
                    }
                    leaf ethIfC1DInPkts {
                        config false;
                        description "The total number of packets received on the interface,
                                     including framing characters in current one day interval.";
                        type uint64;
                    }
                    leaf ethIfC1DInUcastPkts {
                        config false;
                        description "The number of packets, delivered by this sub-layer to a
                                     higher (sub-)layer, which were not addressed to a multicast
                                     or broadcast address at this sub-layer in current one day
                                     interval.";
                        type uint64;
                    }
                    leaf ethIfC1DInMcastPkts {
                        config false;
                        description "The number of packets, delivered by this sub-layer to a
                                     higher (sub-)layer, which were addressed to a multicast
                                     address at this sub-layer in current one day interval.
                                     For a MAC layer protocol, this includes both Group and 
                                     Functional addresses.";
                        type uint64;
                    }
                    leaf ethIfC1DInBcastPkts {
                        config false;
                        description "The number of packets, delivered by this sub-layer to a
                                     higher (sub-)layer, which were addressed to a broadcast
                                     address at this sub-layer in current one day interval.";
                        type uint64;
                    }
                    leaf ethIfC1DInOversizedPkts {
                        config false;
                        description "The number of packets,whick above the configured MTU-size,
                                     e.g.mtu = 2000 (frames >2000 are discarded) in current one
                                     day interval.";
                        type uint64;
                    }
                    leaf ethIfC1DInUndersizedPkts {
                        config false;
                        description "The number of packets,whick above the min port size,
                                     the value is 64 in current one day interval.";
                        type uint64;
                    }
                    leaf ethIfC1DOutOctets {
                        config false;
                        description "The total number of octets transmitted out of the interface, 
                                     including framing characters in current one day interval.";
                        type uint64;
                    }
                    leaf ethIfC1DOutPkts {
                        config false;
                        description "The total number of packets transmitted out of the interface, 
                                     including framing characters in current one day interval.";
                        type uint64;
                    }
                    leaf ethIfC1DOutUcastPkts {
                        config false;
                        description "The total number of packets that higher-level protocols
                                     requested be transmitted, and which were not addressed to a
                                     multicast or broadcast address at this sub-layer, including
                                     those that were discarded or not sent in current one day
                                     interval.";
                        type uint64;
                    }
                    leaf ethIfC1DOutMcastPkts {
                        config false;
                        description "The total number of packets that higher-level protocols
                                     requested be transmitted, and which were addressed to a
                                     multicast address at this sub-layer, including those that
                                     were discarded or not sent in current one day interval.
                                     For a MAC layer protocol, this includes both Group and 
                                     Functional addresses.";
                        type uint64;
                    }
                    leaf ethIfC1DOutBcastPkts {
                        config false;
                        description "The total number of packets that higher-level protocols
                                     requested be transmitted, and which were addressed to a
                                     broadcast address at this sub-layer, including those that
                                     were discarded or not sent in current one day interval.";
                        type uint64;
                    }
                    leaf ethIfC1DOutPausePkts {
                        config false;
                        description "A count of MAC Control frames transmitted on
                                     this interface with an opcode indicating the
                                     PAUSE operation in current one day interval.";
                        type uint64;
                    }
                    leaf ethIfC1DOutDiscardPkts {
                        config false;
                        description "The number of outbound packets which were chosen to be
                                     discarded even though no errors had been detected to prevent
                                     their being transmitted in current one day interval.";
                        type uint64;
                    }
                    leaf ethIfC1DOutCollisions {
                        config false;
                        description "A count of frames that are involved in out collision and 
                                     are subsequently transmitted successfully in current one 
                                     day interval.";
                        type uint64;
                    }
                    leaf ethIfC1DSingleCollisions {
                        config false;
                        description "A count of frames that are involved in a single
                                     collision, and are subsequently transmitted
                                     successfully in current one day interval.";
                        type uint64;
                    }
                    leaf ethIfC1DMultipleCollisions {
                        config false;
                        description "A count of frames that are involved in more
                                     than one collision and are subsequently
                                     transmitted successfully in current one day
                                     interval.";
                        type uint64;
                    }
                    leaf ethIfC1DFcsErrors {
                        config false;
                        description "A count of frames received on a particular
                                     interface that are an integral number of octets
                                     in length but do not pass the FCS check.  This
                                     count does not include frames received with
                                     frame-too-long or frame-too-short error in current
                                     one day interval.";
                        type uint64;
                    }
                    leaf ethIfC1DAlignmentErrors {
                        config false;
                        description "A count of frames received on a particular
                                     interface that are not an integral number of
                                     octets in length and do not pass the FCS check
                                     in current one day interval.";
                        type uint64;
                    }
                    leaf ethIfC1DInCrcErrPkts {
                        config false;
                        description "The total number of CRC errored packets received on the interface
                                     in current 1-day interval.";
                        type uint64;
                    }
                    leaf ethIfC1DInDiscardPkts {
                        config false;
                        description "The total number of discarded packets received on the interface
                                     in current 1-day interval.";
                        type uint64;
                    }
                    leaf ethIfC1DInErrPkts {
                        config false;
                        description "The total number of errored packets received on the interface
                                     in current 1-day interval.";
                        type uint64;
                    }
                    leaf ethIfC1DOutErrPkts {
                        config false;
                        description "The total number of errored packets that could not be transmitted 
                                     from the interface because of errors in current 1-day interval.";
                        type uint64;
                    }
                    leaf ethIfC1DInDropEvents {
                        config false;
                        description "The total number of events in which packets received were 
                                     dropped by the probe due to lack of resources in current 
                                     1-day interval.
                                     Note that this number is not necessarily the number of packets 
                                     dropped; it is just the number of times this condition has been 
                                     detected.";
                        type uint64;
                    }
                    leaf ethIfC1DOutDropEvents {
                        config false;
                        description "The total number of events in which packets transmitted were 
                                     dropped by the probe due to lack of resources in current 
                                     1-day interval.
                                     Note that this number is not necessarily the number of packets 
                                     dropped; it is just the number of times this condition has been 
                                     detected.";
                        type uint64;
                    }
                    leaf ethIfC1DOutCrcErrPkts {
                        config false;
                        description "The total number of CRC errored packets transmitted out of the 
                                     interface in current 1-day interval.";
                        type uint64;
                    }
                    leaf ethIfC1DOutOversizedPkts {
                        config false;
                        description "The total number of packets transmitted that were longer than 
                                     1518 octets (excluding framing bits, but including FCS octets) 
                                     and were otherwise well formed in current 1-day interval.";
                        type uint64;
                    }
                    leaf ethIfC1DOutUndersizedPkts {
                        config false;
                        description "The total number of packets transmitted that were less than 
                                     64 octets long (excluding framing bits, but including FCS 
                                     octets) and were otherwise well formed in current 1-day
                                     interval.";
                        type uint64;
                    }
                    leaf ethIfC1DInFragments {
                        config false;
                        description "The total number of packets received that were less than 64 
                                     octets in length (excluding framing bits but including FCS 
                                     octets) and had either a bad Frame Check Sequence (FCS) with 
                                     an integral number of octets (FCS Error) or a bad FCS with a 
                                     non-integral number of octets (Alignment Error) in current 
                                     1-day interval.";
                        type uint64;
                    }
                    leaf ethIfC1DOutFragments {
                        config false;
                        description "The total number of packets transmitted that were less than 64 
                                     octets in length (excluding framing bits but including FCS 
                                     octets) and had either a bad Frame Check Sequence (FCS) with an 
                                     integral number of octets (FCS Error) or a bad FCS with a 
                                     non-integral number of octets (Alignment Error) in current 
                                     1-day interval.";
                        type uint64;
                    }
                    leaf ethIfC1DInJabbers {
                        config false;
                        description "The total number of packets received that were longer than 
                                     1518 octets (excluding framing bits, but including FCS octets), 
                                     and had either a bad Frame Check Sequence (FCS) with an integral 
                                     number of octets (FCS Error) or a bad FCS with a non-integral
                                     number of octets (Alignment Error) in current 1-day interval.
                                     
                                     Note that this definition of jabber is different than the 
                                     definition in IEEE-802.3 section 8.2.1.5 (10BASE5) and section 
                                     10.3.1.4 (10BASE2). These documents define jabber as the 
                                     condition where any packet exceeds 20 ms. The allowed range to 
                                     detect jabber is between 20 ms and 150 ms.";
                        type uint64;
                    }
                    leaf ethIfC1DOutJabbers {
                        config false;
                        description "The total number of packets transmitted that were longer than 
                                     1518 octets (excluding framing bits, but including FCS octets), 
                                     and had either a bad Frame Check Sequence (FCS) with an integral 
                                     number of octets (FCS Error) or a bad FCS with a non-integral
                                     number of octets (Alignment Error) in current 1-day interval.
                                     
                                     Note that this definition of jabber is different than the 
                                     definition in IEEE-802.3 section 8.2.1.5 (10BASE5) and section 
                                     10.3.1.4 (10BASE2). These documents define jabber as the 
                                     condition where any packet exceeds 20 ms. The allowed range to 
                                     detect jabber is between 20 ms and 150 ms.";
                        type uint64;
                    }
                    leaf ethIfC1DInPkts64Octets {
