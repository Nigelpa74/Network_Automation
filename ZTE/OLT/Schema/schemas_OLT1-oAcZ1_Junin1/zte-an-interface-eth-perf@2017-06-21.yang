                        description "The total number of CRC errored packets received on the interface
                                     in historical 1-day interval.";
                        type uint64;
                    }
                    leaf ethIfH1DInDiscardPkts {
                        config false;
                        description "The total number of discarded packets received on the interface
                                     in historical 1-day interval.";
                        type uint64;
                    }
                    leaf ethIfH1DInErrPkts {
                        config false;
                        description "The total number of errored packets received on the interface
                                     in historical 1-day interval.";
                        type uint64;
                    }
                    leaf ethIfH1DOutErrPkts {
                        config false;
                        description "The total number of errored packets that could not be transmitted 
                                     from the interface because of errors
                                     in historical 1-day interval.";
                        type uint64;
                    }
                    leaf ethIfH1DInDropEvents {
                        config false;
                        description "The total number of events in which packets received were 
                                     dropped by the probe due to lack of resources in historical 
                                     1-day interval.
                                     Note that this number is not necessarily the number of packets 
                                     dropped; it is just the number of times this condition has been 
                                     detected.";
                        type uint64;
                    }
                    leaf ethIfH1DOutDropEvents {
                        config false;
                        description "The total number of events in which packets transmitted were 
                                     dropped by the probe due to lack of resources in historical 
                                     1-day interval.
                                     Note that this number is not necessarily the number of packets 
                                     dropped; it is just the number of times this condition has been 
                                     detected.";
                        type uint64;
                    }
                    leaf ethIfH1DOutCrcErrPkts {
                        config false;
                        description "The total number of CRC errored packets transmitted out of the 
                                     interface in historical 1-day interval.";
                        type uint64;
                    }
                    leaf ethIfH1DOutOversizedPkts {
                        config false;
                        description "The total number of packets transmitted that were longer than 
                                     1518 octets (excluding framing bits, but including FCS octets) 
                                     and were otherwise well formed in historical 1-day interval.";
                        type uint64;
                    }
                    leaf ethIfH1DOutUndersizedPkts {
                        config false;
                        description "The total number of packets transmitted that were less than 
                                     64 octets long (excluding framing bits, but including FCS 
                                     octets) and were otherwise well formed in historical 1-day
                                     interval.";
                        type uint64;
                    }
                    leaf ethIfH1DInFragments {
                        config false;
                        description "The total number of packets received that were less than 64 
                                     octets in length (excluding framing bits but including FCS 
                                     octets) and had either a bad Frame Check Sequence (FCS) with 
                                     an integral number of octets (FCS Error) or a bad FCS with a 
                                     non-integral number of octets (Alignment Error) in historical 
                                     1-day interval.";
                        type uint64;
                    }
                    leaf ethIfH1DOutFragments {
                        config false;
                        description "The total number of packets transmitted that were less than 64 
                                     octets in length (excluding framing bits but including FCS 
                                     octets) and had either a bad Frame Check Sequence (FCS) with an 
                                     integral number of octets (FCS Error) or a bad FCS with a 
                                     non-integral number of octets (Alignment Error) in historical 
                                     1-day interval.";
                        type uint64;
                    }
                    leaf ethIfH1DInJabbers {
                        config false;
                        description "The total number of packets received that were longer than 
                                     1518 octets (excluding framing bits, but including FCS octets), 
                                     and had either a bad Frame Check Sequence (FCS) with an integral 
                                     number of octets (FCS Error) or a bad FCS with a non-integral
                                     number of octets (Alignment Error) in historical 1-day interval.
                                     
                                     Note that this definition of jabber is different than the 
                                     definition in IEEE-802.3 section 8.2.1.5 (10BASE5) and section 
                                     10.3.1.4 (10BASE2). These documents define jabber as the 
                                     condition where any packet exceeds 20 ms. The allowed range to 
                                     detect jabber is between 20 ms and 150 ms.";
                        type uint64;
                    }
                    leaf ethIfH1DOutJabbers {
                        config false;
                        description "The total number of packets transmitted that were longer than 
                                     1518 octets (excluding framing bits, but including FCS octets), 
                                     and had either a bad Frame Check Sequence (FCS) with an integral 
                                     number of octets (FCS Error) or a bad FCS with a non-integral
                                     number of octets (Alignment Error) in historical 1-day interval.
                                     
                                     Note that this definition of jabber is different than the 
                                     definition in IEEE-802.3 section 8.2.1.5 (10BASE5) and section 
                                     10.3.1.4 (10BASE2). These documents define jabber as the 
                                     condition where any packet exceeds 20 ms. The allowed range to 
                                     detect jabber is between 20 ms and 150 ms.";
                        type uint64;
                    }
                    leaf ethIfH1DInPkts64Octets {
                        config false;
                        description "The total number of packets (including bad packets) received 
                                     that were 64 octets in length (excluding framing bits but 
                                     including FCS octets) in historical 1-day interval.";
                        type uint64;
                    }
                    leaf ethIfH1DOutPkts64Octets {
                        config false;
                        description "The total number of packets (including bad packets) transmitted 
                                     that were 64 octets in length (excluding framing bits but 
                                     including FCS octets) in historical 1-day interval.";
                        type uint64;
                    }
                    leaf ethIfH1DInPkts65to127Octs {
                        config false;
                        description "The total number of packets (including bad packets) received 
                                     that were between 65 and 127 octets in length (excluding 
                                     framing bits but including FCS octets) in historical 1-day 
                                     interval.";
                        type uint64;
                    }
                    leaf ethIfH1DOutPkts65to127Octs {
                        config false;
                        description "The total number of packets (including bad packets) transmitted 
                                     that were between 65 and 127 octets in length (excluding 
                                     framing bits but including FCS octets) in historical 1-day 
                                     interval.";
                        type uint64;
                    }
                    leaf ethIfH1DInPkts128to255Octs {
                        config false;
                        description "The total number of packets (including bad packets) received 
                                     that were between 128 and 255 octets in length (excluding 
                                     framing bits but including FCS octets) in historical 1-day 
                                     interval.";
                        type uint64;
                    }
                    leaf ethIfH1DOutPkts128to255Octs {
                        config false;
                        description "The total number of packets (including bad packets) transmitted 
                                     that were between 128 and 255 octets in length (excluding 
                                     framing bits but including FCS octets) in historical 1-day 
                                     interval.";
                        type uint64;
                    }
                    leaf ethIfH1DInPkts256to511Octs {
                        config false;
                        description "The total number of packets (including bad packets) received 
                                     that were between 256 and 511 octets in length (excluding 
                                     framing bits but including FCS octets) in historical 1-day
                                     interval.";
                        type uint64;
                    }
                    leaf ethIfH1DOutPkts256to511Octs {
                        config false;
                        description "The total number of packets (including bad packets) transmitted 
                                     that were between 256 and 511 octets in length (excluding 
                                     framing bits but including FCS octets) in historical 1-day
                                     interval.";
                        type uint64;
                    }
                    leaf ethIfH1DInPkts512to1023 {
                        config false;
                        description "The total number of packets (including bad packets) received 
                                     that were between 512 and 1023 octets in length (excluding 
                                     framing bits but including FCS octets) in historical 1-day 
                                     interval.";
                        type uint64;
                    }
                    leaf ethIfH1DOutPkts512to1023 {
                        config false;
                        description "The total number of packets (including bad packets) transmitted 
                                     that were between 512 and 1023 octets in length (excluding 
                                     framing bits but including FCS octets) in historical 1-day 
                                     interval.";
                        type uint64;
                    }
                    leaf ethIfH1DInPkts1024to1518 {
                        config false;
                        description "The total number of packets (including bad packets) received 
                                     that were between 1024 and 1518 octets in length (excluding 
                                     framing bits but including FCS octets) in historical 1-day
                                     interval.";
                        type uint64;
                    }
                    leaf ethIfH1DOutPkts1024to1518 {
                        config false;
                        description "The total number of packets (including bad packets) transmitted 
                                     that were between 1024 and 1518 octets in length (excluding 
                                     framing bits but including FCS octets) in historical 1-day 
                                     interval.";
                        type uint64;
                    }
                    leaf ethIfH1DLinkStatusChanges {
                        config false;
                        description "The total number of the link status changes on the interface
                                     in historical 1-day interval.
                                     The total number is increased when the link status changes
                                     from up to down, or from down to up.";
                        type uint32;
                    }
                    leaf ethIfH1DInBwUsingRatio {
                        config false;
                        description "An estimate of the interface's received bandwidth using ratio in 
                                     historical 1-day interval.";
                        type int32 {
                            range 0..100;
                        }
                    }
                    leaf ethIfH1DOutBwUsingRatio {
                        config false;
                        description "An estimate of the interface's transmitted bandwidth using ratio 
                                     in historical 1-day interval.";
                        type int32 {
                            range 0..100;
                        }
                    }
                }
            }
            container zxAnEthIfAlmProfileConfTable {
                description "The performance alarm threshold profile table of the ethernet interfaces.";
                list zxAnEthIfAlmProfileConfEntry {
                    description "The performance alarm threshold profile entry of the ethernet interfaces.These
                                 variables in the profile configuration is optional,if not configured,
                                 it means the correspongding alarm is not reported, but the alarm and
                                 clear alarm threshold configuration is needed to bind.";
                    max-elements 100;
                    key "ethIfAlmProfileName ethIfPerfVariable";
                    leaf ethIfAlmProfileName {
                        description "The profile name.";
                        type string {
                            length 1..32;
                        }
                    }
                    leaf ethIfPerfVariable {
                        description "The object identifier of performance variables.";
                        type binary;
                    }
                    leaf ethIfRiseAlmThresh {
                        description "The threshold for rising alarm.";
                        type uint64;
                    }
                    leaf ethIfClrRiseAlmThresh {
                        description "The threshold for rising alarm restore.";
                        type uint64;
                    }
                    leaf ethIfRiseWarnThresh {
                        description "The threshold for rising warning.";
                        type uint64;
                    }
                    leaf ethIfClrRiseWarnThresh {
                        description "The threshold for rising warning restore.";
                        type uint64;
                    }
                    leaf ethIfFallWarnThresh {
                        description "The threshold for falling warning.";
                        type uint64;
                    }
                    leaf ethIfClrFallWarnThresh {
                        description "The threshold for falling warning restore.";
                        type uint64;
                    }
                    leaf ethIfFallAlmThresh {
                        description "The threshold for falling alarm.";
                        type uint64;
                    }
                    leaf ethIfClrFallAlmThresh {
                        description "The threshold for falling alarm restore.";
                        type uint64;
                    }
                    leaf ethIfThreshUsed {
                        description "The threshold used flag.";
                        type bits {
                            bit riseAlmThresh {
                                description "";
                                reference "";
                            }
                            bit riseAlmClrThresh {
                                description "";
                                reference "";
                            }
                            bit riseWarnThresh {
                                description "";
                                reference "";
                            }
                            bit riseWarnClrThresh {
                                description "";
                                reference "";
                            }
                            bit fallWarnThresh {
                                description "";
                                reference "";
                            }
                            bit fallWarnClrThresh {
                                description "";
                                reference "";
                            }
                            bit fallAlmThresh {
                                description "";
                                reference "";
                            }
                            bit fallAlmClrThresh {
                                description "";
                                reference "";
                            }
                        }
                    }
                }
            }
            container zxAnEthIfAlmProfileApplyTable {
                description "The performance alarm threshold profile configuration table of 
                             the ethernet interfaces.";
                list zxAnEthIfAlmProfileApplyEntry {
                    description "The performance alarm threshold profile configuration entry of 
                                 the ethernet interfaces.";
                    max-elements 100;
                    key "ifIndex";
                    leaf ifIndex {
                        description "A unique value, greater than zero, for each interface.  It
                                     is recommended that values are assigned contiguously
                                     starting from 1.  The value for each interface sub-layer
                                     must remain constant at least from one re-initialization of
                                     the entity's network management system to the next re-
                                     initialization.";
                        type int32 {
                            range 1..2147483647;
                        }
                    }
                    leaf ethIfAlmPrf {
                        description "The performance alarm threshold profile.";
                        type string {
                            length 1..32;
                        }
                    }
                }
            }
            container zxAnEthIfAlmProfileTable {
                description "The performance alarm threshold profile table of the ethernet interfaces.It can be used to
                             delete all of the performance alarm threshold profiles which has the same name configured
                             in 'zxAnEthIfAlmProfileConfTable'.";
                list zxAnEthIfAlmProfileEntry {
                    description "The performance alarm threshold profile entry of the ethernet interfaces.";
                    max-elements 100;
                    key "ethIfAlmProfileName";
                    leaf ethIfAlmProfileName {
                        description "The profile name.";
                        type string {
                            length 1..32;
                        }
                    }
                }
            }
            container zxAnEthIfCurrMinPerfTable {
                description "The minutes interval performance data table of the 
                             ethernet interfaces.";
                list zxAnEthIfCurrMinPerfEntry {
                    description "The minutes interval performance data entry of the 
                                 ethernet interfaces.";
                    max-elements 100;
                    key "ifIndex";
                    leaf ifIndex {
                        description "A unique value, greater than zero, for each interface.  It
                                     is recommended that values are assigned contiguously
                                     starting from 1.  The value for each interface sub-layer
                                     must remain constant at least from one re-initialization of
                                     the entity's network management system to the next re-
                                     initialization.";
                        type int32 {
                            range 1..2147483647;
                        }
                    }
                    leaf ethIfCMinTimeElapsed {
                        config false;
                        description "Number of seconds that have elapsed since the beginning of the 
                                     current minutes interval.";
                        type int32 {
                            range 0..86399;
                        }
                    }
                    leaf ethIfCMinInOctets {
                        config false;
                        description "The total number of octets received on the interface,
                                     including framing characters in current minutes interval.";
                        type uint64;
                    }
                    leaf ethIfCMinInPkts {
                        config false;
                        description "The total number of packets received on the interface,
                                     including framing characters in current minutes interval.";
                        type uint64;
                    }
                    leaf ethIfCMinInUcastPkts {
                        config false;
                        description "The number of packets, delivered by this sub-layer to a
                                     higher (sub-)layer, which were not addressed to a multicast
                                     or broadcast address at this sub-layer in current minutes
                                     interval.";
                        type uint64;
                    }
                    leaf ethIfCMinInMcastPkts {
                        config false;
                        description "The number of packets, delivered by this sub-layer to a
                                     higher (sub-)layer, which were addressed to a multicast
                                     address at this sub-layer in current minutes interval.
                                     For a MAC layer protocol, this includes both Group and 
                                     functional addresses.";
                        type uint64;
                    }
                    leaf ethIfCMinInBcastPkts {
                        config false;
                        description "The number of packets, delivered by this sub-layer to a
                                     higher (sub-)layer, which were addressed to a broadcast
                                     address at this sub-layer in current minutes interval.";
                        type uint64;
                    }
                    leaf ethIfCMinInOversizedPkts {
                        config false;
                        description "The number of packets,whick above the configured MTU-size,
                                     e.g.mtu = 2000 (frames >2000 are discarded) in current
                                     minutes interval.";
                        type uint64;
                    }
                    leaf ethIfCMinInUndersizedPkts {
                        config false;
                        description "The number of packets,whick above the min port size,
                                     the value is 64 in current minutes interval.";
                        type uint64;
                    }
                    leaf ethIfCMinOutOctets {
                        config false;
                        description "The total number of octets transmitted out of the interface, 
                                     including framing characters in current minutes interval.";
                        type uint64;
                    }
                    leaf ethIfCMinOutPkts {
                        config false;
                        description "The total number of packets transmitted out of the interface, 
                                     including framing characters in current minutes interval.";
                        type uint64;
                    }
                    leaf ethIfCMinOutUcastPkts {
                        config false;
                        description "The total number of packets that higher-level protocols
                                     requested be transmitted, and which were not addressed to a
                                     multicast or broadcast address at this sub-layer, including
                                     those that were discarded or not sent in current minutes
                                     interval.";
                        type uint64;
                    }
                    leaf ethIfCMinOutMcastPkts {
                        config false;
                        description "The total number of packets that higher-level protocols
                                     requested be transmitted, and which were addressed to a
                                     multicast address at this sub-layer, including those that
                                     were discarded or not sent in current minutes interval.
                                     For a MAC layer protocol, this includes both Group and 
                                     functional addresses.";
                        type uint64;
                    }
                    leaf ethIfCMinOutBcastPkts {
                        config false;
                        description "The total number of packets that higher-level protocols
                                     requested be transmitted, and which were addressed to a
                                     broadcast address at this sub-layer, including those that
                                     were discarded or not sent in current minutes interval.";
                        type uint64;
                    }
                    leaf ethIfCMinOutPausePkts {
                        config false;
                        description "A count of MAC Control frames transmitted on
                                     this interface with an opcode indicating the
                                     PAUSE operation in current minutes interval.";
                        type uint64;
                    }
                    leaf ethIfCMinOutDiscardPkts {
                        config false;
                        description "The number of outbound packets which were chosen to be
                                     discarded even though no errors had been detected to prevent
                                     their being transmitted in current minutes interval.";
                        type uint64;
                    }
                    leaf ethIfCMinOutCollisions {
                        config false;
                        description "A count of frames that are involved in out collision and 
                                     are subsequently transmitted successfully in current 
                                     minutes interval.";
                        type uint64;
                    }
                    leaf ethIfCMinSingleCollisions {
                        config false;
                        description "A count of frames that are involved in a single
                                     collision, and are subsequently transmitted
                                     successfully in current minutes interval.";
                        type uint64;
                    }
                    leaf ethIfCMinMultipleCollisions {
                        config false;
                        description "A count of frames that are involved in more
                                     than one collision and are subsequently
                                     transmitted successfully in current minutes
                                     interval.";
                        type uint64;
                    }
                    leaf ethIfCMinFcsErrors {
                        config false;
                        description "A count of frames received on a particular
                                     interface that are an integral number of octets
                                     in length but do not pass the FCS check.  This
                                     count does not include frames received with
                                     frame-too-long or frame-too-short error in current
                                     minutes interval.";
                        type uint64;
                    }
                    leaf ethIfCMinAlignmentErrors {
                        config false;
                        description "A count of frames received on a particular
                                     interface that are not an integral number of
                                     octets in length and do not pass the FCS check
                                     in current minutes interval.";
                        type uint64;
                    }
                    leaf ethIfCMinInCrcErrPkts {
                        config false;
                        description "The total number of CRC errored packets received on the interface
                                     in current minutes interval.";
                        type uint64;
                    }
                    leaf ethIfCMinInDiscardPkts {
                        config false;
                        description "The total number of discarded packets received on the interface
                                     in current minutes interval.";
                        type uint64;
                    }
                    leaf ethIfCMinInErrPkts {
                        config false;
                        description "The total number of errored packets received on the interface
                                     in current minutes interval.";
                        type uint64;
                    }
                    leaf ethIfCMinOutErrPkts {
                        config false;
                        description "The total number of errored packets that could not be transmitted 
                                     from the interface because of errors in current minutes 
                                     interval.";
                        type uint64;
                    }
                    leaf ethIfCMinInDropEvents {
                        config false;
                        description "The total number of events in which packets received were 
                                     dropped by the probe due to lack of resources.
                                     Note that this number is not necessarily the number of packets 
                                     dropped; it is just the number of times this condition has been 
                                     detected in current minutes interval.";
                        type uint64;
                    }
                    leaf ethIfCMinOutDropEvents {
                        config false;
                        description "The total number of events in which packets transmitted were 
                                     dropped by the probe due to lack of resources.
                                     Note that this number is not necessarily the number of packets 
                                     dropped; it is just the number of times this condition has been 
                                     detected in current minutes interval.";
