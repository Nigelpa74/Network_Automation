            type enumeration {
              enum enable {
                value 1 ;
                description 'The state of the current out clock is enabled.'
                            ;
              }
              enum disable {
                value 2 ;
                description 'The state of the current out clock is disabled.'
                            ;
              }
              enum unsupported {
                value 3 ;
                description 'The state of the current out clock is unsupported.'
                            ;
              }
            }
          }
          leaf out-mode {
            description 'The mode of the current out clock.'
                        ;
            type enumeration {
              enum priority {
                value 1 ;
                description 'According to priority'
                            ;
              }
              enum quality {
                value 2 ;
                description 'According to quality-level'
                            ;
              }
            }
          }
          leaf sub-if-name {
            description 'The interface name of output clock source.'
                        ;
            type string {
              length 0..31 ;
            }
          }
          leaf sub-clock-type {
            description 'The clock type of output clock source.'
                        ;
            type enumeration {
              enum external-clk {
                value 1 ;
                description 'External clock.'
                            ;
              }
              enum line-clk {
                value 2 ;
                description 'Line clock.'
                            ;
              }
              enum inner-clk {
                value 3 ;
                description 'Internal clock.'
                            ;
              }
              enum tributline-clk {
                value 5 ;
                description 'Tribute line clock.'
                            ;
              }
              enum PTP1588-clk {
                value 6 ;
                description 'PTP clock.'
                            ;
              }
              enum gps-clk {
                value 7 ;
                description 'GPS clock.'
                            ;
              }
              enum stm-clk {
                value 8 ;
                description 'Stm-n clock.'
                            ;
              }
              enum current-clock {
                value 19 ;
                description 'Current system clock.'
                            ;
              }
            }
          }
          leaf out-quality {
            description 'The current out clock QL.'
                        ;
            type enumeration {
              enum QL-UNK {
                value 0 ;
                description 'The QL is unknown.'
                            ;
              }
              enum QL-PRC {
                value 2 ;
                description 'The QL is PRC.'
                            ;
              }
              enum QL-SSU-A {
                value 4 ;
                description 'The QL is SSU-A.'
                            ;
              }
              enum QL-SSU-B {
                value 8 ;
                description 'The QL is SSU-B.'
                            ;
              }
              enum QL-SEC {
                value 11 ;
                description 'The QL is SEC.'
                            ;
              }
              enum QL-DNU {
                value 15 ;
                description 'The QL is DNU.'
                            ;
              }
              enum QL-PRTC {
                value 5 ;
                description 'The QL is PRTC.'
                            ;
              }
              enum QL-ePRTC {
                value 1 ;
                description 'The QL is ePRTC.'
                            ;
              }
              enum QL-ePRC {
                value 7 ;
                description 'The QL is ePRC.'
                            ;
              }
              enum QL-eSEC {
                value 10 ;
                description 'The QL is eSEC.'
                            ;
              }
              enum invalid {
                value 254 ;
              }
            }
          }
        }
      }
      container sync-clocks {
        description 'The node of synchronization clock.'
                    ;
        list sync-unif-clock {
          description 'The synchronization clock list.'
                      ;
          key clock-type ;
          leaf clock-type {
            description 'The clock type.'
                        ;
            type enumeration {
              enum inner-clk {
                value 3 ;
                description 'Internal clock.'
                            ;
              }
              enum PTP1588-clk {
                value 6 ;
                description 'PTP clock.'
                            ;
              }
            }
          }
          leaf rcv-quality {
            description 'The value of received clock QL.'
                        ;
            type enumeration {
              enum QL-UNK {
                value 0 ;
                description 'The QL is unknown.'
                            ;
              }
              enum QL-PRC {
                value 2 ;
                description 'The QL is PRC.'
                            ;
              }
              enum QL-SSU-A {
                value 4 ;
                description 'The QL is SSU-A.'
                            ;
              }
              enum QL-SSU-B {
                value 8 ;
                description 'The QL is SSU-B.'
                            ;
              }
              enum QL-SEC {
                value 11 ;
                description 'The QL is SEC.'
                            ;
              }
              enum QL-DNU {
                value 15 ;
                description 'The QL is DNU.'
                            ;
              }
              enum QL-PRTC {
                value 5 ;
                description 'The QL is PRTC.'
                            ;
              }
              enum QL-ePRTC {
                value 1 ;
                description 'The QL is ePRTC.'
                            ;
              }
              enum QL-ePRC {
                value 7 ;
                description 'The QL is ePRC.'
                            ;
              }
              enum QL-eSEC {
                value 10 ;
                description 'The QL is eSEC.'
                            ;
              }
            }
          }
        }
        list sync-clock {
          description 'The synchronization clock list.'
                      ;
          key 'if-name clock-type'
              ;
          leaf if-name {
            description 'The interface name of clock.'
                        ;
            type string {
              length 1..31 ;
            }
          }
          leaf clock-type {
            description 'The clock type.'
                        ;
            type enumeration {
              enum external-clk {
                value 1 ;
                description 'External clock.'
                            ;
              }
              enum line-clk {
                value 2 ;
                description 'Line clock.'
                            ;
              }
              enum tributeline-clk {
                value 5 ;
                description 'Tribute line clock.'
                            ;
              }
              enum gps-clk {
                value 7 ;
                description 'GPS clock.'
                            ;
              }
              enum stm-clk {
                value 8 ;
                description 'Stm-n clock.'
                            ;
              }
            }
          }
          leaf rcv-quality {
            description 'The value of received clock QL.'
                        ;
            type enumeration {
              enum QL-UNK {
                value 0 ;
                description 'The QL is unknown.'
                            ;
              }
              enum QL-PRC {
                value 2 ;
                description 'The QL is PRC.'
                            ;
              }
              enum QL-SSU-A {
                value 4 ;
                description 'The QL is SSU-A.'
                            ;
              }
              enum QL-SSU-B {
                value 8 ;
                description 'The QL is SSU-B.'
                            ;
              }
              enum QL-SEC {
                value 11 ;
                description 'The QL is SEC.'
                            ;
              }
              enum QL-DNU {
                value 15 ;
                description 'The QL is DNU.'
                            ;
              }
              enum QL-PRTC {
                value 5 ;
                description 'The QL is PRTC.'
                            ;
              }
              enum QL-ePRTC {
                value 1 ;
                description 'The QL is ePRTC.'
                            ;
              }
              enum QL-ePRC {
                value 7 ;
                description 'The QL is ePRC.'
                            ;
              }
              enum QL-eSEC {
                value 10 ;
                description 'The QL is eSEC.'
                            ;
              }
            }
          }
          leaf priority {
            description 'The clock priority,the range is 1-255.'
                        ;
            type uint8 {
              range 1..255 {
                description 'The value of DIS is 255.'
                            ;
              }
            }
            default 255 ;
            ncd:revise-date 2022-01-11 ;
          }
          leaf alarm-status {
            description 'Alarm status.'
                        ;
            type enumeration {
              enum no {
                value 0 ;
                description 'Not in alarm status.'
                            ;
              }
              enum lof {
                value 2 ;
                description 'In lof alarm status.'
                            ;
              }
              enum lost {
                value 1 ;
                description 'In lost alarm status.'
                            ;
              }
            }
            ncd:revise-date 2022-01-11 ;
          }
          leaf isWTR {
            description 'WTR flag.'
                        ;
            type enumeration {
              enum no {
                value 0 ;
                description 'Not in WTR status.'
                            ;
              }
              enum yes {
                value 1 ;
                description 'In WTR status.'
                            ;
              }
            }
            ncd:revise-date 2022-01-11 ;
          }
        }
      }
      container ptp-clock {
        description 'PTP clock information.'
                    ;
        leaf pll-state {
          description "PTP clock's PLL status."
                      ;
          type enumeration {
            enum capture {
              value 1 ;
              description 'PLL status is captured.'
                          ;
            }
            enum lock {
              value 3 ;
              description 'PLL status is locked.'
                          ;
            }
            enum unlock {
              value 4 ;
              description 'PLL status is unlocked.'
                          ;
            }
            enum free-run {
              value 5 ;
              description 'PLL status is free-run.'
                          ;
            }
            enum holdover {
              value 6 ;
              description 'PLL status is holdover.'
                          ;
            }
            enum NULL {
              value 254 ;
              description 'PLL status is invalid.'
                          ;
            }
          }
        }
        ncd:revise-date 2021-07-09 ;
      }
    }
    container flexe-sync {
      description 'The node of flexegroup synchronization state.'
                  ;
      container sync-channels {
        description 'The node of synchronization channel state.'
                    ;
        list sync-channel {
          description 'The synchronization channel list.'
                      ;
          key ifname ;
          leaf ifname {
            description 'The interface name of flexegroup.'
                        ;
            type ncd:ifname ;
          }
          leaf phy-if {
            description 'The switch interface.'
                        ;
            type string ;
          }
        }
      }
      ncd:revise-date 2019-01-07 ;
    }
  }
  container operation {
    config false ;
    description 'The operation of SSM.'
                ;
    container ssm {
      description 'The node of SSM.'
                  ;
      container wtr-clear-action {
        description 'Clear wait to restore action.'
                    ;
        choice wtr-clear {
          description 'To clear wait to restore state.'
                      ;
          case clear-oneclock {
            description 'To clear one clock wait to restore state.'
                        ;
            leaf if-name {
              description 'The interface name of clock,inner-clk or PTP1588-clk'
                        + ' is NULL.'
                          ;
              type string {
                length 0..31 ;
              }
            }
            leaf clock-type {
              description 'The clock type.'
                          ;
              type enumeration {
                enum external-clk {
                  value 1 ;
                  description 'External clock.'
                              ;
                }
                enum line-clk {
                  value 2 ;
                  description 'Line clock.'
                              ;
                }
                enum inner-clk {
                  value 3 ;
                  description 'Internal clock.'
                              ;
                }
                enum tributeline-clk {
                  value 5 ;
                  description 'Tribute line clock.'
                              ;
                }
                enum PTP1588-clk {
                  value 6 ;
                  description 'PTP clock.'
                              ;
                }
                enum gps-clk {
                  value 7 ;
                  description 'GPS clock.'
                              ;
                }
                enum stm-clk {
                  value 8 ;
                  description 'Stm-n clock.'
                              ;
                }
              }
            }
          }
          case clear-allclock {
            description 'To clear all clock wait to restore state.'
                        ;
            leaf allclock {
              description 'The flag of all clock ports.'
                          ;
              type uint8 {
                range 1 ;
              }
            }
          }
        }
      }
    }
  }
}
