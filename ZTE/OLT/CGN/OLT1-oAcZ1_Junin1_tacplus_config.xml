          <create-session-template-nat64>enable</create-session-template-nat64>
          <create-portrange-template-nat64>enable</create-portrange-template-nat64>
          <delete-translation-template-nat64>enable</delete-translation-template-nat64>
          <delete-session-template-nat64>enable</delete-session-template-nat64>
          <delete-portrange-template-nat64>enable</delete-portrange-template-nat64>
