          <create-session-template-nat44>enable</create-session-template-nat44>
          <create-portrange-template-nat44>enable</create-portrange-template-nat44>
          <delete-translation-template-nat44>enable</delete-translation-template-nat44>
          <delete-session-template-nat44>enable</delete-session-template-nat44>
