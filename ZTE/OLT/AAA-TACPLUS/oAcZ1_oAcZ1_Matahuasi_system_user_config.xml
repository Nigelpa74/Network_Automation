  <data>
    <configuration xmlns="http://www.zte.com.cn/zxr10/netconf/schema/rosng/adm-mgr">
      <adm-mgr>
        <global-configuration>
          <account-switch>
            <off/>
          </account-switch>
          <enable>
            <global-enable-type>
              <local-authentication/>
            </global-enable-type>
            <enable-secret-expire>
              <never-expire/>
            </enable-secret-expire>
          </enable>
          <default-privilege-level>0</default-privilege-level>
          <password>
            <strong-password>
              <length>8</length>
              <character-set-num>
                <min-num>3</min-num>
              </character-set-num>
              <username-related-check>
                <substring>
                  <substring>enable</substring>
                </substring>
                <inverse>enable</inverse>
              </username-related-check>
              <date-check>enable</date-check>
            </strong-password>
            <strong-password-check>
              <enable/>
            </strong-password-check>
            <duplicated-password>5</duplicated-password>
          </password>
          <login-restriction>
            <login-block>
              <block-time>900</block-time>
              <attemp-times>30</attemp-times>
              <watch-period>120</watch-period>
            </login-block>
            <login-failure-alarm>
              <every-times>1</every-times>
            </login-failure-alarm>
            <user-authen-restriction>
              <fail-times>10</fail-times>
              <lock-time>15</lock-time>
            </user-authen-restriction>
          </login-restriction>
          <strong-username>
            <min-length>3</min-length>
            <dictionary>0</dictionary>
          </strong-username>
          <global-user-aging>
            <day>90</day>
          </global-user-aging>
          <ftp-aaa-authentication>
            <enabled>false</enabled>
          </ftp-aaa-authentication>
